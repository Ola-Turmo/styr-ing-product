---
interface Props { title: string; activeNav?: string; }
const { title, activeNav = '' } = Astro.props;
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Styr.ing",
  url: "https://styr.ing",
  description: "Offentlig konseptdemo for norsk styrearbeid og internkontroll. Styr.ing er ikke et separat aktivt tilbud.",
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "customer support",
    email: "ola@styr.ing",
  },
  sameAs: [],
};
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Styr.ing",
  url: "https://styr.ing",
  description: "Offentlig konseptdemo for norsk styrearbeid og internkontroll",
  inLanguage: "nb-NO",
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Hva er Styr.ing?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Styr.ing er en offentlig konseptdemo med fiktive data. Ingen konto, produktaktivering eller produksjonsfunksjon tilbys på siden.",
      },
    },
    {
      "@type": "Question",
      name: "Kan jeg kjøpe eller registrere Styr.ing?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Nei. Styr.ing har ikke et separat aktivt tilbud, en offentlig pris eller selvbetjent registrering. Samsvarlig er frontdøren for det aktive kontrollsyklustilbudet.",
      },
    },
    {
      "@type": "Question",
      name: "Er demoen juridisk rådgivning eller dokumentasjon på etterlevelse?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Nei. Virksomheten må selv identifisere, kvalitetssikre og oppfylle kravene som gjelder.",
      },
    },
  ],
};
---
<!doctype html>
<html lang="no">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} | Styr.ing</title>
  <meta name="description" content="Konsept- og demoflater for norsk styrearbeid og internkontroll. Produksjonsomfang, funksjoner og pris bekreftes før aktivering." />
  <meta name="keywords" content="styreportal, internkontroll, compliance, styreverktøy, norsk styre, Aksjeloven, GDPR, board portal, governance, Norway" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
  <meta property="og:title" content={`${title} | Styr.ing`} />
  <meta property="og:description" content="Konsept- og demoflater for norsk styrearbeid og internkontroll. Omfang avtales før produksjonsbruk." />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Styr.ing" />
  <meta property="og:locale" content="nb_NO" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
  <link rel="llms-txt" href="/llms.txt" />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <style>
    :root {
      --ink: #10241f;
      --muted: #5c6b65;
      --paper: #f6f2ea;
      --accent: #1f6f5b;
      --gold: #d8a94d;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: Georgia, "Times New Roman", serif;
      background: radial-gradient(circle at 18% 0%, #fff8df 0%, var(--paper) 45%, #dfe9e3 100%);
      color: var(--ink);
      line-height: 1.6;
      overflow-wrap: anywhere;
    }
    main { min-width: 0; }
    .site-boundary {
      padding: 9px clamp(20px,5vw,60px);
      background: #fff4cf;
      border-bottom: 1px solid rgba(138,117,0,0.24);
      color: #655500;
      font-family: system-ui, sans-serif;
      font-size: 0.8rem;
      text-align: center;
    }
    a { color: var(--accent); text-decoration: none; }
    a:hover { color: #0d4a3a; }
    :focus-visible {
      outline: 3px solid #a94800;
      outline-offset: 3px;
    }

    nav {
      position: sticky; top: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 16px clamp(20px,5vw,60px);
      background: rgba(246,242,234,0.92);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(16,36,31,0.08);
    }
    .logo { font-size: 1.25rem; font-weight: 700; letter-spacing: -0.02em; color: var(--ink); }
    .logo span { color: var(--accent); }
    .nav-links { display: flex; gap: 20px; list-style: none; font-family: system-ui, sans-serif; font-size: 0.85rem; align-items: center; }
    .nav-links a { color: var(--muted); font-weight: 500; }
    .nav-links a:hover { color: var(--accent); }
    .nav-links a.active { color: var(--accent); font-weight: 600; }
    .nav-cta {
      background: var(--accent); color: #fff;
      padding: 8px 18px; border-radius: 100px;
      font-family: system-ui, sans-serif; font-size: 0.8rem; font-weight: 600;
    }
    .nav-cta:hover { background: #0d4a3a; color: #fff; }

    .container { max-width: 1100px; margin: 0 auto; }
    [id] { scroll-margin-top: 80px; }

    @media (max-width: 760px) {
      nav { align-items: flex-start; gap: 12px; flex-wrap: wrap; }
      .nav-links { width: 100%; gap: 10px 14px; flex-wrap: wrap; }
      .nav-cta { margin-left: 0 !important; }
    }

    footer {
      background: var(--ink); color: rgba(255,255,255,0.5);
      padding: 32px clamp(20px,5vw,60px); margin-top: 4rem;
      font-family: system-ui, sans-serif; font-size: 0.8rem;
    }
    .footer-inner { max-width: 1100px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; }
    .footer-inner a { color: rgba(255,255,255,0.5); }
    .footer-inner a:hover { color: rgba(255,255,255,0.8); }
  </style>
</head>
<body>
  <nav>
    <a href="/" class="logo">styr<span>.</span>ing</a>
    <ul class="nav-links" aria-label="Hovedmeny">
      <li><a href="/board" class={activeNav === 'boards' ? 'active' : ''}>Styreportal</a></li>
      <li><a href="/compliance" class={activeNav === 'compliance' ? 'active' : ''}>Compliance</a></li>
      <li><a href="/internkontroll" class={activeNav === 'internkontroll' ? 'active' : ''}>Internkontroll</a></li>
      <li><a href="/login">Tilgang</a></li>
      <li><a href="https://samsvarlig.no/" class="nav-cta" style="margin-left: 8px;">Se Samsvarlig</a></li>
    </ul>
  </nav>

  <div class="site-boundary" role="note">
    Offentlig konseptdemo med illustrasjonsdata. Ingen konto, lagring, varsling, signering, eksport eller KI-kjøring skjer på disse sidene.
  </div>

  <main>
    <slot />
  </main>

  <footer>
    <div class="footer-inner">
      <div>© 2026 Styr.ing — offentlig konseptdemo</div>
      <div>
        <a href="mailto:ola@styr.ing">ola@styr.ing</a>
      </div>
    </div>
  </footer>
</body>
</html>
