---
interface Props { title: string; activeNav?: string; }
const { title, activeNav = '' } = Astro.props;
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Styr.ing",
  url: "https://styr.ing",
  description: "Styr.ing er et norsk, komplett regnskapssystem for små virksomheter, med lønn, bankgrunnlag og virksomhetsoppfølging.",
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "customer support",
    email: "ola@styr.ing",
  },
  sameAs: [],
};
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Styr.ing",
  url: "https://styr.ing",
  description: "Norsk regnskapssystem for små virksomheter med bilag, faktura, MVA, lønn og bankgrunnlag",
  inLanguage: "nb-NO",
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Hva er Styr.ing?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Den offentlige forhåndsvisningen bruker fiktive data. Kundeinnlogging og invitasjonsbasert tilgang er tilgjengelig for aktiverte virksomheter.",
      },
    },
    {
      "@type": "Question",
      name: "Kan jeg kjøpe eller registrere Styr.ing?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Styr.ing er SaaS-only. Pris og aktivering avtales med virksomheten; den offentlige demoen har ingen selvbetjent betaling.",
      },
    },
    {
      "@type": "Question",
      name: "Er demoen juridisk rådgivning eller dokumentasjon på etterlevelse?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Nei. Virksomheten må selv identifisere, kvalitetssikre og oppfylle kravene som gjelder.",
      },
    },
  ],
};
import CarbonQuick from '../components/CarbonQuick.astro';
import TransparencyQuick from '../components/TransparencyQuick.astro';
---
<!doctype html>
<html lang="no">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} | Styr.ing</title>
  <meta name="description" content="Styr.ing er et komplett norsk regnskapssystem for små AS og enkeltpersonforetak: bilag, faktura, MVA, lønn, bankgrunnlag og rapportering samlet på ett sted." />
  <meta name="keywords" content="regnskapssystem, regnskapsprogram, små bedrifter, små AS, bilag, faktura, MVA, lønn, bankavstemming, norsk SaaS" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
  <meta property="og:title" content={`${title} | Styr.ing`} />
  <meta property="og:description" content="Komplett regnskap for små norske virksomheter — med bilag, faktura, MVA, lønn og bankgrunnlag." />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Styr.ing" />
  <meta property="og:locale" content="nb_NO" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
  <link rel="llms-txt" href="/llms.txt" />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <style>
    :root {
      --ink: #10241f;
      --muted: #5c6b65;
      --paper: #f6f2ea;
      --accent: #1f6f5b;
      --gold: #d8a94d;
      --night: #10241f;
      --glow: #dff7c9;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: Georgia, "Times New Roman", serif;
      background: radial-gradient(circle at 18% 0%, #fff8df 0%, var(--paper) 45%, #dfe9e3 100%);
      color: var(--ink);
      line-height: 1.6;
      overflow-wrap: normal;
      min-width: 320px;
    }
    main { min-width: 0; }
    .site-boundary {
      padding: 9px clamp(20px,5vw,60px);
      background: #fff4cf;
      border-bottom: 1px solid rgba(138,117,0,0.24);
      color: #655500;
      font-family: system-ui, sans-serif;
      font-size: 0.8rem;
      text-align: center;
    }
    a { color: var(--accent); text-decoration: none; }
    a:hover { color: #0d4a3a; }
    :focus-visible {
      outline: 3px solid #a94800;
      outline-offset: 3px;
    }

    .site-nav {
      position: sticky; top: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 14px clamp(20px,5vw,60px);
      background: rgba(246,242,234,0.92);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(16,36,31,0.08);
      min-height: 62px;
      overflow: visible;
    }
    /* Navigation labels are words, never columns of individual letters.
       Keep this invariant even when a browser reports a narrow/zoomed viewport. */
    .site-nav, .site-nav * { word-break: keep-all; overflow-wrap: normal; hyphens: none; }
    .logo { display: inline-flex; flex: 0 0 auto; align-items: center; gap: 9px; min-width: max-content; white-space: nowrap; font-size: 1.25rem; font-weight: 700; letter-spacing: -0.02em; color: var(--ink); }
    .logo > span:last-child { color: var(--ink); white-space: nowrap; }
    .logo-mark { width: 30px; height: 30px; border-radius: 10px; display: grid; place-items: center; background: var(--night); color: var(--glow); font: 700 1.05rem/1 Georgia, serif; box-shadow: 0 5px 14px rgba(16,36,31,.15); }
    .logo-dot { color: var(--accent); }
    .nav-links { display: flex; flex: 1 1 auto; gap: clamp(12px,2vw,24px); list-style: none; font-family: system-ui, sans-serif; font-size: 0.83rem; align-items: center; justify-content: flex-end; min-width: 0; white-space: nowrap; }
    .nav-links li { display: block; flex: 0 0 auto; width: auto; min-width: max-content; white-space: nowrap; }
    .nav-links a { color: var(--muted); font-weight: 500; white-space: nowrap; }
    .nav-links a:hover { color: var(--accent); }
    .nav-links a.active { color: var(--accent); font-weight: 600; }
    .nav-cta {
      background: var(--accent); color: #fff;
      padding: 8px 18px; border-radius: 100px;
      font-family: system-ui, sans-serif; font-size: 0.8rem; font-weight: 600;
    }
    .nav-cta:hover { background: #0d4a3a; color: #fff; transform: translateY(-1px); }
    .mobile-nav-toggle { display: none; border: 1px solid rgba(16,36,31,.14); background: #fff; color: var(--ink); border-radius: 999px; padding: 8px 13px; font: 600 .78rem/1 system-ui, sans-serif; }

    .nav-secondary { color: var(--muted); font-weight: 600 !important; }
    .nav-group { position: relative; }
    .nav-group details { position: relative; }
    .nav-group details > summary { list-style: none; cursor: pointer; color: var(--muted); font: 500 .83rem/1 system-ui, sans-serif; white-space: nowrap; }
    .nav-group details > summary::-webkit-details-marker { display: none; }
    .nav-group details > summary::after { content: '⌄'; margin-left: 5px; font-size: .75em; }
    .nav-group details[open] > summary, .nav-group details > summary:hover { color: var(--accent); }
    .nav-menu { position: absolute; top: calc(100% + 14px); right: -14px; width: 238px; display: grid; gap: 4px; padding: 10px; border: 1px solid rgba(16,36,31,.1); border-radius: 13px; background: rgba(255,255,255,.98); box-shadow: 0 18px 40px rgba(16,36,31,.15); }
    .nav-menu a { display: block; padding: 9px 10px; border-radius: 8px; color: var(--muted); font-size: .78rem; }
    .nav-menu a:hover { background: #e8f1df; color: var(--accent); }

    .container { max-width: 1100px; margin: 0 auto; }
    [id] { scroll-margin-top: 80px; }

    @media (max-width: 1100px) {
      .nav-links { gap: 13px; font-size: .77rem; }
      .nav-cta { padding-inline: 13px; }
    }
    /* Keep the public first impression readable on laptops and small tablets.
       The previous desktop-only menu could squeeze labels into single letters. */
    /* Keep the primary navigation visible on normal laptop widths. The old
       breakpoint hid the links at 1280 CSS px, which made the public page
       look like a broken, letter-stacked desktop menu. Collapse only when
       there is not enough room for the actual labels. */
    @media (max-width: 1100px) {
      .site-nav { align-items: center; gap: 12px; flex-wrap: wrap; }
      .mobile-nav-toggle { display: inline-flex; margin-left: auto; }
      .nav-links { display: none; width: 100%; gap: 12px 14px; flex-wrap: wrap; padding-top: 4px; white-space: normal; }
      .nav-links.open { display: flex; }
      .nav-links li { min-width: 0; white-space: normal; }
      .nav-cta { margin-left: 0 !important; }
      .nav-group { width: auto; }
      .nav-group details { position: static; }
      .nav-menu { position: static; width: 100%; margin-top: 8px; box-shadow: none; }
    }
    @media (max-width: 760px) {
      .site-nav { align-items: center; gap: 12px; flex-wrap: wrap; }
      .mobile-nav-toggle { display: inline-flex; margin-left: auto; }
      .nav-links { gap: 12px 14px; }
      .nav-cta { margin-left: 0 !important; }
      .nav-group { width: auto; }
      .nav-menu { position: static; width: 100%; margin-top: 8px; box-shadow: none; }
    }

    footer {
      background: var(--ink); color: rgba(255,255,255,0.5);
      padding: 32px clamp(20px,5vw,60px); margin-top: 4rem;
      font-family: system-ui, sans-serif; font-size: 0.8rem;
    }
    .footer-inner { max-width: 1100px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; }
    .footer-inner a { color: rgba(255,255,255,0.5); }
    .footer-inner a:hover { color: rgba(255,255,255,0.8); }
  </style>
</head>
<body>
  <nav class="site-nav">
    <a href="/" class="logo" aria-label="Styr.ing forsiden"><span class="logo-mark">s</span><span>styr<span class="logo-dot">.</span>ing</span></a>
    <button class="mobile-nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">Meny</button>
    <ul id="primary-nav" class="nav-links" aria-label="Hovedmeny">
      <li><a href="/finance" class={activeNav === 'finance' ? 'active' : ''}>Regnskap</a></li>
      <li><a href="/capabilities" class={activeNav === 'capabilities' ? 'active' : ''}>Funksjoner</a></li>
      <li><a href="/abonnement" class={activeNav === 'abonnement' ? 'active' : ''}>Priser</a></li>
      <li><a href="/trust" class={activeNav === 'trust' ? 'active' : ''}>Sikkerhet</a></li>
      <li class="nav-group">
        <details>
          <summary>Mer</summary>
          <div class="nav-menu" aria-label="Flere sider">
            <a href="/app/arbeidsflate?view=governance">Styrearbeid</a>
            <a href="/risk">Risiko og kontroll</a>
            <a href="/people">Mennesker og HCM</a>
            <a href="/commercial">Kunder og kommersielt</a>
            <a href="/it">IT og drift</a>
            <a href="/governance">Avtaler og juss</a>
            <a href="/audit">Kontrollspor</a>
          </div>
        </details>
      </li>
      <li><a id="auth-link" href="/login" class={activeNav === 'login' ? 'active' : ''}>Logg inn</a></li>
      <li><a href="/finance" class="nav-cta">Se regnskapsdemo <span aria-hidden="true">↗</span></a></li>
    </ul>
  </nav>

  <div class="site-boundary" role="note">
    Styr.ing offentlig forhåndsvisning · illustrasjonsdata i denne flaten · ingen reelle virksomhetsdata må legges inn.
  </div>

  <main>
    {activeNav === 'sustainability' && <CarbonQuick />}
    {activeNav === 'sustainability' && <TransparencyQuick />}
    <slot />
  </main>

  <footer>
    <div class="footer-inner">
      <div>© 2026 Styr.ing — norsk SaaS for bedre styring</div>
      <div>
        <a href="mailto:ola@styr.ing">ola@styr.ing</a>
      </div>
    </div>
  </footer>
</body>
<script is:inline>
  const toggle = document.querySelector('.mobile-nav-toggle');
  const nav = document.querySelector('#primary-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
  });
  const authLink = document.querySelector('#auth-link');
  fetch('/api/auth').then((response) => response.json()).then((data) => {
    if (!authLink || !data.authenticated) return;
    authLink.textContent = `${data.user?.name || 'Konto'} · Logg ut`;
    authLink.href = '#logout';
    authLink.addEventListener('click', async (event) => {
      event.preventDefault();
      await fetch('/api/auth', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'logout' }) });
      window.location.href = '/';
    });
  }).catch(() => {});
</script>
</html>
