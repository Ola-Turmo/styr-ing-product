---
interface Props { title: string; activeNav?: string; }
const { title, activeNav = '' } = Astro.props;
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Styr.ing",
  url: "https://styr.ing",
  description: "Styr.ing er norsk SaaS for styrearbeid, økonomi, drift, risiko og virksomhetsoppfølging.",
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "customer support",
    email: "ola@styr.ing",
  },
  sameAs: [],
};
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Styr.ing",
  url: "https://styr.ing",
  description: "Offentlig konseptdemo for norsk styrearbeid og internkontroll",
  inLanguage: "nb-NO",
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Hva er Styr.ing?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Styr.ing er en offentlig konseptdemo med fiktive data. Ingen konto, produktaktivering eller produksjonsfunksjon tilbys på siden.",
      },
    },
    {
      "@type": "Question",
      name: "Kan jeg kjøpe eller registrere Styr.ing?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Styr.ing er SaaS-only. Den offentlige forhåndsvisningen har ikke selvbetjent registrering, checkout eller aktiv produksjonsinnlogging.",
      },
    },
    {
      "@type": "Question",
      name: "Er demoen juridisk rådgivning eller dokumentasjon på etterlevelse?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Nei. Virksomheten må selv identifisere, kvalitetssikre og oppfylle kravene som gjelder.",
      },
    },
  ],
};
---
<!doctype html>
<html lang="no">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} | Styr.ing</title>
  <meta name="description" content="Styr.ing samler styrearbeid, risiko, internkontroll og virksomhetsoppfølging i én norsk SaaS-arbeidsflate." />
  <meta name="keywords" content="styreportal, internkontroll, compliance, styreverktøy, norsk styre, Aksjeloven, GDPR, board portal, governance, Norway" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
  <meta property="og:title" content={`${title} | Styr.ing`} />
  <meta property="og:description" content="Én arbeidsflate for styre, risiko, kontroll og oppfølging." />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Styr.ing" />
  <meta property="og:locale" content="nb_NO" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
  <link rel="llms-txt" href="/llms.txt" />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <style>
    :root {
      --ink: #10241f;
      --muted: #5c6b65;
      --paper: #f6f2ea;
      --accent: #1f6f5b;
      --gold: #d8a94d;
      --night: #10241f;
      --glow: #dff7c9;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: Georgia, "Times New Roman", serif;
      background: radial-gradient(circle at 18% 0%, #fff8df 0%, var(--paper) 45%, #dfe9e3 100%);
      color: var(--ink);
      line-height: 1.6;
      overflow-wrap: anywhere;
    }
    main { min-width: 0; }
    .site-boundary {
      padding: 9px clamp(20px,5vw,60px);
      background: #fff4cf;
      border-bottom: 1px solid rgba(138,117,0,0.24);
      color: #655500;
      font-family: system-ui, sans-serif;
      font-size: 0.8rem;
      text-align: center;
    }
    a { color: var(--accent); text-decoration: none; }
    a:hover { color: #0d4a3a; }
    :focus-visible {
      outline: 3px solid #a94800;
      outline-offset: 3px;
    }

    nav {
      position: sticky; top: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 16px clamp(20px,5vw,60px);
      background: rgba(246,242,234,0.92);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(16,36,31,0.08);
    }
    .logo { display: inline-flex; align-items: center; gap: 9px; font-size: 1.25rem; font-weight: 700; letter-spacing: -0.02em; color: var(--ink); }
    .logo > span:last-child { color: var(--ink); }
    .logo-mark { width: 30px; height: 30px; border-radius: 10px; display: grid; place-items: center; background: var(--night); color: var(--glow); font: 700 1.05rem/1 Georgia, serif; box-shadow: 0 5px 14px rgba(16,36,31,.15); }
    .logo-dot { color: var(--accent); }
    .nav-links { display: flex; gap: 20px; list-style: none; font-family: system-ui, sans-serif; font-size: 0.85rem; align-items: center; }
    .nav-links a { color: var(--muted); font-weight: 500; }
    .nav-links a:hover { color: var(--accent); }
    .nav-links a.active { color: var(--accent); font-weight: 600; }
    .nav-cta {
      background: var(--accent); color: #fff;
      padding: 8px 18px; border-radius: 100px;
      font-family: system-ui, sans-serif; font-size: 0.8rem; font-weight: 600;
    }
    .nav-cta:hover { background: #0d4a3a; color: #fff; transform: translateY(-1px); }
    .mobile-nav-toggle { display: none; border: 1px solid rgba(16,36,31,.14); background: #fff; color: var(--ink); border-radius: 999px; padding: 8px 13px; font: 600 .78rem/1 system-ui, sans-serif; }

    .container { max-width: 1100px; margin: 0 auto; }
    [id] { scroll-margin-top: 80px; }

    @media (max-width: 760px) {
      nav { align-items: center; gap: 12px; flex-wrap: wrap; }
      .mobile-nav-toggle { display: inline-flex; margin-left: auto; }
      .nav-links { display: none; width: 100%; gap: 10px 14px; flex-wrap: wrap; padding-top: 4px; }
      .nav-links.open { display: flex; }
      .nav-cta { margin-left: 0 !important; }
    }

    footer {
      background: var(--ink); color: rgba(255,255,255,0.5);
      padding: 32px clamp(20px,5vw,60px); margin-top: 4rem;
      font-family: system-ui, sans-serif; font-size: 0.8rem;
    }
    .footer-inner { max-width: 1100px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; }
    .footer-inner a { color: rgba(255,255,255,0.5); }
    .footer-inner a:hover { color: rgba(255,255,255,0.8); }
  </style>
</head>
<body>
  <nav>
    <a href="/" class="logo" aria-label="Styr.ing forsiden"><span class="logo-mark">s</span><span>styr<span class="logo-dot">.</span>ing</span></a>
    <button class="mobile-nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">Meny</button>
    <ul id="primary-nav" class="nav-links" aria-label="Hovedmeny">
      <li><a href="/workspace" class={activeNav === 'workspace' ? 'active' : ''}>Arbeidsflate</a></li>
      <li><a href="/board" class={activeNav === 'boards' ? 'active' : ''}>Styre</a></li>
    <li><a href="/risk" class={activeNav === 'risk' ? 'active' : ''}>Risiko</a></li>
    <li><a href="/internkontroll" class={activeNav === 'internkontroll' ? 'active' : ''}>Kontroll</a></li>
    <li><a href="/onboarding" class={activeNav === 'onboarding' ? 'active' : ''}>Oppsett</a></li>
    <li><a href="/capabilities" class={activeNav === 'capabilities' ? 'active' : ''}>Produktkart</a></li>
      <li><a href="/platform" class={activeNav === 'platform' ? 'active' : ''}>Plattform</a></li>
      <li><a href="/events" class={activeNav === 'events' ? 'active' : ''}>Hendelser</a></li>
      <li><a href="/operations" class={activeNav === 'operations' ? 'active' : ''}>Cockpit</a></li>
      <li><a href="/finance" class={activeNav === 'finance' ? 'active' : ''}>Økonomi</a></li>
      <li><a href="/assets" class={activeNav === 'assets' ? 'active' : ''}>Anleggsmidler</a></li>
 <li><a href="/treasury" class={activeNav === 'treasury' ? 'active' : ''}>Lønn og likviditet</a></li> <li><a href="/forecast" class={activeNav === 'forecast' ? 'active' : ''}>Likviditetsprognose</a></li> <li><a href="/payroll" class={activeNav === 'payroll' ? 'active' : ''}>Ferie / OTP</a></li>
      <li><a href="/cards" class={activeNav === 'cards' ? 'active' : ''}>Kort og utlegg</a></li>
      <li><a href="/procurement" class={activeNav === 'procurement' ? 'active' : ''}>Innkjøp</a></li>
      <li><a href="/people" class={activeNav === 'people' ? 'active' : ''}>Mennesker</a></li>
      <li><a href="/it" class={activeNav === 'it' ? 'active' : ''}>IT og drift</a></li>
      <li><a href="/commercial" class={activeNav === 'commercial' ? 'active' : ''}>Kunder</a></li>
      <li><a href="/revenue" class={activeNav === 'revenue' ? 'active' : ''}>Inntekt</a></li>
      <li><a href="/governance" class={activeNav === 'governance' ? 'active' : ''}>Avtaler</a></li>
      <li><a href="/board-governance" class={activeNav === 'board-governance' ? 'active' : ''}>Møte og avstemning</a></li>
      <li><a href="/sustainability" class={activeNav === 'sustainability' ? 'active' : ''}>HMS og ESG</a></li>
      <li><a href="/field" class={activeNav === 'field' ? 'active' : ''}>Felt og prosjekt</a></li>
    <li><a href="/trust" class={activeNav === 'trust' ? 'active' : ''}>Tillit</a></li>
      <li><a href="/workspace#ai" class="nav-cta">Åpne demoen <span aria-hidden="true">↗</span></a></li>
    </ul>
  </nav>

  <div class="site-boundary" role="note">
    Styr.ing SaaS-preview · illustrasjonsdata i denne offentlige flaten · ingen reelle virksomhetsdata må legges inn.
  </div>

  <main>
    <slot />
  </main>

  <footer>
    <div class="footer-inner">
      <div>© 2026 Styr.ing — offentlig konseptdemo</div>
      <div>
        <a href="mailto:ola@styr.ing">ola@styr.ing</a>
      </div>
    </div>
  </footer>
</body>
<script is:inline>
  const toggle = document.querySelector('.mobile-nav-toggle');
  const nav = document.querySelector('#primary-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
</html>
