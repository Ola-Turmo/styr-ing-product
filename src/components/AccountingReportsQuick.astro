<section class="accounting-reports" aria-labelledby="accounting-reports-title">
  <div class="reports-head"><div><span class="section-kicker">Rapporter · bokførte bilag</span><h2 id="accounting-reports-title">Tallene du faktisk trenger</h2><p>Se resultat, balanse, saldobalanse og hovedbok for valgt periode. Rapportene hentes direkte fra bokførte bilagslinjer — aldri fra utkast eller forslag.</p></div><span class="reports-source">Kilde · hovedbok</span></div>
  <form id="reports-filter"><div><label>Fra<input name="from" type="month" value="2026-01" required /></label><label>Til<input name="to" type="month" value="2026-08" required /></label></div><nav aria-label="Rapporttype"><button type="button" data-report="profit-loss" class="active">Resultat</button><button type="button" data-report="balance-sheet">Balanse</button><button type="button" data-report="trial-balance">Saldobalanse</button><button type="button" data-report="general-ledger">Hovedbok</button></nav><button type="submit">Oppdater rapport</button><a id="report-csv" href="#">Last ned CSV</a></form>
  <div id="reports-status" class="reports-status" role="status" aria-live="polite">Henter resultatrapport…</div>
  <div id="reports-totals" class="reports-totals"></div>
  <div class="reports-table-wrap"><table><thead id="reports-head-row"></thead><tbody id="reports-body"></tbody></table></div>
</section>
<script is:inline>
  const repEsc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const repMoney=v=>`${(Number(v||0)/100).toLocaleString('nb-NO',{minimumFractionDigits:2,maximumFractionDigits:2})} kr`;
  let reportBoardId=new URLSearchParams(location.search).get('boardId')||'';let reportView='profit-loss';const repStatus=document.querySelector('#reports-status'),repBody=document.querySelector('#reports-body'),repHead=document.querySelector('#reports-head-row'),repTotals=document.querySelector('#reports-totals');
  const reportLabels={revenue:'Inntekt',expense:'Kostnad',asset:'Eiendel',liability:'Gjeld',equity:'Egenkapital'};
  const renderReport=d=>{const rows=d.data?.rows||[],t=d.data?.totals||{};if(reportView==='profit-loss'){repHead.innerHTML='<tr><th>Konto</th><th>Type</th><th>Periode</th></tr>';repBody.innerHTML=rows.map(x=>`<tr><td><strong>${repEsc(x.code)} · ${repEsc(x.name)}</strong></td><td>${repEsc(reportLabels[x.account_type]||x.account_type)}</td><td>${repMoney(x.periodBalanceMinor)}</td></tr>`).join('');repTotals.innerHTML=`<article><small>Driftsinntekter</small><strong>${repMoney(t.revenueMinor)}</strong></article><article><small>Kostnader</small><strong>${repMoney(t.expenseMinor)}</strong></article><article class="primary"><small>Resultat</small><strong>${repMoney(t.resultMinor)}</strong></article>`;}else if(reportView==='balance-sheet'){repHead.innerHTML='<tr><th>Konto</th><th>Type</th><th>Saldo</th></tr>';repBody.innerHTML=rows.map(x=>`<tr><td><strong>${repEsc(x.code)} · ${repEsc(x.name)}</strong></td><td>${repEsc(reportLabels[x.account_type]||x.account_type)}</td><td>${repMoney(x.closingBalanceMinor)}</td></tr>`).join('');repTotals.innerHTML=`<article><small>Eiendeler</small><strong>${repMoney(t.assetMinor)}</strong></article><article><small>Gjeld og egenkapital</small><strong>${repMoney(t.liabilitiesAndEquityMinor)}</strong></article><article class="${Number(t.differenceMinor)===0?'primary':'warn'}"><small>Differanse</small><strong>${repMoney(t.differenceMinor)}</strong></article>`;}else if(reportView==='trial-balance'){repHead.innerHTML='<tr><th>Konto</th><th>Inngående</th><th>Debet</th><th>Kredit</th><th>Utgående</th></tr>';repBody.innerHTML=rows.map(x=>`<tr><td><strong>${repEsc(x.code)} · ${repEsc(x.name)}</strong></td><td>${repMoney(x.openingBalanceMinor)}</td><td>${repMoney(x.debitMinor)}</td><td>${repMoney(x.creditMinor)}</td><td>${repMoney(x.closingBalanceMinor)}</td></tr>`).join('');repTotals.innerHTML=`<article><small>Debet</small><strong>${repMoney(t.debitMinor)}</strong></article><article><small>Kredit</small><strong>${repMoney(t.creditMinor)}</strong></article><article class="${t.balanced?'primary':'warn'}"><small>Kontroll</small><strong>${t.balanced?'Balansert':'Avvik'}</strong></article>`;}else{repHead.innerHTML='<tr><th>Bilag</th><th>Dato</th><th>Konto</th><th>Beskrivelse</th><th>Debet</th><th>Kredit</th></tr>';repBody.innerHTML=rows.map(x=>`<tr><td>${repEsc(x.voucher_number)}</td><td>${repEsc(x.voucher_date)}</td><td><strong>${repEsc(x.code)} · ${repEsc(x.name)}</strong></td><td>${repEsc(x.description||x.voucher_description)}</td><td>${repMoney(x.debit_minor)}</td><td>${repMoney(x.credit_minor)}</td></tr>`).join('');repTotals.innerHTML=`<article class="primary"><small>Bilagslinjer</small><strong>${repEsc(t.rowCount||0)}</strong></article>`;}if(!rows.length)repBody.innerHTML='<tr><td colspan="6">Ingen bokførte linjer i valgt periode.</td></tr>';};
  const loadReport=async()=>{if(!reportBoardId){const a=await(await fetch('/api/auth')).json();reportBoardId=a.boards?.[0]?.id||'';}if(!reportBoardId)throw new Error('Ingen virksomhet valgt');const f=new FormData(document.querySelector('#reports-filter')),from=f.get('from'),to=f.get('to');repStatus.textContent='Henter bokførte bilagslinjer…';const path=`/api/finance?boardId=${encodeURIComponent(reportBoardId)}&view=${reportView}&from=${encodeURIComponent(from)}&to=${encodeURIComponent(to)}`;const r=await fetch(path),d=await r.json();if(!r.ok)throw new Error(d.error||'Rapporten kunne ikke hentes');document.querySelector('#report-csv').href=path+'&format=csv';renderReport(d);repStatus.textContent=`✓ ${from}–${to} · kun bokførte bilag.`;};
  document.querySelectorAll('[data-report]').forEach(b=>b.addEventListener('click',()=>{reportView=b.dataset.report;document.querySelectorAll('[data-report]').forEach(x=>x.classList.toggle('active',x===b));loadReport().catch(e=>repStatus.textContent=`Kunne ikke hente rapport: ${e.message}`);}));document.querySelector('#reports-filter')?.addEventListener('submit',e=>{e.preventDefault();loadReport().catch(x=>repStatus.textContent=`Kunne ikke hente rapport: ${x.message}`)});loadReport().catch(e=>repStatus.textContent=`Kunne ikke hente rapport: ${e.message}`);
</script>
<style>
  .accounting-reports{margin:18px 0;padding:24px;border:1px solid rgba(16,36,31,.1);border-radius:18px;background:#f5f8f5}.reports-head{display:flex;justify-content:space-between;gap:20px}.accounting-reports h2{margin:8px 0;font:500 1.8rem/1 Georgia,serif}.accounting-reports p{max-width:700px;color:var(--muted);font:.8rem/1.5 system-ui,sans-serif}.reports-source{height:max-content;padding:8px 10px;border-radius:999px;background:#dff2d2;color:#27643f;font:700 .62rem system-ui,sans-serif;white-space:nowrap}#reports-filter{display:flex;align-items:end;gap:9px;margin:20px 0}#reports-filter>div{display:flex;gap:7px}#reports-filter label{display:grid;gap:4px;color:var(--muted);font:600 .62rem system-ui,sans-serif}#reports-filter input{padding:8px;border:1px solid rgba(16,36,31,.15);border-radius:8px;background:#fff}#reports-filter nav{display:flex;gap:4px}#reports-filter button,#report-csv{padding:9px 11px;border:0;border-radius:8px;background:#10241f;color:#fff;cursor:pointer;font:700 .65rem system-ui,sans-serif}#reports-filter nav button{background:#fff;color:var(--muted);border:1px solid rgba(16,36,31,.12)}#reports-filter nav button.active{background:#28624c;color:#fff}#report-csv{margin-left:auto;background:#28624c}.reports-status{color:#27643f;font:700 .68rem system-ui,sans-serif}.reports-totals{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:12px 0}.reports-totals article{padding:12px;border-radius:10px;background:#fff}.reports-totals small,.reports-totals strong{display:block}.reports-totals small{color:var(--muted);font:600 .62rem system-ui,sans-serif}.reports-totals strong{margin-top:7px;font:500 1.25rem Georgia,serif}.reports-totals article.primary{background:#10241f;color:#fff}.reports-totals article.warn{background:#fff2c9;color:#765a10}.reports-table-wrap{overflow:auto;border:1px solid rgba(16,36,31,.09);border-radius:11px;background:#fff}.accounting-reports table{width:100%;border-collapse:collapse;font:.68rem system-ui,sans-serif}.accounting-reports th,.accounting-reports td{padding:10px;text-align:left;border-bottom:1px solid rgba(16,36,31,.07);white-space:nowrap}.accounting-reports th{color:var(--muted);font-size:.6rem;text-transform:uppercase}.accounting-reports td:not(:first-child){text-align:right}@media(max-width:900px){#reports-filter{align-items:stretch;flex-direction:column}#report-csv{margin-left:0;text-align:center}.reports-head{flex-direction:column}.reports-totals{grid-template-columns:1fr}#reports-filter nav{overflow:auto}}
</style>
