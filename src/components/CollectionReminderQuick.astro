<section class="reminder-card" aria-labelledby="reminder-title">
  <div class="reminder-head"><div><span class="section-kicker">Forfalte fakturaer</span><h2 id="reminder-title">Lag et purringsutkast du kan lese først.</h2><p>Styr.ing fyller inn kunde, fakturanummer, forfall og restsaldo. Du kontrollerer teksten før eventuell utsending. Ingen gebyr, renter eller e-post sendes automatisk.</p></div><span class="reminder-badge">Utkast · HITL</span></div>
  <form id="reminder-form" class="reminder-form"><label>Forfalt faktura<select id="reminder-invoice" name="invoiceId" required><option value="">Henter åpne poster…</option></select></label><button type="submit">Lag purringsutkast</button></form>
  <div id="reminder-output" class="reminder-output" hidden><div class="reminder-meta"><strong id="reminder-subject"></strong><span id="reminder-summary"></span></div><pre id="reminder-body"></pre><div class="reminder-actions"><button type="button" id="reminder-approve">Godkjenn utkast for mulig utsending</button><span id="reminder-approve-status" role="status" aria-live="polite"></span></div></div>
  <p id="reminder-status" class="reminder-status" role="status" aria-live="polite"></p>
</section>
<script is:inline>
  const reminderEsc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const reminderMoney=v=>`${(Number(v||0)/100).toLocaleString('nb-NO')} kr`;
  let reminderBoardId=new URLSearchParams(location.search).get('boardId')||'', reminderDraftId='';
  const reminderApi=async(url,options)=>{const r=await fetch(url,options),d=await r.json();if(!r.ok)throw new Error(d.error||'Kunne ikke hente purringsutkast');return d;};
  const reminderLoad=async()=>{if(!reminderBoardId){const a=await (await fetch('/api/auth')).json();reminderBoardId=a.boards?.[0]?.id||'';}if(!reminderBoardId)throw new Error('Ingen virksomhet valgt');const d=await reminderApi(`/api/finance?boardId=${encodeURIComponent(reminderBoardId)}&view=receivables`);const rows=(d.data||[]).filter(x=>x.collection_status==='overdue'&&Number(x.outstanding_minor||0)>0);document.querySelector('#reminder-invoice').innerHTML=rows.length?rows.map(x=>`<option value="${reminderEsc(x.id)}">${reminderEsc(x.invoice_number)} · ${reminderMoney(x.outstanding_minor)} · ${reminderEsc(x.company_name||'Kunde')}</option>`).join(''):'<option value="">Ingen forfalte kundefakturaer</option>';};
  document.querySelector('#reminder-form')?.addEventListener('submit',async event=>{event.preventDefault();const status=document.querySelector('#reminder-status');status.textContent='Bygger utkast fra faktura og kundedata…';try{const d=await reminderApi('/api/collections',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({boardId:reminderBoardId,action:'prepare_reminder',invoiceId:new FormData(event.currentTarget).get('invoiceId')})});reminderDraftId=d.draftId;document.querySelector('#reminder-subject').textContent=d.subject;document.querySelector('#reminder-summary').textContent=`${reminderMoney(d.outstandingMinor)} · forfall ${d.dueDate} · checksum ${String(d.checksum||'').slice(0,12)}…`;document.querySelector('#reminder-body').textContent=d.body;document.querySelector('#reminder-output').hidden=false;status.textContent=d.idempotent?'✓ Viser eksisterende, uendret utkast.':'✓ Utkast klart for kontroll. Det er ikke sendt.';}catch(error){status.textContent=`Kunne ikke lage utkast: ${error.message}`;}});
  document.querySelector('#reminder-approve')?.addEventListener('click',async()=>{const status=document.querySelector('#reminder-approve-status');status.textContent='Godkjenner…';try{const d=await reminderApi('/api/collections',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({boardId:reminderBoardId,action:'approve_reminder',draftId:reminderDraftId})});status.textContent=`✓ Godkjent internt. Ekstern sending: ${d.externalDelivery}.`;document.querySelector('#reminder-approve').disabled=true;}catch(error){status.textContent=`Kunne ikke godkjenne: ${error.message}`;}});
  reminderLoad().catch(error=>{document.querySelector('#reminder-status').textContent=`Kunne ikke laste forfalte fakturaer: ${error.message}`;});
</script>
<style>
  .reminder-card{margin:18px 0;padding:24px;border:1px solid rgba(16,36,31,.1);border-radius:18px;background:#fffdf4}.reminder-head{display:flex;justify-content:space-between;gap:20px}.reminder-card h2{margin:8px 0;font:500 1.8rem/1 Georgia,serif}.reminder-card p{max-width:720px;color:var(--muted);font:.8rem/1.5 system-ui,sans-serif}.reminder-badge{height:max-content;padding:8px 10px;border-radius:999px;background:#fff0ca;color:#75570c;font:700 .62rem system-ui,sans-serif;white-space:nowrap}.reminder-form{display:flex;align-items:end;gap:10px;margin-top:18px}.reminder-form label{display:grid;gap:5px;flex:1;color:var(--muted);font:600 .64rem system-ui,sans-serif}.reminder-form select{padding:9px;border:1px solid rgba(16,36,31,.15);border-radius:8px;background:#fff}.reminder-form button,.reminder-actions button{padding:10px 13px;border:0;border-radius:8px;background:#28624c;color:#fff;cursor:pointer;font:700 .67rem system-ui,sans-serif}.reminder-output{margin-top:18px;padding:16px;border:1px solid rgba(16,36,31,.1);border-radius:12px;background:#fff}.reminder-meta{display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;font:700 .72rem system-ui,sans-serif}.reminder-meta span{color:var(--muted);font-weight:500}.reminder-output pre{margin:14px 0;padding:14px;white-space:pre-wrap;border-radius:8px;background:#f5f8f5;color:var(--ink);font:.78rem/1.55 system-ui,sans-serif}.reminder-actions{display:flex;align-items:center;gap:12px;flex-wrap:wrap}.reminder-actions button:disabled{opacity:.55}.reminder-actions span,.reminder-status{color:#27643f;font:700 .68rem system-ui,sans-serif}.reminder-status{min-height:1em;margin:11px 0 0}@media(max-width:680px){.reminder-head{display:block}.reminder-badge{display:inline-block;margin-top:13px}.reminder-form{display:grid}.reminder-form button{width:100%}}
</style>
