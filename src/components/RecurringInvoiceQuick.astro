<section class="recurring-invoice-quick" aria-labelledby="recurring-invoice-title">
  <div class="recurring-head"><div><span class="section-kicker">Kundefordringer · tidsbesparende</span><h2 id="recurring-invoice-title">Gjenta fakturaer uten å glemme kontrollen.</h2><p>Bruk en enkel mal for faste leveranser. Hver kjøring lager et vanlig fakturautkast med neste forfallsdato — du kontrollerer og godkjenner før sending eller bokføring.</p></div><span class="recurring-boundary">Utkast · ikke automatisk sendt</span></div>
  <div class="recurring-grid">
    <form id="recurring-create-form"><h3>Ny fakturamal</h3><label>Kunde<select name="accountId" id="recurring-account" required><option value="">Henter kunder…</option></select></label><label>Navn på mal<input name="name" required maxlength="120" placeholder="Fast månedsavtale" /></label><label>Beskrivelse på faktura<input name="description" required maxlength="200" placeholder="Rådgivning – august" /></label><div class="recurring-two"><label>Pris per periode (kr)<input name="unitPrice" type="number" min="0.01" step="0.01" required /></label><label>MVA<select name="vatRate"><option value="0">Ingen MVA</option><option value="15">15 %</option><option value="25" selected>25 %</option></select></label></div><div class="recurring-two"><label>Intervall<select name="interval"><option value="month">Hver måned</option><option value="quarter">Hvert kvartal</option><option value="year">Hvert år</option></select></label><label>Første fakturadato<input name="nextIssueDate" type="date" required /></label></div><label>Forfall etter (dager)<input name="dueDays" type="number" min="0" max="365" value="14" required /></label><button type="submit">Lagre fakturamal</button></form>
    <form id="recurring-generate-form"><h3>Lag neste utkast</h3><label>Aktiv mal<select name="templateId" id="recurring-template" required><option value="">Henter maler…</option></select></label><label>Fakturadato (valgfritt)<input name="issueDate" type="date" /></label><p class="recurring-help">Kjøringen er idempotent: samme mal og dato gir ikke et dobbelt fakturautkast.</p><button type="submit">Lag fakturautkast</button></form>
  </div>
  <p id="recurring-status" class="recurring-status" role="status" aria-live="polite"></p>
  <div id="recurring-list" class="recurring-list"><p>Henter fakturakø…</p></div>
</section>
<script is:inline>
  const recurringEsc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const recurringMoney=v=>(Number(v||0)/100).toLocaleString('nb-NO',{style:'currency',currency:'NOK'});
  const recurringInterval={month:'månedlig',quarter:'kvartalsvis',year:'årlig'};
  let recurringBoardId=new URLSearchParams(location.search).get('boardId')||''; const recurringStatus=document.querySelector('#recurring-status');
  const recurringJson=async(url,options)=>{const r=await fetch(url,options),d=await r.json();if(!r.ok)throw Error(d.detail||d.error||'Kunne ikke gjennomføre handlingen');return d;};
  const recurringResolve=async()=>{if(recurringBoardId)return;const a=await recurringJson('/api/auth');recurringBoardId=a.boards?.[0]?.id||'';if(!recurringBoardId)throw Error('Ingen virksomhet valgt');};
  const recurringLoad=async()=>{await recurringResolve();const [customers,templates,generations]=await Promise.all([recurringJson(`/api/finance?boardId=${encodeURIComponent(recurringBoardId)}&view=customers`),recurringJson(`/api/finance?boardId=${encodeURIComponent(recurringBoardId)}&view=recurring-templates`),recurringJson(`/api/finance?boardId=${encodeURIComponent(recurringBoardId)}&view=recurring-generations`)]);const c=customers.data||[],t=templates.data||[],g=generations.data||[];document.querySelector('#recurring-account').innerHTML=c.length?c.map(x=>`<option value="${recurringEsc(x.id)}">${recurringEsc(x.company_name)}</option>`).join(''):'<option value="">Opprett kunde først</option>';const active=t.filter(x=>x.status==='active');const select=document.querySelector('#recurring-template');select.innerHTML=active.length?active.map(x=>`<option value="${recurringEsc(x.id)}">${recurringEsc(x.name)} · ${recurringEsc(x.company_name)} · neste ${recurringEsc(x.next_issue_date)}</option>`).join(''):'<option value="">Ingen aktive maler</option>';select.disabled=!active.length;select.closest('form')?.querySelector('button[type="submit"]')?.toggleAttribute('disabled',!active.length);document.querySelector('#recurring-list').innerHTML=(t.length||g.length)?[...t.map(x=>`<article><div><strong>${recurringEsc(x.name)} · ${recurringEsc(x.company_name)}</strong><small>${recurringMoney(x.unit_price_minor)} · ${recurringEsc(recurringInterval[x.interval]||x.interval)} · neste ${recurringEsc(x.next_issue_date)} · ${x.generated_count||0} utkast</small></div><span>${recurringEsc(x.status)}</span></article>`),...g.slice(0,8).map(x=>`<article class="generation"><div><strong>Utkast ${recurringEsc(x.invoice_number)} · ${recurringEsc(x.company_name)}</strong><small>${recurringEsc(x.issue_date)} · ${recurringEsc(x.template_name)} · faktura ${recurringEsc(x.invoice_status)}</small></div><span>${recurringMoney(x.total_minor||0)}</span></article>`)].join(''):'<p>Ingen fakturakø registrert ennå.</p>';};
  const recurringPost=async(payload,form)=>{const button=form.querySelector('button[type="submit"]');button.disabled=true;recurringStatus.textContent='Lagrer kontrollspor…';try{const d=await recurringJson('/api/finance',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({...payload,boardId:recurringBoardId})});recurringStatus.textContent=d.idempotent?`✓ Utkastet finnes allerede for ${d.issueDate||'datoen'}.`:`✓ ${d.action==='create_recurring_template'?'Fakturamalen er lagret.':`Fakturautkast ${d.invoiceNumber||''} er opprettet.`} Kontroller det i fakturaflyten før godkjenning.`;form.reset();await recurringLoad();}catch(e){recurringStatus.textContent=`Kunne ikke lagre: ${e.message}`;}finally{button.disabled=false;}};
  document.querySelector('#recurring-create-form')?.addEventListener('submit',e=>{e.preventDefault();const f=new FormData(e.currentTarget);recurringPost({action:'create_recurring_template',accountId:f.get('accountId'),name:f.get('name'),description:f.get('description'),unitPriceMinor:Math.round(Number(f.get('unitPrice'))*100),vatRate:Number(f.get('vatRate')),interval:f.get('interval'),nextIssueDate:f.get('nextIssueDate'),dueDays:Number(f.get('dueDays'))},e.currentTarget);});
  document.querySelector('#recurring-generate-form')?.addEventListener('submit',e=>{e.preventDefault();const f=new FormData(e.currentTarget);recurringPost({action:'generate_recurring_invoice',templateId:f.get('templateId'),issueDate:f.get('issueDate')||undefined},e.currentTarget);});
  recurringLoad().catch(e=>{recurringStatus.textContent=e.message;});
</script>
<style>
  .recurring-invoice-quick{margin:18px 0;padding:24px;border:1px solid rgba(16,36,31,.1);border-radius:18px;background:#fffdf4}.recurring-head{display:flex;justify-content:space-between;gap:20px}.recurring-head h2{margin:8px 0;font:500 1.8rem/1 Georgia,serif}.recurring-head p{max-width:730px;color:var(--muted);font:.8rem/1.5 system-ui,sans-serif}.recurring-boundary{height:max-content;padding:8px 10px;border-radius:999px;background:#fff1d5;color:#816021;font:700 .62rem/1 system-ui,sans-serif;white-space:nowrap}.recurring-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:18px}.recurring-grid form{display:grid;gap:9px;padding:16px;border:1px solid rgba(16,36,31,.09);border-radius:13px;background:#fff}.recurring-grid h3{margin:0;font:700 .8rem/1.2 system-ui,sans-serif}.recurring-grid label{display:grid;gap:5px;color:var(--muted);font:600 .62rem/1.2 system-ui,sans-serif}.recurring-grid input,.recurring-grid select{width:100%;box-sizing:border-box;padding:9px;border:1px solid rgba(16,36,31,.15);border-radius:8px;background:#fff;font:.72rem system-ui,sans-serif}.recurring-two{display:grid;grid-template-columns:1fr 1fr;gap:8px}.recurring-grid button{margin-top:auto;justify-self:start;padding:10px 13px;border:0;border-radius:8px;background:#28624c;color:#fff;cursor:pointer;font:700 .67rem/1 system-ui,sans-serif}.recurring-grid button:disabled{opacity:.55}.recurring-help{margin:0;color:var(--muted);font:.67rem/1.45 system-ui,sans-serif}.recurring-status{min-height:1.2em;margin:14px 0 0;color:#27643f;font:700 .7rem/1.4 system-ui,sans-serif}.recurring-list{display:grid;gap:7px;margin-top:12px}.recurring-list article{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center;padding:12px 13px;border-radius:10px;background:#fff;border:1px solid rgba(16,36,31,.08)}.recurring-list strong,.recurring-list small{display:block}.recurring-list small{margin-top:4px;color:var(--muted);font:.65rem/1.35 system-ui,sans-serif}.recurring-list span{color:#28624c;font:700 .62rem/1 system-ui,sans-serif}.recurring-list .generation{background:#eef5e9}@media(max-width:700px){.recurring-head{display:block}.recurring-boundary{display:inline-flex;margin-top:10px}.recurring-grid{grid-template-columns:1fr}.recurring-list article{display:block}.recurring-list span{display:block;margin-top:7px}}@media(max-width:450px){.recurring-two{grid-template-columns:1fr}}
</style>
