<section class="asset-register-quick" aria-labelledby="asset-register-title">
  <div class="asset-register-head"><div><span class="section-kicker">Eiendeler · anlegg</span><h2 id="asset-register-title">Hold orden på utstyr og avskrivning.</h2><p>Registrer maskiner, inventar og annet utstyr. Styr.ing skiller regnskapsmessig avskrivning fra skattemessig estimat, og lager først bokføringsforslag etter godkjenning.</p></div><span class="asset-register-boundary">Ingen automatisk bokføring</span></div>
  <div class="asset-register-grid">
    <form data-asset-action="create_asset"><h3>1. Ny eiendel</h3><label>Eiendelsnummer<input name="assetNumber" required placeholder="AM-2026-001" /></label><label>Navn<input name="name" required placeholder="Arbeidsutstyr" /></label><div class="asset-row"><label>Kategori<input name="category" required placeholder="Inventar" /></label><label>Kjøpsdato<input name="acquisitionDate" type="date" required /></label></div><div class="asset-row"><label>Kost i kroner<input name="cost" type="number" min="0.01" step="0.01" required placeholder="25 000" /></label><label>Restverdi<input name="residual" type="number" min="0" step="0.01" value="0" required /></label></div><div class="asset-row"><label>Levetid (måneder)<input name="life" type="number" min="1" max="1200" required placeholder="60" /></label><label>Metode<select name="method"><option value="linear">Lineær</option><option value="declining_balance">Saldo-lignende kontrollspor</option><option value="none">Ingen</option></select></label></div><div class="asset-row"><label>Skattegruppe<input name="taxGroup" maxlength="10" placeholder="d" /></label><label>Skattesats %<input name="taxRate" type="number" min="0" max="100" step="0.1" value="20" /></label></div><button type="submit">Opprett eiendel</button></form>
    <form data-asset-action="calculate_depreciation"><h3>2. Beregn periode</h3><label>Eiendel<select name="assetId" id="quick-asset-id" required><option value="">Henter eiendeler…</option></select></label><label>Periode<input name="period" type="month" required /></label><button type="submit">Beregn begge spor</button><small>Kontroller levetid, restverdi og skattesats før godkjenning.</small></form>
    <form data-asset-action="approve_depreciation"><h3>3. Godkjenn regnskapspost</h3><label>Avskrivning<select name="entryId" id="quick-depreciation-id" required><option value="">Henter poster…</option></select></label><button type="submit">Godkjenn beregning</button><small>Skatteposten brukes kun som kontrollgrunnlag.</small></form>
    <form data-asset-action="post_depreciation"><h3>4. Forbered bokføring</h3><label>Godkjent regnskapspost<select name="entryId" id="quick-approved-depreciation-id" required><option value="">Henter godkjente…</option></select></label><label>Avskrivningskostnad<select name="expenseAccountId" id="quick-asset-expense-account" required><option value="">Henter kontoer…</option></select></label><label>Akkumulert avskrivning<select name="accumulatedAccountId" id="quick-asset-accumulated-account" required><option value="">Henter kontoer…</option></select></label><button type="submit">Bokfør kontrollert bilag</button><small>Oppretter et balansert bilag i valgt periode.</small></form>
  </div>
  <p id="asset-register-status" class="asset-register-status" role="status" aria-live="polite"></p><div id="asset-register-list" class="asset-register-list"><p>Henter eiendeler…</p></div>
</section>
<script is:inline>
  const assetQuickEsc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); const assetQuickMoney=v=>`${(Number(v||0)/100).toLocaleString('nb-NO',{minimumFractionDigits:2,maximumFractionDigits:2})} kr`; let assetQuickBoardId=new URLSearchParams(location.search).get('boardId')||''; let assetQuickRows=[]; let assetQuickDep=[]; const assetQuickStatus=document.querySelector('#asset-register-status');
  const assetQuickResolve=async()=>{if(assetQuickBoardId)return assetQuickBoardId;try{const a=await(await fetch('/api/auth')).json();assetQuickBoardId=a.boards?.[0]?.id||''}catch{}return assetQuickBoardId||'board-1'}; const assetQuickApi=async(payload)=>{const r=await fetch('/api/assets',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({...payload,boardId:assetQuickBoardId})});const d=await r.json();if(!r.ok)throw Error(d.detail||d.error||'Kunne ikke lagre');return d}; const assetQuickLoad=async()=>{await assetQuickResolve();const [a,d,accounts]=await Promise.all([fetch(`/api/assets?boardId=${encodeURIComponent(assetQuickBoardId)}&view=assets`).then(r=>r.json()),fetch(`/api/assets?boardId=${encodeURIComponent(assetQuickBoardId)}&view=depreciation`).then(r=>r.json()),fetch(`/api/finance?boardId=${encodeURIComponent(assetQuickBoardId)}&view=accounts`).then(r=>r.json())]);assetQuickRows=a.data||[];assetQuickDep=d.data||[];const opts=(accounts.data||[]).filter(x=>x.active).map(x=>`<option value="${assetQuickEsc(x.id)}">${assetQuickEsc(x.code)} · ${assetQuickEsc(x.name)}</option>`).join('');document.querySelector('#quick-asset-expense-account').innerHTML=opts||'<option value="">Ingen aktive kontoer</option>';document.querySelector('#quick-asset-accumulated-account').innerHTML=opts||'<option value="">Ingen aktive kontoer</option>';document.querySelector('#quick-asset-id').innerHTML=assetQuickRows.filter(x=>x.status==='active').map(x=>`<option value="${assetQuickEsc(x.id)}">${assetQuickEsc(x.asset_number)} · ${assetQuickEsc(x.name)}</option>`).join('')||'<option value="">Ingen aktive eiendeler</option>';const open=assetQuickDep.filter(x=>x.status==='calculated'||x.status==='review');const approved=assetQuickDep.filter(x=>x.status==='approved'&&x.ledger_type==='financial');document.querySelector('#quick-depreciation-id').innerHTML=open.map(x=>`<option value="${assetQuickEsc(x.id)}">${assetQuickEsc(x.period)} · ${assetQuickEsc(x.asset_number)} · ${assetQuickEsc(x.ledger_type)} · ${assetQuickMoney(x.amount_minor)}</option>`).join('')||'<option value="">Ingen poster til kontroll</option>';document.querySelector('#quick-approved-depreciation-id').innerHTML=approved.map(x=>`<option value="${assetQuickEsc(x.id)}">${assetQuickEsc(x.period)} · ${assetQuickEsc(x.asset_number)} · ${assetQuickMoney(x.amount_minor)}</option>`).join('')||'<option value="">Ingen godkjente regnskapsposter</option>';document.querySelector('#asset-register-list').innerHTML=assetQuickRows.map(x=>`<article><div><strong>${assetQuickEsc(x.asset_number)} · ${assetQuickEsc(x.name)}</strong><small>${assetQuickEsc(x.category)} · kost ${assetQuickMoney(x.acquisition_cost_minor)} · bokført avskrevet ${assetQuickMoney(x.financial_accumulated_minor)} · skatt ${assetQuickMoney(x.tax_accumulated_minor)}</small></div><span>${assetQuickEsc(x.status)}</span></article>`).join('')||'<p>Ingen eiendeler registrert ennå.</p>';};
  document.querySelectorAll('[data-asset-action]').forEach(form=>form.addEventListener('submit',async e=>{e.preventDefault();const f=new FormData(form);const payload={action:form.dataset.assetAction};for(const[k,v]of f.entries())payload[k]=v;if(payload.cost)payload.acquisitionCostMinor=Math.round(Number(payload.cost)*100);if(payload.residual)payload.residualValueMinor=Math.round(Number(payload.residual)*100);if(payload.life)payload.usefulLifeMonths=Number(payload.life);if(payload.taxRate)payload.taxRatePercent=Number(payload.taxRate);if(payload.method)payload.financialMethod=payload.method;assetQuickStatus.textContent='Lagrer og skriver kontrollspor…';try{const d=await assetQuickApi(payload);assetQuickStatus.textContent=d.action==='post_depreciation'?`✓ Avskrivning bokført som bilag ${d.voucherNumber}.`:`✓ ${d.action} er registrert · ${d.status||'ok'}.`;if(form.dataset.assetAction==='create_asset'||form.dataset.assetAction==='post_depreciation')form.reset();await assetQuickLoad()}catch(err){assetQuickStatus.textContent=`Kunne ikke lagre: ${err.message}`}}));assetQuickLoad().catch(()=>{assetQuickStatus.textContent='Eiendelsbildet er midlertidig utilgjengelig.'});
</script>
<style>
  .asset-register-quick{margin:18px 0;padding:24px;border:1px solid rgba(16,36,31,.1);border-radius:18px;background:#f8f4e8}.asset-register-head{display:flex;justify-content:space-between;gap:20px}.asset-register-head h2{margin:8px 0;font:500 1.8rem/1 Georgia,serif}.asset-register-head p{max-width:730px;color:var(--muted);font:.8rem/1.5 system-ui,sans-serif}.asset-register-boundary{height:max-content;padding:8px 10px;border-radius:999px;background:#fff2c9;color:#765a10;font:700 .62rem/1 system-ui,sans-serif;white-space:nowrap}.asset-register-grid{display:grid;grid-template-columns:1.15fr .85fr .85fr 1fr;gap:10px;margin-top:20px}.asset-register-grid form{display:grid;gap:8px;padding:15px;border-radius:12px;background:#fff;border:1px solid rgba(16,36,31,.08)}.asset-register-grid h3{margin:0;font:700 .78rem/1.2 system-ui,sans-serif}.asset-register-grid label{display:grid;gap:4px;color:var(--muted);font:600 .62rem/1.2 system-ui,sans-serif}.asset-register-grid input,.asset-register-grid select{width:100%;box-sizing:border-box;padding:8px;border:1px solid rgba(16,36,31,.15);border-radius:7px;background:#fff;font:.72rem system-ui,sans-serif}.asset-register-grid button{margin-top:auto;padding:9px;border:0;border-radius:8px;background:#84703c;color:#fff;cursor:pointer;font:700 .67rem/1 system-ui,sans-serif}.asset-register-grid small{color:var(--muted);font:.64rem/1.4 system-ui,sans-serif}.asset-row{display:grid;grid-template-columns:1fr 1fr;gap:7px}.asset-register-status{min-height:1.2em;margin:13px 0 6px;color:#765a10;font:700 .7rem/1.3 system-ui,sans-serif}.asset-register-list{display:grid;gap:7px}.asset-register-list article{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center;padding:12px 13px;border-radius:9px;background:#fff;border:1px solid rgba(16,36,31,.08);font-family:system-ui,sans-serif}.asset-register-list strong,.asset-register-list small{display:block}.asset-register-list small{margin-top:4px;color:var(--muted);font-size:.65rem}.asset-register-list span{color:#84703c;font:700 .62rem/1 system-ui,sans-serif}@media(max-width:1100px){.asset-register-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.asset-register-quick{padding:18px}.asset-register-head{display:block}.asset-register-boundary{display:inline-flex;margin-top:10px}.asset-register-grid{grid-template-columns:1fr}.asset-row{grid-template-columns:1fr}}
</style>
