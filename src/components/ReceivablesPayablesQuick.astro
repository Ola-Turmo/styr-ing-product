<section class="cash-control" aria-labelledby="cash-control-title">
  <div class="cash-control-head">
    <div>
      <span class="section-kicker">Forfall · arbeidskapital</span>
      <h2 id="cash-control-title">Hva skal inn — og hva skal ut?</h2>
      <p>Se åpne kunde- og leverandørposter i samme bilde. Registrer en betaling manuelt, eller koble en allerede godkjent banktransaksjon. Saldoen endres først når betalingen er bokført.</p>
    </div>
    <span class="cash-control-boundary">Kontrollert bokføring</span>
  </div>
  <div class="cash-control-metrics" aria-label="Nøkkeltall for åpne poster">
    <article><small>Kundefordringer</small><strong id="cash-receivable-total">—</strong><span id="cash-receivable-open">Laster åpne poster</span></article>
    <article><small>Leverandørgjeld</small><strong id="cash-payable-total">—</strong><span id="cash-payable-open">Laster åpne poster</span></article>
    <article class="warn"><small>Forfalt</small><strong id="cash-overdue-total">—</strong><span id="cash-overdue-count">Laster forfalte poster</span></article>
  </div>
  <div class="cash-control-grid">
    <div><h3>Inn · kundefordringer</h3><div id="cash-receivables" class="cash-list" aria-live="polite"><p>Henter åpne poster …</p></div></div>
    <div><h3>Ut · leverandørgjeld</h3><div id="cash-payables" class="cash-list" aria-live="polite"><p>Henter åpne poster …</p></div></div>
  </div>
  <form id="cash-payment-form" class="cash-payment-form">
    <h3>Registrer mottatt eller utført betaling</h3>
    <div class="cash-payment-row">
      <label>Type<select name="kind"><option value="receivable">Kundefaktura</option><option value="payable">Leverandørfaktura</option></select></label>
      <label>Åpen post<select name="invoiceId" id="cash-payment-invoice" required><option value="">Henter …</option></select></label>
      <label>Beløp i kroner <span class="label-note">valgfritt</span><input name="amountMinor" type="number" min="0.01" step="0.01" inputmode="decimal" placeholder="Hele restbeløpet" /></label>
      <label>Godkjent banktransaksjon<select name="bankTransactionId" id="cash-payment-bank"><option value="">Ingen — manuell registrering</option></select></label>
      <label>Referanse<input name="paymentReference" maxlength="120" placeholder="KID eller bankreferanse" /></label>
      <button type="submit">Registrer betaling</button>
    </div>
    <p class="cash-help">Delbetalinger oppdaterer restbeløpet. Bankkobling kontrollerer beløp og retning; selve bokføringen skjer i Bankavstemming.</p>
    <p id="cash-control-status" class="cash-status" role="status" aria-live="polite"></p>
  </form>
  <form id="collection-case-form" class="cash-payment-form reminder-form">
    <h3>Forfalt faktura · lag purringsutkast</h3>
    <div class="cash-payment-row reminder-row">
      <label>Forfalt kundefaktura<select name="invoiceId" id="collection-invoice-id" required><option value="">Henter …</option></select></label>
      <button type="submit">Lag kontrollert utkast</button>
    </div>
    <p class="cash-help">Utkastet bruker restsaldo, delbetalinger og bokførte kreditnotaer. Utsending er ikke konfigurert og krever alltid menneskelig godkjenning.</p>
    <p id="collection-case-status" class="cash-status" role="status" aria-live="polite"></p>
  </form>
</section>

<script is:inline>
  const cashEsc = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]);
  const cashMoney = (minor) => `${(Number(minor || 0) / 100).toLocaleString('nb-NO', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} kr`;
  const cashRemaining = (row, kind) => kind === 'receivable' ? Math.max(0, Number(row.outstanding_minor ?? row.total_minor ?? 0)) : Math.max(0, Number(row.amount_minor || 0) - Number(row.paid_minor || 0));
  const cashLabel = (status) => ({ overdue: 'forfalt', paid: 'betalt', approved: 'godkjent', booked: 'bokført', matched: 'matchet', ready_to_pay: 'klar for betaling', needs_review: 'krever kontroll', sent: 'sendt', draft: 'utkast', review: 'til kontroll' }[status] || status || 'ukjent');
  let cashBoardId = new URLSearchParams(location.search).get('boardId') || '';
  let cashReceivables = [], cashPayables = [], cashTransactions = [];
  const cashStatus = document.querySelector('#cash-control-status');
  const cashApi = async (url, options) => { const response = await fetch(url, options); const data = await response.json(); if (!response.ok) throw new Error(data.detail || data.error || 'Kunne ikke hente betalingsbildet'); return data; };
  const fillBankOptions = () => {
    const kind = document.querySelector('[name="kind"]').value; const invoiceId = document.querySelector('#cash-payment-invoice').value; const rows = kind === 'receivable' ? cashReceivables : cashPayables; const invoice = rows.find((row) => row.id === invoiceId); const target = cashRemaining(invoice || {}, kind);
    const candidates = cashTransactions.filter((row) => row.status === 'approved' && !row.posted_voucher_id && !row.payment_link_id && Math.abs(Number(row.amount_minor || 0)) === target && (kind === 'receivable' ? Number(row.amount_minor) > 0 : Number(row.amount_minor) < 0));
    document.querySelector('#cash-payment-bank').innerHTML = `<option value="">Ingen — manuell registrering</option>${candidates.map((row) => `<option value="${cashEsc(row.id)}">${cashEsc(row.transaction_date)} · ${cashEsc(row.description)} · ${cashMoney(Math.abs(Number(row.amount_minor)))}</option>`).join('')}`;
  };
  const fillPaymentOptions = () => {
    const kind = document.querySelector('[name="kind"]').value; const rows = kind === 'receivable' ? cashReceivables.filter((row) => cashRemaining(row, kind) > 0) : cashPayables.filter((row) => row.status !== 'paid' && ['approved', 'booked', 'matched'].includes(row.status));
    document.querySelector('#cash-payment-invoice').innerHTML = rows.length ? rows.map((row) => `<option value="${cashEsc(row.id)}">${cashEsc(row.invoice_number)} · ${cashMoney(cashRemaining(row, kind))} · ${cashEsc(row.company_name || row.supplier_name || 'Uten navn')}</option>`).join('') : '<option value="">Ingen åpne poster</option>'; fillBankOptions();
  };
  const renderCash = () => {
    const receivables = cashReceivables.filter((row) => cashRemaining(row, 'receivable') > 0); const payables = cashPayables.filter((row) => cashRemaining(row, 'payable') > 0); const overdue = [...receivables.filter((row) => row.collection_status === 'overdue'), ...payables.filter((row) => row.payment_status === 'overdue')];
    document.querySelector('#cash-receivable-total').textContent = cashMoney(receivables.reduce((sum, row) => sum + cashRemaining(row, 'receivable'), 0)); document.querySelector('#cash-receivable-open').textContent = `${receivables.length} åpne poster`; document.querySelector('#cash-payable-total').textContent = cashMoney(payables.reduce((sum, row) => sum + cashRemaining(row, 'payable'), 0)); document.querySelector('#cash-payable-open').textContent = `${payables.length} åpne poster`; document.querySelector('#cash-overdue-total').textContent = cashMoney(overdue.reduce((sum, row) => sum + cashRemaining(row, row.collection_status ? 'receivable' : 'payable'), 0)); document.querySelector('#cash-overdue-count').textContent = `${overdue.length} forfalte poster`;
    document.querySelector('#cash-receivables').innerHTML = receivables.length ? receivables.map((row) => `<article class="${row.collection_status === 'overdue' ? 'overdue' : ''}"><div><strong>${cashEsc(row.invoice_number)} · ${cashEsc(row.company_name || 'Kunde')}</strong><small>Forfall ${cashEsc(row.due_date || 'ikke satt')} · ${cashEsc(cashLabel(row.collection_status))}${Number(row.credited_minor || 0) ? ` · kreditert ${cashMoney(row.credited_minor)}` : ''}</small></div><b>${cashMoney(cashRemaining(row, 'receivable'))}</b></article>`).join('') : '<p>Ingen åpne kundefakturaer.</p>';
    document.querySelector('#cash-payables').innerHTML = payables.length ? payables.map((row) => `<article class="${row.payment_status === 'overdue' ? 'overdue' : ''}"><div><strong>${cashEsc(row.invoice_number)} · ${cashEsc(row.supplier_name || 'Leverandør')}</strong><small>Forfall ${cashEsc(row.due_date || 'ikke satt')} · ${cashEsc(cashLabel(row.payment_status))}</small></div><b>${cashMoney(cashRemaining(row, 'payable'))}</b></article>`).join('') : '<p>Ingen åpne leverandørfakturaer.</p>';
    fillPaymentOptions();
  };
  const loadCash = async () => {
    if (!cashBoardId) { const auth = await (await fetch('/api/auth')).json(); cashBoardId = auth.boards?.[0]?.id || ''; } if (!cashBoardId) throw new Error('Ingen virksomhet valgt'); const query = encodeURIComponent(cashBoardId);
    const [receivables, payables, bank] = await Promise.all([cashApi(`/api/finance?boardId=${query}&view=receivables`), cashApi(`/api/finance?boardId=${query}&view=payables`), cashApi(`/api/bank?boardId=${query}&view=transactions`)]); cashReceivables = receivables.data || []; cashPayables = payables.data || []; cashTransactions = bank.data || []; renderCash();
    const overdue = cashReceivables.filter((row) => row.collection_status === 'overdue' && cashRemaining(row, 'receivable') > 0); document.querySelector('#collection-invoice-id').innerHTML = overdue.length ? overdue.map((row) => `<option value="${cashEsc(row.id)}">${cashEsc(row.invoice_number)} · ${cashMoney(cashRemaining(row, 'receivable'))} · ${cashEsc(row.company_name || 'Kunde')}</option>`).join('') : '<option value="">Ingen forfalte kundefakturaer</option>';
  };
  document.querySelector('[name="kind"]')?.addEventListener('change', fillPaymentOptions); document.querySelector('#cash-payment-invoice')?.addEventListener('change', fillBankOptions);
  document.querySelector('#cash-payment-form')?.addEventListener('submit', async (event) => { event.preventDefault(); const form = event.currentTarget; const fields = new FormData(form); const kind = fields.get('kind'); const bankTransactionId = fields.get('bankTransactionId'); const amount = fields.get('amountMinor'); cashStatus.textContent = 'Lagrer betaling i kontrollsporet …'; try { let data; if (bankTransactionId) { data = await cashApi('/api/bank', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ boardId: cashBoardId, action: 'link_payment', transactionId: bankTransactionId, entityType: kind === 'receivable' ? 'sales_invoice' : 'supplier_invoice', entityId: fields.get('invoiceId') }) }); cashStatus.textContent = `✓ ${cashMoney(data.amountMinor)} koblet. Gjenstår ${cashMoney(data.remainingMinor)}. Bokfør matchen i Bankavstemming.`; } else { data = await cashApi(kind === 'receivable' ? '/api/finance' : '/api/procurement', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ boardId: cashBoardId, action: 'record_invoice_payment', invoiceId: fields.get('invoiceId'), paymentReference: fields.get('paymentReference') || 'MANUELL', amountMinor: amount ? Math.round(Number(amount) * 100) : undefined }) }); cashStatus.textContent = `✓ ${cashMoney(data.amountMinor)} registrert. Gjenstår ${cashMoney(data.remainingMinor)}.`; } form.reset(); await loadCash(); } catch (error) { cashStatus.textContent = `Kunne ikke registrere betaling: ${error.message}`; } });
  document.querySelector('#collection-case-form')?.addEventListener('submit', async (event) => { event.preventDefault(); const status = document.querySelector('#collection-case-status'); const invoiceId = new FormData(event.currentTarget).get('invoiceId'); status.textContent = 'Lager purringsutkast …'; try { const data = await cashApi('/api/treasury', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ boardId: cashBoardId, action: 'create_collection_case', invoiceId }) }); status.textContent = `✓ Utkast opprettet for ${cashMoney(data.amountMinor)}. Neste steg krever kontroll.`; await loadCash(); } catch (error) { status.textContent = `Kunne ikke lage utkast: ${error.message}`; } });
  loadCash().catch((error) => { cashStatus.textContent = `Betalingsbildet kunne ikke lastes: ${error.message}`; });
</script>

<style>
  .cash-control{margin:18px 0;padding:24px;border:1px solid rgba(16,36,31,.1);border-radius:18px;background:#fff}.cash-control-head{display:flex;justify-content:space-between;gap:20px}.cash-control h2{margin:8px 0;font:500 1.8rem/1 Georgia,serif}.cash-control p{max-width:720px;color:var(--muted);font:.8rem/1.5 system-ui,sans-serif}.cash-help{max-width:none!important;color:var(--muted)!important;font-weight:500!important}.cash-control-boundary{height:max-content;padding:8px 10px;border-radius:999px;background:#fff2c9;color:#765a10;font:700 .62rem system-ui,sans-serif;white-space:nowrap}.cash-control-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:20px 0 14px}.cash-control-metrics article{padding:14px;border-radius:11px;background:#f5f8f5}.cash-control-metrics article.warn{background:#fff2c9}.cash-control-metrics small,.cash-control-metrics strong,.cash-control-metrics span{display:block}.cash-control-metrics small,.cash-control-metrics span{color:var(--muted);font:600 .62rem system-ui,sans-serif}.cash-control-metrics strong{margin:8px 0 4px;font:500 1.4rem Georgia,serif}.cash-control-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.cash-control-grid h3,.cash-payment-form h3{margin:0 0 8px;font:700 .78rem system-ui,sans-serif}.cash-list{display:grid;gap:6px}.cash-list article{display:flex;justify-content:space-between;gap:10px;padding:10px;border:1px solid rgba(16,36,31,.08);border-radius:9px}.cash-list article.overdue{border-color:#e0b66b;background:#fffaf0}.cash-list strong,.cash-list small{display:block}.cash-list strong{font:700 .7rem system-ui,sans-serif}.cash-list small{margin-top:3px;color:var(--muted);font:.61rem system-ui,sans-serif}.cash-list b{font:700 .68rem system-ui,sans-serif;white-space:nowrap}.cash-payment-form{margin-top:17px;padding-top:16px;border-top:1px solid rgba(16,36,31,.09)}.cash-payment-row{display:grid;grid-template-columns:.8fr 1.3fr 1.5fr 1.1fr 1.1fr auto;gap:7px;align-items:end}.cash-payment-row label{display:grid;gap:4px;color:var(--muted);font:600 .62rem system-ui,sans-serif}.cash-payment-row input,.cash-payment-row select{width:100%;padding:8px;border:1px solid rgba(16,36,31,.15);border-radius:7px;background:#fff;font:inherit}.label-note{font-weight:400}.cash-payment-row button{padding:9px 11px;border:0;border-radius:7px;background:#28624c;color:#fff;cursor:pointer;font:700 .65rem system-ui,sans-serif}.cash-payment-form p{min-height:1em;margin:10px 0}.cash-status{color:#27643f!important;font:700 .68rem system-ui,sans-serif}.reminder-row{grid-template-columns:minmax(0,1fr) auto}.reminder-form{background:#fffaf0;margin-inline:-8px;padding-inline:8px;border-radius:10px}@media(max-width:1050px){.cash-payment-row{grid-template-columns:1fr 1fr}.cash-payment-row button{grid-column:1/-1}}@media(max-width:800px){.cash-control-head,.cash-control-grid{display:flex;flex-direction:column}}@media(max-width:480px){.cash-control{padding:18px}.cash-control-metrics{grid-template-columns:1fr}.cash-payment-row,.reminder-row{grid-template-columns:1fr}.cash-control-boundary{align-self:flex-start}}
</style>
