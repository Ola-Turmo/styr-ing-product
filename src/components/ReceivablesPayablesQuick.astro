<section class="cash-control" aria-labelledby="cash-control-title">
  <div class="cash-control-head"><div><span class="section-kicker">Forfall · arbeidskapital</span><h2 id="cash-control-title">Hva skal inn — og hva skal ut?</h2><p>Et enkelt kontantbilde for små virksomheter. Koble en godkjent banklinje til riktig faktura, eller registrer en manuell betaling når banken ikke er importert.</p></div><span class="cash-control-boundary">Bankkobling · kontrollert bokføring</span></div>
  <div class="cash-control-metrics"><article><small>Kundefordringer</small><strong id="cash-receivable-total">—</strong><span id="cash-receivable-open">— åpne</span></article><article><small>Leverandørgjeld</small><strong id="cash-payable-total">—</strong><span id="cash-payable-open">— åpne</span></article><article class="warn"><small>Forfalt</small><strong id="cash-overdue-total">—</strong><span id="cash-overdue-count">— poster</span></article></div>
  <div class="cash-control-grid"><div><h3>Inn · kundefordringer</h3><div id="cash-receivables" class="cash-list"><p>Henter…</p></div></div><div><h3>Ut · leverandørgjeld</h3><div id="cash-payables" class="cash-list"><p>Henter…</p></div></div></div>
  <form id="collection-case-form" class="cash-payment-form"><h3>Forfalt faktura · lag purringsutkast</h3><div class="cash-payment-row"><label>Forfalt kundefaktura<select name="invoiceId" id="collection-invoice-id" required><option value="">Henter…</option></select></label><button type="submit">Lag kontrollert utkast</button></div><p class="cash-help">Restsaldo, delbetalinger og bokførte kreditnotaer brukes. Utsending krever menneskelig godkjenning og er ikke konfigurert automatisk.</p><p id="collection-case-status" role="status" aria-live="polite"></p></form>
  <form id="cash-payment-form" class="cash-payment-form"><h3>Registrer mottatt eller utført betaling</h3><div class="cash-payment-row"><label>Type<select name="kind"><option value="receivable">Kundefaktura</option><option value="payable">Leverandørfaktura</option></select></label><label>Post<select name="invoiceId" id="cash-payment-invoice" required><option value="">Henter…</option></select></label><label>Beløp i kroner (valgfritt)<input name="amountMinor" type="number" min="0.01" step="0.01" placeholder="Hele restbeløpet" /></label><label>Banktransaksjon (godkjent)<select name="bankTransactionId" id="cash-payment-bank"><option value="">Ingen — manuell registrering</option></select></label><label>Referanse<input name="paymentReference" maxlength="120" placeholder="KID eller bankreferanse" /></label><button type="submit">Registrer betaling</button></div><p class="cash-help">Delbetalinger oppdaterer restbeløpet. Bankkobling kontrollerer beløp og retning. Deretter bokføres matchen separat i Bankavstemming.</p><p id="cash-control-status" role="status" aria-live="polite"></p></form>
</section>
<script is:inline>
  const cashEsc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const cashMoney=v=>`${(Number(v||0)/100).toLocaleString('nb-NO')} kr`;let cashBoardId=new URLSearchParams(location.search).get('boardId')||'';let cashReceivables=[],cashPayables=[],cashTransactions=[];const cashStatus=document.querySelector('#cash-control-status');
  const cashApi=async(url,opts)=>{const r=await fetch(url,opts),d=await r.json();if(!r.ok)throw new Error(d.error||'Kunne ikke hente betalingsbildet');return d;};
  const fillPaymentOptions=()=>{const kind=document.querySelector('[name="kind"]').value;const rows=kind==='receivable'?cashReceivables.filter(x=>Number(x.outstanding_minor??x.total_minor||0)>0):cashPayables.filter(x=>x.status!=='paid'&&['approved','booked','matched'].includes(x.status));document.querySelector('#cash-payment-invoice').innerHTML=rows.length?rows.map(x=>`<option value="${cashEsc(x.id)}">${cashEsc(x.invoice_number)} · ${cashMoney(x.outstanding_minor??Math.max(0,Number(x.amount_minor||0)-Number(x.paid_minor||0)))} · ${cashEsc(x.company_name||x.supplier_name||'')}</option>`).join(''):'<option value="">Ingen åpne poster</option>';fillBankOptions();};
  const fillBankOptions=()=>{const kind=document.querySelector('[name="kind"]').value;const invoiceId=document.querySelector('#cash-payment-invoice').value;const rows=kind==='receivable'?cashReceivables:cashPayables;const invoice=rows.find(x=>x.id===invoiceId);const target=Math.abs(Number(invoice?.outstanding_minor??invoice?.total_minor??invoice?.amount_minor??0));const candidates=cashTransactions.filter(x=>x.status==='approved'&&!x.posted_voucher_id&&!x.payment_link_id&&Math.abs(Number(x.amount_minor||0))===target&&((kind==='receivable'&&Number(x.amount_minor)>0)||(kind==='payable'&&Number(x.amount_minor)<0)));document.querySelector('#cash-payment-bank').innerHTML='<option value="">Ingen — manuell registrering</option>'+candidates.map(x=>`<option value="${cashEsc(x.id)}">${cashEsc(x.transaction_date)} · ${cashEsc(x.description)} · ${cashMoney(Math.abs(Number(x.amount_minor)))}</option>`).join('');};
  const renderCash=()=>{const receivableOpen=cashReceivables.filter(x=>Number(x.outstanding_minor??x.total_minor||0)>0),payableOpen=cashPayables.filter(x=>x.status!=='paid');const overdue=[...cashReceivables.filter(x=>x.collection_status==='overdue'),...cashPayables.filter(x=>x.payment_status==='overdue')];document.querySelector('#cash-receivable-total').textContent=cashMoney(receivableOpen.reduce((n,x)=>n+Number(x.outstanding_minor??x.total_minor||0),0));document.querySelector('#cash-receivable-open').textContent=`${receivableOpen.length} åpne poster`;document.querySelector('#cash-payable-total').textContent=cashMoney(payableOpen.reduce((n,x)=>n+Math.max(0,Number(x.amount_minor||0)-Number(x.paid_minor||0)),0));document.querySelector('#cash-payable-open').textContent=`${payableOpen.length} åpne poster`;document.querySelector('#cash-overdue-total').textContent=cashMoney(overdue.reduce((n,x)=>n+Number(x.outstanding_minor??x.total_minor??x.amount_minor??0),0));document.querySelector('#cash-overdue-count').textContent=`${overdue.length} forfalte poster`;document.querySelector('#cash-receivables').innerHTML=cashReceivables.length?cashReceivables.map(x=>`<article class="${x.collection_status==='overdue'?'overdue':''}"><div><strong>${cashEsc(x.invoice_number)} · ${cashEsc(x.company_name||'Kunde')}</strong><small>forfall ${cashEsc(x.due_date||'ikke satt')} · ${cashEsc(x.collection_status)}${Number(x.credited_minor||0)?` · kreditert ${cashMoney(x.credited_minor)}`:''}</small></div><b>${cashMoney(x.outstanding_minor??x.total_minor)}</b></article>`).join(''):'<p>Ingen kundefakturaer.</p>';document.querySelector('#cash-payables').innerHTML=cashPayables.length?cashPayables.map(x=>`<article class="${x.payment_status==='overdue'?'overdue':''}"><div><strong>${cashEsc(x.invoice_number)} · ${cashEsc(x.supplier_name)}</strong><small>forfall ${cashEsc(x.due_date||'ikke satt')} · ${cashEsc(x.payment_status)}</small></div><b>${cashMoney(Math.max(0,Number(x.amount_minor||0)-Number(x.paid_minor||0)))}</b></article>`).join(''):'<p>Ingen leverandørfakturaer.</p>';fillPaymentOptions();};
  const loadCash=async()=>{if(!cashBoardId){const a=await(await fetch('/api/auth')).json();cashBoardId=a.boards?.[0]?.id||'';}if(!cashBoardId)throw new Error('Ingen virksomhet valgt');const [r,p,b]=await Promise.all([cashApi(`/api/finance?boardId=${encodeURIComponent(cashBoardId)}&view=receivables`),cashApi(`/api/finance?boardId=${encodeURIComponent(cashBoardId)}&view=payables`),cashApi(`/api/bank?boardId=${encodeURIComponent(cashBoardId)}&view=transactions`)]);cashReceivables=r.data||[];cashPayables=p.data||[];cashTransactions=b.data||[];renderCash();const overdueInvoices=cashReceivables.filter(x=>x.collection_status==='overdue'&&Number(x.outstanding_minor||0)>0);document.querySelector('#collection-invoice-id').innerHTML=overdueInvoices.length?overdueInvoices.map(x=>`<option value="${cashEsc(x.id)}">${cashEsc(x.invoice_number)} · ${cashMoney(x.outstanding_minor)} · ${cashEsc(x.company_name||'Kunde')}</option>`).join(''):'<option value="">Ingen forfalte kundefakturaer</option>';};
  document.querySelector('#collection-case-form')?.addEventListener('submit',async e=>{e.preventDefault();const status=document.querySelector('#collection-case-status');status.textContent='Lager purringsutkast…';try{const d=await cashApi('/api/treasury',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({boardId:cashBoardId,action:'create_collection_case',invoiceId:new FormData(e.currentTarget).get('invoiceId')})});status.textContent=`✓ Utkast opprettet for ${cashMoney(d.amountMinor)}. Neste steg krever kontroll.`;await loadCash();}catch(err){status.textContent=`Kunne ikke lage utkast: ${err.message}`;}});
  document.querySelector('[name="kind"]')?.addEventListener('change',fillPaymentOptions);document.querySelector('#cash-payment-invoice')?.addEventListener('change',fillBankOptions);document.querySelector('#cash-payment-form')?.addEventListener('submit',async e=>{e.preventDefault();const f=new FormData(e.currentTarget),kind=f.get('kind'),bankTransactionId=f.get('bankTransactionId'),amountMinor=f.get('amountMinor');cashStatus.textContent='Lagrer betaling i kontrollsporet…';try{let d;if(bankTransactionId){d=await cashApi('/api/bank',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({boardId:cashBoardId,action:'link_payment',transactionId:bankTransactionId,entityType:kind==='receivable'?'sales_invoice':'supplier_invoice',entityId:f.get('invoiceId')})});cashStatus.textContent=`✓ ${cashMoney(d.amountMinor)} koblet. Gjenstår ${cashMoney(d.remainingMinor)}. Bokfør deretter matchen i Bankavstemming.`;}else{d=await cashApi(kind==='receivable'?'/api/finance':'/api/procurement',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({boardId:cashBoardId,action:'record_invoice_payment',invoiceId:f.get('invoiceId'),paymentReference:f.get('paymentReference')||'MANUELL',amountMinor:amountMinor?Math.round(Number(amountMinor)*100):undefined})});cashStatus.textContent=`✓ ${cashMoney(d.amountMinor)} registrert. Gjenstår ${cashMoney(d.remainingMinor)}.`;}e.currentTarget.reset();await loadCash();}catch(err){cashStatus.textContent=`Kunne ikke registrere betaling: ${err.message}`;}});loadCash().catch(e=>cashStatus.textContent=`Betalingsbildet kunne ikke lastes: ${e.message}`);
</script>
<style>
  .cash-control{margin:18px 0;padding:24px;border:1px solid rgba(16,36,31,.1);border-radius:18px;background:#fff}.cash-control-head{display:flex;justify-content:space-between;gap:20px}.cash-control h2{margin:8px 0;font:500 1.8rem/1 Georgia,serif}.cash-control p{max-width:720px;color:var(--muted);font:.8rem/1.5 system-ui,sans-serif}.cash-help{max-width:none!important;color:var(--muted)!important;font-weight:500!important}.cash-control-boundary{height:max-content;padding:8px 10px;border-radius:999px;background:#fff2c9;color:#765a10;font:700 .62rem system-ui,sans-serif;white-space:nowrap}.cash-control-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:20px 0 14px}.cash-control-metrics article{padding:14px;border-radius:11px;background:#f5f8f5}.cash-control-metrics article.warn{background:#fff2c9}.cash-control-metrics small,.cash-control-metrics strong,.cash-control-metrics span{display:block}.cash-control-metrics small,.cash-control-metrics span{color:var(--muted);font:600 .62rem system-ui,sans-serif}.cash-control-metrics strong{margin:8px 0 4px;font:500 1.4rem Georgia,serif}.cash-control-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.cash-control-grid h3,.cash-payment-form h3{margin:0 0 8px;font:700 .78rem system-ui,sans-serif}.cash-list{display:grid;gap:6px}.cash-list article{display:flex;justify-content:space-between;gap:10px;padding:10px;border:1px solid rgba(16,36,31,.08);border-radius:9px}.cash-list article.overdue{border-color:#e0b66b;background:#fffaf0}.cash-list strong,.cash-list small{display:block}.cash-list strong{font:700 .7rem system-ui,sans-serif}.cash-list small{margin-top:3px;color:var(--muted);font:.61rem system-ui,sans-serif}.cash-list b{font:700 .68rem system-ui,sans-serif;white-space:nowrap}.cash-payment-form{margin-top:17px;padding-top:16px;border-top:1px solid rgba(16,36,31,.09)}.cash-payment-row{display:grid;grid-template-columns:.8fr 1.3fr 1.5fr 1.1fr auto;gap:7px;align-items:end}.cash-payment-row label{display:grid;gap:4px;color:var(--muted);font:600 .62rem system-ui,sans-serif}.cash-payment-row input,.cash-payment-row select{padding:8px;border:1px solid rgba(16,36,31,.15);border-radius:7px;background:#fff}.cash-payment-row button{padding:9px 11px;border:0;border-radius:7px;background:#28624c;color:#fff;cursor:pointer;font:700 .65rem system-ui,sans-serif}.cash-payment-form p{min-height:1em;margin:10px 0 0;color:#27643f;font:700 .68rem system-ui,sans-serif}@media(max-width:1000px){.cash-payment-row{grid-template-columns:1fr 1fr}.cash-payment-row button{grid-column:1/-1}}@media(max-width:800px){.cash-control-head,.cash-control-grid{display:flex;flex-direction:column}}@media(max-width:480px){.cash-control-metrics{grid-template-columns:1fr}.cash-payment-row{grid-template-columns:1fr}}
</style>
