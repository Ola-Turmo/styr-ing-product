<section class="vat-quick" aria-labelledby="vat-title">
  <div class="vat-head"><div><span class="section-kicker">MVA · hovedbok</span><h2 id="vat-title">Klargjør MVA-perioden</h2><p>Beregn grunnlaget fra bokførte bilag, se hva som inngår og send videre til menneskelig kontroll. Ingen Altinn-innsending skjer her.</p></div><span class="vat-boundary">Adapter · ikke konfigurert</span></div>
  <div class="vat-controls"><label>Periode<input id="vat-period" type="month" value="2026-08" /></label><button id="vat-calculate" type="button">Beregn grunnlag</button></div>
  <div id="vat-status" class="vat-status" role="status" aria-live="polite">Henter MVA-perioder…</div>
  <div id="vat-periods" class="vat-periods"></div>
</section>
<script is:inline>
  const vatMoney = (v) => `${(Number(v || 0) / 100).toLocaleString('nb-NO')} kr`;
  const vatEsc = (v) => String(v ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const vatStatus = document.querySelector('#vat-status'); const vatList = document.querySelector('#vat-periods');
  const vatRender = (rows=[]) => { vatList.innerHTML = rows.length ? rows.map(x => `<article class="vat-row"><div><b>${vatEsc(x.period)}</b><small>${vatEsc(x.status)} · ${Number(x.source_count||0)} kildelinjer${Number(x.unmapped_count||0)?` · ${x.unmapped_count} ukjent`:''}</small></div><div class="vat-values"><span>Utgående ${vatMoney(x.output_vat_minor)}</span><span>Inngående ${vatMoney(x.input_vat_minor)}</span><strong>${Number(x.net_vat_minor||0)>=0?'Til betaling':'Til gode'} ${vatMoney(Math.abs(Number(x.net_vat_minor||0)))}</strong></div><div class="vat-buttons">${x.status==='calculated'&&Number(x.unmapped_count||0)===0?`<button data-vat-action="approve_period" data-period="${vatEsc(x.period)}">Godkjenn grunnlag</button>`:''}${x.status==='approved'?`<button data-vat-action="prepare_submission" data-period="${vatEsc(x.period)}">Klargjør innsending</button>`:''}</div></article>`).join('') : '<p class="vat-empty">Ingen beregnede perioder ennå.</p>'; };
  const vatLoad = async () => { const r = await fetch('/api/mva?boardId=board-1&view=periods'); const d = await r.json(); if(!r.ok) throw new Error(d.error||'Kunne ikke hente MVA'); vatRender(d.data||[]); };
  document.querySelector('#vat-calculate')?.addEventListener('click', async () => { const period=document.querySelector('#vat-period').value; vatStatus.textContent='Beregner fra bokførte bilag…'; try { const r=await fetch('/api/mva',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({boardId:'board-1',action:'calculate_period',period})}); const d=await r.json(); if(!r.ok) throw new Error(d.error||'Kunne ikke beregne'); vatStatus.textContent=`✓ ${period}: ${d.sourceCount} kildelinjer · ${d.unmappedCount?'krever kontroll':'klar for godkjenning'}.`; await vatLoad(); } catch(e) { vatStatus.textContent=`Kunne ikke beregne: ${e.message}`; } });
  vatList?.addEventListener('click', async (event) => { const button=event.target.closest('[data-vat-action]'); if(!button)return; button.disabled=true; vatStatus.textContent='Lagrer kontrollspor…'; try { const r=await fetch('/api/mva',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({boardId:'board-1',action:button.dataset.vatAction,period:button.dataset.period})}); const d=await r.json(); if(!r.ok)throw new Error(d.error||'Handlingen kunne ikke lagres'); vatStatus.textContent=`✓ ${d.period}: ${d.status==='prepared'?'innsendingsgrunnlag klargjort':'godkjent'}. Ekstern innsending er ikke konfigurert.`; await vatLoad(); } catch(e) { vatStatus.textContent=`Kunne ikke lagre: ${e.message}`; button.disabled=false; } });
  vatLoad().catch(e=>vatStatus.textContent=`Kunne ikke hente MVA-perioder: ${e.message}`);
</script>
<style>
  .vat-quick{margin:18px 0;padding:24px;border:1px solid rgba(16,36,31,.1);border-radius:18px;background:#f5f8f5}.vat-head{display:flex;justify-content:space-between;gap:20px}.vat-head h2{margin:8px 0;font:500 1.8rem/1 Georgia,serif}.vat-head p{max-width:650px;margin:0;color:var(--muted);font:.8rem/1.5 system-ui,sans-serif}.vat-boundary{padding:8px 10px;border-radius:999px;background:#fff2c9;color:#765a10;font:700 .62rem/1 system-ui,sans-serif;white-space:nowrap;height:max-content}.vat-controls{display:flex;align-items:end;gap:10px;margin:20px 0}.vat-controls label{display:flex;flex-direction:column;gap:5px;color:var(--muted);font:600 .63rem/1 system-ui,sans-serif}.vat-controls input{padding:9px;border:1px solid rgba(16,36,31,.16);border-radius:8px;background:#fff}.vat-controls button,.vat-buttons button{padding:10px 13px;border:0;border-radius:8px;background:#10241f;color:#fff;cursor:pointer;font:700 .68rem/1 system-ui,sans-serif}.vat-status{min-height:1.3em;color:#27643f;font:700 .7rem/1.4 system-ui,sans-serif}.vat-row{display:grid;grid-template-columns:1fr 2fr auto;gap:14px;align-items:center;padding:14px 0;border-top:1px solid rgba(16,36,31,.09);font:.74rem/1.3 system-ui,sans-serif}.vat-row small{display:block;margin-top:5px;color:var(--muted);font-size:.64rem}.vat-values{display:flex;gap:16px;flex-wrap:wrap;color:var(--muted);font-size:.68rem}.vat-values strong{color:#10241f}.vat-buttons{display:flex;justify-content:end}.vat-empty{color:var(--muted);font:.75rem/1.4 system-ui,sans-serif}@media(max-width:760px){.vat-head,.vat-row{display:flex;flex-direction:column;align-items:flex-start}.vat-buttons{justify-content:flex-start}.vat-controls{align-items:flex-start;flex-direction:column}}
</style>
