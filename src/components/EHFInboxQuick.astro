<section class="ehf-inbox" aria-labelledby="ehf-inbox-title">
  <div class="ehf-inbox-intro"><span class="kicker">EHF / PEPPOL-kontroll</span><h2 id="ehf-inbox-title">Fra dokument til<br /><em>leverandørfaktura.</em></h2><p>Registrer et EHF-grunnlag, valider feltene og koble det til den eksisterende treveis-matchingen. PEPPOL-transport og automatisk bokføring er ikke aktivert.</p></div>
  <div class="ehf-inbox-grid">
    <form data-ehf-action="receive_ehf"><strong>Ta imot EHF-grunnlag</strong><label>Dokumentreferanse<input name="documentRef" required maxlength="120" placeholder="urn:invoice:2026-001" /></label><label>Leverandør<input name="supplierName" required maxlength="200" placeholder="Leverandør AS" /></label><label>Fakturanummer<input name="invoiceNumber" required maxlength="80" placeholder="INV-8842" /></label><div class="ehf-lines"><div class="ehf-line"><input name="lineDescription" placeholder="Lisens" required /><input name="lineQuantity" type="number" min="0.001" step="0.001" value="1" aria-label="Antall" required /><input name="lineUnitPrice" type="number" min="0" step="0.01" placeholder="1000" aria-label="Pris i kroner" required /><select name="lineVatRate" aria-label="MVA"><option value="0">0 %</option><option value="15">15 %</option><option value="25" selected>25 %</option></select></div></div><button type="button" class="ehf-add-line">+ Legg til linje</button><div class="ehf-row"><label>Fakturadato<input name="issueDate" type="date" required /></label><label>Forfall<input name="dueDate" type="date" required /></label></div><label>Valuta<select name="currency" required><option value="NOK" selected>NOK — norske kroner</option><option value="SEK">SEK — svenske kroner</option><option value="DKK">DKK — danske kroner</option><option value="EUR">EUR — euro</option><option value="GBP">GBP — britiske pund</option></select></label><button type="submit">Registrer dokument</button></form>
    <form data-ehf-action="validate_ehf"><strong>Valider dokument</strong><label>Dokument<select id="ehf-validate-id" name="ehfId" required><option value="">Henter dokumenter…</option></select></label><p>Kontrollerer dato, valuta, beløp og obligatoriske EHF-felt.</p><button type="submit">Valider feltene</button></form>
    <form data-ehf-action="link_ehf_invoice"><strong>Koble til fakturaflyt</strong><label>Validert dokument<select id="ehf-link-id" name="ehfId" required><option value="">Henter validerte…</option></select></label><p>Oppretter en mottatt leverandørfaktura som kan matches mot ordre og varemottak.</p><button type="submit">Opprett leverandørfaktura</button></form>
  </div>
  <p class="ehf-status" id="ehf-status" role="status" aria-live="polite"></p><div class="ehf-list" id="ehf-list"><p>Henter EHF-dokumenter…</p></div>
</section>
<script is:inline>
  const ehfEsc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); const ehfMoney=v=>`${(Number(v||0)/100).toLocaleString('nb-NO')} kr`; let ehfRows=[]; let ehfBoardId=new URLSearchParams(location.search).get('boardId')||'';
  const ehfResolveBoard=async()=>{if(ehfBoardId)return ehfBoardId;try{const auth=await(await fetch('/api/auth')).json();ehfBoardId=auth.boards?.[0]?.id||'';}catch{}return ehfBoardId||(location.pathname==='/finance/'||location.pathname==='/procurement/'?'board-1':'');};
  const ehfLoad=async()=>{await ehfResolveBoard();const d=await (await fetch(`/api/procurement?boardId=${encodeURIComponent(ehfBoardId)}&view=ehf`)).json();ehfRows=d.data||[];const valid=ehfRows.filter(x=>['received','rejected'].includes(x.status)),validated=ehfRows.filter(x=>x.status==='validated');document.querySelector('#ehf-validate-id').innerHTML=valid.length?valid.map(x=>`<option value="${ehfEsc(x.id)}">${ehfEsc(x.document_ref)} · ${ehfEsc(x.supplier_name)}</option>`).join(''):'<option value="">Ingen dokumenter til validering</option>';document.querySelector('#ehf-link-id').innerHTML=validated.length?validated.map(x=>`<option value="${ehfEsc(x.id)}">${ehfEsc(x.document_ref)} · ${ehfEsc(x.supplier_name)}</option>`).join(''):'<option value="">Ingen validerte dokumenter</option>';document.querySelector('#ehf-list').innerHTML=ehfRows.map(x=>`<article><div><strong>${ehfEsc(x.document_ref)} · ${ehfEsc(x.supplier_name)}</strong><p>${ehfEsc(x.invoice_number)} · ${ehfMoney(x.amount_minor)} · ${ehfEsc(x.standard||'EHF 3.0')}</p></div><span>${ehfEsc(x.status)}</span>${['validated','linked'].includes(x.status)?`<a class="ehf-xml-link" href="/api/procurement?boardId=${encodeURIComponent(ehfBoardId)}&view=ehf-xml&invoiceId=${encodeURIComponent(x.id)}">Last ned UBL XML</a>`:''}</article>`).join('')||'<p>Ingen EHF-dokumenter registrert.</p>';};
  document.querySelectorAll('.ehf-add-line').forEach(button=>button.addEventListener('click',()=>{const box=button.previousElementSibling;const clone=box.querySelector('.ehf-line').cloneNode(true);clone.querySelectorAll('input').forEach(input=>{input.value=input.name==='lineQuantity'?'1':''});clone.querySelector('select').value='25';box.appendChild(clone)}));
  document.querySelectorAll('[data-ehf-action]').forEach(form=>form.addEventListener('submit',async e=>{e.preventDefault();const status=document.querySelector('#ehf-status');const f=new FormData(form);const p=Object.fromEntries(f);p.boardId=await ehfResolveBoard();p.action=form.dataset.ehfAction;if(p.action==='receive_ehf'){const d=f.getAll('lineDescription'),q=f.getAll('lineQuantity'),u=f.getAll('lineUnitPrice'),v=f.getAll('lineVatRate');p.lines=d.map((description,i)=>({description,quantity:Number(q[i]),unitPriceMinor:Math.round(Number(u[i])*100),vatRate:Number(v[i])}));delete p.amount;delete p.amountMinor}status.textContent='Lagrer og logger handling…';try{const r=await fetch('/api/procurement',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(p)}),d=await r.json();if(!r.ok)throw new Error(d.error||'Kunne ikke lagre');status.textContent=`✓ ${d.action} er registrert · ${d.status||'ok'}.`;form.reset();await ehfLoad();}catch(err){status.textContent=`Kunne ikke lagre: ${err.message}`;}}));ehfLoad().catch(()=>{document.querySelector('#ehf-status').textContent='EHF-inbox er midlertidig utilgjengelig.'});
</script>
<style>
  .ehf-inbox{margin-top:28px;padding:28px;border-radius:20px;background:#eef5f4;border:1px solid #10241f18}.ehf-inbox-intro h2{margin:9px 0;font:500 2rem/1 Georgia,serif}.ehf-inbox-intro h2 em{color:#28746c;font-style:normal}.ehf-inbox-intro p{max-width:760px;color:#63736a;font:.8rem/1.55 system-ui,sans-serif}.ehf-inbox-grid{display:grid;grid-template-columns:1.25fr 1fr 1fr;gap:10px;margin-top:20px}.ehf-inbox-grid form{display:grid;gap:8px;padding:16px;border-radius:12px;background:#fff;border:1px solid #10241f14}.ehf-inbox-grid strong{font:700 .78rem system-ui,sans-serif}.ehf-inbox-grid label{display:grid;gap:4px;color:#63736a;font:600 .64rem system-ui,sans-serif}.ehf-inbox-grid input,.ehf-inbox-grid select{width:100%;padding:9px;border:1px solid #10241f1c;border-radius:7px;background:#fff;font:.72rem system-ui,sans-serif}.ehf-inbox-grid button{margin-top:auto;padding:9px;border:0;border-radius:8px;background:#28746c;color:#fff;cursor:pointer;font:700 .68rem system-ui,sans-serif}.ehf-inbox-grid p{margin:0;color:#718078;font:.68rem/1.4 system-ui,sans-serif}.ehf-row{display:grid;grid-template-columns:1fr 1fr;gap:7px}.ehf-lines{display:grid;gap:6px}.ehf-line{display:grid;grid-template-columns:2fr .7fr 1fr .8fr;gap:4px}.ehf-add-line{background:transparent!important;color:#28746c!important;border:1px dashed #10241f33!important}.ehf-status{min-height:1.2em;margin:14px 0;color:#28746c;font:700 .7rem system-ui,sans-serif}.ehf-list{display:grid;gap:7px}.ehf-list article{display:grid;grid-template-columns:1fr auto;gap:12px;padding:12px 14px;border-radius:9px;background:#fff;border:1px solid #10241f14;font-family:system-ui,sans-serif}.ehf-list strong{font-size:.74rem}.ehf-list p{margin:4px 0 0;color:#718078;font-size:.65rem}.ehf-list span{color:#28746c;font:700 .64rem system-ui,sans-serif}.ehf-xml-link{grid-column:1/-1;color:#28746c;font:700 .64rem system-ui,sans-serif}@media(max-width:900px){.ehf-inbox-grid{grid-template-columns:1fr 1fr}}@media(max-width:560px){.ehf-inbox{padding:19px}.ehf-inbox-grid{grid-template-columns:1fr}.ehf-row{grid-template-columns:1fr}.ehf-line{grid-template-columns:1fr 1fr}.ehf-line input:first-child{grid-column:1/-1}}
</style>
