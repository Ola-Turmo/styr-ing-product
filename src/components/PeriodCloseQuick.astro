<section class="period-close" aria-labelledby="period-close-title">
  <div class="period-close-head"><div><span class="section-kicker">Periodeavslutning · regnskap</span><h2 id="period-close-title">Avslutt måneden med ro i magen.</h2><p>Styr.ing samler de viktigste kontrollene før du låser en måned. Du ser alltid hva som stopper avslutningen, og låser først etter en egen godkjenning.</p></div><span class="period-close-boundary">Menneskelig godkjenning</span></div>
  <form id="period-close-form" class="period-close-form"><label>Regnskapsperiode<input id="period-close-period" type="month" required /></label><button type="submit">Kontroller måneden</button></form>
  <div id="period-close-status" class="period-close-status" role="status" aria-live="polite">Henter siste avslutninger…</div>
  <div id="period-close-list" class="period-close-list"></div>
</section>
<script is:inline>
  const closeEsc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  let closeBoardId=new URLSearchParams(location.search).get('boardId')||''; const closeStatus=document.querySelector('#period-close-status'); const closeList=document.querySelector('#period-close-list'); const closePeriodInput=document.querySelector('#period-close-period');
  if(closePeriodInput&&!closePeriodInput.value){const now=new Date();closePeriodInput.value=`${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}`;}
  const closeApi=async(path,opts)=>{const r=await fetch(path,opts),d=await r.json();if(!r.ok)throw new Error(d.error||'Kunne ikke oppdatere perioden');return d;};
  const closeChecks=checks=>Object.entries(checks||{}).map(([name,x])=>{const blocked=Boolean(x?.blocking);const warning=Boolean(x?.warning);const labels={vouchers:'Bilag',balance:'Balanse',bank:'Bank',sales:'Kundefaktura',purchases:'Leverandørfaktura',vat:'MVA',payroll:'Lønn',proposals:'Bilagsforslag',depreciation:'Avskrivning',safT:'SAF-T'};const detail=blocked?(x?.openCount?`${x.openCount} åpne`: 'Krever oppfølging'):warning?'Se over':'Kontrollert';return `<li class="${blocked?'blocked':warning?'warning':'clear'}"><i></i><span>${closeEsc(labels[name]||name)}</span><em>${closeEsc(detail)}</em></li>`;}).join('');
  const renderClosures=rows=>{closeList.innerHTML=rows.length?rows.map(x=>{let checks={};try{checks=JSON.parse(x.checks_json||'{}')}catch{}const blocked=Object.values(checks).some(v=>v&&v.blocking);return `<article class="period-close-card"><div class="period-close-card-head"><div><strong>${closeEsc(x.period)}</strong><small>${closeEsc(x.status)} · kontrollert ${closeEsc(x.updated_at||x.created_at||'')}</small></div><span class="${blocked?'blocked':'clear'}">${blocked?'Ikke klar':'Klar for godkjenning'}</span></div><ul>${closeChecks(checks)}</ul><div class="period-close-actions">${x.status==='review'&&!blocked?`<button data-close-action="approve_period_close" data-period="${closeEsc(x.period)}">Godkjenn avslutning</button>`:''}${x.status==='approved'?`<button data-close-action="lock_period" data-period="${closeEsc(x.period)}">Lås perioden</button>`:''}${x.status==='locked'?'<small>Perioden er låst og forseglet.</small>':''}</div></article>`}).join(''):'<p class="period-close-empty">Ingen avslutninger er kontrollert ennå.</p>';};
  const loadClosures=async()=>{if(!closeBoardId){const a=await(await fetch('/api/auth')).json();closeBoardId=a.boards?.[0]?.id||'';}if(!closeBoardId)throw new Error('Ingen virksomhet valgt');const d=await closeApi(`/api/finance?boardId=${encodeURIComponent(closeBoardId)}&view=period-closures`);renderClosures(d.data||[]);};
  document.querySelector('#period-close-form')?.addEventListener('submit',async e=>{e.preventDefault();const period=document.querySelector('#period-close-period').value;closeStatus.textContent='Kontrollerer bank, bilag, MVA, lønn og rapportgrunnlag…';try{const d=await closeApi('/api/finance',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({boardId:closeBoardId,action:'prepare_period_close',period})});closeStatus.textContent=d.ready?'✓ Perioden er klar for godkjenning.':'Perioden trenger oppfølging: '+(d.blocking||[]).join(', ');await loadClosures();}catch(e){closeStatus.textContent=`Kunne ikke kontrollere perioden: ${e.message}`;}});
  closeList?.addEventListener('click',async e=>{const b=e.target.closest('[data-close-action]');if(!b)return;b.disabled=true;closeStatus.textContent='Lagrer avslutningssporet…';try{const d=await closeApi('/api/finance',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({boardId:closeBoardId,action:b.dataset.closeAction,period:b.dataset.period})});closeStatus.textContent=d.status==='locked'?`✓ ${d.period} er låst og forseglet.`:`✓ ${d.period} er godkjent for låsing.`;await loadClosures();}catch(e){closeStatus.textContent=`Kunne ikke oppdatere perioden: ${e.message}`;b.disabled=false;}});
  loadClosures().catch(e=>closeStatus.textContent=`Avslutningskontrollen kunne ikke lastes: ${e.message}`);
</script>
<style>
  .period-close{margin:18px 0;padding:24px;border:1px solid rgba(16,36,31,.1);border-radius:18px;background:#fffaf0}.period-close-head{display:flex;justify-content:space-between;gap:20px}.period-close h2{margin:8px 0;font:500 1.8rem/1 Georgia,serif}.period-close p{max-width:700px;color:var(--muted);font:.8rem/1.5 system-ui,sans-serif}.period-close-boundary{padding:8px 10px;height:max-content;border-radius:999px;background:#e8f1df;color:#27643f;font:700 .62rem/1 system-ui,sans-serif;white-space:nowrap}.period-close-form{display:flex;align-items:end;gap:9px;margin:20px 0}.period-close-form label{display:grid;gap:5px;color:var(--muted);font:600 .63rem/1.2 system-ui,sans-serif}.period-close-form input{padding:9px;border:1px solid rgba(16,36,31,.15);border-radius:8px;background:#fff;font:.7rem system-ui,sans-serif}.period-close button{padding:9px 11px;border:0;border-radius:8px;background:#10241f;color:#fff;cursor:pointer;font:700 .67rem/1 system-ui,sans-serif}.period-close-status{min-height:1.2em;color:#27643f;font:700 .7rem/1.35 system-ui,sans-serif}.period-close-list{display:grid;gap:9px;margin-top:10px}.period-close-card{padding:14px;border:1px solid rgba(16,36,31,.1);border-radius:12px;background:#fff}.period-close-card-head{display:flex;justify-content:space-between;gap:12px}.period-close-card strong,.period-close-card small{display:block}.period-close-card strong{font:700 .84rem system-ui,sans-serif}.period-close-card small{margin-top:4px;color:var(--muted);font:.64rem system-ui,sans-serif}.period-close-card-head>span{font:700 .62rem system-ui,sans-serif;color:#27643f}.period-close-card-head>span.blocked{color:#9b6218}.period-close-card ul{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;padding:0;margin:12px 0;list-style:none}.period-close-card li{display:flex;align-items:center;gap:6px;padding:7px;border-radius:7px;background:#f5f8f5;font:.64rem system-ui,sans-serif}.period-close-card li i{width:7px;height:7px;border-radius:50%;background:#76b76f}.period-close-card li.blocked i{background:#d69738}.period-close-card li em{margin-left:auto;color:var(--muted);font-style:normal;font-size:.58rem}.period-close-actions{display:flex;gap:8px;align-items:center}.period-close-actions button{background:#28624c}.period-close-empty{color:var(--muted);font:.74rem system-ui,sans-serif}@media(max-width:760px){.period-close-head,.period-close-form{display:flex;flex-direction:column;align-items:stretch}.period-close-card ul{grid-template-columns:repeat(2,1fr)}}
</style>
