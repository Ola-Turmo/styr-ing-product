<section class="product-invoice-bridge" aria-labelledby="product-invoice-bridge-title">
  <div><strong id="product-invoice-bridge-title">Bruk en registrert vare i fakturautkastet</strong><small>Fyller første fakturalinje med navn, pris og MVA. Du kan kontrollere og endre før lagring.</small></div>
  <select id="product-invoice-bridge-select" aria-label="Velg vare eller tjeneste"><option value="">Velg vare eller tjeneste</option></select>
  <button type="button" id="product-invoice-bridge-use">Sett inn i faktura</button>
  <p id="product-invoice-bridge-status" role="status" aria-live="polite"></p>
</section>
<script is:inline>
  (() => {
    const esc = value => String(value ?? '').replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
    const money = value => `${(Number(value || 0) / 100).toLocaleString('nb-NO', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} kr`;
    const query = new URLSearchParams(location.search); let boardId = query.get('boardId') || '';
    const select = document.querySelector('#product-invoice-bridge-select'); const button = document.querySelector('#product-invoice-bridge-use'); const status = document.querySelector('#product-invoice-bridge-status'); let products = [];
    const resolveBoard = async () => { if (boardId) return boardId; try { const auth = await (await fetch('/api/auth')).json(); boardId = auth.boards?.[0]?.id || ''; } catch {} return boardId || (location.pathname.startsWith('/finance') ? 'board-1' : ''); };
    const load = async () => { await resolveBoard(); if (!boardId || !select) return; try { const response = await fetch(`/api/finance?boardId=${encodeURIComponent(boardId)}&view=products`); const payload = await response.json(); if (!response.ok) throw new Error(payload.error || 'Kunne ikke hente produktregisteret'); products = Array.isArray(payload.data) ? payload.data.filter(item => Number(item.active) !== 0) : []; select.innerHTML = `<option value="">${products.length ? 'Velg vare eller tjeneste' : 'Ingen aktive varer ennå'}</option>${products.map(item => `<option value="${esc(item.id)}">${esc(item.name)} · ${money(item.unit_price_minor)} · MVA ${esc(item.vat_rate)} %</option>`).join('')}`; } catch { select.innerHTML = '<option value="">Produktregisteret er ikke tilgjengelig</option>'; } };
    button?.addEventListener('click', () => { const product = products.find(item => item.id === select?.value); const form = document.querySelector('[data-invoice-action="create_invoice"]'); const first = form?.querySelector('.invoice-line'); if (!product || !first) { if (status) status.textContent = 'Velg en vare først.'; return; } first.querySelector('[name="lineDescription"]').value = product.name || ''; first.querySelector('[name="lineUnitPrice"]').value = (Number(product.unit_price_minor || 0) / 100).toFixed(2); first.querySelector('[name="lineVatRate"]').value = String(product.vat_rate ?? 25); if (status) status.textContent = `✓ ${product.name} er lagt inn i første fakturalinje.`; form.scrollIntoView({ behavior: 'smooth', block: 'center' }); });
    load();
  })();
</script>
<style>
  .product-invoice-bridge{display:grid;grid-template-columns:minmax(260px,1fr) minmax(230px,.75fr) auto;gap:12px;align-items:center;margin:0 0 18px;padding:13px 16px;border:1px solid rgba(16,36,31,.1);border-radius:12px;background:#eef6e9}.product-invoice-bridge>div{display:grid;gap:3px}.product-invoice-bridge strong{font:700 .72rem/1.2 system-ui,sans-serif}.product-invoice-bridge small{color:var(--muted);font:.65rem/1.35 system-ui,sans-serif}.product-invoice-bridge select{width:100%;box-sizing:border-box;padding:9px;border:1px solid rgba(16,36,31,.14);border-radius:8px;background:#fff;color:var(--ink);font:.7rem system-ui,sans-serif}.product-invoice-bridge button{padding:9px 12px;border:0;border-radius:8px;background:var(--accent);color:#fff;font:700 .65rem/1 system-ui,sans-serif;cursor:pointer}.product-invoice-bridge p{grid-column:1/-1;min-height:1em;margin:0;color:var(--accent);font:700 .65rem/1.2 system-ui,sans-serif}@media(max-width:720px){.product-invoice-bridge{grid-template-columns:1fr}.product-invoice-bridge button{width:100%}}
</style>
