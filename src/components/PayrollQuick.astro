<section class="payroll-quick" aria-labelledby="payroll-quick-title">
  <div class="payroll-head"><div><span class="section-kicker">Lønn · kontrollert grunnlag</span><h2 id="payroll-quick-title">Lønn tett på regnskapet.</h2><p>For små norske virksomheter: registrer lønn, se nettobeløp og arbeidsgiverkostnad, beregn feriepenger/OTP og klargjør A-melding. Altinn, NAV og utbetaling krever egne avtaler og sendes ikke automatisk.</p></div><span class="payroll-boundary">Ingen ekstern sending</span></div>
  <div class="payroll-grid">
    <form data-payroll-action="create_run"><h3>1. Ny lønnskjøring</h3><label>Periode<input name="period" type="month" required /></label><label>Brutto lønn i kroner<input name="gross" type="number" min="0.01" step="0.01" required placeholder="45 000,00" /></label><label>Skattetrekk i kroner<input name="tax" type="number" min="0" step="0.01" required placeholder="13 500,00" /></label><label>Arbeidsgiverkostnad inkl. avgift<input name="employerCost" type="number" min="0.01" step="0.01" required placeholder="51 300,00" /><small>Inkluder arbeidsgiveravgift og andre kostnader du vil bokføre.</small></label><label>Antall ansatte<input name="employees" type="number" min="1" step="1" required /></label><button type="submit">Opprett utkast</button></form>
    <form data-payroll-action="calculate_compliance"><h3>2. Beregn ferie og OTP</h3><label>Lønnskjøring<select name="payrollRunId" id="quick-payroll-run" required><option value="">Henter kjøringer…</option></select></label><div class="payroll-row"><label>Feriesats<input name="holidayRate" type="number" min="0" max="1" step="0.001" value="0.102" required /></label><label>OTP-sats<input name="otpRate" type="number" min="0" max="1" step="0.001" value="0.02" required /></label></div><small>Standardverdiene er veiledende. Kontroller satsene mot virksomhetens avtaler før godkjenning.</small><button type="submit">Beregn kontrollgrunnlag</button></form>
    <form data-payroll-action="approve_compliance"><h3>3. Godkjenn kontrollgrunnlag</h3><label>Grunnlag<select name="checkId" id="quick-payroll-check" required><option value="">Henter beregninger…</option></select></label><small>Godkjenning låser grunnlaget for bokføringsforslag.</small><button type="submit">Godkjenn beregning</button></form>
    <form data-payroll-action="prepare_submission"><h3>4. Klargjør rapport</h3><label>Rapporttype<select name="submissionType"><option value="a_melding">A-melding</option><option value="nav_income">NAV inntektsmelding</option></select></label><label>Periode<input name="period" type="month" required /></label><button type="submit">Klargjør payload</button><small>Payloaden lagres med hash og må sendes manuelt når Altinn-adapter er konfigurert.</small></form>
  </div>
  <p id="payroll-quick-status" class="payroll-status" role="status" aria-live="polite"></p><div id="payroll-quick-list" class="payroll-list"><p>Henter lønn…</p></div>
</section>
<script is:inline>
  const payrollEsc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); const payrollMoney=v=>`${(Number(v||0)/100).toLocaleString('nb-NO')} kr`; let payrollBoardId=new URLSearchParams(location.search).get('boardId')||''; let payrollRuns=[]; let payrollChecks=[]; const payrollStatus=document.querySelector('#payroll-quick-status');
  const resolvePayrollBoard=async()=>{if(payrollBoardId)return payrollBoardId;try{const a=await(await fetch('/api/auth')).json();payrollBoardId=a.boards?.[0]?.id||''}catch{}return payrollBoardId||'board-1'}; const payrollApi=async payload=>{const r=await fetch('/api/payroll',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({...payload,boardId:payrollBoardId})});const d=await r.json();if(!r.ok)throw Error(d.detail||d.error||'Kunne ikke lagre');return d};
  const loadPayroll=async()=>{await resolvePayrollBoard();const [r,c,s]=await Promise.all([fetch(`/api/payroll?boardId=${encodeURIComponent(payrollBoardId)}&view=runs`).then(x=>x.json()),fetch(`/api/payroll?boardId=${encodeURIComponent(payrollBoardId)}&view=checks`).then(x=>x.json()),fetch(`/api/payroll?boardId=${encodeURIComponent(payrollBoardId)}&view=submissions`).then(x=>x.json())]);payrollRuns=r.data||[];payrollChecks=c.data||[];document.querySelector('#quick-payroll-run').innerHTML=payrollRuns.length?payrollRuns.map(x=>`<option value="${payrollEsc(x.id)}">${payrollEsc(x.period)} · brutto ${payrollMoney(x.gross_minor)} · ${payrollEsc(x.status)}</option>`).join(''):'<option value="">Ingen lønnskjøringer</option>';const open=payrollChecks.filter(x=>['calculated','review'].includes(x.status));document.querySelector('#quick-payroll-check').innerHTML=open.length?open.map(x=>`<option value="${payrollEsc(x.id)}">${payrollEsc(x.period)} · ferie ${payrollMoney(x.holiday_pay_minor)} · OTP ${payrollMoney(x.otp_minor)}</option>`).join(''):'<option value="">Ingen åpne beregninger</option>';const submissions=s.data||[];document.querySelector('#payroll-quick-list').innerHTML=payrollRuns.map(x=>{const net=Number(x.gross_minor||0)-Number(x.tax_withheld_minor||0);const check=payrollChecks.find(c=>c.payroll_run_id===x.id);return `<article><div><strong>${payrollEsc(x.period)} · lønnskjøring</strong><small>${payrollEsc(x.employee_count)} ansatte · brutto ${payrollMoney(x.gross_minor)} · skatt ${payrollMoney(x.tax_withheld_minor)} · netto ${payrollMoney(net)} · arbeidsgiverkostnad ${payrollMoney(x.employer_cost_minor)}</small></div><span>${payrollEsc(x.status)}${check?` · kontroll ${payrollEsc(check.status)}`:''}</span></article>`}).join('')||'<p>Ingen lønnskjøringer registrert ennå.</p>';if(submissions.length)document.querySelector('#payroll-quick-list').insertAdjacentHTML('beforeend',`<p class="payroll-submissions"><strong>Rapporter:</strong> ${submissions.slice(0,4).map(x=>`${payrollEsc(x.submission_type)} ${payrollEsc(x.period)} · ${payrollEsc(x.status)}`).join(' · ')}</p>`)};
  document.querySelectorAll('[data-payroll-action]').forEach(form=>form.addEventListener('submit',async e=>{e.preventDefault();const f=new FormData(form);const payload={action:form.dataset.payrollAction};for(const[k,v]of f.entries())payload[k]=v;if(payload.gross)payload.grossMinor=Math.round(Number(payload.gross)*100);if(payload.tax)payload.taxWithheldMinor=Math.round(Number(payload.tax)*100);if(payload.employerCost)payload.employerCostMinor=Math.round(Number(payload.employerCost)*100);if(payload.employees)payload.employeeCount=Number(payload.employees);if(payload.holidayRate)payload.holidayRate=Number(payload.holidayRate);if(payload.otpRate)payload.otpRate=Number(payload.otpRate);payrollStatus.textContent='Lagrer og logger lønnskontroll…';try{const d=await payrollApi(payload);payrollStatus.textContent=d.action==='prepare_submission'?`✓ ${payload.submissionType==='a_melding'?'A-melding':'NAV-inntektsmelding'} er klargjort. Ekstern innsending er ikke satt opp.`:`✓ ${d.action} er registrert · ${d.status||'ok'}.`;form.reset();if(form.dataset.payrollAction==='calculate_compliance'){form.querySelector('[name=holidayRate]').value='0.102';form.querySelector('[name=otpRate]').value='0.02'}await loadPayroll()}catch(err){payrollStatus.textContent=`Kunne ikke lagre: ${err.message}`}}));loadPayroll().catch(()=>{payrollStatus.textContent='Lønnsbildet er midlertidig utilgjengelig.'});
</script>
<style>
  .payroll-quick{margin:28px 0;padding:26px;border:1px solid rgba(16,36,31,.1);border-radius:18px;background:#f8f5fc}.payroll-head{display:flex;justify-content:space-between;gap:20px}.payroll-head h2{margin:8px 0;font:500 1.8rem/1 Georgia,serif}.payroll-head p{max-width:720px;color:var(--muted);font:.8rem/1.5 system-ui,sans-serif}.payroll-boundary{height:max-content;padding:8px 10px;border-radius:999px;background:#eee9ff;color:#65539a;font:700 .62rem/1 system-ui,sans-serif;white-space:nowrap}.payroll-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:20px}.payroll-grid form{display:grid;gap:8px;padding:15px;border-radius:12px;background:#fff;border:1px solid rgba(16,36,31,.08)}.payroll-grid h3{margin:0;font:700 .78rem/1.2 system-ui,sans-serif}.payroll-grid label{display:grid;gap:4px;color:var(--muted);font:600 .62rem/1.2 system-ui,sans-serif}.payroll-grid input,.payroll-grid select{width:100%;box-sizing:border-box;padding:8px;border:1px solid rgba(16,36,31,.15);border-radius:7px;background:#fff;font:.72rem system-ui,sans-serif}.payroll-grid button{margin-top:auto;padding:9px;border:0;border-radius:8px;background:#7161a2;color:#fff;cursor:pointer;font:700 .67rem/1 system-ui,sans-serif}.payroll-grid small{color:var(--muted);font:.64rem/1.4 system-ui,sans-serif}.payroll-row{display:grid;grid-template-columns:1fr 1fr;gap:7px}.payroll-status{min-height:1.2em;margin:13px 0 6px;color:#65539a;font:700 .7rem/1.3 system-ui,sans-serif}.payroll-list{display:grid;gap:7px}.payroll-list article{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center;padding:12px 13px;border-radius:9px;background:#fff;border:1px solid rgba(16,36,31,.08);font-family:system-ui,sans-serif}.payroll-list strong,.payroll-list small{display:block}.payroll-list small{margin-top:4px;color:var(--muted);font-size:.65rem}.payroll-list span{color:#65539a;font:700 .62rem/1 system-ui,sans-serif}.payroll-submissions{margin:4px 0 0;color:var(--muted);font:.66rem/1.4 system-ui,sans-serif}@media(max-width:1100px){.payroll-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.payroll-quick{padding:18px}.payroll-head{display:block}.payroll-boundary{display:inline-flex;margin-top:10px}.payroll-grid{grid-template-columns:1fr}.payroll-row{grid-template-columns:1fr}}
</style>
