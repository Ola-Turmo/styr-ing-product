</style>
<style>
  .payroll-totals{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:18px}.payroll-totals article{display:grid;gap:4px;padding:12px 13px;border:1px solid rgba(16,36,31,.08);border-radius:10px;background:#fff}.payroll-totals span{color:var(--muted);font:600 .61rem/1.2 system-ui,sans-serif}.payroll-totals strong{color:#10241f;font:700 1rem/1.1 system-ui,sans-serif}.payroll-totals small{color:var(--muted);font:.61rem/1.35 system-ui,sans-serif}@media(max-width:800px){.payroll-totals{grid-template-columns:repeat(2,1fr)}}@media(max-width:480px){.payroll-totals article{padding:10px}}
