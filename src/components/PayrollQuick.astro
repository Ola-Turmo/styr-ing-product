<style>
  .payroll-employee-form{display:grid;grid-template-columns:minmax(210px,1.45fr) repeat(3,minmax(120px,1fr)) auto;gap:10px;align-items:end;margin-top:18px;padding:15px;border:1px solid rgba(16,36,31,.08);border-radius:12px;background:#fff}.payroll-employee-form h3{margin:0 0 5px;font:700 .78rem/1.2 system-ui,sans-serif}.payroll-employee-form small{display:block;color:var(--muted);font:.64rem/1.4 system-ui,sans-serif}.payroll-employee-form label{display:grid;gap:4px;color:var(--muted);font:600 .62rem/1.2 system-ui,sans-serif}.payroll-employee-form input{width:100%;box-sizing:border-box;padding:8px;border:1px solid rgba(16,36,31,.15);border-radius:7px;background:#fff;font:.72rem system-ui,sans-serif}.payroll-employee-form button{padding:10px 12px;border:0;border-radius:8px;background:#10241f;color:#fff;cursor:pointer;font:700 .67rem/1 system-ui,sans-serif;white-space:nowrap}.payroll-person-lines{display:grid;gap:8px}.payroll-person-lines fieldset{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin:0;padding:10px;border:1px solid rgba(16,36,31,.1);border-radius:9px;background:#fbfafc}.payroll-person-lines legend{max-width:100%;padding:0 5px;color:#10241f;font:700 .65rem/1.2 system-ui,sans-serif}.payroll-grid button:disabled{cursor:not-allowed;opacity:.48}@media(max-width:900px){.payroll-employee-form{grid-template-columns:1fr 1fr}.payroll-employee-form>div{grid-column:1/-1}}@media(max-width:560px){.payroll-employee-form,.payroll-person-lines fieldset{grid-template-columns:1fr}.payroll-employee-form>div{grid-column:auto}}
  .payroll-readiness{display:grid;grid-template-columns:minmax(180px,.7fr) 1fr;gap:14px;align-items:start;margin-top:16px;padding:14px;border:1px solid rgba(16,36,31,.1);border-radius:12px;background:#fff}.payroll-readiness strong,.payroll-readiness span{display:block}.payroll-readiness strong{font:700 .75rem/1.2 system-ui,sans-serif}.payroll-readiness>div>span{margin-top:4px;color:var(--muted);font:.63rem/1.4 system-ui,sans-serif}.payroll-readiness-items{display:flex;flex-wrap:wrap;gap:6px}.payroll-readiness-items>span{display:inline-flex;align-items:center;gap:5px;padding:6px 8px;border-radius:7px;background:#f5f8f5;color:#27643f;font:700 .61rem/1.1 system-ui,sans-serif}.payroll-readiness-items>span.missing{background:#fff2c9;color:#765a10}.payroll-readiness-items b{font-size:.72rem}.payroll-readiness-note{flex-basis:100%;color:var(--muted)!important;font-weight:500!important}@media(max-width:700px){.payroll-readiness{display:block}.payroll-readiness-items{margin-top:10px}}
</style>
