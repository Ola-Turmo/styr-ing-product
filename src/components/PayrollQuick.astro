<section class="payroll-quick" aria-labelledby="payroll-quick-title">
  <div class="payroll-head"><div><span class="section-kicker">Lønn · kontrollert grunnlag</span><h2 id="payroll-quick-title">Lønn tett på regnskapet.</h2><p>For små norske virksomheter: registrer lønn, se nettobeløp og arbeidsgiverkostnad, beregn feriepenger/OTP og klargjør A-melding. Altinn, NAV og utbetaling krever egne avtaler og sendes ikke automatisk.</p></div><span class="payroll-boundary">Ingen ekstern sending</span></div>
  <form id="payroll-employee-form" class="payroll-employee-form"><div><h3>Legg til ansatt i lønnsgrunnlaget</h3><small>Registreres som aktiv person i virksomheten. Fødselsnummer og skattekort lagres ikke her.</small></div><label>Navn<input name="name" required maxlength="200" /></label><label>Rolle<input name="role" maxlength="120" placeholder="Ansatt" /></label><label>Startdato<input name="startDate" type="date" required /></label><button type="submit">Legg til ansatt</button></form>
  <div class="payroll-totals" aria-label="Siste lønnskjøring – kostnadsoppsummering">
    <article><span>Siste brutto</span><strong id="payroll-total-gross">—</strong><small id="payroll-total-period">Ingen kjøring ennå</small></article>
    <article><span>Utbetalt netto</span><strong id="payroll-total-net">—</strong><small>Brutto minus skattetrekk</small></article>
    <article><span>Arbeidsgiverpåslag</span><strong id="payroll-total-employer">—</strong><small>Oppgitt kostnad minus brutto</small></article>
    <article><span>Feriepenger · OTP</span><strong id="payroll-total-compliance">—</strong><small id="payroll-total-compliance-detail">Beregn kontrollgrunnlag under</small></article>
  </div>
  <section id="payroll-readiness" class="payroll-readiness" aria-live="polite">
    <div><strong>Før du kjører lønn</strong><span>Kontroller at grunnkontoene og virksomhetens bankopplysning er klare.</span></div>
    <div id="payroll-readiness-items" class="payroll-readiness-items"><span>Henter oppsett…</span></div>
  </section>
  <div class="payroll-grid">
    <form data-payroll-action="create_run"><h3>1. Ny lønnskjøring</h3><label>Periode<input name="period" type="month" required /></label><div id="payroll-person-lines" class="payroll-person-lines"><small>Henter aktive ansatte…</small></div><div id="payroll-draft-total" class="payroll-draft-total" aria-live="polite"><span>Brutto<strong>0 kr</strong></span><span>Skatt<strong>0 kr</strong></span><span>Netto<strong>0 kr</strong></span></div><label>Samlet arbeidsgiverkostnad<input name="employerCost" type="number" min="0.01" step="0.01" required placeholder="51 300,00" /><small id="payroll-employer-hint">Må minst dekke samlet bruttolønn.</small></label><button type="submit">Opprett utkast</button></form>
    <form data-payroll-action="calculate_compliance"><h3>2. Beregn ferie og OTP</h3><label>Lønnskjøring<select name="payrollRunId" id="quick-payroll-run" required><option value="">Henter kjøringer…</option></select></label><div class="payroll-row"><label>Feriesats<input name="holidayRate" type="number" min="0" max="1" step="0.001" value="0.102" required /></label><label>OTP-sats<input name="otpRate" type="number" min="0" max="1" step="0.001" value="0.02" required /></label></div><small>Standardverdiene er veiledende. Kontroller satsene mot virksomhetens avtaler før godkjenning.</small><button type="submit">Beregn kontrollgrunnlag</button></form>
    <form data-payroll-action="approve_compliance"><h3>3. Godkjenn kontrollgrunnlag</h3><label>Grunnlag<select name="checkId" id="quick-payroll-check" required><option value="">Henter beregninger…</option></select></label><small>Godkjenning låser grunnlaget for bokføringsforslag.</small><button type="submit">Godkjenn beregning</button></form>
    <form data-payroll-action="prepare_submission"><h3>4. Klargjør rapport</h3><label>Rapporttype<select name="submissionType"><option value="a_melding">A-melding</option><option value="nav_income">NAV inntektsmelding</option></select></label><label>Periode<input name="period" type="month" required /></label><button type="submit">Klargjør payload</button><small>Payloaden lagres med hash og må sendes manuelt når Altinn-adapter er konfigurert.</small></form>
  </div>
  <p id="payroll-quick-status" class="payroll-status" role="status" aria-live="polite"></p><div id="payroll-quick-list" class="payroll-list"><p>Henter lønn…</p></div><div class="payroll-items"><div class="payroll-items-head"><strong>Lønnslinjer per ansatt</strong><small>Kontroller linjene før lønn og rapportgrunnlag godkjennes.</small></div><div id="payroll-item-list"><p>Henter lønnslinjer…</p></div></div>
</section>
<script is:inline>
  const payrollEsc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); const payrollMoney=v=>`${(Number(v||0)/100).toLocaleString('nb-NO')} kr`; let payrollBoardId=new URLSearchParams(location.search).get('boardId')||''; let payrollRuns=[]; let payrollChecks=[]; let payrollPeople=[]; const payrollStatus=document.querySelector('#payroll-quick-status');
  const resolvePayrollBoard=async()=>{if(payrollBoardId)return payrollBoardId;try{const a=await(await fetch('/api/auth')).json();payrollBoardId=a.boards?.[0]?.id||''}catch{}return payrollBoardId||(location.pathname==='/finance/'||location.pathname==='/payroll/'?'board-1':'')}; const payrollApi=async payload=>{await resolvePayrollBoard();const r=await fetch('/api/payroll',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({...payload,boardId:payrollBoardId})});const d=await r.json();if(!r.ok)throw Error(d.detail||d.error||'Kunne ikke lagre');return d};
  const loadPayroll=async()=>{await resolvePayrollBoard();const [r,c,s,p,readiness]=await Promise.all([fetch(`/api/payroll?boardId=${encodeURIComponent(payrollBoardId)}&view=runs`).then(x=>x.json()),fetch(`/api/payroll?boardId=${encodeURIComponent(payrollBoardId)}&view=checks`).then(x=>x.json()),fetch(`/api/payroll?boardId=${encodeURIComponent(payrollBoardId)}&view=submissions`).then(x=>x.json()),fetch(`/api/payroll?boardId=${encodeURIComponent(payrollBoardId)}&view=people`).then(x=>x.json()),fetch(`/api/payroll?boardId=${encodeURIComponent(payrollBoardId)}&view=readiness`).then(x=>x.json())]);payrollRuns=r.data||[];payrollChecks=c.data||[];payrollPeople=p.data||[];const ready=readiness.data||{};const readinessItems=[['5000 · lønnskostnad',ready.salary],['2600/260x · forskuddstrekk',ready.withholding],['2930 · skyldig lønn',ready.payable],['5400 · arbeidsgiveravgift',ready.employerExpense],['2770 · skyldig arbeidsgiveravgift',ready.employerLiability],['Bankopplysning',ready.bankAccountConfigured?{name:'satt'}:null]];document.querySelector('#payroll-readiness-items').innerHTML=readinessItems.map(([label,row])=>`<span class="${row?'ready':'missing'}"><b>${row?'✓':'!'}</b>${label}${row&&row.code?` · ${payrollEsc(row.code)}`:''}</span>`).join('')+`<small class="payroll-readiness-note">Banktilkobling, skattetrekkvalidering, Altinn og utbetaling er ikke konfigurert.</small>`;document.querySelector('#payroll-person-lines').innerHTML=payrollPeople.length?payrollPeople.map(x=>`<fieldset data-payroll-person="${payrollEsc(x.id)}"><legend>${payrollEsc(x.name)} · ${payrollEsc(x.role||'Ansatt')}</legend><label>Brutto<input name="personGross" type="number" min="0.01" step="0.01" required /></label><label>Skattetrekk<input name="personTax" type="number" min="0" step="0.01" value="0" required /></label></fieldset>`).join(''):'<small>Ingen aktive ansatte. Legg til en ansatt først.</small>';const createButton=document.querySelector('[data-payroll-action="create_run"] button[type="submit"]');createButton?.toggleAttribute('disabled',!payrollPeople.length);document.querySelector('#quick-payroll-run').innerHTML=payrollRuns.length?payrollRuns.map(x=>`<option value="${payrollEsc(x.id)}">${payrollEsc(x.period)} · brutto ${payrollMoney(x.gross_minor)} · ${payrollEsc(x.status)}</option>`).join(''):'<option value="">Ingen lønnskjøringer</option>';const open=payrollChecks.filter(x=>['calculated','review'].includes(x.status));document.querySelector('#quick-payroll-check').innerHTML=open.length?open.map(x=>`<option value="${payrollEsc(x.id)}">${payrollEsc(x.period)} · ferie ${payrollMoney(x.holiday_pay_minor)} · OTP ${payrollMoney(x.otp_minor)}</option>`).join(''):'<option value="">Ingen åpne beregninger</option>';const submissions=s.data||[];document.querySelector('#payroll-quick-list').innerHTML=payrollRuns.map(x=>{const net=Number(x.gross_minor||0)-Number(x.tax_withheld_minor||0);const check=payrollChecks.find(c=>c.payroll_run_id===x.id);return `<article><div><strong>${payrollEsc(x.period)} · lønnskjøring</strong><small>${payrollEsc(x.employee_count)} ansatte · brutto ${payrollMoney(x.gross_minor)} · skatt ${payrollMoney(x.tax_withheld_minor)} · netto ${payrollMoney(net)} · arbeidsgiverkostnad ${payrollMoney(x.employer_cost_minor)}</small></div><span>${payrollEsc(x.status)}${check?` · kontroll ${payrollEsc(check.status)}`:''}</span></article>`}).join('')||'<p>Ingen lønnskjøringer registrert ennå.</p>';if(submissions.length)document.querySelector('#payroll-quick-list').insertAdjacentHTML('beforeend',`<p class="payroll-submissions"><strong>Rapporter:</strong> ${submissions.slice(0,4).map(x=>`${payrollEsc(x.submission_type)} ${payrollEsc(x.period)} · ${payrollEsc(x.status)}`).join(' · ')}</p>`)};
  document.querySelector('#payroll-employee-form')?.addEventListener('submit',async e=>{e.preventDefault();const f=new FormData(e.currentTarget);payrollStatus.textContent='Registrerer ansatt…';try{await payrollApi({action:'create_employee',name:f.get('name'),role:f.get('role'),startDate:f.get('startDate')});e.currentTarget.reset();payrollStatus.textContent='✓ Den ansatte er lagt til i lønnsgrunnlaget.';await loadPayroll()}catch(err){payrollStatus.textContent=`Kunne ikke registrere ansatt: ${err.message}`}});
  document.querySelectorAll('[data-payroll-action]').forEach(form=>form.addEventListener('submit',async e=>{e.preventDefault();const f=new FormData(form);const payload={action:form.dataset.payrollAction};for(const[k,v]of f.entries())payload[k]=v;if(payload.action==='create_run'){payload.items=[...form.querySelectorAll('[data-payroll-person]')].map(row=>({personId:row.dataset.payrollPerson,grossMinor:Math.round(Number(row.querySelector('[name="personGross"]').value)*100),taxMinor:Math.round(Number(row.querySelector('[name="personTax"]').value)*100)}));delete payload.personGross;delete payload.personTax;}if(payload.employerCost)payload.employerCostMinor=Math.round(Number(payload.employerCost)*100);if(payload.holidayRate)payload.holidayRate=Number(payload.holidayRate);if(payload.otpRate)payload.otpRate=Number(payload.otpRate);payrollStatus.textContent='Lagrer og logger lønnskontroll…';try{const d=await payrollApi(payload);payrollStatus.textContent=d.action==='prepare_submission'?`✓ ${payload.submissionType==='a_melding'?'A-melding':'NAV-inntektsmelding'} er klargjort. Ekstern innsending er ikke satt opp.`:`✓ ${d.action} er registrert · ${d.status||'ok'}.`;form.reset();if(form.dataset.payrollAction==='calculate_compliance'){form.querySelector('[name=holidayRate]').value='0.102';form.querySelector('[name=otpRate]').value='0.02'}await loadPayroll()}catch(err){payrollStatus.textContent=`Kunne ikke lagre: ${err.message}`}}));loadPayroll().catch(()=>{payrollStatus.textContent='Lønnsbildet er midlertidig utilgjengelig.'});
</script>
<script is:inline>
  const payrollTotalsMoney = value => `${(Number(value || 0) / 100).toLocaleString('nb-NO')} kr`;
  const loadPayrollTotals = async () => {
    let boardId = new URLSearchParams(location.search).get('boardId') || '';
    if (!boardId) { try { const auth = await (await fetch('/api/auth')).json(); boardId = auth.boards?.[0]?.id || ''; } catch {} }
    if (!boardId) return;
    const [runsResponse, checksResponse] = await Promise.all([
      fetch(`/api/payroll?boardId=${encodeURIComponent(boardId)}&view=runs`),
      fetch(`/api/payroll?boardId=${encodeURIComponent(boardId)}&view=checks`),
    ]);
    const runsPayload = await runsResponse.json(); const checksPayload = await checksResponse.json();
    const latest = (runsPayload.data || [])[0];
    const checks = checksPayload.data || [];
    const check = latest && checks.find(row => row.payroll_run_id === latest.id);
    const set = (selector, value) => { const element = document.querySelector(selector); if (element) element.textContent = value; };
    set('#payroll-total-gross', latest ? payrollTotalsMoney(latest.gross_minor) : '—');
    set('#payroll-total-net', latest ? payrollTotalsMoney(Number(latest.gross_minor || 0) - Number(latest.tax_withheld_minor || 0)) : '—');
    set('#payroll-total-employer', latest ? payrollTotalsMoney(Math.max(0, Number(latest.employer_cost_minor || 0) - Number(latest.gross_minor || 0))) : '—');
    set('#payroll-total-period', latest ? `${latest.period} · ${latest.status}` : 'Ingen kjøring ennå');
    set('#payroll-total-compliance', check ? `${payrollTotalsMoney(check.holiday_pay_minor)} · ${payrollTotalsMoney(check.otp_minor)}` : '—');
    set('#payroll-total-compliance-detail', check ? `${check.period} · ${check.status}` : 'Beregn kontrollgrunnlag under');
  };
  loadPayrollTotals().catch(() => {});
  // Refresh after a payroll action has had time to commit on the server.
  document.querySelectorAll('[data-payroll-action]').forEach(form => form.addEventListener('submit', () => window.setTimeout(() => loadPayrollTotals().catch(() => {}), 350)));
</script>
<script is:inline>
  const payrollItemsEsc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); const payrollItemsMoney=v=>`${(Number(v||0)/100).toLocaleString('nb-NO')} kr`; let payrollItemsBoard=new URLSearchParams(location.search).get('boardId')||''; const payrollItemsStatus=document.querySelector('#payroll-quick-status');
  const payrollItemsResolve=async()=>{if(payrollItemsBoard)return;try{const a=await(await fetch('/api/auth')).json();payrollItemsBoard=a.boards?.[0]?.id||''}catch{}if(!payrollItemsBoard&&(location.pathname==='/finance/'||location.pathname==='/payroll/'))payrollItemsBoard='board-1'};
  const payrollItemsLoad=async()=>{await payrollItemsResolve();const r=await fetch(`/api/payroll?boardId=${encodeURIComponent(payrollItemsBoard)}&view=items`);const d=await r.json();if(!r.ok)throw Error(d.error||'Kunne ikke hente lønnslinjer');const rows=d.data||[];document.querySelector('#payroll-item-list').innerHTML=rows.length?rows.map(x=>`<article><div><strong>${payrollItemsEsc(x.period)} · ${payrollItemsEsc(x.person_name)}</strong><small>Brutto ${payrollItemsMoney(x.gross_minor)} · skatt ${payrollItemsMoney(x.tax_minor)} · ferie ${payrollItemsMoney(x.holiday_pay_minor)} · OTP ${payrollItemsMoney(x.otp_minor)}</small></div><span>${payrollItemsEsc(x.status)}</span>${x.status==='calculated'?`<button type="button" data-payroll-item-action="review_item" data-item-id="${payrollItemsEsc(x.id)}">Kontroller</button><button type="button" data-payroll-item-action="exclude_item" data-item-id="${payrollItemsEsc(x.id)}">Ekskluder</button>`:''}</article>`).join(''):'<p>Ingen lønnslinjer registrert ennå.</p>';};
  document.querySelector('#payroll-item-list')?.addEventListener('click',async e=>{const b=e.target.closest('[data-payroll-item-action]');if(!b)return;b.disabled=true;try{const r=await fetch('/api/payroll',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({boardId:payrollItemsBoard,action:b.dataset.payrollItemAction,itemId:b.dataset.itemId})});const d=await r.json();if(!r.ok)throw Error(d.error||'Kunne ikke oppdatere lønnslinje');payrollItemsStatus.textContent=`✓ Lønnslinjen er ${d.status==='reviewed'?'kontrollert':'ekskludert'}.`;await payrollItemsLoad()}catch(err){payrollItemsStatus.textContent=`Kunne ikke oppdatere lønnslinje: ${err.message}`;b.disabled=false;}});payrollItemsLoad().catch(()=>{document.querySelector('#payroll-item-list').innerHTML='<p>Lønnslinjer kunne ikke lastes.</p>'});
</script>
<script is:inline>
  const payrollDraftTotalMoney=v=>`${(Number(v||0)/100).toLocaleString('nb-NO')} kr`;
  const payrollDraftTotals=()=>{const form=document.querySelector('[data-payroll-action="create_run"]');if(!form)return;let gross=0,tax=0;form.querySelectorAll('[data-payroll-person]').forEach(row=>{gross+=Math.round(Number(row.querySelector('[name="personGross"]')?.value||0)*100);tax+=Math.round(Number(row.querySelector('[name="personTax"]')?.value||0)*100)});const values=document.querySelectorAll('#payroll-draft-total strong');if(values.length===3){values[0].textContent=payrollDraftTotalMoney(gross);values[1].textContent=payrollDraftTotalMoney(tax);values[2].textContent=payrollDraftTotalMoney(Math.max(0,gross-tax))}const employer=Number(form.querySelector('[name="employerCost"]')?.value||0)*100;const hint=document.querySelector('#payroll-employer-hint');if(hint)hint.textContent=gross>0?(employer>=gross?`Dekker brutto ${payrollDraftTotalMoney(gross)} · arbeidsgiverkostnad er høy nok.`:`Må minst dekke brutto ${payrollDraftTotalMoney(gross)}.`):'Må minst dekke samlet bruttolønn.'};
  document.querySelector('[data-payroll-action="create_run"]')?.addEventListener('input',payrollDraftTotals); payrollDraftTotals();
</script>
<style>
  .payroll-quick{margin:28px 0;padding:26px;border:1px solid rgba(16,36,31,.1);border-radius:18px;background:#f8f5fc}.payroll-head{display:flex;justify-content:space-between;gap:20px}.payroll-head h2{margin:8px 0;font:500 1.8rem/1 Georgia,serif}.payroll-head p{max-width:720px;color:var(--muted);font:.8rem/1.5 system-ui,sans-serif}.payroll-boundary{height:max-content;padding:8px 10px;border-radius:999px;background:#eee9ff;color:#65539a;font:700 .62rem/1 system-ui,sans-serif;white-space:nowrap}.payroll-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:20px}.payroll-grid form{display:grid;gap:8px;padding:15px;border-radius:12px;background:#fff;border:1px solid rgba(16,36,31,.08)}.payroll-grid h3{margin:0;font:700 .78rem/1.2 system-ui,sans-serif}.payroll-grid label{display:grid;gap:4px;color:var(--muted);font:600 .62rem/1.2 system-ui,sans-serif}.payroll-grid input,.payroll-grid select{width:100%;box-sizing:border-box;padding:8px;border:1px solid rgba(16,36,31,.15);border-radius:7px;background:#fff;font:.72rem system-ui,sans-serif}.payroll-grid button{margin-top:auto;padding:9px;border:0;border-radius:8px;background:#7161a2;color:#fff;cursor:pointer;font:700 .67rem/1 system-ui,sans-serif}.payroll-grid small{color:var(--muted);font:.64rem/1.4 system-ui,sans-serif}.payroll-row{display:grid;grid-template-columns:1fr 1fr;gap:7px}.payroll-draft-total{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;padding:9px;border-radius:8px;background:#f8f5fc}.payroll-draft-total span{display:grid;gap:3px;color:var(--muted);font:600 .6rem/1.2 system-ui,sans-serif}.payroll-draft-total strong{color:#10241f;font-size:.72rem}.payroll-status{min-height:1.2em;margin:13px 0 6px;color:#65539a;font:700 .7rem/1.3 system-ui,sans-serif}.payroll-list,.payroll-items{display:grid;gap:7px}.payroll-list article,.payroll-items article{display:grid;grid-template-columns:1fr auto auto auto;gap:10px;align-items:center;padding:12px 13px;border-radius:9px;background:#fff;border:1