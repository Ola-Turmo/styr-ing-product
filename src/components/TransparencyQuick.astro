<section class="tq-shell"><div class="tq-head"><div><span class="tq-kicker">Åpenhetsloven · styrt forberedelse</span><h2>Få leverandørbildet under kontroll.</h2><p>Styr.ing samler leverandører fra ordre, fakturaer og kontrakter. Du vurderer risiko og godkjenner før et årsgrunnlag kan brukes.</p></div><span class="tq-badge">Screening og publisering ikke konfigurert</span></div><div class="tq-grid"><form data-t-action="prepare_transparency_assessments"><h3>Bygg leverandørregister</h3><label>Rapporteringsår<input name="reportYear" value="2026" pattern="\d{4}" maxlength="4" required /></label><button type="submit">Hent kilder og klargjør</button></form><form data-t-action="prepare_transparency_report"><h3>Forbered årsgrunnlag</h3><label>År<input name="reportYear" value="2026" pattern="\d{4}" maxlength="4" required /></label><button type="submit">Bygg hashbart grunnlag</button></form></div><div class="tq-status" id="tq-status" role="status" aria-live="polite"></div><div class="tq-list" id="tq-list"></div></section>
<script is:inline>
const tqEsc=v=>String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
const tqLoad=async()=>{try{const r=await fetch('/api/sustainability?boardId=board-1&view=transparency'),d=(await r.json()).data||[];document.getElementById('tq-list').innerHTML=d.length?d.map(x=>`<article><div><strong>${tqEsc(x.supplier_name)}</strong><p>${tqEsc(x.source_count)} kilder · ${tqEsc(x.assessment_notes||'Faglig vurdering mangler')}</p></div><span>${tqEsc(x.risk_level)}</span><small>${tqEsc(x.status)}</small></article>`).join(''):'<p>Ingen leverandørkilder registrert ennå.</p>'}catch{document.getElementById('tq-status').textContent='Leverandørregisteret kunne ikke lastes.'}};
document.querySelectorAll('[data-t-action]').forEach(form=>form.addEventListener('submit',async event=>{event.preventDefault();const status=document.getElementById('tq-status');const payload=Object.fromEntries(new FormData(form));payload.boardId='board-1';payload.action=form.dataset.tAction;status.textContent='Klargjør og logger…';try{const res=await fetch('/api/sustainability',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(payload)});const data=await res.json();if(!res.ok)throw new Error(data.error||'Kunne ikke klargjøre');status.textContent=`✓ ${data.rowCount||0} leverandører behandlet. Ekstern status: ${data.screening||data.publication||'not_configured'}.`;await tqLoad()}catch(error){status.textContent=`Kunne ikke klargjøre: ${error.message}`}}));tqLoad();
</script>
<style>.tq-shell{max-width:1180px;margin:24px auto 0;padding:24px;border:1px solid #10241f18;border-radius:18px;background:#fffdf4}.tq-head{display:flex;justify-content:space-between;gap:20px}.tq-kicker{font:700 .68rem system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:#477c51}.tq-head h2{margin:9px 0 7px;font:500 1.8rem Georgia,serif;color:#10241f}.tq-head p{max-width:680px;margin:0;color:#63736a;font:.78rem/1.5 system-ui,sans-serif}.tq-badge{height:max-content;padding:8px 10px;border-radius:999px;background:#fff0c7;color:#80621b;font:700 .62rem system-ui,sans-serif}.tq-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:18px}.tq-grid form{display:flex;flex-direction:column;gap:9px;padding:15px;border:1px solid #10241f18;border-radius:13px;background:#fff}.tq-grid h3{font:700 .78rem system-ui,sans-serif}.tq-grid label{display:flex;flex-direction:column;gap:5px;color:#718078;font:600 .62rem system-ui,sans-serif}.tq-grid input{padding:8px;border:1px solid #10241f26;border-radius:8px;background:#fbfdfb;font:.71rem system-ui,sans-serif}.tq-grid button{margin-top:auto;padding:9px;border:0;border-radius:8px;background:#477c51;color:#fff;font:700 .67rem system-ui,sans-serif;cursor:pointer}.tq-status{min-height:1.2em;margin-top:14px;color:#3f764c;font:700 .72rem system-ui,sans-serif}.tq-list{margin-top:12px}.tq-list article{display:grid;grid-template-columns:1.5fr auto auto;gap:12px;align-items:center;padding:12px 4px;border-top:1px solid #10241f12}.tq-list strong{font:600 .78rem system-ui,sans-serif}.tq-list p,.tq-list small{margin:4px 0 0;color:#718078;font:.68rem system-ui,sans-serif}.tq-list span{padding:5px 8px;border-radius:999px;background:#edf5e9;color:#477c51;font:700 .61rem system-ui,sans-serif}.tq-list>p{color:#718078;font:.72rem system-ui,sans-serif}@media(max-width:800px){.tq-shell{margin-left:15px;margin-right:15px}.tq-head{flex-direction:column}.tq-grid{grid-template-columns:1fr}.tq-list article{grid-template-columns:1fr auto}.tq-list article small{grid-column:1}}
</style>
