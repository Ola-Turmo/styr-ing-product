<section class="posting-queue" aria-labelledby="posting-queue-title">
  <div class="posting-queue-head"><div><span class="section-kicker">Hovedbok · kontrollert bokføring</span><h2 id="posting-queue-title">Bokfør det som er godkjent.</h2><p>Styr.ing foreslår vanlige kontoer fra kontoplanen. Du kontrollerer fordring, inntekt eller kostnad og MVA før et separat godkjent forslag kan bli et bilag.</p></div><span class="posting-boundary">Du bekrefter kontoene</span></div>
  <div class="posting-queue-grid">
    <form id="posting-prepare-form"><h3>Forbered bilagsforslag</h3><label>Kilde<select name="sourceType" id="posting-source-type"><option value="sales_invoice">Kundefaktura</option><option value="sales_credit_note">Kreditnota</option><option value="supplier_invoice">Leverandørfaktura</option><option value="payroll_run">Lønnskjøring</option></select></label><label>Godkjent kilde<select name="sourceId" id="posting-source-id" required><option value="">Henter…</option></select></label><div class="posting-row"><label>Periode<input name="period" type="month" value="2026-08" required /></label><label>MVA i kroner<input name="vatAmount" id="posting-vat-amount" type="number" min="0" step="0.01" value="0" required /></label></div><div class="posting-row"><label><span id="posting-primary-label">Kundefordring</span><select name="primaryAccountId" id="posting-primary-account" required></select></label><label><span id="posting-secondary-label">Salgsinntekt</span><select name="secondaryAccountId" id="posting-secondary-account" required></select></label></div><label><span id="posting-vat-label">Utgående MVA</span><select name="vatAccountId" id="posting-vat-account"><option value="">Ingen MVA</option></select></label><div id="posting-payroll-fields" hidden><div class="posting-row"><label>Lønnskostnad<select name="salaryExpenseAccountId" id="posting-salary-account"></select></label><label>Forskuddstrekk<select name="taxLiabilityAccountId" id="posting-tax-account"></select></label></div><div class="posting-row"><label>Skyldig lønn<select name="payrollPayableAccountId" id="posting-payable-account"></select></label><label>Arbeidsgiveravgift<select name="employerCostAccountId" id="posting-employer-expense-account"></select></label></div><label>Skyldig arbeidsgiveravgift<select name="employerLiabilityAccountId" id="posting-employer-liability-account"></select></label><p class="posting-help">Lønn krever godkjent lønnskontroll. Styr.ing lager kun et balansert forslag; du godkjenner før bokføring.</p><p id="posting-payroll-readiness" class="posting-payroll-readiness" role="status" aria-live="polite">Velg lønnskilde for å sjekke nødvendige kontoer.</p></div><p class="posting-help">Forslagene er forhåndsvalg, ikke automatisk kontering. Kontroller kontoene før du fortsetter.</p><button type="submit">Lag forslag til kontroll</button></form>
    <div><h3>Åpne forslag</h3><div id="posting-proposal-list" class="posting-proposal-list"><p class="posting-muted">Henter forslag…</p></div></div>
  </div>
  <p id="posting-status" class="posting-status" role="status" aria-live="polite"></p>
</section>
<script is:inline>
  const postingEsc = v => String(v ?? '').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const postingMoney = v => `${(Number(v||0)/100).toLocaleString('nb-NO')} kr`;
  let postingBoardId = new URLSearchParams(location.search).get('boardId') || ''; let postingAccounts=[]; let postingInvoices=[]; let postingCreditNotes=[]; let postingSuppliers=[]; let postingPayroll=[];
  const postingStatus=document.querySelector('#posting-status'); const sourceType=document.querySelector('#posting-source-type'); const sourceSelect=document.querySelector('#posting-source-id');
  const postingApi=async(path,opts)=>{const r=await fetch(path,opts),d=await r.json();if(!r.ok)throw new Error(d.error||'Kunne ikke hente bokføringsdata');return d};
  const accountByCode=code=>postingAccounts.find(account=>String(account.code)===String(code));
  const postingAccountLabel=id=>{const account=postingAccounts.find(row=>String(row.id)===String(id));return account?`${account.code} · ${account.name}`:id||'Ukjent konto'};
  const selectAccount=(selector,code)=>{const account=accountByCode(code);if(account)document.querySelector(selector).value=account.id;};
  const fillAccountOptions=()=>{const options=postingAccounts.map(x=>`<option value="${postingEsc(x.id)}">${postingEsc(x.code)} · ${postingEsc(x.name)}</option>`).join('');document.querySelector('#posting-primary-account').innerHTML='<option value="">Velg konto…</option>'+(options||'<option value="">Ingen aktive kontoer</option>');document.querySelector('#posting-secondary-account').innerHTML='<option value="">Velg konto…</option>'+(options||'<option value="">Ingen aktive kontoer</option>');document.querySelector('#posting-vat-account').innerHTML='<option value="">Ingen MVA</option>'+options;['#posting-salary-account','#posting-tax-account','#posting-payable-account','#posting-employer-expense-account','#posting-employer-liability-account'].forEach(sel=>{document.querySelector(sel).innerHTML='<option value="">Velg konto…</option>'+options;});};
  const setPostingDefaults=()=>{const type=sourceType.value;const payroll=type==='payroll_run';const supplier=type==='supplier_invoice';const credit=type==='sales_credit_note';document.querySelector('#posting-payroll-fields').hidden=!payroll;document.querySelector('#posting-vat-amount').disabled=payroll;document.querySelector('#posting-primary-label').textContent=supplier?'Kostnad':credit?'Kundefordring (reversering)':'Kundefordring';document.querySelector('#posting-secondary-label').textContent=supplier?'Leverandørgjeld':'Salgsinntekt (reversering)';document.querySelector('#posting-vat-label').textContent=supplier?'Inngående MVA':'Utgående MVA (reversering)';if(payroll){document.querySelector('#posting-vat-amount').value='0';selectAccount('#posting-salary-account','5000');selectAccount('#posting-tax-account','2600');selectAccount('#posting-payable-account','2930');selectAccount('#posting-employer-expense-account','5400');selectAccount('#posting-employer-liability-account','2770');}else if(supplier){selectAccount('#posting-primary-account','4000');selectAccount('#posting-secondary-account','2400');selectAccount('#posting-vat-account','2710');}else{selectAccount('#posting-primary-account','1500');selectAccount('#posting-secondary-account','3000');selectAccount('#posting-vat-account','2700');}};
  const renderPayrollReadiness=()=>{const region=document.querySelector('#posting-payroll-readiness');const submit=document.querySelector('#posting-prepare-form button[type="submit"]');if(!region)return;const payroll=sourceType?.value==='payroll_run';if(!payroll){region.textContent='';region.className='posting-payroll-readiness';if(submit)submit.disabled=false;return;}const source=postingPayroll.find(row=>String(row.id)===String(sourceSelect?.value))||postingPayroll[0];const employerContribution=Math.max(0,Number(source?.employer_cost_minor||0)-Number(source?.gross_minor||0));const requirements=[['Lønnskostnad','#posting-salary-account','5000'],['Forskuddstrekk','#posting-tax-account','2600'],['Skyldig lønn','#posting-payable-account','2930']];if(employerContribution>0){requirements.push(['Arbeidsgiveravgift','#posting-employer-expense-account','5400'],['Skyldig arbeidsgiveravgift','#posting-employer-liability-account','2770']);}const missing=[];for(const [label,selector,code] of requirements){const id=document.querySelector(selector)?.value;const account=postingAccounts.find(row=>String(row.id)===String(id));if(!account){missing.push(`${label} (${code})`);continue;}if(label==='Forskuddstrekk'&&!/^260\d$/.test(String(account.code))){missing.push(`${label} må være 2600/260x (valgt ${account.code})`);}}if(missing.length){region.className='posting-payroll-readiness is-warning';region.textContent=`⚠ Ikke klar for lønnsforslag: ${missing.join(', ')}. Opprett eller velg konto før du fortsetter.`;if(submit)submit.disabled=true;}else{region.className='posting-payroll-readiness is-ready';region.textContent=`✓ Lønnskontoer klare: ${requirements.map(([,selector])=>postingAccountLabel(document.querySelector(selector)?.value)).join(', ')}. Serveren kontrollerer på nytt ved lagring.`;if(submit)submit.disabled=false;}};
  const syncPostingSource=()=>{const type=sourceType.value;const rows=type==='sales_invoice'?postingInvoices:type==='sales_credit_note'?postingCreditNotes:type==='supplier_invoice'?postingSuppliers:postingPayroll;const source=rows.find(row=>String(row.id)===String(sourceSelect.value))||rows[0];if(source){const date=String(source.issue_date||source.due_date||'');document.querySelector('#posting-prepare-form [name="period"]').value=String(source.period||date.slice(0,7)||new Date().toISOString().slice(0,7));document.querySelector('#posting-vat-amount').value=(Number(source.vat_minor||0)/100).toFixed(2);}setPostingDefaults();renderPayrollReadiness();};
  const fillSourceOptions=()=>{const type=sourceType.value;const rows=type==='sales_invoice'?postingInvoices:type==='sales_credit_note'?postingCreditNotes:type==='supplier_invoice'?postingSuppliers:postingPayroll;sourceSelect.innerHTML=rows.length?rows.map(x=>type==='payroll_run'?`<option value="${postingEsc(x.id)}">Lønn ${postingEsc(x.period)} · ${postingMoney(x.employer_cost_minor)} · ${postingEsc(x.employee_count)} ansatte</option>`:`<option value="${postingEsc(x.id)}">${postingEsc(x.invoice_number||x.credit_note_number)} · ${postingMoney(x.total_minor||x.amount_minor)} · ${postingEsc(x.description||x.supplier_name||'')}</option>`).join(''):'<option value="">Ingen godkjente kilder</option>';syncPostingSource();};
  const renderProposals=rows=>{document.querySelector('#posting-proposal-list').innerHTML=rows.length?rows.map(x=>{const payroll=x.source_type==='payroll_run';const credit=x.source_type==='sales_credit_note';let lines=[];try{lines=JSON.parse(x.lines_json||'[]')}catch{}const debit=lines.reduce((sum,line)=>sum+Number(line.debitMinor||0),0),creditTotal=lines.reduce((sum,line)=>sum+Number(line.creditMinor||0),0);const lineRows=lines.map(line=>`<tr><td>${postingEsc(postingAccountLabel(line.accountId))}</td><td>${postingEsc(line.description||'')}</td><td>${line.debitMinor?postingMoney(line.debitMinor):'—'}</td><td>${line.creditMinor?postingMoney(line.creditMinor):'—'}</td></tr>`).join('');return `<article class="posting-proposal"><div><strong>${postingEsc(x.source_reference||x.source_type)}</strong><small>${postingEsc(x.source_label||'')} · ${postingEsc(x.period)} · ${postingMoney(x.amount_minor)}</small></div><span>${postingEsc(x.status)}</span><details class="posting-lines" ${x.status==='review'?'open':''}><summary>Kontroller ${lines.length} bilagslinjer</summary>${lines.length?`<div class="posting-table-wrap"><table><thead><tr><th>Konto</th><th>Tekst</th><th>Debet</th><th>Kredit</th></tr></thead><tbody>${lineRows}</tbody><tfoot><tr><th colspan="2">Sum</th><th>${postingMoney(debit)}</th><th>${postingMoney(creditTotal)}</th></tr></tfoot></table></div><small class="posting-check ${debit===creditTotal&&debit>0?'is-balanced':'is-error'}">${debit===creditTotal&&debit>0?'✓ Forslaget balanserer':'Forslaget balanserer ikke – ikke godkjenn'} · kilde ${postingEsc(String(x.source_hash||'').slice(0,12))}</small>`:'<p class="posting-muted">Ingen bilagslinjer. Ikke godkjenn forslaget.</p>'}</details><div class="posting-actions">${x.status==='review'?`<button data-posting-action="${payroll?'approve_payroll_proposal':credit?'approve_credit_note_proposal':'approve_proposal'}" data-id="${postingEsc(x.id)}" ${!lines.length||debit!==creditTotal?'disabled':''}>Godkjenn kontrollerte linjer</button>`:''}${x.status==='approved'?`<button data-posting-action="${payroll?'post_payroll_proposal':credit?'post_credit_note_proposal':'post_proposal'}" data-id="${postingEsc(x.id)}">Bokfør bilag</button>`:''}${x.status==='posted'?`<small>Bilag ${postingEsc(x.voucher_id||'opprettet')}</small>`:''}</div></article>`;}).join(''):'<p class="posting-muted">Ingen åpne forslag.</p>';};
  const loadPosting=async()=>{const [accounts,sales,credits,suppliers,payroll,proposals]=await Promise.all([postingApi(`/api/finance?boardId=${encodeURIComponent(postingBoardId)}&view=accounts`),postingApi(`/api/finance?boardId=${encodeURIComponent(postingBoardId)}&view=invoices`),postingApi(`/api/finance?boardId=${encodeURIComponent(postingBoardId)}&view=credit-notes`),postingApi(`/api/procurement?boardId=${encodeURIComponent(postingBoardId)}&view=invoices`),postingApi(`/api/payroll?boardId=${encodeURIComponent(postingBoardId)}&view=runs`),postingApi(`/api/postings?boardId=${encodeURIComponent(postingBoardId)}&view=proposals`)]);postingAccounts=(accounts.data||[]).filter(x=>x.active);const proposalKeys=new Set((proposals.data||[]).map(x=>`${x.source_type}:${x.source_id}`));postingInvoices=(sales.data||[]).filter(x=>['approved','sent','paid'].includes(x.status)&&!proposalKeys.has(`sales_invoice:${x.id}`));postingCreditNotes=(credits.data||[]).filter(x=>x.status==='approved'&&!proposalKeys.has(`sales_credit_note:${x.id}`));postingSuppliers=(suppliers.data||[]).filter(x=>['approved','booked','paid'].includes(x.status)&&x.match_status==='matched'&&!proposalKeys.has(`supplier_invoice:${x.id}`));postingPayroll=(payroll.data||[]).filter(x=>x.status==='approved'&&!proposalKeys.has(`payroll_run:${x.id}`));fillAccountOptions();fillSourceOptions();renderPayrollReadiness();renderProposals(proposals.data||[]);};
  sourceType?.addEventListener('change',fillSourceOptions);sourceSelect?.addEventListener('change',syncPostingSource);['#posting-salary-account','#posting-tax-account','#posting-payable-account','#posting-employer-expense-account','#posting-employer-liability-account'].forEach(selector=>document.querySelector(selector)?.addEventListener('change',renderPayrollReadiness));
  document.querySelector('#posting-prepare-form')?.addEventListener('submit',async e=>{e.preventDefault();const f=new FormData(e.currentTarget);const type=f.get('sourceType');const payload={boardId:postingBoardId,action:type==='sales_invoice'?'prepare_sales_invoice':type==='sales_credit_note'?'prepare_credit_note':type==='supplier_invoice'?'prepare_supplier_invoice':'prepare_payroll',sourceId:f.get('sourceId'),period:f.get('period'),primaryAccountId:f.get('primaryAccountId'),secondaryAccountId:f.get('secondaryAccountId'),vatAccountId:f.get('vatAccountId'),vatMinor:Math.round(Number(f.get('vatAmount')||0)*100),salaryExpenseAccountId:f.get('salaryExpenseAccountId'),taxLiabilityAccountId:f.get('taxLiabilityAccountId'),payrollPayableAccountId:f.get('payrollPayableAccountId'),employerCostAccountId:f.get('employerCostAccountId'),employerLiabilityAccountId:f.get('employerLiabilityAccountId')};postingStatus.textContent='Lager kildebevis og forslag…';try{await postingApi('/api/postings',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(payload)});postingStatus.textContent=`✓ Forslaget er sendt til kontroll. Kontroller linjene før bokføring.`;await loadPosting();}catch(err){postingStatus.textContent=`Kunne ikke lage forslag: ${err.message}`;}});
  document.querySelector('#posting-proposal-list')?.addEventListener('click',async e=>{const b=e.target.closest('[data-posting-action]');if(!b)return;b.disabled=true;postingStatus.textContent='Oppdaterer kontrollsporet…';try{const d=await postingApi('/api/postings',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({boardId:postingBoardId,action:b.dataset.postingAction,proposalId:b.dataset.id})});postingStatus.textContent=d.status==='posted'?`✓ Bilag ${d.voucherNumber} er bokført.`:'✓ Forslag godkjent.';await loadPosting();}catch(err){postingStatus.textContent=`Kunne ikke oppdatere: ${err.message}`;b.disabled=false;}});
  (async()=>{try{if(!postingBoardId){const auth=await (await fetch('/api/auth')).json();postingBoardId=auth.boards?.[0]?.id||'';}if(!postingBoardId)throw new Error('Ingen virksomhet valgt');await loadPosting();}catch(e){postingStatus.textContent=`Bokføringskøen kunne ikke lastes: ${e.message}`;}})();
</script>
<style>
  .posting-queue{margin:18px 0;padding:24px;border:1px solid rgba(16,36,31,.1);border-radius:18px;background:#f5f8f5}.posting-queue-head{display:flex;justify-content:space-between;gap:20px}.posting-queue h2{margin:8px 0;font:500 1.8rem/1 Georgia,serif}.posting-queue p{max-width:700px;color:var(--muted);font:.8rem/1.5 system-ui,sans-serif}.posting-help{margin:0!important;padding:8px;border-radius:8px;background:#f5f8f5;font-size:.65rem!important}.posting-payroll-readiness{margin:0!important;padding:9px;border-radius:8px;font-size:.68rem!important}.posting-payroll-readiness.is-ready{background:#e7f5e8;color:#27643f}.posting-payroll-readiness.is-warning{background:#fff2c9;color:#765a10}.posting-boundary{padding:8px 10px;height:max-content;border-radius:999px;background:#fff2c9;color:#765a10;font:700 .62rem/1 system-ui,sans-serif;white-space:nowrap}.posting-queue-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:20px}.posting-queue form{display:grid;gap:9px;padding:16px;border:1px solid rgba(16,36,31,.1);border-radius:12px;background:#fff}.posting-queue h3{margin:0 0 3px;font:700 .78rem/1.2 system-ui,sans-serif}.posting-queue label{display:grid;gap:5px;color:var(--muted);font:600 .63rem/1.2 system-ui,sans-serif}.posting-queue input,.posting-queue select{width:100%;box-sizing:border-box;padding:8px;border:1px solid rgba(16,36,31,.15);border-radius:8px;background:#fff;font:.7rem system-ui,sans-serif}.posting-queue button{padding:9px 11px;border:0;border-radius:8px;background:#10241f;color:#fff;cursor:pointer;font:700 .67rem/1 system-ui,sans-serif}.posting-queue button:disabled{opacity:.45;cursor:not-allowed}.posting-row{display:grid;grid-template-columns:1fr 1fr;gap:7px}.posting-proposal-list{display:grid;gap:7px}.posting-proposal{display:grid;grid-template-columns:1fr auto;gap:9px;align-items:center;padding:12px;border:1px solid rgba(16,36,31,.1);border-radius:10px;background:#fff;font: .72rem system-ui,sans-serif}.posting-proposal strong,.posting-proposal small{display:block}.posting-proposal small{margin-top:4px;color:var(--muted);font-size:.63rem}.posting-proposal>span{color:#765a10;font-size:.64rem;font-weight:700}.posting-lines{grid-column:1/-1;border:1px solid rgba(16,36,31,.09);border-radius:8px;background:#fbfcfa}.posting-lines summary{padding:9px;cursor:pointer;font-weight:700}.posting-table-wrap{overflow-x:auto}.posting-lines table{width:100%;border-collapse:collapse;font-size:.63rem}.posting-lines th,.posting-lines td{padding:7px;text-align:left;border-top:1px solid rgba(16,36,31,.08);white-space:nowrap}.posting-lines th:nth-child(n+3),.posting-lines td:nth-child(n+3){text-align:right}.posting-check{padding:8px}.posting-check.is-balanced{color:#27643f}.posting-check.is-error{color:#9a3d27}.posting-actions{grid-column:1/-1;display:flex;gap:7px;align-items:center}.posting-actions button{background:#28624c}.posting-muted{color:var(--muted);font:.74rem/1.4 system-ui,sans-serif}.posting-status{min-height:1.2em;margin:14px 0 0;color:#27643f;font:700 .7rem/1.35 system-ui,sans-serif}@media(max-width:760px){.posting-queue-head,.posting-queue-grid{display:flex;flex-direction:column;align-items:stretch}.posting-row{grid-template-columns:1fr}}
</style>
