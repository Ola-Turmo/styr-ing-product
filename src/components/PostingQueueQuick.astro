<section class="posting-queue" aria-labelledby="posting-queue-title">
  <div class="posting-queue-head"><div><span class="section-kicker">Hovedbok · kontrollert bokføring</span><h2 id="posting-queue-title">Fra godkjent faktura til bilag</h2><p>Velg kontoer selv. Styr.ing lager et forslag med kildehash; først etter separat godkjenning kan forslaget bokføres.</p></div><span class="posting-boundary">Ingen automatisk kontering</span></div>
  <div class="posting-queue-grid">
    <form id="posting-prepare-form"><h3>Forbered bilagsforslag</h3><label>Kilde<select name="sourceType" id="posting-source-type"><option value="sales_invoice">Kundefaktura</option><option value="supplier_invoice">Leverandørfaktura</option></select></label><label>Godkjent kilde<select name="sourceId" id="posting-source-id" required><option value="">Henter…</option></select></label><div class="posting-row"><label>Periode<input name="period" type="month" value="2026-08" required /></label><label>MVA i øre<input name="vatMinor" type="number" min="0" step="1" value="0" required /></label></div><div class="posting-row"><label>Fordring / kostnad<select name="primaryAccountId" id="posting-primary-account" required></select></label><label>Inntekt / gjeld<select name="secondaryAccountId" id="posting-secondary-account" required></select></label></div><label>MVA-konto (valgfritt)<select name="vatAccountId" id="posting-vat-account"><option value="">Ingen MVA</option></select></label><button type="submit">Lag forslag til kontroll</button></form>
    <div><h3>Åpne forslag</h3><div id="posting-proposal-list" class="posting-proposal-list"><p class="posting-muted">Henter forslag…</p></div></div>
  </div>
  <p id="posting-status" class="posting-status" role="status" aria-live="polite"></p>
</section>
<script is:inline>
  const postingEsc = v => String(v ?? '').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const postingMoney = v => `${(Number(v||0)/100).toLocaleString('nb-NO')} kr`;
  let postingBoardId = new URLSearchParams(location.search).get('boardId') || ''; let postingAccounts=[]; let postingInvoices=[]; let postingSuppliers=[];
  const postingStatus=document.querySelector('#posting-status'); const sourceType=document.querySelector('#posting-source-type'); const sourceSelect=document.querySelector('#posting-source-id');
  const postingApi=async(path,opts)=>{const r=await fetch(path,opts),d=await r.json();if(!r.ok)throw new Error(d.error||'Kunne ikke hente bokføringsdata');return d};
  const fillAccountOptions=()=>{const options=postingAccounts.map(x=>`<option value="${postingEsc(x.id)}">${postingEsc(x.code)} · ${postingEsc(x.name)}</option>`).join('');document.querySelector('#posting-primary-account').innerHTML=options||'<option value="">Ingen aktive kontoer</option>';document.querySelector('#posting-secondary-account').innerHTML=options||'<option value="">Ingen aktive kontoer</option>';document.querySelector('#posting-vat-account').innerHTML='<option value="">Ingen MVA</option>'+options;};
  const fillSourceOptions=()=>{const rows=sourceType.value==='sales_invoice'?postingInvoices:postingSuppliers;sourceSelect.innerHTML=rows.length?rows.map(x=>`<option value="${postingEsc(x.id)}">${postingEsc(x.invoice_number)} · ${postingMoney(x.total_minor||x.amount_minor)} · ${postingEsc(x.description||x.supplier_name||'')}</option>`).join(''):'<option value="">Ingen godkjente kilder</option>';};
  const renderProposals=rows=>{document.querySelector('#posting-proposal-list').innerHTML=rows.length?rows.map(x=>`<article class="posting-proposal"><div><strong>${postingEsc(x.source_reference||x.source_type)}</strong><small>${postingEsc(x.source_label||'')} · ${postingEsc(x.period)} · ${postingMoney(x.amount_minor)}</small></div><span>${postingEsc(x.status)}</span><div class="posting-actions">${x.status==='review'?`<button data-posting-action="approve_proposal" data-id="${postingEsc(x.id)}">Godkjenn</button>`:''}${x.status==='approved'?`<button data-posting-action="post_proposal" data-id="${postingEsc(x.id)}">Bokfør bilag</button>`:''}${x.status==='posted'?`<small>Bilag ${postingEsc(x.voucher_id||'opprettet')}</small>`:''}</div></article>`).join(''):'<p class="posting-muted">Ingen åpne forslag.</p>';};
  const loadPosting=async()=>{const [accounts,sales,suppliers,proposals]=await Promise.all([postingApi(`/api/finance?boardId=${encodeURIComponent(postingBoardId)}&view=accounts`),postingApi(`/api/finance?boardId=${encodeURIComponent(postingBoardId)}&view=invoices`),postingApi(`/api/procurement?boardId=${encodeURIComponent(postingBoardId)}&view=invoices`),postingApi(`/api/postings?boardId=${encodeURIComponent(postingBoardId)}&view=proposals`)]);postingAccounts=(accounts.data||[]).filter(x=>x.active);postingInvoices=(sales.data||[]).filter(x=>x.status==='approved');postingSuppliers=(suppliers.data||[]).filter(x=>x.status==='approved'&&x.match_status==='matched');fillAccountOptions();fillSourceOptions();renderProposals(proposals.data||[]);};
  sourceType?.addEventListener('change',fillSourceOptions);
  document.querySelector('#posting-prepare-form')?.addEventListener('submit',async e=>{e.preventDefault();const f=new FormData(e.currentTarget);const type=f.get('sourceType');const payload={boardId:postingBoardId,action:type==='sales_invoice'?'prepare_sales_invoice':'prepare_supplier_invoice',sourceId:f.get('sourceId'),period:f.get('period'),primaryAccountId:f.get('primaryAccountId'),secondaryAccountId:f.get('secondaryAccountId'),vatAccountId:f.get('vatAccountId'),vatMinor:Number(f.get('vatMinor')||0)};postingStatus.textContent='Lager kildebevis og forslag…';try{const d=await postingApi('/api/postings',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(payload)});postingStatus.textContent=`✓ Forslag ${d.proposalId} er sendt til kontroll.`;await loadPosting();}catch(err){postingStatus.textContent=`Kunne ikke lage forslag: ${err.message}`;}});
  document.querySelector('#posting-proposal-list')?.addEventListener('click',async e=>{const b=e.target.closest('[data-posting-action]');if(!b)return;b.disabled=true;postingStatus.textContent='Oppdaterer kontrollsporet…';try{const d=await postingApi('/api/postings',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({boardId:postingBoardId,action:b.dataset.postingAction,proposalId:b.dataset.id})});postingStatus.textContent=d.status==='posted'?`✓ Bilag ${d.voucherNumber} er bokført.`:'✓ Forslag godkjent.';await loadPosting();}catch(err){postingStatus.textContent=`Kunne ikke oppdatere: ${err.message}`;b.disabled=false;}});
  (async()=>{try{if(!postingBoardId){const auth=await (await fetch('/api/auth')).json();postingBoardId=auth.boards?.[0]?.id||'';}if(!postingBoardId)throw new Error('Ingen virksomhet valgt');await loadPosting();}catch(e){postingStatus.textContent=`Bokføringskøen kunne ikke lastes: ${e.message}`;}})();
</script>
<style>
  .posting-queue{margin:18px 0;padding:24px;border:1px solid rgba(16,36,31,.1);border-radius:18px;background:#f5f8f5}.posting-queue-head{display:flex;justify-content:space-between;gap:20px}.posting-queue h2{margin:8px 0;font:500 1.8rem/1 Georgia,serif}.posting-queue p{max-width:700px;color:var(--muted);font:.8rem/1.5 system-ui,sans-serif}.posting-boundary{padding:8px 10px;height:max-content;border-radius:999px;background:#fff2c9;color:#765a10;font:700 .62rem/1 system-ui,sans-serif;white-space:nowrap}.posting-queue-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:20px}.posting-queue form{display:grid;gap:9px;padding:16px;border:1px solid rgba(16,36,31,.1);border-radius:12px;background:#fff}.posting-queue h3{margin:0 0 3px;font:700 .78rem/1.2 system-ui,sans-serif}.posting-queue label{display:grid;gap:5px;color:var(--muted);font:600 .63rem/1.2 system-ui,sans-serif}.posting-queue input,.posting-queue select{width:100%;box-sizing:border-box;padding:8px;border:1px solid rgba(16,36,31,.15);border-radius:8px;background:#fff;font:.7rem system-ui,sans-serif}.posting-queue button{padding:9px 11px;border:0;border-radius:8px;background:#10241f;color:#fff;cursor:pointer;font:700 .67rem/1 system-ui,sans-serif}.posting-row{display:grid;grid-template-columns:1fr 1fr;gap:7px}.posting-proposal-list{display:grid;gap:7px}.posting-proposal{display:grid;grid-template-columns:1fr auto;gap:9px;align-items:center;padding:12px;border:1px solid rgba(16,36,31,.1);border-radius:10px;background:#fff;font: .72rem system-ui,sans-serif}.posting-proposal strong,.posting-proposal small{display:block}.posting-proposal small{margin-top:4px;color:var(--muted);font-size:.63rem}.posting-proposal>span{color:#765a10;font-size:.64rem;font-weight:700}.posting-actions{grid-column:1/-1;display:flex;gap:7px;align-items:center}.posting-actions button{background:#28624c}.posting-muted{color:var(--muted);font:.74rem/1.4 system-ui,sans-serif}.posting-status{min-height:1.2em;margin:14px 0 0;color:#27643f;font:700 .7rem/1.35 system-ui,sans-serif}@media(max-width:760px){.posting-queue-head,.posting-queue-grid{display:flex;flex-direction:column;align-items:stretch}.posting-row{grid-template-columns:1fr}}
</style>
