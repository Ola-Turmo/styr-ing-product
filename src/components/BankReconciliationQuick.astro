<section class="bank-reconciliation" aria-labelledby="bank-reconciliation-title">
  <div class="bank-reconciliation-intro"><span class="section-kicker">Bank og avstemming</span><h2 id="bank-reconciliation-title">Importer først.<br /><em>Godkjenn selv.</em></h2><p>Legg inn kontoutskriftens grunnlag, se et forklarbart match-forslag og godkjenn manuelt. Ingen bank kobles til, og ingenting bokføres automatisk i denne flaten.</p></div>
  <div class="bank-reconciliation-grid">
    <form data-bank-action="create_account"><h3>Registrer konto</h3><label>Kontonavn<input name="name" required placeholder="Driftskonto" /></label><div class="bank-row"><label>Siste fire siffer<input name="accountLastFour" inputmode="numeric" maxlength="4" placeholder="1234" /></label><label>Valuta<input name="currency" value="NOK" maxlength="3" required /></label></div><label>Hovedbokskonto<select name="ledgerAccountId" id="bank-ledger-account"><option value="">Velg konto …</option></select></label><button type="submit">Lagre konto</button><small>Manuell konto · banktilkobling ikke aktivert</small></form>
    <form data-bank-action="import_transaction"><h3>Importer transaksjon</h3><label>Konto<select name="bankAccountId" id="bank-account-id" required><option value="">Henter kontoer…</option></select></label><div class="bank-row"><label>Dato<input name="transactionDate" type="date" value="2026-08-25" required /></label><label>Beløp i øre<input name="amountMinor" type="number" step="1" required placeholder="-12500" /></label></div><label>Beskrivelse<input name="description" maxlength="240" required placeholder="Klarna / leverandør / kunde" /></label><label>Referanse<input name="externalReference" maxlength="160" required placeholder="Kontoutskrift-ID" /></label><label>Motpart<input name="counterparty" maxlength="160" placeholder="Navn eller butikk" /></label><button type="submit">Importer grunnlag</button></form>
    <form data-bank-action="suggest_match"><h3>Finn match</h3><label>Transaksjon<select name="transactionId" id="bank-suggest-id" required><option value="">Henter transaksjoner…</option></select></label><p class="bank-note">Forslaget bruker beløp, referanse og motpart. Det er aldri bokføring.</p><button type="submit">Foreslå match</button></form>
    <form data-bank-action="approve_match"><h3>Godkjenn match</h3><label>Forslag<select name="transactionId" id="bank-approve-id" required><option value="">Henter forslag…</option></select></label><p class="bank-note">Kontroller dokumentasjonen før du godkjenner.</p><button type="submit">Godkjenn avstemming</button></form>
    <form data-bank-action="post_match"><h3>Bokfør godkjent match</h3><label>Godkjent transaksjon<select name="transactionId" id="bank-post-id" required><option value="">Henter godkjente…</option></select></label><label>Motkonto<select name="counterAccountId" id="bank-counter-account" required><option value="">Henter kontoplan…</option></select></label><p class="bank-note">Oppretter ett balansert bilag. Ingen MVA gjettes.</p><button type="submit">Bokfør bilag</button></form>
  </div>
  <p id="bank-reconciliation-status" class="bank-reconciliation-status" role="status" aria-live="polite"></p>
  <div class="bank-reconciliation-summary"><span><b id="bank-account-count">—</b> kontoer</span><span><b id="bank-open-count">—</b> åpne transaksjoner</span><span><b id="bank-suggested-count">—</b> til godkjenning</span></div>
  <div id="bank-reconciliation-list" class="bank-reconciliation-list"><p>Henter bankgrunnlag…</p></div>
</section>
<script is:inline>
  const bankEsc = (v) => String(v ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const bankMoney = v => `${(Number(v || 0) / 100).toLocaleString('nb-NO')} kr`;
  let bankAccounts = [], bankTransactions = [];
  const bankStatus = { imported:'Importert', suggested:'Forslag klart', approved:'Godkjent', rejected:'Avvist' };
  const loadBank = async () => { const [summary, accounts, transactions, ledger] = await Promise.all(['summary','accounts','transactions'].map(view => fetch(`/api/bank?boardId=board-1&view=${view}`).then(r=>r.json())).concat([fetch('/api/finance?boardId=board-1&view=accounts').then(r=>r.json())])); const s=summary.data||{}; bankAccounts=accounts.data||[]; bankTransactions=transactions.data||[]; const ledgerAccounts=ledger.data||[]; document.querySelector('#bank-account-count').textContent=s.accounts?.count??bankAccounts.length; document.querySelector('#bank-open-count').textContent=s.transactions?.count??0; document.querySelector('#bank-suggested-count').textContent=s.suggestions?.count??0; const ledgerOptions=ledgerAccounts.length?ledgerAccounts.map(x=>`<option value="${bankEsc(x.id)}">${bankEsc(x.code)} · ${bankEsc(x.name)}</option>`).join(''):'<option value="">Ingen aktive kontoer</option>'; document.querySelector('#bank-ledger-account').innerHTML='<option value="">Velg konto …</option>'+ledgerOptions; document.querySelector('#bank-account-id').innerHTML=bankAccounts.length?bankAccounts.map(x=>`<option value="${bankEsc(x.id)}">${bankEsc(x.name)} · ${bankEsc(x.currency||'NOK')}</option>`).join(''):'<option value="">Registrer en konto først</option>'; document.querySelector('#bank-counter-account').innerHTML=ledgerOptions; const open=bankTransactions.filter(x=>['imported','suggested'].includes(x.status)); const suggested=bankTransactions.filter(x=>x.status==='suggested'); const approved=bankTransactions.filter(x=>x.status==='approved'&&!x.posted_voucher_id); document.querySelector('#bank-suggest-id').innerHTML=open.length?open.map(x=>`<option value="${bankEsc(x.id)}">${bankEsc(x.transaction_date)} · ${bankEsc(x.description)} · ${bankMoney(x.amount_minor)}</option>`).join(''):'<option value="">Ingen åpne transaksjoner</option>'; document.querySelector('#bank-approve-id').innerHTML=suggested.length?suggested.map(x=>`<option value="${bankEsc(x.id)}">${bankEsc(x.description)} · ${bankMoney(x.amount_minor)} · ${bankEsc(x.match_confidence||'forslag')}</option>`).join(''):'<option value="">Ingen forslag til godkjenning</option>'; document.querySelector('#bank-post-id').innerHTML=approved.length?approved.map(x=>`<option value="${bankEsc(x.id)}">${bankEsc(x.description)} · ${bankMoney(x.amount_minor)}</option>`).join(''):'<option value="">Ingen godkjente matcher</option>'; document.querySelector('#bank-reconciliation-list').innerHTML=bankTransactions.map(x=>`<article><div><strong>${bankEsc(x.transaction_date)} · ${bankEsc(x.description)}</strong><p>${bankEsc(x.account_name||'Konto')} · ${bankEsc(x.external_reference)}${x.match_entity_type?` · match: ${bankEsc(x.match_entity_type)}`:''}</p></div><b>${bankMoney(x.amount_minor)}</b><span class="bank-pill ${bankEsc(x.status)}">${bankEsc(x.status==='posted'?'Bokført':bankStatus[x.status]||x.status)}</span></article>`).join('')||'<p>Ingen transaksjoner importert ennå.</p>'; };
  document.querySelectorAll('[data-bank-action]').forEach(form => form.addEventListener('submit', async event => { event.preventDefault(); const status=document.querySelector('#bank-reconciliation-status'); const payload=Object.fromEntries(new FormData(form)); payload.boardId='board-1'; payload.action=form.dataset.bankAction; status.textContent='Lagrer og logger handling…'; try { const res=await fetch('/api/bank',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(payload)}); const data=await res.json(); if(!res.ok) throw new Error(data.error||'Kunne ikke lagre'); status.textContent=`✓ ${data.action} er registrert · ${data.status||'ok'}${data.suggestion?` · forslag: ${data.suggestion.description}`:''}.`; form.reset(); await loadBank(); } catch(error) { status.textContent=`Kunne ikke lagre: ${error.message}`; } }));
  loadBank().catch(()=>{ document.querySelector('#bank-reconciliation-status').textContent='Bankbildet er midlertidig utilgjengelig.'; });
</script>
<style>
  .bank-reconciliation{margin:28px 0;padding:26px;border:1px solid rgba(16,36,31,.1);border-radius:18px;background:#f3f6ef}.bank-reconciliation-intro h2{margin:8px 0;font:500 1.8rem/1 Georgia,serif}.bank-reconciliation-intro h2 em{font-style:normal;color:var(--accent)}.bank-reconciliation-intro p{max-width:760px;color:var(--muted);font:.8rem/1.5 system-ui,sans-serif}.bank-reconciliation-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:20px}.bank-reconciliation-grid form{display:grid;gap:8px;padding:15px;border-radius:12px;background:#fff;border:1px solid rgba(16,36,31,.08)}.bank-reconciliation-grid h3{font:700 .8rem/1.2 system-ui,sans-serif}.bank-reconciliation-grid label{display:grid;gap:4px;color:var(--muted);font:600 .62rem/1.2 system-ui,sans-serif}.bank-reconciliation-grid input,.bank-reconciliation-grid select{width:100%;min-width:0;padding:8px;border:1px solid rgba(16,36,31,.15);border-radius:7px;background:#fff;font:.72rem system-ui,sans-serif}.bank-reconciliation-grid button{margin-top:auto;border:0;border-radius:7px;padding:9px;background:var(--accent);color:#fff;font:700 .68rem/1 system-ui,sans-serif;cursor:pointer}.bank-reconciliation-grid small,.bank-note{margin:0;color:var(--muted);font:.64rem/1.4 system-ui,sans-serif}.bank-row{display:grid;grid-template-columns:1fr 1fr;gap:6px}.bank-reconciliation-status{min-height:1.2em;margin:13px 0 6px;color:var(--accent);font:700 .7rem/1.3 system-ui,sans-serif}.bank-reconciliation-summary{display:flex;flex-wrap:wrap;gap:14px;margin:12px 0;color:var(--muted);font:600 .67rem/1.3 system-ui,sans-serif}.bank-reconciliation-summary b{color:var(--ink);font-size:.9rem}.bank-reconciliation-list{display:grid;gap:7px}.bank-reconciliation-list article{display:grid;grid-template-columns:1fr auto auto;gap:14px;align-items:center;padding:12px 13px;border-radius:9px;background:#fff;border:1px solid rgba(16,36,31,.08);font-family:system-ui,sans-serif}.bank-reconciliation-list strong{display:block;font-size:.75rem}.bank-reconciliation-list p{margin:4px 0 0;color:var(--muted);font-size:.65rem}.bank-reconciliation-list>b{font-size:.72rem}.bank-pill{font:700 .62rem/1 system-ui,sans-serif;color:var(--accent)}.bank-pill.suggested{color:#a36e21}.bank-pill.rejected{color:#a9442d}@media(max-width:1000px){.bank-reconciliation-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.bank-reconciliation{padding:18px}.bank-reconciliation-grid{grid-template-columns:1fr}.bank-reconciliation-list article{grid-template-columns:1fr auto}.bank-reconciliation-list span{grid-column:1/-1}}
</style>
