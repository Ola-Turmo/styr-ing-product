<section class="bank-reconciliation" aria-labelledby="bank-reconciliation-title">
  <div class="bank-reconciliation-intro"><span class="section-kicker">Bank og avstemming</span><h2 id="bank-reconciliation-title">Importer først.<br /><em>Godkjenn selv.</em></h2><p>Legg inn kontoutskriftens grunnlag, se et forklarbart match-forslag og godkjenn manuelt. Ingenting bokføres uten at du velger motkonto og trykker «Bokfør bilag».</p></div>
  <div class="bank-reconciliation-grid">
    <form data-bank-action="create_account"><h3>Registrer konto</h3><label>Kontonavn<input name="name" required placeholder="Driftskonto" /></label><div class="bank-row"><label>Siste fire siffer<input name="accountLastFour" inputmode="numeric" maxlength="4" placeholder="1234" /></label><label>Valuta<input name="currency" value="NOK" maxlength="3" required /></label></div><label>Hovedbokskonto<select name="ledgerAccountId" id="bank-ledger-account"><option value="">Velg konto …</option></select></label><button type="submit">Lagre konto</button><small>Manuell konto · banktilkobling ikke aktivert</small></form>
    <form data-bank-action="import_transactions"><h3>Importer kontoutdrag</h3><label>Konto<select name="bankAccountId" id="bank-account-id" required><option value="">Henter kontoer…</option></select></label><label>CSV-linjer<input name="statementFile" id="bank-statement-file" type="file" accept=".csv,text/csv" required /></label><p class="bank-note">Format: dato;beløp;beskrivelse;referanse;motpart. Første rad kan være overskrift.</p><div id="bank-import-preview" class="bank-import-preview" role="region" aria-live="polite" aria-label="Forhåndsvisning av kontoutdrag" hidden></div><button type="submit">Importer kontoutdrag</button><small>Ingen automatisk bankkobling eller betaling er aktivert.</small></form>
    <form data-bank-action="suggest_match"><h3>Finn match</h3><label>Transaksjon<select name="transactionId" id="bank-suggest-id" required><option value="">Henter transaksjoner…</option></select></label><p class="bank-note">Forslaget bruker beløp, referanse og motpart. Det er aldri bokføring.</p><button type="submit">Foreslå match</button></form>
    <form data-bank-action="approve_match"><h3>Godkjenn match</h3><label>Forslag<select name="transactionId" id="bank-approve-id" required><option value="">Henter forslag…</option></select></label><p class="bank-note">Kontroller dokumentasjonen før du godkjenner.</p><button type="submit">Godkjenn avstemming</button></form>
    <form data-bank-action="reject_match"><h3>Avvis forslag</h3><label>Forslag<select name="transactionId" id="bank-reject-id" required><option value="">Henter forslag…</option></select></label><label>Forklaring<input name="reason" maxlength="240" required placeholder="For eksempel feil kunde eller beløp" /></label><p class="bank-note">Avvisningen logges. Du kan deretter plassere linjen manuelt.</p><button type="submit">Avvis match</button></form>
    <form data-bank-action="classify_transaction"><h3>Plasser annen banklinje</h3><label>Transaksjon<select name="transactionId" id="bank-classify-id" required><option value="">Henter transaksjoner…</option></select></label><label>Motkonto<select name="counterAccountId" id="bank-classify-account" required><option value="">Henter kontoplan…</option></select></label><label>Forklaring<input name="classificationNote" maxlength="200" required placeholder="For eksempel bankgebyr" /></label><p class="bank-note">For husleie, gebyrer, overføringer og eierinnskudd. MVA gjettes aldri.</p><button type="submit">Godkjenn plassering</button></form>
    <form data-bank-action="post_match"><h3>Bokfør godkjent match</h3><label>Godkjent transaksjon<select name="transactionId" id="bank-post-id" required><option value="">Henter godkjente…</option></select></label><label>Motkonto<select name="counterAccountId" id="bank-counter-account" required><option value="">Henter kontoplan…</option></select></label><p class="bank-note">Oppretter ett balansert bilag. Ingen MVA gjettes.</p><button type="submit">Bokfør bilag</button></form>
  </div>
  <p id="bank-reconciliation-status" class="bank-reconciliation-status" role="status" aria-live="polite"></p>
  <div class="bank-reconciliation-summary"><span><b id="bank-account-count">—</b> kontoer</span><span><b id="bank-open-count">—</b> åpne transaksjoner</span><span><b id="bank-suggested-count">—</b> til godkjenning</span></div>
  <div id="bank-reconciliation-list" class="bank-reconciliation-list"><p>Henter bankgrunnlag…</p></div>
</section>
<script is:inline>
  const bankEsc = (v) => String(v ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const bankMoney = v => `${(Number(v || 0) / 100).toLocaleString('nb-NO')} kr`;
  let bankAccounts = [], bankTransactions = [];
  const bankStatus = { imported:'Importert', suggested:'Forslag klart', approved:'Godkjent', rejected:'Avvist' };
  let bankBoardId = new URLSearchParams(location.search).get('boardId') || '';
  const resolveBankBoard = async () => { if (bankBoardId) return bankBoardId; try { const auth=await (await fetch('/api/auth')).json(); bankBoardId=auth.boards?.[0]?.id||''; } catch {} return bankBoardId || (location.pathname === '/finance/' ? 'board-1' : ''); };
  const loadBank = async () => { await resolveBankBoard(); const [summary, accounts, transactions, ledger] = await Promise.all(['summary','accounts','transactions'].map(view => fetch(`/api/bank?boardId=${encodeURIComponent(bankBoardId)}&view=${view}`).then(r=>r.json())).concat([fetch(`/api/finance?boardId=${encodeURIComponent(bankBoardId)}&view=accounts`).then(r=>r.json())])); const s=summary.data||{}; bankAccounts=accounts.data||[]; bankTransactions=transactions.data||[]; const ledgerAccounts=ledger.data||[]; document.querySelector('#bank-account-count').textContent=s.accounts?.count??bankAccounts.length; document.querySelector('#bank-open-count').textContent=s.transactions?.count??0; document.querySelector('#bank-suggested-count').textContent=s.suggestions?.count??0; const ledgerOptions=ledgerAccounts.length?ledgerAccounts.map(x=>`<option value="${bankEsc(x.id)}">${bankEsc(x.code)} · ${bankEsc(x.name)}</option>`).join(''):'<option value="">Ingen aktive kontoer</option>'; document.querySelector('#bank-ledger-account').innerHTML='<option value="">Velg konto …</option>'+ledgerOptions; document.querySelector('#bank-account-id').innerHTML=bankAccounts.length?bankAccounts.map(x=>`<option value="${bankEsc(x.id)}">${bankEsc(x.name)} · ${bankEsc(x.currency||'NOK')}</option>`).join(''):'<option value="">Registrer en konto først</option>'; document.querySelector('#bank-counter-account').innerHTML=ledgerOptions; document.querySelector('#bank-classify-account').innerHTML='<option value="">Velg motkonto …</option>'+ledgerOptions; const open=bankTransactions.filter(x=>['imported','suggested'].includes(x.status)); const suggested=bankTransactions.filter(x=>x.status==='suggested'); const approved=bankTransactions.filter(x=>x.status==='approved'&&!x.posted_voucher_id); const classifiable=bankTransactions.filter(x=>['imported','suggested','rejected'].includes(x.status)&&!x.posted_voucher_id); const suggestionOptions=suggested.length?suggested.map(x=>`<option value="${bankEsc(x.id)}">${bankEsc(x.description)} · ${bankMoney(x.amount_minor)} · ${bankEsc(x.match_confidence||'forslag')}</option>`).join(''):'<option value="">Ingen forslag</option>'; document.querySelector('#bank-suggest-id').innerHTML=open.length?open.map(x=>`<option value="${bankEsc(x.id)}">${bankEsc(x.transaction_date)} · ${bankEsc(x.description)} · ${bankMoney(x.amount_minor)}</option>`).join(''):'<option value="">Ingen åpne transaksjoner</option>'; document.querySelector('#bank-approve-id').innerHTML=suggestionOptions.replace('Ingen forslag','Ingen forslag til godkjenning'); document.querySelector('#bank-reject-id').innerHTML=suggestionOptions; document.querySelector('#bank-classify-id').innerHTML=classifiable.length?classifiable.map(x=>`<option value="${bankEsc(x.id)}">${bankEsc(x.transaction_date)} · ${bankEsc(x.description)} · ${bankMoney(x.amount_minor)}</option>`).join(''):'<option value="">Ingen åpne linjer å plassere</option>'; document.querySelector('#bank-post-id').innerHTML=approved.length?approved.map(x=>`<option value="${bankEsc(x.id)}">${bankEsc(x.description)} · ${bankMoney(x.amount_minor)}</option>`).join(''):'<option value="">Ingen godkjente matcher</option>'; document.querySelector('#bank-reconciliation-list').innerHTML=bankTransactions.map(x=>`<article><div><strong>${bankEsc(x.transaction_date)} · ${bankEsc(x.description)}</strong><p>${bankEsc(x.account_name||'Konto')} · ${bankEsc(x.external_reference)}${x.match_entity_type?` · match: ${bankEsc(x.match_entity_type)}`:''}${x.classification_note?` · ${bankEsc(x.classification_note)}`:''}</p></div><b>${bankMoney(x.amount_minor)}</b><span class="bank-pill ${bankEsc(x.status)}">${bankEsc(x.status==='posted'?'Bokført':bankStatus[x.status]||x.status)}</span></article>`).join('')||'<p>Ingen transaksjoner importert ennå.</p>'; };
  const splitBankCsvLine=(line,delimiter)=>{const cells=[];let cell='',quoted=false;for(let i=0;i<line.length;i+=1){const ch=line[i];if(ch==='"'){if(quoted&&line[i+1]==='"'){cell+='"';i+=1;}else{quoted=!quoted;}}else if(ch===delimiter&&!quoted){cells.push(cell.trim());cell='';}else{cell+=ch;}}cells.push(cell.trim());return cells;};
  const normalizeBankDate=value=>{const raw=String(value??'').replace(/^\uFEFF/,'').trim();if(/^\d{4}-\d{2}-\d{2}$/.test(raw))return raw;const match=raw.match(/^(\d{1,2})[./-](\d{1,2})[./-](\d{4})$/);if(!match)return '';const [,day,month,year]=match;const iso=`${year}-${month.padStart(2,'0')}-${day.padStart(2,'0')}`;const parsed=new Date(`${iso}T00:00:00Z`);return Number.isNaN(parsed.valueOf())||parsed.toISOString().slice(0,10)!==iso?'':iso;};
  const parseBankAmount=value=>{let raw=String(value??'').trim().replace(/\u00a0/g,'').replace(/\s/g,'');if(!raw)return NaN;let negative=false;if(/^\(.*\)$/.test(raw)){negative=true;raw=raw.slice(1,-1);}if(/-$/.test(raw)){negative=true;raw=raw.slice(0,-1);}raw=raw.replace(/^kr/i,'').replace(/kr$/i,'');if(raw.includes(',')){raw=raw.replace(/\./g,'').replace(',','.');}else if(/^[-+]?\d{1,3}(?:\.\d{3})+$/.test(raw)){raw=raw.replace(/\./g,'');}const parsed=Number(raw);return negative?-parsed:parsed;};
  const parseBankCsv=raw=>{const lines=String(raw??'').split(/\r?\n/).map(x=>x.trim()).filter(Boolean);if(!lines.length)return {transactions:[],errors:['CSV-filen er tom.']};const delimiter=(lines[0].match(/;/g)||[]).length>=(lines[0].match(/,/g)||[]).length?';':',';const rows=lines.map(line=>splitBankCsvLine(line,delimiter));const first=rows[0]||[];const hasHeader=/^(dato|date|bokføringsdato|valutadato)/i.test(String(first[0]??''))||/^(beløp|amount|sum)/i.test(String(first[1]??''));const errors=[];const transactions=[];rows.slice(hasHeader?1:0).forEach((parts,index)=>{const lineNumber=index+(hasHeader?2:1);const transactionDate=normalizeBankDate(parts[0]);const amountValue=parseBankAmount(parts[1]);const description=String(parts[2]??'').trim();const externalReference=String(parts[3]??'').trim();const counterparty=String(parts[4]??'').trim();if(!transactionDate||!Number.isFinite(amountValue)||amountValue===0||!description||!externalReference){errors.push(`Linje ${lineNumber}: dato, beløp, beskrivelse og referanse må fylles ut.`);return;}transactions.push({transactionDate,amountMinor:Math.round(amountValue*100),description,externalReference,counterparty});});return {transactions,errors};};
  const bankImportPreview=document.querySelector('#bank-import-preview');
  const renderBankImportPreview=(parsed,file)=>{if(!bankImportPreview)return;bankImportPreview.hidden=false;const total=parsed.transactions.reduce((sum,row)=>sum+Number(row.amountMinor||0),0);const credits=parsed.transactions.filter(row=>row.amountMinor>0).length;const debits=parsed.transactions.filter(row=>row.amountMinor<0).length;const rows=parsed.transactions.slice(0,5).map(row=>`<tr><td>${bankEsc(row.transactionDate)}</td><td>${bankEsc(row.description)}</td><td>${bankMoney(row.amountMinor)}</td></tr>`).join('');const errorCopy=parsed.errors.length?`<p class="is-invalid"><strong>Kontroller ${parsed.errors.length} linje${parsed.errors.length===1?'':'r'}:</strong> ${bankEsc(parsed.errors.slice(0,2).join(' '))}${parsed.errors.length>2?' Flere linjer har feil.':''}</p>`:'';bankImportPreview.innerHTML=`<strong>Kontroller grunnlaget før import</strong><p>${bankEsc(file?.name||'CSV-fil')} · ${parsed.transactions.length} gyldige linjer · ${credits} inn · ${debits} ut · netto ${bankMoney(total)}</p>${errorCopy}${rows?`<div class="bank-import-table-wrap"><table><thead><tr><th>Dato</th><th>Beskrivelse</th><th>Beløp</th></tr></thead><tbody>${rows}</tbody></table></div>`:''}<small>Ingen linjer skrives før du trykker «Importer kontoutdrag».</small>`;};
  const bankStatementFile=document.querySelector('#bank-statement-file');
  bankStatementFile?.addEventListener('change',async event=>{const file=event.target.files?.[0];if(!file||!file.text){if(bankImportPreview)bankImportPreview.hidden=true;return;}if(file.size>10*1024*1024){renderBankImportPreview({transactions:[],errors:['Filen er større enn 10 MB.']},file);return;}renderBankImportPreview(parseBankCsv(await file.text()),file);});
  document.querySelectorAll('[data-bank-action]').forEach(form => form.addEventListener('submit', async event => { event.preventDefault(); const status=document.querySelector('#bank-reconciliation-status'); const f=new FormData(form); const payload=Object.fromEntries(f); payload.boardId=bankBoardId; payload.action=form.dataset.bankAction; if(payload.action==='import_transactions'){const file=f.get('statementFile'); if(!file||!file.text){status.textContent='Velg en CSV-fil først.';return;} const parsed=parseBankCsv(await file.text()); renderBankImportPreview(parsed,file); if(parsed.errors.length){status.textContent=`CSV-en kan ikke importeres: ${parsed.errors.slice(0,3).join(' ')}${parsed.errors.length>3?' Flere linjer har feil.':''}`;return;} if(!parsed.transactions.length||parsed.transactions.length>500){status.textContent='CSV-en må inneholde mellom 1 og 500 gyldige transaksjoner.';return;} payload.transactions=parsed.transactions; delete payload.statementFile;} status.textContent=payload.action==='classify_transaction'?'Lagrer plassering i kontrollsporet…':payload.action==='post_match'?'Bokfører godkjent banklinje…':payload.action==='reject_match'?'Logger avvisning…':'Validerer og importerer kontoutdrag…'; try { const res=await fetch('/api/bank',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(payload)}); const data=await res.json(); if(!res.ok) throw new Error(data.detail||data.error||'Kunne ikke lagre'); status.textContent=payload.action==='classify_transaction'?`✓ Banklinjen er plassert på valgt konto. Kontroller før du bokfører.`:payload.action==='post_match'?`✓ Balansert bilag ${data.voucherNumber||''} er bokført.`:payload.action==='reject_match'?`✓ Matchforslaget er avvist og forklaringen er logget.`:`✓ ${data.action} er registrert · ${data.count||1} transaksjoner behandlet.`; form.reset(); if(bankImportPreview)bankImportPreview.hidden=true; await loadBank(); } catch(error) { status.textContent=`Kunne ikke lagre: ${error.message}`; } }));
  loadBank().catch(()=>{ document.querySelector('#bank-reconciliation-status').textContent='Bankbildet er midlertidig utilgjengelig.'; });
</script>
<style>
  .bank-reconciliation{margin:28px 0;padding:26px;border:1px solid rgba(16,36,31,.1);border-radius:18px;background:#f3f6ef}.bank-reconciliation-intro h2{margin:8px 0;font:500 1.8rem/1 Georgia,serif}.bank-reconciliation-intro h2 em{font-style:normal;color:var(--accent)}.bank-reconciliation-intro p{max-width:760px;color:var(--muted);font:.8rem/1.5 system-ui,sans-serif}.bank-reconciliation-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:20px}.bank-reconciliation-grid form{display:grid;gap:8px;padding:15px;border-radius:12px;background:#fff;border:1px solid rgba(16,36,31,.08)}.bank-reconciliation-grid h3{font:700 .8rem/1.2 system-ui,sans-serif}.bank-reconciliation-grid label{display:grid;gap:4px;color:var(--muted);font:600 .62rem/1.2 system-ui,sans-serif}.bank-reconciliation-grid input,.bank-reconciliation-grid select{width:100%;min-width:0;padding:8px;border:1px solid rgba(16,36,31,.15);border-radius:7px;background:#fff;font:.72rem system-ui,sans-serif}.bank-reconciliation-grid button{margin-top:auto;border:0;border-radius:7px;padding:9px;background:var(--accent);color:#fff;font:700 .68rem/1 system-ui,sans-serif;cursor:pointer}.bank-reconciliation-grid small,.bank-note{margin:0;color:var(--muted);font:.64rem/1.4 system-ui,sans-serif}.bank-row{display:grid;grid-template-columns:1fr 1fr;gap:6px}.bank-reconciliation-status{min-height:1.2em;margin:13px 0 6px;color:var(--accent);font:700 .7rem/1.3 system-ui,sans-serif}.bank-reconciliation-summary{display:flex;flex-wrap:wrap;gap:14px;margin:12px 0;color:var(--muted);font:600 .67rem/1.3 system-ui,sans-serif}.bank-reconciliation-summary b{color:var(--ink);font-size:.9rem}.bank-reconciliation-list{display:grid;gap:7px}.bank-reconciliation-list article{display:grid;grid-template-columns:1fr auto auto;gap:14px;align-items:center;padding:12px 13px;border-radius:9px;background:#fff;border:1px solid rgba(16,36,31,.08);font-family:system-ui,sans-serif}.bank-reconciliation-list strong{display:block;font-size:.75rem}.bank-reconciliation-list p{margin:4px 0 0;color:var(--muted);font-size:.65rem}.bank-reconciliation-list>b{font-size:.72rem}.bank-pill{font:700 .62rem/1 system-ui,sans-serif;color:var(--accent)}.bank-pill.suggested{color:#a36e21}.bank-pill.rejected{color:#a9442d}.bank-import-preview{margin-top:7px;padding:10px 11px;border:1px solid rgba(16,36,31,.12);border-radius:9px;background:#f7faf6;color:var(--ink);font:.68rem/1.4 system-ui,sans-serif}.bank-import-preview[hidden]{display:none}.bank-import-preview p{margin:4px 0;color:var(--muted)}.bank-import-preview small{display:block;margin-top:6px;color:var(--muted)}.bank-import-preview .is-invalid{color:#a9442d}.bank-import-table-wrap{overflow:auto;margin-top:6px}.bank-import-preview table{width:100%;border-collapse:collapse;font-size:.63rem}.bank-import-preview th,.bank-import-preview td{padding:4px 5px;text-align:left;border-bottom:1px solid rgba(16,36,31,.08)}.bank-import-preview th:last-child,.bank-import-preview td:last-child{text-align:right}@media(max-width:1000px){.bank-reconciliation-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.bank-reconciliation{padding:18px}.bank-reconciliation-grid{grid-template-columns:1fr}.bank-reconciliation-list article{grid-template-columns:1fr auto}.bank-reconciliation-list span{grid-column:1/-1}}
</style>
