<section class="statutory-notes" aria-labelledby="statutory-notes-title">
  <div class="statutory-notes-head"><div><span class="section-kicker">Årsoppgjør</span><h2 id="statutory-notes-title">Forbered noter fra regnskapet.</h2><p>Styr.ing samler et kontrollgrunnlag fra ansatte, lønn og eierdata. Du godkjenner selv før noten brukes i årsoppgjøret.</p></div><span class="hitl-badge">Kildebevis · påkrevd</span></div>
  <div class="statutory-notes-grid">
    <form id="statutory-note-prepare"><h3>Ny eller oppdatert note</h3><label>Note<select name="noteType"><option value="remuneration">Godtgjørelse</option><option value="fte">Årsverk</option><option value="related_party_loans">Lån til nærstående</option></select></label><label>Regnskapsår<input name="period" pattern="\d{4}" inputmode="numeric" maxlength="4" value="2026" required /></label><button type="submit">Beregn kontrollgrunnlag</button><small>Ekstern innsending er ikke aktivert.</small></form>
    <form id="statutory-note-approve"><h3>Godkjenn note</h3><label>Note<select name="noteId" id="statutory-note-id" required><option value="">Henter noter…</option></select></label><button type="submit">Godkjenn for årsoppgjør</button><small>Kontroller tall og kildebevis før godkjenning.</small></form>
  </div>
  <p id="statutory-notes-status" class="action-status" role="status" aria-live="polite"></p>
  <div id="statutory-notes-list" class="statutory-notes-list"><p class="empty">Henter noter…</p></div>
</section>
<style>
  .statutory-notes{margin:28px 0;padding:24px;border:1px solid rgba(16,36,31,.1);border-radius:18px;background:#f7f8f3}.statutory-notes-head{display:flex;justify-content:space-between;gap:20px;align-items:flex-start}.statutory-notes-head h2{margin:9px 0 7px;font:500 1.75rem/1 Georgia,serif}.statutory-notes-head p{max-width:720px;margin:0;color:var(--muted);font:.78rem/1.5 system-ui,sans-serif}.hitl-badge{padding:8px 10px;border-radius:999px;background:#e5efda;color:#27643f;font:700 .62rem/1 system-ui,sans-serif;white-space:nowrap}.statutory-notes-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:20px}.statutory-notes-grid form{display:flex;flex-direction:column;gap:9px;padding:15px;border:1px solid rgba(16,36,31,.1);border-radius:13px;background:#fff}.statutory-notes-grid h3{margin:0 0 3px;font:700 .78rem/1.2 system-ui,sans-serif}.statutory-notes-grid label{display:flex;flex-direction:column;gap:5px;color:var(--muted);font:600 .62rem/1.2 system-ui,sans-serif}.statutory-notes-grid input,.statutory-notes-grid select{width:100%;box-sizing:border-box;padding:8px;border:1px solid rgba(16,36,31,.15);border-radius:8px;background:#fbfdfb;color:var(--night);font:.71rem/1.25 system-ui,sans-serif}.statutory-notes-grid button{margin-top:auto;padding:9px;border:0;border-radius:8px;background:var(--night);color:#fff;cursor:pointer;font:700 .67rem/1 system-ui,sans-serif}.statutory-notes-grid button:hover{background:#28624c}.statutory-notes-grid small{color:var(--muted);font:.65rem/1.4 system-ui,sans-serif}.statutory-notes-list{display:grid;gap:7px;margin-top:18px}.statutory-note-row{display:grid;grid-template-columns:1fr auto auto;gap:12px;align-items:center;padding:13px;border:1px solid rgba(16,36,31,.08);border-radius:10px;background:#fff}.statutory-note-row strong{font:700 .75rem/1.2 system-ui,sans-serif}.statutory-note-row p{margin:4px 0 0;color:var(--muted);font:.67rem/1.4 system-ui,sans-serif}.statutory-note-row span{padding:5px 8px;border-radius:999px;background:#edf4e9;color:#3d7651;font:700 .61rem/1 system-ui,sans-serif}.statutory-note-row button{padding:7px 9px;border:1px solid rgba(16,36,31,.15);border-radius:7px;background:#fff;color:var(--accent);cursor:pointer;font:700 .62rem/1 system-ui,sans-serif}.statutory-note-row button:hover{background:#eef5e9}.action-status{min-height:1.2em;margin:14px 0 0;color:var(--accent);font:700 .72rem/1.35 system-ui,sans-serif}.empty{color:var(--muted);font:.74rem/1.4 system-ui,sans-serif}@media(max-width:700px){.statutory-notes-head{flex-direction:column}.statutory-notes-grid{grid-template-columns:1fr}.statutory-note-row{grid-template-columns:1fr auto}.statutory-note-row button{grid-column:2;grid-row:1}.statutory-note-row span{grid-column:1}}
</style>
<script is:inline>
  const snEsc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const snNoteLabel={remuneration:'Godtgjørelse',fte:'Årsverk',related_party_loans:'Lån til nærstående'};
  let snBoardId=new URLSearchParams(location.search).get('boardId')||''; const snStatus=document.querySelector('#statutory-notes-status'); const snList=document.querySelector('#statutory-notes-list'); const snSelect=document.querySelector('#statutory-note-id');
  const snApi=async(options={})=>{const r=await fetch(options.url||`/api/finance?boardId=${encodeURIComponent(snBoardId)}&view=notes`,options);const d=await r.json();if(!r.ok)throw new Error(d.error||'Kunne ikke hente årsoppgjørsnoter');return d;};
  const snResolve=async()=>{if(snBoardId)return;const a=await(await fetch('/api/auth')).json();snBoardId=a.boards?.[0]?.id||'';if(!snBoardId)throw new Error('Ingen virksomhet valgt');};
  const snLoad=async()=>{await snResolve();const rows=(await snApi()).data||[];const open=rows.filter(x=>['draft','review'].includes(x.status));snSelect.innerHTML=open.length?open.map(x=>`<option value="${snEsc(x.id)}">${snEsc(snNoteLabel[x.note_type]||x.note_type)} · ${snEsc(x.period)} · ${snEsc(x.status)}</option>`).join(''):'<option value="">Ingen åpne noter</option>';snSelect.disabled=!open.length;snSelect.closest('form')?.querySelector('button')?.toggleAttribute('disabled',!open.length);snList.innerHTML=rows.length?rows.map(x=>{let p={};let evidence=[];try{p=JSON.parse(x.payload||'{}')}catch{}try{evidence=JSON.parse(x.evidence_refs||'[]')}catch{}const sourceCount=evidence.filter(e=>e.status!=='not_configured').length;return `<article class="statutory-note-row"><div><strong>${snEsc(snNoteLabel[x.note_type]||x.note_type)} · ${snEsc(x.period)}</strong><p>${sourceCount} kilde${sourceCount===1?'':'r'} kontrollert · ${x.note_type==='fte'?`${snEsc(p.fte||0)} aktive ansatte`:x.note_type==='remuneration'?`${snEsc((Number(p.payrollGrossMinor||0)/100).toLocaleString('nb-NO'))} kr lønnsgrunnlag`:'Nærstående lån må avstemmes manuelt'}</p></div><span>${snEsc(x.status)}</span>${['draft','review'].includes(x.status)?`<button type="button" data-sn-approve="${snEsc(x.id)}">Godkjenn</button>`:'<small>Godkjent</small>'}</article>`}).join(''):'<p class="empty">Ingen noter er klargjort ennå.</p>';};
  document.querySelector('#statutory-note-prepare')?.addEventListener('submit',async e=>{e.preventDefault();const f=new FormData(e.currentTarget);snStatus.textContent='Beregner og lagrer kildebevis…';try{const d=await snApi({url:'/api/finance',method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({boardId:snBoardId,action:'prepare_note',noteType:f.get('noteType'),period:f.get('period')})});snStatus.textContent=`✓ ${snNoteLabel[d.noteType]||'Note'} ${d.period} er sendt til kontroll.`;await snLoad();}catch(err){snStatus.textContent=`Kunne ikke beregne note: ${err.message}`;}});
  const snApprove=async(noteId)=>{snStatus.textContent='Godkjenner note…';try{await snApi({url:'/api/finance',method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({boardId:snBoardId,action:'approve_note',noteId})});snStatus.textContent='✓ Note godkjent for årsoppgjør.';await snLoad();}catch(err){snStatus.textContent=`Kunne ikke godkjenne: ${err.message}`;}};
  document.querySelector('#statutory-note-approve')?.addEventListener('submit',e=>{e.preventDefault();snApprove(new FormData(e.currentTarget).get('noteId'));}); snList?.addEventListener('click',e=>{const b=e.target.closest('[data-sn-approve]');if(b)snApprove(b.dataset.snApprove);}); snLoad().catch(e=>{snStatus.textContent=e.message;snList.innerHTML='<p class="empty">Årsoppgjørsnoter kunne ikke lastes.</p>';});
</script>
