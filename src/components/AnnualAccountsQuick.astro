<section class="annual-accounts-quick" aria-labelledby="annual-accounts-title">
  <div class="annual-head"><div><span class="section-kicker">Årsoppgjør · kontrollert innsending</span><h2 id="annual-accounts-title">Klargjør årsregnskapet.</h2><p>Samle årets kontrollgrunnlag etter at rapporter og noter er gjennomgått. Styr.ing sender ikke til Regnskapsregisteret uten en separat, godkjent adapter.</p></div><span class="annual-boundary">Manuell innsending</span></div>
  <div class="annual-grid">
    <form id="annual-prepare-form"><h3>1. Forbered grunnlag</h3><label>Regnskapsår<input name="period" type="number" min="2000" max="2100" required /></label><button type="submit">Klargjør årsregnskap</button><small>Grunnlaget henter bokførte bilag og årsoppgjørsnoter for året, med kontrollsum.</small></form>
    <form id="annual-approve-form"><h3>2. Godkjenn grunnlag</h3><label>Årsregnskap<select id="annual-submission-id" name="submissionId" required><option value="">Henter grunnlag…</option></select></label><button type="submit">Godkjenn for innsending</button><small>Godkjenning endrer intern status. Ekstern innsending skjer separat.</small></form>
  </div>
  <p id="annual-status" class="annual-status" role="status" aria-live="polite"></p>
  <div id="annual-detail" class="annual-detail" hidden></div>
  <div id="annual-list" class="annual-list"><p>Henter årsoppgjør…</p></div>
</section>
<script is:inline>
  const annualEsc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  let annualBoardId=new URLSearchParams(location.search).get('boardId')||''; const annualStatus=document.querySelector('#annual-status');
  const annualResolve=async()=>{if(annualBoardId)return annualBoardId;try{const a=await(await fetch('/api/auth')).json();annualBoardId=a.boards?.[0]?.id||''}catch{}return annualBoardId||(location.pathname==='/finance/'?'board-1':'')};
  const annualApi=async(payload)=>{const r=await fetch('/api/payroll',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({...payload,boardId:annualBoardId})});const d=await r.json();if(!r.ok)throw Error(d.detail||d.error||'Kunne ikke oppdatere årsoppgjøret');return d};
  const annualMoney=v=>`${(Number(v||0)/100).toLocaleString('nb-NO',{minimumFractionDigits:2,maximumFractionDigits:2})} kr`;
  const annualShowDetail=async(period)=>{const detail=document.querySelector('#annual-detail');if(!detail)return;detail.hidden=false;detail.innerHTML='<p>Henter bokførte tall og noter…</p>';try{const r=await fetch(`/api/payroll?boardId=${encodeURIComponent(annualBoardId)}&view=annual-summary&period=${encodeURIComponent(period)}`),d=await r.json();if(!r.ok)throw Error(d.detail||d.error||'Kunne ikke hente årsgrunnlag');const x=d.data||{};detail.innerHTML=`<div class="annual-detail-head"><strong>Kontrollgrunnlag ${annualEsc(period)}</strong><button type="button" data-annual-close>Lukk</button></div><div class="annual-detail-grid"><span>Driftsinntekter<strong>${annualMoney(x.revenueMinor)}</strong></span><span>Kostnader<strong>${annualMoney(x.expenseMinor)}</strong></span><span>Årsresultat<strong>${annualMoney(x.resultMinor)}</strong></span><span>Eiendeler<strong>${annualMoney(x.assetMinor)}</strong></span><span>Gjeld og egenkapital<strong>${annualMoney(x.liabilitiesAndEquityMinor)}</strong></span><span>Kontroll<strong>${x.balanced&&Number(x.balanceDifferenceMinor)===0?'Balansert':'Avvik'}</strong></span></div><p class="annual-detail-meta">${annualEsc(x.voucherCount||0)} bokførte bilag · ${annualEsc(x.noteCount||0)} noter (${annualEsc(x.openNoteCount||0)} åpne) · debet ${annualMoney(x.debitMinor)} · kredit ${annualMoney(x.creditMinor)}</p>`;detail.querySelector('[data-annual-close]')?.addEventListener('click',()=>{detail.hidden=true;});}catch(err){detail.innerHTML=`<p>Kunne ikke hente kontrollgrunnlaget: ${annualEsc(err.message)}</p>`;}};
  const annualLoad=async()=>{await annualResolve();const r=await fetch(`/api/payroll?boardId=${encodeURIComponent(annualBoardId)}&view=submissions`),d=await r.json();if(!r.ok)throw Error(d.error||'Kunne ikke hente grunnlag');const rows=(d.data||[]).filter(x=>x.submission_type==='annual_accounts');const open=rows.filter(x=>['prepared','review'].includes(x.status));document.querySelector('#annual-submission-id').innerHTML=open.length?open.map(x=>`<option value="${annualEsc(x.id)}">${annualEsc(x.period)} · ${annualEsc(x.status)} · hash ${annualEsc(String(x.payload_hash||'').slice(0,12))}…</option>`).join(''):'<option value="">Ingen åpne årsgrunnlag</option>';document.querySelector('#annual-list').innerHTML=rows.length?rows.map(x=>`<article><div><strong>Årsregnskap ${annualEsc(x.period)}</strong><small>${annualEsc(x.notes||'Internt klargjort')} · kontrollsum ${annualEsc(String(x.payload_hash||'').slice(0,16))}…</small></div><span>${annualEsc(x.status)}</span><button type="button" data-annual-detail="${annualEsc(x.period)}">Se tall</button></article>`).join(''):'<p>Ingen årsoppgjør klargjort ennå.</p>';document.querySelectorAll('[data-annual-detail]').forEach(button=>button.addEventListener('click',()=>annualShowDetail(button.dataset.annualDetail)));};
  document.querySelector('#annual-prepare-form')?.addEventListener('submit',async e=>{e.preventDefault();annualStatus.textContent='Klargjør årsoppgjør fra bokførte tall og noter…';try{const year=String(new FormData(e.currentTarget).get('period')||'');const d=await annualApi({action:'prepare_submission',submissionType:'annual_accounts',period:year});const summary=d.annualSummary;annualStatus.textContent=`✓ Årsregnskap ${year} er klargjort · ${summary?.voucherCount??0} bilag · ${summary?.noteCount??0} noter · ${summary?.balanced?'balansert':'må kontrolleres'} · kontrollsum ${String(d.payloadHash||'').slice(0,12)}…`;await annualLoad()}catch(err){annualStatus.textContent=`Kunne ikke klargjøre: ${err.message}`;}});
  document.querySelector('#annual-approve-form')?.addEventListener('submit',async e=>{e.preventDefault();annualStatus.textContent='Godkjenner årsgrunnlag…';try{const d=await annualApi({action:'approve_submission',submissionId:new FormData(e.currentTarget).get('submissionId')});annualStatus.textContent=`✓ Grunnlaget er godkjent. ${d.externalSubmission==='not_configured'?'Ekstern innsending er ikke konfigurert.':''}`;await annualLoad()}catch(err){annualStatus.textContent=`Kunne ikke godkjenne: ${err.message}`;}});
  annualLoad().catch(err=>{annualStatus.textContent=`Årsoppgjøret kunne ikke lastes: ${err.message}`;});
</script>
<style>
  .annual-accounts-quick{margin:18px 0;padding:24px;border:1px solid rgba(16,36,31,.1);border-radius:18px;background:#f3f7f1}.annual-head{display:flex;justify-content:space-between;gap:20px}.annual-head h2{margin:8px 0;font:500 1.8rem/1 Georgia,serif}.annual-head p{max-width:730px;color:var(--muted);font:.8rem/1.5 system-ui,sans-serif}.annual-boundary{height:max-content;padding:8px 10px;border-radius:999px;background:#fff2c9;color:#765a10;font:700 .62rem/1 system-ui,sans-serif;white-space:nowrap}.annual-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:20px}.annual-grid form{display:grid;gap:8px;padding:15px;border-radius:12px;background:#fff;border:1px solid rgba(16,36,31,.08)}.annual-grid h3{margin:0;font:700 .78rem/1.2 system-ui,sans-serif}.annual-grid label{display:grid;gap:4px;color:var(--muted);font:600 .62rem/1.2 system-ui,sans-serif}.annual-grid input,.annual-grid select{width:100%;box-sizing:border-box;padding:8px;border:1px solid rgba(16,36,31,.15);border-radius:7px;background:#fff;font:.72rem system-ui,sans-serif}.annual-grid button,.annual-detail button{margin-top:auto;padding:9px;border:0;border-radius:8px;background:#28624c;color:#fff;cursor:pointer;font:700 .67rem/1 system-ui,sans-serif}.annual-grid small{color:var(--muted);font:.64rem/1.4 system-ui,sans-serif}.annual-status{min-height:1.2em;margin:13px 0 6px;color:#27643f;font:700 .7rem/1.3 system-ui,sans-serif}.annual-list{display:grid;gap:7px}.annual-list article{display:grid;grid-template-columns:1fr auto auto;gap:12px;align-items:center;padding:12px 13px;border-radius:9px;background:#fff;border:1px solid rgba(16,36,31,.08);font-family:system-ui,sans-serif}.annual-list strong,.annual-list small{display:block}.annual-list small{margin-top:4px;color:var(--muted);font-size:.65rem}.annual-list span{color:#27643f;font:700 .62rem/1 system-ui,sans-serif}.annual-list button{padding:7px 9px;border:1px solid #28624c;border-radius:7px;background:#fff;color:#28624c;cursor:pointer;font:700 .62rem/1 system-ui,sans-serif}.annual-detail{margin:12px 0;padding:14px;border:1px solid rgba(40,98,76,.2);border-radius:10px;background:#fff}.annual-detail-head{display:flex;justify-content:space-between;align-items:center}.annual-detail-head button{margin:0;padding:6px 9px;background:#fff;color:#28624c;border:1px solid #28624c}.annual-detail-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:12px}.annual-detail-grid span{display:grid;gap:3px;padding:8px;border-radius:7px;background:#f3f7f1;color:var(--muted);font:600 .6rem/1.2 system-ui,sans-serif}.annual-detail-grid strong{color:#10241f;font-size:.72rem}.annual-detail-meta{margin:10px 0 0;color:var(--muted);font:.64rem/1.4 system-ui,sans-serif}@media(max-width:600px){.annual-head{display:block}.annual-boundary{display:inline-flex;margin-top:10px}.annual-grid{grid-template-columns:1fr}.annual-list article{display:block}.annual-list span,.annual-list button{display:inline-flex;margin-top:7px}.annual-detail-grid{grid-template-columns:1fr 1fr}}
</style>
