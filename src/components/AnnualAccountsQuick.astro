<section class="annual-accounts-quick" aria-labelledby="annual-accounts-title">
  <div class="annual-head"><div><span class="section-kicker">Årsoppgjør · kontrollert innsending</span><h2 id="annual-accounts-title">Klargjør årsregnskapet.</h2><p>Samle årets kontrollgrunnlag etter at rapporter og noter er gjennomgått. Styr.ing sender ikke til Regnskapsregisteret uten en separat, godkjent adapter.</p></div><span class="annual-boundary">Manuell innsending</span></div>
  <div class="annual-grid">
    <form id="annual-prepare-form"><h3>1. Forbered grunnlag</h3><label>Regnskapsår<input name="period" type="number" min="2000" max="2100" required /></label><button type="submit">Klargjør årsregnskap</button><small>Payloaden får en kontrollsum og kan godkjennes av riktig person.</small></form>
    <form id="annual-approve-form"><h3>2. Godkjenn grunnlag</h3><label>Årsregnskap<select id="annual-submission-id" name="submissionId" required><option value="">Henter grunnlag…</option></select></label><button type="submit">Godkjenn for innsending</button><small>Godkjenning endrer intern status. Ekstern innsending skjer separat.</small></form>
  </div>
  <p id="annual-status" class="annual-status" role="status" aria-live="polite"></p>
  <div id="annual-list" class="annual-list"><p>Henter årsoppgjør…</p></div>
</section>
<script is:inline>
  const annualEsc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  let annualBoardId=new URLSearchParams(location.search).get('boardId')||''; const annualStatus=document.querySelector('#annual-status');
  const annualResolve=async()=>{if(annualBoardId)return annualBoardId;try{const a=await(await fetch('/api/auth')).json();annualBoardId=a.boards?.[0]?.id||''}catch{}return annualBoardId||(location.pathname==='/finance/'?'board-1':'')};
  const annualApi=async(payload)=>{const r=await fetch('/api/payroll',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({...payload,boardId:annualBoardId})});const d=await r.json();if(!r.ok)throw Error(d.detail||d.error||'Kunne ikke oppdatere årsoppgjøret');return d};
  const annualLoad=async()=>{await annualResolve();const r=await fetch(`/api/payroll?boardId=${encodeURIComponent(annualBoardId)}&view=submissions`),d=await r.json();if(!r.ok)throw Error(d.error||'Kunne ikke hente grunnlag');const rows=(d.data||[]).filter(x=>x.submission_type==='annual_accounts');const open=rows.filter(x=>['prepared','review'].includes(x.status));document.querySelector('#annual-submission-id').innerHTML=open.length?open.map(x=>`<option value="${annualEsc(x.id)}">${annualEsc(x.period)} · ${annualEsc(x.status)} · hash ${annualEsc(String(x.payload_hash||'').slice(0,12))}…</option>`).join(''):'<option value="">Ingen åpne årsgrunnlag</option>';document.querySelector('#annual-list').innerHTML=rows.length?rows.map(x=>`<article><div><strong>Årsregnskap ${annualEsc(x.period)}</strong><small>${annualEsc(x.notes||'Internt klargjort')} · kontrollsum ${annualEsc(String(x.payload_hash||'').slice(0,16))}…</small></div><span>${annualEsc(x.status)}</span></article>`).join(''):'<p>Ingen årsoppgjør klargjort ennå.</p>';};
  document.querySelector('#annual-prepare-form')?.addEventListener('submit',async e=>{e.preventDefault();annualStatus.textContent='Klargjør årsoppgjør…';try{const year=String(new FormData(e.currentTarget).get('period')||'');const d=await annualApi({action:'prepare_submission',submissionType:'annual_accounts',period:year});annualStatus.textContent=`✓ Årsregnskap ${year} er klargjort. Kontrollsum ${String(d.payloadHash||'').slice(0,12)}…`;await annualLoad()}catch(err){annualStatus.textContent=`Kunne ikke klargjøre: ${err.message}`;}});
  document.querySelector('#annual-approve-form')?.addEventListener('submit',async e=>{e.preventDefault();annualStatus.textContent='Godkjenner årsgrunnlag…';try{const d=await annualApi({action:'approve_submission',submissionId:new FormData(e.currentTarget).get('submissionId')});annualStatus.textContent=`✓ Grunnlaget er godkjent. ${d.externalSubmission==='not_configured'?'Ekstern innsending er ikke konfigurert.':''}`;await annualLoad()}catch(err){annualStatus.textContent=`Kunne ikke godkjenne: ${err.message}`;}});
  annualLoad().catch(err=>{annualStatus.textContent=`Årsoppgjøret kunne ikke lastes: ${err.message}`;});
</script>
<style>
  .annual-accounts-quick{margin:18px 0;padding:24px;border:1px solid rgba(16,36,31,.1);border-radius:18px;background:#f3f7f1}.annual-head{display:flex;justify-content:space-between;gap:20px}.annual-head h2{margin:8px 0;font:500 1.8rem/1 Georgia,serif}.annual-head p{max-width:730px;color:var(--muted);font:.8rem/1.5 system-ui,sans-serif}.annual-boundary{height:max-content;padding:8px 10px;border-radius:999px;background:#fff2c9;color:#765a10;font:700 .62rem/1 system-ui,sans-serif;white-space:nowrap}.annual-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:20px}.annual-grid form{display:grid;gap:8px;padding:15px;border-radius:12px;background:#fff;border:1px solid rgba(16,36,31,.08)}.annual-grid h3{margin:0;font:700 .78rem/1.2 system-ui,sans-serif}.annual-grid label{display:grid;gap:4px;color:var(--muted);font:600 .62rem/1.2 system-ui,sans-serif}.annual-grid input,.annual-grid select{width:100%;box-sizing:border-box;padding:8px;border:1px solid rgba(16,36,31,.15);border-radius:7px;background:#fff;font:.72rem system-ui,sans-serif}.annual-grid button{margin-top:auto;padding:9px;border:0;border-radius:8px;background:#28624c;color:#fff;cursor:pointer;font:700 .67rem/1 system-ui,sans-serif}.annual-grid small{color:var(--muted);font:.64rem/1.4 system-ui,sans-serif}.annual-status{min-height:1.2em;margin:13px 0 6px;color:#27643f;font:700 .7rem/1.3 system-ui,sans-serif}.annual-list{display:grid;gap:7px}.annual-list article{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center;padding:12px 13px;border-radius:9px;background:#fff;border:1px solid rgba(16,36,31,.08);font-family:system-ui,sans-serif}.annual-list strong,.annual-list small{display:block}.annual-list small{margin-top:4px;color:var(--muted);font-size:.65rem}.annual-list span{color:#27643f;font:700 .62rem/1 system-ui,sans-serif}@media(max-width:600px){.annual-head{display:block}.annual-boundary{display:inline-flex;margin-top:10px}.annual-grid{grid-template-columns:1fr}.annual-list article{display:block}.annual-list span{display:block;margin-top:7px}}
</style>
