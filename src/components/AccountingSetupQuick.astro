<section class="accounting-setup" aria-labelledby="accounting-setup-title">
  <div class="setup-head"><div><span class="section-kicker">Første oppsett</span><h2 id="accounting-setup-title">Gjør virksomheten klar.</h2><p>Velg eller legg til kontoer og opprett regnskapsåret før du begynner å føre. Endringer krever redaktør- eller eierrolle.</p></div><span class="setup-badge">SMB-start</span></div>
  <div class="setup-grid">
    <form id="setup-account-form"><h3>Ny konto i kontoplanen</h3><div class="setup-row"><label>Kontonummer<input name="code" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" required placeholder="4300" /></label><label>Navn<input name="name" maxlength="160" required placeholder="Kontorrekvisita" /></label></div><div class="setup-row"><label>Kontotype<select name="accountType"><option value="expense">Kostnad</option><option value="asset">Eiendel</option><option value="liability">Gjeld</option><option value="equity">Egenkapital</option><option value="revenue">Inntekt</option></select></label><label>MVA-kode<input name="vatCode" maxlength="20" placeholder="3 (valgfritt)" /></label></div><button type="submit">Legg til konto</button></form>
    <form id="setup-period-form"><h3>Nytt regnskapsår eller periode</h3><label>Periode<input name="period" type="month" required /></label><small>Opprett én måned av gangen. Låsing gjøres først etter periodestengingskontroll.</small><button type="submit">Åpne periode</button></form>
  </div>
  <div class="setup-summary"><div><strong id="setup-account-count">—</strong><span>aktive kontoer</span></div><div><strong id="setup-period-count">—</strong><span>åpne perioder</span></div></div>
  <p id="setup-status" class="setup-status" role="status" aria-live="polite"></p>
</section>
<script is:inline>
  let setupBoard = new URLSearchParams(location.search).get('boardId') || '';
  const setupStatus = document.querySelector('#setup-status');
  const setupApi = async (url, options) => { const response = await fetch(url, options); const data = await response.json().catch(() => ({})); if (!response.ok) throw new Error(data.error || 'Kunne ikke lagre oppsettet.'); return data; };
  const setupResolve = async () => { if (setupBoard) return; const auth = await (await fetch('/api/auth')).json(); setupBoard = auth.boards?.[0]?.id || ''; };
  const setupLoad = async () => { await setupResolve(); if (!setupBoard) return; const [accounts, periods] = await Promise.all([setupApi(`/api/finance?boardId=${encodeURIComponent(setupBoard)}&view=accounts`), setupApi(`/api/finance?boardId=${encodeURIComponent(setupBoard)}&view=periods`)]); document.querySelector('#setup-account-count').textContent = (accounts.data || []).filter(x => x.active !== 0).length; document.querySelector('#setup-period-count').textContent = (periods.data || []).filter(x => x.status === 'open').length; };
  document.querySelector('#setup-account-form')?.addEventListener('submit', async (event) => { event.preventDefault(); const form = event.currentTarget; const values = new FormData(form); setupStatus.textContent = 'Lagrer konto…'; try { await setupApi('/api/finance', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ boardId: setupBoard, action: 'create_account', code: values.get('code'), name: values.get('name'), accountType: values.get('accountType'), vatCode: values.get('vatCode') }) }); setupStatus.textContent = '✓ Kontoen er lagt til i kontoplanen.'; form.reset(); await setupLoad(); } catch (error) { setupStatus.textContent = `Kunne ikke legge til konto: ${error.message}`; } });
  document.querySelector('#setup-period-form')?.addEventListener('submit', async (event) => { event.preventDefault(); const form = event.currentTarget; const period = new FormData(form).get('period'); setupStatus.textContent = 'Åpner periode…'; try { await setupApi('/api/finance', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ boardId: setupBoard, action: 'create_period', period }) }); setupStatus.textContent = `✓ Perioden ${period} er åpnet.`; form.reset(); await setupLoad(); } catch (error) { setupStatus.textContent = `Kunne ikke åpne perioden: ${error.message}`; } });
  setupLoad().catch(() => { setupStatus.textContent = 'Oppsettet krever innlogging med virksomhetstilgang.'; });
</script>
<style>
  .accounting-setup{margin:0 0 22px;padding:24px;border:1px solid rgba(16,36,31,.1);border-radius:18px;background:#fffdf3}.setup-head{display:flex;justify-content:space-between;gap:20px}.setup-head h2{margin:8px 0;font:500 1.8rem/1 Georgia,serif}.setup-head p{max-width:700px;color:var(--muted);font:.8rem/1.5 system-ui,sans-serif}.setup-badge{height:max-content;padding:8px 10px;border-radius:999px;background:#e5f2d7;color:#27643f;font:700 .62rem/1 system-ui,sans-serif;white-space:nowrap}.setup-grid{display:grid;grid-template-columns:1.3fr .7fr;gap:10px;margin-top:18px}.setup-grid form{display:grid;gap:8px;padding:15px;border:1px solid rgba(16,36,31,.08);border-radius:12px;background:#fff}.setup-grid h3{margin:0;font:700 .8rem/1.2 system-ui,sans-serif}.setup-row{display:grid;grid-template-columns:1fr 1.5fr;gap:8px}.setup-grid label{display:grid;gap:4px;color:var(--muted);font:600 .62rem/1.2 system-ui,sans-serif}.setup-grid input,.setup-grid select{width:100%;box-sizing:border-box;padding:8px;border:1px solid rgba(16,36,31,.15);border-radius:7px;background:#fff;font:.72rem system-ui,sans-serif}.setup-grid button{margin-top:auto;padding:9px;border:0;border-radius:8px;background:var(--night);color:#fff;cursor:pointer;font:700 .67rem/1 system-ui,sans-serif}.setup-grid small{color:var(--muted);font:.64rem/1.4 system-ui,sans-serif}.setup-summary{display:flex;gap:8px;margin-top:10px}.setup-summary div{padding:10px 13px;border-radius:9px;background:#f3f7f1}.setup-summary strong,.setup-summary span{display:block}.setup-summary strong{font:700 1rem system-ui,sans-serif}.setup-summary span{margin-top:3px;color:var(--muted);font:.62rem system-ui,sans-serif}.setup-status{min-height:1.2em;margin:12px 0 0;color:var(--accent);font:700 .7rem/1.3 system-ui,sans-serif}@media(max-width:680px){.setup-head{display:block}.setup-badge{display:inline-flex;margin-top:8px}.setup-grid{grid-template-columns:1fr}.setup-row{grid-template-columns:1fr}}
</style>
