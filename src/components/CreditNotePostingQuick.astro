<section class="credit-posting" aria-labelledby="credit-posting-title">
  <div><span class="section-kicker">Kreditnota · hovedbok</span><h2 id="credit-posting-title">Bokfør godkjente kreditnotaer</h2><p>Velg kontoene som skal reverseres. Forslaget går gjennom samme kontroll og godkjenning som andre bilag.</p></div>
  <form id="credit-posting-form"><label>Kreditnota<select name="sourceId" id="credit-posting-source" required><option value="">Henter…</option></select></label><label>Fordring<select name="primaryAccountId" id="credit-posting-receivable" required></select></label><label>Inntekt<select name="secondaryAccountId" id="credit-posting-revenue" required></select></label><label>Utgående MVA (valgfritt)<select name="vatAccountId" id="credit-posting-vat"><option value="">Ingen MVA</option></select></label><button type="submit">Lag forslag</button></form>
  <p id="credit-posting-status" role="status" aria-live="polite"></p><div id="credit-posting-list"></div>
</section>
<script is:inline>
  const cpEsc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const cpMoney=v=>`${(Number(v||0)/100).toLocaleString('nb-NO')} kr`;let cpBoard=new URLSearchParams(location.search).get('boardId')||'';let cpAccounts=[];const cpStatus=document.querySelector('#credit-posting-status');const cpApi=async(u,o)=>{const r=await fetch(u,o),d=await r.json();if(!r.ok)throw new Error(d.error||'Kunne ikke hente kreditnotaer');return d;};const cpFill=()=>{const opts=cpAccounts.map(a=>`<option value="${cpEsc(a.id)}">${cpEsc(a.code)} · ${cpEsc(a.name)}</option>`).join('');['#credit-posting-receivable','#credit-posting-revenue'].forEach(s=>document.querySelector(s).innerHTML=opts||'<option value="">Ingen aktive kontoer</option>');document.querySelector('#credit-posting-vat').innerHTML='<option value="">Ingen MVA</option>'+opts;};const cpLoad=async()=>{if(!cpBoard){const a=await(await fetch('/api/auth')).json();cpBoard=a.boards?.[0]?.id||'';}const [n,a,p]=await Promise.all([cpApi(`/api/finance?boardId=${encodeURIComponent(cpBoard)}&view=credit-notes`),cpApi(`/api/finance?boardId=${encodeURIComponent(cpBoard)}&view=accounts`),cpApi(`/api/postings?boardId=${encodeURIComponent(cpBoard)}&view=proposals`)]);const notes=(n.data||[]).filter(x=>x.status==='approved');cpAccounts=(a.data||[]).filter(x=>x.active);cpFill();document.querySelector('#credit-posting-source').innerHTML=notes.length?notes.map(x=>`<option value="${cpEsc(x.id)}">${cpEsc(x.credit_note_number)} · ${cpMoney(x.total_minor)} · ${cpEsc(x.invoice_number)}</option>`).join(''):'<option value="">Ingen godkjente kreditnotaer</option>';const rows=(p.data||[]).filter(x=>x.source_type==='sales_credit_note');document.querySelector('#credit-posting-list').innerHTML=rows.length?rows.map(x=>`<article><strong>${cpEsc(x.source_reference)}</strong><span>${cpEsc(x.status)} · ${cpMoney(x.amount_minor)}</span><div>${x.status==='review'?`<button data-cp-action="approve_credit_note_proposal" data-id="${cpEsc(x.id)}">Godkjenn forslag</button>`:''}${x.status==='approved'?`<button data-cp-action="post_credit_note_proposal" data-id="${cpEsc(x.id)}">Bokfør bilag</button>`:''}${x.status==='posted'?'<small>Bilag bokført</small>':''}</div></article>`).join(''):'<p>Ingen kreditnotaforslag.</p>';};document.querySelector('#credit-posting-form')?.addEventListener('submit',async e=>{e.preventDefault();const f=new FormData(e.currentTarget);try{const d=await cpApi('/api/postings',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({boardId:cpBoard,action:'prepare_credit_note',sourceId:f.get('sourceId'),primaryAccountId:f.get('primaryAccountId'),secondaryAccountId:f.get('secondaryAccountId'),vatAccountId:f.get('vatAccountId')})});cpStatus.textContent=`✓ Forslag ${d.proposalId} er opprettet.`;await cpLoad();}catch(err){cpStatus.textContent=`Kunne ikke opprette forslag: ${err.message}`;}});document.querySelector('#credit-posting-list')?.addEventListener('click',async e=>{const b=e.target.closest('[data-cp-action]');if(!b)return;try{const d=await cpApi('/api/postings',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({boardId:cpBoard,action:b.dataset.cpAction,proposalId:b.dataset.id})});cpStatus.textContent=d.status==='posted'?`✓ Bilag ${d.voucherNumber} er bokført.`:'✓ Forslag godkjent.';await cpLoad();}catch(err){cpStatus.textContent=`Kunne ikke oppdatere: ${err.message}`;}}});cpLoad().catch(e=>cpStatus.textContent=e.message);
</script>
<style>.credit-posting{margin:18px 0;padding:24px;border:1px solid rgba(16,36,31,.1);border-radius:18px;background:#fff8e5}.credit-posting h2{margin:8px 0;font:500 1.7rem Georgia,serif}.credit-posting p{color:var(--muted);font:.8rem/1.5 system-ui,sans-serif}.credit-posting form{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr auto;gap:8px;align-items:end}.credit-posting label{display:grid;gap:5px;color:var(--muted);font:600 .63rem system-ui,sans-serif}.credit-posting select{padding:8px;border:1px solid rgba(16,36,31,.15);border-radius:7px;background:#fff}.credit-posting button{padding:9px;border:0;border-radius:7px;background:#28624c;color:#fff;font-weight:700;cursor:pointer}.credit-posting article{display:flex;justify-content:space-between;gap:10px;align-items:center;padding:10px;margin-top:7px;background:#fff;border:1px solid rgba(16,36,31,.1);border-radius:8px;font:.7rem system-ui,sans-serif}.credit-posting article button{margin-left:6px;font-size:.65rem}.credit-posting article span{color:var(--muted)}@media(max-width:850px){.credit-posting form{grid-template-columns:1fr 1fr}.credit-posting form button{grid-column:1/-1}}@media(max-width:500px){.credit-posting form{grid-template-columns:1fr}.credit-posting article{display:grid}}</style>
