<section class="manual-voucher" aria-labelledby="manual-voucher-title">
  <div class="manual-voucher-head">
    <div><span class="section-kicker">Bilag · daglig bokføring</span><h2 id="manual-voucher-title">Registrer et bilag</h2><p>Før kostnader, inntekter og andre posteringer med så mange linjer du trenger. Styr.ing sjekker at bilaget balanserer før det bokføres.</p></div>
    <span class="manual-voucher-boundary">Bokføres med én gang · korrigeres med reversering</span>
  </div>
  <form id="manual-voucher-form">
    <div class="manual-voucher-meta"><label>Dato<input name="voucherDate" type="date" required /></label><label>Beskrivelse<input name="description" maxlength="200" required placeholder="For eksempel kontorrekvisita" /></label><label>Ekstern referanse<input name="externalReference" maxlength="120" placeholder="Kvittering eller fakturanummer" /></label></div>
    <div class="manual-voucher-lines-head"><h3>Posteringer</h3><button id="manual-voucher-add" type="button" class="secondary-button">+ Legg til linje</button></div>
    <div id="manual-voucher-lines" class="manual-voucher-lines"></div>
    <div class="manual-voucher-total" aria-live="polite"><span>Kontroll</span><strong id="manual-voucher-balance">Balansert · 0,00 kr</strong><small id="manual-voucher-total-note">Debet og kredit må være like.</small></div>
    <div class="manual-voucher-actions"><button type="submit" id="manual-voucher-submit">Bokfør bilag</button><span id="manual-voucher-status" role="status" aria-live="polite"></span></div>
  </form>
  <div class="voucher-reversal" aria-labelledby="voucher-reversal-title">
    <div><span class="section-kicker">Korrigering · sporbar reversering</span><h3 id="voucher-reversal-title">Rett et bokført bilag</h3><p>Et bokført bilag slettes aldri. Velg bilaget, så oppretter Styr.ing et motsatt, balansert bilag med tydelig kobling til originalen.</p></div>
    <form id="voucher-reversal-form"><label>Bilag<select name="voucherId" id="voucher-reversal-id" required><option value="">Henter bokførte bilag…</option></select></label><label>Reverseringsdato<input name="reversalDate" type="date" required /></label><label>Forklaring (valgfritt)<input name="description" maxlength="200" placeholder="Korrigering av feilføring" /></label><button type="submit" id="voucher-reversal-submit">Opprett reversering</button></form>
    <p id="voucher-reversal-status" role="status" aria-live="polite"></p>
  </div>
</section>
<template id="manual-voucher-line-template">
  <div class="manual-voucher-line">
    <label class="line-account">Konto<select data-field="accountId" required><option value="">Velg konto …</option></select></label>
    <label class="line-description">Tekst<input data-field="description" maxlength="200" required placeholder="Hva gjelder linjen?" /></label>
    <label>Debet (kr)<input data-field="debit" type="number" min="0" step="0.01" inputmode="decimal" value="0" /></label>
    <label>Kredit (kr)<input data-field="credit" type="number" min="0" step="0.01" inputmode="decimal" value="0" /></label>
    <label>MVA<select data-field="vatCode"><option value="">Ingen</option><option value="1">Inngående 25 %</option><option value="1_15">Inngående 15 %</option><option value="1_12">Inngående 12 %</option><option value="3">Utgående 25 %</option><option value="3_15">Utgående 15 %</option><option value="3_12">Utgående 12 %</option><option value="0">Unntatt / 0 %</option></select></label>
    <button type="button" data-remove class="remove-line" aria-label="Fjern linje">×</button>
  </div>
</template>
<script is:inline>
  const mvEsc = (value) => String(value ?? '').replace(/[&<>'"]/g, (char) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', "'":'&#39;', '"':'&quot;' }[char]));
  const mvMoney = (minor) => `${(Number(minor || 0) / 100).toLocaleString('nb-NO', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} kr`;
  const mvForm = document.querySelector('#manual-voucher-form'); const mvLines = document.querySelector('#manual-voucher-lines'); const mvTemplate = document.querySelector('#manual-voucher-line-template'); const mvStatus = document.querySelector('#manual-voucher-status'); const mvSubmit = document.querySelector('#manual-voucher-submit'); const mvReversalForm = document.querySelector('#voucher-reversal-form'); const mvReversalId = document.querySelector('#voucher-reversal-id'); const mvReversalStatus = document.querySelector('#voucher-reversal-status'); const mvReversalSubmit = document.querySelector('#voucher-reversal-submit');
  let mvBoardId = new URLSearchParams(location.search).get('boardId') || ''; let mvAccounts = [];
  const mvMinor = (value) => { const number = Number(String(value || '').replace(',', '.')); return Number.isFinite(number) && number >= 0 ? Math.round(number * 100) : 0; };
  const mvRefresh = () => { let debit = 0; let credit = 0; mvLines.querySelectorAll('.manual-voucher-line').forEach((line) => { debit += mvMinor(line.querySelector('[data-field="debit"]')?.value); credit += mvMinor(line.querySelector('[data-field="credit"]')?.value); }); const difference = debit - credit; const balance = document.querySelector('#manual-voucher-balance'); const note = document.querySelector('#manual-voucher-total-note'); balance.textContent = difference === 0 ? `Balansert · ${mvMoney(debit)}` : `Avvik · ${mvMoney(Math.abs(difference))}`; balance.classList.toggle('is-invalid', difference !== 0); note.textContent = difference === 0 ? `Debet ${mvMoney(debit)} · Kredit ${mvMoney(credit)}` : `Debet ${mvMoney(debit)} · Kredit ${mvMoney(credit)} · juster før bokføring`; return { debit, credit, difference }; };
  const mvAddLine = (defaults = {}) => { const fragment = mvTemplate.content.cloneNode(true); const line = fragment.querySelector('.manual-voucher-line'); const select = line.querySelector('[data-field="accountId"]'); select.innerHTML = '<option value="">Velg konto …</option>' + mvAccounts.map((account) => `<option value="${mvEsc(account.id)}">${mvEsc(account.code)} · ${mvEsc(account.name)}</option>`).join(''); select.value = defaults.accountId || ''; line.querySelector('[data-field="description"]').value = defaults.description || ''; line.querySelector('[data-field="debit"]').value = defaults.debit || '0'; line.querySelector('[data-field="credit"]').value = defaults.credit || '0'; line.querySelector('[data-field="vatCode"]').value = defaults.vatCode || ''; line.querySelectorAll('input,select').forEach((input) => input.addEventListener('input', mvRefresh)); line.querySelector('[data-remove]').addEventListener('click', () => { if (mvLines.children.length > 2) { line.remove(); mvRefresh(); } }); mvLines.appendChild(fragment); mvRefresh(); };
  const mvLoad = async () => { if (!mvBoardId) { const auth = await (await fetch('/api/auth')).json(); mvBoardId = auth.boards?.[0]?.id || ''; } if (!mvBoardId) throw new Error('Ingen virksomhet valgt'); const [accountResponse, voucherResponse] = await Promise.all([fetch(`/api/finance?boardId=${encodeURIComponent(mvBoardId)}&view=accounts`), fetch(`/api/finance?boardId=${encodeURIComponent(mvBoardId)}&view=vouchers`)]); const payload = await accountResponse.json(); const voucherPayload = await voucherResponse.json(); if (!accountResponse.ok) throw new Error(payload.error || 'Kontoplanen kunne ikke lastes'); if (!voucherResponse.ok) throw new Error(voucherPayload.error || 'Bilagene kunne ikke lastes'); mvAccounts = (payload.data || []).filter((account) => account.active !== 0); const posted = (voucherPayload.data || []).filter((voucher) => voucher.status === 'posted'); mvReversalId.innerHTML = posted.length ? posted.map((voucher) => `<option value="${mvEsc(voucher.id)}">Bilag ${mvEsc(voucher.voucher_number)} · ${mvEsc(voucher.voucher_date)} · ${mvEsc(voucher.description)}</option>`).join('') : '<option value="">Ingen bokførte bilag</option>'; const today = new Date().toISOString().slice(0, 10); mvForm.querySelector('[name="voucherDate"]').value = today; mvReversalForm.querySelector('[name="reversalDate"]').value = today; mvLines.innerHTML = ''; mvAddLine(); mvAddLine(); };
  document.querySelector('#manual-voucher-add')?.addEventListener('click', () => mvAddLine());
  mvForm?.addEventListener('submit', async (event) => { event.preventDefault(); const totals = mvRefresh(); if (totals.difference !== 0) { mvStatus.textContent = 'Bilaget må balansere før det kan bokføres.'; return; } const lines = [...mvLines.querySelectorAll('.manual-voucher-line')].map((line) => ({ accountId: line.querySelector('[data-field="accountId"]').value, description: line.querySelector('[data-field="description"]').value.trim(), debitMinor: mvMinor(line.querySelector('[data-field="debit"]').value), creditMinor: mvMinor(line.querySelector('[data-field="credit"]').value), vatCode: line.querySelector('[data-field="vatCode"]').value || null })); if (lines.some((line) => !line.accountId || !line.description || (line.debitMinor === 0 && line.creditMinor === 0) || (line.debitMinor > 0 && line.creditMinor > 0))) { mvStatus.textContent = 'Fyll ut konto, tekst og beløp på hver linje.'; return; } const data = Object.fromEntries(new FormData(mvForm)); mvSubmit.disabled = true; mvStatus.textContent = 'Bokfører og skriver kontrollspor…'; try { const response = await fetch('/api/finance', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ boardId: mvBoardId, action: 'create_voucher', voucher: { voucherDate: data.voucherDate, period: String(data.voucherDate).slice(0, 7), description: data.description, externalReference: data.externalReference || null, source: 'manual', lines } }) }); const payload = await response.json(); if (!response.ok) throw new Error(payload.error || 'Bilaget kunne ikke bokføres'); mvStatus.textContent = `✓ Bilag ${payload.voucherNumber} er bokført i ${payload.period}.`; mvLines.innerHTML = ''; mvAddLine(); mvAddLine(); mvForm.querySelector('[name="description"]').value = ''; mvForm.querySelector('[name="externalReference"]').value = ''; } catch (error) { mvStatus.textContent = error instanceof Error ? error.message : 'Bilaget kunne ikke bokføres.'; } finally { mvSubmit.disabled = false; } });
  mvReversalForm?.addEventListener('submit', async (event) => { event.preventDefault(); const data = Object.fromEntries(new FormData(mvReversalForm)); mvReversalSubmit.disabled = true; mvReversalStatus.textContent = 'Oppretter motsatt bilag og skriver kontrollspor…'; try { const response = await fetch('/api/finance', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ boardId: mvBoardId, action: 'reverse_voucher', voucherId: data.voucherId, reversalDate: data.reversalDate, description: data.description || undefined }) }); const payload = await response.json(); if (!response.ok) throw new Error(payload.error || 'Reverseringen kunne ikke opprettes'); mvReversalStatus.textContent = `✓ Reversering bokført som bilag ${payload.voucherNumber}${payload.idempotent ? ' · samme korrigering var allerede registrert' : ''}.`; await mvLoad(); } catch (error) { mvReversalStatus.textContent = error instanceof Error ? error.message : 'Reverseringen kunne ikke opprettes.'; } finally { mvReversalSubmit.disabled = false; } });
  mvLoad().catch((error) => { mvStatus.textContent = error instanceof Error ? error.message : 'Bilagsflyten kunne ikke lastes.'; });
</script>
<style>
  .manual-voucher{margin:18px 0;padding:24px;border:1px solid rgba(16,36,31,.1);border-radius:18px;background:#fff}.manual-voucher-head{display:flex;justify-content:space-between;gap:20px}.manual-voucher h2{margin:8px 0;font:500 1.8rem/1 Georgia,serif}.manual-voucher p{max-width:720px;color:var(--muted);font:.8rem/1.5 system-ui,sans-serif}.manual-voucher-boundary{height:max-content;padding:8px 10px;border-radius:999px;background:#fff2cf;color:#7c621b;font:700 .62rem/1 system-ui,sans-serif;white-space:nowrap}.manual-voucher-meta{display:grid;grid-template-columns:150px 1fr 220px;gap:9px;margin:20px 0}.manual-voucher label{display:grid;gap:5px;color:var(--muted);font:600 .63rem/1.2 system-ui,sans-serif}.manual-voucher input,.manual-voucher select{width:100%;padding:9px;border:1px solid rgba(16,36,31,.15);border-radius:8px;background:#fff;color:var(--ink);font:.72rem system-ui,sans-serif}.manual-voucher-lines-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:10px 0}.manual-voucher h3{font:700 .82rem/1 system-ui,sans-serif}.secondary-button,.manual-voucher-actions button{border:0;border-radius:8px;padding:9px 12px;background:#10241f;color:#fff;cursor:pointer;font:700 .67rem/1 system-ui,sans-serif}.secondary-button{background:#e8f1df;color:#28624c}.manual-voucher-lines{display:grid;gap:8px}.manual-voucher-line{display:grid;grid-template-columns:1.1fr 1.5fr .75fr .75fr .9fr 30px;gap:7px;align-items:end;padding:10px;border-radius:10px;background:#f5f8f5}.manual-voucher-line label{font-size:.58rem}.remove-line{width:28px;height:28px;border:0;border-radius:50%;background:#fff;color:#9b6218;cursor:pointer;font:700 1rem/1 system-ui,sans-serif}.manual-voucher-total{display:flex;align-items:center;gap:14px;margin-top:12px;padding:12px;border-top:1px solid rgba(16,36,31,.1);font:600 .7rem system-ui,sans-serif}.manual-voucher-total span{color:var(--muted)}.manual-voucher-total strong{color:#27643f}.manual-voucher-total strong.is-invalid{color:#a85f1e}.manual-voucher-total small{margin-left:auto;color:var(--muted)}.manual-voucher-actions{display:flex;align-items:center;gap:14px;margin-top:12px}.manual-voucher-actions button{background:#28624c}.manual-voucher-actions button:disabled{opacity:.6;cursor:wait}.manual-voucher-actions span{color:#27643f;font:700 .68rem/1.35 system-ui,sans-serif}@media(max-width:900px){.manual-voucher-meta{grid-template-columns:1fr 1fr}.manual-voucher-meta label:nth-child(2){grid-column:1/-1}.manual-voucher-line{grid-template-columns:1fr 1fr 1fr}.line-account,.line-description{grid-column:span 2}.remove-line{justify-self:end}.manual-voucher-total{align-items:flex-start;flex-wrap:wrap}.manual-voucher-total small{width:100%;margin-left:0}}@media(max-width:560px){.manual-voucher{padding:17px}.manual-voucher-head{align-items:flex-start;flex-direction:column}.manual-voucher-meta{grid-template-columns:1fr}.manual-voucher-meta label:nth-child(2){grid-column:auto}.manual-voucher-line{grid-template-columns:1fr 1fr}.line-account,.line-description{grid-column:1/-1}.manual-voucher-line label:nth-of-type(3),.manual-voucher-line label:nth-of-type(4){grid-column:span 1}}
  .voucher-reversal{display:grid;grid-template-columns:1fr 1.5fr;gap:16px;margin-top:24px;padding:18px;border:1px solid rgba(122,98,27,.2);border-radius:13px;background:#fffaf0}.voucher-reversal h3{margin:7px 0;font:500 1.25rem/1 Georgia,serif}.voucher-reversal p{margin:0;color:var(--muted);font:.72rem/1.45 system-ui,sans-serif}.voucher-reversal form{display:grid;grid-template-columns:1fr 150px;gap:9px;align-items:end}.voucher-reversal form label:first-child{grid-column:1/-1}.voucher-reversal button{padding:10px;border:0;border-radius:8px;background:#7b621e;color:#fff;cursor:pointer;font:700 .67rem/1 system-ui,sans-serif}.voucher-reversal button:disabled{opacity:.6;cursor:wait}.voucher-reversal-status{grid-column:1/-1;color:#27643f!important;font-weight:700!important}@media(max-width:760px){.voucher-reversal{display:block}.voucher-reversal form{margin-top:14px;grid-template-columns:1fr}.voucher-reversal form label:first-child{grid-column:auto}.voucher-reversal-status{margin-top:10px!important}}
</style>
