<section class="card-ledger-quick" aria-labelledby="card-ledger-title">
  <div class="card-ledger-head"><div><span class="section-kicker">Firmakort · hovedbok</span><h2 id="card-ledger-title">Bokfør godkjente kortkjøp</h2><p>Velg kortkonto og kostnadskonto etter at kvitteringen er kontrollert. Styr.ing oppretter et balansert bilag på kjøpsdatoen.</p></div><span>HITL · påkrevd</span></div>
  <form id="card-ledger-form"><div class="card-ledger-grid"><label>Godkjent kjøp<select name="transactionId" id="card-ledger-transaction" required><option value="">Henter…</option></select></label><label>Kortkonto<select name="cardLedgerAccountId" id="card-ledger-account" required><option value="">Henter kontoplan…</option></select></label><label>Kostnadskonto<select name="counterAccountId" id="card-counter-account" required><option value="">Henter kontoplan…</option></select></label><label>MVA-sats<select name="vatRate" id="card-vat-rate"><option value="0">Ingen MVA / 0 %</option><option value="25">Inngående MVA 25 %</option><option value="15">Inngående MVA 15 %</option><option value="12">Inngående MVA 12 %</option></select></label><label id="card-vat-account-wrap">MVA-konto<select name="vatAccountId" id="card-vat-account"><option value="">Henter kontoplan…</option></select></label></div><p class="card-ledger-help">Beløpet på kortet er brutto. Velg sats fra kvitteringen; Styr.ing beregner nettobeløp og inngående MVA før bokføring.</p><button type="submit">Bokfør i hovedbok</button></form><p id="card-ledger-status" class="card-ledger-status" role="status" aria-live="polite"></p>
</section>
<script is:inline>
  const clEsc=v=>String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c])); const clMoney=v=>(Number(v||0)/100).toLocaleString('nb-NO',{style:'currency',currency:'NOK'});let clBoard=''; const clGet=async url=>{const r=await fetch(url),d=await r.json();if(!r.ok)throw new Error(d.error||'Kunne ikke laste kortkjøp');return d;};
  const clLoad=async()=>{if(!clBoard){const a=await clGet('/api/auth');clBoard=a.boards?.[0]?.id||'';}if(!clBoard)throw new Error('Ingen virksomhet valgt');const [t,a]=await Promise.all([clGet(`/api/cards?boardId=${encodeURIComponent(clBoard)}&view=transactions`),clGet(`/api/finance?boardId=${encodeURIComponent(clBoard)}&view=accounts`)]);const approved=(t.data||[]).filter(x=>x.status==='approved'&&!x.posted_voucher_id),opts=(a.data||[]).filter(x=>x.active!==0).map(x=>`<option value="${clEsc(x.id)}">${clEsc(x.code)} · ${clEsc(x.name)}</option>`).join('');document.querySelector('#card-ledger-transaction').innerHTML=approved.length?approved.map(x=>`<option value="${clEsc(x.id)}">${clEsc(x.transaction_date)} · ${clEsc(x.merchant)} · ${clMoney(x.amount_minor)}</option>`).join(''):'<option value="">Ingen godkjente kjøp</option>';document.querySelector('#card-ledger-account').innerHTML='<option value="">Velg konto…</option>'+opts;document.querySelector('#card-counter-account').innerHTML='<option value="">Velg konto…</option>'+opts;document.querySelector('#card-vat-account').innerHTML='<option value="">Velg konto…</option>'+opts;const vat=document.querySelector('#card-vat-rate');const syncVat=()=>{document.querySelector('#card-vat-account-wrap').hidden=vat.value==='0';};vat?.addEventListener('change',syncVat);syncVat();};document.querySelector('#card-ledger-form')?.addEventListener('submit',async e=>{e.preventDefault();const b=e.currentTarget.querySelector('button');const s=document.querySelector('#card-ledger-status');const f=new FormData(e.currentTarget);b.disabled=true;s.textContent='Bokfører og skriver kontrollspor…';try{const r=await fetch('/api/cards',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({boardId:clBoard,action:'post_transaction',transactionId:f.get('transactionId'),cardLedgerAccountId:f.get('cardLedgerAccountId'),counterAccountId:f.get('counterAccountId'),vatRate:Number(f.get('vatRate')||0),vatAccountId:f.get('vatAccountId')})}),d=await r.json();if(!r.ok)throw new Error(d.error||'Kortkjøpet kunne ikke bokføres');s.textContent=`✓ Kortkjøpet er bokført som bilag ${d.voucherNumber}. Nettobeløp ${clMoney(d.netMinor)} · MVA ${clMoney(d.vatMinor)}.`;await clLoad();}catch(err){s.textContent=err.message;}finally{b.disabled=false;}});clLoad().catch(e=>document.querySelector('#card-ledger-status').textContent=e.message);
</script>
<style>
  .card-ledger-quick{margin:18px 0;padding:24px;border:1px solid rgba(16,36,31,.1);border-radius:18px;background:#f4f8ff}.card-ledger-head{display:flex;justify-content:space-between;gap:20px}.card-ledger-head h2{margin:8px 0;font:500 1.8rem/1 Georgia,serif}.card-ledger-head p{max-width:720px;color:var(--muted);font:.8rem/1.5 system-ui,sans-serif}.card-ledger-head>span{height:max-content;padding:8px 10px;border-radius:999px;background:#dceaff;color:#36557f;font:700 .62rem/1 system-ui,sans-serif;white-space:nowrap}.card-ledger-grid{display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:9px;margin:18px 0 12px}.card-ledger-grid label{display:grid;gap:5px;color:var(--muted);font:600 .62rem/1.2 system-ui,sans-serif}.card-ledger-grid select{width:100%;padding:9px;border:1px solid rgba(16,36,31,.15);border-radius:8px;background:#fff;font:.72rem system-ui,sans-serif}.card-ledger-quick button{padding:10px 13px;border:0;border-radius:8px;background:#36557f;color:#fff;cursor:pointer;font:700 .67rem/1 system-ui,sans-serif}.card-ledger-quick button:disabled{opacity:.55}.card-ledger-status{min-height:1.2em;color:#36557f;font:700 .68rem/1.4 system-ui,sans-serif}@media(max-width:760px){.card-ledger-head{flex-direction:column}.card-ledger-grid{grid-template-columns:1fr}} 
</style>
