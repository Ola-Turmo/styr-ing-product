<section class="supplier-quick" aria-labelledby="supplier-quick-title">
  <div class="supplier-head"><div><span class="section-kicker">Leverandørfaktura · innkjøp</span><h2 id="supplier-quick-title">Fra kjøp til godkjent kostnad.</h2><p>Registrer ordre, bekreft mottak og kontroller fakturaen før den går videre til attestasjon og anvisning. Ingen betaling eller bokføring skjer automatisk.</p></div><span class="supplier-boundary">3-veis match · 4 øyne</span></div>
  <form data-supplier-action="create_supplier" class="supplier-register"><div><h3>Leverandørregister</h3><p>Lagre leverandører én gang, så kan de brukes i ordre og fakturaer senere.</p></div><label>Navn<input name="name" required maxlength="200" placeholder="Leverandør AS" /></label><label>Organisasjonsnummer<input name="orgNumber" inputmode="numeric" maxlength="11" placeholder="987 654 321" /></label><label>Adresse<input name="addressLine1" maxlength="200" placeholder="Storgata 1" /></label><label>Postnummer<input name="postalCode" inputmode="numeric" maxlength="4" placeholder="0155" /></label><label>Poststed<input name="city" maxlength="100" placeholder="Oslo" /></label><label>E-post<input name="email" type="email" maxlength="200" placeholder="faktura@leverandor.no" /></label><label>Betalingsfrist (dager)<input name="paymentTermsDays" type="number" min="0" max="365" value="14" required /></label><label>Standard kostnadskonto<select name="defaultExpenseAccountId" id="supplier-default-account"><option value="">Ingen standardkonto</option></select></label><button type="submit">Lagre leverandør</button></form>
  <section class="supplier-directory" aria-labelledby="supplier-directory-title"><div class="supplier-directory-head"><div><span class="section-kicker">Leverandørregister</span><h3 id="supplier-directory-title">Hold leverandørene oppdaterte.</h3><p>Endre kontaktinformasjon, betalingsfrist eller standardkonto uten å opprette leverandøren på nytt. Inaktive leverandører kan ikke velges i nye ordre.</p></div><span id="supplier-directory-status" class="supplier-directory-status" role="status" aria-live="polite"></span></div><div id="supplier-directory-list" class="supplier-directory-list"><p>Henter leverandører…</p></div><form id="supplier-edit-form" class="supplier-edit-form" hidden><input type="hidden" name="supplierId" /><h4>Rediger leverandør</h4><div class="supplier-edit-grid"><label>Navn<input name="name" maxlength="200" required /></label><label>Organisasjonsnummer<input name="orgNumber" inputmode="numeric" maxlength="11" /></label><label>Adresse<input name="addressLine1" maxlength="200" /></label><label>Postnummer<input name="postalCode" inputmode="numeric" maxlength="4" /></label><label>Poststed<input name="city" maxlength="100" /></label><label>E-post<input name="email" type="email" maxlength="200" /></label><label>Betalingsfrist (dager)<input name="paymentTermsDays" type="number" min="0" max="365" value="14" required /></label><label>Standard kostnadskonto<select name="defaultExpenseAccountId" id="supplier-edit-account"><option value="">Ingen standardkonto</option></select></label></div><label class="supplier-edit-active"><input name="active" type="checkbox" checked /> Aktiv leverandør</label><div class="supplier-edit-actions"><button type="submit">Lagre endringer</button><button type="button" id="supplier-edit-cancel">Avbryt</button></div></form></section>
  <form data-supplier-action="update_approval_policy" class="supplier-policy"><div><h3>Godkjenningsregler</h3><p>Bestem når fakturaen må kontrolleres av to ulike personer.</p></div><label>Fire øyne fra (kr)<input name="requireFourEyesFrom" id="supplier-four-eyes-limit" type="number" min="0" step="1" value="0" required /></label><label class="supplier-policy-check"><input name="ownerOverrideAllowed" id="supplier-owner-override" type="checkbox" value="1" checked /> Tillat eier å overstyre alene</label><button type="submit">Lagre regler</button></form>
  <div class="supplier-grid">
    <form data-supplier-action="create_order"><h3>Ny innkjøpsordre</h3><label>Ordrenummer<input name="orderNumber" required placeholder="PO-2026-014" /></label><label>Registrert leverandør<select name="supplierPartyId" id="supplier-party-order"><option value="">Velg eller skriv under</option></select></label><label>Leverandør (valgfritt)<input name="supplierName" placeholder="Brukes hvis leverandør ikke er registrert" /></label><label>Beløp i kroner<input name="total" type="number" min="0.01" step="0.01" required placeholder="12500" /></label><button type="submit">Opprett ordre</button></form>
    <form data-supplier-action="approve_order"><h3>Godkjenn innkjøpsordre</h3><label>Ordre til godkjenning<select name="orderId" id="supplier-approve-order" required><option value="">Henter ordrer…</option></select></label><p>Godkjenning låser kontrollpunktet før varemottak. Bestillingen sendes ikke eksternt.</p><button type="submit">Godkjenn ordre</button></form>
    <form data-supplier-action="create_receipt"><h3>Bekreft varemottak</h3><label>Ordre<select name="purchaseOrderId" id="supplier-receipt-order" required><option value="">Henter ordrer…</option></select></label><label>Mottaksdato<input name="receivedDate" type="date" required /></label><label>Status<select name="status"><option value="confirmed">Bekreftet</option><option value="disputed">Avvik</option></select></label><button type="submit">Lagre mottak</button></form>
    <form data-supplier-action="create_invoice"><h3>Registrer leverandørfaktura</h3><label>Fakturanummer<input name="invoiceNumber" required placeholder="INV-8842" /></label><label>Registrert leverandør<select name="supplierPartyId" id="supplier-party-invoice"><option value="">Velg eller skriv under</option></select></label><label>Leverandør (valgfritt)<input name="supplierName" placeholder="Brukes hvis leverandør ikke er registrert" /></label><div class="supplier-lines" data-supplier-lines><div class="supplier-line"><input name="lineDescription" placeholder="Kontorrekvisita" required /><input name="lineQuantity" type="number" min="0.001" step="0.001" value="1" aria-label="Antall" required /><input name="lineUnitPrice" type="number" min="0" step="0.01" placeholder="1000" aria-label="Pris i kroner" required /><select name="lineVatRate" aria-label="MVA"><option value="0">0 %</option><option value="12">12 %</option><option value="15">15 %</option><option value="25" selected>25 %</option></select><select name="lineAccountId" data-supplier-line-account aria-label="Kostnadskonto"><option value="">Velg kostnadskonto</option></select></div></div><p class="supplier-line-hint">Velg kostnadskonto per linje. Leverandørens standardkonto foreslås automatisk, men du kan endre den.</p><button type="button" class="supplier-add-line">+ Legg til linje</button><div id="supplier-invoice-total" class="supplier-invoice-total" aria-live="polite"><span>Netto <strong>0 kr</strong></span><span>MVA <strong>0 kr</strong></span><span>Å betale <strong>0 kr</strong></span></div><label>Forfall<input name="dueDate" type="date" required /></label><label>Godkjent ordre (valgfritt)<select name="purchaseOrderId" id="supplier-invoice-order"><option value="">Ingen kobling</option></select></label><button type="submit">Registrer faktura</button></form>
    <form data-supplier-action="link_invoice_order"><h3>Koble faktura til ordre</h3><label>Faktura uten ordre<select name="invoiceId" id="supplier-link-invoice" required><option value="">Henter fakturaer…</option></select></label><label>Godkjent ordre<select name="purchaseOrderId" id="supplier-link-order" required><option value="">Henter ordrer…</option></select></label><p>Bruk når fakturaen kom før ordren ble registrert. Leverandør må stemme, og matching må kjøres etterpå.</p><button type="submit">Koble og send til matching</button></form>
    <form data-supplier-action="match_invoice"><h3>Treveis matching</h3><label>Faktura<select name="invoiceId" id="supplier-match-invoice" required><option value="">Henter fakturaer…</option></select></label><p>Ordre + bekreftet mottak må finnes. Avvik kan vurderes på nytt etter korrigering.</p><button type="submit">Match mot grunnlag</button></form>
    <form data-supplier-action="attest_invoice"><h3>Attester kontrollgrunnlag</h3><label>Matchet faktura<select name="invoiceId" id="supplier-attest-invoice" required><option value="">Henter matcher…</option></select></label><button type="submit">Attester faktura</button></form>
    <form data-supplier-action="assign_invoice"><h3>Anvis faktura</h3><label>Attestert faktura<select name="invoiceId" id="supplier-assign-invoice" required><option value="">Henter attesterte…</option></select></label><p>Fireøyne-regel håndheves av API-et.</p><button type="submit">Anvis neste steg</button></form>
    <form data-supplier-action="record_invoice_payment"><h3>Registrer betaling</h3><label>Godkjent faktura<select name="invoiceId" id="supplier-payment-invoice" required><option value="">Henter godkjente…</option></select></label><label>Beløp i kroner (valgfritt)<input name="amount" type="number" min="0.01" step="0.01" placeholder="Hele restbeløpet" /></label><label>Betalingsreferanse<input name="paymentReference" maxlength="120" required placeholder="KID eller bankreferanse" /></label><p>Manuell registrering · ingen bankbetaling sendes.</p><button type="submit">Registrer betaling</button></form>
  </div>
  <p id="supplier-quick-status" class="supplier-status" role="status" aria-live="polite"></p>
  <div id="supplier-quick-list" class="supplier-list"><p>Henter leverandørfakturaer…</p></div>
</section>
<script is:inline>
  const supplierEsc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const supplierMoney=v=>`${(Number(v||0)/100).toLocaleString('nb-NO')} kr`;
   let supplierBoardId=new URLSearchParams(location.search).get('boardId')||''; let supplierOrders=[]; let supplierInvoices=[]; let supplierParties=[]; let supplierLedgerAccounts=[]; let supplierApprovalPolicy={require_four_eyes_from_minor:0,owner_override_allowed:1};
  const supplierStatus=document.querySelector('#supplier-quick-status');
  const resolveSupplierBoard=async()=>{if(supplierBoardId)return supplierBoardId;try{const a=await(await fetch('/api/auth')).json();supplierBoardId=a.boards?.[0]?.id||''}catch{}return supplierBoardId||(location.pathname==='/finance/'?'board-1':'')};
  const supplierApi=async(payload)=>{const r=await fetch('/api/procurement',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({...payload,boardId:supplierBoardId})});const d=await r.json();if(!r.ok)throw Error(d.error||'Kunne ikke lagre');return d};
  const option=(x,label)=>`<option value="${supplierEsc(x.id)}">${supplierEsc(label)}</option>`;
   const supplierRefreshLineAccounts=()=>{const options=supplierLedgerAccounts.map(x=>`<option value="${supplierEsc(x.id)}">${supplierEsc(x.code)} · ${supplierEsc(x.name)}</option>`).join('');document.querySelectorAll('[data-supplier-line-account]').forEach(select=>{const current=select.value;select.innerHTML='<option value="">Velg kostnadskonto</option>'+options;select.value=current})};
   const loadSupplierAccounts=async()=>{try{const data=await fetch(`/api/finance?boardId=${encodeURIComponent(supplierBoardId)}&view=accounts`).then(r=>r.json());supplierLedgerAccounts=(data.data||[]).filter(x=>Number(x.active)!==0);const options=supplierLedgerAccounts.map(x=>`<option value="${supplierEsc(x.id)}">${supplierEsc(x.code)} · ${supplierEsc(x.name)}</option>`).join('');document.querySelector('#supplier-default-account').innerHTML='<option value="">Ingen standardkonto</option>'+options;document.querySelector('#supplier-edit-account').innerHTML='<option value="">Ingen standardkonto</option>'+options;supplierRefreshLineAccounts();}catch{}}
   const renderSupplierDirectory=()=>{const list=document.querySelector('#supplier-directory-list');if(!list)return;const rows=supplierParties||[];list.innerHTML=rows.length?rows.map(x=>`<article class="supplier-directory-row ${Number(x.active)===0?'inactive':''}"><div><strong>${supplierEsc(x.name)}</strong><small>${x.org_number?supplierEsc(x.org_number)+' · ':''}${x.email?supplierEsc(x.email)+' · ':''}Betalingsfrist ${supplierEsc(x.payment_terms_days??14)} dager${x.default_expense_account_name?` · ${supplierEsc(x.default_expense_account_code)} ${supplierEsc(x.default_expense_account_name)}`:''}</small></div><span>${Number(x.active)===0?'Inaktiv':'Aktiv'}</span><button type="button" class="supplier-edit-trigger" data-supplier-id="${supplierEsc(x.id)}">Rediger</button></article>`).join(''):'<p>Ingen leverandører registrert ennå.</p>';list.querySelectorAll('.supplier-edit-trigger').forEach(button=>button.addEventListener('click',()=>{const supplier=supplierParties.find(row=>String(row.id)===button.dataset.supplierId);const form=document.querySelector('#supplier-edit-form');if(!supplier||!form)return;form.hidden=false;form.elements.supplierId.value=supplier.id;form.elements.name.value=supplier.name||'';form.elements.orgNumber.value=supplier.org_number||'';form.elements.addressLine1.value=supplier.address_line1||'';form.elements.postalCode.value=supplier.postal_code||'';form.elements.city.value=supplier.city||'';form.elements.email.value=supplier.email||'';form.elements.paymentTermsDays.value=supplier.payment_terms_days??14;form.elements.defaultExpenseAccountId.value=supplier.default_expense_account_id||'';form.elements.active.checked=Number(supplier.active)!==0;form.scrollIntoView({behavior:'smooth',block:'center'});}));};
   const fillSupplierOptions=()=>{const partyOptions=supplierParties.filter(x=>Number(x.active)!==0).map(x=>option(x,`${x.name}${x.org_number?` · ${x.org_number}`:''}`)).join('');document.querySelector('#supplier-party-order').innerHTML='<option value="">Velg registrert leverandør</option>'+partyOptions;document.querySelector('#supplier-party-invoice').innerHTML='<option value="">Velg registrert leverandør</option>'+partyOptions;const pending=supplierOrders.filter(x=>x.status==='pending_approval');document.querySelector('#supplier-approve-order').innerHTML=pending.length?pending.map(x=>option(x,`${x.order_number} · ${x.supplier_party_name||x.supplier_name} · ${supplierMoney(x.total_minor)}`)).join(''):'<option value="">Ingen ordrer til godkjenning</option>';const approved=supplierOrders.filter(x=>['approved','received'].includes(x.status));document.querySelector('#supplier-receipt-order').innerHTML=approved.length?approved.map(x=>option(x,`${x.order_number} · ${x.supplier_party_name||x.supplier_name}`)).join(''):'<option value="">Ingen godkjente ordrer</option>';document.querySelector('#supplier-invoice-order').innerHTML='<option value="">Ingen kobling</option>'+approved.map(x=>option(x,`${x.order_number} · ${x.supplier_party_name||x.supplier_name}`)).join('');const linkable=supplierInvoices.filter(x=>['received','exception'].includes(x.status)&&!x.purchase_order_id);document.querySelector('#supplier-link-invoice').innerHTML=linkable.length?linkable.map(x=>option(x,`${x.invoice_number} · ${x.supplier_party_name||x.supplier_name}${x.status==='exception'?' · avvik':''} · ${supplierMoney(x.amount_minor)}`)).join(''):'<option value="">Ingen fakturaer uten ordre</option>';document.querySelector('#supplier-link-order').innerHTML=approved.length?approved.map(x=>option(x,`${x.order_number} · ${x.supplier_party_name||x.supplier_name} · ${supplierMoney(x.total_minor)}`)).join(''):'<option value="">Ingen godkjente ordrer</option>';const retryable=supplierInvoices.filter(x=>['received','exception'].includes(x.status)&&x.match_status!=='matched');document.querySelector('#supplier-match-invoice').innerHTML=retryable.length?retryable.map(x=>option(x,`${x.invoice_number} · ${x.supplier_party_name||x.supplier_name}${x.status==='exception'?' · avvik':''} · ${supplierMoney(x.amount_minor)}`)).join(''):'<option value="">Ingen fakturaer til matching</option>';const matched=supplierInvoices.filter(x=>x.status==='matched'&&x.match_status==='matched'&&!x.attested_at);document.querySelector('#supplier-attest-invoice').innerHTML=matched.length?matched.map(x=>option(x,`${x.invoice_number} · ${x.supplier_party_name||x.supplier_name}`)).join(''):'<option value="">Ingen til attestasjon</option>';const attested=supplierInvoices.filter(x=>x.status==='matched'&&x.match_status==='matched'&&x.attested_at&&!x.assigned_at);document.querySelector('#supplier-assign-invoice').innerHTML=attested.length?attested.map(x=>option(x,`${x.invoice_number} · ${x.attested_by||'attestant'}`)).join(''):'<option value="">Ingen til anvisning</option>';const payable=supplierInvoices.filter(x=>['approved','booked'].includes(x.status)&&Number(x.amount_minor||0)-Number(x.paid_minor||0)>0);document.querySelector('#supplier-payment-invoice').innerHTML=payable.length?payable.map(x=>option(x,`${x.invoice_number} · rest ${supplierMoney(Number(x.amount_minor||0)-Number(x.paid_minor||0))}`)).join(''):'<option value="">Ingen fakturaer til betaling</option>';};
   const loadSupplier=async()=>{await resolveSupplierBoard();const [o,i,s,p]=await Promise.all([fetch(`/api/procurement?boardId=${encodeURIComponent(supplierBoardId)}&view=orders`).then(r=>r.json()),fetch(`/api/procurement?boardId=${encodeURIComponent(supplierBoardId)}&view=invoices`).then(r=>r.json()),fetch(`/api/procurement?boardId=${encodeURIComponent(supplierBoardId)}&view=suppliers`).then(r=>r.json()),fetch(`/api/procurement?boardId=${encodeURIComponent(supplierBoardId)}&view=approval-policy`).then(r=>r.json())]);supplierOrders=o.data||[];supplierInvoices=i.data||[];supplierParties=s.data||[];supplierApprovalPolicy=p.data||supplierApprovalPolicy;document.querySelector('#supplier-four-eyes-limit').value=String(Number(supplierApprovalPolicy.require_four_eyes_from_minor||0)/100);document.querySelector('#supplier-owner-override').checked=Number(supplierApprovalPolicy.owner_override_allowed)!==0;fillSupplierOptions();await loadSupplierAccounts();renderSupplierDirectory();document.querySelector('#supplier-quick-list').innerHTML=supplierInvoices.map(x=>{const stage=x.paid_at?'Betalt':x.assigned_at?'Anvist':x.attested_at?'Attestert':x.match_status==='matched'?'Matchet':x.status==='exception'?'Avvik':x.status==='received'?'Mottatt':'—';const paid=Number(x.paid_minor||0);return `<article><div><strong>${supplierEsc(x.invoice_number)} · ${supplierEsc(x.supplier_party_name||x.supplier_name)}</strong><small>${supplierMoney(x.amount_minor)} · betalt ${supplierMoney(paid)} · rest ${supplierMoney(Math.max(0,Number(x.amount_minor||0)-paid))} · forfall ${supplierEsc(x.due_date||'ikke satt')}</small></div><span>${stage}</span></article>`}).join('')||'<p>Ingen leverandørfakturaer registrert ennå.</p>';};
   const addSupplierTermDefault=()=>{const select=document.querySelector('#supplier-party-invoice');const form=document.querySelector('[data-supplier-action="create_invoice"]');const due=form?.querySelector('[name="dueDate"]');const party=supplierParties.find(x=>x.id===select?.value);if(!party)return;if(due&&!due.value){const issue=new Date();issue.setUTCHours(0,0,0,0);issue.setUTCDate(issue.getUTCDate()+Number(party.payment_terms_days||14));due.value=issue.toISOString().slice(0,10)};document.querySelectorAll('[data-supplier-line-account]').forEach(account=>{if(!account.value)account.value=party.default_expense_account_id||''})};
   const updateSupplierInvoiceTotal=()=>{const form=document.querySelector('[data-supplier-action="create_invoice"]');if(!form)return;let net=0,vat=0;form.querySelectorAll('.supplier-line').forEach(row=>{const quantity=Number(row.querySelector('[name="lineQuantity"]')?.value||0),price=Math.round(Number(row.querySelector('[name="lineUnitPrice"]')?.value||0)*100),rate=Number(row.querySelector('[name="lineVatRate"]')?.value||0),lineNet=Math.round(quantity*price);net+=lineNet;vat+=Math.round(lineNet*rate/100)});const values=document.querySelectorAll('#supplier-invoice-total strong');if(values.length===3){values[0].textContent=supplierMoney(net);values[1].textContent=supplierMoney(vat);values[2].textContent=supplierMoney(net+vat)}};
   document.querySelector('#supplier-party-invoice')?.addEventListener('change',addSupplierTermDefault);
   document.querySelector('#supplier-edit-cancel')?.addEventListener('click',()=>{const form=document.querySelector('#supplier-edit-form');if(form)form.hidden=true;});
   document.querySelector('#supplier-edit-form')?.addEventListener('submit',async event=>{event.preventDefault();const form=event.currentTarget;const fields=new FormData(form);const status=document.querySelector('#supplier-directory-status');status.textContent='Lagrer leverandør…';try{await supplierApi({action:'update_supplier',supplierId:fields.get('supplierId'),name:fields.get('name'),orgNumber:fields.get('orgNumber'),addressLine1:fields.get('addressLine1'),postalCode:fields.get('postalCode'),city:fields.get('city'),email:fields.get('email'),paymentTermsDays:Number(fields.get('paymentTermsDays')||14),defaultExpenseAccountId:fields.get('defaultExpenseAccountId'),active:form.elements.active.checked});status.textContent='✓ Leverandøren er oppdatert.';form.hidden=true;await loadSupplier();}catch(error){status.textContent=`Kunne ikke oppdatere leverandør: ${error.message}`;}});
   const supplierInvoiceForm=document.querySelector('[data-supplier-action="create_invoice"]');supplierInvoiceForm?.addEventListener('input',updateSupplierInvoiceTotal);supplierInvoiceForm?.addEventListener('change',updateSupplierInvoiceTotal);
  document.querySelectorAll('.supplier-add-line').forEach(button=>button.addEventListener('click',()=>{const row=button.previousElementSibling.querySelector('.supplier-line');const clone=row.cloneNode(true);clone.querySelectorAll('input').forEach(input=>{if(input.name==='lineQuantity')input.value='1';else input.value=''});clone.querySelectorAll('select').forEach(select=>{if(select.name==='lineVatRate')select.value='25';else select.value=''});button.previousElementSibling.appendChild(clone);supplierRefreshLineAccounts();addSupplierTermDefault();updateSupplierInvoiceTotal()}));
  document.querySelectorAll('[data-supplier-action]').forEach(form=>form.addEventListener('submit',async e=>{e.preventDefault();const f=new FormData(form);const action=form.dataset.supplierAction;const payload={action};for(const [k,v] of f.entries())payload[k]=v;if(action==='update_approval_policy'){payload.requireFourEyesFromMinor=Math.round(Number(payload.requireFourEyesFrom||0)*100);payload.ownerOverrideAllowed=f.has('ownerOverrideAllowed');delete payload.requireFourEyesFrom}if(payload.total)payload.totalMinor=Math.round(Number(payload.total)*100);if(action==='record_invoice_payment'){if(payload.amount)payload.amountMinor=Math.round(Number(payload.amount)*100);delete payload.amount;}if(action==='create_invoice'){const descriptions=f.getAll('lineDescription'),quantities=f.getAll('lineQuantity'),prices=f.getAll('lineUnitPrice'),rates=f.getAll('lineVatRate'),accountIds=f.getAll('lineAccountId');payload.lines=descriptions.map((description,index)=>({description,quantity:Number(quantities[index]),unitPriceMinor:Math.round(Number(prices[index])*100),vatRate:Number(rates[index]),accountId:String(accountIds[index]||'')}));delete payload.amount;delete payload.amountMinor}if(action==='create_order')payload.currency='NOK';if(action==='create_invoice')payload.currency='NOK';supplierStatus.textContent='Lagrer og logger kontrollspor…';try{const d=await supplierApi(payload);supplierStatus.textContent=`✓ ${d.action} er registrert · ${d.status||'ok'}.`;if(action!=='update_approval_policy')form.reset();updateSupplierInvoiceTotal();await loadSupplier()}catch(err){supplierStatus.textContent=err.message==='supplier_invoice_number_exists'?err.message+': Fakturanummeret er allerede registrert – kontroller leverandør og nummer.':`Kunne ikke lagre: ${err.message}`}}));
  loadSupplier().catch(()=>{supplierStatus.textContent='Leverandørbildet er midlertidig utilgjengelig.'});
</script>
