<script is:inline>
  (() => {
    const productInvoiceEsc = value => String(value ?? '').replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
    const productInvoiceMoney = value => `${(Number(value || 0) / 100).toLocaleString('nb-NO', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} kr`;
    let productInvoiceRows = [];
    const productInvoiceBoard = () => new URLSearchParams(location.search).get('boardId') || invoiceBoardId;
    const productInvoiceOptions = () => '<option value="">Velg vare eller tjeneste …</option>' + productInvoiceRows.filter(row => Number(row.active) !== 0).map(row => `<option value="${productInvoiceEsc(row.id)}">${productInvoiceEsc(row.name)} · ${productInvoiceMoney(row.unit_price_minor)} · MVA ${productInvoiceEsc(row.vat_rate)} %</option>`).join('');
    const productInvoiceDecorate = () => document.querySelectorAll('#invoice-lines .invoice-line').forEach(line => {
      let picker = line.querySelector('.invoice-product-picker');
      if (!picker) { line.insertAdjacentHTML('afterbegin', '<label class="invoice-product-label">Hent fra produktregister<select class="invoice-product-picker" aria-label="Hent vare eller tjeneste"></select></label>'); picker = line.querySelector('.invoice-product-picker'); }
      if (picker) picker.innerHTML = productInvoiceOptions();
    });
    document.querySelector('#invoice-lines')?.addEventListener('change', event => {
      const picker = event.target.closest('.invoice-product-picker'); if (!picker) return;
      const product = productInvoiceRows.find(row => row.id === picker.value); if (!product) return;
      const line = picker.closest('.invoice-line'); line.querySelector('[name="lineDescription"]').value = product.name || '';
      line.querySelector('[name="lineUnitPrice"]').value = (Number(product.unit_price_minor || 0) / 100).toFixed(2);
      line.querySelector('[name="lineVatRate"]').value = String(product.vat_rate ?? 25); line.dataset.revenueAccountId = product.revenue_account_id || '';
    });
    const loadInvoiceProducts = async () => { try { const response = await fetch(`/api/finance?boardId=${encodeURIComponent(productInvoiceBoard())}&view=products`); const payload = await response.json(); if (response.ok) { productInvoiceRows = payload.data || []; productInvoiceDecorate(); } } catch {} };
    document.querySelector('#add-invoice-line')?.addEventListener('click', () => setTimeout(productInvoiceDecorate, 0));
    productInvoiceDecorate(); loadInvoiceProducts();
  })();
</script>
