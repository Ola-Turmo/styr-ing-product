<section class="sales-invoice-quick" aria-labelledby="sales-invoice-title">
  <div class="sales-invoice-intro"><span class="section-kicker">Kundefordringer</span><h2 id="sales-invoice-title">Fakturer kunder uten å miste oversikten.</h2><p>Dette er den korte, trygge arbeidsflyten for små virksomheter: lag utkast, kontroller, godkjenn og registrer innbetalingen. Ekstern sending (EHF/e-post) vises som ikke konfigurert før en leveringsavtale er på plass.</p></div>
  <div class="invoice-summary" id="invoice-summary" aria-label="Fakturaoppsummering"><div><span>Åpne fakturaer</span><strong>–</strong></div><div><span>Utestående</span><strong>–</strong></div><div><span>Forfalt</span><strong>–</strong></div></div>
  <div class="invoice-steps" aria-label="Fakturaflyt"><span><b>1</b> Utkast</span><i>→</i><span><b>2</b> Kontroll</span><i>→</i><span><b>3</b> Godkjenn</span><i>→</i><span><b>4</b> Registrer betaling</span></div>
  <form id="invoice-customer-form" class="invoice-customer-form"><div><h3>Har du ikke kunden ennå?</h3><p>Opprett kunden her, så blir den tilgjengelig i fakturautkastet.</p></div><label>Firmanavn<input name="companyName" maxlength="200" required placeholder="Eksempel AS" /></label><label>Organisasjonsnummer (valgfritt)<input name="orgNumber" inputmode="numeric" pattern="[0-9 ]{9,14}" maxlength="14" placeholder="987 654 321" /></label><button type="submit">Opprett kunde</button></form>
  <div class="sales-invoice-grid">
    <form data-invoice-action="create_invoice"><h3>Nytt fakturautkast</h3><label>Kunde<select name="accountId" id="invoice-account-id" required><option value="">Henter kunder…</option></select></label><label>Fakturanummer<input name="invoiceNumber" required placeholder="2026-001" /></label><div class="sales-invoice-row"><label>Fakturadato<input name="issueDate" type="date" value="2026-08-25" required /></label><label>Forfall<input name="dueDate" type="date" value="2026-09-08" /></label></div><label>Beskrivelse (valgfritt)<input name="description" maxlength="200" placeholder="Leveranse august" /></label><div id="invoice-lines" class="invoice-lines"><div class="invoice-line"><label>Vare/tjeneste<input name="lineDescription" required placeholder="Rådgivning" /></label><div class="sales-invoice-row"><label>Antall<input name="lineQuantity" type="number" min="0.01" step="0.01" value="1" required /></label><label>Pris per enhet<input name="lineUnitPrice" type="number" min="0.01" step="0.01" required placeholder="1000" /></label></div><label>MVA<select name="lineVatRate"><option value="0">Ingen MVA</option><option value="15">15 %</option><option value="25" selected>25 %</option></select></label></div></div><button type="button" id="add-invoice-line" class="secondary-button">+ Legg til linje</button><button type="submit">Opprett utkast</button></form>
    <form data-invoice-action="review_invoice"><h3>2 · Send til kontroll</h3><p class="form-help">En annen person kan kontrollere kunde, dato, linjer og MVA før godkjenning.</p><label>Utkast<select name="invoiceId" id="invoice-review-id" required></select></label><button type="submit">Send til kontroll</button></form>
    <form data-invoice-action="approve_invoice"><h3>3 · Godkjenn faktura</h3><p class="form-help">Godkjenning låser grunnlaget for videre oppfølging.</p><label>Faktura<select name="invoiceId" id="invoice-approve-id" required></select></label><button type="submit">Godkjenn grunnlag</button></form>
    <form data-invoice-action="record_invoice_payment"><h3>4 · Registrer betaling</h3><p class="form-help">Bruk delbetaling når kunden betaler i flere omganger.</p><label>Faktura<select name="invoiceId" id="invoice-payment-id" required></select></label><label>Beløp i kroner (valgfritt)<input name="amount" type="number" min="0.01" step="0.01" placeholder="Hele restbeløpet" /></label><label>Betalingsreferanse<input name="paymentReference" maxlength="120" required placeholder="KID eller bankreferanse" /></label><button type="submit">Registrer betaling</button></form>
    <form data-invoice-action="create_credit_note"><h3>Ny kreditnota</h3><label>Faktura<select name="invoiceId" id="invoice-credit-id" required></select></label><label>Kreditnotanummer<input name="creditNoteNumber" required placeholder="2026-KN-001" /></label><label>Dato<input name="issueDate" type="date" value="2026-08-25" required /></label><label>Beskrivelse<input name="description" required placeholder="Kreditering av feil faktura" /></label><div class="sales-invoice-row"><label>Netto<input name="amount" type="number" min="0.01" step="0.01" required /></label><label>MVA<input name="vat" type="number" min="0" step="0.01" value="0" required /></label></div><button type="submit">Opprett kreditnota</button></form>
    <form data-invoice-action="review_credit_note"><h3>Send kreditnota til kontroll</h3><label>Kreditnota<select name="creditNoteId" id="credit-review-id" required></select></label><button type="submit">Send til review</button></form>
    <form data-invoice-action="approve_credit_note"><h3>Godkjenn kreditnota</h3><label>Kreditnota<select name="creditNoteId" id="credit-approve-id" required></select></label><button type="submit">Godkjenn grunnlag</button></form>
  </div>
  <p id="sales-invoice-status" class="sales-invoice-status" role="status" aria-live="polite"></p>
  <div id="sales-invoice-list" class="sales-invoice-list"><p>Henter fakturaer…</p></div>
</section>
<script is:inline>
  const invoiceEsc = (v) => String(v ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const invoiceMoney = v => `${(Number(v || 0) / 100).toLocaleString('nb-NO', {minimumFractionDigits: 2, maximumFractionDigits: 2})} kr`;
  const invoiceStatusLabel = status => ({draft:'Utkast',review:'Til kontroll',approved:'Godkjent',sent:'Sendt',overdue:'Forfalt',paid:'Betalt',cancelled:'Kansellert'}[status] || status || 'Ukjent');
  let invoiceRows = []; let invoiceBoardId = new URLSearchParams(location.search).get('boardId') || '';
  const resolveInvoiceBoard = async () => { if (invoiceBoardId) return invoiceBoardId; try { const auth=await (await fetch('/api/auth')).json(); invoiceBoardId=auth.boards?.[0]?.id||''; } catch {} return invoiceBoardId || 'board-1'; };
  const loadInvoices = async () => { await resolveInvoiceBoard(); const [res, customers, creditRes] = await Promise.all([fetch(`/api/finance?boardId=${encodeURIComponent(invoiceBoardId)}&view=invoices`), fetch(`/api/finance?boardId=${encodeURIComponent(invoiceBoardId)}&view=customers`), fetch(`/api/finance?boardId=${encodeURIComponent(invoiceBoardId)}&view=credit-notes`)]); const data = await res.json(); const customerData = await customers.json(); const creditData=await creditRes.json(); invoiceRows = data.data || []; const creditRows=creditData.data||[]; const customerRows=customerData.data||[]; document.querySelector('#invoice-account-id').innerHTML=customerRows.length?customerRows.map(x=>`<option value="${invoiceEsc(x.id)}">${invoiceEsc(x.company_name)}${x.org_number?` · ${invoiceEsc(x.org_number)}`:''}</option>`).join(''):'<option value="">Opprett kunde først</option>'; const today = new Date().toISOString().slice(0,10); const openRows=invoiceRows.filter(x=>!['paid','cancelled'].includes(x.status)); const outstanding=openRows.reduce((sum,x)=>sum+Math.max(0,Number(x.total_minor||0)-Number(x.paid_minor||0)),0); const overdue=openRows.filter(x=>x.due_date && x.due_date<today).reduce((sum,x)=>sum+Math.max(0,Number(x.total_minor||0)-Number(x.paid_minor||0)),0); document.querySelector('#invoice-summary').innerHTML=`<div><span>Åpne fakturaer</span><strong>${openRows.length}</strong></div><div><span>Utestående</span><strong>${invoiceMoney(outstanding)}</strong></div><div><span>Forfalt</span><strong>${invoiceMoney(overdue)}</strong></div>`; const list = document.querySelector('#sales-invoice-list'); list.innerHTML = invoiceRows.map(x => { const paid=Number(x.paid_minor||0), total=Number(x.total_minor||0), rest=Math.max(0,total-paid), due=x.due_date && x.due_date<today && rest>0; return `<article><div><strong>${invoiceEsc(x.invoice_number)} · ${invoiceEsc(x.company_name || 'Kunde ikke satt')}</strong><p>${invoiceEsc(x.description || 'Ingen beskrivelse')} · ${x.line_count||0} linjer · forfall ${invoiceEsc(x.due_date || 'ikke satt')} · betalt ${invoiceMoney(paid)}${rest>0?` · rest ${invoiceMoney(rest)}`:''}</p></div><b>${invoiceMoney(total)}</b><span class="status-${invoiceEsc(due?'overdue':x.status)}">${invoiceEsc(invoiceStatusLabel(due?'overdue':x.status))}</span></article>`; }).join('') || '<p>Ingen fakturaer registrert ennå.</p>'; const fill=(id,statuses,empty)=>{const el=document.querySelector(id); const rows=invoiceRows.filter(x=>statuses.includes(x.status)); el.innerHTML=rows.length?rows.map(x=>`<option value="${invoiceEsc(x.id)}">${invoiceEsc(x.invoice_number)} · ${invoiceMoney(x.total_minor)} · ${invoiceEsc(invoiceStatusLabel(x.status))}</option>`).join(''):`<option value="">${empty}</option>`; el.disabled=!rows.length; el.closest('form')?.querySelector('button[type="submit"]')?.toggleAttribute('disabled',!rows.length);}; fill('#invoice-review-id',['draft'],'Ingen utkast'); fill('#invoice-approve-id',['review'],'Ingen fakturaer til godkjenning'); fill('#invoice-payment-id',['approved','sent','overdue'],'Ingen åpne fakturaer'); fill('#invoice-credit-id',['approved','sent','overdue','paid'],'Ingen utstedte fakturaer'); const fillCredits=(id,statuses,empty)=>{const el=document.querySelector(id); const rows=creditRows.filter(x=>statuses.includes(x.status)); el.innerHTML=rows.length?rows.map(x=>`<option value="${invoiceEsc(x.id)}">${invoiceEsc(x.credit_note_number)} · ${invoiceMoney(x.total_minor)} · ${invoiceEsc(invoiceStatusLabel(x.status))}</option>`).join(''):`<option value="">${empty}</option>`; el.disabled=!rows.length; el.closest('form')?.querySelector('button[type="submit"]')?.toggleAttribute('disabled',!rows.length);}; fillCredits('#credit-review-id',['draft'],'Ingen utkast'); fillCredits('#credit-approve-id',['review'],'Ingen kreditnotaer til godkjenning'); };
  document.querySelector('#add-invoice-line')?.addEventListener('click',()=>{const template=document.querySelector('.invoice-line');const clone=template.cloneNode(true);clone.querySelectorAll('input').forEach(input=>{input.value=input.name==='lineQuantity'?'1':'';});clone.querySelector('select').value='25';document.querySelector('#invoice-lines').appendChild(clone);});
  document.querySelector('#invoice-customer-form')?.addEventListener('submit',async event=>{event.preventDefault();const form=event.currentTarget;const status=document.querySelector('#sales-invoice-status');const fields=new FormData(form);status.textContent='Oppretter kunde og logger handling…';try{const res=await fetch('/api/domains/crm_accounts',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({boardId:invoiceBoardId,data:{company_name:String(fields.get('companyName')||'').trim(),org_number:String(fields.get('orgNumber')||'').replace(/\s/g,'')||null,stage:'prospect',currency:'NOK'}})});const data=await res.json();if(!res.ok)throw new Error(data.error||'Kunne ikke opprette kunde');status.textContent='✓ Kunde opprettet. Kunden er valgt i fakturautkastet.';form.reset();await loadInvoices();const select=document.querySelector('#invoice-account-id');if(data.id)select.value=data.id;}catch(error){status.textContent=`Kunne ikke opprette kunde: ${error.message}`;}});
  document.querySelectorAll('[data-invoice-action]').forEach(form => form.addEventListener('submit', async event => { event.preventDefault(); const status=document.querySelector('#sales-invoice-status'); const payload=Object.fromEntries(new FormData(form)); payload.boardId=invoiceBoardId; payload.action=form.dataset.invoiceAction; if(payload.action==='create_invoice'){payload.lines=[...form.querySelectorAll('.invoice-line')].map(line=>({description:line.querySelector('[name="lineDescription"]').value,quantity:Number(line.querySelector('[name="lineQuantity"]').value),unitPriceMinor:Math.round(Number(line.querySelector('[name="lineUnitPrice"]').value)*100),vatRate:Number(line.querySelector('[name="lineVatRate"]').value)})); delete payload.lineDescription; delete payload.lineQuantity; delete payload.lineUnitPrice; delete payload.lineVatRate; } if(payload.amount)payload.amountMinor=Math.round(Number(payload.amount)*100); if(payload.vat)payload.vatMinor=Math.round(Number(payload.vat)*100); status.textContent='Lagrer og logger handling…'; try { const res=await fetch('/api/finance',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(payload)}); const data=await res.json(); if(!res.ok) throw new Error(data.error||'Kunne ikke lagre'); status.textContent=`✓ ${data.action} er registrert · status ${data.status||'ok'}.`; form.reset(); await loadInvoices(); } catch (error) { status.textContent=`Kunne ikke lagre: ${error.message}`; } })); loadInvoices().catch(()=>{document.querySelector('#sales-invoice-status').textContent='Fakturabildet er midlertidig utilgjengelig.';});
</script>
<style>
  .sales-invoice-quick{margin:28px 0;padding:26px;border:1px solid rgba(16,36,31,.1);border-radius:18px;background:#eef4ed}.sales-invoice-intro h2{margin:8px 0;font:500 1.8rem/1 Georgia,serif}.sales-invoice-intro p{max-width:700px;color:var(--muted);font:.8rem/1.5 system-ui,sans-serif}.invoice-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:18px 0 10px}.invoice-summary div{padding:12px 14px;border-radius:11px;background:#fff;border:1px solid rgba(16,36,31,.08)}.invoice-summary span{display:block;color:var(--muted);font:600 .62rem system-ui,sans-serif}.invoice-summary strong{display:block;margin-top:4px;color:var(--ink);font:700 1.05rem system-ui,sans-serif}.invoice-steps{display:flex;align-items:center;gap:8px;margin:14px 0;color:var(--muted);font:600 .65rem system-ui,sans-serif}.invoice-steps b{display:inline-grid;place-items:center;width:20px;height:20px;margin-right:3px;border-radius:50%;background:var(--accent);color:#fff}.invoice-steps i{font-style:normal;color:rgba(16,36,31,.3)}.invoice-customer-form{display:grid;grid-template-columns:1.3fr 1fr 1fr auto;gap:10px;align-items:end;margin:14px 0 2px;padding:14px 15px;border:1px dashed rgba(16,36,31,.22);border-radius:12px;background:rgba(255,255,255,.65)}.invoice-customer-form h3{margin:0;font:700 .78rem/1.2 system-ui,sans-serif}.invoice-customer-form p{margin:4px 0 0;color:var(--muted);font:.64rem/1.35 system-ui,sans-serif}.invoice-customer-form label{display:grid;gap:4px;color:var(--muted);font:600 .62rem/1.2 system-ui,sans-serif}.invoice-customer-form input{width:100%;box-sizing:border-box;padding:8px;border:1px solid rgba(16,36,31,.15);border-radius:7px;background:#fff;font:.72rem system-ui,sans-serif}.invoice-customer-form button{border:0;border-radius:7px;padding:9px 12px;background:#28624c;color:#fff;font:700 .68rem/1 system-ui,sans-serif;cursor:pointer}.sales-invoice-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:20px}.sales-invoice-grid form{display:grid;gap:8px;padding:15px;border-radius:12px;background:#fff;border:1px solid rgba(16,36,31,.08)}.sales-invoice-grid h3{font:700 .8rem/1.2 system-ui,sans-serif}.form-help{margin:-2px 0 2px;color:var(--muted);font:500 .62rem/1.35 system-ui,sans-serif}.sales-invoice-grid label{display:grid;gap:4px;color:var(--muted);font:600 .62rem/1.2 system-ui,sans-serif}.sales-invoice-grid input,.sales-invoice-grid select{width:100%;min-width:0;padding:8px;border:1px solid rgba(16,36,31,.15);border-radius:7px;background:#fff;font:.72rem system-ui,sans-serif}.sales-invoice-grid button{border:0;border-radius:7px;padding:9px;background:var(--accent);color:#fff;font:700 .68rem/1 system-ui,sans-serif;cursor:pointer}.sales-invoice-grid button:disabled{opacity:.45;cursor:not-allowed}.sales-invoice-row{display:grid;grid-template-columns:1fr 1fr;gap:6px}.sales-invoice-status{min-height:1.2em;margin:13px 0 6px;color:var(--accent);font:700 .7rem/1.3 system-ui,sans-serif}.sales-invoice-list{display:grid;gap:7px}.sales-invoice-list article{display:grid;grid-template-columns:1fr auto auto;gap:14px;align-items:center;padding:12px 13px;border-radius:9px;background:#fff;border:1px solid rgba(16,36,31,.08);font-family:system-ui,sans-serif}.sales-invoice-list strong{display:block;font-size:.75rem}.sales-invoice-list p{margin:4px 0 0;color:var(--muted);font-size:.65rem}.sales-invoice-list b{font-size:.72rem;white-space:nowrap}.sales-invoice-list span{color:var(--accent);font:700 .62rem/1 system-ui,sans-serif}.sales-invoice-list .status-overdue{color:#a53a24}.sales-invoice-list .status-paid{color:#39774c}@media(max-width:900px){.invoice-customer-form{grid-template-columns:1fr 1fr}.invoice-customer-form>div{grid-column:1/-1}.sales-invoice-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.sales-invoice-quick{padding:18px}.invoice-summary{grid-template-columns:1fr}.invoice-steps{flex-wrap:wrap}.invoice-steps i{display:none}.invoice-customer-form{grid-template-columns:1fr}.invoice-customer-form>div{grid-column:auto}.sales-invoice-grid{grid-template-columns:1fr}.sales-invoice-list article{grid-template-columns:1fr auto}.sales-invoice-list span{grid-column:1/-1}}
</style>
