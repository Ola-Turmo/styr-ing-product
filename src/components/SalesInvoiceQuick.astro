<section class="sales-invoice-quick" aria-labelledby="sales-invoice-title">
  <div class="sales-invoice-intro"><span class="section-kicker">Kundefordringer</span><h2 id="sales-invoice-title">Fra fakturagrunnlag til betalt.</h2><p>Opprett et internt fakturautkast, send det til kontroll og registrer betaling. EHF, e-post og bankavstemming aktiveres først med avtale og riktig adapter.</p></div>
  <div class="sales-invoice-grid">
    <form data-invoice-action="create_invoice"><h3>Nytt fakturautkast</h3><label>Kunde<select name="accountId" id="invoice-account-id" required><option value="">Henter kunder…</option></select></label><label>Fakturanummer<input name="invoiceNumber" required placeholder="2026-001" /></label><div class="sales-invoice-row"><label>Fakturadato<input name="issueDate" type="date" value="2026-08-25" required /></label><label>Forfall<input name="dueDate" type="date" value="2026-09-08" /></label></div><label>Beskrivelse (valgfritt)<input name="description" maxlength="200" placeholder="Leveranse august" /></label><div id="invoice-lines" class="invoice-lines"><div class="invoice-line"><label>Vare/tjeneste<input name="lineDescription" required placeholder="Rådgivning" /></label><div class="sales-invoice-row"><label>Antall<input name="lineQuantity" type="number" min="0.01" step="0.01" value="1" required /></label><label>Pris per enhet<input name="lineUnitPrice" type="number" min="0.01" step="0.01" required placeholder="1000" /></label></div><label>MVA<select name="lineVatRate"><option value="0">Ingen MVA</option><option value="15">15 %</option><option value="25" selected>25 %</option></select></label></div></div><button type="button" id="add-invoice-line" class="secondary-button">+ Legg til linje</button><button type="submit">Opprett utkast</button></form>
    <form data-invoice-action="review_invoice"><h3>Send til kontroll</h3><label>Utkast<select name="invoiceId" id="invoice-review-id" required></select></label><button type="submit">Send til review</button></form>
    <form data-invoice-action="approve_invoice"><h3>Godkjenn faktura</h3><label>Faktura<select name="invoiceId" id="invoice-approve-id" required></select></label><button type="submit">Godkjenn grunnlag</button></form>
    <form data-invoice-action="record_invoice_payment"><h3>Registrer betaling</h3><label>Faktura<select name="invoiceId" id="invoice-payment-id" required></select></label><label>Beløp i kroner (valgfritt)<input name="amount" type="number" min="0.01" step="0.01" placeholder="Hele restbeløpet" /></label><label>Betalingsreferanse<input name="paymentReference" maxlength="120" required placeholder="KID eller bankreferanse" /></label><button type="submit">Registrer betaling</button></form>
    <form data-invoice-action="create_credit_note"><h3>Ny kreditnota</h3><label>Faktura<select name="invoiceId" id="invoice-credit-id" required></select></label><label>Kreditnotanummer<input name="creditNoteNumber" required placeholder="2026-KN-001" /></label><label>Dato<input name="issueDate" type="date" value="2026-08-25" required /></label><label>Beskrivelse<input name="description" required placeholder="Kreditering av feil faktura" /></label><div class="sales-invoice-row"><label>Netto<input name="amount" type="number" min="0.01" step="0.01" required /></label><label>MVA<input name="vat" type="number" min="0" step="0.01" value="0" required /></label></div><button type="submit">Opprett kreditnota</button></form>
    <form data-invoice-action="review_credit_note"><h3>Send kreditnota til kontroll</h3><label>Kreditnota<select name="creditNoteId" id="credit-review-id" required></select></label><button type="submit">Send til review</button></form>
    <form data-invoice-action="approve_credit_note"><h3>Godkjenn kreditnota</h3><label>Kreditnota<select name="creditNoteId" id="credit-approve-id" required></select></label><button type="submit">Godkjenn grunnlag</button></form>
  </div>
  <p id="sales-invoice-status" class="sales-invoice-status" role="status" aria-live="polite"></p>
  <div id="sales-invoice-list" class="sales-invoice-list"><p>Henter fakturaer…</p></div>
</section>
<script is:inline>
  const invoiceEsc = (v) => String(v ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const invoiceMoney = v => `${(Number(v || 0) / 100).toLocaleString('nb-NO')} kr`;
  let invoiceRows = []; let invoiceBoardId = new URLSearchParams(location.search).get('boardId') || '';
  const resolveInvoiceBoard = async () => { if (invoiceBoardId) return invoiceBoardId; try { const auth=await (await fetch('/api/auth')).json(); invoiceBoardId=auth.boards?.[0]?.id||''; } catch {} return invoiceBoardId || 'board-1'; };
  const loadInvoices = async () => { await resolveInvoiceBoard(); const [res, customers, creditRes] = await Promise.all([fetch(`/api/finance?boardId=${encodeURIComponent(invoiceBoardId)}&view=invoices`), fetch(`/api/finance?boardId=${encodeURIComponent(invoiceBoardId)}&view=customers`), fetch(`/api/finance?boardId=${encodeURIComponent(invoiceBoardId)}&view=credit-notes`)]); const data = await res.json(); const customerData = await customers.json(); const creditData=await creditRes.json(); invoiceRows = data.data || []; const creditRows=creditData.data||[]; const customerRows=customerData.data||[]; document.querySelector('#invoice-account-id').innerHTML=customerRows.length?customerRows.map(x=>`<option value="${invoiceEsc(x.id)}">${invoiceEsc(x.company_name)}${x.org_number?` · ${invoiceEsc(x.org_number)}`:''}</option>`).join(''):'<option value="">Opprett kunde først</option>'; const list = document.querySelector('#sales-invoice-list'); list.innerHTML = invoiceRows.map(x => `<article><div><strong>${invoiceEsc(x.invoice_number)} · ${invoiceEsc(x.company_name || 'Kunde ikke satt')}</strong><p>${invoiceEsc(x.description)} · forfall ${invoiceEsc(x.due_date || 'ikke satt')} · betalt ${invoiceMoney(x.paid_minor||0)}${x.paid_minor&&Number(x.paid_minor)<Number(x.total_minor)?` · rest ${invoiceMoney(Number(x.total_minor)-Number(x.paid_minor))}`:''}</p></div><b>${invoiceMoney(x.total_minor)}</b><span>${invoiceEsc(x.status)}</span></article>`).join('') || '<p>Ingen fakturaer registrert ennå.</p>'; const fill=(id,statuses,empty)=>{const rows=invoiceRows.filter(x=>statuses.includes(x.status));document.querySelector(id).innerHTML=rows.length?rows.map(x=>`<option value="${invoiceEsc(x.id)}">${invoiceEsc(x.invoice_number)} · ${invoiceMoney(x.total_minor)} · ${invoiceEsc(x.status)}</option>`).join(''):`<option value="">${empty}</option>`}; fill('#invoice-review-id',['draft'],'Ingen utkast'); fill('#invoice-approve-id',['review'],'Ingen fakturaer til godkjenning'); fill('#invoice-payment-id',['approved','sent','overdue'],'Ingen åpne fakturaer'); fill('#invoice-credit-id',['approved','sent','overdue','paid'],'Ingen utstedte fakturaer'); const fillCredits=(id,statuses,empty)=>{const rows=creditRows.filter(x=>statuses.includes(x.status));document.querySelector(id).innerHTML=rows.length?rows.map(x=>`<option value="${invoiceEsc(x.id)}">${invoiceEsc(x.credit_note_number)} · ${invoiceMoney(x.total_minor)} · ${invoiceEsc(x.status)}</option>`).join(''):`<option value="">${empty}</option>`}; fillCredits('#credit-review-id',['draft'],'Ingen utkast'); fillCredits('#credit-approve-id',['review'],'Ingen kreditnotaer til godkjenning'); };
  document.querySelector('#add-invoice-line')?.addEventListener('click',()=>{const template=document.querySelector('.invoice-line');const clone=template.cloneNode(true);clone.querySelectorAll('input').forEach(input=>{input.value=input.name==='lineQuantity'?'1':'';});clone.querySelector('select').value='25';document.querySelector('#invoice-lines').appendChild(clone);});
  document.querySelectorAll('[data-invoice-action]').forEach(form => form.addEventListener('submit', async event => { event.preventDefault(); const status=document.querySelector('#sales-invoice-status'); const payload=Object.fromEntries(new FormData(form)); payload.boardId=invoiceBoardId; payload.action=form.dataset.invoiceAction; if(payload.action==='create_invoice'){payload.lines=[...form.querySelectorAll('.invoice-line')].map(line=>({description:line.querySelector('[name="lineDescription"]').value,quantity:Number(line.querySelector('[name="lineQuantity"]').value),unitPriceMinor:Math.round(Number(line.querySelector('[name="lineUnitPrice"]').value)*100),vatRate:Number(line.querySelector('[name="lineVatRate"]').value)})); delete payload.lineDescription; delete payload.lineQuantity; delete payload.lineUnitPrice; delete payload.lineVatRate; } if(payload.amount)payload.amountMinor=Math.round(Number(payload.amount)*100); if(payload.vat)payload.vatMinor=Math.round(Number(payload.vat)*100); status.textContent='Lagrer og logger handling…'; try { const res=await fetch('/api/finance',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(payload)}); const data=await res.json(); if(!res.ok) throw new Error(data.error||'Kunne ikke lagre'); status.textContent=`✓ ${data.action} er registrert · status ${data.status||'ok'}.`; form.reset(); await loadInvoices(); } catch (error) { status.textContent=`Kunne ikke lagre: ${error.message}`; } })); loadInvoices().catch(()=>{document.querySelector('#sales-invoice-status').textContent='Fakturabildet er midlertidig utilgjengelig.';});
</script>
<style>
  .sales-invoice-quick{margin:28px 0;padding:26px;border:1px solid rgba(16,36,31,.1);border-radius:18px;background:#eef4ed}.sales-invoice-intro h2{margin:8px 0;font:500 1.8rem/1 Georgia,serif}.sales-invoice-intro p{max-width:700px;color:var(--muted);font:.8rem/1.5 system-ui,sans-serif}.sales-invoice-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:20px}.sales-invoice-grid form{display:grid;gap:8px;padding:15px;border-radius:12px;background:#fff;border:1px solid rgba(16,36,31,.08)}.sales-invoice-grid h3{font:700 .8rem/1.2 system-ui,sans-serif}.sales-invoice-grid label{display:grid;gap:4px;color:var(--muted);font:600 .62rem/1.2 system-ui,sans-serif}.sales-invoice-grid input,.sales-invoice-grid select{width:100%;min-width:0;padding:8px;border:1px solid rgba(16,36,31,.15);border-radius:7px;background:#fff;font:.72rem system-ui,sans-serif}.sales-invoice-grid button{border:0;border-radius:7px;padding:9px;background:var(--accent);color:#fff;font:700 .68rem/1 system-ui,sans-serif;cursor:pointer}.sales-invoice-row{display:grid;grid-template-columns:1fr 1fr;gap:6px}.sales-invoice-status{min-height:1.2em;margin:13px 0 6px;color:var(--accent);font:700 .7rem/1.3 system-ui,sans-serif}.sales-invoice-list{display:grid;gap:7px}.sales-invoice-list article{display:grid;grid-template-columns:1fr auto auto;gap:14px;align-items:center;padding:12px 13px;border-radius:9px;background:#fff;border:1px solid rgba(16,36,31,.08);font-family:system-ui,sans-serif}.sales-invoice-list strong{display:block;font-size:.75rem}.sales-invoice-list p{margin:4px 0 0;color:var(--muted);font-size:.65rem}.sales-invoice-list b{font-size:.72rem}.sales-invoice-list span{color:var(--accent);font:700 .62rem/1 system-ui,sans-serif}@media(max-width:900px){.sales-invoice-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.sales-invoice-quick{padding:18px}.sales-invoice-grid{grid-template-columns:1fr}.sales-invoice-list article{grid-template-columns:1fr auto}.sales-invoice-list span{grid-column:1/-1}}
</style>
