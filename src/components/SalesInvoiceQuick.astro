<section class="sales-invoice-quick" aria-labelledby="sales-invoice-title">
  <div class="sales-invoice-intro"><span class="section-kicker">Kundefordringer</span><h2 id="sales-invoice-title">Lag faktura uten å miste oversikten.</h2><p>Dette er den korte, trygge arbeidsflyten for små virksomheter: lag utkast, kontroller, godkjenn og registrer innbetalingen. Ekstern sending (EHF/e-post) vises som ikke konfigurert før en leveringsavtale er på plass.</p></div>
  <div class="invoice-summary" id="invoice-summary" aria-label="Fakturaoppsummering"><div><span>Åpne fakturaer</span><strong>–</strong></div><div><span>Utestående</span><strong>–</strong></div><div><span>Forfalt</span><strong>–</strong></div></div>
  <div class="invoice-steps" aria-label="Fakturaflyt"><span><b>1</b> Utkast</span><i>→</i><span><b>2</b> Kontroll</span><i>→</i><span><b>3</b> Godkjenn</span><i>→</i><span><b>4</b> Registrer betaling</span></div>
  <button type="button" id="invoice-setup-toggle" class="invoice-setup-toggle" aria-expanded="false">Rediger kunderegister og fakturaprofil</button>
  <form id="invoice-customer-form" class="invoice-customer-form"><div><h3>Legg kunden i kunderegisteret</h3><p>Opprett kunden én gang. Adresse og kundetype følger med på fakturaen, og kan endres senere under fakturaprofil.</p></div><label>Navn / firmanavn<input name="companyName" maxlength="200" required placeholder="Eksempel AS" /></label><label>Kundetype<select name="customerType"><option value="business">Bedrift</option><option value="private">Privatkunde</option></select></label><label>Organisasjonsnummer<input name="orgNumber" inputmode="numeric" pattern="[0-9 ]{9,14}" maxlength="14" placeholder="987 654 321" /><small class="form-help">Påkrevd for bedrifter. 9 siffer med gyldig kontrollsiffer.</small></label><label>Adresse<input name="addressLine1" maxlength="200" required placeholder="Storgata 1" /></label><label>Postnummer<input name="postalCode" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" required placeholder="0155" /></label><label>Poststed<input name="city" maxlength="100" required placeholder="Oslo" /></label><label>E-post (valgfritt)<input name="email" type="email" maxlength="200" placeholder="faktura@eksempel.no" /></label><label>Betalingsfrist (dager)<input name="paymentTermsDays" type="number" min="0" max="365" step="1" value="14" required /><small class="form-help">Brukes som forfallsdato på nye fakturaer.</small></label><button type="submit">Opprett i kunderegisteret</button></form>
  <section class="customer-directory" aria-labelledby="customer-directory-title"><div class="customer-directory-heading"><div><span class="section-kicker">Kunderegister</span><h3 id="customer-directory-title">Kunder du fakturerer</h3><p>Hold kontaktinformasjon, kundetype og betalingsfrist oppdatert på ett sted.</p></div><p id="customer-directory-status" class="form-note" role="status" aria-live="polite"></p></div><div id="customer-directory-list" class="customer-directory-list"><p>Laster kunderegister…</p></div><form id="customer-directory-edit" class="customer-directory-edit" hidden><input type="hidden" name="accountId" /><h4>Rediger kunde</h4><div class="invoice-setup-grid"><label>Navn / firmanavn<input name="companyName" required maxlength="200" /></label><label>Kundetype<select name="customerType"><option value="business">Bedrift</option><option value="private">Privatkunde</option></select></label><label>Organisasjonsnummer<input name="orgNumber" inputmode="numeric" maxlength="11" pattern="[0-9]{9}" /><small class="form-help">Påkrevd for bedrifter. 9 siffer med gyldig kontrollsiffer.</small></label><label>Adresse<input name="addressLine1" required maxlength="200" /></label><label>Postnummer<input name="postalCode" required inputmode="numeric" maxlength="4" /></label><label>Poststed<input name="city" required maxlength="100" /></label><label>E-post<input name="email" type="email" maxlength="200" /></label><label>Betalingsfrist (dager)<input name="paymentTermsDays" type="number" min="0" max="365" step="1" value="14" required /></label></div><div class="customer-directory-actions"><button type="submit">Lagre endringer</button><button type="button" class="button-secondary" id="customer-directory-cancel">Avbryt</button></div></form></section>
  <div class="sales-invoice-grid">
    <form data-invoice-action="create_invoice"><h3>Nytt fakturautkast</h3><label>Kunde<select name="accountId" id="invoice-account-id" required><option value="">Henter kunder…</option></select></label><label>Fakturanummer<input name="invoiceNumber" placeholder="Tildeles automatisk" /><small class="form-help">La feltet stå tomt for neste sikre nummer, for eksempel 2026-00001.</small></label><div class="sales-invoice-row"><label>Fakturadato<input name="issueDate" type="date" required /></label><label>Forfall<input name="dueDate" type="date" /></label></div><label>Beskrivelse (valgfritt)<input name="description" maxlength="200" placeholder="Leveranse august" /></label><div id="invoice-lines" class="invoice-lines"><div class="invoice-line"><label>Vare/tjeneste<input name="lineDescription" required placeholder="Rådgivning" /></label><div class="sales-invoice-row"><label>Antall<input name="lineQuantity" type="number" min="0.01" step="0.01" value="1" required /></label><label>Pris per enhet<input name="lineUnitPrice" type="number" min="0.01" step="0.01" required placeholder="1000" /></label></div><label>MVA<select name="lineVatRate"><option value="0">Ingen MVA</option><option value="12">12 %</option><option value="15">15 %</option><option value="25" selected>25 %</option></select></label></div></div><div id="invoice-draft-total" class="invoice-draft-total" aria-live="polite"><span>Netto <b>0,00 kr</b></span><span>MVA <b>0,00 kr</b></span><strong>Å betale <b>0,00 kr</b></strong></div><button type="button" id="add-invoice-line" class="secondary-button">+ Legg til linje</button><button type="submit">Opprett utkast</button></form>
    <form data-invoice-action="review_invoice"><h3>2 · Send til kontroll</h3><p class="form-help">En annen person kan kontrollere kunde, dato, linjer og MVA før godkjenning.</p><label>Utkast<select name="invoiceId" id="invoice-review-id" required></select></label><button type="submit">Send til kontroll</button></form>
    <form data-invoice-action="approve_invoice"><h3>3 · Godkjenn faktura</h3><p class="form-help">Godkjenning låser grunnlaget for videre oppfølging.</p><label>Faktura<select name="invoiceId" id="invoice-approve-id" required></select></label><button type="submit">Godkjenn grunnlag</button></form>
    <form data-invoice-action="record_invoice_payment"><h3>4 · Registrer betaling</h3><p class="form-help">Bruk delbetaling når kunden betaler i flere omganger. Betalingen registreres som grunnlag og må avstemmes mot banken før hovedboken oppdateres.</p><label>Faktura<select name="invoiceId" id="invoice-payment-id" required></select></label><label>Beløp i kroner (valgfritt)<input name="amount" type="number" min="0.01" step="0.01" placeholder="Hele restbeløpet" /></label><label>Betalingsreferanse<input name="paymentReference" maxlength="120" required placeholder="KID eller bankreferanse" /></label><button type="submit">Registrer betaling</button></form>
    <form data-invoice-action="create_credit_note"><h3>Ny kreditnota</h3><label>Faktura<select name="invoiceId" id="invoice-credit-id" required></select></label><label>Kreditnotanummer<input name="creditNoteNumber" required placeholder="2026-KN-001" /></label><label>Dato<input name="issueDate" type="date" required /></label><label>Beskrivelse<input name="description" required placeholder="Kreditering av feil faktura" /></label><div class="sales-invoice-row"><label>Netto<input name="amount" type="number" min="0.01" step="0.01" required /></label><label>MVA<input name="vat" type="number" min="0" step="0.01" value="0" required /></label></div><button type="submit">Opprett kreditnota</button></form>
    <form data-invoice-action="review_credit_note"><h3>Send kreditnota til kontroll</h3><label>Kreditnota<select name="creditNoteId" id="credit-review-id" required></select></label><button type="submit">Send til review</button></form>
    <form data-invoice-action="approve_credit_note"><h3>Godkjenn kreditnota</h3><label>Kreditnota<select name="creditNoteId" id="credit-approve-id" required></select></label><button type="submit">Godkjenn grunnlag</button></form>
  </div>
  <p id="sales-invoice-status" class="sales-invoice-status" role="status" aria-live="polite"></p>
  <div id="sales-invoice-list" class="sales-invoice-list"><p>Henter fakturaer…</p></div>
  <section id="invoice-setup" class="invoice-setup" hidden aria-labelledby="invoice-setup-title"><div><span class="section-kicker">Fakturaprofil</span><h3 id="invoice-setup-title">Opplysninger som skal stå på fakturaen</h3><p>Disse opplysningene lagres per virksomhet og kunde. Du trenger dem før en faktura kan godkjennes.</p></div><form id="seller-invoice-profile-form"><h4>Din virksomhet</h4><div class="invoice-setup-grid"><label>Juridisk navn<input name="legalName" required maxlength="200" /></label><label>Organisasjonsnummer<input name="orgNumber" required inputmode="numeric" maxlength="11" /><small class="form-help">9 siffer med gyldig kontrollsiffer.</small></label><label>Adresse<input name="addressLine1" required maxlength="200" /></label><label>Postnummer<input name="postalCode" required inputmode="numeric" maxlength="4" /></label><label>Poststed<input name="city" required maxlength="100" /></label><label>Bankkontonummer<input name="bankAccount" required inputmode="numeric" maxlength="11" /><small class="form-help">11 siffer med gyldig kontrollsiffer.</small></label><label>E-post<input name="email" type="email" maxlength="200" /></label><label class="invoice-check"><input name="vatRegistered" type="checkbox" /> Registrert i Merverdiavgiftsregisteret</label></div><button type="submit">Lagre virksomhetsopplysninger</button></form><form id="customer-invoice-profile-form"><h4>Kunderegister</h4><div class="invoice-setup-grid"><label>Kunde<select name="accountId" id="invoice-profile-account" required></select></label><label>Navn / firmanavn<input name="companyName" required maxlength="200" /></label><label>Kundetype<select name="customerType"><option value="business">Bedrift</option><option value="private">Privatkunde</option></select></label><label>Organisasjonsnummer<input name="orgNumber" inputmode="numeric" maxlength="11" pattern="[0-9]{9}" /><small class="form-help">Påkrevd for bedrifter. 9 siffer med gyldig kontrollsiffer. La stå tomt for privatkunde.</small></label><label>Adresse<input name="addressLine1" required maxlength="200" /></label><label>Postnummer<input name="postalCode" required inputmode="numeric" maxlength="4" /></label><label>Poststed<input name="city" required maxlength="100" /></label><label>E-post<input name="email" type="email" maxlength="200" /></label><label>Betalingsfrist (dager)<input name="paymentTermsDays" type="number" min="0" max="365" step="1" value="14" required /><small class="form-help">Brukes som forfallsdato på nye fakturaer.</small></label></div><button type="submit">Lagre i kunderegisteret</button></form><p id="invoice-setup-status" class="form-note" role="status" aria-live="polite"></p></section>
  <aside id="invoice-detail" class="invoice-detail" hidden aria-live="polite"></aside>
</section>
<script is:inline>
  const invoiceEsc = (v) => String(v ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const invoiceMoney = v => `${(Number(v || 0) / 100).toLocaleString('nb-NO', {minimumFractionDigits: 2, maximumFractionDigits: 2})} kr`;
  const updateInvoiceDraftTotal = () => { const form=document.querySelector('[data-invoice-action="create_invoice"]'); const total=document.querySelector('#invoice-draft-total'); if(!form||!total)return; let net=0,vat=0; form.querySelectorAll('.invoice-line').forEach(line=>{const quantity=Number(line.querySelector('[name="lineQuantity"]')?.value||0);const unit=Math.round(Number(line.querySelector('[name="lineUnitPrice"]')?.value||0)*100);const rate=Number(line.querySelector('[name="lineVatRate"]')?.value||0);const lineNet=Math.round(quantity*unit);net+=lineNet;vat+=Math.round(lineNet*rate/100);});total.innerHTML=`<span>Netto <b>${invoiceMoney(net)}</b></span><span>MVA <b>${invoiceMoney(vat)}</b></span><strong>Å betale <b>${invoiceMoney(net+vat)}</b></strong>`;};
  const invoiceStatusLabel = status => ({draft:'Utkast',review:'Til kontroll',approved:'Godkjent',sent:'Sendt',overdue:'Forfalt',paid:'Betalt',cancelled:'Kansellert'}[status] || status || 'Ukjent');
  const invoiceValidOrg = value => { const digits=String(value||'').replace(/\s/g,''); if(!/^\d{9}$/.test(digits)) return false; const weights=[3,2,7,6,5,4,3,2]; const sum=weights.reduce((total,weight,index)=>total+Number(digits[index])*weight,0); const remainder=11-(sum%11); return remainder!==10 && (remainder===11?0:remainder)===Number(digits.at(-1)); };
  let invoiceRows = []; let invoiceCustomerRows = []; let invoiceBoardId = new URLSearchParams(location.search).get('boardId') || '';
  const setInvoiceDateDefaults = () => { const invoiceForm=document.querySelector('[data-invoice-action="create_invoice"]'); const issue=invoiceForm?.querySelector('[name="issueDate"]'); const due=invoiceForm?.querySelector('[name="dueDate"]'); const creditDate=document.querySelector('[data-invoice-action="create_credit_note"] [name="issueDate"]'); const today=new Date().toISOString().slice(0,10); if(issue&&!issue.value)issue.value=today; if(due&&issue){due.min=issue.value; if(!due.value||due.value<issue.value){const d=new Date(`${issue.value}T00:00:00Z`);d.setUTCDate(d.getUTCDate()+14);due.value=d.toISOString().slice(0,10);}} if(creditDate&&!creditDate.value)creditDate.value=today; };
  const invoiceDateForm=document.querySelector('[data-invoice-action="create_invoice"]'); const invoiceIssueDate=invoiceDateForm?.querySelector('[name="issueDate"]'); const invoiceDueDate=invoiceDateForm?.querySelector('[name="dueDate"]'); let invoiceDueAuto=true; invoiceIssueDate?.addEventListener('change',()=>{invoiceDueAuto=true;setInvoiceDateDefaults();}); invoiceDueDate?.addEventListener('input',()=>{invoiceDueAuto=false;}); setInvoiceDateDefaults();
  invoiceDateForm?.querySelector('[name="accountId"]')?.addEventListener('change',()=>{const accountId=invoiceDateForm.querySelector('[name="accountId"]').value;const due=invoiceDateForm.querySelector('[name="dueDate"]');const issue=invoiceDateForm.querySelector('[name="issueDate"]');if(!accountId||!due||!issue?.value||!invoiceDueAuto)return;fetch(`/api/finance?boardId=${encodeURIComponent(invoiceBoardId)}&view=customers`).then(r=>r.json()).then(d=>{const c=(d.data||[]).find(x=>x.id===accountId);if(c){const date=new Date(`${issue.value}T00:00:00Z`);date.setUTCDate(date.getUTCDate()+Number(c.payment_terms_days??14));due.value=date.toISOString().slice(0,10);}}).catch(()=>{});});
  const resolveInvoiceBoard = async () => { if (invoiceBoardId) return invoiceBoardId; try { const auth=await (await fetch('/api/auth')).json(); invoiceBoardId=auth.boards?.[0]?.id||''; } catch {} return invoiceBoardId || (location.pathname === '/finance/' ? 'board-1' : ''); };
  const showInvoiceDetail = async (invoiceId, updateUrl = true) => { const detail=document.querySelector('#invoice-detail'); const invoice=invoiceRows.find(x=>x.id===invoiceId); if(!invoice){detail.hidden=true;return;} detail.hidden=false; detail.innerHTML='<p>Henter fakturadokument…</p>'; if(updateUrl){const url=new URL(location.href);url.searchParams.set('invoiceId',invoiceId);history.replaceState({},'',url);} try { const res=await fetch(`/api/finance?boardId=${encodeURIComponent(invoiceBoardId)}&view=invoice-document&invoiceId=${encodeURIComponent(invoiceId)}`); const data=await res.json(); if(!res.ok||!data.data)throw new Error(data.error||'Kunne ikke hente fakturadokument'); const doc=data.data.document, rows=doc.lines||[], draft=doc.invoice.status==='draft'||doc.invoice.status==='review'; detail.innerHTML=`<div class="invoice-detail-head"><div><span class="section-kicker">${draft?'Fakturautkast':'Fakturadokument'}</span><h3>${invoiceEsc(doc.invoice.number)} · ${invoiceEsc(doc.customer.name||'Kunde ikke satt')}</h3><p>${invoiceEsc(doc.invoice.issueDate||'—')} · forfall ${invoiceEsc(doc.invoice.dueDate||'ikke satt')} · ${invoiceEsc(invoiceStatusLabel(doc.invoice.status))}${data.data.checksum?` · kontrollsum ${invoiceEsc(String(data.data.checksum).slice(0,12))}…`:''}</p></div><div class="invoice-detail-actions">${draft?'<button type="button" class="invoice-edit-draft">Rediger utkast</button>':''}<button type="button" class="invoice-print" ${draft?'disabled':''}>Skriv ut / lagre PDF</button><button type="button" class="invoice-detail-close" aria-label="Lukk fakturadetaljer">Lukk</button></div></div><div class="invoice-print-sheet"><div class="invoice-print-top"><div><strong>${invoiceEsc(doc.seller.legalName||'Virksomhetsnavn ikke satt')}</strong><span>${invoiceEsc(doc.seller.addressLine1||'Adresse ikke satt')} · ${invoiceEsc(doc.seller.postalCode||'')} ${invoiceEsc(doc.seller.city||'')}</span><span>Org.nr. ${invoiceEsc(doc.seller.orgNumber||'')}</span></div><div><b>FAKTURA</b><span>Nr. ${invoiceEsc(doc.invoice.number)}</span><span>Dato ${invoiceEsc(doc.invoice.issueDate||'—')}</span><span>Forfall ${invoiceEsc(doc.invoice.dueDate||'—')}</span></div></div><div class="invoice-print-customer"><strong>${invoiceEsc(doc.customer.name||'Kunde')}</strong><span>${invoiceEsc(doc.customer.addressLine1||'Adresse ikke satt')} · ${invoiceEsc(doc.customer.postalCode||'')} ${invoiceEsc(doc.customer.city||'')}</span><span>${doc.customer.type==='private'?'Privatkunde':'Org.nr. '+invoiceEsc(doc.customer.orgNumber||'')}</span></div>${draft?'<p class="invoice-draft-watermark">UTKAST – IKKE SENDT</p>':''}<div class="invoice-detail-lines">${rows.length?rows.map(x=>`<div><span>${invoiceEsc(x.description)}</span><small>${invoiceEsc(x.quantity)} × ${invoiceMoney(x.unit_price_minor)} · MVA ${invoiceEsc(x.vat_rate)} %</small><b>${invoiceMoney(x.total_minor)}</b></div>`).join(''):'<p>Ingen linjer registrert.</p>'}</div><div class="invoice-print-totals"><span>Netto <b>${invoiceMoney(doc.invoice.netMinor)}</b></span><span>MVA <b>${invoiceMoney(doc.invoice.vatMinor)}</b></span><strong>Å betale <b>${invoiceMoney(doc.invoice.totalMinor)}</b></strong></div><p class="invoice-detail-note">Betales til konto ${invoiceEsc(doc.seller.bankAccount||'ikke satt')}. Ekstern sending (EHF/e-post) er ikke konfigurert.</p></div></div>`; detail.querySelector('.invoice-edit-draft')?.addEventListener('click',()=>{const form=document.querySelector('[data-invoice-action="create_invoice"]');if(!form)return;form.dataset.editingInvoiceId=invoiceId;form.querySelector('[name="accountId"]').value=invoice.account_id||'';form.querySelector('[name="issueDate"]').value=doc.invoice.issueDate||'';form.querySelector('[name="dueDate"]').value=doc.invoice.dueDate||'';form.querySelector('[name="description"]').value=doc.invoice.description||'';const linesEl=form.querySelector('#invoice-lines');linesEl.innerHTML='';rows.forEach((line,index)=>{const template=document.querySelector('.invoice-line').cloneNode(true);template.querySelector('[name="lineDescription"]').value=line.description||'';template.querySelector('[name="lineQuantity"]').value=line.quantity||1;template.querySelector('[name="lineUnitPrice"]').value=(Number(line.unit_price_minor||0)/100).toFixed(2);template.querySelector('[name="lineVatRate"]').value=String(line.vat_rate??25);template.dataset.revenueAccountId=line.account_id||'';linesEl.appendChild(template);});updateInvoiceDraftTotal();form.querySelector('button[type="submit"]').textContent='Lagre endringer';form.scrollIntoView({behavior:'smooth',block:'start'});detail.hidden=true;}); detail.querySelector('.invoice-detail-close')?.addEventListener('click',()=>{detail.hidden=true;const url=new URL(location.href);url.searchParams.delete('invoiceId');history.replaceState({},'',url);}); detail.querySelector('.invoice-print')?.addEventListener('click',()=>{document.body.classList.add('printing-invoice');const clean=()=>{document.body.classList.remove('printing-invoice');window.removeEventListener('afterprint',clean);};window.addEventListener('afterprint',clean);window.print();}); } catch(error) { detail.innerHTML=`<p>Fakturadokumentet kunne ikke lastes: ${invoiceEsc(error.message)}</p>`; } };
  const loadInvoices = async () => { await resolveInvoiceBoard(); const [res, customers, creditRes] = await Promise.all([fetch(`/api/finance?boardId=${encodeURIComponent(invoiceBoardId)}&view=invoices`), fetch(`/api/finance?boardId=${encodeURIComponent(invoiceBoardId)}&view=customers`), fetch(`/api/finance?boardId=${encodeURIComponent(invoiceBoardId)}&view=credit-notes`)]); const data = await res.json(); const customerData = await customers.json(); const creditData=await creditRes.json(); invoiceRows = data.data || []; const creditRows=creditData.data||[]; const customerRows=customerData.data||[]; document.querySelector('#invoice-account-id').innerHTML=customerRows.length?customerRows.map(x=>`<option value="${invoiceEsc(x.id)}">${invoiceEsc(x.company_name)}${x.org_number?` · ${invoiceEsc(x.org_number)}`:''}</option>`).join(''):'<option value="">Opprett kunde først</option>'; const today = new Date().toISOString().slice(0,10); const restOf=x=>Math.max(0,Number(x.total_minor||0)-Number(x.paid_minor||0)-Number(x.credited_minor||0)); const openRows=invoiceRows.filter(x=>!['cancelled'].includes(x.status)&&restOf(x)>0); const outstanding=openRows.reduce((sum,x)=>sum+restOf(x),0); const overdue=openRows.filter(x=>x.due_date && x.due_date<today).reduce((sum,x)=>sum+restOf(x),0); document.querySelector('#invoice-summary').innerHTML=`<div><span>Åpne fakturaer</span><strong>${openRows.length}</strong></div><div><span>Utestående</span><strong>${invoiceMoney(outstanding)}</strong></div><div><span>Forfalt</span><strong>${invoiceMoney(overdue)}</strong></div>`; const list = document.querySelector('#sales-invoice-list'); list.innerHTML = invoiceRows.map(x => { const paid=Number(x.paid_minor||0), credited=Number(x.credited_minor||0), total=Number(x.total_minor||0), rest=restOf(x), due=x.due_date && x.due_date<today && rest>0; return `<article><div><strong>${invoiceEsc(x.invoice_number)} · ${invoiceEsc(x.company_name || 'Kunde ikke satt')}</strong><p>${invoiceEsc(x.description || 'Ingen beskrivelse')} · ${x.line_count||0} linjer · forfall ${invoiceEsc(x.due_date || 'ikke satt')} · betalt ${invoiceMoney(paid)}${credited?` · kreditert ${invoiceMoney(credited)}`:''}${rest>0?` · rest ${invoiceMoney(rest)}`:''}</p></div><b>${invoiceMoney(total)}</b><span class="status-${invoiceEsc(due?'overdue':rest===0?'paid':x.status)}">${invoiceEsc(invoiceStatusLabel(due?'overdue':rest===0?'paid':x.status))}</span><button type="button" class="invoice-open" data-invoice-id="${invoiceEsc(x.id)}">Vis detaljer</button></article>`; }).join('') || '<p>Ingen fakturaer registrert ennå.</p>'; list.querySelectorAll('.invoice-open').forEach(button=>button.addEventListener('click',()=>showInvoiceDetail(button.dataset.invoiceId))); const fill=(id,statuses,empty,extraFilter=()=>true)=>{const el=document.querySelector(id); const rows=invoiceRows.filter(x=>statuses.includes(x.status)&&extraFilter(x)); el.innerHTML=rows.length?rows.map(x=>`<option value="${invoiceEsc(x.id)}">${invoiceEsc(x.invoice_number)} · ${invoiceMoney(restOf(x)||x.total_minor)} · ${invoiceEsc(invoiceStatusLabel(x.status))}</option>`).join(''):`<option value="">${empty}</option>`; el.disabled=!rows.length; el.closest('form')?.querySelector('button[type="submit"]')?.toggleAttribute('disabled',!rows.length);}; fill('#invoice-review-id',['draft'],'Ingen utkast'); fill('#invoice-approve-id',['review'],'Ingen fakturaer til godkjenning'); fill('#invoice-payment-id',['approved','sent','overdue'],'Ingen åpne fakturaer',x=>restOf(x)>0); fill('#invoice-credit-id',['approved','sent','overdue','paid'],'Ingen fakturaer med krediterbar saldo',x=>Math.max(0,Number(x.total_minor||0)-Number(x.reserved_credit_minor||0))>0); const fillCredits=(id,statuses,empty)=>{const el=document.querySelector(id); const rows=creditRows.filter(x=>statuses.includes(x.status)); el.innerHTML=rows.length?rows.map(x=>`<option value="${invoiceEsc(x.id)}">${invoiceEsc(x.credit_note_number)} · ${invoiceMoney(x.total_minor)} · ${invoiceEsc(invoiceStat