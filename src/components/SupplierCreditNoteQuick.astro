<section class="supplier-credit-note" aria-labelledby="supplier-credit-note-title">
  <div class="supplier-credit-note-head"><div><span class="section-kicker">Leverandørkreditnota · regnskap</span><h2 id="supplier-credit-note-title">Få med prisavslag og returer.</h2><p>Registrer kreditnota mot en godkjent leverandørfaktura. Styr.ing holder saldoen korrekt og krever kontroll før bokføring.</p></div><span class="supplier-credit-boundary">Ingen automatisk bokføring</span></div>
  <div class="supplier-credit-grid">
    <form data-supplier-credit-action="create_credit_note"><h3>1. Registrer kreditnota</h3><label>Leverandørfaktura<select name="supplierInvoiceId" id="supplier-credit-invoice" required><option value="">Henter fakturaer…</option></select></label><label>Kreditnotanummer<input name="creditNoteNumber" maxlength="80" required placeholder="KN-2026-001" /></label><label>Dato<input name="issueDate" type="date" required /></label><label>Beskrivelse<input name="description" maxlength="240" required placeholder="Prisavslag eller retur" /></label><div class="supplier-credit-row"><label>Netto<input name="amount" type="number" min="0.01" step="0.01" required /></label><label>Inngående MVA<input name="vat" type="number" min="0" step="0.01" value="0" required /></label></div><button type="submit">Opprett utkast</button></form>
    <form data-supplier-credit-action="review_credit_note"><h3>2. Send til kontroll</h3><label>Kreditnota<select name="supplierCreditNoteId" id="supplier-credit-review" required><option value="">Henter utkast…</option></select></label><button type="submit">Send til kontroll</button></form>
    <form data-supplier-credit-action="approve_credit_note"><h3>3. Godkjenn grunnlag</h3><label>Kreditnota<select name="supplierCreditNoteId" id="supplier-credit-approve" required><option value="">Henter til godkjenning…</option></select></label><button type="submit">Godkjenn kreditnota</button></form>
  </div>
  <div id="supplier-credit-list" class="supplier-credit-list"><p>Henter leverandørkreditnotaer…</p></div><p id="supplier-credit-status" class="supplier-credit-status" role="status" aria-live="polite"></p>
</section>
<script is:inline>
  (() => {
    const esc = (v) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
    const money = (v) => `${(Number(v || 0) / 100).toLocaleString('nb-NO')} kr`;
    let board = new URLSearchParams(location.search).get('boardId') || ''; let invoices = []; let notes = [];
    const status = document.querySelector('#supplier-credit-status');
    const api = async (url, options) => { const response = await fetch(url, options); const data = await response.json(); if (!response.ok) throw new Error(data.detail || data.error || 'Kunne ikke hente leverandørkreditnotaer'); return data; };
    const resolve = async () => { if (board) return board; try { board = (await (await fetch('/api/auth')).json()).boards?.[0]?.id || ''; } catch {} return board; };
    const fill = (id, rows, empty) => { const select = document.querySelector(id); if (!select) return; select.innerHTML = rows.length ? rows.map((x) => `<option value="${esc(x.id)}">${esc(x.credit_note_number)} · ${money(x.total_minor)} · ${esc(x.invoice_number || '')}</option>`).join('') : `<option value="">${empty}</option>`; select.disabled = !rows.length; select.closest('form')?.querySelector('button[type="submit"]')?.toggleAttribute('disabled', !rows.length); };
    const render = () => { fill('#supplier-credit-invoice', invoices.filter((x) => ['approved','booked','paid'].includes(x.status) && Number(x.amount_minor || 0) - Number(x.paid_minor || 0) > 0), 'Ingen godkjente fakturaer med saldo'); fill('#supplier-credit-review', notes.filter((x) => x.status === 'draft'), 'Ingen utkast'); fill('#supplier-credit-approve', notes.filter((x) => x.status === 'review'), 'Ingen kreditnotaer til godkjenning'); const list = document.querySelector('#supplier-credit-list'); list.innerHTML = notes.length ? notes.map((x) => `<article><div><strong>${esc(x.credit_note_number)} · ${esc(x.supplier_party_name || x.supplier_name)}</strong><small>Mot ${esc(x.invoice_number)} · ${money(x.total_minor)} · ${esc(x.issue_date)}</small></div><span>${esc({draft:'Utkast',review:'Til kontroll',approved:'Godkjent',posted:'Bokført',cancelled:'Kansellert'}[x.status] || x.status)}</span></article>`).join('') : '<p>Ingen leverandørkreditnotaer registrert ennå.</p>'; };
    const load = async () => { await resolve(); if (!board) throw new Error('Ingen virksomhet valgt'); const [invoiceData, noteData] = await Promise.all([api(`/api/procurement?boardId=${encodeURIComponent(board)}&view=invoices`), api(`/api/procurement?boardId=${encodeURIComponent(board)}&view=credit-notes`)]); invoices = invoiceData.data || []; notes = noteData.data || []; render(); };
    document.querySelectorAll('[data-supplier-credit-action]').forEach((form) => form.addEventListener('submit', async (event) => { event.preventDefault(); const data = Object.fromEntries(new FormData(form)); const action = form.dataset.supplierCreditAction; if (action === 'create_credit_note') { data.amountMinor = Math.round(Number(data.amount || 0) * 100); data.vatMinor = Math.round(Number(data.vat || 0) * 100); delete data.amount; delete data.vat; data.currency = 'NOK'; } data.boardId = board; data.action = action; status.textContent = 'Lagrer og logger kontrollspor…'; try { await api('/api/procurement', { method:'POST', headers:{'content-type':'application/json'}, body:JSON.stringify(data) }); status.textContent = '✓ Handlingen er registrert. Neste kontrollsteg er klart.'; form.reset(); await load(); } catch (error) { status.textContent = `Kunne ikke lagre: ${error.message}`; } }));
    load().catch((error) => { status.textContent = error.message; });
  })();
</script>
<style>
  .supplier-credit-note{margin:18px 0;padding:24px;border:1px solid rgba(16,36,31,.1);border-radius:18px;background:#fff8e5}.supplier-credit-note-head{display:flex;justify-content:space-between;gap:20px}.supplier-credit-note h2{margin:8px 0;font:500 1.8rem/1 Georgia,serif}.supplier-credit-note p{max-width:700px;color:var(--muted);font:.8rem/1.5 system-ui,sans-serif}.supplier-credit-boundary{height:max-content;padding:8px 10px;border-radius:999px;background:#fff2c9;color:#765a10;font:700 .62rem/1 system-ui,sans-serif;white-space:nowrap}.supplier-credit-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:10px;margin-top:18px}.supplier-credit-grid form{display:grid;gap:8px;padding:15px;border:1px solid rgba(16,36,31,.1);border-radius:12px;background:#fff}.supplier-credit-grid h3{margin:0;font:700 .78rem/1.2 system-ui,sans-serif}.supplier-credit-grid label{display:grid;gap:4px;color:var(--muted);font:600 .63rem/1.2 system-ui,sans-serif}.supplier-credit-grid input,.supplier-credit-grid select{width:100%;box-sizing:border-box;padding:8px;border:1px solid rgba(16,36,31,.15);border-radius:8px;background:#fff;font:.72rem system-ui,sans-serif}.supplier-credit-row{display:grid;grid-template-columns:1fr 1fr;gap:7px}.supplier-credit-grid button{padding:9px;border:0;border-radius:8px;background:#28624c;color:#fff;cursor:pointer;font:700 .67rem/1 system-ui,sans-serif}.supplier-credit-grid button:disabled{opacity:.45;cursor:not-allowed}.supplier-credit-list{display:grid;gap:7px;margin-top:12px}.supplier-credit-list article{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:center;padding:11px 13px;border:1px solid rgba(16,36,31,.1);border-radius:9px;background:#fff;font:.72rem system-ui,sans-serif}.supplier-credit-list strong,.supplier-credit-list small{display:block}.supplier-credit-list small{margin-top:4px;color:var(--muted);font-size:.63rem}.supplier-credit-list span{color:#28624c;font-weight:700;font-size:.64rem}.supplier-credit-status{min-height:1.2em;margin:12px 0 0;color:#28624c;font:700 .7rem/1.35 system-ui,sans-serif}@media(max-width:850px){.supplier-credit-grid{grid-template-columns:1fr 1fr}}@media(max-width:560px){.supplier-credit-note{padding:18px}.supplier-credit-note-head{display:block}.supplier-credit-boundary{display:inline-flex;margin-top:10px}.supplier-credit-grid{grid-template-columns:1fr}.supplier-credit-row{grid-template-columns:1fr}}
</style>
