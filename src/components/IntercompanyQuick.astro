<section class="ic-quick" aria-labelledby="ic-title">
  <div class="ic-head"><div><span class="section-kicker">Konsern · kontrollert bokføring</span><h2 id="ic-title">Speilpostering mellom selskaper</h2><p>Forbered mellomværendet, kontroller beløpet og velg kontoene som skal brukes i målselskapet. Først ved godkjenning opprettes et balansert bilag.</p></div><span>To trinn · auditert</span></div>
  <div class="ic-grid">
    <form id="ic-prepare-form"><h3>1. Forbered</h3><div class="two"><label>Fra selskap<input name="sourceEntity" required maxlength="120" placeholder="Holding AS" /></label><label>Til selskap<input name="targetEntity" required maxlength="120" placeholder="Drift AS" /></label></div><label>Referanse<input name="reference" required maxlength="120" placeholder="Management fee august" /></label><div class="two"><label>Periode<input name="period" required pattern="\d{4}-(0[1-9]|1[0-2])" placeholder="2026-08" /></label><label>Beløp (kr)<input name="amount" required type="number" min="0.01" step="0.01" /></label></div><button type="submit">Legg til kontroll</button></form>
    <form id="ic-approve-form"><h3>2. Kontroller og bokfør</h3><label>Åpen speilpostering<select name="postingId" id="ic-posting" required><option value="">Henter åpne poster…</option></select></label><div class="two"><label>Debetkonto<select name="debitAccountId" id="ic-debit" required><option value="">Velg konto…</option></select></label><label>Kreditkonto<select name="creditAccountId" id="ic-credit" required><option value="">Velg konto…</option></select></label></div><p class="ic-note">Bokføringsdato settes til første dag i valgt periode. Låst periode og ugyldige kontoer stoppes.</p><button type="submit">Godkjenn og bokfør</button></form>
  </div>
  <div id="ic-list" class="ic-list"><p>Henter mellomværender…</p></div><p id="ic-status" class="ic-status" role="status" aria-live="polite"></p>
</section>
<script is:inline>
  const icEsc=v=>String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c])); const icMoney=v=>(Number(v||0)/100).toLocaleString('nb-NO',{style:'currency',currency:'NOK'}); let icBoard='';
  const icFetch=async(url,options)=>{const r=await fetch(url,options),d=await r.json();if(!r.ok)throw new Error(d.error||'Handlingen kunne ikke gjennomføres');return d;};
  const icLoad=async()=>{if(!icBoard){const auth=await icFetch('/api/auth');icBoard=auth.boards?.[0]?.id||'';}if(!icBoard)throw new Error('Ingen virksomhet valgt');const [postings,accounts]=await Promise.all([icFetch(`/api/finance?boardId=${encodeURIComponent(icBoard)}&view=intercompany`),icFetch(`/api/finance?boardId=${encodeURIComponent(icBoard)}&view=accounts`)]);const rows=postings.data||[],open=rows.filter(x=>['prepared','review'].includes(x.status)),opts=(accounts.data||[]).filter(x=>x.active!==0).map(x=>`<option value="${icEsc(x.id)}">${icEsc(x.code)} · ${icEsc(x.name)}</option>`).join('');document.querySelector('#ic-debit').innerHTML='<option value="">Velg konto…</option>'+opts;document.querySelector('#ic-credit').innerHTML='<option value="">Velg konto…</option>'+opts;document.querySelector('#ic-posting').innerHTML=open.length?open.map(x=>`<option value="${icEsc(x.id)}">${icEsc(x.reference)} · ${icMoney(x.amount_minor)} · ${icEsc(x.period)}</option>`).join(''):'<option value="">Ingen åpne poster</option>';document.querySelector('#ic-list').innerHTML=rows.length?rows.slice(0,8).map(x=>`<article><span><strong>${icEsc(x.reference)}</strong><small>${icEsc(x.source_entity)} → ${icEsc(x.target_entity)} · ${icEsc(x.period)}</small></span><b>${icMoney(x.amount_minor)}</b><em>${x.status==='mirrored'?`Bokført${x.target_voucher_id?' · bilag opprettet':''}`:'Til kontroll'}</em></article>`).join(''):'<p>Ingen speilposteringer registrert.</p>';};
  const icPost=async(payload,button)=>{button.disabled=true;document.querySelector('#ic-status').textContent='Lagrer kontrollspor…';try{const d=await icFetch('/api/finance',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({boardId:icBoard,...payload})});document.querySelector('#ic-status').textContent=d.targetVoucherNumber?`✓ Speilposteringen er bokført som bilag ${d.targetVoucherNumber}.`:'✓ Speilposteringen er klar for kontroll.';await icLoad();}catch(e){document.querySelector('#ic-status').textContent=e.message;}finally{button.disabled=false;}};
  document.querySelector('#ic-prepare-form')?.addEventListener('submit',e=>{e.preventDefault();const f=new FormData(e.currentTarget);icPost({action:'prepare_intercompany',sourceEntity:f.get('sourceEntity'),targetEntity:f.get('targetEntity'),reference:f.get('reference'),period:f.get('period'),amountMinor:Math.round(Number(f.get('amount'))*100),currency:'NOK'},e.currentTarget.querySelector('button'));});
  document.querySelector('#ic-approve-form')?.addEventListener('submit',e=>{e.preventDefault();const f=new FormData(e.currentTarget);icPost({action:'approve_intercompany',postingId:f.get('postingId'),debitAccountId:f.get('debitAccountId'),creditAccountId:f.get('creditAccountId')},e.currentTarget.querySelector('button'));});
  icLoad().catch(e=>document.querySelector('#ic-status').textContent=e.message);
</script>
<style>
  .ic-quick{margin:18px 0;padding:24px;border:1px solid rgba(16,36,31,.1);border-radius:18px;background:#fff}.ic-head{display:flex;justify-content:space-between;gap:20px}.ic-head h2{margin:8px 0;font:500 1.8rem/1 Georgia,serif}.ic-head p{max-width:720px;color:var(--muted);font:.8rem/1.5 system-ui,sans-serif}.ic-head>span{height:max-content;padding:8px 10px;border-radius:999px;background:#e8f1df;color:#28624c;font:700 .62rem/1 system-ui,sans-serif;white-space:nowrap}.ic-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:18px}.ic-grid form{display:grid;gap:10px;padding:16px;border-radius:13px;background:#f5f8f5}.ic-grid h3{margin:0;font:700 .8rem/1.2 system-ui,sans-serif}.ic-grid label{display:grid;gap:5px;color:var(--muted);font:600 .62rem/1.2 system-ui,sans-serif}.ic-grid input,.ic-grid select{width:100%;padding:9px;border:1px solid rgba(16,36,31,.15);border-radius:8px;background:#fff;font:.72rem system-ui,sans-serif}.two{display:grid;grid-template-columns:1fr 1fr;gap:8px}.ic-grid button{justify-self:start;padding:10px 13px;border:0;border-radius:8px;background:#10241f;color:#fff;cursor:pointer;font:700 .67rem/1 system-ui,sans-serif}.ic-grid button:disabled{opacity:.55}.ic-note{margin:0;color:var(--muted);font:.64rem/1.45 system-ui,sans-serif}.ic-list{display:grid;margin-top:14px}.ic-list article{display:grid;grid-template-columns:1fr auto auto;align-items:center;gap:14px;padding:12px 2px;border-top:1px solid rgba(16,36,31,.08)}.ic-list span{display:grid;gap:4px}.ic-list strong{font:700 .75rem system-ui,sans-serif}.ic-list small,.ic-list em,.ic-list p{color:var(--muted);font:.64rem/1.35 system-ui,sans-serif}.ic-list b{font:600 .72rem system-ui,sans-serif}.ic-list em{font-style:normal}.ic-status{min-height:1.2em;color:#27643f;font:700 .68rem/1.4 system-ui,sans-serif}@media(max-width:760px){.ic-grid{grid-template-columns:1fr}.ic-head{flex-direction:column}.ic-list article{grid-template-columns:1fr auto}.ic-list em{grid-column:1/-1}}@media(max-width:480px){.ic-quick{padding:17px}.two{grid-template-columns:1fr}}
</style>
