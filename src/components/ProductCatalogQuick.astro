<section class="product-catalog-quick" aria-labelledby="product-catalog-title">
  <div class="product-catalog-head"><div><span class="section-kicker">Regnskapskjerne · register</span><h2 id="product-catalog-title">Varer og tjenester du fakturerer ofte.</h2><p>Valgfritt register for faste leveranser. Lagre pris og MVA én gang, og hent dem inn i fakturautkast når det passer.</p></div><span class="product-catalog-boundary">Intern · ingen utsending</span></div>
  <div class="product-catalog-grid">
    <form id="product-catalog-form"><h3>Ny vare eller tjeneste</h3><label>Navn<input name="name" maxlength="160" required placeholder="Rådgivning" /></label><label>Varenummer (valgfritt)<input name="sku" maxlength="80" placeholder="RAD-001" /></label><div class="product-catalog-row"><label>Pris per enhet (kr)<input name="unitPrice" type="number" min="0" step="0.01" required placeholder="1250" /></label><label>MVA<select name="vatRate"><option value="0">Ingen MVA</option><option value="12">12 %</option><option value="15">15 %</option><option value="25" selected>25 %</option></select></label></div><label>Beskrivelse (valgfritt)<input name="description" maxlength="500" placeholder="Kort beskrivelse" /></label><button type="submit">Lagre i registeret</button></form>
    <div><h3>Registrerte varer og tjenester</h3><p class="product-catalog-help">Registeret gjelder bare denne virksomheten. Historiske fakturaer endres ikke når en vare oppdateres.</p><div id="product-catalog-list" class="product-catalog-list"><p>Henter registeret…</p></div></div>
  </div>
  <p id="product-catalog-status" class="product-catalog-status" role="status" aria-live="polite"></p>
  <form id="product-edit-form" class="product-edit-form" hidden><h3>Rediger vare eller tjeneste</h3><input type="hidden" name="productId" /><div class="product-catalog-row"><label>Navn<input name="name" maxlength="160" required /></label><label>Varenummer<input name="sku" maxlength="80" /></label></div><div class="product-catalog-row"><label>Pris per enhet (kr)<input name="unitPrice" type="number" min="0" step="0.01" required /></label><label>MVA<select name="vatRate"><option value="0">Ingen MVA</option><option value="12">12 %</option><option value="15">15 %</option><option value="25">25 %</option></select></label></div><label>Beskrivelse<input name="description" maxlength="500" /></label><label class="product-edit-active"><input name="active" type="checkbox" checked /> Aktiv i registeret</label><div><button type="submit">Oppdater</button><button type="button" id="product-edit-cancel">Avbryt</button></div></form>
</section>
<script is:inline>
  (() => {
    const esc = value => String(value ?? '').replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
    const money = value => `${(Number(value || 0) / 100).toLocaleString('nb-NO', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} kr`;
    const query = new URLSearchParams(location.search); let boardId = query.get('boardId') || '';
    const list = document.querySelector('#product-catalog-list'); const status = document.querySelector('#product-catalog-status'); const editForm = document.querySelector('#product-edit-form');
    const resolveBoard = async () => { if (boardId) return boardId; try { const auth = await (await fetch('/api/auth')).json(); boardId = auth.boards?.[0]?.id || ''; } catch {} return boardId || (location.pathname.startsWith('/finance') ? 'board-1' : ''); };
    const openEdit = row => { if (!editForm) return; editForm.hidden = false; editForm.elements.namedItem('productId').value = row.id; editForm.elements.namedItem('name').value = row.name || ''; editForm.elements.namedItem('sku').value = row.sku || ''; editForm.elements.namedItem('unitPrice').value = (Number(row.unit_price_minor || 0) / 100).toFixed(2); editForm.elements.namedItem('vatRate').value = String(row.vat_rate ?? 25); editForm.elements.namedItem('description').value = row.description || ''; editForm.elements.namedItem('active').checked = Number(row.active) !== 0; const account = editForm.elements.namedItem('revenueAccountId'); if (account) { account.dataset.selected = row.revenue_account_id || ''; account.innerHTML = `<option value="">Ingen fast inntektskonto</option>`; } editForm.scrollIntoView({ behavior: 'smooth', block: 'center' }); };
    const load = async () => { await resolveBoard(); if (!boardId || !list) return; try { const response = await fetch(`/api/finance?boardId=${encodeURIComponent(boardId)}&view=products`); const payload = await response.json(); if (!response.ok) throw new Error(payload.error || 'Kunne ikke hente registeret'); const rows = payload.data || []; list.innerHTML = rows.length ? rows.map(row => `<article class="product-catalog-item"><div><strong>${esc(row.name)}</strong><small>${row.sku ? `${esc(row.sku)} · ` : ''}${money(row.unit_price_minor)} · MVA ${esc(row.vat_rate)} %</small>${row.description ? `<p>${esc(row.description)}</p>` : ''}</div><span>${Number(row.active) ? 'Aktiv' : 'Inaktiv'}</span><button type="button" class="product-edit-trigger" data-product-id="${esc(row.id)}">Rediger</button></article>`).join('') : '<p class="product-catalog-empty">Ingen varer eller tjenester lagret ennå.</p>'; list.querySelectorAll('.product-edit-trigger').forEach(button => button.addEventListener('click', () => openEdit(rows.find(row => row.id === button.dataset.productId)))); } catch (error) { list.innerHTML = '<p class="product-catalog-empty">Registeret kunne ikke lastes.</p>'; } };
    const saveProduct = async (event, action) => { event.preventDefault(); await resolveBoard(); const fields = new FormData(event.currentTarget); const payload = Object.fromEntries(fields); payload.boardId = boardId; payload.action = action; payload.unitPriceMinor = Math.round(Number(fields.get('unitPrice') || 0) * 100); payload.active = fields.get('active') === 'on'; delete payload.unitPrice; status.textContent = action === 'create_product' ? 'Lagrer…' : 'Oppdaterer…'; try { const response = await fetch('/api/finance', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload) }); const result = await response.json(); if (!response.ok) throw new Error(result.detail || result.error || 'Kunne ikke lagre'); status.textContent = action === 'create_product' ? '✓ Lagret i produktregisteret.' : '✓ Produktet er oppdatert.'; event.currentTarget.reset(); if (editForm) editForm.hidden = true; await load(); } catch (error) { status.textContent = `Kunne ikke lagre: ${error.message}`; } };
    document.querySelector('#product-catalog-form')?.addEventListener('submit', event => saveProduct(event, 'create_product'));
    editForm?.addEventListener('submit', event => saveProduct(event, 'update_product')); document.querySelector('#product-edit-cancel')?.addEventListener('click', () => { editForm.hidden = true; });
    load();
  })();
</script>
<script is:inline>
  (() => {
    let catalogAccounts = []; let catalogProducts = []; let catalogBoard = new URLSearchParams(location.search).get('boardId') || '';
    const catalogEsc = value => String(value ?? '').replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
    const catalogResolve = async () => { if (catalogBoard) return; try { const auth = await (await fetch('/api/auth')).json(); catalogBoard = auth.boards?.[0]?.id || ''; } catch {} if (!catalogBoard && location.pathname.startsWith('/finance')) catalogBoard = 'board-1'; };
    const catalogOptions = selected => '<option value="">Ingen fast inntektskonto</option>' + catalogAccounts.filter(account => Number(account.active) !== 0 && account.account_type === 'revenue').map(account => `<option value="${catalogEsc(account.id)}" ${account.id === selected ? 'selected' : ''}>${catalogEsc(account.code)} · ${catalogEsc(account.name)}</option>`).join('');
    const catalogInject = () => { const create = document.querySelector('#product-catalog-form'); const edit = document.querySelector('#product-edit-form'); if (create && !create.elements.namedItem('revenueAccountId')) create.querySelector('button[type="submit"]')?.insertAdjacentHTML('beforebegin', `<label>Inntektskonto (valgfritt)<select name="revenueAccountId" id="product-revenue-account">${catalogOptions('')}</select><small>Foreslås ved bokføring av fakturalinjen.</small></label>`); if (edit && !edit.elements.namedItem('revenueAccountId')) edit.querySelector('.product-edit-active')?.insertAdjacentHTML('beforebegin', `<label>Inntektskonto (valgfritt)<select name="revenueAccountId" id="product-edit-revenue-account">${catalogOptions('')}</select></label>`); };
    document.querySelector('#product-catalog-list')?.addEventListener('click', event => { const button = event.target.closest('.product-edit-trigger'); if (!button) return; const product = catalogProducts.find(row => row.id === button.dataset.productId); const select = document.querySelector('#product-edit-revenue-account'); if (select) select.innerHTML = catalogOptions(product?.revenue_account_id || ''); });
    const catalogLoad = async () => { await catalogResolve(); if (!catalogBoard) return; try { const [accounts, products] = await Promise.all([fetch(`/api/finance?boardId=${encodeURIComponent(catalogBoard)}&view=accounts`).then(response => response.json()), fetch(`/api/finance?boardId=${encodeURIComponent(catalogBoard)}&view=products`).then(response => response.json())]); catalogAccounts = accounts.data || []; catalogProducts = products.data || []; catalogInject(); } catch {} };
    catalogInject(); catalogLoad();
  })();
</script>
<style>
  .product-catalog-quick{margin:0 0 18px;padding:22px;border:1px solid rgba(16,36,31,.1);border-radius:18px;background:#fff}.product-catalog-head{display:flex;justify-content:space-between;gap:18px;align-items:start}.product-catalog-head h2{margin:8px 0;font:500 clamp(1.7rem,3vw,2.35rem)/1 Georgia,serif}.product-catalog-head p,.product-catalog-help{max-width:720px;color:var(--muted);font:.78rem/1.5 system-ui,sans-serif}.product-catalog-boundary{padding:8px 10px;border-radius:999px;background:#eaf2e7;color:var(--accent);font:700 .62rem/1 system-ui,sans-serif;white-space:nowrap}.product-catalog-grid{display:grid;grid-template-columns:minmax(280px,.8fr) minmax(320px,1.2fr);gap:18px;margin-top:18px}.product-catalog-grid form,.product-catalog-grid>div{padding:16px;border:1px solid rgba(16,36,31,.08);border-radius:12px;background:#f7faf6}.product-catalog-grid h3{margin:0 0 10px;font:700 .82rem/1.2 system-ui,sans-serif}.product-catalog-grid label{display:grid;gap:5px;margin-top:9px;color:var(--muted);font:600 .64rem/1.2 system-ui,sans-serif}.product-catalog-grid input,.product-catalog-grid select{width:100%;box-sizing:border-box;padding:9px;border:1px solid rgba(16,36,31,.14);border-radius:8px;background:#fff;color:var(--ink);font:.74rem system-ui,sans-serif}.product-catalog-row{display:grid;grid-template-columns:1fr 1fr;gap:8px}.product-catalog-grid button{margin-top:13px;padding:10px 13px;border:0;border-radius:8px;background:var(--accent);color:#fff;cursor:pointer;font:700 .68rem/1 system-ui,sans-serif}.product-catalog-list{display:grid;gap:7px}.product-catalog-item{display:flex;justify-content:space-between;align-items:start;gap:12px;padding:11px 12px;border:1px solid rgba(16,36,31,.08);border-radius:9px;background:#fff}.product-catalog-item strong,.product-catalog-item small,.product-catalog-item p{display:block}.product-catalog-item strong{font:700 .74rem/1.25 system-ui,sans-serif}.product-catalog-item small,.product-catalog-item p{margin-top:4px;color:var(--muted);font:.64rem/1.35 system-ui,sans-serif}.product-catalog-item span{padding:5px 7px;border-radius:999px;background:#dff2d2;color:#27643f;font:700 .58rem/1 system-ui,sans-serif;white-space:nowrap}.product-catalog-empty{color:var(--muted);font:.7rem/1.4 system-ui,sans-serif}.product-catalog-status{min-height:1.2em;margin:12px 0 0;color:var(--accent);font:700 .7rem/1.3 system-ui,sans-serif}@media(max-width:720px){.product-catalog-head{display:block}.product-catalog-boundary{display:inline-flex;margin-top:10px}.product-catalog-grid{grid-template-columns:1fr}.product-catalog-quick{padding:16px}}
</style>
<style>
  .product-edit-form{display:grid;gap:9px;margin:14px 0 0;padding:16px;border:1px solid rgba(16,36,31,.1);border-radius:12px;background:#f7faf6}.product-edit-form h3{margin:0;font:700 .82rem/1.2 system-ui,sans-serif}.product-edit-form label{display:grid;gap:5px;color:var(--muted);font:600 .64rem/1.2 system-ui,sans-serif}.product-edit-form input,.product-edit-form select{width:100%;box-sizing:border-box;padding:9px;border:1px solid rgba(16,36,31,.14);border-radius:8px;background:#fff;color:var(--ink);font:.74rem system-ui,sans-serif}.product-edit-form>div{display:flex;gap:8px}.product-edit-form button{padding:9px 12px;border:0;border-radius:8px;background:var(--accent);color:#fff;cursor:pointer;font:700 .66rem/1 system-ui,sans-serif}.product-edit-form button[type="button"]{background:#fff;color:var(--accent);border:1px solid rgba(16,36,31,.14)}.product-edit-active{display:flex!important;align-items:center;gap:7px}.product-edit-active input{width:auto}.product-edit-trigger{padding:6px 8px;border:1px solid rgba(16,36,31,.14);border-radius:7px;background:#fff;color:var(--accent);cursor:pointer;font:700 .58rem/1 system-ui,sans-serif}
</style>
