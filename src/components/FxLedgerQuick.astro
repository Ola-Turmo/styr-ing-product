<section class="fx-ledger-quick" aria-labelledby="fx-ledger-title"><div class="fx-ledger-head"><div><span class="section-kicker">Valuta · hovedbok</span><h2 id="fx-ledger-title">Bokfør godkjent agio/disagio</h2><p>Valutaforskjellen er allerede beregnet og godkjent. Velg kontoene for gevinst/tap og motkonto før bilaget opprettes.</p></div><span>HITL · påkrevd</span></div><form id="fx-ledger-form"><div class="fx-ledger-grid"><label>Godkjent vurdering<select name="fxId" id="fx-ledger-id" required><option value="">Henter…</option></select></label><label>Gevinst/tap-konto<select name="debitAccountId" id="fx-gain-account" required><option value="">Velg konto…</option></select></label><label>Motkonto<select name="creditAccountId" id="fx-counter-account" required><option value="">Velg konto…</option></select></label></div><button type="submit">Bokfør agio/disagio</button></form><p id="fx-ledger-status" class="fx-ledger-status" role="status" aria-live="polite"></p></section>
<script is:inline>
  const fxEsc=v=>String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c])); const fxMoney=v=>(Number(v||0)/100).toLocaleString('nb-NO',{style:'currency',currency:'NOK'});let fxBoard='';const fxGet=async url=>{const r=await fetch(url),d=await r.json();if(!r.ok)throw new Error(d.error||'Kunne ikke laste valutaposter');return d;};const fxLoad=async()=>{if(!fxBoard){const a=await fxGet('/api/auth');fxBoard=a.boards?.[0]?.id||'';}if(!fxBoard)throw new Error('Ingen virksomhet valgt');const [f,a]=await Promise.all([fxGet(`/api/finance?boardId=${encodeURIComponent(fxBoard)}&view=fx`),fxGet(`/api/finance?boardId=${encodeURIComponent(fxBoard)}&view=accounts`)]);const open=(f.data||[]).filter(x=>x.status==='approved'&&!x.posted_voucher_id),opts=(a.data||[]).filter(x=>x.active!==0).map(x=>`<option value="${fxEsc(x.id)}">${fxEsc(x.code)} · ${fxEsc(x.name)}</option>`).join('');document.querySelector('#fx-ledger-id').innerHTML=open.length?open.map(x=>`<option value="${fxEsc(x.id)}">${fxEsc(x.reference)} · ${fxEsc(x.currency)} · ${fxMoney(x.gain_loss_minor)}</option>`).join(''):'<option value="">Ingen godkjente valutaposter</option>';document.querySelector('#fx-gain-account').innerHTML='<option value="">Velg konto…</option>'+opts;document.querySelector('#fx-counter-account').innerHTML='<option value="">Velg konto…</option>'+opts;};document.querySelector('#fx-ledger-form')?.addEventListener('submit',async e=>{e.preventDefault();const b=e.currentTarget.querySelector('button'),s=document.querySelector('#fx-ledger-status'),f=new FormData(e.currentTarget);b.disabled=true;s.textContent='Bokfører og skriver kontrollspor…';try{const r=await fetch('/api/finance',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({boardId:fxBoard,action:'post_fx',fxId:f.get('fxId'),debitAccountId:f.get('debitAccountId'),creditAccountId:f.get('creditAccountId')})}),d=await r.json();if(!r.ok)throw new Error(d.error||'Valutaposten kunne ikke bokføres');s.textContent=`✓ Valutaposten er bokført som bilag ${d.voucherNumber}.`;await fxLoad();}catch(err){s.textContent=err.message;}finally{b.disabled=false;}});fxLoad().catch(e=>document.querySelector('#fx-ledger-status').textContent=e.message);
</script>
<style>
  .fx-ledger-quick{margin:18px 0;padding:24px;border:1px solid rgba(16,36,31,.1);border-radius:18px;background:#fff8e9}.fx-ledger-head{display:flex;justify-content:space-between;gap:20px}.fx-ledger-head h2{margin:8px 0;font:500 1.8rem/1 Georgia,serif}.fx-ledger-head p{max-width:720px;color:var(--muted);font:.8rem/1.5 system-ui,sans-serif}.fx-ledger-head>span{height:max-content;padding:8px 10px;border-radius:999px;background:#fff0c8;color:#7c621b;font:700 .62rem/1 system-ui,sans-serif;white-space:nowrap}.fx-ledger-grid{display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:9px;margin:18px 0 12px}.fx-ledger-grid label{display:grid;gap:5px;color:var(--muted);font:600 .62rem/1.2 system-ui,sans-serif}.fx-ledger-grid select{width:100%;padding:9px;border:1px solid rgba(16,36,31,.15);border-radius:8px;background:#fff;font:.72rem system-ui,sans-serif}.fx-ledger-quick button{padding:10px 13px;border:0;border-radius:8px;background:#7c621b;color:#fff;cursor:pointer;font:700 .67rem/1 system-ui,sans-serif}.fx-ledger-quick button:disabled{opacity:.55}.fx-ledger-status{min-height:1.2em;color:#7c621b;font:700 .68rem/1.4 system-ui,sans-serif}@media(max-width:760px){.fx-ledger-head{flex-direction:column}.fx-ledger-grid{grid-template-columns:1fr}}
</style>
