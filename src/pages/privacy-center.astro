---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Personvernsenter — Styr.ing" activeNav="privacy">
  <main class="privacy-shell"><section class="privacy-hero"><div><span class="eyebrow">Personvern · kontroll</span><h1>Se, eksporter,<br /><em>be om endring.</em></h1><p>Et samlet sted for datainventar, lagringstid og forespørsler. I previewen er innholdet illustrert; i en kunde-tenant knyttes det til innlogget bruker og virksomhet.</p></div><div class="privacy-orb"><span>Forespørsler</span><strong id="request-count">—</strong><small>for denne brukeren</small></div></section><section class="privacy-card"><div class="card-head"><div><span class="section-kicker">Datainventar</span><h2>Hva behandles — og hvorfor?</h2></div><a href="/api/privacy?boardId=board-1&view=inventory">API ↗</a></div><div id="inventory-list"><p class="muted">Henter oversikt…</p></div></section><section class="privacy-grid"><article class="privacy-card"><span class="section-kicker">Dine valg</span><h2>Ny forespørsel</h2><p>Forespørsler registreres med status og behandles av en autorisert person.</p><div class="privacy-actions"><button data-request="access">Be om innsyn</button><button data-request="export">Be om eksport</button><button data-request="deletion">Be om sletting</button></div><p id="privacy-status" class="muted" role="status"></p></article><article class="privacy-card"><span class="section-kicker">Lagring</span><h2>Retensjon</h2><div id="retention-list"><p class="muted">Henter retningslinjer…</p></div></article></section><p class="boundary">Forespørsler kan kreve identitetskontroll, kundeinstruks eller lovpålagt oppbevaring. Ikke legg inn nye personopplysninger i den offentlige previewen.</p></main>
</Layout>
<script is:inline>
  const esc=(v)=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); const status=document.querySelector('#privacy-status');
  fetch('/api/privacy?boardId=board-1').then(r=>r.json()).then((data)=>{const inv=data.inventory||[];document.querySelector('#request-count').textContent=(data.requests||[]).length;document.querySelector('#inventory-list').innerHTML=inv.map(x=>`<div class="privacy-row"><div><strong>${esc(x.category)}</strong><span>${esc(x.examples)}</span></div><small>${esc(x.purpose)} · ${esc(x.basis)}</small></div>`).join('');document.querySelector('#retention-list').innerHTML=(data.retention||[]).map(x=>`<div class="retention-row"><strong>${esc(x.data_category)}</strong><span>${esc(x.retention_period)}</span></div>`).join('');}).catch(()=>{status.textContent='Personvern-API utilgjengelig.'});
  document.querySelectorAll('[data-request]').forEach((button)=>button.addEventListener('click',async()=>{status.textContent='Registrerer forespørsel…';const r=await fetch('/api/privacy',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({boardId:'board-1',requestType:button.dataset.request})});const d=await r.json();status.textContent=r.ok?`Forespørsel ${d.requestId} er registrert.`:(d.error==='authenticated_board_member_required'?'Logg inn med kundeprofil for å sende forespørsel.':'Forespørselen kunne ikke registreres.');}));
</script>
<style>.privacy-shell{max-width:1150px;margin:0 auto;padding:45px 24px 80px}.privacy-hero{display:grid;grid-template-columns:1fr 240px;gap:40px;align-items:center;padding:40px;border-radius:25px;background:linear-gradient(120deg,#244b46,#3a8068);color:#fff}.eyebrow,.section-kicker{font:700 .68rem/1 system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase}.eyebrow{color:#d9ffca}.privacy-hero h1{font:500 clamp(2.6rem,5vw,4.4rem)/.94 Georgia,serif;letter-spacing:-.05em;margin:16px 0}.privacy-hero h1 em{color:#d9ffca;font-style:normal}.privacy-hero p{max-width:590px;color:rgba(255,255,255,.75);font:.9rem/1.6 system-ui,sans-serif}.privacy-orb{width:180px;height:180px;border-radius:50%;display:flex;flex-direction:column;justify-content:center;align-items:center;background:rgba(8,42,34,.35);border:1px solid rgba(217,255,202,.55);margin:auto}.privacy-orb span,.privacy-orb small{font:700 .63rem/1 system-ui,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:#c5e6c0}.privacy-orb strong{font:500 2.7rem/1 Georgia,serif;color:#f0ffe9;margin:12px 0}.privacy-card{margin-top:18px;padding:23px;border:1px solid rgba(16,36,31,.09);border-radius:16px;background:#fff}.card-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:15px}.card-head h2,.privacy-card h2{margin:8px 0 0;font:500 1.6rem/1 Georgia,serif}.card-head a{color:var(--accent);font:700 .67rem/1 system-ui,sans-serif}.privacy-row,.retention-row{display:flex;justify-content:space-between;gap:18px;padding:14px 0;border-top:1px solid rgba(16,36,31,.08);font:.75rem/1.3 system-ui,sans-serif}.privacy-row strong,.privacy-row span{display:block}.privacy-row span{color:var(--muted);margin-top:4px;font-size:.67rem}.privacy-row small,.retention-row span{color:var(--muted);font-size:.67rem}.privacy-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.privacy-card p{color:var(--muted);font:.78rem/1.55 system-ui,sans-serif}.privacy-actions{display:flex;flex-wrap:wrap;gap:8px;margin:20px 0 12px}.privacy-actions button{padding:10px 12px;border:0;border-radius:8px;background:#e8f1df;color:var(--accent);cursor:pointer;font:700 .67rem/1 system-ui,sans-serif}.muted,.boundary{color:var(--muted);font:.7rem/1.4 system-ui,sans-serif}.boundary{margin-top:15px}@media(max-width:760px){.privacy-hero{grid-template-columns:1fr;padding:28px 22px}.privacy-orb{width:155px;height:155px;margin:0}.privacy-grid{grid-template-columns:1fr}.privacy-row{flex-direction:column;gap:7px}}
</style>
