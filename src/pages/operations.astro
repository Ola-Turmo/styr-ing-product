---
import Layout from '../layouts/Layout.astro';

const tabs = [
  { key: 'people', label: 'Mennesker', kicker: 'HCM · ATS · LMS', title: 'Bygg kapasitet med samme kontekst', description: 'Se personer, kandidater, håndbok, mål og obligatorisk læring i sammenheng med virksomhetens mål.', accent: 'rose', metrics: [['Aktive personer', '3', 'fiktiv organisasjon'], ['Åpne kandidater', '1', 'intervju pågår'], ['Kurs i kø', '2', 'krever oppfølging']], actions: [['Kandidatintervju', 'Demo Kandidat · scorecard venter', 'I dag', 'Høy'], ['HMS-kurs', 'Demo CFO · kurs pågår', '31. aug', 'Normal'], ['Håndbok', 'Personalhåndbok v2.1 · 1 lesespor mangler', 'I dag', 'Normal']], link: '/people' },
  { key: 'it', label: 'IT og eiendeler', kicker: 'ITSM · MDM · SAAS', title: 'Hold verktøy og tilgang under kontroll', description: 'Koble saker, eiendeler, SaaS-fornyelser og tilgangsrevisjoner til riktig eier og livssyklus.', accent: 'blue', metrics: [['Åpne saker', '1', 'demo-sak krever oppfølging'], ['Aktive eiendeler', '2', '1 tildelt'], ['Tilgang venter', '1', 'DPO må vurdere ERP']], actions: [['Tilgangsavvik ERP', 'Kritisk sak · rolle må dokumenteres', '31. aug', 'Høy'], ['SaaS-fornyelse', 'Designverktøy · 42% utnyttelse', '15. okt', 'Normal'], ['Offboarding-kø', '3 forslag venter på godkjenning', '31. des', 'Høy']], link: '/it' },
  { key: 'finance', label: 'Finans', kicker: 'HOVEDBOK · SAF-T · EHF', title: 'Gjør tallene klare for beslutning', description: 'Følg balanserte bilag, perioder, avstemming og likviditet uten å miste kontrollsporet.', accent: 'gold', metrics: [['Avstemt hittil', '100%', 'alle demo-bilag balansert'], ['Perioder låst', '1', 'neste periode åpen'], ['Kontoplan', '5', 'aktive kontoer']], actions: [['Bilag', 'Kontorrekvisita · debet og kredit balansert', 'Postert', 'OK'], ['Terminlåsing', 'Juli er låst med kontrollspor', 'Låst', 'OK'], ['SAF‑T', 'Eksport 1.3 klar for gjennomgang', 'Klar', 'Normal']], link: '/finance' },
  { key: 'commercial', label: 'Salg', kicker: 'CRM · CPQ · SLA', title: 'La løfter bli synlige leveranser', description: 'Fra kvalifisering til godkjent tilbud, salgsrom, abonnement og kundeservice i ett spor.', accent: 'orange', metrics: [['Pipeline', '1', 'Nordic Demo AS'], ['Tilbud til godkjenning', '1', 'krever menneskelig beslutning'], ['Åpne kundesaker', '1', 'høy prioritet']], actions: [['Tilbud venter', 'Styr.ing kontrollplattform · godkjenning kreves', 'I dag', 'Høy'], ['Salgsrom', 'Nordic Demo AS · sikkerhetskrav åpne', '30. sep', 'Normal'], ['Kundesak', 'Sikkerhetskrav · svarfrist nærmer seg', 'I dag', 'Høy']], link: '/commercial' },
  { key: 'field', label: 'Flåte og FDV', kicker: 'GPS · KJØREBOK · FDV', title: 'Koble feltarbeid til kostnad', description: 'Få oversikt over kjøretøy, vedlikehold og anlegg før frister blir avvik.', accent: 'lime', metrics: [['Kjørebok komplett', '91%', '3 turer mangler'], ['Service forfaller', '2', 'neste 30 dager'], ['FDV-dokumenter', '86%', '14 mangler eier']], actions: [['EU-kontroll', 'Toyota Proace · time må bestilles', '19. juni', 'Høy'], ['Kjørebok', 'Privat tur mangler klassifisering', 'I dag', 'Normal'], ['Brannrunde', 'Kontrollpunkt B-04 mangler bildebevis', '25. juni', 'Normal']], link: '/workspace#capability-map' },
  { key: 'platform', label: 'Plattform og AI', kicker: 'EVENTS · SØK · HITL', title: 'Automatiser med et tydelig stoppunkt', description: 'La signaler finne riktig spor, men krev godkjenning før en agent gjør endringer.', accent: 'violet', metrics: [['Hendelser i kø', '42', '0 feilet'], ['Søketreff', '1,284', 'på tvers av kilder'], ['Agentforslag', '9', '3 venter på godkjenning']], actions: [['SmartGate', 'Forslag om å blokkere uautorisert PO', 'Nå', 'Høy'], ['Event mesh', 'Invoice.Paid levert til webhook', '10 min siden', 'Fullført'], ['Søkekilde', 'Nytt dokumentarkiv indekseres', 'I dag', 'Normal']], link: '/workspace#ai' },
];
---

<Layout title="Operativ cockpit" activeNav="operations">
  <main class="ops-shell">
    <section class="ops-hero">
      <div><span class="eyebrow"><i></i> Pilotselskap AS · operativ cockpit</span><h1>Fra signal.<br /><em>Til neste handling.</em></h1><p>Én oversikt for de arbeidsområdene som gjør virksomheten levende — mennesker, systemer, penger, kunder og AI.</p></div>
      <div class="pulse-card"><span class="pulse-label">Dagens signal</span><strong>7</strong><span>oppgaver bør avklares før kl. 16:00</span><div class="pulse-bar"><i></i></div><a href="#action-queue">Åpne handlingskø <span>↓</span></a></div>
    </section>

    <nav class="ops-tabs" aria-label="Operative arbeidsområder">{tabs.map((tab, index) => <button class={`ops-tab ${index === 0 ? 'active' : ''} tab-${tab.accent}`} data-tab={tab.key}><span>0{index + 1}</span>{tab.label}</button>)}</nav>

    <section class="ops-content">
      {tabs.map((tab, index) => <div class={`ops-view ${index === 0 ? 'active' : ''}`} data-view={tab.key}>
        <div class="view-intro"><span class={`view-kicker ${tab.accent}`}>{tab.kicker}</span><h2>{tab.title}</h2><p>{tab.description}</p><a class="view-link" href={tab.link}>Åpne arbeidsområde <span>↗</span></a></div>
        <div class="metric-grid">{tab.metrics.map(metric => <div class="ops-metric"><span>{metric[0]}</span><strong>{metric[1]}</strong><small>{metric[2]}</small></div>)}</div>
        <div class="view-divider"><span>Siste signaler</span><span>Illustrasjonsdata · {tab.label}</span></div>
        <div class="signal-list">{tab.actions.map((action, actionIndex) => <article class="signal-item" data-action-id={`${tab.key}-${actionIndex}`}><span class={`signal-status status-${action[3].toLowerCase()}`}></span><div><strong>{action[0]}</strong><p>{action[1]}</p></div><time>{action[2]}</time><span class="priority">{action[3]}</span><button class="signal-open" aria-label={`Marker ${action[0]} som gjennomgått`} aria-pressed="false">→</button></article>)}</div>
      </div>)}
    </section>

    <section id="action-queue" class="ops-footer"><div><span class="section-kicker">Styringssløyfen</span><h2>Hver arbeidsflate gir styret et bedre spor.</h2><p>Start i signalet, avklar ansvar, og løft bare det som trenger en beslutning.</p></div><div class="ops-footer-actions"><button id="reset-demo" class="reset-demo" type="button">Nullstill demo</button><a href="/workspace" class="ops-button">Tilbake til arbeidsflaten <span>↗</span></a><a href="/trust" class="ops-trust-link">Se tillitsmodellen <span>→</span></a></div><span class="local-note">Status lagres bare lokalt i denne nettleseren.</span></section>
  </main>
</Layout>

<script is:inline>
  const tabs = [...document.querySelectorAll('.ops-tab')];
  const views = [...document.querySelectorAll('.ops-view')];
  const storageKey = 'styring-demo-reviewed-signals';
  let reviewed = new Set();
  try { reviewed = new Set(JSON.parse(localStorage.getItem(storageKey) || '[]')); } catch { reviewed = new Set(); }
  const paintReviewed = () => document.querySelectorAll('.signal-item').forEach(item => { const id = item.dataset.actionId; const done = reviewed.has(id); item.classList.toggle('reviewed', done); const button = item.querySelector('.signal-open'); if (button) { button.textContent = done ? '✓' : '→'; button.classList.toggle('opened', done); button.setAttribute('aria-pressed', String(done)); } });
  const persist = () => { try { localStorage.setItem(storageKey, JSON.stringify([...reviewed])); } catch {} };
  tabs.forEach(tab => tab.addEventListener('click', () => { tabs.forEach(item => item.classList.remove('active')); views.forEach(view => view.classList.remove('active')); tab.classList.add('active'); document.querySelector(`[data-view="${tab.dataset.tab}"]`)?.classList.add('active'); paintReviewed(); }));
  document.querySelectorAll('.signal-open').forEach(button => button.addEventListener('click', () => { const item = button.closest('.signal-item'); const id = item?.dataset.actionId; if (!id) return; reviewed.has(id) ? reviewed.delete(id) : reviewed.add(id); persist(); paintReviewed(); }));
  document.querySelector('#reset-demo')?.addEventListener('click', () => { reviewed.clear(); persist(); paintReviewed(); });
  paintReviewed();
</script>

<style>
  .ops-shell { max-width:1180px; margin:0 auto; padding:38px 24px 80px; }.ops-hero { display:grid; grid-template-columns:1fr .55fr; gap:28px; align-items:center; padding:42px; border-radius:27px; color:#fff; background:linear-gradient(115deg,#132f28,#245c48); box-shadow:0 22px 60px rgba(16,36,31,.14); }.eyebrow { display:flex; align-items:center; gap:8px; color:#d3f5ae; font:700 .7rem/1 system-ui,sans-serif; letter-spacing:.14em; text-transform:uppercase; }.eyebrow i { width:7px; height:7px; border-radius:50%; background:#c7f47a; box-shadow:0 0 0 4px rgba(199,244,122,.16); }.ops-hero h1 { margin:20px 0 17px; font:500 clamp(2.5rem,5vw,4.3rem)/.96 Georgia,serif; letter-spacing:-.055em; }.ops-hero h1 em { color:#d0f88a; font-style:normal; }.ops-hero p { max-width:570px; margin:0; color:rgba(255,255,255,.72); font:1rem/1.6 system-ui,sans-serif; }.pulse-card { padding:22px; border:1px solid rgba(215,250,170,.36); border-radius:16px; background:rgba(6,40,30,.48); }.pulse-label { display:block; color:#b8d9bc; font:700 .65rem/1 system-ui,sans-serif; letter-spacing:.12em; text-transform:uppercase; }.pulse-card strong { display:block; margin:14px 0 5px; color:#e0fbaa; font:500 3.5rem/.9 Georgia,serif; }.pulse-card > span:not(.pulse-label) { display:block; color:#c6e3c5; font: .74rem/1.4 system-ui,sans-serif; }.pulse-bar { height:5px; overflow:hidden; margin:19px 0 15px; border-radius:999px; background:rgba(255,255,255,.14); }.pulse-bar i { display:block; width:67%; height:100%; border-radius:inherit; background:#d0f88a; }.pulse-card a { color:#e0fbaa; font:700 .73rem/1 system-ui,sans-serif; }.pulse-card a span { margin-left:8px; }.ops-tabs { display:flex; overflow:auto; gap:5px; margin:24px 0 16px; padding-bottom:4px; scrollbar-width:none; }.ops-tabs::-webkit-scrollbar { display:none; }.ops-tab { flex:1 0 auto; display:flex; align-items:center; gap:9px; padding:12px 14px; border:1px solid rgba(16,36,31,.1); border-radius:10px; background:#fff; color:var(--muted); cursor:pointer; font:700 .73rem/1 system-ui,sans-serif; }.ops-tab span { color:#a0afa5; font:700 .6rem/1 system-ui,sans-serif; letter-spacing:.1em; }.ops-tab.active { color:#fff; background:var(--night); border-color:var(--night); }.ops-tab.active span { color:#c9f584; }.ops-content { min-height:480px; }.ops-view { display:none; grid-template-columns:.75fr 1.25fr; gap:28px; padding:30px 0 15px; }.ops-view.active { display:grid; }.view-intro { grid-row:span 2; align-self:start; }.view-kicker { display:inline-block; padding:6px 8px; border-radius:999px; background:#edf2ee; font:700 .62rem/1 system-ui,sans-serif; letter-spacing:.08em; }.view-kicker.rose { color:#ad607c; background:#f9edf2; }.view-kicker.blue { color:#3974a1; background:#edf5fb; }.view-kicker.gold { color:#9d761f; background:#fff4dd; }.view-kicker.orange { color:#b66f32; background:#fff0e4; }.view-kicker.lime { color:#6f8f38; background:#f1f6e6; }.view-kicker.violet { color:#726bb3; background:#f0eefb; }.view-intro h2 { margin:17px 0 10px; color:var(--ink); font:500 2.25rem/1.02 Georgia,serif; letter-spacing:-.045em; }.view-intro p { max-width:300px; margin:0 0 20px; color:var(--muted); font: .82rem/1.55 system-ui,sans-serif; }.view-link { color:var(--accent); font:700 .75rem/1 system-ui,sans-serif; }.view-link span { margin-left:8px; }.metric-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; }.ops-metric { min-height:112px; display:flex; flex-direction:column; justify-content:space-between; padding:15px; border:1px solid rgba(16,36,31,.09); border-radius:13px; background:#fff; }.ops-metric span,.ops-metric small { color:var(--muted); font:600 .65rem/1.25 system-ui,sans-serif; }.ops-metric strong { color:var(--ink); font:500 1.7rem/.9 Georgia,serif; }.ops-metric small { color:#3d9867; font-weight:500; }.view-divider { display:flex; justify-content:space-between; align-items:center; margin-top:24px; padding-bottom:9px; border-bottom:1px solid rgba(16,36,31,.11); color:var(--muted); font:700 .65rem/1 system-ui,sans-serif; letter-spacing:.08em; text-transform:uppercase; }.view-divider span:last-child { font-weight:500; letter-spacing:0; text-transform:none; }.signal-list { grid-column:2; }.signal-item { display:grid; grid-template-columns:10px 1fr auto auto 28px; align-items:center; gap:12px; padding:14px 5px; border-bottom:1px solid rgba(16,36,31,.08); }.signal-item.reviewed { opacity:.52; }.signal-status { width:8px; height:8px; border-radius:50%; background:#d49731; }.status-høy { background:#cd6e5b; }.status-normal { background:#d49731; }.status-fullført { background:#4eaa78; }.signal-item strong { color:var(--ink); font:600 .8rem/1.2 system-ui,sans-serif; }.signal-item p { margin:4px 0 0; color:var(--muted); font: .7rem/1.35 system-ui,sans-serif; }.signal-item time { color:var(--muted); white-space:nowrap; font: .68rem/1 system-ui,sans-serif; }.priority { padding:5px 7px; border-radius:999px; color:var(--muted); background:#f0f3f0; font:600 .6rem/1 system-ui,sans-serif; }.signal-open { width:25px; height:25px; border:1px solid rgba(16,36,31,.12); border-radius:7px; background:#fff; color:var(--accent); cursor:pointer; }.signal-open:hover,.signal-open.opened { color:#fff; background:var(--accent); border-color:var(--accent); }.ops-footer { display:flex; justify-content:space-between; align-items:center; gap:20px; margin-top:55px; padding:29px 32px; border-radius:18px; color:#fff; background:var(--night); position:relative; }.section-kicker { color:#c9f584; font:700 .68rem/1 system-ui,sans-serif; letter-spacing:.14em; text-transform:uppercase; }.ops-footer h2 { margin:9px 0 7px; font:500 1.8rem/1.05 Georgia,serif; letter-spacing:-.04em; }.ops-footer p { margin:0; color:#b9d6bf; font: .78rem/1.4 system-ui,sans-serif; }.ops-footer-actions { display:flex; align-items:center; gap:17px; }.reset-demo { padding:7px 9px; border:1px solid rgba(213,251,152,.28); border-radius:8px; background:transparent; color:#c7e8c0; cursor:pointer; font:600 .65rem/1 system-ui,sans-serif; }.reset-demo:hover { color:#fff; border-color:#d5fb98; }.local-note { position:absolute; right:32px; bottom:8px; color:#7fa78a; font: .58rem/1 system-ui,sans-serif; }.ops-button { display:inline-flex; align-items:center; gap:12px; padding:12px 15px; border-radius:10px; color:#16352b; background:#d5fb98; white-space:nowrap; font:700 .75rem/1 system-ui,sans-serif; }.ops-button:hover { color:#16352b; background:#e7ffbf; }.ops-trust-link { color:#d5f3ad; font:700 .7rem/1 system-ui,sans-serif; white-space:nowrap; }.ops-trust-link span { margin-left:6px; }
  @media (max-width:840px) { .ops-hero { grid-template-columns:1fr; padding:30px 25px; }.ops-view { grid-template-columns:1fr; }.view-intro { grid-row:auto; }.signal-list { grid-column:auto; }.ops-footer { align-items:flex-start; flex-direction:column; } }
  @media (max-width:560px) { .ops-shell { padding:20px 15px 55px; }.ops-hero { padding:27px 22px; border-radius:21px; }.ops-hero h1 { font-size:2.7rem; }.ops-tabs { margin-top:19px; }.ops-tab { padding:11px 12px; }.metric-grid { grid-template-columns:1fr; }.signal-item { grid-template-columns:9px 1fr auto 28px; gap:9px; }.signal-item time { grid-column:2; grid-row:2; }.priority { display:none; }.ops-footer { padding:24px 20px 42px; }.ops-footer h2 { font-size:1.55rem; }.ops-footer-actions { align-items:flex-start; flex-direction:column; gap:14px; }.local-note { right:auto; left:20px; bottom:16px; } }
</style>
