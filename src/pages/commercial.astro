---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Kunder og kommersielt" activeNav="commercial">
  <main class="commercial-shell">
    <section class="commercial-hero">
      <div>
        <span class="eyebrow"><i></i> Pilotselskap AS · kunder</span>
        <h1>Fra første samtale<br /><em>til trygg fornyelse.</em></h1>
        <p>Se pipeline, tilbud, salgsrom, abonnement og kundesaker i samme arbeidsflyt. Styr.ing viser neste steg — og stopper før noe sendes eller endres uten godkjenning.</p>
        <div class="hero-actions"><a class="primary-button" href="#pipeline">Se kommersiell oversikt <span>↓</span></a><a class="text-button" href="/workspace#search">Søk i kundebildet <span>↗</span></a></div>
      </div>
      <div class="hero-orbit" aria-hidden="true"><div class="orbit-ring ring-one"></div><div class="orbit-ring ring-two"></div><div class="orbit-core"><span>MRR</span><strong id="hero-mrr">—</strong><small>demo · NOK</small></div><div class="orbit-node node-one">Tilbud<br /><b id="hero-quotes">—</b> venter</div><div class="orbit-node node-two">Kundesaker<br /><b id="hero-cases">—</b> åpne</div></div>
    </section>

    <section class="metric-grid" aria-label="Kommersielle nøkkeltall">
      <article class="metric-card"><span>Pipeline</span><strong id="metric-pipeline">—</strong><small id="metric-pipeline-note">Henter…</small></article>
      <article class="metric-card"><span>Tilbud til oppfølging</span><strong id="metric-quotes">—</strong><small>godkjenning eller sending</small></article>
      <article class="metric-card"><span>Aktive salgsrom</span><strong id="metric-rooms">—</strong><small>felles handlingsplaner</small></article>
      <article class="metric-card dark"><span>Åpne kundesaker</span><strong id="metric-cases">—</strong><small id="metric-cases-note">med svar- og løsningsfrist</small></article>
    </section>

    <section id="pipeline" class="workspace-card">
      <div class="section-head"><div><span class="kicker">Kommersiell kontroll</span><h2>Én kø for vekst og leveranse</h2></div><span class="status-pill"><i></i> Demo-data · tenant-scoped</span></div>
      <nav class="commercial-tabs" aria-label="Kommersielle visninger">{[['pipeline','Pipeline'],['quotes','Tilbud'],['rooms','Salgsrom'],['subscriptions','Abonnement'],['cases','Kundeservice']].map(([key,label], index) => <button class={index === 0 ? 'active' : ''} data-view={key}>{label}</button>)}</nav>
      <div id="commercial-status" class="commercial-status" role="status">Henter kommersielle data…</div>
      <div id="commercial-list" class="commercial-list" aria-live="polite"></div>
    </section>

    <section class="guardrail"><div><span class="kicker">Trygg kommersiell flyt</span><h2>Godkjenn før du lover.</h2><p>Tilbud kan klargjøres og godkjennes i API-et. Faktisk e-post, e-signering, betaling, skatt og CRM-synkronisering krever egne produksjonsnøkler, avtaler og menneskelig bekreftelse.</p></div><div class="guardrail-steps"><span><b>01</b> Kvalifiser</span><span><b>02</b> Godkjenn</span><span><b>03</b> Send manuelt</span></div></section>
  </main>
</Layout>

<script is:inline>
  const boardId = 'board-1';
  const list = document.getElementById('commercial-list');
  const status = document.getElementById('commercial-status');
  const esc = (value) => String(value ?? '').replace(/[&<>'"]/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
  const money = (minor, currency = 'NOK') => `${new Intl.NumberFormat('nb-NO').format(Number(minor || 0) / 100)} ${currency}`;
  const labels = { prospect:'Prospekt', qualified:'Kvalifisert', proposal:'Tilbud', won:'Vunnet', lost:'Tapt', pending_approval:'Venter godkjenning', approved:'Godkjent', sent:'Sendt', active:'Aktiv', trial:'Prøveperiode', open:'Åpen', in_progress:'Pågår', waiting_customer:'Venter kunde', resolved:'Løst', closed:'Lukket' };
  const pill = (value) => `<span class="pill">${esc(labels[value] || value || '—')}</span>`;
  const render = (view, rows) => {
    if (!list) return;
    if (!rows.length) { list.innerHTML = '<div class="empty">Ingen poster i denne visningen ennå.</div>'; return; }
    const templates = {
      pipeline: (r) => `<article><div><strong>${esc(r.company_name)}</strong><p>${esc(r.next_action || 'Neste steg ikke satt')} · ${esc(r.owner_name || 'Uten eier')}</p></div>${pill(r.stage)}<b>${money(r.estimated_value_minor, r.currency)}</b></article>`,
      quotes: (r) => `<article><div><strong>${esc(r.title)}</strong><p>#${esc(r.quote_number)} · ${esc(r.company_name || 'Uten kunde')} · ${esc(r.owner_name || 'Uten eier')}</p></div>${pill(r.status)}<b>${money(r.total_minor, r.currency)}</b><small>Gyldig til ${esc(r.valid_until || '—')}</small></article>`,
      rooms: (r) => `<article><div><strong>${esc(r.name)}</strong><p>${esc(r.company_name || 'Uten kunde')} · ${esc(r.buyer_contact || 'Kontakt ikke satt')}</p></div>${pill(r.status)}<small>Utløper ${esc(r.expires_at || '—')}</small></article>`,
      subscriptions: (r) => `<article><div><strong>${esc(r.plan_name)}</strong><p>${esc(r.company_name)} · ${esc(r.interval || 'month')}</p></div>${pill(r.status)}<b>${money(r.recurring_minor, r.currency)}/mnd</b><small>Fornyes ${esc(r.renewal_date || '—')}</small></article>`,
      cases: (r) => `<article><div><strong>#${esc(r.case_number)} · ${esc(r.title)}</strong><p>${esc(r.company_name || 'Uten kunde')} · ${esc(r.assignee_name || 'Ikke tildelt')}</p></div>${pill(r.priority)}${pill(r.status)}<small>SLA: ${esc(({within_sla:'Innen frist',awaiting_first_response:'Venter første svar',first_response_breached:'Førstesvar brutt',resolution_breached:'Løsningsfrist brutt',closed:'Lukket'})[r.sla_state] || r.sla_state || 'Ikke beregnet')}</small></article>`,
    };
    list.innerHTML = rows.map(templates[view]).join('');
  };
  const load = async (view) => { if (status) status.textContent = 'Henter…'; try { const response = await fetch(`/api/commercial?boardId=${boardId}&view=${view}`); const payload = await response.json(); if (!response.ok) throw new Error(payload.error); const rows = Array.isArray(payload.data) ? payload.data : []; render(view, rows); if (status) status.textContent = `${rows.length} poster · alle neste steg er synlige`; } catch { if (status) status.textContent = 'Kommersielle data er midlertidig utilgjengelige.'; if (list) list.innerHTML = ''; } };
  const loadSummary = async () => { try { const response = await fetch(`/api/commercial?boardId=${boardId}&view=summary`); const payload = await response.json(); const d = payload.data || {}; const p = d.pipeline || {}, q = d.quotes || {}, r = d.rooms || {}, s = d.activeSubs || {}, c = d.cases || {}, b = d.slaBreaches || {}; document.getElementById('metric-pipeline').textContent = p.count ?? '0'; document.getElementById('metric-pipeline-note').textContent = money(p.value_minor, 'NOK') + ' estimert'; document.getElementById('metric-quotes').textContent = q.count ?? '0'; document.getElementById('metric-rooms').textContent = r.count ?? '0'; document.getElementById('metric-cases').textContent = c.count ?? '0'; document.getElementById('metric-cases-note').textContent = `${b.count ?? 0} SLA-brudd · svar og løsning`; document.getElementById('hero-mrr').textContent = money(s.mrr_minor, 'NOK').replace(' NOK',''); document.getElementById('hero-quotes').textContent = q.count ?? '0'; document.getElementById('hero-cases').textContent = c.count ?? '0'; } catch {} };
  document.querySelectorAll('.commercial-tabs button').forEach((button) => button.addEventListener('click', () => { document.querySelectorAll('.commercial-tabs button').forEach((item) => item.classList.remove('active')); button.classList.add('active'); load(button.dataset.view); }));
  loadSummary(); load('pipeline');
</script>

<style>
  .commercial-shell{max-width:1180px;margin:0 auto;padding:38px 24px 80px}.commercial-hero{display:grid;grid-template-columns:1fr .58fr;gap:25px;align-items:center;padding:42px;border-radius:27px;color:#fff;background:linear-gradient(120deg,#3b2820,#854c2c 60%,#c47742);box-shadow:0 22px 60px rgba(83,49,32,.16)}.eyebrow{display:flex;gap:8px;align-items:center;color:#ffe0bc;font:700 .7rem/1 system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase}.eyebrow i{width:7px;height:7px;border-radius:50%;background:#ffd096;box-shadow:0 0 0 4px rgba(255,208,150,.16)}.commercial-hero h1{margin:20px 0 16px;font:500 clamp(2.5rem,5vw,4.3rem)/.96 Georgia,serif;letter-spacing:-.055em}.commercial-hero h1 em{color:#ffd39d;font-style:normal}.commercial-hero p{max-width:600px;color:rgba(255,255,255,.76);font:1rem/1.6 system-ui,sans-serif}.hero-actions{display:flex;gap:18px;flex-wrap:wrap;margin-top:24px}.primary-button,.text-button{display:inline-flex;align-items:center;gap:12px;padding:13px 17px;border-radius:10px;font:700 .78rem/1 system-ui,sans-serif}.primary-button{background:#ffd39d;color:#3d291e}.text-button{color:#ffe1c3}.hero-orbit{position:relative;min-height:245px;display:grid;place-items:center}.orbit-ring{position:absolute;border:1px solid rgba(255,222,183,.35);border-radius:50%;transform:rotate(-18deg)}.ring-one{width:240px;height:170px}.ring-two{width:295px;height:210px;transform:rotate(32deg);border-color:rgba(255,255,255,.18)}.orbit-core{width:126px;height:126px;display:flex;flex-direction:column;align-items:center;justify-content:center;border:1px solid rgba(255,229,196,.6);border-radius:50%;background:rgba(66,37,25,.82);box-shadow:0 0 45px rgba(255,199,127,.18);z-index:2}.orbit-core span,.orbit-core small{color:#edcaaa;font:700 .58rem/1 system-ui,sans-serif;letter-spacing:.08em;text-transform:uppercase}.orbit-core strong{margin:8px 0 3px;color:#ffdcae;font:500 1.65rem/.95 Georgia,serif}.orbit-node{position:absolute;padding:9px 12px;border:1px solid rgba(255,224,190,.3);border-radius:10px;background:rgba(73,40,26,.9);color:#ffe6c8;font:600 .68rem/1.35 system-ui,sans-serif}.orbit-node b{color:#fff;font-size:.75rem}.node-one{top:12px;right:3%}.node-two{bottom:11px;left:2%}.metric-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:16px 0 52px}.metric-card{min-height:108px;padding:17px 18px;border:1px solid rgba(16,36,31,.08);border-radius:15px;background:#fff;display:flex;flex-direction:column;justify-content:space-between}.metric-card.dark{background:#10241f;color:#fff;border-color:#10241f}.metric-card span,.metric-card small{color:var(--muted);font:600 .67rem/1.25 system-ui,sans-serif}.metric-card strong{font:500 1.7rem/.9 Georgia,serif}.metric-card small{font-weight:500;color:#4a9b6f}.metric-card.dark span{color:#b8d5bd}.metric-card.dark small{color:#c7e6a9}.workspace-card{padding:28px;border:1px solid rgba(16,36,31,.1);border-radius:20px;background:#fff}.section-head{display:flex;justify-content:space-between;align-items:end;gap:16px}.kicker{color:#b66f32;font:700 .66rem/1 system-ui,sans-serif;letter-spacing:.13em;text-transform:uppercase}.section-head h2,.guardrail h2{margin:9px 0 0;color:var(--ink);font:500 2.1rem/1.05 Georgia,serif;letter-spacing:-.045em}.status-pill{color:var(--muted);font:600 .67rem/1 system-ui,sans-serif}.status-pill i{display:inline-block;width:7px;height:7px;margin-right:5px;border-radius:50%;background:#57aa72}.commercial-tabs{display:flex;gap:6px;overflow:auto;margin:25px 0 14px;padding-bottom:4px}.commercial-tabs button{padding:10px 13px;border:1px solid rgba(16,36,31,.11);border-radius:9px;background:#fafbf9;color:var(--muted);cursor:pointer;font:700 .72rem/1 system-ui,sans-serif;white-space:nowrap}.commercial-tabs button.active,.commercial-tabs button:hover{background:#3d2a21;color:#fff;border-color:#3d2a21}.commercial-status{color:var(--muted);font:.7rem/1.3 system-ui,sans-serif}.commercial-list{margin-top:10px}.commercial-list article{display:grid;grid-template-columns:1.7fr auto auto auto;align-items:center;gap:12px;padding:15px 5px;border-top:1px solid rgba(16,36,31,.08)}.commercial-list strong{color:var(--ink);font:600 .82rem/1.2 system-ui,sans-serif}.commercial-list p,.commercial-list small{margin:5px 0 0;color:var(--muted);font:.7rem/1.3 system-ui,sans-serif}.commercial-list b{color:var(--ink);font:600 .78rem/1 system-ui,sans-serif;white-space:nowrap}.pill{display:inline-flex;padding:5px 8px;border-radius:999px;background:#fff1e5;color:#a9602e;font:700 .61rem/1 system-ui,sans-serif;white-space:nowrap}.empty{padding:28px 5px;color:var(--muted);font:.8rem/1.4 system-ui,sans-serif}.guardrail{display:grid;grid-template-columns:1fr .7fr;gap:30px;align-items:center;margin-top:40px;padding:30px;border-radius:20px;background:#f7ede4}.guardrail p{max-width:620px;margin:13px 0 0;color:var(--muted);font:.82rem/1.55 system-ui,sans-serif}.guardrail-steps{display:grid;gap:9px}.guardrail-steps span{display:flex;align-items:center;gap:11px;padding:10px 12px;border-radius:10px;background:#fff;color:var(--ink);font:600 .74rem/1 system-ui,sans-serif}.guardrail-steps b{color:#b66f32;font:700 .62rem/1 system-ui,sans-serif;letter-spacing:.08em}@media(max-width:820px){.commercial-hero,.guardrail{grid-template-columns:1fr}.metric-grid{grid-template-columns:repeat(2,1fr)}.commercial-list article{grid-template-columns:1fr auto}.commercial-list article small,.commercial-list article b{justify-self:start}}@media(max-width:560px){.commercial-shell{padding:20px 15px 55px}.commercial-hero{padding:28px 22px;border-radius:21px}.commercial-hero h1{font-size:2.65rem}.metric-grid{grid-template-columns:1fr}.workspace-card{padding:20px 16px}.section-head{align-items:start;flex-direction:column}.hero-orbit{min-height:220px}.ring-one{width:210px;height:150px}.ring-two{width:260px;height:185px}}
</style>
