---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Kontrollspor — Styr.ing" activeNav="audit">
  <main class="audit-shell">
    <section class="audit-hero"><div><span class="eyebrow"><i></i>Kontrollspor</span><h1>Se hva som skjedde — <em>og hvorfor.</em></h1><p>Et lesbart spor for hendelser og kontrollendringer. I den offentlige previewen er radene illustrasjoner; i en kunde-tenant knyttes de til bruker, tidspunkt og objekt.</p></div><div class="audit-orb"><span>Poster</span><strong id="audit-count">—</strong><small>siste registreringer</small></div></section>
    <section class="audit-card"><div class="card-head"><div><span class="section-kicker">Siste aktivitet</span><h2>Audit-logg</h2></div><a href="/api/audit?boardId=board-1">API ↗</a></div><div id="audit-list"><p class="muted">Henter kontrollspor…</p></div></section>
    <p class="audit-boundary">Ingen endringer kan gjøres fra denne offentlige siden. Skriveoperasjoner krever en autorisert tjenestegrense og blir registrert.</p>
  </main>
</Layout>
<script is:inline>
  const esc = (v) => String(v ?? '').replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  fetch('/api/audit?boardId=board-1').then(r=>r.json()).then(({data=[]})=>{ document.querySelector('#audit-count').textContent=data.length; document.querySelector('#audit-list').innerHTML=data.length?data.map(x=>`<div class="audit-row"><div><strong>${esc(x.action)}</strong><span>${esc(x.entity_type||'system')}${x.entity_id?' · '+esc(x.entity_id):''}</span></div><time>${esc(x.created_at)}</time></div>`).join(''):'<p class="muted">Ingen kontrollendringer er registrert ennå.</p>'; }).catch(()=>{ document.querySelector('#audit-list').innerHTML='<p class="muted">Kontrollsporet er midlertidig utilgjengelig.</p>'; });
</script>
<style>
 .audit-shell{max-width:1180px;margin:0 auto;padding:44px 24px 76px}.audit-hero{display:grid;grid-template-columns:1fr 250px;gap:40px;align-items:center;padding:42px;border-radius:26px;background:linear-gradient(120deg,#172b3b,#376b80);color:#fff}.eyebrow,.section-kicker{font:700 .68rem/1 system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase}.eyebrow{color:#c7eff9}.eyebrow i{display:inline-block;width:7px;height:7px;border-radius:50%;background:#c7eff9;margin-right:7px}.audit-hero h1{font:500 clamp(2.5rem,5vw,4.2rem)/.95 Georgia,serif;letter-spacing:-.05em;margin:18px 0}.audit-hero h1 em{color:#c7eff9;font-style:normal}.audit-hero p{max-width:590px;color:rgba(255,255,255,.76);font:.92rem/1.65 system-ui,sans-serif}.audit-orb{width:190px;height:190px;border-radius:50%;display:flex;flex-direction:column;justify-content:center;align-items:center;background:rgba(5,25,36,.3);border:1px solid rgba(199,239,249,.55);margin:auto}.audit-orb span,.audit-orb small{font:700 .63rem/1 system-ui,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:#b6dbe6}.audit-orb strong{font:500 2.7rem/1 Georgia,serif;color:#e8fbff;margin:12px 0}.audit-card{margin-top:18px;padding:22px;border:1px solid rgba(16,36,31,.09);border-radius:16px;background:#fff}.card-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:16px}.card-head h2{margin:8px 0 0;font:500 1.65rem/1 Georgia,serif}.card-head a{color:var(--accent);font:700 .68rem/1 system-ui,sans-serif}.audit-row{display:flex;justify-content:space-between;gap:20px;padding:14px 0;border-top:1px solid rgba(16,36,31,.08);font:.76rem/1.3 system-ui,sans-serif}.audit-row strong,.audit-row span{display:block}.audit-row span{color:var(--muted);margin-top:4px;font-size:.68rem}.audit-row time{color:var(--muted);font-size:.68rem;white-space:nowrap}.muted{color:var(--muted);font:.76rem/1.4 system-ui,sans-serif}.audit-boundary{margin-top:18px;color:var(--muted);font:.68rem/1.4 system-ui,sans-serif}@media(max-width:760px){.audit-hero{grid-template-columns:1fr}.audit-orb{width:160px;height:160px;margin:0}.audit-row{flex-direction:column;gap:6px}}
</style>
