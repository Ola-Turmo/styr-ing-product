---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Kort og utlegg" activeNav="cards"><main class="c-shell"><section class="c-hero"><div><span class="eyebrow">Styr.ing · kort og utlegg</span><h1>Se hvert kjøp.<br /><em>Godkjenn med spor.</em></h1><p>Samle firmakort, kvitteringer og utlegg i ett kontrollbilde. Kortutstedelse, betaling og bokføring er tydelig stoppet til leverandør og avtale er på plass.</p><a href="#c-work" class="primary">Åpne kortbildet ↓</a></div><div class="c-orb"><strong id="hero-missing">—</strong><span>kvitteringer mangler</span><small id="hero-review">— til kontroll</small></div></section><section class="metrics"><article><span>Aktive/proposerte kort</span><strong id="m-cards">—</strong><small>med synlig eier</small></article><article><span>Kjøp i kontroll</span><strong id="m-transactions">—</strong><small>beløp før avstemming</small></article><article><span>Kvitteringer mangler</span><strong id="m-missing">—</strong><small>må kompletteres</small></article><article class="dark"><span>Kortutsteder</span><strong>STOPP</strong><small>PayFac og betaling ikke aktivert</small></article></section><section id="c-work" class="workspace"><div class="head"><div><span class="kicker">Kontrollert forbruk</span><h2>Firmakort og utlegg</h2></div><span id="status">Henter…</span></div><nav class="tabs"><button class="active" data-view="cards">Kort</button><button data-view="transactions">Transaksjoner</button></nav><div id="list"></div></section><section class="card-actions"><div class="card-actions-head"><div><span class="kicker">Styrte handlinger</span><h2>Kompletter før avstemming.</h2><p>Kvitteringer og godkjenninger blir logget. Ingen betaling eller bokføring utføres her.</p></div><span class="hitl-badge">HITL · påkrevd</span></div><div class="card-action-grid"><form data-card-action="attach_receipt"><h3>Legg ved kvitteringsreferanse</h3><label>Transaksjon<select name="transactionId" id="receipt-transaction-id" required><option value="">Henter transaksjoner…</option></select></label><label>Referanse<input name="receiptRef" maxlength="240" required placeholder="Filnavn, URL eller arkivreferanse" /></label><button type="submit">Registrer kvittering</button></form><form data-card-action="approve_transaction"><h3>Godkjenn transaksjon</h3><label>Transaksjon<select name="transactionId" id="approval-transaction-id" required><option value="">Henter til kontroll…</option></select></label><p class="form-note">Godkjenningen oppretter ikke bokføring før ledger-adapter er konfigurert.</p><button type="submit">Godkjenn kjøp</button></form></div><p id="card-action-status" class="action-status" role="status" aria-live="polite"></p></section><section class="notice"><strong>Produksjonsgrense</strong><p>Dette er et internt kontrollspor. Kortutstedelse, betalingsautorisasjon, refusjon, automatisk bokføring og kvitterings-OCR krever leverandøravtale, tilgang, SCA og menneskelig godkjenning.</p></section></main></Layout>
<script is:inline>
const esc=v=>String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));const list=document.getElementById('list'),status=document.getElementById('status');const labels={proposed:'Foreslått',active:'Aktivt',paused:'Pauset',needs_receipt:'Kvittering mangler',ready_for_review:'Til kontroll',approved:'Godkjent',reconciled:'Avstemt'};const pill=v=>`<em class="pill">${esc(labels[v]||v||'—')}</em>`;const money=n=>`${new Intl.NumberFormat('nb-NO').format(Number(n||0)/100)} NOK`;const render=(view,rows)=>{const f={cards:r=>`<article><div><strong>${esc(r.card_name)} · **** ${esc(r.last_four||'—')}</strong><p>${esc(r.holder_name||'Uten eier')} · Grense ${money(r.monthly_limit_minor)}</p></div>${pill(r.status)}<small>${esc(r.provider||'Utsteder ikke konfigurert')}</small></article>`,transactions:r=>`<article><div><strong>${esc(r.transaction_date)} · ${esc(r.merchant)}</strong><p>${esc(r.category||'Kategori mangler')} · ${esc(r.holder_name||'Ukjent kortholder')}</p></div>${pill(r.status)}<b>${money(r.amount_minor)}</b></article>`};list.innerHTML=rows.length?rows.map(f[view]).join(''):'<p class="empty">Ingen registrerte rader.</p>';};const load=async view=>{try{const d=await (await fetch(`/api/cards?boardId=board-1&view=${view}`)).json();render(view,d.data||[]);status.textContent=`${(d.data||[]).length} poster · kilde synlig`;}catch{status.textContent='API utilgjengelig'}};const summary=async()=>{try{const d=(await (await fetch('/api/cards?boardId=board-1&view=summary')).json()).data||{};document.getElementById('m-cards').textContent=d.cards?.count??0;document.getElementById('m-transactions').textContent=money(d.transactions?.amount_minor);document.getElementById('m-missing').textContent=d.missingReceipts?.count??0;document.getElementById('hero-missing').textContent=d.missingReceipts?.count??0;document.getElementById('hero-review').textContent=`${d.review?.count??0} til kontroll`;}catch{}};const fillCardOptions=async()=>{const rows=(await fetch('/api/cards?boardId=board-1&view=transactions').then(r=>r.json())).data||[];const missing=rows.filter(x=>x.status==='needs_receipt'),ready=rows.filter(x=>x.status==='ready_for_review');document.getElementById('receipt-transaction-id').innerHTML=missing.length?missing.map(x=>`<option value="${esc(x.id)}">${esc(x.transaction_date)} · ${esc(x.merchant)} · ${money(x.amount_minor)}</option>`).join(''):'<option value="">Ingen kvitteringer som mangler</option>';document.getElementById('approval-transaction-id').innerHTML=ready.length?ready.map(x=>`<option value="${esc(x.id)}">${esc(x.transaction_date)} · ${esc(x.merchant)} · ${money(x.amount_minor)}</option>`).join(''):'<option value="">Ingen kjøp til kontroll</option>';};const cardPost=async form=>{const statusEl=document.getElementById('card-action-status');const payload=Object.fromEntries(new FormData(form));payload.boardId='board-1';payload.action=form.dataset.cardAction;statusEl.textContent='Lagrer og logger handling…';try{const res=await fetch('/api/cards',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(payload)});const data=await res.json();if(!res.ok)throw new Error(data.error||'Kunne ikke lagre');statusEl.textContent=`✓ ${data.action} er registrert. Status: ${data.status||'ok'}.`;form.reset();await Promise.all([fillCardOptions(),summary()]);await load(document.querySelector('.tabs button.active')?.dataset.view||'cards');}catch(error){statusEl.textContent=`Kunne ikke lagre: ${error.message}`;}};document.querySelectorAll('.tabs button').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.tabs button').forEach(x=>x.classList.remove('active'));b.classList.add('active');load(b.dataset.view)}));document.querySelectorAll('[data-card-action]').forEach(form=>form.addEventListener('submit',event=>{event.preventDefault();cardPost(form);}));summary();fillCardOptions().catch(()=>{});load('cards');
</script>
<style>.c-shell{max-width:1180px;margin:0 auto;padding:38px 24px 80px}.c-hero{display:grid;grid-template-columns:1fr .45fr;align-items:center;gap:24px;padding:44px;border-radius:27px;background:linear-gradient(120deg,#263653,#5276a6);color:#fff}.eyebrow,.kicker{font:700 .68rem system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:#d5e8ff}.c-hero h1{margin:20px 0 16px;font:500 clamp(2.5rem,5vw,4.4rem)/.96 Georgia,serif}.c-hero h1 em{color:#c9e2ff;font-style:normal}.c-hero p{max-width:570px;color:#ffffffbf;font:1rem/1.6 system-ui,sans-serif}.primary{display:inline-flex;margin-top:22px;padding:13px 17px;border-radius:10px;background:#c9e2ff;color:#273852;font:700 .78rem system-ui,sans-serif}.c-orb{width:190px;height:190px;display:flex;flex-direction:column;align-items:center;justify-content:center;border:1px solid #c9e2ffaa;border-radius:50%;background:#36557f;color:#fff}.c-orb strong{font:500 3.2rem Georgia,serif;color:#d9ecff}.c-orb span,.c-orb small{font:.68rem system-ui,sans-serif}.c-orb small{margin-top:9px;color:#c1dcf5}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:16px 0 52px}.metrics article{min-height:105px;padding:17px;border:1px solid #10241f14;border-radius:15px;background:#fff;display:flex;flex-direction:column;justify-content:space-between}.metrics .dark{background:#10241f;color:#fff}.metrics span,.metrics small{color:#718078;font:600 .67rem system-ui,sans-serif}.metrics strong{font:500 1.7rem Georgia,serif}.workspace{padding:28px;border:1px solid #10241f18;border-radius:20px;background:#fff}.head{display:flex;justify-content:space-between;align-items:end}.head h2{margin:9px 0 0;font:500 2.1rem Georgia,serif}.head>span{color:#718078;font:.7rem system-ui,sans-serif}.tabs{display:flex;gap:6px;overflow:auto;margin:25px 0 12px}.tabs button{padding:10px 14px;border:1px solid #10241f1c;border-radius:9px;background:#fafbf9;color:#65746b;cursor:pointer;font:700 .72rem system-ui,sans-serif}.tabs button.active{background:#5276a6;color:#fff}.workspace article{display:grid;grid-template-columns:1.6fr auto auto;gap:12px;align-items:center;padding:15px 4px;border-top:1px solid #10241f12}.workspace strong{font:600 .82rem system-ui,sans-serif}.workspace p,.workspace small{margin:5px 0 0;color:#718078;font:.7rem/1.35 system-ui,sans-serif}.pill{padding:5px 8px;border-radius:999px;background:#e8f0fb;color:#476b99;font:700 .61rem system-ui,sans-serif;font-style:normal;white-space:nowrap}.card-actions{margin-top:35px;padding:24px;border:1px solid #10241f18;border-radius:18px;background:#f4f8ff}.card-actions-head{display:flex;justify-content:space-between;gap:18px}.card-actions-head h2{margin:9px 0 7px;font:500 1.8rem Georgia,serif}.card-actions-head p{color:#63736a;font:.78rem/1.5 system-ui,sans-serif}.hitl-badge{height:max-content;padding:8px 10px;border-radius:999px;background:#dceaff;color:#36557f;font:700 .62rem system-ui,sans-serif;white-space:nowrap}.card-action-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:20px}.card-action-grid form{display:flex;flex-direction:column;gap:9px;padding:15px;border:1px solid #10241f18;border-radius:13px;background:#fff}.card-action-grid h3{font:700 .78rem system-ui,sans-serif}.card-action-grid label{display:flex;flex-direction:column;gap:5px;color:#718078;font:600 .62rem system-ui,sans-serif}.card-action-grid input,.card-action-grid select{width:100%;padding:8px;border:1px solid #10241f26;border-radius:8px;background:#fbfdfb;font:.71rem system-ui,sans-serif}.card-action-grid button{margin-top:auto;padding:9px;border:0;border-radius:8px;background:#5276a6;color:#fff;font:700 .67rem system-ui,sans-serif;cursor:pointer}.form-note{color:#718078;font:.66rem/1.4 system-ui,sans-serif}.action-status{min-height:1.2em;margin-top:14px;color:#36557f;font:700 .72rem system-ui,sans-serif}.notice{margin-top:35px;padding:22px 25px;border-radius:16px;background:#edf3fb}.notice strong{font:700 .78rem system-ui,sans-serif}.notice p{margin:8px 0 0;color:#63736a;font:.78rem/1.5 system-ui,sans-serif}@media(max-width:800px){.c-hero{grid-template-columns:1fr}.metrics{grid-template-columns:repeat(2,1fr)}.card-actions-head{flex-direction:column}}@media(max-width:560px){.c-shell{padding:20px 15px 55px}.c-hero{padding:28px 22px}.metrics,.card-action-grid{grid-template-columns:1fr}.workspace{padding:20px 16px}.workspace article{grid-template-columns:1fr auto}.workspace article small{grid-column:1}}
</style>
