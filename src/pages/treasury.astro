---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Lønn og likviditet" activeNav="treasury"><main class="t-shell"><section class="t-hero"><div><span class="eyebrow">Styr.ing · lønn og likviditet</span><h1>Forbered tallene.<br /><em>Godkjenn før de går.</em></h1><p>Samle lønnskjøring, A-melding-forberedelse, likviditetsbilde og innkrevingsoppfølging i ett kontrollert spor.</p><a href="#t-work" class="primary">Åpne kontrollbildet ↓</a></div><div class="t-orb"><strong id="hero-runway">—</strong><span>måneder runway</span><small id="hero-payroll">— i lønnskø</small></div></section><section class="metrics"><article><span>Lønn til kontroll</span><strong id="m-payroll">—</strong><small>brutto grunnlag</small></article><article><span>Innsendinger</span><strong id="m-submissions">—</strong><small>forberedt eller til review</small></article><article><span>Innkrevingssaldo</span><strong id="m-collections">—</strong><small>krever oppfølging</small></article><article class="dark"><span>Ekstern sending</span><strong>STOPP</strong><small>Altinn, bank og inkasso ikke aktivert</small></article></section><section id="t-work" class="workspace"><div class="head"><div><span class="kicker">Finansiell kontroll</span><h2 id="view-title">Lønnskjøringer</h2></div><span id="status">Henter…</span></div><nav class="tabs">{[['payroll','Lønn'],['submissions','Innsendinger'],['liquidity','Likviditet'],['collections','Innkrevingsspor']].map(([key,label],i)=><button class={i===0?'active':''} data-view={key}>{label}</button>)}</nav><div id="list"></div></section><section class="notice"><strong>Produksjonsgrense</strong><p>A-melding, NAV, skattekort, bankbetaling, Vipps/Klarna og inkassovarsler krever Maskinporten-/bankavtaler, juridisk godkjenning, SCA og menneskelig godkjenning. Denne flaten sender ingenting eksternt.</p></section></main></Layout>
<script is:inline>
const esc=v=>String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));const list=document.getElementById('list'),status=document.getElementById('status');const labels={draft:'Utkast',calculated:'Beregnet',review:'Til review',approved:'Godkjent',prepared:'Forberedt',submitted:'Sendt',open:'Åpen',reminder_prepared:'Påminnelse forberedt',paid:'Betalt',closed:'Lukket'};const pill=v=>`<em class="pill">${esc(labels[v]||v||'—')}</em>`;const money=n=>`${new Intl.NumberFormat('nb-NO').format(Number(n||0)/100)} NOK`;
const render=(view,rows)=>{const f={payroll:r=>`<article><div><strong>${esc(r.period)} · lønnskjøring</strong><p>${esc(r.employee_count)} ansatte · ${esc(r.item_count)} lønnslinjer</p></div>${pill(r.status)}<b>${money(r.gross_minor)}</b></article>`,submissions:r=>`<article><div><strong>${esc(r.submission_type)} · ${esc(r.period)}</strong><p>${esc(r.notes||'Payload klart for kontroll')}</p></div>${pill(r.status)}<small>${esc(r.external_reference||'Ekstern innsending ikke konfigurert')}</small></article>`,liquidity:r=>`<article><div><strong>${esc(r.as_of_date)} · likviditetsbilde</strong><p>Kontant ${money(r.cash_minor)} · fordringer ${money(r.receivables_minor)}</p></div>${pill(r.status)}<small>${esc(r.runway_months||'—')} måneder runway</small></article>`,collections:r=>`<article><div><strong>${esc(r.reference)} · ${esc(r.company_name||'Uten kunde')}</strong><p>Forfaller ${esc(r.due_date||'—')} · ${esc(r.next_action||'Neste steg ikke satt')}</p></div>${pill(r.status)}<b>${money(r.amount_minor)}</b></article>`};list.innerHTML=rows.length?rows.map(f[view]).join(''):'<p class="empty">Ingen registrerte rader.</p>';};
const load=async view=>{try{const r=await fetch(`/api/treasury?boardId=board-1&view=${view}`),d=await r.json();render(view,d.data||[]);status.textContent=`${(d.data||[]).length} poster · kilde synlig`;}catch{status.textContent='API utilgjengelig'}};const summary=async()=>{try{const r=await fetch('/api/treasury?boardId=board-1&view=summary'),d=(await r.json()).data||{};document.getElementById('m-payroll').textContent=money(d.payroll?.gross_minor);document.getElementById('m-submissions').textContent=d.submissions?.count??0;document.getElementById('m-collections').textContent=money(d.collections?.amount_minor);document.getElementById('hero-runway').textContent=d.liquidity?.runway_months??'—';document.getElementById('hero-payroll').textContent=`${d.payroll?.count??0} lønnskjøring(er)`;}catch{}};document.querySelectorAll('.tabs button').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.tabs button').forEach(x=>x.classList.remove('active'));b.classList.add('active');load(b.dataset.view)}));summary();load('payroll');
</script>
<style>.t-shell{max-width:1180px;margin:0 auto;padding:38px 24px 80px}.t-hero{display:grid;grid-template-columns:1fr .45fr;align-items:center;gap:24px;padding:44px;border-radius:27px;background:linear-gradient(120deg,#46332b,#966345);color:#fff}.eyebrow,.kicker{font:700 .68rem system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:#ffe0c1}.t-hero h1{margin:20px 0 16px;font:500 clamp(2.5rem,5vw,4.4rem)/.96 Georgia,serif}.t-hero h1 em{color:#ffd7a9;font-style:normal}.t-hero p{max-width:570px;color:#ffffffbf;font:1rem/1.6 system-ui,sans-serif}.primary{display:inline-flex;margin-top:22px;padding:13px 17px;border-radius:10px;background:#ffdcab;color:#493328;font:700 .78rem system-ui,sans-serif}.t-orb{width:190px;height:190px;display:flex;flex-direction:column;align-items:center;justify-content:center;border:1px solid #ffddb0aa;border-radius:50%;background:#65452f;color:#fff}.t-orb strong{font:500 3.2rem Georgia,serif;color:#ffe0a7}.t-orb span,.t-orb small{font:.68rem system-ui,sans-serif}.t-orb small{margin-top:9px;color:#f3ccb0}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:16px 0 52px}.metrics article{min-height:105px;padding:17px;border:1px solid #10241f14;border-radius:15px;background:#fff;display:flex;flex-direction:column;justify-content:space-between}.metrics .dark{background:#10241f;color:#fff}.metrics span,.metrics small{color:#718078;font:600 .67rem system-ui,sans-serif}.metrics strong{font:500 1.7rem Georgia,serif}.metrics small{color:#a06942}.workspace{padding:28px;border:1px solid #10241f18;border-radius:20px;background:#fff}.head{display:flex;justify-content:space-between;align-items:end}.head h2{margin:9px 0 0;font:500 2.1rem Georgia,serif}.head>span{color:#718078;font:.7rem system-ui,sans-serif}.tabs{display:flex;gap:6px;overflow:auto;margin:25px 0 12px}.tabs button{padding:10px 14px;border:1px solid #10241f1c;border-radius:9px;background:#fafbf9;color:#65746b;cursor:pointer;font:700 .72rem system-ui,sans-serif;white-space:nowrap}.tabs button.active{background:#65452f;color:#fff}.workspace article{display:grid;grid-template-columns:1.6fr auto auto;gap:12px;align-items:center;padding:15px 4px;border-top:1px solid #10241f12}.workspace strong{font:600 .82rem system-ui,sans-serif}.workspace p,.workspace small{margin:5px 0 0;color:#718078;font:.7rem/1.35 system-ui,sans-serif}.pill{padding:5px 8px;border-radius:999px;background:#fff0e4;color:#9c633b;font:700 .61rem system-ui,sans-serif;font-style:normal;white-space:nowrap}.notice{margin-top:35px;padding:22px 25px;border-radius:16px;background:#fff1e7}.notice strong{font:700 .78rem system-ui,sans-serif}.notice p{margin:8px 0 0;color:#63736a;font:.78rem/1.5 system-ui,sans-serif}@media(max-width:800px){.t-hero{grid-template-columns:1fr}.metrics{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.t-shell{padding:20px 15px 55px}.t-hero{padding:28px 22px}.metrics{grid-template-columns:1fr}.workspace{padding:20px 16px}.head{align-items:start;flex-direction:column;gap:9px}.workspace article{grid-template-columns:1fr auto}.workspace article small{grid-column:1}}
</style>
