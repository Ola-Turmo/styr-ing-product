---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Lønn og likviditet" activeNav="treasury">
  <main class="t-shell">
    <section class="t-hero"><div><span class="eyebrow">Styr.ing · lønn og likviditet</span><h1>Forbered tallene.<br /><em>Godkjenn før de går.</em></h1><p>Samle lønnskjøring, A-melding-forberedelse, likviditetsbilde og innkrevingsoppfølging i ett kontrollert spor.</p><a href="#t-work" class="primary">Åpne kontrollbildet ↓</a></div><div class="t-orb"><strong id="hero-runway">—</strong><span>måneder runway</span><small id="hero-payroll">— i lønnskø</small></div></section>
    <section class="metrics"><article><span>Lønn til kontroll</span><strong id="m-payroll">—</strong><small>brutto grunnlag</small></article><article><span>Innsendinger</span><strong id="m-submissions">—</strong><small>forberedt eller til review</small></article><article><span>Innkrevingssaldo</span><strong id="m-collections">—</strong><small>krever oppfølging</small></article><article class="dark"><span>Ekstern sending</span><strong>STOPP</strong><small>Altinn, bank og inkasso ikke aktivert</small></article></section>
    <section id="t-work" class="workspace"><div class="head"><div><span class="kicker">Finansiell kontroll</span><h2 id="view-title">Lønnskjøringer</h2></div><span id="status">Henter…</span></div><nav class="tabs"><button class="active" data-view="payroll">Lønn</button><button data-view="submissions">Innsendinger</button><button data-view="liquidity">Likviditet</button><button data-view="collections">Innkrevingsspor</button></nav><div id="list"></div></section>
    <section class="t-actions"><div class="t-actions-head"><div><span class="kicker">Styrte handlinger</span><h2>Godkjenn før noe går ut.</h2><p>Lønn, myndighetsgrunnlag, likviditet og innkreving blir bare forberedt eller godkjent — aldri sendt automatisk.</p></div><span class="hitl-badge">HITL · påkrevd</span></div><div class="t-action-grid"><form data-treasury-action="approve_payroll"><h3>Godkjenn lønnskjøring</h3><label>Kjøring<select name="payrollRunId" id="treasury-payroll-id" required><option value="">Henter lønn…</option></select></label><button type="submit">Godkjenn kontroll</button></form><form data-treasury-action="approve_submission"><h3>Godkjenn innsending</h3><label>Grunnlag<select name="submissionId" id="treasury-submission-id" required><option value="">Henter grunnlag…</option></select></label><button type="submit">Godkjenn grunnlag</button></form><form data-treasury-action="prepare_collection"><h3>Forbered innkreving</h3><label>Sak<select name="caseId" id="treasury-collection-id" required><option value="">Henter saker…</option></select></label><p class="form-note">Påminnelse sendes ikke uten separat menneskelig kontroll.</p><button type="submit">Forbered påminnelse</button></form><form data-treasury-action="create_liquidity_snapshot"><h3>Nytt likviditetsbilde</h3><label>Dato<input type="date" name="asOfDate" value="2026-08-25" required /></label><div class="form-row"><label>Kontanter (kr)<input type="number" name="cashMinor" min="0" required /></label><label>Fordringer (kr)<input type="number" name="receivablesMinor" min="0" required /></label></div><div class="form-row"><label>Gjeld (kr)<input type="number" name="payablesMinor" min="0" required /></label><label>Lønn (kr)<input type="number" name="payrollDueMinor" min="0" required /></label></div><button type="submit">Lagre bilde</button></form></div><p id="treasury-action-status" class="action-status" role="status" aria-live="polite"></p></section>
    <section class="notice"><strong>Produksjonsgrense</strong><p>A-melding, NAV, skattekort, bankbetaling, Vipps/Klarna og inkassovarsler krever Maskinporten-/bankavtaler, juridisk godkjenning, SCA og menneskelig godkjenning. Denne flaten sender ingenting eksternt.</p></section>
  </main>
</Layout>
<script is:inline>
const treasuryDateInput=document.querySelector('input[name="asOfDate"]');if(treasuryDateInput)treasuryDateInput.value=new Date().toISOString().slice(0,10);
const esc=v=>String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
const list=document.getElementById('list'),pageStatus=document.getElementById('status');
const labels={draft:'Utkast',calculated:'Beregnet',review:'Til review',approved:'Godkjent',prepared:'Forberedt',submitted:'Sendt',open:'Åpen',reminder_prepared:'Påminnelse forberedt',paid:'Betalt',closed:'Lukket'};
const pill=v=>`<em class="pill">${esc(labels[v]||v||'—')}</em>`;
const money=n=>`${new Intl.NumberFormat('nb-NO').format(Number(n||0)/100)} NOK`;
const render=(view,rows)=>{const f={payroll:r=>`<article><div><strong>${esc(r.period)} · lønnskjøring</strong><p>${esc(r.employee_count)} ansatte · ${esc(r.item_count)} lønnslinjer</p></div>${pill(r.status)}<b>${money(r.gross_minor)}</b></article>`,submissions:r=>`<article><div><strong>${esc(r.submission_type)} · ${esc(r.period)}</strong><p>${esc(r.notes||'Payload klart for kontroll')}</p></div>${pill(r.status)}<small>${esc(r.external_reference||'Ekstern innsending ikke konfigurert')}</small></article>`,liquidity:r=>`<article><div><strong>${esc(r.as_of_date)} · likviditetsbilde</strong><p>Kontant ${money(r.cash_minor)} · fordringer ${money(r.receivables_minor)}</p></div>${pill(r.status)}<small>${esc(r.runway_months||'—')} måneder runway</small></article>`,collections:r=>`<article><div><strong>${esc(r.reference)} · ${esc(r.company_name||'Uten kunde')}</strong><p>Forfaller ${esc(r.due_date||'—')} · ${esc(r.next_action||'Neste steg ikke satt')}</p></div>${pill(r.status)}<b>${money(r.current_outstanding_minor??r.amount_minor)}</b></article>`};list.innerHTML=rows.length?rows.map(f[view]).join(''):'<p class="empty">Ingen registrerte rader.</p>';};
const load=async view=>{try{const d=await fetch(`/api/treasury?boardId=board-1&view=${view}`).then(r=>r.json());render(view,d.data||[]);pageStatus.textContent=`${(d.data||[]).length} poster · kilde synlig`;}catch{pageStatus.textContent='API utilgjengelig';}};
const summary=async()=>{try{const d=(await fetch('/api/treasury?boardId=board-1&view=summary').then(r=>r.json())).data||{};document.getElementById('m-payroll').textContent=money(d.payroll?.gross_minor);document.getElementById('m-submissions').textContent=d.submissions?.count??0;document.getElementById('m-collections').textContent=money(d.collections?.amount_minor);document.getElementById('hero-runway').textContent=d.liquidity?.runway_months??'—';document.getElementById('hero-payroll').textContent=`${d.payroll?.count??0} lønnskjøring(er)`;}catch{}};
const fillOptions=async()=>{const [payroll,submissions,collections]=await Promise.all(['payroll','submissions','collections'].map(v=>fetch(`/api/treasury?boardId=board-1&view=${v}`).then(r=>r.json())));const p=(payroll.data||[]).filter(x=>x.status==='review');document.getElementById('treasury-payroll-id').innerHTML=p.length?p.map(x=>`<option value="${esc(x.id)}">${esc(x.period)} · ${money(x.gross_minor)}</option>`).join(''):'<option value="">Ingen lønn til kontroll</option>';const s=(submissions.data||[]).filter(x=>['prepared','review'].includes(x.status));document.getElementById('treasury-submission-id').innerHTML=s.length?s.map(x=>`<option value="${esc(x.id)}">${esc(x.submission_type)} · ${esc(x.period)}</option>`).join(''):'<option value="">Ingen grunnlag til kontroll</option>';const c=(collections.data||[]).filter(x=>x.status==='open'&&Number(x.current_outstanding_minor??x.amount_minor)>0);document.getElementById('treasury-collection-id').innerHTML=c.length?c.map(x=>`<option value="${esc(x.id)}">${esc(x.reference)} · ${money(x.current_outstanding_minor??x.amount_minor)}</option>`).join(''):'<option value="">Ingen åpne saker</option>';};
const post=async form=>{const status=document.getElementById('treasury-action-status');const payload=Object.fromEntries(new FormData(form));payload.boardId='board-1';payload.action=form.dataset.treasuryAction;['cashMinor','receivablesMinor','payablesMinor','payrollDueMinor'].forEach(k=>{if(payload[k]!==undefined)payload[k]=Math.round(Number(payload[k])*100);});status.textContent='Lagrer og logger handling…';try{const res=await fetch('/api/treasury',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(payload)});const data=await res.json();if(!res.ok)throw new Error(data.error||'Kunne ikke lagre');status.textContent=`✓ ${data.action} er registrert. Status: ${data.status||'ok'}.`;form.reset();await Promise.all([fillOptions(),summary()]);await load(document.querySelector('.tabs button.active')?.dataset.view||'payroll');}catch(error){status.textContent=`Kunne ikke lagre: ${error.message}`;}};
document.querySelectorAll('.tabs button').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll('.tabs button').forEach(x=>x.classList.remove('active'));button.classList.add('active');load(button.dataset.view);}));document.querySelectorAll('[data-treasury-action]').forEach(form=>form.addEventListener('submit',event=>{event.preventDefault();post(form);}));summary();fillOptions().catch(()=>{});load('payroll');
</script>
<style>
.t-shell{max-width:1180px;margin:0 auto;padding:38px 24px 80px}.t-hero{display:grid;grid-template-columns:1fr .45fr;align-items:center;gap:24px;padding:44px;border-radius:27px;background:linear-gradient(120deg,#46332b,#966345);color:#fff}.eyebrow,.kicker{font:700 .68rem system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:#ffe0c1}.t-hero h1{margin:20px 0 16px;font:500 clamp(2.5rem,5vw,4.4rem)/.96 Georgia,serif}.t-hero h1 em{color:#ffd7a9;font-style:normal}.t-hero p{max-width:570px;color:#ffffffbf;font:1rem/1.6 system-ui,sans-serif}.primary{display:inline-flex;margin-top:22px;padding:13px 17px;border-radius:10px;background:#ffdcab;color:#493328;font:700 .78rem system-ui,sans-serif}.t-orb{width:190px;height:190px;display:flex;flex-direction:column;align-items:center;justify-content:center;border:1px solid #ffddb0aa;border-radius:50%;background:#65452f;color:#fff}.t-orb strong{font:500 3.2rem Georgia,serif;color:#ffe0a7}.t-orb span,.t-orb small{font:.68rem system-ui,sans-serif}.t-orb small{margin-top:9px;color:#f3ccb0}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:16px 0 52px}.metrics article{min-height:105px;padding:17px;border:1px solid #10241f14;border-radius:15px;background:#fff;display:flex;flex-direction:column;justify-content:space-between}.metrics .dark{background:#10241f;color:#fff}.metrics span,.metrics small{color:#718078;font:600 .67rem system-ui,sans-serif}.metrics strong{font:500 1.7rem Georgia,serif}.metrics small{color:#a06942}.workspace{padding:28px;border:1px solid #10241f18;border-radius:20px;background:#fff}.head{display:flex;justify-content:space-between;align-items:end}.head h2{margin:9px 0 0;font:500 2.1rem Georgia,serif}.head>span{color:#718078;font:.7rem system-ui,sans-serif}.tabs{display:flex;gap:6px;overflow:auto;margin:25px 0 12px}.tabs button{padding:10px 14px;border:1px solid #10241f1c;border-radius:9px;background:#fafbf9;color:#65746b;cursor:pointer;font:700 .72rem system-ui,sans-serif}.tabs button.active{background:#65452f;color:#fff}.workspace article{display:grid;grid-template-columns:1.6fr auto auto;gap:12px;align-items:center;padding:15px 4px;border-top:1px solid #10241f12}.workspace strong{font:600 .82rem system-ui,sans-serif}.workspace p,.workspace small{margin:5px 0 0;color:#718078;font:.7rem/1.35 system-ui,sans-serif}.pill{padding:5px 8px;border-radius:999px;background:#fff0e4;color:#9c633b;font:700 .61rem system-ui,sans-serif;font-style:normal}.t-actions{margin-top:35px;padding:24px;border:1px solid #10241f18;border-radius:18px;background:#fff7f0}.t-actions-head{display:flex;justify-content:space-between;gap:18px}.t-actions-head h2{margin:9px 0 7px;font:500 1.8rem Georgia,serif}.t-actions-head p{color:#63736a;font:.78rem/1.5 system-ui,sans-serif}.hitl-badge{height:max-content;padding:8px 10px;border-radius:999px;background:#ffe4c7;color:#825031;font:700 .62rem system-ui,sans-serif;white-space:nowrap}.t-action-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:20px}.t-action-grid form{display:flex;flex-direction:column;gap:9px;padding:15px;border:1px solid #10241f18;border-radius:13px;background:#fff}.t-action-grid h3{font:700 .78rem system-ui,sans-serif}.t-action-grid label{display:flex;flex-direction:column;gap:5px;color:#718078;font:600 .62rem system-ui,sans-serif}.t-action-grid input,.t-action-grid select{width:100%;padding:8px;border:1px solid #10241f26;border-radius:8px;background:#fbfdfb;font:.71rem system-ui,sans-serif}.t-action-grid button{margin-top:auto;padding:9px;border:0;border-radius:8px;background:#65452f;color:#fff;font:700 .67rem system-ui,sans-serif;cursor:pointer}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:7px}.form-note{color:#718078;font:.66rem/1.4 system-ui,sans-serif}.action-status{min-height:1.2em;margin-top:14px;color:#825031;font:700 .72rem system-ui,sans-serif}.notice{margin-top:35px;padding:22px 25px;border-radius:16px;background:#fff1e7}.notice strong{font:700 .78rem system-ui,sans-serif}.notice p{margin:8px 0 0;color:#63736a;font:.78rem/1.5 system-ui,sans-serif}@media(max-width:950px){.t-action-grid{grid-template-columns:1fr 1fr}}@media(max-width:800px){.t-hero{grid-template-columns:1fr}.metrics{grid-template-columns:repeat(2,1fr)}.t-actions-head{flex-direction:column}}@media(max-width:560px){.t-shell{padding:20px 15px 55px}.t-hero{padding:28px 22px}.metrics,.t-action-grid{grid-template-columns:1fr}.workspace{padding:20px 16px}.head{align-items:start;flex-direction:column;gap:9px}.workspace article{grid-template-columns:1fr auto}.workspace article small{grid-column:1}.form-row{grid-template-columns:1fr}}
</style>
