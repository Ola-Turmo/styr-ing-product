---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Priser og abonnement — Styr.ing" activeNav="abonnement">
  <main class="pricing-shell">
    <section class="pricing-hero">
      <p class="eyebrow">SaaS-abonnement · regnskap først</p>
      <h1>Én rolig pris for<br /><em>det daglige regnskapet.</em></h1>
      <p>Styr.ing aktiveres per virksomhet etter en kort gjennomgang. Du får komplett regnskapsflyt som kjerne – bilag, faktura, bank, MVA, lønn og rapporter – med tydelige roller og kontrollspor.</p>
      <div class="pricing-actions"><a class="primary" href="/finance">Se regnskapsdemoen ↗</a><a class="secondary" href="mailto:ola@styr.ing?subject=Styr.ing%20abonnement">Be om pris og aktivering</a></div>
      <small class="boundary">Ingen betaling eller abonnement opprettes fra denne siden. Pris, omfang og vilkår bekreftes før aktivering.</small>
    </section>

    <section class="plan-card" aria-labelledby="plan-title">
      <div class="plan-head"><div><span class="kicker">Styr.ing Regnskap</span><h2 id="plan-title">Komplett grunnpakke</h2><p>For små AS og ENK som vil føre selv eller samarbeide med regnskapsfører.</p></div><span class="plan-label">Pris etter behov</span></div>
      <div class="included-grid">
        <div><strong>Bilag og bokføring</strong><span>Kontoplan, perioder, dokumentasjon og auditspor.</span></div>
        <div><strong>Faktura og reskontro</strong><span>Kunder, fakturautkast, åpne poster og betalinger.</span></div>
        <div><strong>Bank og MVA</strong><span>Bankgrunnlag, avstemming og MVA-kontroll.</span></div>
        <div><strong>Lønn og rapporter</strong><span>Lønnsgrunnlag, frister, resultat, balanse og SAF-T.</span></div>
      </div>
      <p class="plan-note">Regnskapsfører kan få egen tilgang med rolle og virksomhetstilknytning. Dere beholder kontrollen over hvem som kan lese, endre og godkjenne.</p>
    </section>

    <section class="extras" aria-labelledby="extras-title">
      <div><span class="kicker">Når dere trenger mer</span><h2 id="extras-title">Koble på etter hvert.</h2><p>Styrearbeid, prosjekt og timer, kunder, risiko og drift kan aktiveres som egne arbeidsflater når grunnregnskapet er på plass.</p></div>
      <div class="extra-list"><div><strong>Interne arbeidsflater</strong><span>Aktiveres i avtalt omfang og med riktig rolle.</span></div><div><strong>Eksterne integrasjoner</strong><span>Altinn, EHF, bank, betaling og andre leverandører krever egen avtale, nøkler og sikkerhetsvurdering.</span></div><div><strong>KI-assistanse</strong><span>Utkast med kilder og menneskelig godkjenning – aldri automatisk bokføring.</span></div></div>
    </section>

    <section class="next-step"><span class="kicker">Neste steg</span><h2>Se hvordan det føles<br /><em>før dere bestemmer dere.</em></h2><p>Start i den offentlige regnskapsdemoen med fiktive data. Når dere vil gå videre, sender vi omfang, pris, abonnement og databehandleravtale til godkjenning.</p><div><a class="primary dark" href="/finance">Åpne regnskapsdemoen ↗</a><a class="link" href="/trust">Les om sikkerhet og databehandling →</a></div></section>
  </main>
</Layout>

<style>
  .pricing-shell{max-width:1040px;margin:0 auto;padding:54px 24px 90px;color:var(--ink)}.pricing-hero{padding:52px;border-radius:26px;background:linear-gradient(120deg,#10241f,#1f5a46);color:#fff}.eyebrow,.kicker{font:700 .69rem/1.2 system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase}.eyebrow{color:#d5fb98}.pricing-hero h1{margin:18px 0;font:500 clamp(3rem,7vw,5.8rem)/.92 Georgia,serif;letter-spacing:-.06em}.pricing-hero h1 em,.next-step h2 em{font-style:normal;color:#d5fb98}.pricing-hero p{max-width:650px;color:rgba(255,255,255,.78);font:1rem/1.65 system-ui,sans-serif}.pricing-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:27px}.primary,.secondary{display:inline-flex;align-items:center;padding:14px 17px;border-radius:10px;font:700 .76rem/1 system-ui,sans-serif;text-decoration:none}.primary{background:#d5fb98;color:#10241f}.primary:hover{background:#e4ffc0;color:#10241f}.secondary{border:1px solid rgba(255,255,255,.3);color:#fff}.secondary:hover{background:rgba(255,255,255,.1);color:#fff}.boundary{display:block;margin-top:20px;color:rgba(255,255,255,.56);font:.7rem/1.45 system-ui,sans-serif}.plan-card{margin-top:16px;padding:31px;border:1px solid rgba(16,36,31,.1);border-radius:20px;background:#fff}.plan-head{display:flex;justify-content:space-between;gap:20px;align-items:start}.kicker{color:#267157}.plan-head h2,.extras h2,.next-step h2{margin:11px 0 7px;font:500 2.2rem/.98 Georgia,serif;letter-spacing:-.04em}.plan-head p,.extras p,.next-step p{color:var(--muted);font:.84rem/1.6 system-ui,sans-serif}.plan-label{padding:8px 10px;border-radius:999px;background:#eef5e9;color:#2c7559;font:700 .63rem/1 system-ui,sans-serif;white-space:nowrap}.included-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:25px}.included-grid div{padding:16px;border-radius:11px;background:#eef3ed}.included-grid strong,.included-grid span{display:block}.included-grid strong{font:700 .78rem/1.2 system-ui,sans-serif}.included-grid span{margin-top:6px;color:var(--muted);font:.72rem/1.45 system-ui,sans-serif}.plan-note{margin:19px 0 0;padding-top:17px;border-top:1px solid rgba(16,36,31,.1);font-size:.76rem!important}.extras{display:grid;grid-template-columns:.8fr 1.2fr;gap:44px;margin-top:64px;padding:0 20px}.extras h2{font-size:2.8rem}.extra-list{display:grid;gap:10px}.extra-list div{padding:17px 18px;border-left:3px solid #d5fb98;background:#f4f7f1}.extra-list strong,.extra-list span{display:block}.extra-list strong{font:700 .78rem/1.2 system-ui,sans-serif}.extra-list span{margin-top:6px;color:var(--muted);font:.73rem/1.45 system-ui,sans-serif}.next-step{margin-top:65px;padding:42px 48px;border-radius:20px;background:#eaf2e7}.next-step p{max-width:650px}.next-step>div{display:flex;gap:18px;flex-wrap:wrap;align-items:center;margin-top:24px}.dark{background:#10241f;color:#fff}.dark:hover{background:#28624c;color:#fff}.link{color:#1f6a51;font:700 .73rem/1.2 system-ui,sans-serif}@media(max-width:720px){.pricing-shell{padding:30px 15px 65px}.pricing-hero{padding:32px 24px}.plan-head,.extras{display:block}.plan-label{display:inline-flex;margin-top:8px}.included-grid{grid-template-columns:1fr}.extras{padding:0 8px}.extra-list{margin-top:22px}.next-step{padding:34px 26px}.next-step h2{font-size:2.35rem}}
</style>
