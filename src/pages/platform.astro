---
import Layout from '../layouts/Layout.astro';
const domains = [
  { key:'people', title:'Mennesker og mål', icon:'◎', desc:'HCM, roller, rekruttering, OKR, håndbok og opplæring.', href:'/api/domains/people?boardId=board-1', label:'People API' },
  { key:'it_assets', title:'IT og drift', icon:'▣', desc:'Eiendeler, ITSM-saker, SaaS-forbruk, MDM og lokasjon.', href:'/api/domains/it_assets?boardId=board-1', label:'IT API' },
  { key:'finance_records', title:'Økonomi og ERP', icon:'◒', desc:'Bilag, bank, lønn, skatt, SAF-T, EHF og prosjektspor.', href:'/api/domains/finance_records?boardId=board-1', label:'Finance API' },
  { key:'crm_accounts', title:'Kunder og inntekter', icon:'⌁', desc:'CRM, CPQ, salgsrom, abonnement og service desk.', href:'/api/domains/crm_accounts?boardId=board-1', label:'CRM API' },
  { key:'contracts', title:'Avtaler og eierskap', icon:'◫', desc:'Kontrakter, prokura, fullmakter, cap table og ESOP.', href:'/api/domains/contracts?boardId=board-1', label:'Contracts API' },
  { key:'sustainability_items', title:'HMS, risiko og ESG', icon:'✦', desc:'Hendelser, SJA, sikkerhetsrunder, carbon og Åpenhetsloven.', href:'/api/domains/sustainability_items?boardId=board-1', label:'GRC API' },
];
const integrations = [
  ['Altinn / NAV','Maskinporten og virksomhetsavtale','planned'],
  ['EHF / PEPPOL','Access point og fakturaflyt','planned'],
  ['Stripe Billing','Konto, priser, skatt og vilkår','configuration'],
  ['Bank / betaling','Bankavtale, PSD2 og SCA','planned'],
  ['eID / signering','Signicat/BankID og PAdES-LTV','planned'],
  ['AI / MCP','Provider, policy og ReBAC-gateway','planned'],
];
---
<Layout title="Plattform — Styr.ing" activeNav="platform">
  <main class="platform-page">
    <section class="platform-hero"><div><span class="eyebrow">Styr.ing operating system</span><h1>Én plattform for<br /><em>hele styringsbildet.</em></h1><p>Se hvordan styre, mennesker, drift, økonomi, kunder, avtaler og kontroll kan henge sammen. Dette er den operative backend-kjernen og den end-user arbeidsflaten i samme produkt.</p><div class="hero-actions"><a href="/workspace" class="primary">Åpne arbeidsflaten ↗</a><a href="/trust" class="secondary">Se sikkerhet og AI-vakt</a></div></div><div class="hero-orb"><div class="orb-core">styr<span>.</span>ing<small>D1 + API + arbeidsflate</small></div><i class="orb-node n1">Mennesker</i><i class="orb-node n2">Økonomi</i><i class="orb-node n3">Kontroll</i><i class="orb-node n4">Kunder</i></div></section>
    <section class="live-card"><div class="live-head"><div><span class="section-kicker">Live backend</span><h2>Operative domener</h2></div><span id="live-summary">Sjekker D1…</span></div><div class="domain-grid">{domains.map((domain) => <article class="domain-card" data-domain={domain.key}><div class="domain-icon">{domain.icon}</div><div><h3>{domain.title}</h3><p>{domain.desc}</p><span class="domain-count">Sjekker rader…</span></div><a href={domain.href} aria-label={`Åpne ${domain.label}`}>↗</a></article>)}</div></section>
    <section class="integration-section"><div class="section-heading"><div><span class="section-kicker">Koblede tjenester</span><h2>Adapterstatus uten gråsoner</h2></div><p>Styr.ing skiller mellom en ferdig intern arbeidsflate og en ekstern tjeneste som krever credentials, kontrakt, sikkerhet og juridisk godkjenning.</p></div><div class="integration-grid">{integrations.map((item) => <div class="integration-card"><span class={`status-dot status-${item[2]}`}></span><div><strong>{item[0]}</strong><span>{item[1]}</span></div><b>{item[2] === 'configuration' ? 'Oppsett' : 'Planlagt'}</b></div>)}</div></section>
    <section class="next-section"><span class="section-kicker">Neste for sluttbrukeren</span><h2>Start der du er.<br /><em>Bygg videre uten å miste sporet.</em></h2><div class="next-grid"><a href="/board/board-1"><strong>01 · Beslutt</strong><span>Åpne møte, vedtak og protokoll</span>↗</a><a href="/operations"><strong>02 · Følg opp</strong><span>Se samlet operativ kø</span>↗</a><a href="/capabilities"><strong>03 · Utvid</strong><span>Utforsk hele produktkartet</span>↗</a></div></section>
  </main>
</Layout>
<script is:inline>
  const cards = [...document.querySelectorAll('[data-domain]')];
  Promise.all(cards.map(async (card) => { const key = card.getAttribute('data-domain'); try { const r = await fetch(`/api/domains/${key}?boardId=board-1`); const data = await r.json(); const count = Array.isArray(data.data) ? data.data.length : 0; const target = card.querySelector('.domain-count'); if (target) target.textContent = `${count} illustrerte rader i D1`; return count; } catch { const target = card.querySelector('.domain-count'); if (target) target.textContent = 'API ikke tilgjengelig i preview'; return 0; } })).then((counts) => { const target = document.getElementById('live-summary'); if (target) target.textContent = `${counts.length} domener · ${counts.reduce((a,b) => a+b, 0)} rader i D1`; });
</script>
<style>
.platform-page{max-width:1180px;margin:0 auto;padding:0 24px 80px}.platform-hero{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:center;padding:70px 0 80px}.eyebrow,.section-kicker{font:700 .68rem/1 system-ui,sans-serif;letter-spacing:.15em;text-transform:uppercase;color:var(--accent)}.platform-hero h1{font-size:clamp(3rem,6vw,5.2rem);line-height:.94;letter-spacing:-.065em;font-weight:500;margin:20px 0}.platform-hero h1 em,.next-section h2 em{font-style:normal;color:var(--accent)}.platform-hero p{max-width:540px;color:var(--muted);font:1rem/1.65 system-ui,sans-serif}.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}.primary,.secondary{display:inline-flex;padding:13px 17px;border-radius:10px;font:700 .78rem/1 system-ui,sans-serif}.primary{background:#10241f;color:#fff}.secondary{color:var(--ink);border:1px solid rgba(16,36,31,.15)}.hero-orb{position:relative;min-height:370px;border-radius:50%;background:radial-gradient(circle,#e8f4d8 0%,#d4e7d0 36%,rgba(212,231,208,.1) 66%,transparent 67%);display:grid;place-items:center}.orb-core{width:155px;height:155px;border-radius:50%;display:grid;place-items:center;align-content:center;background:#10241f;color:#c4f392;font:500 1.45rem Georgia,serif;box-shadow:0 20px 45px rgba(16,36,31,.2)}.orb-core span{color:#fff}.orb-core small{display:block;color:#a9beb1;font:600 .52rem system-ui,sans-serif;margin-top:8px}.orb-node{position:absolute;padding:9px 13px;border-radius:999px;background:#fff;border:1px solid rgba(16,36,31,.12);box-shadow:0 8px 18px rgba(16,36,31,.1);font:700 .67rem system-ui,sans-serif;font-style:normal;color:var(--ink)}.n1{top:24px;left:19%}.n2{top:46%;right:0}.n3{bottom:29px;left:23%}.n4{top:45%;left:0}.live-card{padding:32px;border-radius:18px;background:#f4f8f1;border:1px solid rgba(31,111,91,.13)}.live-head,.section-heading{display:flex;justify-content:space-between;align-items:end;gap:15px;margin-bottom:22px}.live-head h2,.section-heading h2{margin:10px 0 0;font-size:2rem;letter-spacing:-.04em;font-weight:500}.live-head>span{font:600 .72rem system-ui,sans-serif;color:var(--accent)}.domain-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.domain-card{display:grid;grid-template-columns:38px 1fr 18px;gap:11px;padding:17px;background:#fff;border:1px solid rgba(16,36,31,.08);border-radius:12px}.domain-icon{display:grid;place-items:center;width:34px;height:34px;border-radius:9px;background:#e8f1e5;color:var(--accent);font-size:1.1rem}.domain-card h3{margin:0;font:700 .84rem system-ui,sans-serif}.domain-card p{margin:5px 0 10px;color:var(--muted);font:.7rem/1.4 system-ui,sans-serif}.domain-card a{color:var(--accent);font-weight:700}.domain-count{font:600 .64rem system-ui,sans-serif;color:#6ca171}.integration-section{padding:80px 0}.section-heading{align-items:start}.section-heading p{max-width:390px;margin:0;color:var(--muted);font:.82rem/1.55 system-ui,sans-serif}.integration-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:9px}.integration-card{display:flex;align-items:center;gap:11px;padding:14px 16px;background:#fff;border:1px solid rgba(16,36,31,.09);border-radius:11px}.integration-card>div{display:flex;flex-direction:column;gap:4px;flex:1}.integration-card strong{font:700 .78rem system-ui,sans-serif}.integration-card span:not(.status-dot){color:var(--muted);font:.68rem system-ui,sans-serif}.integration-card b{font:700 .64rem system-ui,sans-serif;color:#a17a32}.status-dot{width:8px;height:8px;border-radius:50%;background:#d2a34b}.status-configuration{background:#75bd7a}.next-section{padding:50px 0}.next-section h2{font-size:clamp(2.2rem,4vw,3.5rem);line-height:.98;font-weight:500;letter-spacing:-.05em;margin:14px 0 28px}.next-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.next-grid a{display:grid;grid-template-columns:1fr 20px;gap:9px;padding:19px;border:1px solid rgba(16,36,31,.1);border-radius:12px;background:#fff;color:var(--ink)}.next-grid strong{font:700 .76rem system-ui,sans-serif}.next-grid span{grid-column:1;color:var(--muted);font:.74rem system-ui,sans-serif}.next-grid a{font-size:1rem}.next-grid a:hover{border-color:var(--accent);transform:translateY(-2px)}
@media(max-width:820px){.platform-hero{grid-template-columns:1fr;padding-top:45px}.hero-orb{min-height:300px;max-width:500px;margin:auto}.domain-grid{grid-template-columns:repeat(2,1fr)}.section-heading{flex-direction:column}.next-grid{grid-template-columns:1fr}}
@media(max-width:560px){.platform-page{padding:0 16px 55px}.platform-hero h1{font-size:3.2rem}.live-card{padding:20px}.domain-grid,.integration-grid{grid-template-columns:1fr}.live-head{align-items:start;flex-direction:column}.orb-node{font-size:.58rem}.n1{left:5%}.n3{left:8%}.n2{right:-2%}.n4{left:-2%}}
</style>
