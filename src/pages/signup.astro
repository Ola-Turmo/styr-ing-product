---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Ingen selvbetjent registrering" activeNav="">
  <div class="container" style="max-width: 440px; margin: 4rem auto; padding: 0 20px;">
    <h1 style="font-size: 1.8rem; margin-bottom: 0.5rem;">Ingen selvbetjent registrering</h1>
    <p style="font-family: system-ui, sans-serif; color: var(--muted); margin: 0 0 2rem 0;">
      Den offentlige siden oppretter ikke kontoer og samler ikke inn registreringsdata. Styr.ing er ikke et separat aktivt tilbud.
    </p>

    <div style="text-align: center; margin-top: 1.5rem; padding: 1rem; background: rgba(31,111,91,0.06); border-radius: 10px;">
      <p style="font-family: system-ui, sans-serif; font-size: 0.85rem; color: var(--muted); margin: 0;">
        <a href="https://samsvarlig.no/" style="display:inline-block; background:var(--accent); color:white; padding:12px 22px; border-radius:999px; font-weight:600;">Se aktivt kontrolltilbud</a>
      </p>
    </div>
  </div>
</Layout>
