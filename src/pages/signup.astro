---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Be om tilgang — Styr.ing" activeNav="login">
  <main class="request-shell">
    <span class="section-kicker">Tilgang avtales separat</span>
    <h1>Ingen selvbetjent registrering.</h1>
    <p>Styr.ing er SaaS-only. En administrator oppretter brukere etter godkjent kundeavtale, og knytter dem til riktig virksomhet og rolle.</p>
    <div class="request-actions"><a href="mailto:ola@styr.ing?subject=Be%20om%20Styr.ing-tilgang">Be om tilgang på e-post ↗</a><a href="/login">Til innlogging</a></div>
  </main>
</Layout>
<style>.request-shell{max-width:650px;margin:0 auto;padding:90px 24px 120px}.request-shell h1{font:500 clamp(2.5rem,6vw,4.5rem)/.95 Georgia,serif;letter-spacing:-.06em;margin:17px 0}.request-shell p{max-width:520px;color:var(--muted);font:.94rem/1.65 system-ui,sans-serif}.request-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.request-actions a{padding:13px 16px;border-radius:9px;background:var(--night);color:#fff;font:700 .74rem/1 system-ui,sans-serif}.request-actions a+ a{background:#e8f1df;color:var(--accent)}</style>
