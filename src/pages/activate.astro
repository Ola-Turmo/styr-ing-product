---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Aktiver tilgang — Styr.ing" activeNav="login">
  <main class="activate-shell"><section class="activate-card"><span class="section-kicker">Sikker invitasjon</span><h1>Aktiver<br /><em>tilgangen din.</em></h1><p>Velg et passord på minst 12 tegn. Invitasjonen kan bare brukes én gang og utløper etter 24 timer.</p><form id="activate-form"><label for="password">Nytt passord</label><input id="password" type="password" minlength="12" autocomplete="new-password" required /><button>Aktiver konto ↗</button><p id="status" role="status"></p></form><a href="/login">Har du allerede tilgang? Logg inn</a></section></main>
</Layout>
<script is:inline>
  const token = new URLSearchParams(location.search).get('token') || ''; const form=document.querySelector('#activate-form'); const status=document.querySelector('#status');
  form?.addEventListener('submit',async(e)=>{e.preventDefault();status.textContent='Aktiverer…';const r=await fetch('/api/auth',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({action:'activate_invite',token,password:document.querySelector('#password').value})});const d=await r.json();if(!r.ok){status.textContent=d.error==='invite_invalid_or_expired'?'Lenken er utløpt eller allerede brukt. Be administratoren om en ny invitasjon.':'Kunne ikke aktivere tilgangen.';return}status.textContent='Aktivert. Åpner arbeidsflaten…';location.href=`/app?boardId=${encodeURIComponent(d.boardId)}`;});
</script>
<style>.activate-shell{max-width:560px;margin:0 auto;padding:80px 24px 120px}.activate-card{padding:34px;border-radius:22px;background:#fff;border:1px solid rgba(16,36,31,.1);box-shadow:0 20px 55px rgba(16,36,31,.1)}.activate-card h1{font:500 clamp(2.7rem,7vw,4.6rem)/.92 Georgia,serif;letter-spacing:-.06em;margin:16px 0}.activate-card h1 em{font-style:normal;color:var(--accent)}.activate-card p{color:var(--muted);font:.86rem/1.6 system-ui,sans-serif}.activate-card label{display:block;margin:22px 0 7px;font:700 .7rem/1 system-ui,sans-serif}.activate-card input{width:100%;box-sizing:border-box;padding:13px;border:1px solid rgba(16,36,31,.18);border-radius:9px}.activate-card button{width:100%;margin-top:17px;padding:14px;border:0;border-radius:9px;background:var(--night);color:#fff;font:700 .78rem/1 system-ui,sans-serif}.activate-card #status{min-height:1.2em;color:#9b5b25;font-weight:600}.activate-card a{display:inline-block;margin-top:15px;color:var(--accent);font:700 .7rem/1 system-ui,sans-serif}</style>
