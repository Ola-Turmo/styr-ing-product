---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Felt og prosjekt" activeNav="field"><main class="field-shell"><section class="field-hero"><div><span class="eyebrow">Styr.ing · felt og prosjekt</span><h1>Koble arbeidet<br /><em>til kostnaden.</em></h1><p>Få kjørebok, vedlikehold, FDV, prosjekter, timer og fakturagrunnlag inn i samme spor — med et tydelig stoppunkt før skatte- eller fakturagrunnlag godkjennes.</p><a href="#field-work" class="primary">Åpne feltbildet ↓</a></div><div class="field-orb"><strong id="hero-projects">—</strong><span>aktive prosjekter</span><small id="hero-hours">— timer i kø</small></div></section><section class="metrics"><article><span>Aktive kjøretøy</span><strong id="m-fleet">—</strong><small>med neste kontroll</small></article><article><span>Kjørebok</span><strong id="m-trips">—</strong><small>turer mangler klassifisering</small></article><article><span>Fakturagrunnlag</span><strong id="m-wip">—</strong><small>godkjente timer i verdi</small></article><article class="dark"><span>Feltoppgaver</span><strong id="m-facilities">—</strong><small>FDV/HMS krever oppfølging</small></article></section><section id="field-work" class="workspace"><div class="head"><div><span class="kicker">Operativt feltregister</span><h2 id="view-title">Kjøretøy og kjørebok</h2></div><span id="status">Henter…</span></div><nav class="tabs">{[['fleet','Kjøretøy'],['trips','Kjørebok'],['maintenance','Vedlikehold'],['facilities','FDV'],['projects','Prosjekter'],['rates','Priser og margin'],['time','Timer'],['wip','WIP'],['invoice_drafts','Fakturautkast']].map(([key,label],i)=><button class={i===0?'active':''} data-view={key}>{label}</button>)}</nav><div id="list"></div></section><section class="notice"><strong>Produksjonsgrense</strong><p>GPS, Skatteetaten-beregning, fakturering og EHF-utsending krever samtykke, datakilder, leverandøravtaler og menneskelig kontroll. Styr.ing viser grunnlaget — den sender eller rapporterer ikke automatisk.</p></section></main></Layout>
<script is:inline>
const esc=v=>String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));const list=document.getElementById('list');const status=document.getElementById('status');const labels={active:'Aktiv',draft:'Utkast',classified:'Klassifisert',approved:'Godkjent',scheduled:'Planlagt',open:'Åpen',submitted:'Innsendt',complete:'Ferdig',hourly:'Timepris'};const pill=v=>`<em class="pill">${esc(labels[v]||v||'—')}</em>`;const money=(n)=>`${new Intl.NumberFormat('nb-NO').format(Number(n||0)/100)} NOK`;
const render=(view,rows)=>{const f={fleet:r=>`<article><div><strong>${esc(r.registration)} · ${esc(r.make_model)}</strong><p>${esc(r.owner_name||'Uten eier')} · ${esc(r.odometer_km)} km</p></div>${pill(r.status)}<small>EU-kontroll ${esc(r.next_inspection_date||'—')}</small></article>`,trips:r=>`<article><div><strong>${esc(r.trip_date)} · ${esc(r.start_location)} → ${esc(r.end_location)}</strong><p>${esc(r.driver_name||'Ukjent fører')} · ${esc(r.purpose||'Uten formål')}</p></div>${pill(r.status)}${pill(r.trip_type)}<small>${esc(r.distance_km)} km</small></article>`,maintenance:r=>`<article><div><strong>${esc(r.title)}</strong><p>${esc(r.registration)} · ${esc(r.vendor||'Leverandør ikke satt')}</p></div>${pill(r.status)}<small>Frist ${esc(r.due_date)} · ${money(r.cost_minor)}</small></article>`,facilities:r=>`<article><div><strong>${esc(r.name)}</strong><p>${esc(r.address||'Adresse ikke satt')} · ${esc(r.owner_name||'Uten eier')}</p></div>${pill(r.status)}<small>FDV-objekt</small></article>`,projects:r=>`<article><div><strong>${esc(r.code)} · ${esc(r.name)}</strong><p>${esc(r.company_name||'Internt prosjekt')} · ${esc(r.billing_model)}</p></div>${pill(r.status)}<small>Budsjett ${money(r.budget_minor)}</small></article>`,rates:r=>`<article><div><strong>${esc(r.project_name)} · ${esc(r.role)}</strong><p>Pris ${money(r.hourly_minor)}/t · kostbasis ${money(r.cost_hourly_minor)}/t</p></div>${pill(r.source||'manual')}<small>Gyldig fra ${esc(r.valid_from||'—')} · dekningsgrad ${Math.round((1-Number(r.cost_hourly_minor||0)/Math.max(1,Number(r.hourly_minor||0)))*100)}%</small></article>`,time:r=>`<article><div><strong>${esc(r.work_date)} · ${esc(r.project_code)} · ${esc(r.person_name)}</strong><p>${esc(r.description||'Uten beskrivelse')} · ${r.billable?'Fakturerbar':'Ikke fakturerbar'}</p></div>${pill(r.status)}<small>${Math.round(Number(r.minutes||0)/60*10)/10} t</small></article>`,wip:r=>`<article><div><strong>${esc(r.code)} · ${esc(r.name)}</strong><p>${esc(r.company_name||'Internt prosjekt')} · ${esc(r.entry_count||0)} godkjente fakturerbare timer</p></div><span><b>${money(r.amount_minor)}</b><small>kost ${money(r.cost_minor)} · margin ${money(Number(r.amount_minor||0)-Number(r.cost_minor||0))}</small></span></article>`,invoice_drafts:r=>`<article><div><strong>${esc(r.code)} · ${esc(r.period)} fakturautkast</strong><p>${esc(r.company_name||'Uten kunde')} · ${esc(r.source_minutes||0)} minutter fra timer</p></div>${pill(r.status)}<b>${money(r.amount_minor)}</b></article>`};list.innerHTML=rows.length?rows.map(f[view]).join(''):'<p class="empty">Ingen registrerte rader.</p>';};
const load=async view=>{try{const r=await fetch(`/api/field?boardId=board-1&view=${view}`),d=await r.json();render(view,d.data||[]);status.textContent=`${(d.data||[]).length} poster · kilde synlig`;}catch{status.textContent='API utilgjengelig'}};const summary=async()=>{try{const r=await fetch('/api/field?boardId=board-1&view=summary'),d=(await r.json()).data||{};document.getElementById('m-fleet').textContent=d.fleet?.count??0;document.getElementById('m-trips').textContent=d.trips?.count??0;document.getElementById('m-wip').textContent=money(d.wip?.amount_minor);document.getElementById('m-facilities').textContent=d.facilities?.count??0;document.getElementById('hero-projects').textContent=d.projects?.count??0;document.getElementById('hero-hours').textContent=`${Math.round(Number(d.time?.minutes||0)/60*10)/10} timer i kø`;}catch{}};document.querySelectorAll('.tabs button').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.tabs button').forEach(x=>x.classList.remove('active'));b.classList.add('active');load(b.dataset.view)}));summary();load('fleet');
</script>
<style>.field-shell{max-width:1180px;margin:0 auto;padding:38px 24px 80px}.field-hero{display:grid;grid-template-columns:1fr .45fr;align-items:center;gap:24px;padding:44px;border-radius:27px;background:linear-gradient(120deg,#263a43,#35707a);color:#fff}.eyebrow,.kicker{font:700 .68rem system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:#c5eee7}.field-hero h1{margin:20px 0 16px;font:500 clamp(2.5rem,5vw,4.4rem)/.96 Georgia,serif}.field-hero h1 em{color:#c3f3bc;font-style:normal}.field-hero p{max-width:570px;color:#ffffffbf;font:1rem/1.6 system-ui,sans-serif}.primary{display:inline-flex;margin-top:22px;padding:13px 17px;border-radius:10px;background:#c8f4bf;color:#21413d;font:700 .78rem system-ui,sans-serif}.field-orb{width:190px;height:190px;display:flex;flex-direction:column;align-items:center;justify-content:center;border:1px solid #c5eee7aa;border-radius:50%;background:#255763;color:#fff}.field-orb strong{font:500 3.2rem Georgia,serif;color:#d0ffc4}.field-orb span,.field-orb small{font:.68rem system-ui,sans-serif}.field-orb small{margin-top:9px;color:#b9dfdb}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:16px 0 52px}.metrics article{min-height:105px;padding:17px;border:1px solid #10241f14;border-radius:15px;background:#fff;display:flex;flex-direction:column;justify-content:space-between}.metrics .dark{background:#10241f;color:#fff}.metrics span,.metrics small{color:#718078;font:600 .67rem system-ui,sans-serif}.metrics strong{font:500 1.7rem Georgia,serif}.metrics small{color:#478f68}.workspace{padding:28px;border:1px solid #10241f18;border-radius:20px;background:#fff}.head{display:flex;justify-content:space-between;align-items:end}.head h2{margin:9px 0 0;font:500 2.1rem Georgia,serif}.head>span{color:#718078;font:.7rem system-ui,sans-serif}.tabs{display:flex;gap:6px;overflow:auto;margin:25px 0 12px}.tabs button{padding:10px 14px;border:1px solid #10241f1c;border-radius:9px;background:#fafbf9;color:#65746b;cursor:pointer;font:700 .72rem system-ui,sans-serif;white-space:nowrap}.tabs button.active{background:#255763;color:#fff}.workspace article{display:grid;grid-template-columns:1.6fr auto auto;gap:12px;align-items:center;padding:15px 4px;border-top:1px solid #10241f12}.workspace strong{font:600 .82rem system-ui,sans-serif}.workspace p,.workspace small{margin:5px 0 0;color:#718078;font:.7rem/1.35 system-ui,sans-serif}.pill{padding:5px 8px;border-radius:999px;background:#e9f3f5;color:#286977;font:700 .61rem system-ui,sans-serif;font-style:normal;white-space:nowrap}.notice{margin-top:35px;padding:22px 25px;border-radius:16px;background:#edf5f3}.notice strong{font:700 .78rem system-ui,sans-serif}.notice p{margin:8px 0 0;color:#63736a;font:.78rem/1.5 system-ui,sans-serif}@media(max-width:800px){.field-hero{grid-template-columns:1fr}.metrics{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.field-shell{padding:20px 15px 55px}.field-hero{padding:28px 22px}.metrics{grid-template-columns:1fr}.workspace{padding:20px 16px}.head{align-items:start;flex-direction:column;gap:9px}.workspace article{grid-template-columns:1fr auto}.workspace article small{grid-column:1}}
</style>
