---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Kundeområde — Styr.ing" activeNav="workspace">
  <main class="app-shell">
    <section id="app-loading" class="app-state"><span class="section-kicker">Kundeområde</span><h1>Henter virksomheten din.</h1><p>Sjekker tilgang og laster de siste styringssignalene.</p></section>
    <section id="app-error" class="app-state" hidden><span class="section-kicker">Tilgang</span><h1 id="error-title">Kunne ikke åpne kundeområdet.</h1><p id="error-copy">Prøv å logge inn på nytt, eller kontakt administratoren for virksomheten.</p><a class="app-button" href="/login">Gå til innlogging ↗</a></section>
    <div id="app-content" hidden>
      <header class="app-header"><div><span class="section-kicker">Styr.ing · kundeområde</span><h1 id="board-name">—</h1><p id="board-description">—</p></div><div class="app-header-actions"><span id="board-role" class="role-pill">—</span><a href="/privacy-center">Personvern</a><button id="logout" type="button">Logg ut</button></div></header>
      <section class="app-alert" id="app-alert" hidden><strong id="alert-title">—</strong><span id="alert-copy">—</span><a id="alert-link" href="/risk">Se oppfølging ↗</a></section>
      <section class="app-stats" aria-label="Nøkkeltall"><article><small>Åpne oppgaver</small><strong id="stat-actions">—</strong><span id="stat-actions-note">—</span></article><article><small>Risikoer til vurdering</small><strong id="stat-risks">—</strong><span id="stat-risks-note">—</span></article><article><small>Kontroller</small><strong id="stat-controls">—</strong><span id="stat-controls-note">—</span></article><article><small>Kommende møter</small><strong id="stat-meetings">—</strong><span id="stat-meetings-note">—</span></article></section>
      <section class="app-grid"><article class="app-card"><div class="card-head"><div><span class="section-kicker">Neste steg</span><h2>Det som trenger oppmerksomhet</h2></div><a class="tenant-link" data-view="operations" href="/app/arbeidsflate?view=operations">Åpne cockpit ↗</a></div><div id="priority-list" class="priority-list"></div></article><article class="app-card"><div class="card-head"><div><span class="section-kicker">Snarveier</span><h2>Arbeidsflater</h2></div></div><div class="shortcut-grid"><a class="tenant-link" data-view="operations" href="/app/arbeidsflate?view=operations"><strong>Operativ cockpit</strong><span>Signalene på tvers ↗</span></a><a class="tenant-link" data-view="board" href="/app/arbeidsflate?view=board"><strong>Styre og møter</strong><span>Saker, vedtak og oppfølging ↗</span></a><a class="tenant-link" data-view="risk" href="/app/arbeidsflate?view=risk"><strong>Risiko</strong><span>Register og tiltak ↗</span></a><a class="tenant-link" data-view="controls" href="/app/arbeidsflate?view=controls"><strong>Internkontroll</strong><span>Kontroller og status ↗</span></a><a class="tenant-link" data-view="finance" href="/app/arbeidsflate?view=finance"><strong>Økonomi</strong><span>Bilag og kontrollspor ↗</span></a><a class="tenant-link" data-view="people" href="/app/arbeidsflate?view=people"><strong>Mennesker og mål</strong><span>Roller og fremdrift ↗</span></a><a href="/app/hcm"><strong>People og HCM</strong><span>Kandidater, håndbok og læring ↗</span></a><a href="/app/governance"><strong>Avtaler og eierskap</strong><span>Fullmakter, cap table og redlines ↗</span></a><a href="/trust"><strong>Tillit</strong><span>Tilgang og avtalegrunnlag ↗</span></a></div></article></section>
      <section class="app-card finance-callout"><div><span class="section-kicker">Økonomi og flyt</span><h2>Fra kilde til kontroll.</h2><p>Eiendeler, firmakort, inntektsplaner og innkjøp i egne visninger — med godkjenning før bokføring eller eksterne steg.</p></div><a class="app-button" href="/app/finance">Åpne økonomiflaten ↗</a></section><section class="app-card finance-callout intelligence-callout"><div><span class="section-kicker">Søk og assistent</span><h2>Finn tråden med kilden synlig.</h2><p>Universelt søk, kildebaserte AI-utkast og event mesh i en kontrollert tenant-flate.</p></div><a class="app-button" href="/app/intelligence">Åpne plattformflaten ↗</a></section>
      <section class="app-card integration-card"><div class="card-head"><div><span class="section-kicker">Kildestatus</span><h2>Integrasjoner og datakilder</h2></div><a id="integration-link" href="/platform">Se plattformstatus ↗</a></div><div id="integration-list" class="integration-list"></div><p class="boundary">Status viser kun registrerte kilder. Innsending, betaling og endringer krever særskilt avtale, tilgang og menneskelig godkjenning.</p></section>
    </div>
  </main>
</Layout>
<script is:inline>
  const qs = (selector) => document.querySelector(selector);
  const escapeHtml = (value) => String(value ?? '').replace(/[&<>'\"]/g, (c) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', "'":'&#39;', '\"':'&quot;' }[c]));
  const state = (error, title, copy) => { qs('#app-loading').hidden = true; qs('#app-content').hidden = true; qs('#app-error').hidden = false; qs('#error-title').textContent = title; qs('#error-copy').textContent = copy || error; };
  const first = (value) => Array.isArray(value) ? value[0] : value;
  const load = async () => {
    try {
      const authResponse = await fetch('/api/auth');
      const auth = await authResponse.json();
      if (!auth.authenticated) { window.location.href = `/login?next=${encodeURIComponent(location.pathname + location.search)}`; return; }
      const requested = new URLSearchParams(location.search).get('boardId');
      const boards = Array.isArray(auth.boards) ? auth.boards : [];
      const selected = boards.find((board) => board.id === requested) || boards[0];
      if (!selected) { state('Ingen aktiv virksomhet er knyttet til brukeren.', 'Ingen virksomhet er koblet til kontoen.', 'Be en administrator om en invitasjon til riktig virksomhet.'); return; }
      const response = await fetch(`/api/board/${encodeURIComponent(selected.id)}`);
      const payload = await response.json();
      if (!response.ok || !payload.data?.board) { state(payload.error || 'board_load_failed', 'Virksomheten kunne ikke lastes.', 'Tilgangen kan ha blitt endret. Kontakt administratoren hvis problemet fortsetter.'); return; }
      const data = payload.data;
      const board = data.board;
      qs('#app-loading').hidden = true; qs('#app-error').hidden = true; qs('#app-content').hidden = false;
      qs('#board-name').textContent = board.name || 'Virksomhet'; qs('#board-description').textContent = board.description || 'Samlet arbeidsflate for styre og virksomhet.'; qs('#board-role').textContent = selected.role === 'owner' ? 'Eier' : selected.role === 'editor' ? 'Redaktør' : 'Leser';
      const actions = data.actions || []; const risks = data.risks || []; const controls = data.controls || []; const meetings = data.meetings || [];
      const openActions = actions.filter((item) => !['completed','done','closed'].includes(item.status)); const openRisks = risks.filter((item) => !['closed','resolved'].includes(item.status)); const openControls = controls.filter((item) => item.status !== 'green'); const upcoming = meetings.filter((item) => !['completed','cancelled'].includes(item.status));
      qs('#stat-actions').textContent = openActions.length; qs('#stat-actions-note').textContent = `${openActions.filter((item) => ['critical','high'].includes(item.priority)).length} med høy prioritet`; qs('#stat-risks').textContent = openRisks.length; qs('#stat-risks-note').textContent = `${openRisks.filter((item) => ['critical','high'].includes(item.level)).length} høy alvorlighet`; qs('#stat-controls').textContent = controls.length; qs('#stat-controls-note').textContent = `${openControls.length} krever vurdering`; qs('#stat-meetings').textContent = upcoming.length; qs('#stat-meetings-note').textContent = first(upcoming)?.date || 'Ingen dato satt';
      document.querySelectorAll('.tenant-link').forEach((link) => { link.href = `/app/arbeidsflate?boardId=${encodeURIComponent(selected.id)}&view=${encodeURIComponent(link.dataset.view || 'board')}`; });
      const priorities = [...openActions.slice(0,3).map((item) => ({ label: item.title, meta: `Oppgave · ${item.due_date || 'frist ikke satt'}`, tone: ['critical','high'].includes(item.priority) ? 'warn' : 'neutral', href: `/app/arbeidsflate?boardId=${encodeURIComponent(selected.id)}&view=board` })), ...openRisks.slice(0,2).map((item) => ({ label: item.title, meta: `Risiko · ${item.owner || 'eier ikke satt'}`, tone: ['critical','high'].includes(item.level) ? 'warn' : 'neutral', href: `/app/arbeidsflate?boardId=${encodeURIComponent(selected.id)}&view=risk` }))];
      qs('#priority-list').innerHTML = priorities.length ? priorities.slice(0,5).map((item) => `<a class="priority-row" href="${item.href}"><i class="${item.tone}"></i><span><strong>${escapeHtml(item.label)}</strong><small>${escapeHtml(item.meta)}</small></span><b>↗</b></a>`).join('') : '<p class="empty">Ingen åpne punkter i denne visningen.</p>';
      const integrations = data.integrations || []; qs('#integration-list').innerHTML = integrations.length ? integrations.map((item) => `<div class="integration-row"><span><strong>${escapeHtml(item.display_name || item.key)}</strong><small>${escapeHtml(item.domain || 'Kilde')} · ${escapeHtml(item.residency || 'EEA')}</small></span><em class="status-${escapeHtml(item.status)}">${escapeHtml(item.status || 'ukjent')}</em></div>`).join('') : '<p class="empty">Ingen registrerte integrasjoner.</p>';
      qs('#app-alert').hidden = !openControls.length && !openRisks.some((item) => ['critical','high'].includes(item.level)); if (!qs('#app-alert').hidden) { qs('#alert-title').textContent = `${openControls.length + openRisks.filter((item) => ['critical','high'].includes(item.level)).length} punkter krever vurdering`; qs('#alert-copy').textContent = 'Se kilden før neste beslutning.'; }
    } catch { state('network_error', 'Kundeområdet er midlertidig utilgjengelig.', 'Prøv igjen om litt.'); }
  };
  qs('#logout')?.addEventListener('click', async () => { await fetch('/api/auth', { method:'POST', headers:{'content-type':'application/json'}, body:JSON.stringify({ action:'logout' }) }); window.location.href = '/'; });
  load();
</script>
<style>
  .app-shell{max-width:1180px;margin:0 auto;padding:46px 24px 88px}.app-header{display:flex;justify-content:space-between;gap:28px;align-items:flex-end;margin-bottom:26px}.app-header h1{margin:12px 0 6px;font:500 clamp(2.6rem,6vw,4.6rem)/.95 Georgia,serif;letter-spacing:-.06em}.app-header p{margin:0;color:var(--muted);font:.88rem/1.5 system-ui,sans-serif}.app-header-actions{display:flex;align-items:center;gap:12px;flex-wrap:wrap;font:600 .7rem/1 system-ui,sans-serif}.app-header-actions a,.app-header-actions button{color:var(--accent);background:none;border:0;padding:0;cursor:pointer;font:inherit}.role-pill{padding:7px 10px;border-radius:999px;background:#e8f1df;color:var(--accent)}.app-state{max-width:620px;margin:90px auto;text-align:center}.app-state h1{margin:14px 0;font:500 clamp(2.5rem,6vw,4.5rem)/.95 Georgia,serif;letter-spacing:-.06em}.app-state p{color:var(--muted);font:.9rem/1.6 system-ui,sans-serif}.app-button{display:inline-flex;margin-top:14px;padding:12px 16px;border-radius:10px;background:var(--night);color:#fff;font:700 .75rem/1 system-ui,sans-serif}.app-alert{display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:15px 18px;border:1px solid rgba(203,139,55,.3);border-radius:13px;background:#fff4df;color:#764c18;font:.75rem/1.4 system-ui,sans-serif;margin-bottom:18px}.app-alert strong{color:#513410}.app-alert span{flex:1}.app-alert a{color:#8d5e1e;font-weight:700}.app-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:11px;margin-bottom:18px}.app-stats article,.app-card{background:#fff;border:1px solid rgba(16,36,31,.09);border-radius:16px}.app-stats article{padding:18px;min-height:112px}.app-stats small,.app-stats span{display:block;color:var(--muted);font:600 .68rem/1.35 system-ui,sans-serif}.app-stats strong{display:block;margin:12px 0 5px;font:500 2rem/1 Georgia,serif}.app-stats span{color:var(--accent)}.app-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:18px}.app-card{padding:22px;margin-bottom:18px}.card-head{display:flex;justify-content:space-between;align-items:start;gap:14px;margin-bottom:14px}.card-head h2{margin:8px 0 0;font:500 1.5rem/1.05 Georgia,serif;letter-spacing:-.04em}.card-head a{color:var(--accent);font:700 .68rem/1.2 system-ui,sans-serif;white-space:nowrap}.priority-list,.integration-list{display:grid;gap:2px}.priority-row,.integration-row{display:flex;align-items:center;gap:11px;padding:12px 0;border-bottom:1px solid rgba(16,36,31,.07);color:var(--ink)}.priority-row:last-child,.integration-row:last-child{border-bottom:0}.priority-row i{width:8px;height:8px;border-radius:50%;background:#76b76f;flex:none}.priority-row i.warn{background:#d69738}.priority-row span,.integration-row span{display:grid;gap:3px;flex:1}.priority-row strong,.integration-row strong{font:700 .78rem/1.25 system-ui,sans-serif}.priority-row small,.integration-row small{color:var(--muted);font:.68rem/1.3 system-ui,sans-serif}.priority-row b{color:var(--accent)}.shortcut-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.shortcut-grid a{display:grid;gap:7px;padding:13px;border-radius:10px;background:#f5f8f3;color:var(--ink)}.shortcut-grid a:hover{background:#e8f1df}.shortcut-grid strong{font:700 .75rem/1.2 system-ui,sans-serif}.shortcut-grid span{color:var(--muted);font:.66rem/1.35 system-ui,sans-serif}.integration-row em{font:600 .64rem/1 system-ui,sans-serif;font-style:normal;color:#9a6b25}.integration-row .status-active,.integration-row .status-connected{color:var(--accent)}.boundary,.empty{color:var(--muted);font:.7rem/1.5 system-ui,sans-serif}.boundary{margin:16px 0 0;padding-top:14px;border-top:1px solid rgba(16,36,31,.08)}
  .finance-callout{display:flex;align-items:center;justify-content:space-between;gap:20px;background:#edf5e7}.finance-callout h2{margin:8px 0 5px;font:500 1.5rem/1 Georgia,serif}.finance-callout p{max-width:650px;margin:0;color:var(--muted);font:.75rem/1.5 system-ui,sans-serif}.finance-callout .app-button{margin:0;white-space:nowrap}
  .intelligence-callout{background:#e8f0f5}.intelligence-callout .section-kicker{color:#2d6078}
  @media(max-width:820px){.app-header{align-items:start;flex-direction:column}.app-stats{grid-template-columns:repeat(2,1fr)}.app-grid{grid-template-columns:1fr}}
  @media(max-width:520px){.app-shell{padding:28px 16px 60px}.app-stats{grid-template-columns:1fr}.app-card{padding:18px}.shortcut-grid{grid-template-columns:1fr}.app-header-actions{gap:10px}.finance-callout{align-items:flex-start;flex-direction:column}.finance-callout .app-button{width:100%;justify-content:center}}
</style>
