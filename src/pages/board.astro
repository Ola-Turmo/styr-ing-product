---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Styrearbeid — Styr.ing" activeNav="workspace">
  <main class="board-gateway">
    <section class="gateway-card">
      <span class="section-kicker">Styrearbeid</span>
      <h1>Beslutninger som er lette å følge opp.</h1>
      <p>Åpne den innloggede arbeidsflaten for møter, fremmøte, habilitet, avstemninger, vedtak og protokollgrunnlag i virksomheten din.</p>
      <div class="gateway-actions">
        <a class="primary" href="/app/arbeidsflate?view=governance">Åpne styrearbeid ↗</a>
        <a class="secondary" href="/login?next=%2Fapp%2Farbeidsflate%3Fview%3Dgovernance">Logg inn</a>
      </div>
      <p class="gateway-note">Tilgang styres per virksomhet. Demo- og eksempeldata skal ikke brukes som selskapsdokumentasjon.</p>
    </section>
  </main>
</Layout>

<style>
  .board-gateway{max-width:1180px;margin:0 auto;padding:72px 24px 120px;min-height:58vh;display:grid;place-items:center}.gateway-card{width:min(100%,680px);padding:48px;border:1px solid rgba(16,36,31,.1);border-radius:22px;background:#fff;box-shadow:0 18px 45px rgba(16,36,31,.08)}.gateway-card h1{margin:14px 0;font:500 clamp(2.6rem,6vw,4.5rem)/.94 Georgia,serif;letter-spacing:-.06em;color:var(--ink)}.gateway-card>p{max-width:570px;color:var(--muted);font:.95rem/1.65 system-ui,sans-serif}.gateway-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}.gateway-actions a{display:inline-flex;align-items:center;border-radius:9px;padding:13px 16px;font:700 .75rem/1 system-ui,sans-serif}.gateway-actions .primary{background:var(--night);color:#fff}.gateway-actions .primary:hover{background:var(--accent)}.gateway-actions .secondary{color:var(--ink);border:1px solid rgba(16,36,31,.12)}.gateway-note{margin-top:30px!important;padding-top:18px;border-top:1px solid rgba(16,36,31,.09);font-size:.72rem!important}@media(max-width:560px){.board-gateway{padding:45px 16px 80px}.gateway-card{padding:30px 23px}}
</style>
