---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Tilgang" activeNav="">
  <div class="container" style="max-width: 440px; margin: 4rem auto; padding: 0 20px;">
    <h1 style="font-size: 1.8rem; margin-bottom: 0.5rem;">Tilgang avtales separat</h1>
    <p style="font-family: system-ui, sans-serif; color: var(--muted); margin: 0 0 2rem 0;">
      Denne offentlige statiske siden har ingen autentisering og tar ikke imot brukernavn eller passord.
    </p>

    <div style="text-align: center; margin-top: 1.5rem; padding: 1rem; background: rgba(31,111,91,0.06); border-radius: 10px;">
      <p style="font-family: system-ui, sans-serif; font-size: 0.85rem; color: var(--muted); margin: 0;">
        For det aktive kontrollsyklustilbudet, <a href="https://samsvarlig.no/" style="color: var(--accent); font-weight: 600;">gå til Samsvarlig</a>. Styr.ing har ingen separat aktiv tilgangsflyt.
      </p>
    </div>
  </div>
</Layout>
