---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Feriepenger og OTP" activeNav="treasury">
  <main class="pay-shell">
    <section class="pay-hero"><div><span class="eyebrow">Styr.ing · payroll compliance</span><h1>Regn ut.<br /><em>Gjennomgå før innsending.</em></h1><p>Se feriepenger og OTP som et tydelig kontrollgrunnlag fra siste lønnskjøring. Satsene kan justeres av ansvarlig lønnsfører; ingenting sendes automatisk.</p></div><div class="pay-orb"><strong id="pay-total">—</strong><span>ferie + OTP</span><small id="pay-status">Henter…</small></div></section>
    <section class="pay-metrics"><article><span>Feriepenger</span><strong id="pay-holiday">—</strong><small id="pay-holiday-rate">—</small></article><article><span>OTP</span><strong id="pay-otp">—</strong><small id="pay-otp-rate">—</small></article><article><span>Ansatte</span><strong id="pay-people">—</strong><small>i grunnlaget</small></article><article class="dark"><span>Altinn / NAV</span><strong>STOPP</strong><small>adapter ikke aktivert</small></article></section>
    <section class="pay-card"><div class="pay-head"><div><span class="kicker">Kontrollspor</span><h2>Siste beregnede grunnlag</h2></div><a href="/treasury">Tilbake til treasury ↗</a></div><div id="pay-list"><p class="muted">Henter lønnskontroller…</p></div></section>
    <section class="pay-notice"><strong>Produksjonsgrense</strong><p>Dette er en beregning og et revisjonsspor. Ferielov, OTP-grunnlag, skattekort, A-melding og NAV-innsending må kvalitetssikres av ansvarlig lønnsfører og sendes gjennom godkjente Maskinporten-/leverandøravtaler.</p></section>
  </main>
</Layout>
<script is:inline>
const esc=v=>String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));const money=n=>`${new Intl.NumberFormat('nb-NO').format(Number(n||0)/100)} NOK`;fetch('/api/payroll?boardId=board-1').then(r=>r.json()).then(d=>{const rows=d.data||[],r=rows[0]||{};document.getElementById('pay-holiday').textContent=money(r.holiday_pay_minor);document.getElementById('pay-otp').textContent=money(r.otp_minor);document.getElementById('pay-total').textContent=money(Number(r.holiday_pay_minor||0)+Number(r.otp_minor||0));document.getElementById('pay-people').textContent=r.employee_count??'—';document.getElementById('pay-holiday-rate').textContent=`Sats ${Number(r.holiday_rate||0)*100}%`;document.getElementById('pay-otp-rate').textContent=`Sats ${Number(r.otp_rate||0)*100}%`;document.getElementById('pay-status').textContent=r.status==='approved'?'Godkjent':'Krever review';document.getElementById('pay-list').innerHTML=rows.length?rows.map(x=>`<article><div><strong>${esc(x.period)} · ${esc(x.payroll_run_id)}</strong><p>${esc(x.assumptions||'Forutsetninger ikke oppgitt')}</p></div><em>${esc(x.status)}</em><b>${money(Number(x.holiday_pay_minor||0)+Number(x.otp_minor||0))}</b></article>`).join(''):'<p class="muted">Ingen beregninger registrert.</p>'}).catch(()=>{document.getElementById('pay-status').textContent='API utilgjengelig'});
</script>
<style>.pay-shell{max-width:1180px;margin:0 auto;padding:38px 24px 80px}.pay-hero{display:grid;grid-template-columns:1fr .45fr;align-items:center;gap:24px;padding:44px;border-radius:27px;background:linear-gradient(120deg,#3e374f,#7161a2);color:#fff}.eyebrow,.kicker{font:700 .68rem system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:#ded5ff}.pay-hero h1{margin:20px 0 16px;font:500 clamp(2.5rem,5vw,4.4rem)/.96 Georgia,serif}.pay-hero h1 em{color:#e1d3ff;font-style:normal}.pay-hero p{max-width:570px;color:#ffffffbf;font:1rem/1.6 system-ui,sans-serif}.pay-orb{width:190px;height:190px;display:flex;flex-direction:column;align-items:center;justify-content:center;border:1px solid #ded3ffaa;border-radius:50%;background:#514475;color:#fff}.pay-orb strong{font:500 2.35rem Georgia,serif;color:#f0e9ff}.pay-orb span,.pay-orb small{font:.68rem system-ui,sans-serif}.pay-orb small{margin-top:9px;color:#d9cff7}.pay-metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:16px 0 52px}.pay-metrics article{min-height:105px;padding:17px;border:1px solid #10241f14;border-radius:15px;background:#fff;display:flex;flex-direction:column;justify-content:space-between}.pay-metrics .dark{background:#10241f;color:#fff}.pay-metrics span,.pay-metrics small{color:#718078;font:600 .67rem system-ui,sans-serif}.pay-metrics strong{font:500 1.5rem Georgia,serif}.pay-card{padding:28px;border:1px solid #10241f18;border-radius:20px;background:#fff}.pay-head{display:flex;justify-content:space-between;align-items:end}.pay-head h2{margin:9px 0 0;font:500 2rem Georgia,serif}.pay-head a{color:#7261a2;font:700 .68rem system-ui,sans-serif}.pay-card article{display:grid;grid-template-columns:1.7fr auto auto;gap:12px;align-items:center;padding:15px 4px;border-top:1px solid #10241f12}.pay-card article p{margin:5px 0 0;color:#718078;font:.7rem/1.35 system-ui,sans-serif}.pay-card em{padding:5px 8px;border-radius:999px;background:#eee9ff;color:#65539a;font:700 .61rem system-ui,sans-serif;font-style:normal}.pay-card strong{font:600 .82rem system-ui,sans-serif}.pay-notice{margin-top:35px;padding:22px 25px;border-radius:16px;background:#eeeaff}.pay-notice strong{font:700 .78rem system-ui,sans-serif}.pay-notice p{margin:8px 0 0;color:#63736a;font:.78rem/1.5 system-ui,sans-serif}@media(max-width:800px){.pay-hero{grid-template-columns:1fr}.pay-metrics{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.pay-shell{padding:20px 15px 55px}.pay-hero{padding:28px 22px}.pay-metrics{grid-template-columns:1fr}.pay-card{padding:20px 16px}.pay-head{align-items:start;flex-direction:column;gap:10px}.pay-card article{grid-template-columns:1fr auto}.pay-card article b{grid-column:1}.pay-card article em{grid-column:2;grid-row:1}}
</style>
