---
import Layout from '../layouts/Layout.astro';

const modules = [
  { icon: '⌁', name: 'Styre og møter', description: 'Agenda, sakspapirer, vedtak og protokoll', tone: 'mint', href: '/board/board-1' },
  { icon: '◈', name: 'Risiko og GRC', description: 'Risikoer, hendelser, KRI-er og tiltak', tone: 'violet', href: '/risk' },
  { icon: '✓', name: 'Internkontroll', description: 'Kontroller, bevis og avvik samlet', tone: 'gold', href: '/internkontroll' },
  { icon: '◒', name: 'Frister og oppgaver', description: 'Ansvar, tidslinjer og beslutningsspor', tone: 'blue', href: '/compliance' },
  { icon: '＋', name: 'Mennesker og policy', description: 'Roller, håndbok, OKR og opplæring', tone: 'rose', href: '/onboarding' },
  { icon: '⌂', name: 'Økonomi og leverandører', description: 'Budsjett, kontrakter og innkjøpskontroll', tone: 'slate', href: '/board/board-1/documents' },
  { icon: '◎', name: 'Salg og kundeoppfølging', description: 'CRM, tilbud, avtaler og leveranser i ett spor', tone: 'orange', href: '#capability-map' },
  { icon: '▣', name: 'IT, utstyr og lokasjon', description: 'Saker, eiendeler, tilgang og leverandørforbruk', tone: 'teal', href: '#capability-map' },
  { icon: '⌖', name: 'Flåte og feltarbeid', description: 'Kjørebok, kjøretøy, anlegg og arbeidsordre', tone: 'lime', href: '#capability-map' },
  { icon: '◌', name: 'Regnskap og betaling', description: 'EHF, bank, lønn, skatt og avstemmingsspor', tone: 'indigo', href: '#capability-map' },
  { icon: '◫', name: 'Avtaler og eierskap', description: 'Kontrakter, prokura, cap table og opsjoner', tone: 'plum', href: '#capability-map' },
  { icon: '✦', name: 'Hendelser og agenter', description: 'Søk, varsler og AI med menneskelig godkjenning', tone: 'cyan', href: '#ai' },
];

const activities = [
  { time: 'I dag, 09:42', title: 'Budsjett H2 2026 er klart for behandling', meta: 'CFO · Møte Q2 2026', status: 'Til behandling', tone: 'amber' },
  { time: 'I går, 16:18', title: 'Kontrollbevis lastet opp', meta: 'Tilgangsstyring ERP · Internkontroll', status: 'Dokumentert', tone: 'green' },
  { time: '12. aug, 11:05', title: 'Risiko R-002 fikk ny eier', meta: 'DPO · Risikoregister', status: 'Oppdatert', tone: 'violet' },
  { time: '10. aug, 14:30', title: 'Protokoll Q1 markert som godkjent', meta: 'Styreleder · Styre', status: 'Fullført', tone: 'blue' },
];
---

<Layout title="Arbeidsflate" activeNav="workspace">
  <main class="workspace-shell">
    <section class="workspace-hero">
      <div>
        <div class="eyebrow"><span class="eyebrow-dot"></span> Pilotselskap AS · arbeidsflate</div>
        <h1>Alt styret trenger.<br /><em>Én klar retning.</em></h1>
        <p class="hero-copy">Styr.ing kobler styrearbeid, risiko, internkontroll og oppfølging i et rolig arbeidsrom som gjør neste beslutning tydelig.</p>
        <div class="hero-actions">
          <a class="primary-button" href="/board/board-1">Åpne styreportal <span>↗</span></a>
          <a class="text-button" href="#modules">Se alle arbeidsområder <span>↓</span></a>
        </div>
      </div>
      <div class="hero-orbit" aria-hidden="true">
        <div class="orbit-ring orbit-ring-one"></div><div class="orbit-ring orbit-ring-two"></div>
        <div class="orbit-core"><span class="core-kicker">Neste styremøte</span><strong>15</strong><span class="core-month">JUN · 09:00</span></div>
        <div class="orbit-node node-one">Agenda<br /><b>8 saker</b></div>
        <div class="orbit-node node-two">Oppfølging<br /><b>6 åpne</b></div>
        <div class="orbit-node node-three">Risiko<br /><b>2 kritiske</b></div>
      </div>
    </section>

    <section class="metric-row" aria-label="Nøkkeltall">
      <div class="metric-card"><span class="metric-label">Neste møte</span><strong>15. juni</strong><span class="metric-note good">Om 12 dager · 8 saker</span></div>
      <div class="metric-card"><span class="metric-label">Åpne oppgaver</span><strong>6</strong><span class="metric-note warn">2 med høy prioritet</span></div>
      <div class="metric-card"><span class="metric-label">Kontrollstatus</span><strong>94<span class="metric-unit">%</span></strong><span class="metric-note good">+6% siden forrige kvartal</span></div>
      <div class="metric-card metric-card-dark"><span class="metric-label">Siste styrevedtak</span><strong>2026/03</strong><span class="metric-note light">Styrets årsberetning · signert</span></div>
    </section>

    <section id="modules" class="module-section">
      <div class="section-intro"><div><span class="section-kicker">Arbeidsområder</span><h2>Fra sakspapir til handling</h2></div><a href="#all-activity" class="quiet-link">Se siste aktivitet <span>→</span></a></div>
      <div class="module-grid">
        {modules.map((module, index) => <a href={module.href} class={`module-card module-${module.tone}`}>
          <div class="module-top"><span class="module-icon">{module.icon}</span><span class="module-arrow">↗</span></div>
          <span class="module-index">0{index + 1}</span><h3>{module.name}</h3><p>{module.description}</p>
          <div class="module-line"><span></span></div>
        </a>)}
      </div>
    </section>

    <section class="command-section" id="ai">
      <div class="command-copy"><span class="section-kicker">Styr.assistent</span><h2>Spør arbeidsflaten.<br /><em>Få et spor tilbake.</em></h2><p>Assistert oppsummering kan gjøre møtemateriale, kontrollbevis og oppfølging enklere å finne. All tekst er et utkast som må gjennomgås av mennesker.</p><a href="/board/board-1/meeting/mtg-ext-3/minutes" class="secondary-button">Se eksempel på protokoll <span>↗</span></a></div>
      <div class="command-panel"><div class="panel-top"><span class="panel-status"><i></i> Illustrert assistent</span><span>Demo</span></div><div class="prompt">Hva må styret følge opp før neste møte?</div><div class="answer"><div class="answer-mark">s</div><div><strong>Tre punkter krever oppmerksomhet</strong><p>1. Budsjett H2 2026 må ferdigstilles av CFO.<br />2. Tilgangsstyring ERP har et kritisk avvik.<br />3. Pensjonsavtale mangler sammenligningsgrunnlag.</p><span class="source-label">Kilder · oppgaver · internkontroll · møte Q2</span></div></div><div class="panel-input"><span>Skriv et spørsmål …</span><b>↗</b></div></div>
    </section>

    <section id="capability-map" class="capability-map">
      <div class="section-intro"><div><span class="section-kicker">Produktkart</span><h2>Én plattform. Flere spor.</h2></div><span class="capability-note">Illustrert i preview · aktiveres med riktig oppsett</span></div>
      <div class="capability-grid">
        <div><strong>Virksomhet</strong><span>HCM · ATS · OKR · håndbok · LMS</span></div>
        <div><strong>Operasjon</strong><span>ITSM · MDM · SaaS-forbruk · GPS · fasiliteter</span></div>
        <div><strong>Finans</strong><span>SAF-T · EHF/PEPPOL · bank · lønn · NAV · OTP</span></div>
        <div><strong>Kommersielt</strong><span>CRM · CPQ · IFRS 15 · service desk · salgsrom</span></div>
        <div><strong>Eierskap</strong><span>Styreportal · signering · cap table · ESOP · prokura</span></div>
        <div><strong>Styring</strong><span>GRC · HMS · ESG · hendelser · søk · MCP</span></div>
      </div>
      <p class="capability-footnote">Koblede leverandører og regulatoriske innsendelser krever separat avtale, nøkler og godkjenning før produksjonsbruk.</p>
    </section>

    <section id="all-activity" class="activity-section"><div class="section-intro"><div><span class="section-kicker">Siste aktivitet</span><h2>Hold tråden samlet</h2></div><div class="activity-filter"><button class="filter active" data-filter="all">Alle</button><button class="filter" data-filter="green">Fullført</button><button class="filter" data-filter="amber">Til behandling</button></div></div><div class="activity-list">{activities.map(activity => <article class="activity-item" data-tone={activity.tone}><time>{activity.time}</time><div class="activity-symbol tone-{activity.tone}"></div><div class="activity-body"><h3>{activity.title}</h3><p>{activity.meta}</p></div><span class={`activity-status status-${activity.tone}`}>{activity.status}</span><span class="activity-chevron">→</span></article>)}</div></section>

    <section class="trust-strip"><div><span class="trust-mark">✦</span><strong>Norsk arbeidsflate for styre og virksomhet</strong></div><span>Demo med fiktive data · ingen produksjonsløfter på denne siden</span><a href="/personvern">Personvern ↗</a></section>
  </main>
</Layout>

<script is:inline>
  document.querySelectorAll('.filter').forEach((button) => button.addEventListener('click', () => {
    document.querySelectorAll('.filter').forEach((item) => item.classList.remove('active'));
    button.classList.add('active');
    const filter = button.dataset.filter;
    document.querySelectorAll('.activity-item').forEach((item) => { item.hidden = filter !== 'all' && item.dataset.tone !== filter; });
  }));
</script>

<style>
  .workspace-shell { max-width: 1180px; margin: 0 auto; padding: 38px 24px 72px; }
  .workspace-hero { min-height: 360px; display: grid; grid-template-columns: minmax(0,1.05fr) minmax(320px,.95fr); gap: 30px; align-items: center; padding: 36px 38px; border-radius: 28px; background: linear-gradient(120deg,#13362d 0%,#1a4a3b 58%,#265b49 100%); color: #fff; overflow: hidden; position: relative; box-shadow: 0 22px 60px rgba(16,36,31,.16); }
  .workspace-hero::after { content:''; position:absolute; inset:auto -10% -70% auto; width:65%; aspect-ratio:1; border-radius:50%; background:radial-gradient(circle,rgba(205,252,141,.18),transparent 66%); }
  .eyebrow,.section-kicker { font: 700 .7rem/1 system-ui,sans-serif; letter-spacing:.14em; text-transform:uppercase; }
  .eyebrow { color:#d9f4b3; display:flex; align-items:center; gap:8px; margin-bottom:20px; }.eyebrow-dot { width:7px; height:7px; border-radius:50%; background:#c4f477; box-shadow:0 0 0 4px rgba(196,244,119,.16); }
  .workspace-hero h1 { font-size:clamp(2.4rem,5vw,4.35rem); line-height:.98; letter-spacing:-.05em; margin:0; font-weight:500; }.workspace-hero h1 em,.command-copy h2 em { color:#ccf786; font-style:normal; }
  .hero-copy { max-width:500px; color:rgba(255,255,255,.72); font: 400 1rem/1.65 system-ui,sans-serif; margin:22px 0 26px; }.hero-actions { display:flex; align-items:center; gap:18px; flex-wrap:wrap; }.primary-button,.secondary-button { display:inline-flex; align-items:center; gap:16px; padding:13px 18px; border-radius:11px; font:700 .82rem/1 system-ui,sans-serif; }.primary-button { color:#16352b; background:#d5fb98; }.primary-button:hover { color:#16352b; background:#e5ffbd; }.text-button { color:#ddf5be; font:600 .82rem/1 system-ui,sans-serif; }.text-button:hover { color:#fff; }
  .hero-orbit { position:relative; min-height:280px; display:grid; place-items:center; }.orbit-ring { position:absolute; border:1px solid rgba(201,246,133,.32); border-radius:50%; transform:rotate(-18deg); }.orbit-ring-one { width:245px; height:175px; }.orbit-ring-two { width:300px; height:215px; transform:rotate(35deg); border-color:rgba(255,255,255,.16); }.orbit-core { width:132px; height:132px; border-radius:50%; display:flex; flex-direction:column; align-items:center; justify-content:center; background:rgba(11,42,33,.84); border:1px solid rgba(217,252,166,.55); box-shadow:0 0 45px rgba(193,255,110,.16); z-index:2; }.core-kicker,.core-month { font:700 .57rem/1 system-ui,sans-serif; letter-spacing:.08em; text-transform:uppercase; color:#b4d6b8; }.orbit-core strong { color:#e2fda9; font:500 3rem/.95 Georgia,serif; margin:8px 0 4px; }.orbit-node { position:absolute; z-index:3; padding:9px 12px; border:1px solid rgba(220,250,190,.28); background:rgba(21,60,48,.92); border-radius:10px; color:#dff5c5; font:600 .68rem/1.3 system-ui,sans-serif; box-shadow:0 10px 20px rgba(0,0,0,.14); }.orbit-node b { color:#fff; font-size:.75rem; }.node-one { top:15px; right:5%; }.node-two { bottom:8px; left:6%; }.node-three { bottom:38px; right:2%; }
  .metric-row { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin:16px 0 56px; }.metric-card { min-height:110px; padding:17px 18px; background:#fff; border:1px solid rgba(16,36,31,.08); border-radius:15px; display:flex; flex-direction:column; justify-content:space-between; }.metric-card-dark { background:#10241f; color:#fff; border-color:#10241f; }.metric-label,.metric-note { font:600 .67rem/1.2 system-ui,sans-serif; letter-spacing:.07em; text-transform:uppercase; color:var(--muted); }.metric-card strong { font:500 1.65rem/1 Georgia,serif; letter-spacing:-.03em; }.metric-unit { font-size:.85rem; }.metric-note { text-transform:none; letter-spacing:0; font-weight:500; }.metric-note.good { color:#27805d; }.metric-note.warn { color:#ae6f19; }.metric-note.light { color:#b9d5bf; }
  .module-section,.activity-section { margin-top:10px; }.section-intro { display:flex; align-items:end; justify-content:space-between; gap:18px; margin-bottom:18px; }.section-kicker { color:var(--accent); }.section-intro h2 { font-size:2rem; font-weight:500; letter-spacing:-.04em; margin:8px 0 0; }.quiet-link { color:var(--muted); font:600 .78rem/1 system-ui,sans-serif; }.quiet-link:hover { color:var(--accent); }.module-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:13px; }.module-card { min-height:190px; padding:19px; background:#fff; border:1px solid rgba(16,36,31,.08); border-radius:16px; color:var(--ink); position:relative; overflow:hidden; transition:.2s ease; }.module-card:hover { transform:translateY(-3px); box-shadow:0 14px 28px rgba(16,36,31,.1); }.module-card::after { content:''; width:110px; height:110px; position:absolute; right:-35px; bottom:-38px; border-radius:50%; background:currentColor; opacity:.05; }.module-top { display:flex; justify-content:space-between; align-items:center; }.module-icon { width:36px; height:36px; display:grid; place-items:center; border-radius:11px; background:rgba(16,36,31,.07); font-size:1.25rem; }.module-arrow { opacity:.45; font:1.2rem/1 system-ui,sans-serif; }.module-index { display:block; margin-top:25px; color:var(--muted); font:700 .62rem/1 system-ui,sans-serif; letter-spacing:.1em; }.module-card h3 { font-size:1.08rem; margin:7px 0 3px; }.module-card p { color:var(--muted); font: .78rem/1.45 system-ui,sans-serif; margin:0; max-width:220px; }.module-line { position:absolute; bottom:0; left:0; right:0; height:3px; background:currentColor; opacity:.7; }.module-mint { color:#1f6f5b; }.module-violet { color:#726bb3; }.module-gold { color:#b38329; }.module-blue { color:#3974a1; }.module-rose { color:#ad607c; }.module-slate { color:#576a6a; }
  .command-section { margin:70px 0; display:grid; grid-template-columns:.85fr 1.15fr; gap:40px; align-items:center; padding:38px; border-radius:23px; background:#ecf2e9; }.command-copy h2 { font-size:2.3rem; line-height:1.03; font-weight:500; letter-spacing:-.045em; margin:10px 0 14px; }.command-copy p { color:var(--muted); font: .86rem/1.6 system-ui,sans-serif; max-width:380px; margin:0 0 22px; }.secondary-button { background:var(--night); color:#fff; }.secondary-button:hover { color:#fff; background:#285b47; }.command-panel { background:#fff; border:1px solid rgba(16,36,31,.1); border-radius:16px; padding:17px; box-shadow:0 15px 30px rgba(16,36,31,.08); }.panel-top { display:flex; justify-content:space-between; color:var(--muted); font:600 .65rem/1 system-ui,sans-serif; text-transform:uppercase; letter-spacing:.08em; }.panel-status i { display:inline-block; width:6px; height:6px; background:#56ad72; border-radius:50%; margin-right:5px; }.prompt { background:#f4f7f2; border-radius:9px; padding:13px; margin:15px 0; color:var(--ink); font:600 .81rem/1.3 system-ui,sans-serif; }.answer { display:flex; gap:11px; padding:4px 2px 18px; }.answer-mark { width:28px; height:28px; display:grid; place-items:center; border-radius:9px; background:var(--night); color:#d5fb98; font:700 1rem/1 Georgia,serif; flex-shrink:0; }.answer strong { font:700 .82rem/1.2 system-ui,sans-serif; }.answer p { color:var(--muted); font: .76rem/1.55 system-ui,sans-serif; margin:6px 0 10px; }.source-label { color:#6b9c75; font:600 .62rem/1 system-ui,sans-serif; }.panel-input { display:flex; justify-content:space-between; padding:11px 12px; border:1px solid rgba(16,36,31,.1); border-radius:9px; color:#9aa8a0; font: .75rem/1 system-ui,sans-serif; }.panel-input b { color:var(--accent); }
  .activity-filter { display:flex; gap:5px; }.filter { border:1px solid rgba(16,36,31,.1); background:#fff; color:var(--muted); padding:7px 10px; border-radius:999px; font:600 .68rem/1 system-ui,sans-serif; cursor:pointer; }.filter.active,.filter:hover { background:var(--night); color:#fff; border-color:var(--night); }.activity-list { border-top:1px solid rgba(16,36,31,.1); }.activity-item { display:grid; grid-template-columns:95px 10px 1fr auto 20px; align-items:center; gap:14px; padding:17px 8px; border-bottom:1px solid rgba(16,36,31,.07); }.activity-item time,.activity-body p { color:var(--muted); font: .7rem/1.3 system-ui,sans-serif; }.activity-symbol { width:8px; height:8px; border-radius:50%; }.tone-green { background:#3c9a6c; }.tone-amber { background:#d99b3a; }.tone-violet { background:#8074c6; }.tone-blue { background:#4d8db8; }.activity-body h3 { font:600 .85rem/1.25 system-ui,sans-serif; margin:0 0 3px; }.activity-body p { margin:0; }.activity-status { padding:5px 9px; border-radius:999px; font:600 .63rem/1 system-ui,sans-serif; }.status-green { color:#23734f; background:#e4f4e9; }.status-amber { color:#936017; background:#fff0d8; }.status-violet { color:#6156a1; background:#eeeafd; }.status-blue { color:#276487; background:#e5f2fa; }.activity-chevron { color:#8a9b92; }.trust-strip { margin-top:60px; padding:18px 0 0; display:flex; gap:18px; align-items:center; justify-content:space-between; border-top:1px solid rgba(16,36,31,.1); color:var(--muted); font: .7rem/1.3 system-ui,sans-serif; }.trust-strip > div { display:flex; align-items:center; gap:9px; color:var(--ink); }.trust-mark { color:var(--accent); font-size:1.1rem; }.trust-strip a { color:var(--accent); font-weight:700; }
  @media (max-width: 840px) { .workspace-hero,.command-section { grid-template-columns:1fr; }.hero-orbit { min-height:245px; }.metric-row { grid-template-columns:repeat(2,1fr); }.module-grid { grid-template-columns:repeat(2,1fr); } }
  @media (max-width: 560px) { .workspace-shell { padding:20px 15px 50px; }.workspace-hero { padding:27px 22px; border-radius:21px; }.workspace-hero h1 { font-size:2.55rem; }.metric-row,.module-grid { grid-template-columns:1fr; }.metric-card { min-height:96px; }.section-intro { align-items:start; flex-direction:column; }.command-section { padding:25px 18px; margin:45px 0; }.command-copy h2 { font-size:2rem; }.activity-item { grid-template-columns:65px 8px 1fr 16px; gap:9px; }.activity-status { display:none; }.trust-strip { align-items:start; flex-direction:column; gap:10px; }.orbit-ring-one { width:215px; height:155px; }.orbit-ring-two { width:270px; height:195px; }.node-one { right:0; }.node-two { left:0; } }
  .module-orange { color:#b66f32; }.module-teal { color:#2c7d83; }.module-lime { color:#6f8f38; }.module-indigo { color:#586ca5; }.module-plum { color:#8a5f87; }.module-cyan { color:#3a8395; }
  .capability-map { margin-top:70px; padding-top:10px; }.capability-note { color:var(--muted); font:600 .72rem/1.3 system-ui,sans-serif; }.capability-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1px; overflow:hidden; border:1px solid rgba(16,36,31,.1); border-radius:16px; background:rgba(16,36,31,.1); }.capability-grid > div { min-height:106px; padding:20px; background:#fff; display:flex; flex-direction:column; gap:9px; }.capability-grid strong { font:600 .92rem/1.2 system-ui,sans-serif; }.capability-grid span { color:var(--muted); font: .74rem/1.45 system-ui,sans-serif; }.capability-footnote { color:var(--muted); font: .72rem/1.5 system-ui,sans-serif; margin:13px 0 0; }
  @media (max-width: 560px) { .capability-grid { grid-template-columns:1fr; }.capability-note { align-self:flex-start; } }
</style>
