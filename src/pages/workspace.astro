---
import Layout from '../layouts/Layout.astro';

const modules = [
  { icon: '⌁', name: 'Styre og møter', description: 'Agenda, sakspapirer, vedtak og protokoll', tone: 'mint', href: '/board/board-1' },
  { icon: '◈', name: 'Risiko og GRC', description: 'Risikoer, hendelser, KRI-er og tiltak', tone: 'violet', href: '/risk' },
  { icon: '✓', name: 'Internkontroll', description: 'Kontroller, bevis og avvik samlet', tone: 'gold', href: '/internkontroll' },
  { icon: '◒', name: 'Frister og oppgaver', description: 'Ansvar, tidslinjer og beslutningsspor', tone: 'blue', href: '/compliance' },
  { icon: '＋', name: 'Mennesker og policy', description: 'Roller, håndbok, OKR og opplæring', tone: 'rose', href: '/onboarding' },
  { icon: '⌂', name: 'Økonomi og leverandører', description: 'Budsjett, kontrakter og innkjøpskontroll', tone: 'slate', href: '/board/board-1/documents' },
  { icon: '◎', name: 'Salg og kundeoppfølging', description: 'CRM, tilbud, salgsrom, abonnement og kundesaker', tone: 'orange', href: '/commercial' },
  { icon: '∿', name: 'Inntektsplanlegging', description: 'Kontrakter, leveranseforpliktelser og periodisering', tone: 'plum', href: '/revenue' },
  { icon: '▣', name: 'IT, utstyr og lokasjon', description: 'Saker, eiendeler, tilgang og leverandørforbruk', tone: 'teal', href: '#capability-map' },
  { icon: '⌖', name: 'Flåte og feltarbeid', description: 'Kjørebok, kjøretøy, FDV, prosjekter, WIP og timer', tone: 'lime', href: '/field' },
  { icon: '◌', name: 'Regnskap og betaling', description: 'EHF, bank, lønn, likviditet, skatt og avstemmingsspor', tone: 'indigo', href: '/finance' },
  { icon: '◇', name: 'Anleggsmidler', description: 'Eiendeler, bokført verdi og doble avskrivningsspor', tone: 'gold', href: '/assets' },
  { icon: '↳', name: 'Innkjøp og leverandører', description: 'Bestilling, mottak, treveis matching og attestasjon', tone: 'teal', href: '/procurement' },
  { icon: '▰', name: 'Kort og utlegg', description: 'Firmakort, kjøp, kvitteringer og godkjenning', tone: 'blue', href: '/cards' },
  { icon: '◫', name: 'Avtaler og eierskap', description: 'Kontrakter, prokura, cap table og opsjoner', tone: 'plum', href: '/governance' },
  { icon: '✦', name: 'Hendelser og agenter', description: 'Søk, varsler og AI med menneskelig godkjenning', tone: 'cyan', href: '#ai' },
  { icon: '⌘', name: 'Operativ cockpit', description: 'Mennesker, IT, finans, salg og felt i én kø', tone: 'mint', href: '/operations' },
];

const activities = [
  { time: 'I dag, 09:42', title: 'Budsjett H2 2026 er klart for behandling', meta: 'CFO · Møte Q2 2026', status: 'Til behandling', tone: 'amber' },
  { time: 'I går, 16:18', title: 'Kontrollbevis lastet opp', meta: 'Tilgangsstyring ERP · Internkontroll', status: 'Dokumentert', tone: 'green' },
  { time: '12. aug, 11:05', title: 'Risiko R-002 fikk ny eier', meta: 'DPO · Risikoregister', status: 'Oppdatert', tone: 'violet' },
  { time: '10. aug, 14:30', title: 'Protokoll Q1 markert som godkjent', meta: 'Styreleder · Styre', status: 'Fullført', tone: 'blue' },
];
---

<Layout title="Arbeidsflate" activeNav="workspace">
  <main class="workspace-shell">
    <section class="workspace-hero">
      <div>
        <div class="eyebrow"><span class="eyebrow-dot"></span> Pilotselskap AS · arbeidsflate</div>
        <h1>Alt styret trenger.<br /><em>Én klar retning.</em></h1>
        <p class="hero-copy">Styr.ing kobler styrearbeid, risiko, internkontroll og oppfølging i et rolig arbeidsrom som gjør neste beslutning tydelig.</p>
        <div class="hero-actions">
          <a class="primary-button" href="/board/board-1">Åpne styreportal <span>↗</span></a>
          <a class="text-button" href="#modules">Se alle arbeidsområder <span>↓</span></a>
        </div>
      </div>
      <div class="hero-orbit" aria-hidden="true">
        <div class="orbit-ring orbit-ring-one"></div><div class="orbit-ring orbit-ring-two"></div>
        <div class="orbit-core"><span class="core-kicker">Neste styremøte</span><strong>15</strong><span class="core-month">JUN · 09:00</span></div>
        <div class="orbit-node node-one">Agenda<br /><b>8 saker</b></div>
        <div class="orbit-node node-two">Oppfølging<br /><b>6 åpne</b></div>
        <div class="orbit-node node-three">Risiko<br /><b>2 kritiske</b></div>
      </div>
    </section>

    <section class="metric-row" aria-label="Nøkkeltall">
      <div class="metric-card"><span class="metric-label">Neste møte</span><strong>15. juni</strong><span class="metric-note good">Om 12 dager · 8 saker</span></div>
      <div class="metric-card"><span class="metric-label">Åpne oppgaver</span><strong>6</strong><span class="metric-note warn">2 med høy prioritet</span></div>
      <div class="metric-card"><span class="metric-label">Kontrollstatus</span><strong>94<span class="metric-unit">%</span></strong><span class="metric-note good">+6% siden forrige kvartal</span></div>
      <div class="metric-card metric-card-dark"><span class="metric-label">Siste styrevedtak</span><strong>2026/03</strong><span class="metric-note light">Styrets årsberetning · signert</span></div>
    </section>

    <section id="modules" class="module-section">
      <div class="section-intro"><div><span class="section-kicker">Arbeidsområder</span><h2>Fra sakspapir til handling</h2></div><a href="#all-activity" class="quiet-link">Se siste aktivitet <span>→</span></a></div>
      <div class="module-grid">
        {modules.map((module, index) => <a href={module.href} class={`module-card module-${module.tone}`}>
          <div class="module-top"><span class="module-icon">{module.icon}</span><span class="module-arrow">↗</span></div>
          <span class="module-index">0{index + 1}</span><h3>{module.name}</h3><p>{module.description}</p>
          <div class="module-line"><span></span></div>
        </a>)}
      </div>
    </section>

    <section class="search-section" id="search" aria-labelledby="search-title">
      <div class="search-copy"><span class="section-kicker">Universelt søk</span><h2 id="search-title">Finn tråden på tvers.</h2><p>Søk i styresaker, risiko, mennesker, økonomi, kunder, avtaler og drift fra ett sted. Treffene viser alltid hvilken kilde de kommer fra.</p><span class="search-note">Kun lesing · tilgangsstyrt per virksomhet · ingen automatisk handling</span></div>
      <div class="search-panel">
        <form id="universal-search-form" class="universal-search-form"><label for="universal-search">Hva leter du etter?</label><div class="search-input-row"><input id="universal-search" autocomplete="off" placeholder="Søk etter f.eks. ERP, budsjett eller leverandør" /><button type="submit">Søk <span>↗</span></button></div></form>
        <div id="search-status" class="search-status" role="status">Skriv minst to tegn for å søke i arbeidsflaten.</div>
        <div id="search-results" class="search-results" aria-live="polite"></div>
      </div>
    </section>

    <section class="command-section" id="ai">
      <div class="command-copy"><span class="section-kicker">Styr.assistent</span><h2>Spør arbeidsflaten.<br /><em>Få et spor tilbake.</em></h2><p>Assistert oppsummering kan gjøre møtemateriale, kontrollbevis og oppfølging enklere å finne. All tekst er et utkast som må gjennomgås av mennesker.</p><a href="/board/board-1/meeting/mtg-ext-3/minutes" class="secondary-button">Se eksempel på protokoll <span>↗</span></a></div>
      <div class="command-panel"><div class="panel-top"><span class="panel-status"><i></i> Illustrert assistent</span><span>Demo</span></div><div id="assistant-prompt" class="prompt">Hva må styret følge opp før neste møte?</div><div class="answer"><div class="answer-mark">s</div><div><strong id="assistant-title">Tre punkter krever oppmerksomhet</strong><p id="assistant-answer">1. Budsjett H2 2026 må ferdigstilles av CFO.<br />2. Tilgangsstyring ERP har et kritisk avvik.<br />3. Pensjonsavtale mangler sammenligningsgrunnlag.</p><span id="assistant-sources" class="source-label">Kilder · oppgaver · internkontroll · møte Q2</span></div></div><form id="assistant-form" class="panel-input"><input id="assistant-input" aria-label="Skriv et spørsmål til assistenten" placeholder="Skriv et spørsmål …" /><button type="submit" aria-label="Send spørsmål">↗</button></form><div class="assistant-hints"><button type="button" data-question="Hva er den største risikoen?">Største risiko</button><button type="button" data-question="Hva ble vedtatt sist?">Siste vedtak</button><span>Utkast · menneskelig godkjenning</span></div></div>
    </section>

    <section id="capability-map" class="capability-map">
      <div class="section-intro"><div><span class="section-kicker">Produktkart</span><h2>Én plattform. Flere spor.</h2></div><span class="capability-note">Illustrert i preview · aktiveres med riktig oppsett</span></div>
      <div class="capability-grid">
        <div><strong>Virksomhet</strong><span>HCM · ATS · OKR · håndbok · LMS</span></div>
        <div><strong>Operasjon</strong><span>ITSM · MDM · SaaS-forbruk · GPS · fasiliteter</span></div>
        <div><strong>Finans</strong><span>SAF-T · EHF/PEPPOL · bank · lønn · NAV · OTP</span></div>
        <div><strong>Kommersielt</strong><span>CRM · CPQ · IFRS 15 · service desk · salgsrom</span></div>
        <div><strong>Eierskap</strong><span>Styreportal · signering · cap table · ESOP · prokura</span></div>
        <div><strong>Styring</strong><span>GRC · HMS · ESG · hendelser · søk · MCP</span></div>
      </div>
      <p class="capability-footnote">Koblede leverandører og regulatoriske innsendelser krever separat avtale, nøkler og godkjenning før produksjonsbruk.</p>
    </section>
<section class="domain-readiness" aria-label="Domene- og backendstatus"><div class="section-intro"><div><span class="section-kicker">Status per område</span><h2>Se hva som er klart for neste steg</h2></div><span id="domain-status-label" class="capability-note">Henter backend-status…</span></div><div class="readiness-grid"><a href="/api/domains/people?boardId=board-1"><strong>Mennesker</strong><span>HR, OKR og mål</span><b>API ↗</b></a><a href="/api/domains/it_assets?boardId=board-1"><strong>IT og drift</strong><span>Eiendeler, tickets og SaaS</span><b>API ↗</b></a><a href="/finance"><strong>Økonomi</strong><span>Hovedbok, bilag, perioder og SAF‑T</span><b>Arbeidsflate ↗</b></a><a href="/treasury"><strong>Lønn og likviditet</strong><span>Lønnskjøring, innsendinger og innkreving</span><b>Arbeidsflate ↗</b></a><a href="/api/domains/crm_accounts?boardId=board-1"><strong>Kunder</strong><span>CRM, tilbud og oppfølging</span><b>API ↗</b></a><a href="/api/domains/contracts?boardId=board-1"><strong>Avtaler</strong><span>Kontrakter, prokura og eierskap</span><b>API ↗</b></a><a href="/api/domains/sustainability_items?boardId=board-1"><strong>HMS og ESG</strong><span>Hendelser, SJA og leverandørkontroll</span><b>API ↗</b></a><a href="/api/domains/integration_registry?boardId=board-1"><strong>Integrasjoner</strong><span>Altinn, EHF, Stripe og adapterstatus</span><b>API ↗</b></a><a href="/api/events"><strong>Plattform</strong><span>Event mesh, søk og MCP-kontrakt</span><b>API ↗</b></a></div></section>

    <section id="all-activity" class="activity-section"><div class="section-intro"><div><span class="section-kicker">Siste aktivitet</span><h2>Hold tråden samlet</h2></div><div class="activity-filter"><button class="filter active" data-filter="all">Alle</button><button class="filter" data-filter="green">Fullført</button><button class="filter" data-filter="amber">Til behandling</button></div></div><div class="activity-list">{activities.map(activity => <article class="activity-item" data-tone={activity.tone}><time>{activity.time}</time><div class="activity-symbol tone-{activity.tone}"></div><div class="activity-body"><h3>{activity.title}</h3><p>{activity.meta}</p></div><span class={`activity-status status-${activity.tone}`}>{activity.status}</span><span class="activity-chevron">→</span></article>)}</div></section>

    <section class="trust-strip"><div><span class="trust-mark">✦</span><strong>Norsk arbeidsflate for styre og virksomhet</strong></div><span>Demo med fiktive data · API og D1 kan aktiveres for avtalt produksjonsoppsett</span><a href="/trust">Sikkerhet ↗</a></section>
    <section class="api-strip" aria-label="Backend-status"><div><span class="api-dot"></span><strong>Backend-kontrakt tilgjengelig</strong><span id="api-status">Sjekker API…</span></div><a href="/api/health">Åpne helsesjekk ↗</a></section>
  </main>
</Layout>

<script is:inline>
  const domainStatus = document.getElementById('domain-status-label');
  fetch('/api/domains/integration_registry?boardId=board-1').then((r) => r.json()).then((data) => { const count = Array.isArray(data.data) ? data.data.length : 0; if (domainStatus) domainStatus.textContent = `${count} integrasjoner i registeret · API tilgjengelig`; }).catch(() => { if (domainStatus) domainStatus.textContent = 'Preview-modus · API ikke tilgjengelig'; });
  const assistantAnswers = {
    'risiko': { prompt: 'Hva er den største risikoen?', title: 'Tilgangsstyring ERP er høyest prioritert', answer: 'Avviket er kritisk fordi tilganger ikke er dokumentert for alle roller. Eier er DPO, med frist før neste styremøte.', sources: 'Kilder · risikoregister · kontroll C-014 · oppgave 23' },
    'vedtatt': { prompt: 'Hva ble vedtatt sist?', title: 'Styrets årsberetning ble godkjent', answer: 'Vedtak 2026/03 ble signert etter møtet. CFO følger opp publisering og arkivering av endelig versjon.', sources: 'Kilder · vedtak 2026/03 · protokoll Q1 · dokumentarkiv' },
    'default': { prompt: 'Hva må styret følge opp før neste møte?', title: 'Tre punkter krever oppmerksomhet', answer: '1. Budsjett H2 2026 må ferdigstilles av CFO.<br />2. Tilgangsstyring ERP har et kritisk avvik.<br />3. Pensjonsavtale mangler sammenligningsgrunnlag.', sources: 'Kilder · oppgaver · internkontroll · møte Q2' }
  };
  const assistantForm = document.querySelector('#assistant-form');
  const assistantInput = document.querySelector('#assistant-input');
  const answerFor = (question) => { const q = question.toLowerCase(); return q.includes('risiko') ? assistantAnswers.risiko : q.includes('vedtatt') || q.includes('sist') ? assistantAnswers.vedtatt : assistantAnswers.default; };
  const renderAssistant = (question) => { const a = answerFor(question); document.querySelector('#assistant-prompt').textContent = a.prompt; document.querySelector('#assistant-title').textContent = a.title; document.querySelector('#assistant-answer').innerHTML = a.answer; document.querySelector('#assistant-sources').textContent = a.sources; };
  assistantForm?.addEventListener('submit', (event) => { event.preventDefault(); renderAssistant(assistantInput?.value || ''); if (assistantInput) assistantInput.value = ''; });
  document.querySelectorAll('[data-question]').forEach((button) => button.addEventListener('click', () => renderAssistant(button.dataset.question || '')));
  const searchForm = document.querySelector('#universal-search-form');
  const searchInput = document.querySelector('#universal-search');
  const searchStatus = document.querySelector('#search-status');
  const searchResults = document.querySelector('#search-results');
  const escapeHtml = (value) => String(value).replace(/[&<>'\"]/g, (character) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', "'":'&#39;', '\"':'&quot;' }[character]));
  const renderSearch = (data, query) => {
    if (!searchResults || !searchStatus) return;
    const results = Array.isArray(data?.data) ? data.data : [];
    searchStatus.textContent = results.length ? `${results.length} treff · kilder er synlige for kontroll` : `Ingen treff på «${query}». Prøv et kortere eller annet søkeord.`;
    searchResults.innerHTML = results.map((result) => `<article class="search-result"><div class="search-result-top"><span class="search-type">${escapeHtml(result.type)}</span><span class="search-source">${escapeHtml(result.source)}</span></div><strong>${escapeHtml(result.title)}</strong><p>${escapeHtml(result.snippet || 'Åpne kilden for mer informasjon.')}</p></article>`).join('');
  };
  searchForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const query = (searchInput?.value || '').trim();
    if (query.length < 2) { if (searchStatus) searchStatus.textContent = 'Skriv minst to tegn for å søke i arbeidsflaten.'; return; }
    if (searchStatus) searchStatus.textContent = 'Søker i virksomhetsbildet…';
    try {
      const response = await fetch(`/api/search?boardId=board-1&q=${encodeURIComponent(query)}`);
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'search_failed');
      renderSearch(data, query);
    } catch {
      if (searchStatus) searchStatus.textContent = 'Søket er midlertidig utilgjengelig. Prøv igjen om litt.';
      if (searchResults) searchResults.innerHTML = '';
    }
  });
  document.querySelectorAll('.filter').forEach((button) => button.addEventListener('click', () => {
    document.querySelectorAll('.filter').forEach((item) => item.classList.remove('active'));
    button.classList.add('active');
    const filter = button.dataset.filter;
    document.querySelectorAll('.activity-item').forEach((item) => { item.hidden = filter !== 'all' && item.dataset.tone !== filter; });
  }));
</script>
<script is:inline>
  const status = document.getElementById('api-status');
  fetch('/api/health').then((r) => r.json()).then((data) => { status.textContent = data.database === 'ready' ? 'D1 tilkoblet' : 'Preview-modus · D1 ikke aktivert'; }).catch(() => { status.textContent = 'Preview-modus · API ikke tilgjengelig'; });
</script>

<style>
  .workspace-shell { max-width: 1180px; margin: 0 auto; padding: 38px 24px 72px; }
  .workspace-hero { min-height: 360px; display: grid; grid-template-columns: minmax(0,1.05fr) minmax(320px,.95fr); gap: 30px; align-items: center; padding: 36px 38px; border-radius: 28px; background: linear-gradient(120deg,#13362d 0%,#1a4a3b 58%,#265b49 100%); color: #fff; overflow: hidden; position: relative; box-shadow: 0 22px 60px rgba(16,36,31,.16); }
  .workspace-hero::after { content:''; position:absolute; inset:auto -10% -70% auto; width:65%; aspect-ratio:1; border-radius:50%; background:radial-gradient(circle,rgba(205,252,141,.18),transparent 66%); }
  .eyebrow,.section-kicker { font: 700 .7rem/1 system-ui,sans-serif; letter-spacing:.14em; text-transform:uppercase; }
  .eyebrow { color:#d9f4b3; display:flex; align-items:center; gap:8px; margin-bottom:20px; }.eyebrow-dot { width:7px; height:7px; border-radius:50%; background:#c4f477; box-shadow:0 0 0 4px rgba(196,244,119,.16); }
  .workspace-hero h1 { font-size:clamp(2.4rem,5vw,4.35rem); line-height:.98; letter-spacing:-.05em; margin:0; font-weight:500; }.workspace-hero h1 em,.command-copy h2 em { color:#ccf786; font-style:normal; }
  .hero-copy { max-width:500px; color:rgba(255,255,255,.72); font: 400 1rem/1.65 system-ui,sans-serif; margin:22px 0 26px; }.hero-actions { display:flex; align-items:center; gap:18px; flex-wrap:wrap; }.primary-button,.secondary-button { display:inline-flex; align-items:center; gap:16px; padding:13px 18px; border-radius:11px; font:700 .82rem/1 system-ui,sans-serif; }.primary-button { color:#16352b; background:#d5fb98; }.primary-button:hover { color:#16352b; background:#e5ffbd; }.text-button { color:#ddf5be; font:600 .82rem/1 system-ui,sans-serif; }.text-button:hover { color:#fff; }
