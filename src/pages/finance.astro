---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Økonomi — Styr.ing" activeNav="finance">
  <main class="finance-shell">
    <section class="finance-hero"><div><span class="eyebrow"><i></i>Økonomi · hovedbok</span><h1>Tall du kan <em>stole på.</em></h1><p>Hold bilag, avstemmingsspor, perioder og styrebeslutninger i samme arbeidsflate. Demoen bruker fiktive data, men API-kontrakten validerer balanserte bilag før de kan posteres.</p></div><div class="ledger-orb"><span>Saldo</span><strong>+44 000</strong><small>NOK · illustrert</small></div></section>
    <section class="finance-metrics"><div><span>Aktive kontoer</span><strong id="account-count">—</strong></div><div><span>Perioder låst</span><strong id="locked-count">—</strong></div><div><span>Bilag</span><strong id="voucher-count">—</strong></div><div><span>Kontroll</span><strong id="balance-status">Sjekker…</strong></div></section>
    <section class="finance-grid"><article class="finance-card"><div class="card-head"><div><span class="section-kicker">Hovedbok</span><h2>Kontoplan</h2></div><a href="/api/finance?boardId=board-1&view=accounts">API ↗</a></div><div id="accounts-list" class="account-list"><p class="muted">Henter kontoer…</p></div></article><article class="finance-card"><div class="card-head"><div><span class="section-kicker">Posteringer</span><h2>Siste bilag</h2></div><a href="/api/finance?boardId=board-1&view=vouchers">API ↗</a></div><div id="vouchers-list" class="voucher-list"><p class="muted">Henter bilag…</p></div></article></section>
    <section class="finance-grid"><article class="finance-card"><div class="card-head"><div><span class="section-kicker">Konsernkontroll</span><h2>Intercompany</h2></div><a href="/api/finance?boardId=board-1&view=intercompany">API ↗</a></div><div id="intercompany-list" class="voucher-list"><p class="muted">Henter speilposteringer…</p></div></article><article class="finance-card"><div class="card-head"><div><span class="section-kicker">Årsoppgjør</span><h2>Noteforberedelse</h2></div><a href="/api/finance?boardId=board-1&view=notes">API ↗</a></div><div id="notes-list" class="voucher-list"><p class="muted">Henter noter…</p></div></article></section>
    <section class="finance-tools"><div><span class="section-kicker">Kontrollspor</span><h2>Eksporter uten å miste kontekst.</h2><p>SAF‑T Financial 1.3-kontrakten lager en lesbar eksport av kontoplan og posterte linjer. Innsending til Skatteetaten krever fortsatt godkjent adapter og kundens autorisasjon.</p></div><div class="tool-actions"><a class="tool-button" href="/api/finance?boardId=board-1&view=saf-t&from=2026-01&to=2026-12">Last ned SAF‑T-eksempel <span>↓</span></a><a class="tool-link" href="/workspace#search">Søk i økonomien ↗</a></div></section>
    <p class="finance-boundary">Preview med fiktive data · ingen reell bokføring eller regulatorisk innsending utføres fra denne offentlige siden.</p>
  </main>
</Layout>
<script is:inline>
  const esc = (v) => String(v ?? '').replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const money = (v) => `${(Number(v || 0) / 100).toLocaleString('nb-NO')} kr`;
  Promise.all([fetch('/api/finance?boardId=board-1&view=accounts').then(r=>r.json()), fetch('/api/finance?boardId=board-1&view=vouchers').then(r=>r.json()), fetch('/api/finance?boardId=board-1&view=periods').then(r=>r.json()), fetch('/api/finance?boardId=board-1&view=intercompany').then(r=>r.json()), fetch('/api/finance?boardId=board-1&view=notes').then(r=>r.json())]).then(([accounts,vouchers,periods,intercompany,notes]) => {
    const a = accounts.data || [], v = vouchers.data || [], p = periods.data || []; document.querySelector('#account-count').textContent = a.length; document.querySelector('#locked-count').textContent = p.filter(x=>x.status==='locked').length; document.querySelector('#voucher-count').textContent = v.length; document.querySelector('#balance-status').textContent = v.every(x=>Number(x.debit_minor)===Number(x.credit_minor)) ? 'Balansert' : 'Avvik';
    document.querySelector('#accounts-list').innerHTML = a.map(x=>`<div class="account-row"><span><b>${esc(x.code)}</b> ${esc(x.name)}</span><em>${esc(x.account_type)}</em></div>`).join(''); document.querySelector('#vouchers-list').innerHTML = v.slice(0,6).map(x=>`<div class="voucher-row"><span><b>${esc(x.voucher_number)}</b> ${esc(x.description)}</span><em>${money(x.debit_minor)} · ${esc(x.period)}</em></div>`).join(''); const ic=intercompany.data||[], n=notes.data||[]; document.querySelector('#intercompany-list').innerHTML=ic.map(x=>`<div class="voucher-row"><span><b>${esc(x.reference)}</b><br />${esc(x.source_entity)} → ${esc(x.target_entity)}</span><em>${money(x.amount_minor)} · ${esc(x.status)}</em></div>`).join(''); document.querySelector('#notes-list').innerHTML=n.map(x=>`<div class="voucher-row"><span><b>${esc(x.note_type)}</b><br />Periode ${esc(x.period)}</span><em>${esc(x.status)} · bevis ${esc(x.evidence_refs)}</em></div>`).join('');
  }).catch(()=>{ document.querySelector('#balance-status').textContent='Preview-modus'; });
</script>
<style>
 .finance-shell{max-width:1180px;margin:0 auto;padding:44px 24px 76px}.finance-hero{display:grid;grid-template-columns:1fr 290px;gap:40px;align-items:center;padding:42px;border-radius:26px;background:linear-gradient(120deg,#10241f,#1f5a46);color:#fff}.eyebrow,.section-kicker{font:700 .68rem/1 system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase}.eyebrow{color:#d5fb98}.eyebrow i{display:inline-block;width:7px;height:7px;border-radius:50%;background:#d5fb98;margin-right:7px}.finance-hero h1{font:500 clamp(2.5rem,5vw,4.4rem)/.95 Georgia,serif;letter-spacing:-.05em;margin:18px 0}.finance-hero h1 em{color:#d5fb98;font-style:normal}.finance-hero p{max-width:580px;color:rgba(255,255,255,.72);font:.92rem/1.65 system-ui,sans-serif}.ledger-orb{width:210px;height:210px;border-radius:50%;display:flex;flex-direction:column;justify-content:center;align-items:center;background:rgba(5,28,21,.35);border:1px solid rgba(213,251,152,.5);box-shadow:0 0 50px rgba(213,251,152,.12);margin:auto}.ledger-orb span,.ledger-orb small{font:700 .63rem/1 system-ui,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:#b6d4bd}.ledger-orb strong{font:500 2.2rem/1 Georgia,serif;color:#e6ffc0;margin:12px 0}.finance-metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:16px 0 52px}.finance-metrics>div{padding:17px;border:1px solid rgba(16,36,31,.09);border-radius:14px;background:#fff}.finance-metrics span{display:block;color:var(--muted);font:600 .65rem/1 system-ui,sans-serif;text-transform:uppercase}.finance-metrics strong{display:block;margin-top:12px;font:500 1.7rem/1 Georgia,serif}.finance-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.finance-card{padding:22px;border:1px solid rgba(16,36,31,.09);border-radius:16px;background:#fff}.card-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:16px}.card-head h2{margin:8px 0 0;font:500 1.65rem/1 Georgia,serif}.card-head a,.tool-link{color:var(--accent);font:700 .68rem/1 system-ui,sans-serif}.account-row,.voucher-row{display:flex;justify-content:space-between;gap:12px;padding:12px 0;border-top:1px solid rgba(16,36,31,.08);font:.76rem/1.3 system-ui,sans-serif}.account-row b,.voucher-row b{font-weight:700}.account-row em,.voucher-row em{color:var(--muted);font:.65rem/1.3 system-ui,sans-serif;font-style:normal;white-space:nowrap}.muted{color:var(--muted);font:.76rem/1.4 system-ui,sans-serif}.finance-tools{display:grid;grid-template-columns:1fr 1fr;gap:30px;margin-top:52px;padding:28px;border-radius:20px;background:#eaf2e7}.finance-tools h2{margin:9px 0 12px;font:500 2rem/1 Georgia,serif}.finance-tools p{max-width:520px;color:var(--muted);font:.82rem/1.6 system-ui,sans-serif}.tool-actions{display:flex;flex-direction:column;justify-content:center;align-items:flex-start;gap:14px}.tool-button{padding:13px 16px;border-radius:10px;background:#10241f;color:#fff;font:700 .76rem/1 system-ui,sans-serif}.tool-button:hover{color:#fff;background:#28624c}.finance-boundary{margin-top:20px;color:var(--muted);font:.68rem/1.4 system-ui,sans-serif}@media(max-width:760px){.finance-hero,.finance-grid,.finance-tools{grid-template-columns:1fr}.ledger-orb{width:160px;height:160px;margin:0}.finance-metrics{grid-template-columns:repeat(2,1fr)}}@media(max-width:500px){.finance-shell{padding:24px 15px 55px}.finance-hero{padding:28px 22px}.finance-metrics{grid-template-columns:1fr}.account-row,.voucher-row{flex-direction:column;gap:5px}}
</style>
