---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Økonomi — Styr.ing" activeNav="finance">
  <main class="finance-shell">
    <section class="finance-hero">
      <div>
        <p class="eyebrow">Regnskap for små norske bedrifter</p>
        <h1>Fra bilag til <em>oversikt.</em></h1>
        <p class="lead">Styr.ing samler bokføring, faktura, bankavstemming, MVA, lønn og rapporter i én rolig arbeidsflate. Du ser alltid hva som er gjort – og hva som må gjøres videre.</p>
        <div class="hero-actions"><a class="primary" href="/login?next=%2Fapp%2Ffinance">Åpne regnskapsflaten</a><a class="secondary" href="/abonnement">Se abonnement</a></div>
        <p class="boundary" id="finance-boundary">Offentlig forhåndsvisning med fiktive data. Innlogging kreves for å opprette eller endre regnskapsdata.</p>
      </div>
      <div class="ledger-orb" aria-label="Balansert hovedbok"><span>Hovedbok</span><strong id="balance-status">Balansert</strong><small>kontrollert grunnlag</small></div>
    </section>

    <section class="metrics" aria-label="Regnskapsstatus">
      <article><span>Konti i kontoplanen</span><strong id="account-count">–</strong><small>klare for bokføring</small></article>
      <article><span>Bilag i perioden</span><strong id="voucher-count">–</strong><small>med sporbar historikk</small></article>
      <article><span>Åpne bankposter</span><strong id="bank-open-count">–</strong><small>til avstemming</small></article>
      <article><span>MVA-perioder</span><strong id="vat-period-count">–</strong><small>beregnes fra bokførte bilag</small></article>
    </section>

    <section class="core-grid">
      <article class="card"><span class="kicker">01 · Bokføring</span><h2>Bilag som tåler kontroll.</h2><p>Last opp underlag, foreslå kontering og godkjenn før noe blir postert. Nummerering, periodelås og auditspor følger med.</p><a href="/app/finance">Se bokføringsflyten →</a></article>
      <article class="card"><span class="kicker">02 · Faktura</span><h2>Fakturer og følg opp.</h2><p>Opprett fakturautkast, registrer innbetalinger og få åpne poster samlet. EHF og ekstern sending aktiveres når leverandøravtale er på plass.</p><a href="/app/finance">Åpne faktura →</a></article>
      <article class="card"><span class="kicker">03 · Bank og MVA</span><h2>Avstem med ro i magen.</h2><p>Importer bankgrunnlag, godkjenn matchforslag og klargjør MVA-perioden fra dokumenterte kildelinjer – uten gjetting.</p><a href="/app/finance">Se avstemming →</a></article>
      <article class="card"><span class="kicker">04 · Lønn og rapporter</span><h2>Få tallene ut når du trenger dem.</h2><p>Kontroller lønnsgrunnlag, feriepenger og arbeidsgiveravgift. Hent resultat, balanse, hovedbok og SAF-T-grunnlag med samme sporbarhet.</p><a href="/app/finance">Se rapporter →</a></article>
    </section>

    <section class="workspace-callout">
      <div><span class="kicker">Én arbeidsflate</span><h2>Det viktigste først.</h2><p>Styr.ing er bygget rundt hverdagen i en liten virksomhet: få ting riktig, få dem godkjent og se neste oppgave uten å lete i menyer.</p></div>
      <div class="callout-links"><a class="primary" href="/login?next=%2Fapp%2Ffinance">Logg inn</a><a href="/trust">Sikkerhet og databehandling →</a><a href="/personvern">Personvern →</a></div>
    </section>
  </main>
</Layout>
<script is:inline>
  const setMetric = (id, value) => {
    const node = document.getElementById(id);
    if (node) node.textContent = String(value ?? '–');
  };

  const getJson = (url) => fetch(url).then((response) => {
    if (!response.ok) throw new Error('preview_unavailable');
    return response.json();
  });

  Promise.allSettled([
    getJson('/api/finance?boardId=board-1&view=accounts'),
    getJson('/api/finance?boardId=board-1&view=vouchers'),
    getJson('/api/bank?boardId=board-1&view=summary'),
    getJson('/api/mva?boardId=board-1&view=periods'),
  ]).then(([accounts, vouchers, bank, vat]) => {
    if (accounts.status === 'fulfilled') setMetric('account-count', accounts.value.data?.length ?? 0);
    if (vouchers.status === 'fulfilled') setMetric('voucher-count', vouchers.value.data?.length ?? 0);
    if (bank.status === 'fulfilled') setMetric('bank-open-count', bank.value.data?.openCount ?? bank.value.data?.open_count ?? 0);
    if (vat.status === 'fulfilled') setMetric('vat-period-count', vat.value.data?.length ?? 0);
  });
</script>
<style>
  .finance-shell{max-width:1180px;margin:0 auto;padding:52px 24px 84px;color:#10241f}.finance-hero{display:grid;grid-template-columns:1fr 280px;gap:48px;align-items:center;padding:52px;border-radius:28px;background:linear-gradient(120deg,#10241f,#1f5a46);color:#fff}.eyebrow,.kicker{font:700 .7rem/1.2 system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase}.eyebrow{color:#d5fb98}.finance-hero h1{margin:18px 0;font:500 clamp(3rem,7vw,5.8rem)/.9 Georgia,serif;letter-spacing:-.06em}.finance-hero h1 em{color:#d5fb98;font-style:normal}.lead{max-width:620px;color:rgba(255,255,255,.78);font:1rem/1.65 system-ui,sans-serif}.hero-actions,.callout-links{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-top:26px}.primary,.secondary{display:inline-block;padding:13px 17px;border-radius:10px;font:700 .76rem/1 system-ui,sans-serif;text-decoration:none}.primary{background:#d5fb98;color:#10241f}.primary:hover{background:#e4ffc0;color:#10241f}.secondary{border:1px solid rgba(255,255,255,.3);color:#fff}.secondary:hover{background:rgba(255,255,255,.1);color:#fff}.boundary{margin:22px 0 0;color:rgba(255,255,255,.56);font:.72rem/1.45 system-ui,sans-serif}.ledger-orb{width:210px;height:210px;border-radius:50%;display:flex;flex-direction:column;justify-content:center;align-items:center;background:rgba(5,28,21,.35);border:1px solid rgba(213,251,152,.5);box-shadow:0 0 50px rgba(213,251,152,.12);margin:auto}.ledger-orb span,.ledger-orb small{font:700 .63rem/1 system-ui,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:#b6d4bd}.ledger-orb strong{font:500 1.8rem/1 Georgia,serif;color:#e6ffc0;margin:12px 0}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:18px 0 54px}.metrics article{padding:18px;border:1px solid rgba(16,36,31,.1);border-radius:14px;background:#fff}.metrics span,.metrics small{display:block;color:#61726b;font:600 .66rem/1.35 system-ui,sans-serif}.metrics strong{display:block;margin:10px 0 4px;font:500 1.9rem/1 Georgia,serif}.core-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}.card{padding:26px;border:1px solid rgba(16,36,31,.1);border-radius:18px;background:#fff}.kicker{color:#267157}.card h2,.workspace-callout h2{margin:12px 0 9px;font:500 1.8rem/1 Georgia,serif;letter-spacing:-.03em}.card p,.workspace-callout p{margin:0 0 18px;color:#61726b;font:.83rem/1.6 system-ui,sans-serif}.card a,.callout-links a:not(.primary){color:#1f6a51;font:700 .72rem/1.2 system-ui,sans-serif}.workspace-callout{display:grid;grid-template-columns:1fr 280px;gap:40px;align-items:center;margin-top:54px;padding:30px;border-radius:20px;background:#eaf2e7}.workspace-callout h2{font-size:2.2rem}.callout-links{flex-direction:column;align-items:flex-start;margin-top:0}.callout-links .primary{background:#10241f;color:#fff}.callout-links .primary:hover{background:#28624c;color:#fff}@media(max-width:760px){.finance-shell{padding:28px 15px 58px}.finance-hero{grid-template-columns:1fr;padding:30px 24px}.ledger-orb{width:160px;height:160px;margin:0}.metrics{grid-template-columns:repeat(2,1fr)}.core-grid,.workspace-callout{grid-template-columns:1fr}}@media(max-width:480px){.metrics{grid-template-columns:1fr}.finance-hero h1{font-size:3.3rem}}
</style>
