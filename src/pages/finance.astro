---
import Layout from '../layouts/Layout.astro';
import SalesInvoiceQuick from '../components/SalesInvoiceQuick.astro';
import BankReconciliationQuick from '../components/BankReconciliationQuick.astro';
---
<Layout title="Økonomi — Styr.ing" activeNav="finance">
  <div class="finance-shell">
    <SalesInvoiceQuick />
    <BankReconciliationQuick />
    <section class="finance-hero"><div><span class="eyebrow"><i></i>Økonomi · hovedbok</span><h1>Tall du kan <em>stole på.</em></h1><p>Hold bilag, avstemmingsspor, perioder og styrebeslutninger i samme arbeidsflate. Bilagsnummeret tildeles atomisk sammen med bilaget og linjene, mens API-kontrakten validerer balanse før postering.</p></div><div class="ledger-orb"><span>Saldo</span><strong>+44 000</strong><small>NOK · illustrert</small></div></section>
    <section class="finance-metrics"><div><span>Aktive kontoer</span><strong id="account-count">—</strong></div><div><span>Perioder låst</span><strong id="locked-count">—</strong></div><div><span>Bilag</span><strong id="voucher-count">—</strong></div><div><span>Kontroll</span><strong id="balance-status">Sjekker…</strong></div></section>
    <section class="finance-grid"><article class="finance-card"><div class="card-head"><div><span class="section-kicker">Hovedbok</span><h2>Kontoplan</h2></div><a href="/api/finance?boardId=board-1&view=accounts">API ↗</a></div><div id="accounts-list" class="account-list"><p class="muted">Henter kontoer…</p></div></article><article class="finance-card"><div class="card-head"><div><span class="section-kicker">Posteringer</span><h2>Siste bilag</h2></div><a href="/api/finance?boardId=board-1&view=vouchers">API ↗</a></div><div id="vouchers-list" class="voucher-list"><p class="muted">Henter bilag…</p></div></article></section>
    <section class="finance-grid"><article class="finance-card"><div class="card-head"><div><span class="section-kicker">Konsernkontroll</span><h2>Intercompany</h2></div><a href="/api/finance?boardId=board-1&view=intercompany">API ↗</a></div><div id="intercompany-list" class="voucher-list"><p class="muted">Henter speilposteringer…</p></div></article><article class="finance-card"><div class="card-head"><div><span class="section-kicker">Valuta</span><h2>Agio og disagio</h2></div><a href="/api/finance?boardId=board-1&view=fx">API ↗</a></div><div id="fx-list" class="voucher-list"><p class="muted">Henter valutaposter…</p></div></article></section>
    <section class="finance-actions"><div class="finance-actions-head"><div><span class="section-kicker">Styrte handlinger</span><h2>Postér, lås og avstem — med kontroll.</h2><p>Handlingene er laget for autoriserte brukere og blir auditert. Ingen ekstern innsending skjer fra demoen.</p></div><span class="hitl-badge">HITL · påkrevd</span></div><div class="finance-action-grid"><form data-finance-action="create_voucher"><h3>Nytt balansert bilag</h3><label>Dato<input type="date" name="voucherDate" value="2026-08-25" required /></label><label>Beskrivelse<input name="description" maxlength="200" required placeholder="Hva gjelder posteringen?" /></label><div class="form-row"><label>Debetkonto<select name="debitAccount" id="debit-account" required><option value="">Henter kontoer…</option></select></label><label>Kreditkonto<select name="creditAccount" id="credit-account" required><option value="">Henter kontoer…</option></select></label></div><label>Beløp i kroner<input name="amount" type="number" min="0.01" step="0.01" required placeholder="0,00" /></label><button type="submit">Forbered bilag</button></form><form data-finance-action="lock_period"><h3>Lås regnskapsperiode</h3><label>Periode<input name="period" pattern="\\d{4}-(0[1-9]|1[0-2])" placeholder="2026-08" required /></label><p class="form-note">Når perioden er låst, avvises nye bilag i perioden.</p><button type="submit">Lås og forsegl</button></form><form data-finance-action="prepare_intercompany"><h3>Forbered speilpostering</h3><div class="form-row"><label>Fra selskap<input name="sourceEntity" required placeholder="Holding AS" /></label><label>Til selskap<input name="targetEntity" required placeholder="Drift AS" /></label></div><label>Referanse<input name="reference" maxlength="120" required placeholder="IC-2026-001" /></label><div class="form-row"><label>Periode<input name="period" pattern="\\d{4}-(0[1-9]|1[0-2])" required placeholder="2026-08" /></label><label>Beløp i kroner<input name="amount" type="number" min="0.01" step="0.01" required /></label></div><button type="submit">Forbered kontroll</button></form><form data-finance-action="approve_intercompany"><h3>Godkjenn speilpostering</h3><label>Åpen postering<select name="postingId" id="posting-id" required><option value="">Henter poster…</option></select></label><button type="submit">Godkjenn post</button></form><form data-finance-action="prepare_note"><h3>Forbered årsoppgjørsnote</h3><label>Type<select name="noteType"><option value="remuneration">Godtgjørelse</option><option value="fte">Årsverk</option><option value="related_party_loans">Nærstående lån</option></select></label><label>Periode/år<input name="period" value="2026" maxlength="20" required /></label><button type="submit">Beregn og send til review</button><small class="form-note">Henter kildebevis fra HR, lønn og cap table. Ingen innsending.</small></form><form data-finance-action="approve_note"><h3>Godkjenn årsoppgjørsnote</h3><label>Note<select name="noteId" id="note-id" required><option value="">Henter noter…</option></select></label><button type="submit">Godkjenn note</button></form><form data-finance-action="prepare_fx"><h3>Forbered valutarevaluering</h3><label>Referanse<input name="reference" maxlength="120" required placeholder="FX-2026-001" /></label><div class="form-row"><label>Valuta<input name="currency" value="EUR" maxlength="3" required /></label><label>Periode<input name="period" pattern="\\d{4}-(0[1-9]|1[0-2])" required placeholder="2026-08" /></label></div><label>Beløp i valuta (øre)<input name="foreignAmountMinor" type="number" min="1" required /></label><div class="form-row"><label>Bokført kurs<input name="bookedRate" type="number" min="0.0001" step="0.0001" required /></label><label>Sluttkurs<input name="closingRate" type="number" min="0.0001" step="0.0001" required /></label></div><button type="submit">Beregn agio/disagio</button><small class="form-note">Kurskilde og bokføring må godkjennes separat.</small></form><form data-finance-action="approve_fx"><h3>Godkjenn valutapost</h3><label>Post<select name="fxId" id="fx-id" required><option value="">Henter valutaposter…</option></select></label><button type="submit">Godkjenn post</button></form></div><p id="finance-action-status" class="action-status" role="status" aria-live="polite"></p></section>
    <section class="finance-tools"><div><span class="section-kicker">Kontrollspor</span><h2>Eksporter uten å miste kontekst.</h2><p>SAF‑T Financial 1.3-kontrakten lager en deterministisk eksport av kontoplan og alle posterte linjer. Last ned er alltid lesende; autoriserte brukere kan i tillegg registrere eksporten med checksum og historikk. Innsending til Skatteetaten krever fortsatt godkjent adapter og kundens autorisasjon.</p></div><div class="tool-actions"><a class="tool-button" href="/api/finance?boardId=board-1&view=saf-t&from=2026-01&to=2026-12">Last ned SAF‑T-eksempel <span>↓</span></a><button class="tool-button tool-button-secondary" type="button" data-saf-record>Registrer autorisert eksport</button><span id="saf-status" class="form-note" role="status" aria-live="polite"></span><a class="tool-link" href="/api/finance?boardId=board-1&view=saf-t-exports">Se eksporthistorikk ↗</a><a class="tool-link" href="/workspace#search">Søk i økonomien ↗</a></div></section>
    <p class="finance-boundary">Preview med fiktive data · ingen reell bokføring eller regulatorisk innsending utføres fra denne offentlige siden.</p>
  </div>
</Layout>
<script is:inline>
  const esc = (v) => String(v ?? '').replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const money = (v) => `${(Number(v || 0) / 100).toLocaleString('nb-NO')} kr`;
  Promise.all([fetch('/api/finance?boardId=board-1&view=accounts').then(r=>r.json()), fetch('/api/finance?boardId=board-1&view=vouchers').then(r=>r.json()), fetch('/api/finance?boardId=board-1&view=periods').then(r=>r.json()), fetch('/api/finance?boardId=board-1&view=intercompany').then(r=>r.json()), fetch('/api/finance?boardId=board-1&view=notes').then(r=>r.json()), fetch('/api/finance?boardId=board-1&view=fx').then(r=>r.json())]).then(([accounts,vouchers,periods,intercompany,notes,fx]) => {
    const a = accounts.data || [], v = vouchers.data || [], p = periods.data || []; document.querySelector('#account-count').textContent = a.length; document.querySelector('#locked-count').textContent = p.filter(x=>x.status==='locked').length; document.querySelector('#voucher-count').textContent = v.length; document.querySelector('#balance-status').textContent = v.every(x=>Number(x.debit_minor)===Number(x.credit_minor)) ? 'Balansert' : 'Avvik';
    document.querySelector('#accounts-list').innerHTML = a.map(x=>`<div class="account-row"><span><b>${esc(x.code)}</b> ${esc(x.name)}</span><em>${esc(x.account_type)}</em></div>`).join(''); document.querySelector('#vouchers-list').innerHTML = v.slice(0,6).map(x=>`<div class="voucher-row"><span><b>${esc(x.voucher_number)}</b> ${esc(x.description)}</span><em>${money(x.debit_minor)} · ${esc(x.period)}</em></div>`).join(''); const ic=intercompany.data||[], f=fx.data||[]; document.querySelector('#intercompany-list').innerHTML=ic.map(x=>`<div class="voucher-row"><span><b>${esc(x.reference)}</b><br />${esc(x.source_entity)} → ${esc(x.target_entity)}</span><em>${money(x.amount_minor)} · ${esc(x.status)}</em></div>`).join(''); document.querySelector('#fx-list').innerHTML=f.slice(0,6).map(x=>`<div class="voucher-row"><span><b>${esc(x.reference)}</b><br />${esc(x.currency)} · ${esc(x.period)}</span><em>${money(x.gain_loss_minor)} · ${esc(x.status)}</em></div>`).join('');
  }).catch(()=>{ document.querySelector('#balance-status').textContent='Preview-modus'; });
  const accountsForActions=fetch('/api/finance?boardId=board-1&view=accounts').then(r=>r.json()).then(({data=[]})=>{const opts=data.map(x=>`<option value="${esc(x.id)}">${esc(x.code)} · ${esc(x.name)}</option>`).join('');document.querySelector('#debit-account').innerHTML=opts;document.querySelector('#credit-account').innerHTML=opts;});
  const refreshFinanceOptions=async()=>{const [ic,notes,fx]=await Promise.all([fetch('/api/finance?boardId=board-1&view=intercompany').then(r=>r.json()),fetch('/api/finance?boardId=board-1&view=notes').then(r=>r.json()),fetch('/api/finance?boardId=board-1&view=fx').then(r=>r.json())]);const open=(ic.data||[]).filter(x=>['prepared','review'].includes(x.status));document.querySelector('#posting-id').innerHTML=open.length?open.map(x=>`<option value="${esc(x.id)}">${esc(x.reference)} · ${money(x.amount_minor)} · ${esc(x.status)}</option>`).join(''):'<option value="">Ingen åpne poster</option>';const pending=(notes.data||[]).filter(x=>['draft','review'].includes(x.status));document.querySelector('#note-id').innerHTML=pending.length?pending.map(x=>`<option value="${esc(x.id)}">${esc(x.note_type)} · ${esc(x.period)} · ${esc(x.status)}</option>`).join(''):'<option value="">Ingen åpne noter</option>';const openFx=(fx.data||[]).filter(x=>['draft','review'].includes(x.status));document.querySelector('#fx-id').innerHTML=openFx.length?openFx.map(x=>`<option value="${esc(x.id)}">${esc(x.reference)} · ${esc(x.currency)} · ${money(x.gain_loss_minor)}</option>`).join(''):'<option value="">Ingen åpne valutaposter</option>';};
  const financePost=async(form)=>{const status=document.querySelector('#finance-action-status');const payload=Object.fromEntries(new FormData(form));payload.boardId='board-1';payload.action=form.dataset.financeAction;if(payload.amount)payload.amountMinor=Math.round(Number(payload.amount)*100);if(payload.action==='create_voucher'){payload.voucher={voucherDate:payload.voucherDate,period:payload.voucherDate.slice(0,7),description:payload.description,lines:[{accountId:payload.debitAccount,debitMinor:payload.amountMinor,creditMinor:0},{accountId:payload.creditAccount,debitMinor:0,creditMinor:payload.amountMinor}]};}status.textContent='Lagrer og logger handling…';try{const res=await fetch('/api/finance',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(payload)});const data=await res.json();if(!res.ok)throw new Error(data.error||'Kunne ikke lagre');status.textContent=`✓ ${data.action} er registrert. Status: ${data.status||'postert'}.`;form.reset();await refreshFinanceOptions();}catch(error){status.textContent=`Kunne ikke lagre: ${error.message}`;}};
  document.querySelectorAll('[data-finance-action]').forEach(form=>form.addEventListener('submit',event=>{event.preventDefault();financePost(form);})); accountsForActions.catch(()=>{}); refreshFinanceOptions().catch(()=>{});
  document.querySelector('[data-saf-record]')?.addEventListener('click', async () => { const button=document.querySelector('[data-saf-record]'); const status=document.querySelector('#saf-status'); button.disabled=true; status.textContent='Registrerer eksport…'; try { const response=await fetch('/api/finance',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({boardId:'board-1',action:'record_saf_t_export',from:'2026-01',to:'2026-12'})}); const data=await response.json(); if(response.status===401){status.textContent='Logg inn for å registrere eksporthistorikk.';} else if(!response.ok){status.textContent=`Kunne ikke registrere eksport: ${data.error||'ukjent feil'}`;} else {status.textContent=`✓ Eksport registrert · checksum ${String(data.checksum||'').slice(0,12)}…`;}} catch { status.textContent='Kunne ikke kontakte eksporttjenesten.'; } finally { button.disabled=false; } });
</script>
<style>
  .finance-shell{max-width:1180px;margin:0 auto;padding:44px 24px 76px}.finance-hero{display:grid;grid-template-columns:1fr 290px;gap:40px;align-items:center;padding:42px;border-radius:26px;background:linear-gradient(120deg,#10241f,#1f5a46);color:#fff}.eyebrow,.section-kicker{font:700 .68rem/1 system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase}.eyebrow{color:#d5fb98}.eyebrow i{display:inline-block;width:7px;height:7px;border-radius:50%;background:#d5fb98;margin-right:7px}.finance-hero h1{font:500 clamp(2.5rem,5vw,4.4rem)/.95 Georgia,serif;letter-spacing:-.05em;margin:18px 0}.finance-hero h1 em{color:#d5fb98;font-style:normal}.finance-hero p{max-width:580px;color:rgba(255,255,255,.72);font:.92rem/1.65 system-ui,sans-serif}.ledger-orb{width:210px;height:210px;border-radius:50%;display:flex;flex-direction:column;justify-content:center;align-items:center;background:rgba(5,28,21,.35);border:1px solid rgba(213,251,152,.5);box-shadow:0 0 50px rgba(213,251,152,.12);margin:auto}.ledger-orb span,.ledger-orb small{font:700 .63rem/1 system-ui,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:#b6d4bd}.ledger-orb strong{font:500 2.2rem/1 Georgia,serif;color:#e6ffc0;margin:12px 0}.finance-metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:16px 0 52px}.finance-metrics>div{padding:17px;border:1px solid rgba(16,36,31,.09);border-radius:14px;background:#fff}.finance-metrics span{display:block;color:var(--muted);font:600 .65rem/1 system-ui,sans-serif;text-transform:uppercase}.finance-metrics strong{display:block;margin-top:12px;font:500 1.7rem/1 Georgia,serif}.finance-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.finance-card{padding:22px;border:1px solid rgba(16,36,31,.09);border-radius:16px;background:#fff}.card-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:16px}.card-head h2{margin:8px 0 0;font:500 1.65rem/1 Georgia,serif}.card-head a,.tool-link{color:var(--accent);font:700 .68rem/1 system-ui,sans-serif}.account-row,.voucher-row{display:flex;justify-content:space-between;gap:12px;padding:12px 0;border-top:1px solid rgba(16,36,31,.08);font:.76rem/1.3 system-ui,sans-serif}.account-row b,.voucher-row b{font-weight:700}.account-row em,.voucher-row em{color:var(--muted);font:.65rem/1.3 system-ui,sans-serif;font-style:normal;white-space:nowrap}.muted{color:var(--muted);font:.76rem/1.4 system-ui,sans-serif}.finance-tools{display:grid;grid-template-columns:1fr 1fr;gap:30px;margin-top:52px;padding:28px;border-radius:20px;background:#eaf2e7}.finance-tools h2{margin:9px 0 12px;font:500 2rem/1 Georgia,serif}.finance-tools p{max-width:520px;color:var(--muted);font:.82rem/1.6 system-ui,sans-serif}.tool-actions{display:flex;flex-direction:column;justify-content:center;align-items:flex-start;gap:14px}.tool-button{padding:13px 16px;border-radius:10px;background:#10241f;color:#fff;font:700 .76rem/1 system-ui,sans-serif;border:0;cursor:pointer}.tool-button:hover{color:#fff;background:#28624c}.tool-button:disabled{opacity:.6;cursor:wait}.tool-button-secondary{background:#28624c}.finance-boundary{margin-top:20px;color:var(--muted);font:.68rem/1.4 system-ui,sans-serif}.finance-actions{margin-top:35px;padding:24px;border:1px solid rgba(16,36,31,.09);border-radius:18px;background:#f5f8f5}.finance-actions-head{display:flex;justify-content:space-between;gap:20px;align-items:flex-start}.finance-actions-head h2{margin:9px 0 7px;font:500 1.7rem/1 Georgia,serif}.finance-actions-head p{margin:0;color:var(--muted);font:.78rem/1.5 system-ui,sans-serif}.hitl-badge{padding:8px 10px;border-radius:999px;background:#dff2d2;color:#27643f;font:700 .62rem/1 system-ui,sans-serif;white-space:nowrap}.finance-action-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px;margin-top:20px}.finance-action-grid form{display:flex;flex-direction:column;gap:9px;padding:15px;border:1px solid rgba(16,36,31,.1);border-radius:13px;background:#fff}.finance-action-grid h3{margin:0 0 3px;font:700 .78rem/1.2 system-ui,sans-serif}.finance-action-grid label{display:flex;flex-direction:column;gap:5px;color:var(--muted);font:600 .62rem/1.2 system-ui,sans-serif}.finance-action-grid input,.finance-action-grid select{width:100%;box-sizing:border-box;padding:8px;border:1px solid rgba(16,36,31,.15);border-radius:8px;background:#fbfdfb;color:var(--night);font:400 .71rem/1.25 system-ui,sans-serif}.finance-action-grid button{margin-top:auto;padding:9px;border:0;border-radius:8px;background:#10241f;color:#fff;cursor:pointer;font:700 .67rem/1 system-ui,sans-serif}.finance-action-grid button:hover{background:#28624c}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:7px}.form-note{margin:0;color:var(--muted);font:.66rem/1.4 system-ui,sans-serif}.action-status{min-height:1.2em;margin:14px 0 0;color:#27643f;font:700 .72rem/1.4 system-ui,sans-serif}@media(max-width:1100px){.finance-action-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:760px){.finance-hero,.finance-grid,.finance-tools{grid-template-columns:1fr}.ledger-orb{width:160px;height:160px;margin:0}.finance-metrics{grid-template-columns:repeat(2,1fr)}.finance-action-grid{grid-template-columns:1fr 1fr}.finance-actions-head{flex-direction:column}}@media(max-width:500px){.finance-shell{padding:24px 15px 55px}.finance-hero{padding:28px 22px}.finance-metrics{grid-template-columns:1fr}.account-row,.voucher-row{flex-direction:column;gap:5px}.finance-action-grid{grid-template-columns:1fr}.form-row{grid-template-columns:1fr}}
</style>
