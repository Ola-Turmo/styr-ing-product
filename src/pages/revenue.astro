---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Inntektsplanlegging" activeNav="revenue"><main class="r-shell"><section class="r-hero"><div><span class="eyebrow">Styr.ing · inntektsplanlegging</span><h1>Skill faktura<br /><em>fra inntekt.</em></h1><p>Planlegg periodisering per leveranse og periode, slik at kommersielt salg kan gjennomgås før regnskapsmessig bokføring.</p><a href="#r-work" class="primary">Åpne inntektsbildet ↓</a></div><div class="r-orb"><strong id="hero-review">—</strong><span>poster til kontroll</span><small id="hero-planned">— planlagt</small></div></section><section class="metrics"><article><span>Kontrakter</span><strong id="m-contracts">—</strong><small>aktive eller til review</small></article><article><span>Transaksjonspris</span><strong id="m-total">—</strong><small>kontrakter i registeret</small></article><article><span>Planlagt inntekt</span><strong id="m-planned">—</strong><small>ikke bokført</small></article><article class="dark"><span>Bokføring</span><strong>STOPP</strong><small>må gjennomgås separat</small></article></section><section id="r-work" class="workspace"><div class="head"><div><span class="kicker">IFRS 15-forberedelse</span><h2>Kontrakter og periodisering</h2></div><span id="status">Henter…</span></div><nav class="tabs">{[['contracts','Kontrakter'],['obligations','Leveranseforpliktelser'],['schedule','Periodisering']].map(([key,label],i)=><button class={i===0?'active':''} data-view={key}>{label}</button>)}</nav><div id="list"></div></section><section class="notice"><strong>Kontrollgrense</strong><p>Dette er et beslutningsgrunnlag, ikke autoritativ IFRS 15-bokføring. Vurdering av leveranse, transaksjonspris, modifikasjoner og endelig postering krever ansvarlig regnskapsfører.</p></section></main></Layout>
<script is:inline>
const esc=v=>String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));const list=document.getElementById('list'),status=document.getElementById('status');const labels={draft:'Utkast',review:'Til kontroll',approved:'Godkjent',active:'Aktiv',planned:'Planlagt',posted:'Bokført',over_time:'Over tid',point_in_time:'På tidspunkt'};const pill=v=>`<em class="pill">${esc(labels[v]||v||'—')}</em>`;const money=n=>`${new Intl.NumberFormat('nb-NO').format(Number(n||0)/100)} NOK`;const render=(view,rows)=>{const f={contracts:r=>`<article><div><strong>${esc(r.contract_number)} · ${esc(r.title)}</strong><p>${esc(r.company_name)} · ${esc(r.start_date)}–${esc(r.end_date)}</p></div>${pill(r.status)}<b>${money(r.transaction_price_minor)}</b></article>`,obligations:r=>`<article><div><strong>${esc(r.contract_number)} · ${esc(r.description)}</strong><p>${esc(r.satisfied_percent)}% tilfredsstilt</p></div>${pill(r.recognition_method)}<b>${money(r.allocated_minor)}</b></article>`,schedule:r=>`<article><div><strong>${esc(r.period)} · ${esc(r.contract_number)}</strong><p>${esc(r.obligation_description||'Leveranseforpliktelse')}</p></div>${pill(r.status)}<b>${money(r.planned_minor)}</b></article>`};list.innerHTML=rows.length?rows.map(f[view]).join(''):'<p class="empty">Ingen registrerte rader.</p>';};const load=async view=>{try{const d=await (await fetch(`/api/revenue?boardId=board-1&view=${view}`)).json();render(view,d.data||[]);status.textContent=`${(d.data||[]).length} poster · kilde synlig`;}catch{status.textContent='API utilgjengelig'}};const summary=async()=>{try{const d=(await (await fetch('/api/revenue?boardId=board-1&view=summary')).json()).data||{};document.getElementById('m-contracts').textContent=d.contracts?.count??0;document.getElementById('m-total').textContent=money(d.total?.amount_minor);document.getElementById('m-planned').textContent=money(d.planned?.amount_minor);document.getElementById('hero-review').textContent=`${d.review?.count??0} poster til kontroll`;document.getElementById('hero-planned').textContent=money(d.planned?.amount_minor)+' planlagt';}catch{}};document.querySelectorAll('.tabs button').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.tabs button').forEach(x=>x.classList.remove('active'));b.classList.add('active');load(b.dataset.view)}));summary();load('contracts');
</script>
<style>.r-shell{max-width:1180px;margin:0 auto;padding:38px 24px 80px}.r-hero{display:grid;grid-template-columns:1fr .45fr;align-items:center;gap:24px;padding:44px;border-radius:27px;background:linear-gradient(120deg,#39284d,#72538d);color:#fff}.eyebrow,.kicker{font:700 .68rem system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:#ecd8ff}.r-hero h1{margin:20px 0 16px;font:500 clamp(2.5rem,5vw,4.4rem)/.96 Georgia,serif}.r-hero h1 em{color:#e7caff;font-style:normal}.r-hero p{max-width:570px;color:#ffffffbf;font:1rem/1.6 system-ui,sans-serif}.primary{display:inline-flex;margin-top:22px;padding:13px 17px;border-radius:10px;background:#e7caff;color:#39284d;font:700 .78rem system-ui,sans-serif}.r-orb{width:190px;height:190px;display:flex;flex-direction:column;align-items:center;justify-content:center;border:1px solid #e7caffaa;border-radius:50%;background:#5b3f72;color:#fff}.r-orb strong{font:500 2.6rem Georgia,serif;color:#f0d9ff}.r-orb span,.r-orb small{font:.68rem system-ui,sans-serif;text-align:center}.r-orb small{margin-top:9px;color:#d9c1eb}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:16px 0 52px}.metrics article{min-height:105px;padding:17px;border:1px solid #10241f14;border-radius:15px;background:#fff;display:flex;flex-direction:column;justify-content:space-between}.metrics .dark{background:#10241f;color:#fff}.metrics span,.metrics small{color:#718078;font:600 .67rem system-ui,sans-serif}.metrics strong{font:500 1.55rem Georgia,serif}.workspace{padding:28px;border:1px solid #10241f18;border-radius:20px;background:#fff}.head{display:flex;justify-content:space-between;align-items:end}.head h2{margin:9px 0 0;font:500 2.1rem Georgia,serif}.head>span{color:#718078;font:.7rem system-ui,sans-serif}.tabs{display:flex;gap:6px;overflow:auto;margin:25px 0 12px}.tabs button{padding:10px 14px;border:1px solid #10241f1c;border-radius:9px;background:#fafbf9;color:#65746b;cursor:pointer;font:700 .72rem system-ui,sans-serif;white-space:nowrap}.tabs button.active{background:#72538d;color:#fff}.workspace article{display:grid;grid-template-columns:1.6fr auto auto;gap:12px;align-items:center;padding:15px 4px;border-top:1px solid #10241f12}.workspace strong{font:600 .82rem system-ui,sans-serif}.workspace p{margin:5px 0 0;color:#718078;font:.7rem/1.35 system-ui,sans-serif}.pill{padding:5px 8px;border-radius:999px;background:#f0e6f8;color:#72538d;font:700 .61rem system-ui,sans-serif;font-style:normal;white-space:nowrap}.notice{margin-top:35px;padding:22px 25px;border-radius:16px;background:#f3ebf8}.notice strong{font:700 .78rem system-ui,sans-serif}.notice p{margin:8px 0 0;color:#63736a;font:.78rem/1.5 system-ui,sans-serif}@media(max-width:800px){.r-hero{grid-template-columns:1fr}.metrics{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.r-shell{padding:20px 15px 55px}.r-hero{padding:28px 22px}.metrics{grid-template-columns:1fr}.workspace{padding:20px 16px}.workspace article{grid-template-columns:1fr auto}.workspace article b{grid-column:1}}
</style>
