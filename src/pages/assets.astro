---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Anleggsmidler" activeNav="assets"><main class="a-shell"><section class="a-hero"><div><span class="eyebrow">Styr.ing · anleggsmidler</span><h1>To avskrivningsspor.<br /><em>Én forklaring.</em></h1><p>Følg anskaffelseskost, bokført verdi og forskjellen mellom regnskapsmessig og skattemessig avskrivning uten å miste kontrollsporet.</p><a href="#a-work" class="primary">Åpne anleggsregisteret ↓</a></div><div class="a-orb"><strong id="hero-assets">—</strong><span>aktive eiendeler</span><small id="hero-review">— til kontroll</small></div></section><section class="metrics"><article><span>Anskaffelseskost</span><strong id="m-cost">—</strong><small>aktive eiendeler</small></article><article><span>Avskrevet</span><strong id="m-dep">—</strong><small>regnskapsmessig hittil</small></article><article><span>Til gjennomgang</span><strong id="m-review">—</strong><small>før bokføring</small></article><article class="dark"><span>Bokføring</span><strong>STOPP</strong><small>bilag må godkjennes separat</small></article></section><section id="a-work" class="workspace"><div class="head"><div><span class="kicker">Dual ledger</span><h2>Anleggsmidler og avskrivning</h2></div><span id="status">Henter…</span></div><nav class="tabs">{[['assets','Eiendeler'],['depreciation','Avskrivninger']].map(([key,label],i)=><button class={i===0?'active':''} data-view={key}>{label}</button>)}</nav><div id="list"></div></section><section class="notice"><strong>Kontrollgrense</strong><p>Beregningene er et internt kontrollgrunnlag. Skatteklasse, levetid, restverdi og endelig bokføring må kvalitetssikres av ansvarlig regnskapsfører før postering eller rapportering.</p></section></main></Layout>
<script is:inline>
const esc=v=>String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));const list=document.getElementById('list'),status=document.getElementById('status');const labels={active:'Aktiv',financial:'Regnskap',tax:'Skatt',calculated:'Beregnet',review:'Til kontroll',approved:'Godkjent'};const pill=v=>`<em class="pill">${esc(labels[v]||v||'—')}</em>`;const money=n=>`${new Intl.NumberFormat('nb-NO').format(Number(n||0)/100)} NOK`;const render=(view,rows)=>{const f={assets:r=>`<article><div><strong>${esc(r.asset_number)} · ${esc(r.name)}</strong><p>${esc(r.category)} · Anskaffet ${esc(r.acquisition_date)} · Skattegruppe ${esc(r.tax_group||'—')}</p></div>${pill(r.status)}<b>${money(r.acquisition_cost_minor)}</b></article>`,depreciation:r=>`<article><div><strong>${esc(r.period)} · ${esc(r.asset_number)} · ${esc(r.name)}</strong><p>Bokført verdi ${money(r.book_value_minor)} · Akkumulert ${money(r.accumulated_minor)}</p></div>${pill(r.ledger_type)}${pill(r.status)}<b>${money(r.amount_minor)}</b></article>`};list.innerHTML=rows.length?rows.map(f[view]).join(''):'<p class="empty">Ingen registrerte rader.</p>';};const load=async view=>{try{const d=await (await fetch(`/api/assets?boardId=board-1&view=${view}`)).json();render(view,d.data||[]);status.textContent=`${(d.data||[]).length} poster · kilde synlig`;}catch{status.textContent='API utilgjengelig'}};const summary=async()=>{try{const d=(await (await fetch('/api/assets?boardId=board-1&view=summary')).json()).data||{};document.getElementById('hero-assets').textContent=d.assets?.count??0;document.getElementById('hero-review').textContent=`${d.review?.count??0} til kontroll`;document.getElementById('m-cost').textContent=money(d.cost?.amount_minor);document.getElementById('m-dep').textContent=money(d.depreciation?.amount_minor);document.getElementById('m-review').textContent=d.review?.count??0;}catch{}};document.querySelectorAll('.tabs button').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.tabs button').forEach(x=>x.classList.remove('active'));b.classList.add('active');load(b.dataset.view)}));summary();load('assets');
</script>
<style>.a-shell{max-width:1180px;margin:0 auto;padding:38px 24px 80px}.a-hero{display:grid;grid-template-columns:1fr .45fr;align-items:center;gap:24px;padding:44px;border-radius:27px;background:linear-gradient(120deg,#3d3422,#84703c);color:#fff}.eyebrow,.kicker{font:700 .68rem system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:#f4e5b2}.a-hero h1{margin:20px 0 16px;font:500 clamp(2.5rem,5vw,4.4rem)/.96 Georgia,serif}.a-hero h1 em{color:#f4df94;font-style:normal}.a-hero p{max-width:570px;color:#ffffffbf;font:1rem/1.6 system-ui,sans-serif}.primary{display:inline-flex;margin-top:22px;padding:13px 17px;border-radius:10px;background:#f4df94;color:#3e3523;font:700 .78rem system-ui,sans-serif}.a-orb{width:190px;height:190px;display:flex;flex-direction:column;align-items:center;justify-content:center;border:1px solid #f4df94aa;border-radius:50%;background:#66572e;color:#fff}.a-orb strong{font:500 3.2rem Georgia,serif;color:#f9e9ad}.a-orb span,.a-orb small{font:.68rem system-ui,sans-serif}.a-orb small{margin-top:9px;color:#e7d9a8}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:16px 0 52px}.metrics article{min-height:105px;padding:17px;border:1px solid #10241f14;border-radius:15px;background:#fff;display:flex;flex-direction:column;justify-content:space-between}.metrics .dark{background:#10241f;color:#fff}.metrics span,.metrics small{color:#718078;font:600 .67rem system-ui,sans-serif}.metrics strong{font:500 1.55rem Georgia,serif}.workspace{padding:28px;border:1px solid #10241f18;border-radius:20px;background:#fff}.head{display:flex;justify-content:space-between;align-items:end}.head h2{margin:9px 0 0;font:500 2.1rem Georgia,serif}.head>span{color:#718078;font:.7rem system-ui,sans-serif}.tabs{display:flex;gap:6px;margin:25px 0 12px}.tabs button{padding:10px 14px;border:1px solid #10241f1c;border-radius:9px;background:#fafbf9;color:#65746b;cursor:pointer;font:700 .72rem system-ui,sans-serif}.tabs button.active{background:#84703c;color:#fff}.workspace article{display:grid;grid-template-columns:1.6fr auto auto auto;gap:12px;align-items:center;padding:15px 4px;border-top:1px solid #10241f12}.workspace strong{font:600 .82rem system-ui,sans-serif}.workspace p{margin:5px 0 0;color:#718078;font:.7rem/1.35 system-ui,sans-serif}.pill{padding:5px 8px;border-radius:999px;background:#f6eed5;color:#766334;font:700 .61rem system-ui,sans-serif;font-style:normal;white-space:nowrap}.notice{margin-top:35px;padding:22px 25px;border-radius:16px;background:#f7f1df}.notice strong{font:700 .78rem system-ui,sans-serif}.notice p{margin:8px 0 0;color:#63736a;font:.78rem/1.5 system-ui,sans-serif}@media(max-width:800px){.a-hero{grid-template-columns:1fr}.metrics{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.a-shell{padding:20px 15px 55px}.a-hero{padding:28px 22px}.metrics{grid-template-columns:1fr}.workspace{padding:20px 16px}.workspace article{grid-template-columns:1fr auto}.workspace article b{grid-column:1}}
</style>
