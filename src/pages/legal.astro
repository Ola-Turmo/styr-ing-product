---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Avtaler og abonnement — Styr.ing" activeNav="legal">
  <main class="legal-shell">
    <section class="legal-hero"><div><span class="eyebrow">Kundeoppsett · avtaler</span><h1>Riktig grunnlag<br /><em>før aktivering.</em></h1><p>Se hvilke dokumentversjoner en virksomhet må akseptere, og om abonnementet har en verifisert betalingsstatus.</p></div><div class="legal-orb"><span>Billing</span><strong id="billing-status">—</strong><small id="billing-plan">henter status</small></div></section>
    <section class="legal-card"><div class="card-head"><div><span class="section-kicker">Gjeldende dokumenter</span><h2>Aksept og versjon</h2></div><span id="legal-status" class="muted">Henter…</span></div><div id="legal-list"><p class="muted">Henter avtalegrunnlag…</p></div></section>
    <section class="legal-card billing-card"><div><span class="section-kicker">Abonnement</span><h2>Betalingsstatus</h2><p>Stripe aktiveres først når konto, produkter/priser, skatt, juridiske vilkår og webhook-verifisering er på plass. Denne flaten viser statusen, men oppretter ikke checkout.</p></div><a href="/api/billing?boardId=board-1" class="api-link">API ↗</a></section>
    <p class="boundary">Offentlig preview · fiktive data · ingen abonnement eller betaling blir opprettet her.</p>
  </main>
</Layout>
<script is:inline>
  const esc = (v) => String(v ?? '').replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  fetch('/api/legal?boardId=board-1').then((response) => response.json()).then((data) => {
    const billing = data.billing || {}; document.querySelector('#billing-status').textContent = billing.status === 'not_configured' ? 'Ikke aktivert' : billing.status; document.querySelector('#billing-plan').textContent = billing.plan || 'pilot';
    const docs = data.documents || []; const accepted = new Set((data.acceptances || []).map((x) => `${x.document_type}:${x.document_version}`)); document.querySelector('#legal-status').textContent = `${docs.length} publiserte dokumenter`;
    const links = { privacy: '/personvern', terms: '/vilkar', subscription: '/abonnement', refund: '/refusjon', sla: '/sla', dpa: '/dpa' };
    document.querySelector('#legal-list').innerHTML = docs.length ? docs.map((doc) => `<div class="legal-row"><div><strong><a href="${links[doc.document_type] || '/legal'}">${esc(doc.title)} ↗</a></strong><span>${esc(doc.document_type)} · ${esc(doc.version)} · gjelder fra ${esc(doc.effective_at || '—')}</span></div><em>${accepted.has(`${doc.document_type}:${doc.version}`) ? 'Akseptert' : 'Krever aksept'}</em></div>`).join('') : '<p class="muted">Ingen publiserte produksjonsdokumenter er aktivert ennå.</p>';
  }).catch(() => { document.querySelector('#legal-status').textContent = 'API utilgjengelig'; });
</script>
<style>.legal-shell{max-width:1100px;margin:0 auto;padding:45px 24px 80px}.legal-hero{display:grid;grid-template-columns:1fr 240px;gap:35px;align-items:center;padding:40px;border-radius:25px;background:linear-gradient(120deg,#2d263b,#5f4c78);color:#fff}.eyebrow,.section-kicker{font:700 .68rem/1 system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase}.eyebrow{color:#e8d9ff}.legal-hero h1{font:500 clamp(2.6rem,5vw,4.3rem)/.94 Georgia,serif;letter-spacing:-.05em;margin:16px 0}.legal-hero h1 em{color:#e8d9ff;font-style:normal}.legal-hero p{max-width:570px;color:rgba(255,255,255,.75);font:.9rem/1.6 system-ui,sans-serif}.legal-orb{width:180px;height:180px;border-radius:50%;display:flex;flex-direction:column;justify-content:center;align-items:center;background:rgba(24,16,39,.3);border:1px solid rgba(232,217,255,.55);margin:auto}.legal-orb span,.legal-orb small{font:700 .63rem/1 system-ui,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:#d9c8ef}.legal-orb strong{font:500 1.35rem/1 Georgia,serif;color:#fff;margin:12px 0;text-align:center}.legal-card{display:flex;justify-content:space-between;gap:25px;margin-top:18px;padding:23px;border:1px solid rgba(16,36,31,.09);border-radius:16px;background:#fff}.card-head{display:flex;justify-content:space-between;align-items:end;gap:20px;width:100%;margin-bottom:15px}.card-head h2,.legal-card h2{margin:8px 0 0;font:500 1.6rem/1 Georgia,serif}.legal-card>div:first-child{flex:1}.legal-row{display:flex;justify-content:space-between;gap:18px;padding:14px 0;border-top:1px solid rgba(16,36,31,.08);font:.75rem/1.3 system-ui,sans-serif}.legal-row strong,.legal-row span{display:block}.legal-row span{color:var(--muted);margin-top:4px;font-size:.67rem}.legal-row em{color:var(--accent);font:.67rem/1 system-ui,sans-serif;font-style:normal;white-space:nowrap}.billing-card{align-items:center}.billing-card p{max-width:700px;color:var(--muted);font:.78rem/1.55 system-ui,sans-serif;margin-top:12px}.api-link{color:var(--accent);font:700 .68rem/1 system-ui,sans-serif;white-space:nowrap}.muted,.boundary{color:var(--muted);font:.7rem/1.4 system-ui,sans-serif}.boundary{margin-top:15px}@media(max-width:720px){.legal-hero{grid-template-columns:1fr;padding:28px 22px}.legal-orb{width:155px;height:155px;margin:0}.legal-card{flex-direction:column}.card-head{align-items:flex-start;flex-direction:column;gap:8px}.legal-row{flex-direction:column;gap:7px}}
</style>
