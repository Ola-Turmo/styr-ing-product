---
// Onboarding Wizard — Guided board setup per PRD
import Layout from '../layouts/Layout.astro';
---
<Layout title="Kom i gang — Styr.ing" activeNav="onboarding">
<div class="onboarding-page">
  <h1 class="page-title">Kom i gang med regnskapet</h1>
  <div class="progress-bar" id="progress">
    <div class="step active" data-step="1"><span>1</span>Regnskap</div>
    <div class="step-connector"></div>
    <div class="step" data-step="2"><span>2</span>Virksomhet</div>
    <div class="step-connector"></div>
    <div class="step" data-step="3"><span>3</span>Kontroller</div>
    <div class="step-connector"></div>
    <div class="step" data-step="4"><span>4</span>Klar</div>
  </div>

  <div id="step-company" class="onboarding-card">
    <h2>Start med den vanlige regnskapshverdagen</h2>
    <p class="card-desc">Dette er en trygg forhåndsvisning med fiktive data. Se hvordan bilag, faktura, bank og MVA samles før du kobler til en virksomhet.</p>
    <form onsubmit="event.preventDefault();switchStep(2)">
      <div class="form-group"><label for="demo-company">Bedriftens navn</label><input id="demo-company" type="text" value="Pilotselskap AS" autocomplete="off"/></div>
      <div class="form-row"><div class="form-group"><label for="demo-org-number">Org.nummer</label><input id="demo-org-number" type="text" value="123456789" inputmode="numeric" autocomplete="off"/></div><div class="form-group"><label for="demo-employees">Ansatte</label><select id="demo-employees"><option>1-10</option><option selected>11-50</option><option>51-200</option></select></div></div>
      <div class="form-group"><label for="demo-industry">Bransje</label><select id="demo-industry"><option>Teknologi/IT</option><option selected>Konsulent/rådgivning</option><option>Finans</option><option>Helse</option></select></div>
      <div class="form-group"><label>Hva vil du få kontroll på først?</label>
        <div class="check-group">
          <label class="check-option"><input type="checkbox" checked/>Bilag og bokføring</label>
          <label class="check-option"><input type="checkbox" checked/>Faktura og bank</label>
          <label class="check-option"><input type="checkbox" checked/>MVA og lønn</label>
        </div>
      </div>
      <button type="submit" class="btn-primary">Neste →</button>
    </form>
  </div>

  <div id="step-board" class="onboarding-card" style="display:none">
    <h2>Virksomhet og regnskapsår</h2>
    <p class="card-desc">Velg en enkel start. Du kan senere legge til styre, prosjekt og andre arbeidsflater.</p>
    <div class="board-comp">
      <div class="role-row"><span aria-hidden="true">▦</span><input type="text" value="Pilotselskap AS" aria-label="Demo virksomhetsnavn" autocomplete="off"/><select aria-label="Selskapsform"><option selected>AS</option><option>ENK</option></select><input type="text" value="2026" aria-label="Regnskapsår" inputmode="numeric" autocomplete="off"/></div>
      <div class="role-row"><span aria-hidden="true">₿</span><input type="text" value="NOK" aria-label="Hovedvaluta" autocomplete="off"/><select aria-label="MVA-registrering"><option selected>MVA-registrert</option><option>Ikke MVA-registrert</option></select><input type="text" value="12 åpne perioder" aria-label="Åpne perioder" autocomplete="off"/></div>
      <span class="add-btn demo-control" aria-label="Ikke-aktiv demokontroll">Styre og flere brukere · senere</span>
    </div>
    <div class="step-nav"><button class="btn-outline" onclick="switchStep(1)">← Tilbake</button><button class="btn-primary" onclick="switchStep(3)">Neste →</button></div>
  </div>

  <div id="step-cadence" class="onboarding-card" style="display:none">
    <h2>Kontroller før du begynner</h2>
    <p class="card-desc">Regnskapet blir mest nyttig når grunnlaget er riktig. Velg hvordan du vil starte, og gå videre til arbeidsflaten.</p>
    <form onsubmit="event.preventDefault();switchStep(4)">
      <div class="form-group"><label for="demo-frequency">Første arbeidsflyt</label><select id="demo-frequency"><option selected>Bilag og bokføring</option><option>Faktura og kunder</option><option>Bankavstemming</option></select></div>
      <div class="form-group"><label for="demo-meeting-day">Kontrollnivå</label><select id="demo-meeting-day"><option selected>Kontroller før bokføring</option><option>To personer ved behov</option></select></div>
      <div class="form-group"><label for="demo-signature">Eksterne innsendinger</label><select id="demo-signature"><option selected>Ikke konfigurert ennå</option><option>Avklares med regnskapsfører</option></select></div>
      <div class="form-group"><label for="demo-approval">Neste steg</label><select id="demo-approval"><option selected>Åpne regnskapsflaten</option><option>Se offentlig demo først</option></select></div>
      <div class="step-nav"><button type="button" class="btn-outline" onclick="switchStep(2)">← Tilbake</button><button type="submit" class="btn-primary">Vis demooppsummering →</button></div>
    </form>
  </div>

  <div id="step-confirm" class="onboarding-card" style="display:none">
    <div class="success-icon">✓</div>
    <h2>Regnskapsstarten er klar</h2>
    <p class="card-desc">Dette er fortsatt en lokal forhåndsvisning. Ingen konto, virksomhet eller integrasjon er opprettet.</p>
    <div class="blueprint">
      <h3>Driftsplan</h3>
      <div class="bp-grid">
        <div class="bp-item"><span class="bp-l">Bedrift</span><span>Pilotselskap AS</span></div>
        <div class="bp-item"><span class="bp-l">Kjerne</span><span>Bilag, faktura, bank, MVA og lønn</span></div>
        <div class="bp-item"><span class="bp-l">Kontroll</span><span>Balanserte bilag før bokføring</span></div>
        <div class="bp-item"><span class="bp-l">Regnskapsår</span><span>12 åpne perioder · klar for oppstart</span></div>
        <div class="bp-item"><span class="bp-l">Tillegg</span><span>Styre, prosjekt og risiko kan aktiveres senere</span></div>
      </div>
      <h3>Neste steg i Styr.ing</h3>
      <div class="agent-list">
        <div>▤ Regnskapsflaten — før bilag og følg åpne kontrollpunkter</div>
        <div>↗ Faktura og bank — bygg grunnlaget før betaling eller innsending</div>
        <div>＋ Utvidelser — styre og prosjekt når hverdagen krever det</div>
      </div>
    </div>
    <div style="text-align:center;margin-top:2rem">
      <a href="/app/finance" class="btn-primary" style="display:inline-block;text-decoration:none;padding:14px 40px;font-size:1.1rem">Åpne regnskapsflaten →</a>
    </div>
  </div>

  <div class="demo-notice">Demo av onboarding-flyt. Innlogging, virksomhetstilgang, eksterne innsendinger og eventuell KI-assistanse må avtales og verifiseres separat.</div>
</div>

<script is:inline>
function switchStep(n) {
  ['step-company','step-board','step-cadence','step-confirm'].forEach((id,i) => {
    document.getElementById(id).style.display = (i+1 === n) ? 'block' : 'none';
  });
  document.querySelectorAll('.step').forEach((el,i) => {
    el.className = 'step' + (i+1 < n ? ' done' : i+1 === n ? ' active' : '');
  });
  document.querySelectorAll('.step-connector').forEach((el,i) => {
    el.className = 'step-connector' + (i+1 < n ? ' done' : '');
  });
}
</script>
</Layout>

<style>
.onboarding-page { max-width: 640px; margin: 2rem auto; padding: 0 20px; }
.page-title { font-size: clamp(1.6rem, 4vw, 2.1rem); margin: 0 0 1.25rem; text-align: center; }
.progress-bar { display: flex; align-items: center; justify-content: center; margin-bottom: 2rem; }
.step { display: flex; flex-direction: column; align-items: center; gap: 6px; font-family: system-ui, sans-serif; font-size: 0.75rem; color: #ccc; }
.step span { width: 30px; height: 30px; border-radius: 50%; background: #eee; color: #aaa; font-weight: 700; font-size: 0.78rem; display: flex; align-items: center; justify-content: center; }
.step.done span { background: var(--accent); color: white; }
.step.done { color: var(--accent); }
.step.active span { background: var(--accent); color: white; box-shadow: 0 0 0 4px rgba(31,111,91,0.15); }
.step.active { color: var(--accent); font-weight: 700; }
.step-connector { width: 36px; height: 2px; background: #eee; margin: 0 6px 18px; }
.step-connector.done { background: var(--accent); }

.onboarding-card { background: white; border: 1px solid rgba(16,36,31,0.08); border-radius: 16px; padding: 32px; }
.onboarding-card h2 { font-size: 1.3rem; margin: 0 0 4px; }
.card-desc { font-family: system-ui, sans-serif; font-size: 0.85rem; color: var(--muted); margin: 0 0 20px; line-height: 1.4; }

.form-group { margin-bottom: 14px; }
.form-group label { display: block; font-family: system-ui, sans-serif; font-size: 0.78rem; font-weight: 600; color: var(--ink); margin-bottom: 4px; }
.form-group input, .form-group select { width: 100%; padding: 10px 12px; border: 1.5px solid rgba(16,36,31,0.12); border-radius: 8px; font-family: system-ui, sans-serif; font-size: 0.88rem; box-sizing: border-box; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

.check-group { display: flex; flex-wrap: wrap; gap: 10px; }
.check-option { font-family: system-ui, sans-serif; font-size: 0.82rem; display: flex; align-items: center; gap: 6px; cursor: pointer; }

.btn-primary { background: var(--accent); color: white; border: none; padding: 10px 24px; border-radius: 8px; font-family: system-ui, sans-serif; font-size: 0.88rem; font-weight: 600; cursor: pointer; }
.btn-outline { background: transparent; border: 1.5px solid rgba(16,36,31,0.2); color: var(--ink); padding: 10px 24px; border-radius: 8px; font-family: system-ui, sans-serif; font-size: 0.88rem; cursor: pointer; }
.step-nav { display: flex; justify-content: space-between; margin-top: 20px; }

.board-comp { display: flex; flex-direction: column; gap: 10px; margin-bottom: 16px; }
.role-row { display: flex; gap: 8px; align-items: center; padding: 8px; border: 1px solid rgba(0,0,0,0.06); border-radius: 8px; }
.role-row span { font-size: 1.2rem; }
.role-row input, .role-row select { padding: 6px 8px; border: 1px solid rgba(0,0,0,0.1); border-radius: 6px; font-family: system-ui, sans-serif; font-size: 0.82rem; flex: 1; min-width: 0; }
.add-btn { background: transparent; border: 2px dashed rgba(16,36,31,0.12); border-radius: 8px; padding: 10px; width: 100%; font-family: system-ui, sans-serif; font-size: 0.82rem; color: var(--muted); cursor: pointer; }
.demo-control { display: block; box-sizing: border-box; text-align: center; cursor: default; opacity: 0.72; }

.success-icon { width: 52px; height: 52px; border-radius: 50%; background: #27ae60; color: white; font-size: 1.4rem; display: flex; align-items: center; justify-content: center; margin: 0 auto 12px; }

.blueprint h3 { font-size: 0.95rem; margin: 16px 0 10px; }
.bp-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
.bp-item { padding: 10px; background: rgba(31,111,91,0.03); border-radius: 6px; font-family: system-ui, sans-serif; font-size: 0.8rem; }
.bp-l { display: block; font-size: 0.65rem; font-weight: 700; text-transform: uppercase; color: var(--muted); margin-bottom: 2px; }

.agent-list { display: flex; flex-direction: column; gap: 6px; }
.agent-list div { font-family: system-ui, sans-serif; font-size: 0.8rem; padding: 8px; background: rgba(31,111,91,0.04); border-radius: 6px; }

.demo-notice { text-align: center; padding: 1.5rem; margin-top: 2rem; background: rgba(31,111,91,0.06); border-radius: 12px; font-family: system-ui, sans-serif; font-size: 0.85rem; color: var(--muted); }

@media (max-width: 520px) {
  .onboarding-card { padding: 22px 16px; }
  .form-row, .bp-grid { grid-template-columns: 1fr; }
  .role-row { flex-wrap: wrap; }
  .role-row span { width: 100%; }
  .role-row input, .role-row select { flex: 1 1 100%; width: 100%; }
  .step-nav { gap: 8px; flex-wrap: wrap; }
}
</style>
