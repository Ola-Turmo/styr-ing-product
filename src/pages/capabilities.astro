---
import Layout from '../layouts/Layout.astro';
const domains = [
  { key:'governance', number:'01', label:'Styre og beslutninger', title:'Fra sak til vedtak', intro:'Møter, sakspapirer, fremmøte, avstemninger, vedtak og oppgaver i samme spor.', status:'live', statusLabel:'Arbeidsflyt live', color:'mint', features:['Agenda og dokumenter','Fremmøte og avstemning','Vedtak med ansvar og frist','Kontrakter og mandater'], href:'/board' },
  { key:'risk', number:'02', label:'Risiko og kontroll', title:'Kontroll som faktisk følges opp', intro:'Gjør risiko, kontrollaktiviteter, bevis og avvik synlige for styret og ledelsen.', status:'live', statusLabel:'Arbeidsflyt live', color:'blue', features:['Risikoregister og tiltak','Internkontroll med status','Auditert oppfølging','Dokumentert beslutningsgrunnlag'], href:'/risk' },
  { key:'finance', number:'03', label:'Økonomi og lønn', title:'Tall med kilde og godkjenning', intro:'Kontrollbilder for regnskap, lønn, eiendeler, perioder og inntektsplaner – uten å late som Styr.ing er et ERP.', status:'preview', statusLabel:'Kontrollert preview', color:'gold', features:['Bilag, perioder og SAF-T-eksport','Lønnskontroller og godkjenning','Avskrivning og inntektsplan','Likviditetsbilde og innkreving'], href:'/finance' },
  { key:'people', number:'04', label:'Mennesker', title:'Ansvar fra ansettelse til avslutning', intro:'Roller, rekruttering, mål, onboarding, samtaler og offboarding med tydelig eier.', status:'preview', statusLabel:'Kontrollert preview', color:'rose', features:['Kandidater og rekruttering','Mål og medarbeideroppfølging','Onboarding og opplæring','Tilgangs- og avslutningskø'], href:'/people' },
  { key:'operations', number:'05', label:'Drift og IT', title:'Oppgaver som ikke faller mellom stoler', intro:'IT-saker, eiendeler, tilgangsrevisjon og operativ oppfølging på tvers av virksomheten.', status:'preview', statusLabel:'Kontrollert preview', color:'violet', features:['IT-saker og ansvar','Eiendeler og SaaS-oversikt','Tilgangsrevisjon','Operativ cockpit'], href:'/it' },
  { key:'commercial', number:'06', label:'Kunder og innkjøp', title:'Fra kundeinnsikt til leveranse', intro:'Følg pipeline, tilbud, kundesaker, innkjøp og leverandørkontroll i samme arbeidsflate.', status:'preview', statusLabel:'Kontrollert preview', color:'orange', features:['Kunder, pipeline og tilbud','Salgsrom og kundesaker','Innkjøpsflyt og mottak','Leverandørfaktura til kontroll'], href:'/commercial' },
  { key:'projects', number:'07', label:'Prosjekt og felt', title:'Tid, arbeid og leveranse', intro:'Prosjektstatus, timer, kjørelister og oppfølging med tydelig fakturagrunnlag.', status:'preview', statusLabel:'Kontrollert preview', color:'teal', features:['Prosjekt og milepæler','Timer og arbeidspakker','Kjørelister og utlegg','Vedlikehold og feltoppgaver'], href:'/field' },
  { key:'platform', number:'08', label:'Plattform og AI', title:'Søkbar kontekst, menneskelig kontroll', intro:'Felles hendelser, søk og assistanse som foreslår neste steg – aldri som en skjult autopilot.', status:'adapter', statusLabel:'Krever adapter/avtale', color:'indigo', features:['Arbeidsflate og tenant-isolasjon','Kontrollert søk og hendelser','AI-forslag med kildespor','HITL-godkjenning og audit'], href:'/workspace' },
];
const roadmap = [
  ['Tilgjengelig nå','Fiktive data i offentlig demo og arbeidsflyter for styre, risiko, kontroll og oppfølging.','live'],
  ['Pilot med virksomhet','Tenant-tilgang, roller, skrivehandlinger og kontrollert datagrunnlag aktiveres per kunde.','preview'],
  ['Koblede tjenester','Altinn, bank, EHF, eID, betaling, lønn og andre adaptere krever kontoer, avtaler og godkjenning.','adapter'],
];
---
<Layout title="Produkt og arbeidsflater" activeNav="capabilities">
  <main class="cap-shell">
    <section class="cap-hero"><div><span class="eyebrow"><i></i> Norsk SaaS for virksomhetsstyring</span><h1>Se hva dere kan styre<br /><em>fra ett sted.</em></h1><p>Styr.ing kobler styrearbeid, risiko, kontroll og oppfølging. Start med det viktigste, og aktiver flere arbeidsflater når ansvar, roller og datagrunnlag er avklart.</p><div class="hero-actions"><a class="button" href="/workspace">Åpne arbeidsflaten <span>↗</span></a><a class="text-link" href="mailto:ola@styr.ing?subject=Pilot%20av%20Styr.ing">Snakk med oss <span>→</span></a></div></div><div class="hero-panel" aria-label="Status for produktet"><div class="orb"><strong>08</strong><span>arbeidsflater</span></div><div><b>Én tydelig modell</b><p>Kilde · ansvar · godkjenning · historikk</p></div></div></section>
    <section class="truth-note" role="note"><strong>Ærlig produktkart.</strong><span>«Live» betyr at arbeidsflyten finnes i previewet. «Kontrollert preview» bruker eksempeldata. Eksterne innsendinger og betalinger skjer ikke uten konfigurert adapter, avtale og menneskelig godkjenning.</span><a href="/trust">Se tillitsmodellen ↗</a></section>
    <section class="search-panel" aria-label="Søk i arbeidsflatene"><div class="search-label"><span>⌕</span><label for="cap-search">Finn en arbeidsflate</label><kbd>⌘ K</kbd></div><input id="cap-search" type="search" placeholder="Prøv «lønn», «EHF», «risiko» eller «vedtak» …" autocomplete="off" /><p id="search-result" aria-live="polite">Viser alle 8 arbeidsflater</p></section>
    <div class="filter-row" role="toolbar" aria-label="Filtrer arbeidsflater"><button class="filter active" data-filter="all">Alle</button>{domains.map(domain => <button class="filter" data-filter={domain.key}>{domain.label}</button>)}</div>
    <section class="domain-grid" aria-label="Styr.ings arbeidsflater">{domains.map(domain => <article class={`domain-card ${domain.color}`} data-domain={domain.key}><div class="domain-head"><span class="domain-number">{domain.number}</span><span class="domain-label">{domain.label}</span><span class={`status ${domain.status}`}>{domain.statusLabel}</span></div><h2>{domain.title}</h2><p class="domain-intro">{domain.intro}</p><ul>{domain.features.map(feature => <li data-feature={feature.toLowerCase()}><span>↗</span>{feature}</li>)}</ul><a class="domain-link" href={domain.href}>Åpne relevant flate <span>→</span></a></article>)}</section>
    <section class="roadmap-section"><div class="section-heading"><span class="section-kicker">Slik skal det forstås</span><h2>Fra demo til<br /><em>trygg pilot.</em></h2><p>Styr.ing selger kun SaaS. Vi skiller derfor tydelig mellom det som er tilgjengelig i produktet, og det som krever eksterne leverandører.</p></div><div class="roadmap-list">{roadmap.map((item,index) => <div class={`roadmap-item ${item[2]}`}><span class="roadmap-index">0{index+1}</span><div><strong>{item[0]}</strong><p>{item[1]}</p></div><span class="roadmap-state">{item[2]==='live'?'Nå':item[2]==='preview'?'Pilot':'Avtale'}</span></div>)}</div></section>
    <section class="cap-cta"><div><span class="section-kicker">Neste steg</span><h2>Begynn med én beslutning.</h2><p>Utforsk eksempeldata nå, eller bestill en gjennomgang av hvilke arbeidsflater som passer virksomheten deres.</p></div><div class="cta-actions"><a href="/workspace" class="button">Se demo <span>↗</span></a><a href="mailto:ola@styr.ing?subject=Pilot%20av%20Styr.ing" class="cta-trust">Bestill pilot <span>→</span></a></div></section>
  </main>
</Layout>
<script is:inline>
  const search=document.querySelector('#cap-search');const result=document.querySelector('#search-result');const filters=[...document.querySelectorAll('.filter')];const cards=[...document.querySelectorAll('.domain-card')];
  const apply=()=>{const query=(search?.value||'').trim().toLowerCase();const active=document.querySelector('.filter.active')?.dataset.filter||'all';let visible=0;cards.forEach(card=>{const matches=(active==='all'||card.dataset.domain===active)&&(!query||card.textContent.toLowerCase().includes(query));card.hidden=!matches;if(matches)visible+=1});if(result)result.textContent=query?`${visible} arbeidsflate${visible===1?'':'r'} funnet`:`Viser ${visible} arbeidsflater`};
  filters.forEach(button=>button.addEventListener('click',()=>{filters.forEach(item=>item.classList.remove('active'));button.classList.add('active');apply()}));search?.addEventListener('input',apply);document.addEventListener('keydown',event=>{if((event.metaKey||event.ctrlKey)&&event.key.toLowerCase()==='k'){event.preventDefault();search?.focus()}});apply();
</script>
<style>
  .cap-shell{max-width:1180px;margin:0 auto;padding:38px 24px 80px}.cap-hero{display:grid;grid-template-columns:1fr .75fr;gap:30px;align-items:center;padding:48px 44px;border-radius:27px;color:#fff;background:linear-gradient(120deg,#102e27,#1d5744 68%,#2d6a52);box-shadow:0 22px 60px rgba(16,36,31,.14);overflow:hidden;position:relative}.cap-hero:after{content:'';position:absolute;width:430px;height:430px;right:-160px;top:-150px;border-radius:50%;background:radial-gradient(circle,rgba(203,247,125,.2),transparent 65%)}.eyebrow{display:flex;gap:8px;align-items:center;color:#d4f4ae;font:700 .7rem/1 system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase}.eyebrow i{width:7px;height:7px;border-radius:50%;background:#c8f77e;box-shadow:0 0 0 4px rgba(200,247,126,.18)}.cap-hero h1{font:500 clamp(2.45rem,5vw,4.2rem)/.98 Georgia,serif;letter-spacing:-.055em;margin:20px 0 18px}.cap-hero h1 em{color:#cef78a;font-style:normal}.cap-hero p{max-width:570px;margin:0;color:rgba(255,255,255,.74);font:1rem/1.65 system-ui,sans-serif}.hero-actions{display:flex;align-items:center;gap:18px;margin-top:26px}.button{display:inline-flex;align-items:center;gap:13px;padding:12px 16px;border-radius:10px;color:#16352b;background:#d5fb98;white-space:nowrap;font:700 .78rem/1 system-ui,sans-serif}.button:hover{color:#16352b;background:#e6ffbd}.text-link,.cta-trust{color:#d6f5b0;font:700 .72rem/1 system-ui,sans-serif}.hero-panel{position:relative;z-index:1;display:flex;gap:18px;align-items:center;justify-content:center}.orb{width:148px;height:148px;display:flex;flex-direction:column;align-items:center;justify-content:center;border:1px solid rgba(214,251,168,.5);border-radius:50%;background:rgba(7,39,30,.65);box-shadow:0 0 0 15px rgba(212,250,162,.05),0 0 50px rgba(199,248,121,.16)}.orb strong{color:#e0fbaa;font:500 3.6rem/.9 Georgia,serif}.orb span{color:#b4d6bb;font:700 .58rem/1 system-ui,sans-serif;letter-spacing:.1em;text-transform:uppercase;margin-top:9px}.hero-panel b{font:600 .9rem/1.2 system-ui,sans-serif}.hero-panel p{max-width:145px;margin-top:7px;color:#b7d6be;font:.72rem/1.45 system-ui,sans-serif}.truth-note{display:grid;grid-template-columns:auto 1fr auto;gap:13px;align-items:center;margin:24px 0 15px;padding:13px 16px;border:1px solid rgba(16,36,31,.1);border-radius:12px;background:#fff8df;color:var(--muted);font:.75rem/1.45 system-ui,sans-serif}.truth-note strong{color:var(--ink)}.truth-note a{white-space:nowrap;font-weight:700}.search-panel{margin:26px 0 14px;padding:15px 18px 13px;background:#fff;border:1px solid rgba(16,36,31,.1);border-radius:15px;box-shadow:0 12px 24px rgba(16,36,31,.04)}.search-label{display:flex;align-items:center;gap:8px;color:var(--muted);font:700 .67rem/1 system-ui,sans-serif;letter-spacing:.09em;text-transform:uppercase}.search-label>span{color:var(--accent);font-size:1.3rem;line-height:0}.search-label kbd{margin-left:auto;padding:4px 6px;border:1px solid rgba(16,36,31,.12);border-radius:5px;font:600 .62rem/1 system-ui,sans-serif}.search-panel input{width:100%;border:0;outline:0;color:var(--ink);background:transparent;padding:12px 0 5px;font:1rem/1.4 system-ui,sans-serif}.search-panel input::placeholder{color:#9aa9a0}.search-panel p{margin:3px 0 0;color:var(--muted);font:.7rem/1.3 system-ui,sans-serif}.filter-row{display:flex;flex-wrap:wrap;gap:7px;margin:14px 0 23px}.filter{cursor:pointer;border:1px solid rgba(16,36,31,.12);background:#fff;color:var(--muted);padding:8px 12px;border-radius:999px;font:600 .68rem/1 system-ui,sans-serif}.filter.active,.filter:hover{background:var(--night);border-color:var(--night);color:#fff}.domain-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.domain-card{min-height:290px;display:flex;flex-direction:column;padding:23px;border:1px solid rgba(16,36,31,.1);border-radius:17px;background:#fff;position:relative;overflow:hidden}.domain-card:after{content:'';position:absolute;right:-55px;bottom:-70px;width:180px;height:180px;border-radius:50%;background:currentColor;opacity:.05}.domain-card[hidden]{display:none}.domain-card.mint{color:#1f6f5b}.domain-card.blue{color:#3974a1}.domain-card.gold{color:#b38329}.domain-card.rose{color:#ad607c}.domain-card.violet{color:#726bb3}.domain-card.orange{color:#b66f32}.domain-card.teal{color:#27807b}.domain-card.indigo{color:#5962a4}.domain-head{display:flex;align-items:center;gap:10px}.domain-number{color:var(--muted);font:700 .65rem/1 system-ui,sans-serif;letter-spacing:.1em}.domain-label{font:700 .65rem/1 system-ui,sans-serif;letter-spacing:.1em;text-transform:uppercase}.status{margin-left:auto;padding:6px 8px;border-radius:999px;font:700 .57rem/1 system-ui,sans-serif;white-space:nowrap}.status.live{color:#23734f;background:#e3f4e7}.status.preview{color:#8b6118;background:#fff0d7}.status.adapter{color:#5c628d;background:#ececff}.domain-card h2{margin:20px 0 8px;color:var(--ink);font:500 1.55rem/1.05 Georgia,serif;letter-spacing:-.035em}.domain-intro{min-height:42px;max-width:470px;margin:0;color:var(--muted);font:.8rem/1.5 system-ui,sans-serif}.domain-card ul{display:grid;grid-template-columns:1fr 1fr;gap:8px 18px;list-style:none;padding:0;margin:22px 0}.domain-card li{display:flex;gap:7px;align-items:baseline;color:var(--ink);font:.75rem/1.35 system-ui,sans-serif}.domain-card li span{color:currentColor;font-size:.75rem}.domain-link{position:relative;z-index:1;display:inline-flex;gap:6px;align-items:center;margin-top:auto;padding-top:14px;border-top:1px solid rgba(16,36,31,.09);color:currentColor;font:700 .68rem/1 system-ui,sans-serif}.roadmap-section{display:grid;grid-template-columns:.7fr 1.3fr;gap:50px;margin:75px 0 25px;padding-top:10px}.section-kicker{color:var(--accent);font:700 .68rem/1 system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase}.section-heading h2{margin:10px 0 13px;color:var(--ink);font:500 2.25rem/1.03 Georgia,serif;letter-spacing:-.045em}.section-heading h2 em{color:var(--accent);font-style:normal}.section-heading p{max-width:330px;color:var(--muted);font:.82rem/1.55 system-ui,sans-serif}.roadmap-list{border-top:1px solid rgba(16,36,31,.1)}.roadmap-item{display:grid;grid-template-columns:40px 1fr auto;align-items:center;gap:14px;padding:16px 0;border-bottom:1px solid rgba(16,36,31,.1)}.roadmap-index{color:var(--muted);font:700 .68rem/1 system-ui,sans-serif}.roadmap-item strong{color:var(--ink);font:600 .84rem/1.2 system-ui,sans-serif}.roadmap-item p{margin:5px 0 0;color:var(--muted);font:.72rem/1.35 system-ui,sans-serif}.roadmap-state{padding:6px 9px;border-radius:999px;font:600 .62rem/1 system-ui,sans-serif;color:var(--muted);background:#eef2ee}.roadmap-item.live .roadmap-state{color:#23734f;background:#e3f4e7}.roadmap-item.preview .roadmap-state{color:#8b6118;background:#fff0d7}.roadmap-item.adapter .roadmap-state{color:#5c628d;background:#ececff}.cap-cta{display:flex;justify-content:space-between;align-items:center;gap:25px;margin-top:70px;padding:28px 31px;color:#fff;border-radius:18px;background:var(--night)}.cap-cta h2{margin:8px 0 7px;font:500 1.85rem/1.05 Georgia,serif;letter-spacing:-.04em}.cap-cta p{max-width:560px;margin:0;color:#b8d4bf;font:.78rem/1.45 system-ui,sans-serif}.cap-cta .section-kicker{color:#c9f584}.cta-actions{display:flex;align-items:center;gap:18px}@media(max-width:840px){.cap-hero,.roadmap-section{grid-template-columns:1fr}.hero-panel{justify-content:flex-start}.domain-grid{grid-template-columns:1fr}.roadmap-section{gap:25px}.truth-note{grid-template-columns:1fr}.truth-note a{justify-self:start}}@media(max-width:560px){.cap-shell{padding:20px 15px 55px}.cap-hero{padding:28px 22px;border-radius:21px}.cap-hero h1{font-size:2.65rem}.hero-panel{margin-top:15px}.domain-card ul{grid-template-columns:1fr}.cap-cta{align-items:flex-start;flex-direction:column;padding:24px 20px}.cap-cta h2{font-size:1.6rem}.cta-actions{align-items:flex-start;flex-direction:column;gap:14px}}
</style>
