---
import Layout from '../layouts/Layout.astro';

const domains = [
  {
    key: 'governance',
    number: '01',
    label: 'Styring og juss',
    title: 'Styre, eierskap og avtaler',
    intro: 'Fra innkalling og quorum til signering, fullmakter og aksjeeierbok.',
    color: 'mint',
    features: ['Agenda og digital innkalling', 'Quorum, avstemning og protokoll', 'PAdES-LTV signeringsspor', 'Cap table, ESOP og prokura'],
    links: ['/board', '/board/board-1/resolutions'],
  },
  {
    key: 'people',
    number: '02',
    label: 'Mennesker',
    title: 'HCM, talent og kultur',
    intro: 'Ansettelser, OKR, håndbok og obligatorisk opplæring i samme kontekst.',
    color: 'rose',
    features: ['ATS og kandidatpipeline', 'OKR og medarbeidersamtaler', 'Personhåndbok med lesespor', 'HMS/GDPR/AML-kurs og sertifisering'],
    links: ['/onboarding'],
  },
  {
    key: 'operations',
    number: '03',
    label: 'Operasjon',
    title: 'IT, eiendeler og felt',
    intro: 'Hjelpdesk, maskinvare, SaaS-forbruk, kjørebok og FDV samlet.',
    color: 'blue',
    features: ['ITSM-saker med SLA', 'Asset/MDM og zero-touch offboarding', 'GPS-kjørebok og flåtevedlikehold', 'FDV, arbeidsordre og CAPEX/OPEX'],
    links: ['/workspace#capability-map'],
  },
  {
    key: 'finance',
    number: '04',
    label: 'Finans',
    title: 'Regnskap, lønn og betaling',
    intro: 'Norske innsendelser, bankflyt og lønn med sporbar kontroll.',
    color: 'gold',
    features: ['SAF-T og terminlåsing', 'EHF/PEPPOL og 3-veis matching', 'A-melding, skattekort og OTP', 'Bank, likviditet og avstemming'],
    links: ['/internkontroll', '/compliance'],
  },
  {
    key: 'commercial',
    number: '05',
    label: 'Kommersielt',
    title: 'CRM, tilbud og leveranser',
    intro: 'Kundeinnsikt, CPQ, salgsrom og service desk fra første kontakt til fornyelse.',
    color: 'orange',
    features: ['Brønnøysund-oppslag og kredittsjekk', 'Digitalt salgsrom og mutual action plan', 'CPQ og eID-signering', 'IFRS 15 og SLA-service'],
    links: ['/workspace#capability-map'],
  },
  {
    key: 'platform',
    number: '06',
    label: 'Plattform',
    title: 'Hendelser, søk og agenter',
    intro: 'Et sikkert lag for integrasjoner og AI, alltid med mennesket i kontroll.',
    color: 'violet',
    features: ['Event mesh og webhook-ruting', 'Semantisk søk på tvers av kilder', 'MCP-endepunkt med tilgangspolicy', 'HITL-agenter: forslag, godkjenning, logg'],
    links: ['/workspace#ai'],
  },
];

const roadmap = [
  { label: 'Grunnmur', detail: 'Styre, risiko, kontroll og aktivitet', value: 'Levert preview', state: 'done' },
  { label: 'Arbeidsområder', detail: 'Mennesker, IT, finans og kommersielt', value: 'Produktkart', state: 'now' },
  { label: 'Koblede tjenester', detail: 'Altinn, bank, EHF, eID og betalingspartnere', value: 'Krever avtaler', state: 'later' },
  { label: 'Produksjonsplattform', detail: 'Auth, D1, event mesh, AI og tenant-isolasjon', value: 'Krever backend', state: 'later' },
];
---

<Layout title="Produktkart" activeNav="capabilities">
  <main class="cap-shell">
    <section class="cap-hero">
      <div class="hero-copy">
        <span class="eyebrow"><i></i> Styr.ing · PRD 8.0</span>
        <h1>Hele virksomheten.<br /><em>Én tydelig modell.</em></h1>
        <p>Produktkartet gjør den samlede retningen søkbar: fra styrevedtak og personell til bank, CRM, flåte og agentisk AI.</p>
      </div>
      <div class="hero-signal" aria-label="Produktstatus">
        <div class="signal-orb"><span>06</span><small>domener</small></div>
        <div class="signal-copy"><strong>Én sikker arbeidsflate</strong><span>Felles kontekst · tydelig ansvar · sporbar handling</span></div>
      </div>
    </section>

    <section class="search-panel" aria-label="Søk i produktkartet">
      <div class="search-label"><span class="search-icon">⌕</span><label for="cap-search">Søk i mulighetene</label><kbd>⌘ K</kbd></div>
      <input id="cap-search" type="search" placeholder="Prøv «EHF», «OKR», «MCP» eller «quorum» …" autocomplete="off" />
      <p id="search-result" class="search-result" aria-live="polite">Viser alle 26 illustrerte capabilities</p>
    </section>

    <div class="filter-row" role="toolbar" aria-label="Filtrer produktområder">
      <button class="filter active" data-filter="all">Alle</button>
      {domains.map(domain => <button class={`filter filter-${domain.color}`} data-filter={domain.key}>{domain.label}</button>)}
    </div>

    <section class="domain-grid" aria-label="Produktområder">
      {domains.map(domain => <article class={`domain-card ${domain.color}`} data-domain={domain.key}>
        <div class="domain-head"><span class="domain-number">{domain.number}</span><span class="domain-label">{domain.label}</span><span class="domain-dot"></span></div>
        <h2>{domain.title}</h2><p class="domain-intro">{domain.intro}</p>
        <ul>{domain.features.map(feature => <li data-feature={feature.toLowerCase()}><span>↗</span>{feature}</li>)}</ul>
        <div class="domain-foot"><span>Illustrert capability</span><a href={domain.links[0]}>Åpne relevant flate <span>→</span></a></div>
      </article>)}
    </section>

    <section class="roadmap-section">
      <div class="section-heading"><span class="section-kicker">Leveransestatus</span><h2>Fra preview til produksjon</h2><p>Dette er den ærlige avstanden mellom det du kan se nå og det som krever kontoer, databehandling og leverandøravtaler.</p></div>
      <div class="roadmap-list">{roadmap.map((item, index) => <div class={`roadmap-item ${item.state}`}><span class="roadmap-index">0{index + 1}</span><div><strong>{item.label}</strong><p>{item.detail}</p></div><span class="roadmap-state">{item.value}</span></div>)}</div>
    </section>

    <section class="cap-cta"><div><span class="section-kicker">Neste steg</span><h2>Start med beslutningssporet.</h2><p>Utforsk en konkret arbeidsflate med fiktive data, og bruk produktkartet som grunnlag for neste pilot.</p></div><div class="cta-actions"><a href="/workspace" class="button">Åpne arbeidsflaten <span>↗</span></a><a href="/trust" class="cta-trust">Se tillitsmodellen <span>→</span></a></div></section>
  </main>
</Layout>

<script is:inline>
  const search = document.querySelector('#cap-search');
  const result = document.querySelector('#search-result');
  const filters = [...document.querySelectorAll('.filter')];
  const cards = [...document.querySelectorAll('.domain-card')];
  const items = [...document.querySelectorAll('[data-feature]')];
  function apply() {
    const query = (search?.value || '').trim().toLowerCase();
    const active = document.querySelector('.filter.active')?.dataset.filter || 'all';
    let matches = 0;
    cards.forEach(card => {
      const domainMatch = active === 'all' || card.dataset.domain === active;
      const textMatch = !query || card.textContent.toLowerCase().includes(query);
      card.hidden = !(domainMatch && textMatch);
      if (!card.hidden) matches += card.querySelectorAll('[data-feature]').length;
    });
    if (result) result.textContent = query ? `${matches} treff i produktkartet` : `Viser ${matches} illustrerte capabilities`;
  }
  filters.forEach(button => button.addEventListener('click', () => { filters.forEach(item => item.classList.remove('active')); button.classList.add('active'); apply(); }));
  search?.addEventListener('input', apply);
  document.addEventListener('keydown', event => { if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); search?.focus(); } });
  apply();
</script>

<style>
  .cap-shell { max-width:1180px; margin:0 auto; padding:38px 24px 80px; }
  .cap-hero { display:grid; grid-template-columns:1fr .8fr; gap:30px; align-items:center; padding:44px 42px; border-radius:27px; color:#fff; background:linear-gradient(120deg,#102e27,#1d5744 68%,#2d6a52); box-shadow:0 22px 60px rgba(16,36,31,.14); overflow:hidden; position:relative; }.cap-hero::after { content:''; position:absolute; width:430px; height:430px; right:-160px; top:-150px; border-radius:50%; background:radial-gradient(circle,rgba(203,247,125,.2),transparent 65%); }
  .eyebrow { display:flex; gap:8px; align-items:center; color:#d4f4ae; font:700 .7rem/1 system-ui,sans-serif; letter-spacing:.14em; text-transform:uppercase; }.eyebrow i { width:7px; height:7px; border-radius:50%; background:#c8f77e; box-shadow:0 0 0 4px rgba(200,247,126,.18); }.cap-hero h1 { font:500 clamp(2.45rem,5vw,4.2rem)/.98 Georgia,serif; letter-spacing:-.055em; margin:20px 0 18px; }.cap-hero h1 em { color:#cef78a; font-style:normal; }.cap-hero p { max-width:570px; margin:0; color:rgba(255,255,255,.72); font:1rem/1.65 system-ui,sans-serif; }.hero-signal { position:relative; z-index:1; display:flex; gap:18px; align-items:center; justify-content:center; }.signal-orb { width:142px; height:142px; display:flex; flex-direction:column; align-items:center; justify-content:center; border:1px solid rgba(214,251,168,.5); border-radius:50%; background:rgba(7,39,30,.65); box-shadow:0 0 0 15px rgba(212,250,162,.05),0 0 50px rgba(199,248,121,.16); }.signal-orb span { color:#e0fbaa; font:500 3.6rem/.9 Georgia,serif; }.signal-orb small { color:#b4d6bb; font:700 .58rem/1 system-ui,sans-serif; letter-spacing:.1em; text-transform:uppercase; margin-top:9px; }.signal-copy { display:flex; flex-direction:column; gap:7px; max-width:150px; }.signal-copy strong { font:600 .9rem/1.2 system-ui,sans-serif; }.signal-copy span { color:#b7d6be; font: .72rem/1.45 system-ui,sans-serif; }
  .search-panel { margin:26px 0 14px; padding:15px 18px 13px; background:#fff; border:1px solid rgba(16,36,31,.1); border-radius:15px; box-shadow:0 12px 24px rgba(16,36,31,.04); }.search-label { display:flex; align-items:center; gap:8px; color:var(--muted); font:700 .67rem/1 system-ui,sans-serif; letter-spacing:.09em; text-transform:uppercase; }.search-icon { color:var(--accent); font-size:1.3rem; line-height:0; }.search-label kbd { margin-left:auto; padding:4px 6px; border:1px solid rgba(16,36,31,.12); border-radius:5px; font:600 .62rem/1 system-ui,sans-serif; }.search-panel input { width:100%; border:0; outline:0; color:var(--ink); background:transparent; padding:12px 0 5px; font:1rem/1.4 system-ui,sans-serif; }.search-panel input::placeholder { color:#9aa9a0; }.search-result { margin:3px 0 0; color:var(--muted); font: .7rem/1.3 system-ui,sans-serif; }
  .filter-row { display:flex; flex-wrap:wrap; gap:7px; margin:14px 0 23px; }.filter { cursor:pointer; border:1px solid rgba(16,36,31,.12); background:#fff; color:var(--muted); padding:8px 12px; border-radius:999px; font:600 .68rem/1 system-ui,sans-serif; }.filter.active,.filter:hover { background:var(--night); border-color:var(--night); color:#fff; }.filter-mint:hover { background:#1f6f5b; border-color:#1f6f5b; }.filter-rose:hover { background:#ad607c; border-color:#ad607c; }.filter-blue:hover { background:#3974a1; border-color:#3974a1; }.filter-gold:hover { background:#b38329; border-color:#b38329; }.filter-orange:hover { background:#b66f32; border-color:#b66f32; }.filter-violet:hover { background:#726bb3; border-color:#726bb3; }
  .domain-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:14px; }.domain-card { min-height:310px; display:flex; flex-direction:column; padding:23px; border:1px solid rgba(16,36,31,.1); border-radius:17px; background:#fff; position:relative; overflow:hidden; }.domain-card::after { content:''; position:absolute; right:-55px; bottom:-70px; width:180px; height:180px; border-radius:50%; background:currentColor; opacity:.05; }.domain-card[hidden] { display:none; }.domain-card.mint { color:#1f6f5b; }.domain-card.rose { color:#ad607c; }.domain-card.blue { color:#3974a1; }.domain-card.gold { color:#b38329; }.domain-card.orange { color:#b66f32; }.domain-card.violet { color:#726bb3; }.domain-head { display:flex; align-items:center; gap:10px; }.domain-number { color:var(--muted); font:700 .65rem/1 system-ui,sans-serif; letter-spacing:.1em; }.domain-label { font:700 .65rem/1 system-ui,sans-serif; letter-spacing:.1em; text-transform:uppercase; }.domain-dot { width:7px; height:7px; border-radius:50%; margin-left:auto; background:currentColor; }.domain-card h2 { margin:20px 0 8px; color:var(--ink); font:500 1.55rem/1.05 Georgia,serif; letter-spacing:-.035em; }.domain-intro { min-height:42px; max-width:430px; margin:0; color:var(--muted); font: .8rem/1.5 system-ui,sans-serif; }.domain-card ul { display:grid; grid-template-columns:1fr 1fr; gap:8px 18px; list-style:none; padding:0; margin:22px 0; }.domain-card li { display:flex; gap:7px; align-items:baseline; color:var(--ink); font: .75rem/1.35 system-ui,sans-serif; }.domain-card li span { color:currentColor; font-size:.75rem; }.domain-foot { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-top:auto; padding-top:14px; border-top:1px solid rgba(16,36,31,.09); color:var(--muted); font: .66rem/1.25 system-ui,sans-serif; }.domain-foot a { position:relative; z-index:1; color:currentColor; font-weight:700; }.domain-foot a span { margin-left:6px; }
  .roadmap-section { display:grid; grid-template-columns:.7fr 1.3fr; gap:50px; margin:75px 0 25px; padding-top:10px; }.section-kicker { color:var(--accent); font:700 .68rem/1 system-ui,sans-serif; letter-spacing:.14em; text-transform:uppercase; }.section-heading h2 { margin:10px 0 13px; color:var(--ink); font:500 2.25rem/1.03 Georgia,serif; letter-spacing:-.045em; }.section-heading p { max-width:330px; color:var(--muted); font: .82rem/1.55 system-ui,sans-serif; }.roadmap-list { border-top:1px solid rgba(16,36,31,.1); }.roadmap-item { display:grid; grid-template-columns:40px 1fr auto; align-items:center; gap:14px; padding:16px 0; border-bottom:1px solid rgba(16,36,31,.1); }.roadmap-index { color:var(--muted); font:700 .68rem/1 system-ui,sans-serif; }.roadmap-item strong { color:var(--ink); font:600 .84rem/1.2 system-ui,sans-serif; }.roadmap-item p { margin:5px 0 0; color:var(--muted); font: .72rem/1.35 system-ui,sans-serif; }.roadmap-state { padding:6px 9px; border-radius:999px; font:600 .62rem/1 system-ui,sans-serif; color:var(--muted); background:#eef2ee; }.roadmap-item.done .roadmap-state { color:#23734f; background:#e3f4e7; }.roadmap-item.now .roadmap-state { color:#8b6118; background:#fff0d7; }.cap-cta { display:flex; justify-content:space-between; align-items:center; gap:25px; margin-top:70px; padding:28px 31px; color:#fff; border-radius:18px; background:var(--night); }.cap-cta h2 { margin:8px 0 7px; font:500 1.85rem/1.05 Georgia,serif; letter-spacing:-.04em; }.cap-cta p { max-width:560px; margin:0; color:#b8d4bf; font: .78rem/1.45 system-ui,sans-serif; }.cap-cta .section-kicker { color:#c9f584; }.button { position:relative; z-index:1; display:inline-flex; align-items:center; gap:15px; padding:12px 16px; border-radius:10px; color:#16352b; background:#d5fb98; white-space:nowrap; font:700 .78rem/1 system-ui,sans-serif; }.button:hover { color:#16352b; background:#e6ffbd; }.cta-actions { display:flex; align-items:center; gap:18px; }.cta-trust { color:#d6f5b0; font:700 .72rem/1 system-ui,sans-serif; white-space:nowrap; }.cta-trust span { margin-left:7px; }
  @media (max-width:840px) { .cap-hero,.roadmap-section { grid-template-columns:1fr; }.hero-signal { justify-content:flex-start; }.domain-grid { grid-template-columns:1fr; }.roadmap-section { gap:25px; } }
  @media (max-width:560px) { .cap-shell { padding:20px 15px 55px; }.cap-hero { padding:28px 22px; border-radius:21px; }.cap-hero h1 { font-size:2.65rem; }.hero-signal { margin-top:15px; }.domain-card ul { grid-template-columns:1fr; }.cap-cta { align-items:flex-start; flex-direction:column; padding:24px 20px; }.cap-cta h2 { font-size:1.6rem; }.cta-actions { align-items:flex-start; flex-direction:column; gap:14px; } }
</style>
