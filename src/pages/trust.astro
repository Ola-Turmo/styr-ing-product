---
import Layout from '../layouts/Layout.astro';

const areas = [
  { key: 'security', label: 'Sikkerhet', title: 'Sikkerhet som er synlig i arbeidsflyten', intro: 'PRD-en beskriver tiered isolation, ReBAC + ABAC, envelope-KMS og EØS-residens. Her er det oversatt til valg en sluttbruker kan forstå.', accent: 'mint', rows: [['Tilgang', 'Rolle + relasjon + kontekst', 'ReBAC / ABAC'], ['Datasoner', 'Styre og hovedbok separert fra CRM', 'Hybrid isolasjon'], ['Kryptering', 'Kundestyrt nøkkel for sensitive spor', 'Envelope KMS'], ['Region', 'EØS-hosting som standardvalg', 'eu-north-1 / norwayeast']] },
  { key: 'ai', label: 'AI-vakt', title: 'Agenten stopper før den handler', intro: 'AI-forslag skal ha kilde, eier og godkjenning. Ingen automatisk utsending, betaling eller sletting skjer i denne previewen.', accent: 'violet', rows: [['SolvencyShield', 'Utkast til likviditets- og egenkapitalvarsel', 'Krever styregodkjenning'], ['ConflictRadar', 'Markerer mulig habilitetskonflikt', 'Krever juridisk vurdering'], ['SmartGate', 'Forbereder betalingsfil med dual custody', 'Krever BankID/SCA'], ['SalesAI', 'Foreslår neste salgssteg med kilde', 'Krever menneskelig send']] },
  { key: 'integrations', label: 'Integrasjoner', title: 'Koble på når avtalen er klar', intro: 'Leverandører, regulatoriske innsendelser og eID er kartlagt, men aktivering krever konto, kontrakt, databehandleravtale og nøkler.', accent: 'blue', rows: [['Altinn / NAV', 'A-melding, skattekort og inntektsmelding', 'Ikke aktivert'], ['Bank / betaling', 'SCA, bankflyt og avstemming', 'Ikke aktivert'], ['EHF / PEPPOL', 'Fakturainngang og utsending', 'Ikke aktivert'], ['eID / Brønnøysund', 'BankID, signering og registeroppslag', 'Ikke aktivert']] },
];

const checklist = [
  ['01', 'Velg tenant-modell', 'Silo for enterprise eller hybrid for SMB'],
  ['02', 'Definer tilgangsrelasjoner', 'Board-medlem, eier, attestant og leser'],
  ['03', 'Godkjenn datasoner', 'Styredokumenter, HR, finans og CRM'],
  ['04', 'Signer leverandøravtaler', 'DPA, underleverandører og transfergrunnlag'],
  ['05', 'Aktiver agent-policy', 'HITL, audit-logg og stoppregler'],
];
---

<Layout title="Sikkerhet og tillit" activeNav="trust">
  <main class="trust-shell">
    <section class="trust-hero"><div><span class="eyebrow"><i></i> Styr.ing · tillitssenter</span><h1>Se hva som skjer<br /><em>før det skjer.</em></h1><p>Et godt virksomhetssystem gjør tilgang, integrasjoner og AI-vurderinger lesbare for menneskene som har ansvaret.</p></div><div class="trust-score"><span>Preview-status</span><strong>Transparent</strong><small>Illustrasjonsdata · ingen reelle koblinger</small><div class="score-line"><i></i></div></div></section>

    <nav class="trust-tabs" aria-label="Tillitssenter"><div class="trust-tab-list">{areas.map((area, index) => <button class={`trust-tab ${index === 0 ? 'active' : ''}`} data-tab={area.key}>{area.label}<span>0{index + 1}</span></button>)}</div></nav>

    <section class="trust-views">{areas.map((area, index) => <div class={`trust-view ${index === 0 ? 'active' : ''}`} data-view={area.key}><div class="trust-intro"><span class={`trust-kicker ${area.accent}`}>{area.label}</span><h2>{area.title}</h2><p>{area.intro}</p></div><div class="trust-table">{area.rows.map(row => <div class="trust-row"><div><strong>{row[0]}</strong><span>{row[1]}</span></div><b>{row[2]}</b></div>)}</div></div>)}</section>

    <section class="guardrail-section"><div class="guardrail-copy"><span class="section-kicker">Produksjonsklar rekkefølge</span><h2>Tillit bygges<br /><em>steg for steg.</em></h2><p>Dette er sjekklisten som må være ferdig før illustrerte workflows kan få ekte data eller sende noe på vegne av kunden.</p></div><div class="guardrail-list">{checklist.map(item => <div class="guardrail-item"><span>{item[0]}</span><div><strong>{item[1]}</strong><p>{item[2]}</p></div><i>○</i></div>)}</div></section>

    <section class="trust-note"><span class="note-mark">!</span><div><strong>Viktig avgrensning</strong><p>Denne offentlige flaten er en SaaS-preview. Den dokumenterer produktretning og kontrollpunkter, men er ikke bevis på sertifisering, juridisk rådgivning eller aktiv databehandling.</p></div><a href="/vilkar">Les vilkårene ↗</a></section>
  </main>
</Layout>

<script is:inline>
  const tabs = [...document.querySelectorAll('.trust-tab')];
  const views = [...document.querySelectorAll('.trust-view')];
  tabs.forEach(tab => tab.addEventListener('click', () => { tabs.forEach(item => item.classList.remove('active')); views.forEach(view => view.classList.remove('active')); tab.classList.add('active'); document.querySelector(`[data-view="${tab.dataset.tab}"]`)?.classList.add('active'); }));
</script>

<style>
  .trust-shell { max-width:1180px; margin:0 auto; padding:38px 24px 80px; }.trust-hero { display:grid; grid-template-columns:1fr .55fr; gap:32px; align-items:center; padding:43px 42px; border-radius:27px; color:#fff; background:linear-gradient(120deg,#132f28,#1f5543); box-shadow:0 22px 60px rgba(16,36,31,.14); }.eyebrow { display:flex; gap:8px; align-items:center; color:#d5f5af; font:700 .7rem/1 system-ui,sans-serif; letter-spacing:.14em; text-transform:uppercase; }.eyebrow i { width:7px; height:7px; border-radius:50%; background:#c6f477; box-shadow:0 0 0 4px rgba(198,244,119,.16); }.trust-hero h1 { margin:19px 0 17px; font:500 clamp(2.5rem,5vw,4.25rem)/.97 Georgia,serif; letter-spacing:-.055em; }.trust-hero h1 em { color:#d1f78b; font-style:normal; }.trust-hero p { max-width:560px; margin:0; color:rgba(255,255,255,.72); font:1rem/1.6 system-ui,sans-serif; }.trust-score { padding:22px; border:1px solid rgba(213,250,168,.36); border-radius:16px; background:rgba(7,40,30,.48); }.trust-score > span { display:block; color:#b7d6ba; font:700 .64rem/1 system-ui,sans-serif; letter-spacing:.11em; text-transform:uppercase; }.trust-score strong { display:block; margin:15px 0 6px; color:#e0fbaa; font:500 2.3rem/1 Georgia,serif; }.trust-score small { color:#c0dfc2; font: .72rem/1.4 system-ui,sans-serif; }.score-line { height:5px; margin-top:21px; overflow:hidden; border-radius:999px; background:rgba(255,255,255,.14); }.score-line i { display:block; width:88%; height:100%; border-radius:inherit; background:#d2f98c; }.trust-tabs { margin:23px 0 10px; border-bottom:1px solid rgba(16,36,31,.1); }.trust-tab-list { display:flex; gap:4px; }.trust-tab { display:flex; align-items:center; gap:10px; padding:13px 17px; border:0; border-bottom:2px solid transparent; background:transparent; color:var(--muted); cursor:pointer; font:700 .74rem/1 system-ui,sans-serif; }.trust-tab span { color:#a1afa6; font:700 .6rem/1 system-ui,sans-serif; }.trust-tab.active { color:var(--ink); border-bottom-color:var(--accent); }.trust-tab.active span { color:var(--accent); }.trust-views { min-height:335px; }.trust-view { display:none; grid-template-columns:.7fr 1.3fr; gap:45px; padding:35px 0 15px; }.trust-view.active { display:grid; }.trust-intro h2 { margin:17px 0 10px; color:var(--ink); font:500 2.25rem/1.04 Georgia,serif; letter-spacing:-.045em; }.trust-intro p { max-width:320px; margin:0; color:var(--muted); font: .82rem/1.55 system-ui,sans-serif; }.trust-kicker { display:inline-block; padding:6px 8px; border-radius:999px; font:700 .62rem/1 system-ui,sans-serif; letter-spacing:.08em; text-transform:uppercase; }.trust-kicker.mint { color:#1f6f5b; background:#e8f4e9; }.trust-kicker.violet { color:#726bb3; background:#efedfb; }.trust-kicker.blue { color:#3974a1; background:#eaf3fa; }.trust-table { border-top:1px solid rgba(16,36,31,.1); }.trust-row { display:grid; grid-template-columns:1fr auto; align-items:center; gap:18px; padding:17px 5px; border-bottom:1px solid rgba(16,36,31,.09); }.trust-row div { display:flex; flex-direction:column; gap:5px; }.trust-row strong { color:var(--ink); font:600 .82rem/1.2 system-ui,sans-serif; }.trust-row span { color:var(--muted); font: .72rem/1.3 system-ui,sans-serif; }.trust-row b { padding:6px 9px; border-radius:999px; color:#267152; background:#e5f4e8; font:600 .62rem/1 system-ui,sans-serif; white-space:nowrap; }.guardrail-section { display:grid; grid-template-columns:.7fr 1.3fr; gap:50px; margin:70px 0; padding-top:10px; }.section-kicker { color:var(--accent); font:700 .68rem/1 system-ui,sans-serif; letter-spacing:.14em; text-transform:uppercase; }.guardrail-copy h2 { margin:10px 0 14px; color:var(--ink); font:500 2.3rem/1.02 Georgia,serif; letter-spacing:-.05em; }.guardrail-copy h2 em { color:var(--accent); font-style:normal; }.guardrail-copy p { max-width:330px; color:var(--muted); font: .82rem/1.55 system-ui,sans-serif; }.guardrail-list { border-top:1px solid rgba(16,36,31,.1); }.guardrail-item { display:grid; grid-template-columns:40px 1fr 20px; gap:15px; align-items:center; padding:15px 0; border-bottom:1px solid rgba(16,36,31,.1); }.guardrail-item > span { color:var(--muted); font:700 .65rem/1 system-ui,sans-serif; }.guardrail-item strong { color:var(--ink); font:600 .82rem/1.2 system-ui,sans-serif; }.guardrail-item p { margin:5px 0 0; color:var(--muted); font: .72rem/1.3 system-ui,sans-serif; }.guardrail-item i { color:#d39a38; font-style:normal; font-size:1.1rem; }.trust-note { display:flex; gap:14px; align-items:center; padding:18px 20px; border:1px solid rgba(173,111,24,.22); border-radius:14px; background:#fff8e9; }.note-mark { width:23px; height:23px; display:grid; place-items:center; border-radius:50%; color:#fff; background:#c98b28; font:700 .76rem/1 system-ui,sans-serif; flex-shrink:0; }.trust-note strong { color:#805719; font:700 .76rem/1.2 system-ui,sans-serif; }.trust-note p { margin:4px 0 0; color:#8c7146; font: .7rem/1.4 system-ui,sans-serif; }.trust-note a { margin-left:auto; color:#9b6d20; font:700 .7rem/1 system-ui,sans-serif; white-space:nowrap; }
  @media (max-width:840px) { .trust-hero,.trust-view,.guardrail-section { grid-template-columns:1fr; }.trust-hero { padding:30px 25px; }.trust-score { max-width:400px; }.trust-view { gap:25px; }.guardrail-section { gap:25px; } }
  @media (max-width:560px) { .trust-shell { padding:20px 15px 55px; }.trust-hero { padding:27px 22px; border-radius:21px; }.trust-hero h1 { font-size:2.7rem; }.trust-tab { padding:12px 11px; }.trust-tab-list { overflow:auto; }.trust-row { grid-template-columns:1fr; gap:8px; }.trust-row b { justify-self:start; }.trust-note { align-items:flex-start; flex-wrap:wrap; }.trust-note a { margin-left:37px; } }
</style>
