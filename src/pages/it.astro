---
import Layout from '../layouts/Layout.astro';
---
<Layout title="IT og drift — Styr.ing" activeNav="it">
  <main class="it-shell">
    <section class="it-hero"><div><span class="eyebrow"><i></i>IT · drift og livssyklus</span><h1>Hold verktøy og tilgang <em>under kontroll.</em></h1><p>Se eiendeler, IT-saker, SaaS-fornyelser og tilgangsrevisjoner i samme kø. Offboarding lager forslag — aldri automatiske tilgangsendringer.</p></div><div class="it-orb"><span>Kontrollpunkt</span><strong>HITL</strong><small>menneskelig godkjenning</small></div></section>
    <section class="it-metrics"><div><span>Aktive eiendeler</span><strong id="asset-count">—</strong></div><div><span>Åpne saker</span><strong id="ticket-count">—</strong></div><div><span>Fornyelser snart</span><strong id="renewal-count">—</strong></div><div><span>Tilgang venter</span><strong id="access-count">—</strong></div></section>
    <nav class="it-tabs" aria-label="IT-områder"><button class="it-tab active" data-view="assets">Eiendeler</button><button class="it-tab" data-view="tickets">IT-saker</button><button class="it-tab" data-view="saas">SaaS-forbruk</button><button class="it-tab" data-view="saas_insights">SaaS-signaler</button><button class="it-tab" data-view="access">Tilgangsrevisjon</button><button class="it-tab" data-view="lifecycle">Offboarding-kø</button></nav>
    <section class="it-card"><div class="card-head"><div><span id="it-kicker" class="section-kicker">IT · EIENDELER</span><h2 id="it-title">Eiendeler og eierskap</h2></div><a id="it-api" href="/api/it?boardId=board-1&view=assets">API ↗</a></div><div id="it-list" class="it-list"><p class="muted">Henter arbeidsflate…</p></div></section>
    <section class="it-actions"><div class="it-actions-head"><div><span class="section-kicker">Styrte handlinger</span><h2>Gjør neste steg — med sporbarhet.</h2><p>Alle endringer logges. Tilgang og offboarding blir aldri endret automatisk.</p></div><span class="hitl-badge">HITL · påkrevd</span></div><div class="action-grid"><form data-action-form="create_ticket"><h3>Ny IT-sak</h3><label>Tittel<input name="title" maxlength="200" required placeholder="Hva trenger hjelp?" /></label><label>Beskrivelse<textarea name="description" maxlength="2000" rows="3" placeholder="Kort kontekst og ønsket resultat"></textarea></label><div class="form-row"><label>Type<select name="category"><option value="general">Generelt</option><option value="hardware">Utstyr</option><option value="access">Tilgang</option><option value="software">Programvare</option><option value="facility">Lokaler</option><option value="hr">HR</option></select></label><label>Prioritet<select name="priority"><option value="medium">Normal</option><option value="high">Høy</option><option value="critical">Kritisk</option><option value="low">Lav</option></select></label></div><label>Frist<input type="date" name="dueDate" /></label><button type="submit">Opprett sak</button></form><form data-action-form="review_access"><h3>Tilgangsrevisjon</h3><label>Vurdering<select name="reviewId" id="access-review-id" required><option value="">Henter åpne vurderinger…</option></select></label><div class="form-row"><label>Beslutning<select name="decision"><option value="retain">Behold</option><option value="reduce">Reduser</option><option value="remove">Fjern</option></select></label><label>Begrunnelse<input name="reason" maxlength="240" placeholder="Kort begrunnelse" /></label></div><button type="submit">Registrer vurdering</button></form><form data-action-form="prepare_offboarding"><h3>Forbered offboarding</h3><label>HCM-sak<select name="caseId" id="offboarding-case-id" required><option value="">Henter HCM-saker…</option></select></label><p class="form-note">Oppretter forslag for tilgang, utstyr og lønn. Ingen endring skjer automatisk.</p><button type="submit">Lag kontrollkø</button></form><form data-action-form="approve_lifecycle_task"><h3>Godkjenn offboarding</h3><label>Oppgave<select name="taskId" id="lifecycle-task-id" required><option value="">Henter forslag…</option></select></label><label>Ansvarlig<input name="assignedTo" maxlength="120" placeholder="Navn eller team" /></label><p class="form-note">Godkjenningen er et forslag til neste steg — ingen konto eller enhet endres her.</p><button type="submit">Godkjenn oppgave</button></form></div><p id="it-action-status" class="action-status" role="status" aria-live="polite"></p></section>
    <section class="offboarding-callout"><div><span class="section-kicker">Koblet til HCM</span><h2>Én avslutning.<br /><em>Tre kontroller.</em></h2><p>Et offboarding-forslag kan samle tilgang, eiendeler og lønn i én godkjenningskø. Ingen av de tre endres før en ansvarlig godkjenner hvert steg.</p></div><a href="/people" class="callout-button">Åpne HCM ↗</a></section>
    <section class="saas-register"><div><span class="section-kicker">ITSM · SaaS-register</span><h2>Få kostnaden inn i kontrollsporet.</h2><p>Registrer et abonnement manuelt når det ikke kommer fra kort- eller fakturakilde. Fornyelse, utnyttelse og duplikater blir synlige i samme arbeidsflate.</p></div><form data-action-form="create_saas_subscription"><label>Navn<input name="name" maxlength="160" required placeholder="Designverktøy" /></label><label>Leverandør<input name="vendor" maxlength="120" required placeholder="Leverandør AS" /></label><div class="form-row"><label>Seter<input name="seats" type="number" min="1" required value="1" /></label><label>Månedsbeløp (øre)<input name="monthlyMinor" type="number" min="0" placeholder="79000" /></label></div><div class="form-row"><label>Fornyelse<input name="renewalDate" type="date" /></label><label>Utnyttelse (%)<input name="utilizationPercent" type="number" min="0" max="100" placeholder="80" /></label></div><button type="submit">Registrer abonnement</button></form></section>
  </main>
</Layout>
<script is:inline>
 const esc=(v)=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); const money=(v)=>`${(Number(v||0)/100).toLocaleString('nb-NO')} kr`;
 const labels={assets:['IT · EIENDELER','Eiendeler og eierskap'],tickets:['ITSM · SAKER','Saker og SLA'],saas:['SAAS · FORBRUK','Abonnement og fornyelser'],saas_insights:['SAAS · SIGNALER','Duplikater, utnyttelse og fornyelse'],access:['SIKKERHET · TILGANG','Tilgangsrevisjon'],lifecycle:['HCM → IT · OFFBOARDING','Godkjenningskø']};
 const render=(view,data)=>{document.querySelector('#it-kicker').textContent=labels[view][0];document.querySelector('#it-title').textContent=labels[view][1];document.querySelector('#it-api').href=`/api/it?boardId=board-1&view=${view}`;const r=data.data||[];const fn={assets:x=>`<div class="it-row"><strong>${esc(x.name)}</strong><span>${esc(x.asset_tag)} · ${esc(x.vendor||'')}</span><em>${esc(x.owner_name||'Ingen eier')} · ${esc(x.custody_status||x.status)}</em></div>`,tickets:x=>`<div class="it-row"><strong>${esc(x.title)}</strong><span>${esc(x.category)} · ${esc(x.assignee_name||'Ikke tildelt')}</span><em>${esc(x.priority)} · ${esc(x.status)} · frist ${esc(x.due_date)}</em></div>`,saas:x=>`<div class="it-row"><strong>${esc(x.name)}</strong><span>${esc(x.vendor)} · ${esc(x.seats)} seter · ${money(x.monthly_minor)}/mnd</span><em>${esc(x.utilization_percent)}% brukt · fornyes ${esc(x.renewal_date)} · ${esc(x.status)}</em><span class="row-actions"><button type="button" class="row-action" data-saas-status="${esc(x.id)}" data-status="trial">Prøve</button><button type="button" class="row-action" data-saas-status="${esc(x.id)}" data-status="cancel_pending">Planlegg avslutning</button></span></div>`,saas_insights:x=>`<div class="it-row"><strong>${esc(x.name)} · ${esc(x.vendor)}</strong><span>${money(x.monthly_minor)}/mnd · ${esc(x.utilization_percent)}% utnyttet</span><em>${x.duplicateVendor?'Duplikatleverandør · ':''}${x.lowUtilization?'Lav utnyttelse · ':''}${x.renewalRisk?'Fornyelse snart':''}${!x.duplicateVendor&&!x.lowUtilization&&!x.renewalRisk?'Ingen flagg':' Krever vurdering'}</em></div>`,access:x=>`<div class="it-row"><strong>${esc(x.person_name)} · ${esc(x.system_name)}</strong><span>${esc(x.access_level)} · ${esc(x.reason)}</span><em>${esc(x.decision)}${x.reviewer_name?' · '+esc(x.reviewer_name):''}</em></div>`,lifecycle:x=>`<div class="it-row"><strong>${esc(x.title)}</strong><span>${esc(x.person_name)} · ${esc(x.task_type)}</span><em>${esc(x.status)} · godkjenning ${x.requires_approval?'påkrevd':'ferdig'}</em></div>`};document.querySelector('#it-list').innerHTML=r.length?r.map(fn[view]).join(''):'<p class="muted">Ingen rader i denne visningen.</p>';};
 const load=(view)=>fetch(`/api/it?boardId=board-1&view=${view}`).then(r=>r.json()).then(d=>render(view,d)).catch(()=>document.querySelector('#it-list').innerHTML='<p class="muted">Arbeidsflaten er midlertidig utilgjengelig.</p>');
 const fillActionOptions=async()=>{const [access,lifecycle,hcm]=await Promise.all([fetch('/api/it?boardId=board-1&view=access').then(r=>r.json()),fetch('/api/it?boardId=board-1&view=lifecycle').then(r=>r.json()),fetch('/api/hcm?boardId=board-1&view=offboarding').then(r=>r.json())]);const a=document.querySelector('#access-review-id');const pending=(access.data||[]).filter(x=>x.decision==='pending');a.innerHTML=pending.length?pending.map(x=>`<option value="${esc(x.id)}">${esc(x.person_name)} · ${esc(x.system_name)} · ${esc(x.access_level)}</option>`).join(''):'<option value="">Ingen åpne vurderinger</option>';const l=document.querySelector('#lifecycle-task-id');const proposed=(lifecycle.data||[]).filter(x=>x.status==='proposed');l.innerHTML=proposed.length?proposed.map(x=>`<option value="${esc(x.id)}">${esc(x.title)} · ${esc(x.person_name)}</option>`).join(''):'<option value="">Ingen forslag i køen</option>';const o=document.querySelector('#offboarding-case-id');const cases=(hcm.data||[]).filter(x=>['planned','in_progress'].includes(x.status));o.innerHTML=cases.length?cases.map(x=>`<option value="${esc(x.id)}">${esc(x.person_name)} · siste dag ${esc(x.last_day)}</option>`).join(''):'<option value="">Ingen åpne HCM-saker</option>';};
 const postAction=async(form)=>{const status=document.querySelector('#it-action-status');const payload=form.payload||Object.fromEntries(new FormData(form));payload.boardId='board-1';payload.action=form.dataset.actionForm;status.textContent='Lagrer og logger handling…';try{const res=await fetch('/api/it',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(payload)});const data=await res.json();if(!res.ok)throw new Error(data.error||'Kunne ikke lagre');status.textContent=`✓ ${data.action} er registrert. Status: ${data.status||'ok'}.`;if(form.reset)form.reset();await fillActionOptions();await load(document.querySelector('.it-tab.active')?.dataset.view||'assets')}catch(error){status.textContent=`Kunne ikke lagre: ${error.message}`;}};
 document.querySelectorAll('[data-action-form]').forEach(form=>form.addEventListener('submit',event=>{event.preventDefault();postAction(form)}));
 document.querySelector('#it-list')?.addEventListener('click',async(event)=>{const button=event.target.closest('[data-saas-status]');if(!button)return;const next=button.dataset.status;if(next==='cancel_pending'&&!window.confirm('Planlegge avslutning av dette abonnementet?'))return;await postAction({dataset:{actionForm:'update_saas_subscription'},payload:{subscriptionId:button.dataset.saasStatus,status:next}});});
 fillActionOptions().catch(()=>{});
 fetch('/api/it?boardId=board-1&view=summary').then(r=>r.json()).then(({data})=>{document.querySelector('#asset-count').textContent=data.assets?.count??'—';document.querySelector('#ticket-count').textContent=data.tickets?.count??'—';document.querySelector('#renewal-count').textContent=data.renewals?.count??'—';document.querySelector('#access-count').textContent=data.pendingAccess?.count??'—';}).catch(()=>{});load('assets');document.querySelectorAll('.it-tab').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.it-tab').forEach(x=>x.classList.remove('active'));b.classList.add('active');load(b.dataset.view);}));
</script>
<style>
.row-actions{display:flex;gap:6px;flex-wrap:wrap}.row-action{padding:5px 7px;border:1px solid rgba(32,68,91,.25);border-radius:7px;background:#fff;color:#20445b;cursor:pointer;font:700 .6rem/1 system-ui,sans-serif}.row-action:hover{background:#20445b;color:#fff}
.it-shell{max-width:1180px;margin:0 auto;padding:44px 24px 76px}.it-hero{display:grid;grid-template-columns:1fr 270px;gap:40px;align-items:center;padding:42px;border-radius:26px;background:linear-gradient(120deg,#20445b,#347a8c);color:#fff}.eyebrow,.section-kicker{font:700 .68rem/1 system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase}.eyebrow{color:#c8f2f0}.eyebrow i{display:inline-block;width:7px;height:7px;border-radius:50%;background:#c8f2f0;margin-right:7px}.it-hero h1{font:500 clamp(2.5rem,5vw,4.3rem)/.95 Georgia,serif;letter-spacing:-.05em;margin:18px 0}.it-hero h1 em{color:#b9f0de;font-style:normal}.it-hero p{max-width:570px;color:rgba(255,255,255,.74);font:.92rem/1.65 system-ui,sans-serif}.it-orb{width:195px;height:195px;border-radius:50%;display:flex;flex-direction:column;justify-content:center;align-items:center;background:rgba(12,49,62,.35);border:1px solid rgba(185,240,222,.55);margin:auto}.it-orb span,.it-orb small{font:700 .62rem/1 system-ui,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:#b5dfdc}.it-orb strong{font:500 2.5rem/1 Georgia,serif;color:#e3fff4;margin:12px 0}.it-metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:16px 0 35px}.it-metrics>div{padding:17px;border:1px solid rgba(16,36,31,.09);border-radius:14px;background:#fff}.it-metrics span{display:block;color:var(--muted);font:600 .65rem/1 system-ui,sans-serif;text-transform:uppercase}.it-metrics strong{display:block;margin-top:12px;font:500 1.7rem/1 Georgia,serif}.it-tabs{display:flex;gap:7px;overflow:auto;padding-bottom:14px}.it-tab{white-space:nowrap;padding:9px 12px;border:1px solid rgba(16,36,31,.1);border-radius:999px;background:#fff;color:var(--muted);font:700 .68rem/1 system-ui,sans-serif;cursor:pointer}.it-tab.active,.it-tab:hover{background:var(--night);border-color:var(--night);color:#fff}.it-card{padding:22px;border:1px solid rgba(16,36,31,.09);border-radius:16px;background:#fff}.card-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:16px}.card-head h2{margin:8px 0 0;font:500 1.65rem/1 Georgia,serif}.card-head a{color:var(--accent);font:700 .68rem/1 system-ui,sans-serif}.it-row{display:grid;grid-template-columns:1.1fr 1fr auto;gap:15px;align-items:center;padding:14px 0;border-top:1px solid rgba(16,36,31,.08);font:.77rem/1.3 system-ui,sans-serif}.it-row strong{font-weight:700}.it-row span{color:var(--muted)}.it-row em{color:var(--accent);font:.66rem/1.3 system-ui,sans-serif;font-style:normal;white-space:nowrap}.muted{color:var(--muted);font:.76rem/1.4 system-ui,sans-serif}.offboarding-callout{display:flex;justify-content:space-between;gap:25px;align-items:center;margin-top:52px;padding:30px;border-radius:20px;background:#e2f0f1}.offboarding-callout h2{margin:9px 0 12px;font:500 2rem/1 Georgia,serif}.offboarding-callout h2 em{color:#267786;font-style:normal}.offboarding-callout p{max-width:600px;color:var(--muted);font:.82rem/1.6 system-ui,sans-serif}.callout-button{padding:13px 16px;border-radius:10px;background:#20445b;color:#fff;white-space:nowrap;font:700 .76rem/1 system-ui,sans-serif}.callout-button:hover{color:#fff;background:#347a8c}@media(max-width:760px){.it-hero{grid-template-columns:1fr}.it-orb{width:160px;height:160px;margin:0}.it-metrics{grid-template-columns:repeat(2,1fr)}.offboarding-callout{align-items:flex-start;flex-direction:column}}@media(max-width:500px){.it-shell{padding:24px 15px 55px}.it-hero{padding:28px 22px}.it-metrics{grid-template-columns:1fr}.it-row{grid-template-columns:1fr;gap:5px}.it-row em{white-space:normal}}
.it-actions{margin-top:35px;padding:24px;border:1px solid rgba(16,36,31,.09);border-radius:18px;background:#f5f8f5}.it-actions-head{display:flex;justify-content:space-between;gap:20px;align-items:flex-start}.it-actions-head h2{margin:9px 0 7px;font:500 1.7rem/1 Georgia,serif}.it-actions-head p{margin:0;color:var(--muted);font:.78rem/1.5 system-ui,sans-serif}.hitl-badge{padding:8px 10px;border-radius:999px;background:#dff2d2;color:#27643f;font:700 .62rem/1 system-ui,sans-serif;white-space:nowrap}.action-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:20px}.action-grid form{display:flex;flex-direction:column;gap:10px;padding:16px;border:1px solid rgba(16,36,31,.1);border-radius:13px;background:#fff}.action-grid h3{margin:0 0 3px;font:700 .8rem/1.2 system-ui,sans-serif}.action-grid label{display:flex;flex-direction:column;gap:5px;color:var(--muted);font:600 .64rem/1.2 system-ui,sans-serif}.action-grid input,.action-grid select,.action-grid textarea{width:100%;box-sizing:border-box;padding:9px;border:1px solid rgba(16,36,31,.15);border-radius:8px;background:#fbfdfb;color:var(--night);font:400 .75rem/1.3 system-ui,sans-serif}.action-grid textarea{resize:vertical}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:8px}.action-grid button{margin-top:auto;padding:10px;border:0;border-radius:8px;background:#20445b;color:#fff;cursor:pointer;font:700 .7rem/1 system-ui,sans-serif}.action-grid button:hover{background:#347a8c}.form-note{margin:0;color:var(--muted);font:.68rem/1.4 system-ui,sans-serif}.action-status{min-height:1.2em;margin:14px 0 0;color:#27643f;font:700 .72rem/1.4 system-ui,sans-serif}@media(max-width:900px){.action-grid{grid-template-columns:1fr 1fr}}@media(max-width:600px){.it-actions-head{flex-direction:column}.action-grid{grid-template-columns:1fr}.form-row{grid-template-columns:1fr}}
</style>
<style>
.saas-register{display:grid;grid-template-columns:.8fr 1.2fr;gap:24px;margin-top:35px;padding:24px;border:1px solid rgba(16,36,31,.09);border-radius:18px;background:#eaf3ed}.saas-register h2{margin:9px 0 8px;font:500 1.8rem/1 Georgia,serif}.saas-register p{max-width:540px;color:var(--muted);font:.78rem/1.5 system-ui,sans-serif}.saas-register form{display:flex;flex-direction:column;gap:10px;padding:16px;border:1px solid rgba(16,36,31,.1);border-radius:13px;background:#fff}.saas-register label{display:flex;flex-direction:column;gap:5px;color:var(--muted);font:600 .64rem/1.2 system-ui,sans-serif}.saas-register input{width:100%;box-sizing:border-box;padding:9px;border:1px solid rgba(16,36,31,.15);border-radius:8px;background:#fbfdfb;color:var(--night);font:.75rem/1.3 system-ui,sans-serif}.saas-register button{margin-top:auto;padding:10px;border:0;border-radius:8px;background:#20445b;color:#fff;cursor:pointer;font:700 .7rem/1 system-ui,sans-serif}@media(max-width:900px){.saas-register{grid-template-columns:1fr}}
</style>
