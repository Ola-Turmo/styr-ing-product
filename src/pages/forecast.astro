---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Likviditetsprognose — Styr.ing" activeNav="treasury">
  <main class="f-shell"><section class="f-hero"><div><span class="eyebrow">Styr.ing · treasury</span><h1>Se handlingsrommet<br /><em>før det blir trangt.</em></h1><p>En transparent 12-måneders plan basert på siste likviditetsbilde. Justerbare scenarioer viser konsekvensen av innbetalinger og kostnader — uten å sende betalinger.</p></div><div class="f-orb"><strong id="f-runway">—</strong><span>måneder runway</span><small id="f-asof">Henter kilde…</small></div></section><section class="f-metrics"><article><span>Kontant</span><strong id="f-cash">—</strong><small>fra siste bilde</small></article><article><span>Fordringer</span><strong id="f-receivables">—</strong><small>inkludert åpne krav</small></article><article><span>Planlagt burn</span><strong id="f-burn">—</strong><small>månedlig modellforutsetning</small></article><article class="dark"><span>Ekstern handling</span><strong>STOPP</strong><small>kun planlegging og review</small></article></section><section class="f-card"><div class="f-head"><div><span class="kicker">Scenarier</span><h2>Saldo måned for måned</h2></div><span id="f-status">Henter…</span></div><div id="f-scenarios"></div></section><section class="f-notice"><strong>Dette er et planleggingsverktøy</strong><p>Prognosen bruker manuelle eller godkjente likviditetsbilder og eksplisitte antakelser. Den er ikke en ML-spådom, investeringsråd eller betalingsinstruks. Mennesker må kontrollere grunnlaget før beslutninger.</p><a href="/treasury">Tilbake til treasury-kontroll ↗</a></section></main>
</Layout>
<script is:inline>
const esc=v=>String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));const money=n=>`${new Intl.NumberFormat('nb-NO').format(Number(n||0)/100)} NOK`;fetch('/api/forecast?boardId=board-1').then(r=>r.json()).then(d=>{const c=d.current||{},a=d.assumptions||{};document.getElementById('f-runway').textContent=c.runwayMonths??'—';document.getElementById('f-asof').textContent=`Kilde ${esc(d.asOf||'ikke satt')}`;document.getElementById('f-cash').textContent=money(c.cashMinor);document.getElementById('f-receivables').textContent=money(c.receivablesMinor);document.getElementById('f-burn').textContent=money(a.monthlyBurnMinor);document.getElementById('f-status').textContent=`${(d.scenarios||[]).length} scenarioer · menneskelig review`;document.getElementById('f-scenarios').innerHTML=(d.scenarios||[]).map(s=>`<article><div><strong>${esc(s.label)}</strong><span>${Math.round(s.collectionRate*100)}% innbetaling · kostnadsfaktor ${s.expenseRate}×</span></div><div class="bars">${s.months.map(m=>`<i title="Måned ${m.month}: ${money(m.balanceMinor)}" style="height:${Math.max(6,Math.min(100,Math.round((m.balanceMinor/Math.max(1,c.cashMinor))*100)))}%"></i>`).join('')}</div><small>Måned 12: ${money(s.months[11]?.balanceMinor)}</small></article>`).join('')}).catch(()=>{document.getElementById('f-status').textContent='API utilgjengelig'});
</script>
<style>.f-shell{max-width:1180px;margin:0 auto;padding:38px 24px 80px}.f-hero{display:grid;grid-template-columns:1fr .45fr;align-items:center;gap:24px;padding:44px;border-radius:27px;background:linear-gradient(120deg,#203b38,#3b7467);color:#fff}.eyebrow,.kicker{font:700 .68rem system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:#c9f4de}.f-hero h1{margin:20px 0 16px;font:500 clamp(2.5rem,5vw,4.4rem)/.96 Georgia,serif}.f-hero h1 em{color:#c8f6be;font-style:normal}.f-hero p{max-width:600px;color:#ffffffbf;font:1rem/1.6 system-ui,sans-serif}.f-orb{width:190px;height:190px;display:flex;flex-direction:column;align-items:center;justify-content:center;border:1px solid #c9f4deaa;border-radius:50%;background:#2b574d;color:#fff}.f-orb strong{font:500 3.2rem Georgia,serif;color:#d8ffbf}.f-orb span,.f-orb small{font:.68rem system-ui,sans-serif}.f-orb small{margin-top:9px;color:#bde5d3}.f-metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:16px 0 52px}.f-metrics article{min-height:105px;padding:17px;border:1px solid #10241f14;border-radius:15px;background:#fff;display:flex;flex-direction:column;justify-content:space-between}.f-metrics .dark{background:#10241f;color:#fff}.f-metrics span,.f-metrics small{color:#718078;font:600 .67rem system-ui,sans-serif}.f-metrics strong{font:500 1.5rem Georgia,serif}.f-card{padding:28px;border:1px solid #10241f18;border-radius:20px;background:#fff}.f-head{display:flex;justify-content:space-between;align-items:end}.f-head h2{margin:9px 0 0;font:500 2rem Georgia,serif}.f-head>span{color:#4b9279;font:.7rem system-ui,sans-serif}.f-card article{display:grid;grid-template-columns:180px 1fr auto;gap:16px;align-items:end;padding:20px 4px;border-top:1px solid #10241f12}.f-card article strong{display:block;font:700 .82rem system-ui,sans-serif}.f-card article span{display:block;margin-top:6px;color:#718078;font:.68rem/1.35 system-ui,sans-serif}.bars{height:100px;display:flex;align-items:end;gap:5px}.bars i{flex:1;min-width:8px;border-radius:4px 4px 0 0;background:linear-gradient(#9bd8a2,#418a70);opacity:.86}.f-card article small{color:#4b9279;font:600 .68rem system-ui,sans-serif;white-space:nowrap}.f-notice{margin-top:35px;padding:22px 25px;border-radius:16px;background:#eaf5ef}.f-notice strong{font:700 .78rem system-ui,sans-serif}.f-notice p{margin:8px 0 10px;color:#63736a;font:.78rem/1.5 system-ui,sans-serif}.f-notice a{color:#297b62;font:700 .72rem system-ui,sans-serif}@media(max-width:800px){.f-hero{grid-template-columns:1fr}.f-metrics{grid-template-columns:repeat(2,1fr)}.f-card article{grid-template-columns:1fr}.f-card article small{justify-self:start}}@media(max-width:560px){.f-shell{padding:20px 15px 55px}.f-hero{padding:28px 22px}.f-metrics{grid-template-columns:1fr}.f-card{padding:20px 16px}.f-head{align-items:start;flex-direction:column;gap:10px}}
</style>
