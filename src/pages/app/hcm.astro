---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Mennesker og HCM — Styr.ing" activeNav="workspace">
  <main class="hcm-shell">
    <section id="hcm-loading" class="hcm-state"><span class="section-kicker">Mennesker og HCM</span><h1>Henter people-flaten.</h1><p>Kontrollerer tilgang og laster virksomhetens HR-data.</p></section>
    <section id="hcm-error" class="hcm-state" hidden><span class="section-kicker">Tilgang</span><h1 id="hcm-error-title">Kunne ikke åpne people-flaten.</h1><p id="hcm-error-copy">Prøv å logge inn på nytt.</p><a class="primary" href="/login">Gå til innlogging ↗</a></section>
    <div id="hcm-content" hidden>
      <header class="hcm-header"><div><a id="hcm-back" href="/app">← Kundeområde</a><span class="section-kicker">Mennesker og HCM</span><h1>Ansvar i organisasjonen</h1><p>Kandidater, håndbok, læring, medarbeidersamtaler og offboarding i ett kontrollert spor.</p></div><div class="hcm-identity"><strong id="hcm-board">—</strong><span id="hcm-role">—</span></div></header>
      <nav id="hcm-tabs" class="hcm-tabs" aria-label="People-visninger"></nav>
      <section class="hcm-summary"><article><small>Aktive personer</small><strong id="metric-people">—</strong><span>i virksomheten</span></article><article><small>Åpne kandidater</small><strong id="metric-candidates">—</strong><span>i rekrutteringssporet</span></article><article><small>HR-oppfølging</small><strong id="metric-review">—</strong><span>krever gjennomgang</span></article></section>
      <section class="hcm-card"><div class="card-head"><div><span class="section-kicker" id="hcm-kicker">People</span><h2 id="hcm-title">—</h2></div><span id="hcm-count">—</span></div><p id="hcm-status" class="hcm-status" role="status" hidden></p><div id="hcm-list" class="hcm-list"><p class="empty">Henter data…</p></div></section>
      <p class="boundary">HR-data krever riktig rolle og menneskelig vurdering. Styr.ing foreslår og dokumenterer neste steg, men endrer ikke lønn, identitetstilgang eller arbeidsforhold automatisk.</p>
    </div>
  </main>
</Layout>
<script is:inline>
  const qs = (s) => document.querySelector(s);
  const esc = (v) => String(v ?? '').replace(/[&<>'\"]/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','\"':'&quot;'}[c]));
  const tabs = {summary:['Oversikt','HR-kontroll'],people:['Personer','Roller og status'],candidates:['Kandidater','Rekrutteringsspor'],handbook:['Håndbok','Policy og bekreftelser'],training:['Læring','Kurs og frister'],reviews:['Samtaler','Medarbeideroppfølging'],offboarding:['Offboarding','Trygg avslutning']};
  const params = new URLSearchParams(location.search); let boardId=''; let currentView=params.get('view')||'summary'; let people=[];
  const get = async (view) => { const r=await fetch(`/api/hcm?boardId=${encodeURIComponent(boardId)}&view=${encodeURIComponent(view)}`); const d=await r.json(); if(!r.ok) throw new Error(d.error||'hcm_load_failed'); return d; };
  const status = (message, error=false) => { const el=qs('#hcm-status'); el.hidden=!message; el.textContent=message||''; el.classList.toggle('error',error); };
  const row = (title, meta, state, tone='', actions='') => `<div class="hcm-row"><i class="${tone}"></i><span><strong>${esc(title)}</strong><small>${esc(meta)}</small></span><em>${esc(state||'—')}</em>${actions}</div>`;
  const candidateActions = (item) => canWrite && !['hired','rejected'].includes(item.stage) ? `<span class="row-actions"><button type="button" data-candidate-id="${esc(item.id)}" data-candidate-stage="screening">Til screening</button><button type="button" data-candidate-id="${esc(item.id)}" data-candidate-stage="interview">Intervju</button><button type="button" data-candidate-id="${esc(item.id)}" data-candidate-stage="offer">Tilbud</button><button type="button" data-candidate-id="${esc(item.id)}" data-candidate-stage="rejected">Avslå</button><button type="button" data-scorecard-id="${esc(item.id)}">Scorecard</button></span>` : '';
  const trainingActions = (item) => canWrite && !['passed','waived'].includes(item.status) ? `<span class="row-actions"><button type="button" data-training-id="${esc(item.id)}">Registrer fullført</button></span>` : '';
  const offboardingActions = (item) => canWrite && item.status !== 'complete' ? `<span class="row-actions"><button type="button" data-offboarding-id="${esc(item.id)}" data-offboarding-flag="accessRevoked" data-access-revoked="${item.access_revoked?1:0}" data-assets-returned="${item.assets_returned?1:0}" data-payroll-reviewed="${item.payroll_reviewed?1:0}">Kontroller tilgang</button><button type="button" data-offboarding-id="${esc(item.id)}" data-offboarding-flag="assetsReturned" data-access-revoked="${item.access_revoked?1:0}" data-assets-returned="${item.assets_returned?1:0}" data-payroll-reviewed="${item.payroll_reviewed?1:0}">Registrer retur</button><button type="button" data-offboarding-id="${esc(item.id)}" data-offboarding-flag="payrollReviewed" data-access-revoked="${item.access_revoked?1:0}" data-assets-returned="${item.assets_returned?1:0}" data-payroll-reviewed="${item.payroll_reviewed?1:0}">Kontroller lønn</button></span>` : '';
  const render = async () => {
    const data=await get(currentView); let rows=data.data||[]; const labels=tabs[currentView]||tabs.summary; qs('#hcm-kicker').textContent=labels[0]; qs('#hcm-title').textContent=labels[1]; qs('#hcm-count').textContent=`${rows.length} rader`;
    if(currentView==='summary'){ const s=data.data||{}; qs('#hcm-title').textContent='HR-kontroll'; rows=[['Personer',`${s.people?.count||0} aktive personer`,'Roller og status synlig',''],['Kandidater',`${s.openCandidates?.count||0} åpne kandidater`,'Samtykke og vurdering før neste steg',(s.openCandidates?.count||0)?'warn':''],['Læring',`${s.dueTraining?.count||0} kurs til oppfølging`,'Frister må eies',(s.dueTraining?.count||0)?'warn':''],['Samtaler',`${s.reviews?.count||0} samtaler i sporet`,'Menneskelig vurdering',(s.reviews?.count||0)?'warn':''],['Offboarding',`${s.offboarding?.count||0} saker`,'Ingen automatisk tilgangsfjerning',(s.offboarding?.count||0)?'warn':'']].map(x=>row(x[0],x[1],x[2],x[3]));}
    if(currentView==='people') rows=rows.map(x=>row(x.name,`${x.role||'Rolle ikke satt'} · ${x.department||'avdeling ikke satt'}`,x.employment_status));
    if(currentView==='candidates') { const stages=[['new','Nye'],['screening','Screening'],['interview','Intervju'],['offer','Tilbud'],['hired','Ansatt'],['rejected','Avslått']]; rows=[`<div class="candidate-board">${stages.map(([stage,label])=>{const items=data.data.filter(x=>x.stage===stage);return `<section class="candidate-column"><header><strong>${label}</strong><span>${items.length}</span></header>${items.length?items.map(x=>row(`${x.name} · ${x.requisition_title||'Stilling ikke satt'}`,`${x.email||'e-post ikke satt'} · samtykke ${x.consent_status||'ikke satt'} · ${x.completed_scorecards||0} scorecard`,x.scorecard_score===null||x.scorecard_score===undefined?'Score ikke satt':`Score ${x.scorecard_score}/100`,['interview','offer'].includes(x.stage)?'warn':'',candidateActions(x))).join(''):'<p class="empty">Ingen kandidater</p>'}</section>`}).join('')}</div>`]; }
    if(currentView==='handbook') rows=rows.map(x=>row(`${x.title} · v${x.version||'—'}`,`${x.category||'policy'} · ${x.acknowledgements||0} bekreftelser`,x.status,x.requires_ack?'warn':''));
    if(currentView==='training') rows=rows.map(x=>row(`${x.person_name} · ${x.course_title}`,`Frist ${x.due_date||'ikke satt'} · score ${x.score??'—'}`,x.status,!['passed','waived'].includes(x.status)?'warn':'',trainingActions(x)));
    if(currentView==='reviews') rows=rows.map(x=>row(`${x.person_name} · ${x.period||'periode ikke satt'}`,`Frist ${x.due_date||'ikke satt'} · vurderer ${x.reviewer_name||'ikke satt'}`,x.status,x.status!=='complete'?'warn':''));
    if(currentView==='offboarding') rows=rows.map(x=>row(`${x.person_name} · siste dag ${x.last_day||'ikke satt'}`,`Tilgang ${x.access_revoked?'revurdert':'ikke revurdert'} · eiendeler ${x.assets_returned?'returnert':'åpen'} · lønn ${x.payroll_reviewed?'kontrollert':'åpen'}`,x.status,x.status!=='complete'?'warn':'',offboardingActions(x)));
    qs('#hcm-list').innerHTML=rows.length?rows.join(''):'<p class="empty">Ingen rader i denne visningen.</p>';
    document.querySelectorAll('#hcm-tabs a').forEach(a=>{a.classList.toggle('active',a.dataset.view===currentView)});
    wireActions(); wireScorecards();
  };
  let canWrite=false;
  const wireScorecards = () => document.querySelectorAll('[data-scorecard-id]').forEach(button=>button.addEventListener('click',async()=>{const score=window.prompt('Samlet score (0–100)','70');if(score===null)return;const recommendation=window.prompt('Anbefaling: strong_yes, yes, mixed, no eller strong_no','mixed');if(!recommendation)return;const notes=window.prompt('Kort begrunnelse','')||'';try{await mutate({action:'save_scorecard',candidateId:button.dataset.scorecardId,overallScore:Number(score),recommendation,notes,criteria:{structuredInterview:true}});}catch(e){status('Scorecard ble ikke lagret.',true);}}));
  const mutate = async (payload) => { const response=await fetch('/api/hcm',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({boardId,...payload})}); const data=await response.json(); if(!response.ok) throw new Error(data.error||'hcm_write_failed'); await render(); status('Endringen er lagret og registrert i kontrollsporet.'); };
  const wireActions = () => { document.querySelectorAll('[data-candidate-stage]').forEach(button=>button.addEventListener('click',async()=>{if(button.dataset.candidateStage==='rejected'&&!confirm('Avslå kandidaten? Dette registreres som en menneskelig beslutning.'))return;const score=button.dataset.candidateScore?window.prompt('Score (0–100)', '70'):null;if(button.dataset.candidateScore&&score===null)return;try{await mutate({action:'update_candidate',candidateId:button.dataset.candidateId,stage:button.dataset.candidateStage,score:score===null?undefined:Number(score)});}catch(e){status('Endringen ble ikke lagret.',true);}})); document.querySelectorAll('[data-training-id]').forEach(button=>button.addEventListener('click',async()=>{const score=window.prompt('Resultat (0–100)', '100');if(score===null)return;try{await mutate({action:'complete_training',enrollmentId:button.dataset.trainingId,score:Number(score)});}catch(e){status('Kurset ble ikke oppdatert.',true);}})); document.querySelectorAll('[data-offboarding-flag]').forEach(button=>button.addEventListener('click',async()=>{const payload={action:'advance_offboarding',caseId:button.dataset.offboardingId,accessRevoked:button.dataset.accessRevoked==='1',assetsReturned:button.dataset.assetsReturned==='1',payrollReviewed:button.dataset.payrollReviewed==='1'};payload[button.dataset.offboardingFlag]=true;try{await mutate(payload);}catch(e){status('Offboarding-saken ble ikke oppdatert.',true);}})); };
  const load = async () => { try { const auth=await (await fetch('/api/auth')).json(); if(!auth.authenticated){location.href=`/login?next=${encodeURIComponent(location.pathname+location.search)}`;return;} const selected=(auth.boards||[]).find(x=>x.id===params.get('boardId'))||(auth.boards||[])[0]; if(!selected) throw new Error('no_board'); boardId=selected.id; canWrite=['owner','editor'].includes(selected.role); const board=await (await fetch(`/api/board/${encodeURIComponent(boardId)}`)).json(); const summary=await get('summary'); people=(await get('people')).data||[]; qs('#hcm-loading').hidden=true; qs('#hcm-content').hidden=false; qs('#hcm-board').textContent=board.data?.board?.name||'Virksomhet'; qs('#hcm-role').textContent=selected.role==='owner'?'Eier':selected.role==='editor'?'Redaktør':'Leser'; qs('#hcm-back').href=`/app?boardId=${encodeURIComponent(boardId)}`; qs('#metric-people').textContent=summary.data?.people?.count||people.length; qs('#metric-candidates').textContent=summary.data?.openCandidates?.count||0; qs('#metric-review').textContent=(summary.data?.reviews?.count||0)+(summary.data?.offboarding?.count||0); qs('#hcm-tabs').innerHTML=Object.entries(tabs).map(([key,value])=>`<a data-view="${key}" href="/app/hcm?boardId=${encodeURIComponent(boardId)}&view=${key}">${value[0]}</a>`).join(''); await render(); } catch(e){ qs('#hcm-loading').hidden=true; qs('#hcm-error').hidden=false; qs('#hcm-error-title').textContent=e.message==='no_board'?'Ingen virksomhet er koblet til kontoen.':'People-flaten kunne ikke lastes.'; } };
  load();
</script>
<style>
  .hcm-shell{max-width:1040px;margin:0 auto;padding:42px 24px 88px}.hcm-state{max-width:620px;margin:80px auto;text-align:center}.hcm-state h1{font:500 clamp(2.5rem,6vw,4.5rem)/.95 Georgia,serif;letter-spacing:-.06em;margin:14px 0}.hcm-state p,.boundary,.empty{color:var(--muted);font:.8rem/1.55 system-ui,sans-serif}.primary{display:inline-flex;margin-top:15px;padding:12px 16px;border-radius:9px;background:var(--night);color:#fff;font:700 .74rem/1 system-ui,sans-serif}.hcm-header{display:flex;justify-content:space-between;align-items:end;gap:25px;margin-bottom:24px}.hcm-header>a{display:block;margin-bottom:18px;color:var(--accent);font:700 .68rem/1 system-ui,sans-serif}.hcm-header h1{margin:11px 0 8px;font:500 clamp(2.6rem,6vw,4.6rem)/.94 Georgia,serif;letter-spacing:-.06em}.hcm-header p{margin:0;max-width:620px;color:var(--muted);font:.84rem/1.55 system-ui,sans-serif}.hcm-identity{display:grid;justify-items:end;gap:7px;min-width:180px}.hcm-identity strong{font:700 .78rem/1.2 system-ui,sans-serif}.hcm-identity span{padding:6px 9px;border-radius:999px;background:#e8f1df;color:var(--accent);font:700 .62rem/1 system-ui,sans-serif}.hcm-tabs{display:flex;gap:6px;overflow:auto;padding-bottom:7px;margin-bottom:15px}.hcm-tabs a{white-space:nowrap;padding:9px 12px;border:1px solid rgba(16,36,31,.1);border-radius:9px;background:#fff;color:var(--muted);font:700 .68rem/1 system-ui,sans-serif}.hcm-tabs a.active,.hcm-tabs a:hover{background:var(--night);border-color:var(--night);color:#fff}.hcm-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:11px;margin-bottom:15px}.hcm-summary article,.hcm-card{border:1px solid rgba(16,36,31,.09);border-radius:15px;background:#fff}.hcm-summary article{padding:17px;min-height:105px}.hcm-summary small,.hcm-summary span{display:block;color:var(--muted);font:600 .67rem/1.35 system-ui,sans-serif}.hcm-summary strong{display:block;margin:11px 0 5px;font:500 1.9rem/1 Georgia,serif}.hcm-summary span{color:var(--accent)}.hcm-card{padding:22px}.card-head{display:flex;justify-content:space-between;align-items:start;gap:15px;margin-bottom:13px}.card-head h2{margin:8px 0 0;font:500 1.5rem/1 Georgia,serif}.card-head>span{color:var(--muted);font:700 .66rem/1 system-ui,sans-serif}.hcm-status{margin:0 0 10px;padding:10px 12px;border-radius:8px;background:#edf5e7;color:var(--accent);font:700 .68rem/1.35 system-ui,sans-serif}.hcm-status.error{background:#faece8;color:#8f3e34}.hcm-list{display:grid}.hcm-row{display:flex;align-items:center;gap:11px;padding:13px 2px;border-bottom:1px solid rgba(16,36,31,.07)}.hcm-row:last-child{border-bottom:0}.hcm-row i{width:8px;height:8px;border-radius:50%;background:#76b76f;flex:none}.hcm-row i.warn{background:#d69738}.hcm-row span{display:grid;gap:4px;flex:1}.hcm-row strong{font:700 .78rem/1.25 system-ui,sans-serif}.hcm-row small{color:var(--muted);font:.68rem/1.35 system-ui,sans-serif}.hcm-row em{font:600 .65rem/1 system-ui,sans-serif;font-style:normal;color:var(--muted)}.row-actions{display:flex;gap:5px;flex:none}.row-actions button{padding:7px 8px;border:1px solid rgba(16,36,31,.14);border-radius:7px;background:#fff;color:var(--night);font:700 .6rem/1 system-ui,sans-serif;cursor:pointer}.row-actions button:hover{background:var(--night);color:#fff}.boundary{margin:16px 0 0;padding:15px 3px;border-top:1px solid rgba(16,36,31,.08)}
  .candidate-board{display:grid;grid-template-columns:repeat(6,minmax(190px,1fr));gap:10px;overflow-x:auto}.candidate-column{min-width:190px;padding:12px;border:1px solid rgba(16,36,31,.08);border-radius:11px;background:#f7faf6}.candidate-column>header{display:flex;justify-content:space-between;align-items:center;margin-bottom:7px;color:var(--accent);font:700 .68rem/1 system-ui,sans-serif}.candidate-column>header span{padding:3px 6px;border-radius:999px;background:#e3efdf}.candidate-column .hcm-row{display:grid;grid-template-columns:8px 1fr;gap:8px;align-items:start;margin-bottom:7px;padding:10px 0;border:1px solid rgba(16,36,31,.08);border-radius:8px;background:#fff}.candidate-column .hcm-row>em,.candidate-column .row-actions{grid-column:2}.candidate-column .row-actions{flex-wrap:wrap}.candidate-column .row-actions button{font-size:.56rem;padding:6px 7px}
  @media(max-width:650px){.hcm-shell{padding:28px 16px 60px}.hcm-header{align-items:start;flex-direction:column}.hcm-identity{justify-items:start}.hcm-summary{grid-template-columns:1fr}.hcm-card{padding:17px}.hcm-row{align-items:flex-start;flex-wrap:wrap}.hcm-row em{max-width:110px;text-align:right}}
</style>
