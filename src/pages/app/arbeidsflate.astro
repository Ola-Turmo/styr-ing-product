---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Arbeidsflate — Styr.ing" activeNav="workspace">
  <main class="tenant-shell">
    <div id="tenant-loading" class="tenant-state"><span class="section-kicker">Kundeområde</span><h1>Henter arbeidsflaten.</h1><p>Kontrollerer tilgang og laster virksomhetens data.</p></div>
    <div id="tenant-error" class="tenant-state" hidden><span class="section-kicker">Tilgang</span><h1 id="tenant-error-title">Kunne ikke åpne arbeidsflaten.</h1><p id="tenant-error-copy">Prøv å logge inn på nytt.</p><a href="/login" class="primary">Gå til innlogging ↗</a></div>
    <div id="tenant-content" hidden>
      <header class="tenant-header"><div><a id="back-link" href="/app">← Kundeområde</a><span id="tenant-kicker" class="section-kicker">Arbeidsflate</span><h1 id="tenant-title">—</h1><p id="tenant-copy">—</p></div><div class="tenant-identity"><strong id="tenant-board">—</strong><span id="tenant-role">—</span></div></header>
      <nav class="tenant-tabs" aria-label="Arbeidsområder"><a data-view="board" href="?view=board">Styre</a><a data-view="governance" href="?view=governance">Møte og habilitet</a><a data-view="operations" href="?view=operations">Operativ cockpit</a><a data-view="risk" href="?view=risk">Risiko</a><a data-view="controls" href="?view=controls">Internkontroll</a><a data-view="finance" href="?view=finance">Økonomi</a><a data-view="treasury" href="?view=treasury">Likviditet</a><a data-view="projects" href="?view=projects">Prosjekt</a><a data-view="commercial" href="?view=commercial">Kunder</a><a data-view="people" href="?view=people">Mennesker</a><a data-view="goals" href="?view=goals">Mål</a><a data-view="sustainability" href="?view=sustainability">HMS og ESG</a></nav>
      <section class="tenant-summary"><article><small id="metric-a-label">—</small><strong id="metric-a">—</strong><span id="metric-a-note">—</span></article><article><small id="metric-b-label">—</small><strong id="metric-b">—</strong><span id="metric-b-note">—</span></article><article><small id="metric-c-label">—</small><strong id="metric-c">—</strong><span id="metric-c-note">—</span></article></section>
      <section class="tenant-card"><div class="card-head"><div><span id="list-kicker" class="section-kicker">Oversikt</span><h2 id="list-title">—</h2></div><div class="card-head-tools"><a id="export-link" href="#" hidden>Last ned SAF‑T ↗</a><span id="list-count">—</span></div></div><nav id="finance-tabs" class="finance-tabs" aria-label="Økonomivisninger" hidden><a data-finance-view="vouchers" href="#">Bilag</a><a data-finance-view="periods" href="#">Perioder</a><a data-finance-view="accounts" href="#">Kontoplan</a></nav><nav id="treasury-tabs" class="finance-tabs" aria-label="Likviditetsvisninger" hidden><a data-treasury-view="summary" href="#">Oversikt</a><a data-treasury-view="payroll" href="#">Lønn</a><a data-treasury-view="submissions" href="#">Innsendinger</a><a data-treasury-view="liquidity" href="#">Likviditet</a><a data-treasury-view="collections" href="#">Innkrevingsspor</a></nav><p id="action-status" class="action-status" role="status" hidden></p><div id="tenant-list" class="tenant-list"><p class="empty">Henter rader…</p></div></section>
      <section class="tenant-card"><div class="card-head"><div><span id="list-kicker" class="section-kicker">Oversikt</span><h2 id="list-title">—</h2></div><div class="card-head-tools"><a id="export-link" href="#" hidden>Last ned SAF‑T ↗</a><span id="list-count">—</span></div></div><nav id="finance-tabs" class="finance-tabs" aria-label="Økonomivisninger" hidden><a data-finance-view="vouchers" href="#">Bilag</a><a data-finance-view="periods" href="#">Perioder</a><a data-finance-view="accounts" href="#">Kontoplan</a></nav><nav id="treasury-tabs" class="finance-tabs" aria-label="Likviditetsvisninger" hidden><a data-treasury-view="summary" href="#">Oversikt</a><a data-treasury-view="payroll" href="#">Lønn</a><a data-treasury-view="submissions" href="#">Innsendinger</a><a data-treasury-view="liquidity" href="#">Likviditet</a><a data-treasury-view="collections" href="#">Innkrevingsspor</a></nav><nav id="commercial-tabs" class="finance-tabs" aria-label="Kundevisninger" hidden><a data-commercial-view="summary" href="#">Oversikt</a><a data-commercial-view="pipeline" href="#">Pipeline</a><a data-commercial-view="quotes" href="#">Tilbud</a><a data-commercial-view="rooms" href="#">Salgsrom</a><a data-commercial-view="subscriptions" href="#">Abonnementer</a><a data-commercial-view="cases" href="#">Kundesaker</a></nav><p id="action-status" class="action-status" role="status" hidden></p><div id="tenant-list" class="tenant-list"><p class="empty">Henter rader…</p></div></section>
      <p class="boundary">Dataene i denne arbeidsflaten er avgrenset til virksomheten kontoen har tilgang til. Endringer og eksterne innsendinger krever riktig rolle, kontrollspor og eksplisitt godkjenning.</p>
    </div>
  </main>
</Layout>
<script is:inline>
  const qs = (selector) => document.querySelector(selector);
  const esc = (value) => String(value ?? '').replace(/[&<>'\"]/g, (c) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', "'":'&#39;', '\"':'&quot;' }[c]));
  const labels = {
    board: { kicker:'STYRE · OPPFØLGING', title:'Saker som skal videre', copy:'Se møter, åpne oppgaver og vedtak i samme beslutningsspor.', list:'Åpne oppgaver' },
    governance: { kicker:'STYRE · MØTE OG HABILITET', title:'Møter med tydelig spor', copy:'Følg planlagte møter, fremmøte og avstemninger før beslutningen går videre.', list:'Møteoversikt' },
    operations: { kicker:'OPERATIV COCKPIT · SIGNALER', title:'Det som trenger en eier', copy:'Se tverrgående signaler fra mennesker, IT, økonomi, kunder, felt og plattform.', list:'Styringssignaler' },
    risk: { kicker:'RISIKO · TILTAK', title:'Risiko med tydelig eier', copy:'Prioriter det som krever vurdering og følg frister og behandling.', list:'Risikoregister' },
    controls: { kicker:'INTERNKONTROLL · STATUS', title:'Kontroller du kan følge', copy:'Se kontrollstatus, ansvar og siste gjennomgang uten å miste kilden.', list:'Kontrollpunkter' },
    finance: { kicker:'ØKONOMI · KONTROLLSPOR', title:'Bilag med spor', copy:'Følg referanse, motpart, periode og status før neste beslutning.', list:'Siste bilag' },
    treasury: { kicker:'LIKVIDITET · REVIEW FØR SENDING', title:'Tall som tåler en ekstra gjennomgang', copy:'Se lønn, innsendinger, kontantbilde og innkrevingsspor. Ingenting sendes eksternt uten riktig avtale og menneskelig godkjenning.', list:'Likviditetsoversikt' },
    projects: { kicker:'PROSJEKT · TIMER OG WIP', title:'Se arbeid før det blir faktura', copy:'Følg aktive prosjekter, timer, dekningsbidrag og fakturautkast. EHF-fakturering er ikke aktivert uten leverandøravtale.', list:'Prosjektoversikt' },
    commercial: { kicker:'KUNDER · PIPELINE OG SLA', title:'Kunder med neste steg', copy:'Følg pipeline, tilbud, abonnementer og kundesaker i ett kontrollert spor. Utsending og betaling krever fortsatt riktig godkjenning.', list:'Kundekontroll' },
    people: { kicker:'MENNESKER · ROLLER', title:'Ansvar i organisasjonen', copy:'Se rolle, avdeling og arbeidsstatus i én avgrenset oversikt.', list:'Personer' },
    goals: { kicker:'MÅL · FREMDRIFT', title:'Mål som kan følges opp', copy:'Se hva som er på rett spor, hva som trenger hjelp og hvem som eier fremdriften.', list:'Mål og OKR' },
    sustainability: { kicker:'HMS OG ESG · OPPFØLGING', title:'Ansvar som kan følges', copy:'Se avvik, sikkerhet, karbon og leverandøraktsomhet i samme oppfølgingsspor.', list:'HMS- og ESG-oppfølging' },
  };
  const params = new URLSearchParams(location.search); const view = labels[params.get('view')] ? params.get('view') : 'board'; const financeView=['vouchers','periods','accounts'].includes(params.get('finance'))?params.get('finance'):'vouchers'; const treasuryView=['summary','payroll','submissions','liquidity','collections'].includes(params.get('treasury'))?params.get('treasury'):'summary'; const projectView=['summary','projects','time','wip','invoice_drafts','fleet','maintenance'].includes(params.get('projects'))?params.get('projects'):'summary'; const commercialView=['summary','pipeline','quotes','rooms','subscriptions','cases'].includes(params.get('commercial'))?params.get('commercial'):'summary';
  let activeBoardId = ''; let canWrite = false;
  const money = (value) => `${new Intl.NumberFormat('nb-NO').format(Number(value || 0) / 100)} NOK`;
  const setMetric = (slot, label, value, note) => { qs(`#metric-${slot}-label`).textContent=label; qs(`#metric-${slot}`).textContent=value; qs(`#metric-${slot}-note`).textContent=note; };
  const row = (title, meta, status, tone='', actions='') => `<article class="tenant-row"><i class="${tone}"></i><span><strong>${esc(title)}</strong><small>${esc(meta)}</small></span><em>${esc(status || '—')}</em>${actions}</article>`;
  const controlActions = (control) => canWrite ? `<span class="row-actions" aria-label="Oppdater kontrollstatus"><button type="button" data-control-id="${esc(control.id)}" data-control-status="green">Grønn</button><button type="button" data-control-id="${esc(control.id)}" data-control-status="yellow">Gul</button><button type="button" data-control-id="${esc(control.id)}" data-control-status="red">Rød</button></span>` : '';
  const riskActions = (risk) => canWrite ? `<span class="row-actions" aria-label="Oppdater risikostatus"><button type="button" data-risk-id="${esc(risk.id)}" data-risk-status="treating">Behandle</button><button type="button" data-risk-id="${esc(risk.id)}" data-risk-status="monitoring">Overvåk</button><button type="button" data-risk-id="${esc(risk.id)}" data-risk-status="closed">Lukk</button></span>` : '';
  const actionActions = (item) => canWrite ? `<span class="row-actions" aria-label="Oppdater oppgave"><button type="button" data-action-id="${esc(item.id)}" data-action-status="completed">Marker ferdig</button></span>` : '';
  const goalActions = (goal) => canWrite ? `<span class="row-actions" aria-label="Oppdater målfremdrift"><button type="button" data-goal-id="${esc(goal.id)}" data-goal-status="on_track" data-goal-progress="${Math.max(0, Number(goal.progress || 0))}">På rett spor</button><button type="button" data-goal-id="${esc(goal.id)}" data-goal-status="at_risk" data-goal-progress="${Math.max(0, Number(goal.progress || 0))}">Løft risiko</button><button type="button" data-goal-id="${esc(goal.id)}" data-goal-status="complete" data-goal-progress="100">Ferdig</button></span>` : '';
  const sustainabilityActions = (item) => canWrite && !['complete','closed'].includes(item.status) ? `<span class="row-actions"><button type="button" data-sustainability-id="${esc(item.id)}">Marker fulgt opp</button></span>` : '';
  const attendanceActions = (item) => canWrite ? `<span class="row-actions"><button type="button" data-attendance-id="${esc(item.id)}" data-attendance-status="present">Fremmøtt</button><button type="button" data-attendance-id="${esc(item.id)}" data-attendance-status="absent">Fravær</button><button type="button" data-attendance-id="${esc(item.id)}" data-attendance-status="excused">Forfall</button></span>` : '';
  const periodActions = (period) => canWrite && period.status !== 'locked' ? `<span class="row-actions"><button type="button" data-period="${esc(period.period)}">Lås periode</button></span>` : '';
  const treasuryActions = (item, action, idKey) => canWrite && !['approved','submitted','paid','closed'].includes(item.status) ? `<span class="row-actions"><button type="button" data-treasury-action="${action}" data-treasury-id="${esc(item[idKey])}">${action==='prepare_collection'?'Forbered purring':action==='approve_submission'?'Godkjenn review':'Godkjenn lønn'}</button></span>` : '';
  const projectActions = (item, action, idKey) => canWrite && !['approved','complete','sent'].includes(item.status) ? `<span class="row-actions"><button type="button" data-project-action="${action}" data-project-id="${esc(item[idKey])}">${action==='approve_time'?'Godkjenn timer':action==='approve_invoice_draft'?'Godkjenn utkast':action==='complete_maintenance'?'Marker utført':'Forbered fakturautkast'}</button></span>` : '';
  const commercialActions = (item, action, idKey) => canWrite && !['approved','sent','resolved','closed'].includes(item.status) ? `<span class="row-actions"><button type="button" data-commercial-action="${action}" data-commercial-id="${esc(item[idKey])}">${action==='approve_quote'?'Godkjenn tilbud':action==='send_quote'?'Forbered utsending':'Marker løst'}</button></span>` : '';
  const fail = (title, copy) => { qs('#tenant-loading').hidden=true; qs('#tenant-content').hidden=true; qs('#tenant-error').hidden=false; qs('#tenant-error-title').textContent=title; qs('#tenant-error-copy').textContent=copy; };
  const get = async (url, options={}) => { const response=await fetch(url,options); const data=await response.json(); if(!response.ok) throw new Error(data.error||'request_failed'); return data; };
  const render = async (boardId, boardPayload) => {
    let rows=[]; const boardData=boardPayload.data||{};
    if(view==='board') { const actions=boardData.actions||[], meetings=boardData.meetings||[], resolutions=boardData.resolutions||[]; const open=actions.filter(x=>!['completed','done','closed'].includes(x.status)); setMetric('a','Åpne oppgaver',open.length,`${open.filter(x=>['critical','high'].includes(x.priority)).length} høy prioritet`); setMetric('b','Kommende møter',meetings.filter(x=>!['completed','cancelled'].includes(x.status)).length,'planlagt eller pågående'); setMetric('c','Vedtak',resolutions.length,`${resolutions.filter(x=>x.signature_status!=='complete').length} krever signaturkontroll`); rows=open.map(x=>row(x.title,`${x.assigned_to||'Eier ikke satt'} · frist ${x.due_date||'ikke satt'}`,x.status,['critical','high'].includes(x.priority)?'warn':'',actionActions(x))); }
    if(view==='governance') { const [summary, meetings]=await Promise.all([get(`/api/board_governance?boardId=${encodeURIComponent(boardId)}&view=summary`),get(`/api/board_governance?boardId=${encodeURIComponent(boardId)}&view=meetings`)]); const data=summary.data||{}; rows=meetings.data||[]; setMetric('a','Møter',Number(data.meetings?.count||0),'aktive eller gjennomførte'); setMetric('b','Planlagt',Number(data.upcoming?.count||0),'krever forberedelse'); setMetric('c','Fremmøter',Number(data.present?.count||0),`${Number(data.ballots?.count||0)} stemmer registrert`); rows=rows.map(x=>row(x.title,`${x.date||'dato ikke satt'} · ${x.present_count||0}/${x.invited_count||0} fremmøtt`,x.status,Number(x.present_count||0)<Number(x.invited_count||0)?'warn':'')); }
    if(view==='governance') { const attendance=await get(`/api/board_governance?boardId=${encodeURIComponent(boardId)}&view=attendance`); rows=attendance.data||[]; qs('#list-title').textContent='Fremmøte og habilitet'; rows=rows.map(x=>row(`${x.meeting_title||'Møte'} · ${x.member_name||'Medlem'}`,`${x.role||'rolle ikke satt'} · ${x.conflict_flag?'Habilitet må vurderes':'Ingen registrert konflikt'}`,x.attendance_status,x.conflict_flag?'danger':'',attendanceActions(x))); }
    if(view==='operations') { const result=await get(`/api/operations?boardId=${encodeURIComponent(boardId)}`); const data=result.metrics||{}; const groups=[['Mennesker','people'],['IT og drift','it'],['Økonomi','finance'],['Kunder','commercial'],['Felt og prosjekt','field'],['Plattform','platform']]; rows=groups.flatMap(([label,key])=>(data[key]||[]).map((metric,index)=>({label, key, index, value:Number(metric[0]||0), note:String(metric[1]||'')}))); setMetric('a','Åpne signaler',Number(result.attentionCount||0),'krever prioritering'); setMetric('b','Områder',groups.length,'samlet i cockpit'); setMetric('c','Integrasjoner',Number(data.platform?.[1]?.[0]||0),'tilkoblet i registeret'); rows=rows.map(x=>row(`${x.label} · ${x.note}`,`Signal ${x.index+1} · kilde i virksomhetsbildet`,String(x.value),x.value>0&&['Mennesker','IT og drift','Kunder','Felt og prosjekt'].includes(x.label)?'warn':'')); }
    if(view==='risk') { const result=await get(`/api/risk?boardId=${encodeURIComponent(boardId)}&view=risks`); rows=(result.data||[]); setMetric('a','Registrerte risikoer',rows.length,'i dette registeret'); setMetric('b','Høy alvorlighet',rows.filter(x=>['critical','high'].includes(x.level)).length,'krever prioritering'); setMetric('c','Forfalt',rows.filter(x=>x.due_date&&new Date(x.due_date)<new Date()&&!['closed','resolved'].includes(x.status)).length,'basert på frist'); rows=rows.map(x=>row(`${x.code} · ${x.title}`,`${x.owner||'Eier ikke satt'} · frist ${x.due_date||'ikke satt'}`,x.status,['critical','high'].includes(x.level)?'warn':'',riskActions(x))); }
    if(view==='controls') { const result=await get(`/api/controls?boardId=${encodeURIComponent(boardId)}&view=items`); rows=result.data||[]; setMetric('a','Kontroller',rows.length,'registrert'); setMetric('b','Grønn status',rows.filter(x=>x.status==='green').length,'gjennomgått uten åpent avvik'); setMetric('c','Krever vurdering',rows.filter(x=>x.status!=='green').length,'gul eller rød'); rows=rows.map(x=>row(x.title,`${x.owner||'Eier ikke satt'} · ${x.frequency||'frekvens ikke satt'}`,x.status,x.status==='red'?'danger':x.status==='yellow'?'warn':'',controlActions(x))); }
    if(view==='finance') { const [summaryResult, selectedResult, periodResult]=await Promise.all([get(`/api/finance?boardId=${encodeURIComponent(boardId)}&view=summary`),get(`/api/finance?boardId=${encodeURIComponent(boardId)}&view=${encodeURIComponent(financeView)}`),get(`/api/finance?boardId=${encodeURIComponent(boardId)}&view=periods`)]); const summary=summaryResult.data||{}; rows=selectedResult.data||[]; const periods=periodResult.data||[]; setMetric('a','Aktive kontoer',Number(summary.accounts?.count||0),'i kontoplanen'); setMetric('b','Låste perioder',periods.filter(x=>x.status==='locked').length,'forseglet kontrollspor'); setMetric('c','Bilag',Number(summary.vouchers?.count||0),'registrerte poster'); const exportLink=qs('#export-link'); exportLink.hidden=false; exportLink.href=`/api/finance?boardId=${encodeURIComponent(boardId)}&view=saf-t`; qs('#finance-tabs').hidden=false; document.querySelectorAll('[data-finance-view]').forEach(link=>{link.href=`/app/arbeidsflate?boardId=${encodeURIComponent(boardId)}&view=finance&finance=${link.dataset.financeView}`;link.classList.toggle('active',link.dataset.financeView===financeView)}); if(financeView==='vouchers'){qs('#list-title').textContent='Siste bilag';rows=rows.map(x=>row(`${x.voucher_number||x.reference||x.id} · ${x.description||'Bilag'}`,`${x.voucher_date||x.period||'dato ikke satt'} · ${x.source||'kilde ikke satt'} · ${Number(x.debit_minor||0)===Number(x.credit_minor||0)?'balansert':'avvik'}`,x.status,Number(x.debit_minor||0)===Number(x.credit_minor||0)?'':'danger'));} if(financeView==='periods'){qs('#list-title').textContent='Regnskapsperioder';rows=rows.map(x=>row(x.period,`${x.locked_by?`Låst av ${x.locked_by}`:'Ikke låst'} · ${x.locked_at||'ingen låsetid'}`,x.status,x.status==='locked'?'':'warn',periodActions(x)));} if(financeView==='accounts'){qs('#list-title').textContent='Kontoplan';rows=rows.map(x=>row(`${x.code} · ${x.name}`,`${x.account_type||'kontotype ikke satt'} · MVA ${x.vat_code||'ikke satt'}`,x.active?'aktiv':'inaktiv',x.active?'':'warn'));} }
    if(view==='treasury') { const [summaryResult, selectedResult]=await Promise.all([get(`/api/treasury?boardId=${encodeURIComponent(boardId)}&view=summary`),get(`/api/treasury?boardId=${encodeURIComponent(boardId)}&view=${encodeURIComponent(treasuryView)}`)]); const summary=summaryResult.data||{}; rows=selectedResult.data||[]; setMetric('a','Lønn til kontroll',Number(summary.payroll?.count||0),`${money(summary.payroll?.gross_minor)} brutto grunnlag`); setMetric('b','Runway',summary.liquidity?.runway_months==null?'—':`${summary.liquidity.runway_months} mnd`,'basert på siste manuelle bilde'); setMetric('c','Åpne innkrevingssaker',Number(summary.collections?.count||0),money(summary.collections?.amount_minor)); qs('#treasury-tabs').hidden=false; document.querySelectorAll('[data-treasury-view]').forEach(link=>{link.href=`/app/arbeidsflate?boardId=${encodeURIComponent(boardId)}&view=treasury&treasury=${link.dataset.treasuryView}`;link.classList.toggle('active',link.dataset.treasuryView===treasuryView)}); const moneyMeta=x=>`Kilde: ${x.source||'ikke oppgitt'} · ${x.external_reference||'ekstern adapter ikke konfigurert'}`; if(treasuryView==='summary'){qs('#list-title').textContent='Kontrollbildet'; const s=summary; rows=[['Lønn',`${s.payroll?.count||0} kjøring(er) · ${money(s.payroll?.gross_minor)}`,s.payroll?.count?'Til kontroll':'Ingen åpne kjøringer','warn'],['Innsendinger',`${s.submissions?.count||0} forberedt eller til review`,'Krever menneskelig godkjenning',s.submissions?.count?'warn':''],['Likviditet',`${money(s.liquidity?.cash_minor)} kontant · ${s.liquidity?.runway_months??'—'} måneder runway`,s.liquidity?'Manuelt kontrollbilde':'Ikke registrert',''],['Innkrevingsspor',`${s.collections?.count||0} åpne · ${money(s.collections?.amount_minor)}`,'Krever oppfølging',s.collections?.count?'warn':'']].map(x=>row(x[0],x[1],x[2],x[3]));} if(treasuryView==='payroll'){qs('#list-title').textContent='Lønnskjøringer';rows=rows.map(x=>row(`${x.period||'Periode ikke satt'} · lønnskjøring`,`${x.employee_count||0} ansatte · ${x.item_count||0} lønnslinjer`,x.status,x.status==='review'?'warn':'',treasuryActions(x,'approve_payroll','id')));} if(treasuryView==='submissions'){qs('#list-title').textContent='Innsendinger';rows=rows.map(x=>row(`${x.submission_type||'Innsending'} · ${x.period||'Periode ikke satt'}`,x.notes||moneyMeta(x),x.status,x.status==='submitted'?'':'warn',treasuryActions(x,'approve_submission','id')));} if(treasuryView==='liquidity'){qs('#list-title').textContent='Likviditetsbilder';rows=rows.map(x=>row(`${x.as_of_date||'Dato ikke satt'} · manuelt bilde`,`${money(x.cash_minor)} kontant · ${money(x.receivables_minor)} fordringer · ${money(x.payables_minor)} forpliktelser`,x.status,x.status==='draft'?'warn':''));} if(treasuryView==='collections'){qs('#list-title').textContent='Innkrevingsspor';rows=rows.map(x=>row(`${x.reference||x.id} · ${x.company_name||'Uten kunde'}`,`Forfaller ${x.due_date||'ikke satt'} · ${x.next_action||'Neste steg ikke satt'}`,x.status,x.status==='open'?'warn':'',treasuryActions(x,'prepare_collection','id')));} }
