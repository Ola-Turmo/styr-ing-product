---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Arbeidsflate — Styr.ing" activeNav="workspace">
  <main class="tenant-shell">
    <div id="tenant-loading" class="tenant-state"><span class="section-kicker">Kundeområde</span><h1>Henter arbeidsflaten.</h1><p>Kontrollerer tilgang og laster virksomhetens data.</p></div>
    <div id="tenant-error" class="tenant-state" hidden><span class="section-kicker">Tilgang</span><h1 id="tenant-error-title">Kunne ikke åpne arbeidsflaten.</h1><p id="tenant-error-copy">Prøv å logge inn på nytt.</p><a href="/login" class="primary">Gå til innlogging ↗</a></div>
    <div id="tenant-content" hidden>
      <header class="tenant-header"><div><a id="back-link" href="/app">← Kundeområde</a><span id="tenant-kicker" class="section-kicker">Arbeidsflate</span><h1 id="tenant-title">—</h1><p id="tenant-copy">—</p></div><div class="tenant-identity"><strong id="tenant-board">—</strong><span id="tenant-role">—</span></div></header>
      <nav class="tenant-tabs" aria-label="Arbeidsområder"><a data-view="board" href="?view=board">Styre</a><a data-view="risk" href="?view=risk">Risiko</a><a data-view="controls" href="?view=controls">Internkontroll</a><a data-view="finance" href="?view=finance">Økonomi</a><a data-view="people" href="?view=people">Mennesker</a></nav>
      <section class="tenant-summary"><article><small id="metric-a-label">—</small><strong id="metric-a">—</strong><span id="metric-a-note">—</span></article><article><small id="metric-b-label">—</small><strong id="metric-b">—</strong><span id="metric-b-note">—</span></article><article><small id="metric-c-label">—</small><strong id="metric-c">—</strong><span id="metric-c-note">—</span></article></section>
      <section class="tenant-card"><div class="card-head"><div><span id="list-kicker" class="section-kicker">Oversikt</span><h2 id="list-title">—</h2></div><span id="list-count">—</span></div><div id="tenant-list" class="tenant-list"><p class="empty">Henter rader…</p></div></section>
      <p class="boundary">Dataene i denne arbeidsflaten er avgrenset til virksomheten kontoen har tilgang til. Endringer og eksterne innsendinger krever riktig rolle, kontrollspor og eksplisitt godkjenning.</p>
    </div>
  </main>
</Layout>
<script is:inline>
  const qs = (selector) => document.querySelector(selector);
  const esc = (value) => String(value ?? '').replace(/[&<>'\"]/g, (c) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', "'":'&#39;', '\"':'&quot;' }[c]));
  const labels = {
    board: { kicker:'STYRE · OPPFØLGING', title:'Saker som skal videre', copy:'Se møter, åpne oppgaver og vedtak i samme beslutningsspor.', list:'Åpne oppgaver' },
    risk: { kicker:'RISIKO · TILTAK', title:'Risiko med tydelig eier', copy:'Prioriter det som krever vurdering og følg frister og behandling.', list:'Risikoregister' },
    controls: { kicker:'INTERNKONTROLL · STATUS', title:'Kontroller du kan følge', copy:'Se kontrollstatus, ansvar og siste gjennomgang uten å miste kilden.', list:'Kontrollpunkter' },
    finance: { kicker:'ØKONOMI · KONTROLLSPOR', title:'Bilag med spor', copy:'Følg referanse, motpart, periode og status før neste beslutning.', list:'Siste bilag' },
    people: { kicker:'MENNESKER · ROLLER', title:'Ansvar i organisasjonen', copy:'Se rolle, avdeling og arbeidsstatus i én avgrenset oversikt.', list:'Personer' },
  };
  const params = new URLSearchParams(location.search); const view = labels[params.get('view')] ? params.get('view') : 'board';
  const setMetric = (slot, label, value, note) => { qs(`#metric-${slot}-label`).textContent=label; qs(`#metric-${slot}`).textContent=value; qs(`#metric-${slot}-note`).textContent=note; };
  const row = (title, meta, status, tone='') => `<article class="tenant-row"><i class="${tone}"></i><span><strong>${esc(title)}</strong><small>${esc(meta)}</small></span><em>${esc(status || '—')}</em></article>`;
  const fail = (title, copy) => { qs('#tenant-loading').hidden=true; qs('#tenant-content').hidden=true; qs('#tenant-error').hidden=false; qs('#tenant-error-title').textContent=title; qs('#tenant-error-copy').textContent=copy; };
  const get = async (url) => { const response=await fetch(url); const data=await response.json(); if(!response.ok) throw new Error(data.error||'request_failed'); return data; };
  const render = async (boardId, boardPayload) => {
    let rows=[]; const boardData=boardPayload.data||{};
    if(view==='board') { const actions=boardData.actions||[], meetings=boardData.meetings||[], resolutions=boardData.resolutions||[]; const open=actions.filter(x=>!['completed','done','closed'].includes(x.status)); setMetric('a','Åpne oppgaver',open.length,`${open.filter(x=>['critical','high'].includes(x.priority)).length} høy prioritet`); setMetric('b','Kommende møter',meetings.filter(x=>!['completed','cancelled'].includes(x.status)).length,'planlagt eller pågående'); setMetric('c','Vedtak',resolutions.length,`${resolutions.filter(x=>x.signature_status!=='complete').length} krever signaturkontroll`); rows=open.map(x=>row(x.title,`${x.assigned_to||'Eier ikke satt'} · frist ${x.due_date||'ikke satt'}`,x.status,['critical','high'].includes(x.priority)?'warn':'')); }
    if(view==='risk') { const result=await get(`/api/risk?boardId=${encodeURIComponent(boardId)}&view=risks`); rows=(result.data||[]); setMetric('a','Registrerte risikoer',rows.length,'i dette registeret'); setMetric('b','Høy alvorlighet',rows.filter(x=>['critical','high'].includes(x.level)).length,'krever prioritering'); setMetric('c','Forfalt',rows.filter(x=>x.due_date&&new Date(x.due_date)<new Date()&&!['closed','resolved'].includes(x.status)).length,'basert på frist'); rows=rows.map(x=>row(`${x.code} · ${x.title}`,`${x.owner||'Eier ikke satt'} · frist ${x.due_date||'ikke satt'}`,x.status,['critical','high'].includes(x.level)?'warn':'')); }
    if(view==='controls') { const result=await get(`/api/controls?boardId=${encodeURIComponent(boardId)}&view=items`); rows=result.data||[]; setMetric('a','Kontroller',rows.length,'registrert'); setMetric('b','Grønn status',rows.filter(x=>x.status==='green').length,'gjennomgått uten åpent avvik'); setMetric('c','Krever vurdering',rows.filter(x=>x.status!=='green').length,'gul eller rød'); rows=rows.map(x=>row(x.title,`${x.owner||'Eier ikke satt'} · ${x.frequency||'frekvens ikke satt'}`,x.status,x.status==='red'?'danger':x.status==='yellow'?'warn':'')); }
    if(view==='finance') { const result=await get(`/api/finance?boardId=${encodeURIComponent(boardId)}&view=vouchers`); rows=result.data||[]; const balanced=rows.filter(x=>Number(x.debit_minor||0)===Number(x.credit_minor||0)); setMetric('a','Bilag',rows.length,'i valgt visning'); setMetric('b','Postert',rows.filter(x=>x.status==='posted').length,'med kontrollspor'); setMetric('c','Balansert',balanced.length,'debet er lik kredit'); rows=rows.map(x=>row(`${x.voucher_number||x.reference||x.id} · ${x.description||'Bilag'}`,`${x.voucher_date||x.period||'dato ikke satt'} · ${x.source||'kilde ikke satt'}`,x.status)); }
    if(view==='people') { const result=await get(`/api/hcm?boardId=${encodeURIComponent(boardId)}&view=people`); rows=result.data||[]; setMetric('a','Personer',rows.length,'i virksomheten'); setMetric('b','Aktive',rows.filter(x=>x.employment_status==='active').length,'arbeidsstatus aktiv'); setMetric('c','Avdelinger',new Set(rows.map(x=>x.department).filter(Boolean)).size,'representert'); rows=rows.map(x=>row(x.name,`${x.role||'Rolle ikke satt'} · ${x.department||'avdeling ikke satt'}`,x.employment_status)); }
    qs('#tenant-list').innerHTML=rows.length?rows.join(''):'<p class="empty">Ingen rader i denne visningen.</p>'; qs('#list-count').textContent=`${rows.length} poster`;
  };
  const load = async () => {
    try { const auth=await get('/api/auth'); if(!auth.authenticated){location.href=`/login?next=${encodeURIComponent(location.pathname+location.search)}`;return;} const requested=params.get('boardId'); const boards=auth.boards||[]; const selected=boards.find(x=>x.id===requested)||boards[0]; if(!selected){fail('Ingen virksomhet er koblet til kontoen.','Be en administrator om tilgang.');return;} const boardPayload=await get(`/api/board/${encodeURIComponent(selected.id)}`); const meta=labels[view]; qs('#tenant-loading').hidden=true;qs('#tenant-error').hidden=true;qs('#tenant-content').hidden=false;qs('#tenant-kicker').textContent=meta.kicker;qs('#tenant-title').textContent=meta.title;qs('#tenant-copy').textContent=meta.copy;qs('#list-kicker').textContent=meta.kicker;qs('#list-title').textContent=meta.list;qs('#tenant-board').textContent=boardPayload.data.board.name;qs('#tenant-role').textContent=selected.role==='owner'?'Eier':selected.role==='editor'?'Redaktør':'Leser';qs('#back-link').href=`/app?boardId=${encodeURIComponent(selected.id)}`;document.querySelectorAll('.tenant-tabs a').forEach(link=>{link.href=`/app/arbeidsflate?boardId=${encodeURIComponent(selected.id)}&view=${link.dataset.view}`;link.classList.toggle('active',link.dataset.view===view)});await render(selected.id,boardPayload); } catch(error) { fail(error.message==='board_access_denied'?'Ingen tilgang til virksomheten.':'Arbeidsflaten er midlertidig utilgjengelig.','Prøv igjen, eller kontakt administratoren hvis problemet fortsetter.'); }
  };
  load();
</script>
<style>
  .tenant-shell{max-width:1040px;margin:0 auto;padding:42px 24px 88px}.tenant-state{max-width:620px;margin:80px auto;text-align:center}.tenant-state h1{font:500 clamp(2.5rem,6vw,4.5rem)/.95 Georgia,serif;letter-spacing:-.06em;margin:14px 0}.tenant-state p,.boundary,.empty{color:var(--muted);font:.8rem/1.55 system-ui,sans-serif}.primary{display:inline-flex;margin-top:15px;padding:12px 16px;border-radius:9px;background:var(--night);color:#fff;font:700 .74rem/1 system-ui,sans-serif}.tenant-header{display:flex;justify-content:space-between;align-items:end;gap:25px;margin-bottom:24px}.tenant-header>a,#back-link{display:inline-block;margin-bottom:18px;color:var(--accent);font:700 .68rem/1 system-ui,sans-serif}.tenant-header h1{margin:11px 0 8px;font:500 clamp(2.6rem,6vw,4.6rem)/.94 Georgia,serif;letter-spacing:-.06em}.tenant-header p{margin:0;max-width:600px;color:var(--muted);font:.84rem/1.55 system-ui,sans-serif}.tenant-identity{display:grid;justify-items:end;gap:7px;min-width:180px}.tenant-identity strong{font:700 .78rem/1.2 system-ui,sans-serif}.tenant-identity span{padding:6px 9px;border-radius:999px;background:#e8f1df;color:var(--accent);font:700 .62rem/1 system-ui,sans-serif}.tenant-tabs{display:flex;gap:6px;overflow:auto;padding-bottom:7px;margin-bottom:15px}.tenant-tabs a{white-space:nowrap;padding:9px 12px;border:1px solid rgba(16,36,31,.1);border-radius:9px;background:#fff;color:var(--muted);font:700 .68rem/1 system-ui,sans-serif}.tenant-tabs a.active,.tenant-tabs a:hover{background:var(--night);border-color:var(--night);color:#fff}.tenant-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:11px;margin-bottom:15px}.tenant-summary article,.tenant-card{border:1px solid rgba(16,36,31,.09);border-radius:15px;background:#fff}.tenant-summary article{padding:17px;min-height:105px}.tenant-summary small,.tenant-summary span{display:block;color:var(--muted);font:600 .67rem/1.35 system-ui,sans-serif}.tenant-summary strong{display:block;margin:11px 0 5px;font:500 1.9rem/1 Georgia,serif}.tenant-summary span{color:var(--accent)}.tenant-card{padding:22px}.card-head{display:flex;justify-content:space-between;align-items:start;gap:15px;margin-bottom:13px}.card-head h2{margin:8px 0 0;font:500 1.5rem/1 Georgia,serif}.card-head>span{color:var(--muted);font:700 .66rem/1 system-ui,sans-serif}.tenant-list{display:grid}.tenant-row{display:flex;align-items:center;gap:11px;padding:13px 2px;border-bottom:1px solid rgba(16,36,31,.07)}.tenant-row:last-child{border-bottom:0}.tenant-row i{width:8px;height:8px;border-radius:50%;background:#76b76f;flex:none}.tenant-row i.warn{background:#d69738}.tenant-row i.danger{background:#b95f55}.tenant-row span{display:grid;gap:4px;flex:1}.tenant-row strong{font:700 .78rem/1.25 system-ui,sans-serif}.tenant-row small{color:var(--muted);font:.68rem/1.35 system-ui,sans-serif}.tenant-row em{font:600 .65rem/1 system-ui,sans-serif;font-style:normal;color:var(--muted)}.boundary{margin:16px 0 0;padding:15px 3px;border-top:1px solid rgba(16,36,31,.08)}
  @media(max-width:650px){.tenant-shell{padding:28px 16px 60px}.tenant-header{align-items:start;flex-direction:column}.tenant-identity{justify-items:start}.tenant-summary{grid-template-columns:1fr}.tenant-card{padding:17px}.tenant-row{align-items:flex-start}.tenant-row em{max-width:90px;text-align:right}}
</style>
