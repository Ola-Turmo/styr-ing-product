---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Arbeidsflate — Styr.ing" activeNav="workspace">
  <main class="tenant-shell">
    <div id="tenant-loading" class="tenant-state"><span class="section-kicker">Kundeområde</span><h1>Henter arbeidsflaten.</h1><p>Kontrollerer tilgang og laster virksomhetens data.</p></div>
    <div id="tenant-error" class="tenant-state" hidden><span class="section-kicker">Tilgang</span><h1 id="tenant-error-title">Kunne ikke åpne arbeidsflaten.</h1><p id="tenant-error-copy">Prøv å logge inn på nytt.</p><a href="/login" class="primary">Gå til innlogging ↗</a></div>
    <div id="tenant-content" hidden>
      <header class="tenant-header"><div><a id="back-link" href="/app">← Kundeområde</a><span id="tenant-kicker" class="section-kicker">Arbeidsflate</span><h1 id="tenant-title">—</h1><p id="tenant-copy">—</p></div><div class="tenant-identity"><strong id="tenant-board">—</strong><span id="tenant-role">—</span></div></header>
      <nav class="tenant-tabs" aria-label="Arbeidsområder"><a data-view="board" href="?view=board">Styre</a><a data-view="governance" href="?view=governance">Møte og habilitet</a><a data-view="risk" href="?view=risk">Risiko</a><a data-view="controls" href="?view=controls">Internkontroll</a><a data-view="finance" href="?view=finance">Økonomi</a><a data-view="people" href="?view=people">Mennesker</a><a data-view="goals" href="?view=goals">Mål</a></nav>
      <section class="tenant-summary"><article><small id="metric-a-label">—</small><strong id="metric-a">—</strong><span id="metric-a-note">—</span></article><article><small id="metric-b-label">—</small><strong id="metric-b">—</strong><span id="metric-b-note">—</span></article><article><small id="metric-c-label">—</small><strong id="metric-c">—</strong><span id="metric-c-note">—</span></article></section>
      <section class="tenant-card"><div class="card-head"><div><span id="list-kicker" class="section-kicker">Oversikt</span><h2 id="list-title">—</h2></div><div class="card-head-tools"><a id="export-link" href="#" hidden>Last ned SAF‑T ↗</a><span id="list-count">—</span></div></div><nav id="finance-tabs" class="finance-tabs" aria-label="Økonomivisninger" hidden><a data-finance-view="vouchers" href="#">Bilag</a><a data-finance-view="periods" href="#">Perioder</a><a data-finance-view="accounts" href="#">Kontoplan</a></nav><p id="action-status" class="action-status" role="status" hidden></p><div id="tenant-list" class="tenant-list"><p class="empty">Henter rader…</p></div></section>
      <p class="boundary">Dataene i denne arbeidsflaten er avgrenset til virksomheten kontoen har tilgang til. Endringer og eksterne innsendinger krever riktig rolle, kontrollspor og eksplisitt godkjenning.</p>
    </div>
  </main>
</Layout>
<script is:inline>
  const qs = (selector) => document.querySelector(selector);
  const esc = (value) => String(value ?? '').replace(/[&<>'\"]/g, (c) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', "'":'&#39;', '\"':'&quot;' }[c]));
  const labels = {
    board: { kicker:'STYRE · OPPFØLGING', title:'Saker som skal videre', copy:'Se møter, åpne oppgaver og vedtak i samme beslutningsspor.', list:'Åpne oppgaver' },
    governance: { kicker:'STYRE · MØTE OG HABILITET', title:'Møter med tydelig spor', copy:'Følg planlagte møter, fremmøte og avstemninger før beslutningen går videre.', list:'Møteoversikt' },
    risk: { kicker:'RISIKO · TILTAK', title:'Risiko med tydelig eier', copy:'Prioriter det som krever vurdering og følg frister og behandling.', list:'Risikoregister' },
    controls: { kicker:'INTERNKONTROLL · STATUS', title:'Kontroller du kan følge', copy:'Se kontrollstatus, ansvar og siste gjennomgang uten å miste kilden.', list:'Kontrollpunkter' },
    finance: { kicker:'ØKONOMI · KONTROLLSPOR', title:'Bilag med spor', copy:'Følg referanse, motpart, periode og status før neste beslutning.', list:'Siste bilag' },
    people: { kicker:'MENNESKER · ROLLER', title:'Ansvar i organisasjonen', copy:'Se rolle, avdeling og arbeidsstatus i én avgrenset oversikt.', list:'Personer' },
    goals: { kicker:'MÅL · FREMDRIFT', title:'Mål som kan følges opp', copy:'Se hva som er på rett spor, hva som trenger hjelp og hvem som eier fremdriften.', list:'Mål og OKR' },
  };
  const params = new URLSearchParams(location.search); const view = labels[params.get('view')] ? params.get('view') : 'board'; const financeView=['vouchers','periods','accounts'].includes(params.get('finance'))?params.get('finance'):'vouchers';
  let activeBoardId = ''; let canWrite = false;
  const setMetric = (slot, label, value, note) => { qs(`#metric-${slot}-label`).textContent=label; qs(`#metric-${slot}`).textContent=value; qs(`#metric-${slot}-note`).textContent=note; };
  const row = (title, meta, status, tone='', actions='') => `<article class="tenant-row"><i class="${tone}"></i><span><strong>${esc(title)}</strong><small>${esc(meta)}</small></span><em>${esc(status || '—')}</em>${actions}</article>`;
  const controlActions = (control) => canWrite ? `<span class="row-actions" aria-label="Oppdater kontrollstatus"><button type="button" data-control-id="${esc(control.id)}" data-control-status="green">Grønn</button><button type="button" data-control-id="${esc(control.id)}" data-control-status="yellow">Gul</button><button type="button" data-control-id="${esc(control.id)}" data-control-status="red">Rød</button></span>` : '';
  const riskActions = (risk) => canWrite ? `<span class="row-actions" aria-label="Oppdater risikostatus"><button type="button" data-risk-id="${esc(risk.id)}" data-risk-status="treating">Behandle</button><button type="button" data-risk-id="${esc(risk.id)}" data-risk-status="monitoring">Overvåk</button><button type="button" data-risk-id="${esc(risk.id)}" data-risk-status="closed">Lukk</button></span>` : '';
  const actionActions = (item) => canWrite ? `<span class="row-actions" aria-label="Oppdater oppgave"><button type="button" data-action-id="${esc(item.id)}" data-action-status="completed">Marker ferdig</button></span>` : '';
  const goalActions = (goal) => canWrite ? `<span class="row-actions" aria-label="Oppdater målfremdrift"><button type="button" data-goal-id="${esc(goal.id)}" data-goal-status="on_track" data-goal-progress="${Math.max(0, Number(goal.progress || 0))}">På rett spor</button><button type="button" data-goal-id="${esc(goal.id)}" data-goal-status="at_risk" data-goal-progress="${Math.max(0, Number(goal.progress || 0))}">Løft risiko</button><button type="button" data-goal-id="${esc(goal.id)}" data-goal-status="complete" data-goal-progress="100">Ferdig</button></span>` : '';
  const fail = (title, copy) => { qs('#tenant-loading').hidden=true; qs('#tenant-content').hidden=true; qs('#tenant-error').hidden=false; qs('#tenant-error-title').textContent=title; qs('#tenant-error-copy').textContent=copy; };
  const get = async (url, options={}) => { const response=await fetch(url,options); const data=await response.json(); if(!response.ok) throw new Error(data.error||'request_failed'); return data; };
  const render = async (boardId, boardPayload) => {
    let rows=[]; const boardData=boardPayload.data||{};
    if(view==='board') { const actions=boardData.actions||[], meetings=boardData.meetings||[], resolutions=boardData.resolutions||[]; const open=actions.filter(x=>!['completed','done','closed'].includes(x.status)); setMetric('a','Åpne oppgaver',open.length,`${open.filter(x=>['critical','high'].includes(x.priority)).length} høy prioritet`); setMetric('b','Kommende møter',meetings.filter(x=>!['completed','cancelled'].includes(x.status)).length,'planlagt eller pågående'); setMetric('c','Vedtak',resolutions.length,`${resolutions.filter(x=>x.signature_status!=='complete').length} krever signaturkontroll`); rows=open.map(x=>row(x.title,`${x.assigned_to||'Eier ikke satt'} · frist ${x.due_date||'ikke satt'}`,x.status,['critical','high'].includes(x.priority)?'warn':'',actionActions(x))); }
    if(view==='governance') { const [summary, meetings]=await Promise.all([get(`/api/board_governance?boardId=${encodeURIComponent(boardId)}&view=summary`),get(`/api/board_governance?boardId=${encodeURIComponent(boardId)}&view=meetings`)]); const data=summary.data||{}; rows=meetings.data||[]; setMetric('a','Møter',Number(data.meetings?.count||0),'aktive eller gjennomførte'); setMetric('b','Planlagt',Number(data.upcoming?.count||0),'krever forberedelse'); setMetric('c','Fremmøter',Number(data.present?.count||0),`${Number(data.ballots?.count||0)} stemmer registrert`); rows=rows.map(x=>row(x.title,`${x.date||'dato ikke satt'} · ${x.present_count||0}/${x.invited_count||0} fremmøtt`,x.status,Number(x.present_count||0)<Number(x.invited_count||0)?'warn':'')); }
    if(view==='risk') { const result=await get(`/api/risk?boardId=${encodeURIComponent(boardId)}&view=risks`); rows=(result.data||[]); setMetric('a','Registrerte risikoer',rows.length,'i dette registeret'); setMetric('b','Høy alvorlighet',rows.filter(x=>['critical','high'].includes(x.level)).length,'krever prioritering'); setMetric('c','Forfalt',rows.filter(x=>x.due_date&&new Date(x.due_date)<new Date()&&!['closed','resolved'].includes(x.status)).length,'basert på frist'); rows=rows.map(x=>row(`${x.code} · ${x.title}`,`${x.owner||'Eier ikke satt'} · frist ${x.due_date||'ikke satt'}`,x.status,['critical','high'].includes(x.level)?'warn':'',riskActions(x))); }
    if(view==='controls') { const result=await get(`/api/controls?boardId=${encodeURIComponent(boardId)}&view=items`); rows=result.data||[]; setMetric('a','Kontroller',rows.length,'registrert'); setMetric('b','Grønn status',rows.filter(x=>x.status==='green').length,'gjennomgått uten åpent avvik'); setMetric('c','Krever vurdering',rows.filter(x=>x.status!=='green').length,'gul eller rød'); rows=rows.map(x=>row(x.title,`${x.owner||'Eier ikke satt'} · ${x.frequency||'frekvens ikke satt'}`,x.status,x.status==='red'?'danger':x.status==='yellow'?'warn':'',controlActions(x))); }
    if(view==='finance') { const [summaryResult, selectedResult, periodResult]=await Promise.all([get(`/api/finance?boardId=${encodeURIComponent(boardId)}&view=summary`),get(`/api/finance?boardId=${encodeURIComponent(boardId)}&view=${encodeURIComponent(financeView)}`),get(`/api/finance?boardId=${encodeURIComponent(boardId)}&view=periods`)]); const summary=summaryResult.data||{}; rows=selectedResult.data||[]; const periods=periodResult.data||[]; setMetric('a','Aktive kontoer',Number(summary.accounts?.count||0),'i kontoplanen'); setMetric('b','Låste perioder',periods.filter(x=>x.status==='locked').length,'forseglet kontrollspor'); setMetric('c','Bilag',Number(summary.vouchers?.count||0),'registrerte poster'); const exportLink=qs('#export-link'); exportLink.hidden=false; exportLink.href=`/api/finance?boardId=${encodeURIComponent(boardId)}&view=saf-t`; qs('#finance-tabs').hidden=false; document.querySelectorAll('[data-finance-view]').forEach(link=>{link.href=`/app/arbeidsflate?boardId=${encodeURIComponent(boardId)}&view=finance&finance=${link.dataset.financeView}`;link.classList.toggle('active',link.dataset.financeView===financeView)}); if(financeView==='vouchers'){qs('#list-title').textContent='Siste bilag';rows=rows.map(x=>row(`${x.voucher_number||x.reference||x.id} · ${x.description||'Bilag'}`,`${x.voucher_date||x.period||'dato ikke satt'} · ${x.source||'kilde ikke satt'} · ${Number(x.debit_minor||0)===Number(x.credit_minor||0)?'balansert':'avvik'}`,x.status,Number(x.debit_minor||0)===Number(x.credit_minor||0)?'':'danger'));} if(financeView==='periods'){qs('#list-title').textContent='Regnskapsperioder';rows=rows.map(x=>row(x.period,`${x.locked_by?`Låst av ${x.locked_by}`:'Ikke låst'} · ${x.locked_at||'ingen låsetid'}`,x.status,x.status==='locked'?'':'warn'));} if(financeView==='accounts'){qs('#list-title').textContent='Kontoplan';rows=rows.map(x=>row(`${x.code} · ${x.name}`,`${x.account_type||'kontotype ikke satt'} · MVA ${x.vat_code||'ikke satt'}`,x.active?'aktiv':'inaktiv',x.active?'':'warn'));} }
    if(view==='people') { const result=await get(`/api/hcm?boardId=${encodeURIComponent(boardId)}&view=people`); rows=result.data||[]; setMetric('a','Personer',rows.length,'i virksomheten'); setMetric('b','Aktive',rows.filter(x=>x.employment_status==='active').length,'arbeidsstatus aktiv'); setMetric('c','Avdelinger',new Set(rows.map(x=>x.department).filter(Boolean)).size,'representert'); rows=rows.map(x=>row(x.name,`${x.role||'Rolle ikke satt'} · ${x.department||'avdeling ikke satt'}`,x.employment_status)); }
    if(view==='goals') { const result=await get(`/api/hcm?boardId=${encodeURIComponent(boardId)}&view=goals`); rows=result.data||[]; setMetric('a','Mål',rows.length,'i valgt periode'); setMetric('b','På rett spor',rows.filter(x=>x.status==='on_track').length,'status satt av eier'); setMetric('c','Krever hjelp',rows.filter(x=>x.status==='at_risk').length,'må løftes i oppfølgingen'); rows=rows.map(x=>row(x.title,`${x.owner_name||'Eier ikke satt'} · ${x.period||'periode ikke satt'} · ${Number(x.progress||0)}%`,x.status,['at_risk'].includes(x.status)?'danger':x.status==='on_track'?'':'warn',goalActions(x))); }
    qs('#export-link').hidden=view!=='finance'; qs('#finance-tabs').hidden=view!=='finance'; if(view!=='finance') qs('#export-link').removeAttribute('href'); qs('#tenant-list').innerHTML=rows.length?rows.join(''):'<p class="empty">Ingen rader i denne visningen.</p>'; qs('#list-count').textContent=`${rows.length} poster`;
    document.querySelectorAll('[data-control-status]').forEach((button) => button.addEventListener('click', async () => { await mutate('/api/controls', { boardId: activeBoardId, controlId: button.dataset.controlId, status: button.dataset.controlStatus }); }));
    document.querySelectorAll('[data-risk-status]').forEach((button) => button.addEventListener('click', async () => { if(button.dataset.riskStatus==='closed'&&!confirm('Lukke denne risikoen? Endringen blir registrert i kontrollsporet.')) return; await mutate('/api/risk', { boardId: activeBoardId, action: 'update_risk', riskId: button.dataset.riskId, status: button.dataset.riskStatus }); }));
    document.querySelectorAll('[data-action-status]').forEach((button) => button.addEventListener('click', async () => { if(!confirm('Markere oppgaven som ferdig?')) return; await mutate('/api/risk', { boardId: activeBoardId, action: 'complete_action', actionId: button.dataset.actionId }); }));
    document.querySelectorAll('[data-goal-status]').forEach((button) => button.addEventListener('click', async () => { if(button.dataset.goalStatus==='complete'&&!confirm('Markere målet som ferdig?')) return; await mutate('/api/hcm', { boardId: activeBoardId, action: 'update_goal', goalId: button.dataset.goalId, status: button.dataset.goalStatus, progress: Number(button.dataset.goalProgress || 0) }); }));
  };
  const mutate = async (url, payload) => { const status=qs('#action-status'); status.hidden=false;status.classList.remove('error');status.textContent='Lagrer endringen…'; document.querySelectorAll('.row-actions button').forEach(button=>button.disabled=true); try { await get(url, { method:'POST', headers:{'content-type':'application/json'}, body:JSON.stringify(payload) }); await load(); status.hidden=false;status.textContent='Endringen er lagret og registrert i kontrollsporet.'; } catch(error) { status.hidden=false;status.classList.add('error');status.textContent=error.message==='write_not_authorized'?'Du har ikke rollen som kan endre dette.':'Endringen ble ikke lagret. Prøv igjen.'; document.querySelectorAll('.row-actions button').forEach(button=>button.disabled=false); } };
  const load = async () => {
    try { const auth=await get('/api/auth'); if(!auth.authenticated){location.href=`/login?next=${encodeURIComponent(location.pathname+location.search)}`;return;} const requested=params.get('boardId'); const boards=auth.boards||[]; const selected=boards.find(x=>x.id===requested)||boards[0]; if(!selected){fail('Ingen virksomhet er koblet til kontoen.','Be en administrator om tilgang.');return;} activeBoardId=selected.id; canWrite=['owner','editor'].includes(selected.role); const boardPayload=await get(`/api/board/${encodeURIComponent(selected.id)}`); const meta=labels[view]; qs('#tenant-loading').hidden=true;qs('#tenant-error').hidden=true;qs('#tenant-content').hidden=false;qs('#tenant-kicker').textContent=meta.kicker;qs('#tenant-title').textContent=meta.title;qs('#tenant-copy').textContent=meta.copy;qs('#list-kicker').textContent=meta.kicker;qs('#list-title').textContent=meta.list;qs('#tenant-board').textContent=boardPayload.data.board.name;qs('#tenant-role').textContent=selected.role==='owner'?'Eier':selected.role==='editor'?'Redaktør':'Leser';qs('#back-link').href=`/app?boardId=${encodeURIComponent(selected.id)}`;document.querySelectorAll('.tenant-tabs a').forEach(link=>{link.href=`/app/arbeidsflate?boardId=${encodeURIComponent(selected.id)}&view=${link.dataset.view}`;link.classList.toggle('active',link.dataset.view===view)});await render(selected.id,boardPayload); } catch(error) { fail(error.message==='board_access_denied'?'Ingen tilgang til virksomheten.':'Arbeidsflaten er midlertidig utilgjengelig.','Prøv igjen, eller kontakt administratoren hvis problemet fortsetter.'); }
  };
  load();
</script>
<style>
  .tenant-shell{max-width:1040px;margin:0 auto;padding:42px 24px 88px}.tenant-state{max-width:620px;margin:80px auto;text-align:center}.tenant-state h1{font:500 clamp(2.5rem,6vw,4.5rem)/.95 Georgia,serif;letter-spacing:-.06em;margin:14px 0}.tenant-state p,.boundary,.empty{color:var(--muted);font:.8rem/1.55 system-ui,sans-serif}.primary{display:inline-flex;margin-top:15px;padding:12px 16px;border-radius:9px;background:var(--night);color:#fff;font:700 .74rem/1 system-ui,sans-serif}.tenant-header{display:flex;justify-content:space-between;align-items:end;gap:25px;margin-bottom:24px}.tenant-header>a,#back-link{display:inline-block;margin-bottom:18px;color:var(--accent);font:700 .68rem/1 system-ui,sans-serif}.tenant-header h1{margin:11px 0 8px;font:500 clamp(2.6rem,6vw,4.6rem)/.94 Georgia,serif;letter-spacing:-.06em}.tenant-header p{margin:0;max-width:600px;color:var(--muted);font:.84rem/1.55 system-ui,sans-serif}.tenant-identity{display:grid;justify-items:end;gap:7px;min-width:180px}.tenant-identity strong{font:700 .78rem/1.2 system-ui,sans-serif}.tenant-identity span{padding:6px 9px;border-radius:999px;background:#e8f1df;color:var(--accent);font:700 .62rem/1 system-ui,sans-serif}.tenant-tabs{display:flex;gap:6px;overflow:auto;padding-bottom:7px;margin-bottom:15px}.tenant-tabs a{white-space:nowrap;padding:9px 12px;border:1px solid rgba(16,36,31,.1);border-radius:9px;background:#fff;color:var(--muted);font:700 .68rem/1 system-ui,sans-serif}.tenant-tabs a.active,.tenant-tabs a:hover{background:var(--night);border-color:var(--night);color:#fff}.tenant-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:11px;margin-bottom:15px}.tenant-summary article,.tenant-card{border:1px solid rgba(16,36,31,.09);border-radius:15px;background:#fff}.tenant-summary article{padding:17px;min-height:105px}.tenant-summary small,.tenant-summary span{display:block;color:var(--muted);font:600 .67rem/1.35 system-ui,sans-serif}.tenant-summary strong{display:block;margin:11px 0 5px;font:500 1.9rem/1 Georgia,serif}.tenant-summary span{color:var(--accent)}.tenant-card{padding:22px}.card-head{display:flex;justify-content:space-between;align-items:start;gap:15px;margin-bottom:13px}.card-head h2{margin:8px 0 0;font:500 1.5rem/1 Georgia,serif}.card-head-tools{display:flex;align-items:center;gap:11px}.card-head-tools span{color:var(--muted);font:700 .66rem/1 system-ui,sans-serif}.card-head-tools a{padding:7px 9px;border-radius:7px;background:#edf5e7;color:var(--accent);font:700 .62rem/1 system-ui,sans-serif}.action-status{margin:0 0 10px;padding:10px 12px;border-radius:8px;background:#edf5e7;color:var(--accent);font:700 .68rem/1.35 system-ui,sans-serif}.action-status.error{background:#faece8;color:#8f3e34}.tenant-list{display:grid}.tenant-row{display:flex;align-items:center;gap:11px;padding:13px 2px;border-bottom:1px solid rgba(16,36,31,.07)}.tenant-row:last-child{border-bottom:0}.tenant-row i{width:8px;height:8px;border-radius:50%;background:#76b76f;flex:none}.tenant-row i.warn{background:#d69738}.tenant-row i.danger{background:#b95f55}.tenant-row>span:not(.row-actions){display:grid;gap:4px;flex:1}.tenant-row strong{font:700 .78rem/1.25 system-ui,sans-serif}.tenant-row small{color:var(--muted);font:.68rem/1.35 system-ui,sans-serif}.tenant-row em{font:600 .65rem/1 system-ui,sans-serif;font-style:normal;color:var(--muted)}.row-actions{display:flex;gap:5px;flex:none}.row-actions button{padding:7px 8px;border:1px solid rgba(16,36,31,.14);border-radius:7px;background:#fff;color:var(--night);font:700 .6rem/1 system-ui,sans-serif;cursor:pointer}.row-actions button:hover{background:var(--night);color:#fff}.row-actions button:disabled{opacity:.45;cursor:wait}.boundary{margin:16px 0 0;padding:15px 3px;border-top:1px solid rgba(16,36,31,.08)}
  .finance-tabs{display:flex;gap:6px;margin:0 0 10px;padding:4px;border-radius:9px;background:#f3f6f2}.finance-tabs a{padding:8px 10px;border-radius:7px;color:var(--muted);font:700 .63rem/1 system-ui,sans-serif}.finance-tabs a.active,.finance-tabs a:hover{background:#fff;color:var(--accent);box-shadow:0 2px 8px rgba(16,36,31,.07)}
  @media(max-width:650px){.tenant-shell{padding:28px 16px 60px}.tenant-header{align-items:start;flex-direction:column}.tenant-identity{justify-items:start}.tenant-summary{grid-template-columns:1fr}.tenant-card{padding:17px}.card-head{align-items:flex-start;flex-direction:column}.card-head-tools{width:100%;justify-content:space-between}.tenant-row{align-items:flex-start;flex-wrap:wrap}.tenant-row em{max-width:90px;text-align:right}.row-actions{width:100%;padding-left:19px}}
</style>
