---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Avtaler og eierskap — Styr.ing" activeNav="workspace">
  <main class="gov-shell">
    <section id="gov-loading" class="gov-state"><span class="section-kicker">Avtaler og eierskap</span><h1>Henter styringsregisteret.</h1><p>Kontrollerer tilgang og laster virksomhetens avtaler og eierdata.</p></section>
    <section id="gov-error" class="gov-state" hidden><span class="section-kicker">Tilgang</span><h1 id="gov-error-title">Kunne ikke åpne styringsregisteret.</h1><p id="gov-error-copy">Prøv å logge inn på nytt.</p><a class="primary" href="/login">Gå til innlogging ↗</a></section>
    <div id="gov-content" hidden>
      <header class="gov-header"><div><a id="gov-back" href="/app">← Kundeområde</a><span class="section-kicker">Avtaler og eierskap</span><h1>Beslutninger som tåler neste steg.</h1><p>Kontrakter, fullmakter, redlines, eierskap og opsjoner i ett kontrollspor. Se hva som må vurderes før noen signerer, fornyer eller tildeler.</p></div><div class="gov-identity"><strong id="gov-board">—</strong><span id="gov-role">—</span></div></header>
      <nav id="gov-tabs" class="gov-tabs" aria-label="Styringsregister"></nav>
      <section class="gov-summary"><article><small>Avtaler</small><strong id="metric-contracts">—</strong><span id="metric-contracts-note">—</span></article><article><small>Fullmakter</small><strong id="metric-mandates">—</strong><span>aktive og til vurdering</span></article><article><small>Eierskap</small><strong id="metric-equity">—</strong><span id="metric-equity-note">—</span></article></section>
      <section class="gov-card"><div class="card-head"><div><span id="gov-kicker" class="section-kicker">Styringsregister</span><h2 id="gov-title">—</h2></div><span id="gov-count">—</span></div><p id="gov-status" class="gov-status" role="status" hidden></p><div id="gov-list" class="gov-list"><p class="empty">Henter rader…</p></div></section>
      <p class="boundary">Styr.ing signerer ikke avtaler, oppdaterer ikke aksjeeierboken og sender ikke meldinger til offentlige registre automatisk. Slike steg krever riktig rolle, dokumentasjon og menneskelig godkjenning.</p>
    </div>
  </main>
</Layout>
<script is:inline>
  const qs = (s) => document.querySelector(s); const esc = (v) => String(v ?? '').replace(/[&<>'\"]/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','\"':'&quot;'}[c]));
  const tabs={summary:['Oversikt','Styringskontroll'],contracts:['Avtaler','Fornyelser og gjennomgang'],redlines:['Redlines','Klausuler til vurdering'],mandates:['Fullmakter','Hvem kan beslutte hva'],equity:['Eierskap','Cap table'],grants:['Opsjoner','Tildelinger og skatt']};
  const params=new URLSearchParams(location.search); let boardId=''; const current=params.get('view')&&tabs[params.get('view')]?params.get('view'):'summary';
  const get=async(view)=>{const r=await fetch(`/api/governance?boardId=${encodeURIComponent(boardId)}&view=${encodeURIComponent(view)}`);const d=await r.json();if(!r.ok)throw new Error(d.error||'governance_load_failed');return d;};
  const row=(title,meta,state,tone='')=>`<div class="gov-row"><i class="${tone}"></i><span><strong>${esc(title)}</strong><small>${esc(meta)}</small></span><em>${esc(state||'—')}</em></div>`;
  const render=async()=>{const d=await get(current);let rows=d.data||[];const label=tabs[current];qs('#gov-kicker').textContent=label[0];qs('#gov-title').textContent=label[1];qs('#gov-count').textContent=`${rows.length} rader`;
    if(current==='summary'){const s=d.data||{};rows=[['Avtaler',`${s.contracts?.count||0} registrerte avtaler`,`${s.contracts?.review_count||0} til gjennomgang`,s.contracts?.review_count?'warn':''],['Fullmakter',`${s.mandates?.count||0} fullmakter`,`${s.mandates?.draft_count||0} utkast`,s.mandates?.draft_count?'warn':''],['Redlines',`${s.redlines?.count||0} klausuler`,`${s.redlines?.open_count||0} åpne vurderinger`,s.redlines?.open_count?'danger':''],['Eierskap',`${s.equity?.holders||0} eiere · ${s.equity?.shares||0} aksjer`,'Modellert oversikt',''],['Opsjoner',`${s.grants?.count||0} tildelinger`,`${s.grants?.review_count||0} krever skattevurdering`,s.grants?.review_count?'warn':'']].map(x=>row(x[0],x[1],x[2],x[3]));}
    if(current==='contracts')rows=rows.map(x=>row(`${x.title} · ${x.counterparty}`,`${x.contract_type||'avtale'} · eier ${x.owner_name||'ikke satt'} · fornyelse ${x.renewal_notice_date||x.due_date||'ikke satt'}`,x.review_status||x.status,x.review_status&&x.review_status!=='approved'?'warn':''));
    if(current==='redlines')rows=rows.map(x=>row(`${x.contract_title} · ${x.clause_ref||'klausul'}`,`${x.counterparty||'motpart ikke satt'} · ${x.recommendation||'juridisk vurdering mangler'}`,x.risk_level||x.status,['critical','high'].includes(x.risk_level)?'danger':'warn'));
    if(current==='mandates')rows=rows.map(x=>row(`${x.holder_name||'Innehaver ikke satt'} · ${x.mandate_type}`,`${x.scope||'omfang ikke satt'} · gyldig til ${x.valid_until||'ikke satt'}`,x.status,x.status==='draft'?'warn':''));
    if(current==='equity')rows=rows.map(x=>row(x.holder_name,`${x.holder_type||'eier'} · klasse ${x.share_class||'—'} · ${x.shares||0} aksjer`,`${x.ownership_percent||0}%`));
    if(current==='grants')rows=rows.map(x=>row(`${x.grant_name||'Tildeling'} · ${x.holder_name||'innehaver ikke satt'}`,`${x.instrument||'instrument ikke satt'} · ${x.granted_shares||0} enheter · vesting ${x.vested_shares||0}`,`${x.status||'—'} · skatt ${x.tax_review_status||'—'}`,x.tax_review_status!=='cleared'?'warn':''));
    qs('#gov-list').innerHTML=rows.length?rows.join(''):'<p class="empty">Ingen rader i denne visningen.</p>';document.querySelectorAll('#gov-tabs a').forEach(a=>a.classList.toggle('active',a.dataset.view===current));
  };
  const load=async()=>{try{const auth=await(await fetch('/api/auth')).json();if(!auth.authenticated){location.href=`/login?next=${encodeURIComponent(location.pathname+location.search)}`;return;}const selected=(auth.boards||[]).find(x=>x.id===params.get('boardId'))||(auth.boards||[])[0];if(!selected)throw new Error('no_board');boardId=selected.id;const board=await(await fetch(`/api/board/${encodeURIComponent(boardId)}`)).json();const summary=await get('summary');qs('#gov-loading').hidden=true;qs('#gov-content').hidden=false;qs('#gov-board').textContent=board.data?.board?.name||'Virksomhet';qs('#gov-role').textContent=selected.role==='owner'?'Eier':selected.role==='editor'?'Redaktør':'Leser';qs('#gov-back').href=`/app?boardId=${encodeURIComponent(boardId)}`;qs('#metric-contracts').textContent=summary.data?.contracts?.count||0;qs('#metric-contracts-note').textContent=`${summary.data?.contracts?.review_count||0} til gjennomgang`;qs('#metric-mandates').textContent=summary.data?.mandates?.count||0;qs('#metric-equity').textContent=summary.data?.equity?.holders||0;qs('#metric-equity-note').textContent=`${summary.data?.equity?.shares||0} aksjer i registeret`;qs('#gov-tabs').innerHTML=Object.entries(tabs).map(([key,value])=>`<a data-view="${key}" href="/app/governance?boardId=${encodeURIComponent(boardId)}&view=${key}">${value[0]}</a>`).join('');await render();}catch(e){qs('#gov-loading').hidden=true;qs('#gov-error').hidden=false;qs('#gov-error-title').textContent=e.message==='no_board'?'Ingen virksomhet er koblet til kontoen.':'Styringsregisteret kunne ikke lastes.';}};load();
</script>
<style>
  .gov-shell{max-width:1040px;margin:0 auto;padding:42px 24px 88px}.gov-state{max-width:620px;margin:80px auto;text-align:center}.gov-state h1{font:500 clamp(2.5rem,6vw,4.5rem)/.95 Georgia,serif;letter-spacing:-.06em;margin:14px 0}.gov-state p,.boundary,.empty{color:var(--muted);font:.8rem/1.55 system-ui,sans-serif}.primary{display:inline-flex;margin-top:15px;padding:12px 16px;border-radius:9px;background:var(--night);color:#fff;font:700 .74rem/1 system-ui,sans-serif}.gov-header{display:flex;justify-content:space-between;align-items:end;gap:25px;margin-bottom:24px}.gov-header>a{display:block;margin-bottom:18px;color:var(--accent);font:700 .68rem/1 system-ui,sans-serif}.gov-header h1{margin:11px 0 8px;font:500 clamp(2.6rem,6vw,4.6rem)/.94 Georgia,serif;letter-spacing:-.06em}.gov-header p{margin:0;max-width:620px;color:var(--muted);font:.84rem/1.55 system-ui,sans-serif}.gov-identity{display:grid;justify-items:end;gap:7px;min-width:180px}.gov-identity strong{font:700 .78rem/1.2 system-ui,sans-serif}.gov-identity span{padding:6px 9px;border-radius:999px;background:#e8f1df;color:var(--accent);font:700 .62rem/1 system-ui,sans-serif}.gov-tabs{display:flex;gap:6px;overflow:auto;padding-bottom:7px;margin-bottom:15px}.gov-tabs a{white-space:nowrap;padding:9px 12px;border:1px solid rgba(16,36,31,.1);border-radius:9px;background:#fff;color:var(--muted);font:700 .68rem/1 system-ui,sans-serif}.gov-tabs a.active,.gov-tabs a:hover{background:var(--night);border-color:var(--night);color:#fff}.gov-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:11px;margin-bottom:15px}.gov-summary article,.gov-card{border:1px solid rgba(16,36,31,.09);border-radius:15px;background:#fff}.gov-summary article{padding:17px;min-height:105px}.gov-summary small,.gov-summary span{display:block;color:var(--muted);font:600 .67rem/1.35 system-ui,sans-serif}.gov-summary strong{display:block;margin:11px 0 5px;font:500 1.9rem/1 Georgia,serif}.gov-summary span{color:var(--accent)}.gov-card{padding:22px}.card-head{display:flex;justify-content:space-between;align-items:start;gap:15px;margin-bottom:13px}.card-head h2{margin:8px 0 0;font:500 1.5rem/1 Georgia,serif}.card-head>span{color:var(--muted);font:700 .66rem/1 system-ui,sans-serif}.gov-list{display:grid}.gov-row{display:flex;align-items:center;gap:11px;padding:13px 2px;border-bottom:1px solid rgba(16,36,31,.07)}.gov-row:last-child{border-bottom:0}.gov-row i{width:8px;height:8px;border-radius:50%;background:#76b76f;flex:none}.gov-row i.warn{background:#d69738}.gov-row i.danger{background:#b95f55}.gov-row span{display:grid;gap:4px;flex:1}.gov-row strong{font:700 .78rem/1.25 system-ui,sans-serif}.gov-row small{color:var(--muted);font:.68rem/1.35 system-ui,sans-serif}.gov-row em{font:600 .65rem/1 system-ui,sans-serif;font-style:normal;color:var(--muted);text-align:right}.boundary{margin:16px 0 0;padding:15px 3px;border-top:1px solid rgba(16,36,31,.08)}
  @media(max-width:650px){.gov-shell{padding:28px 16px 60px}.gov-header{align-items:start;flex-direction:column}.gov-identity{justify-items:start}.gov-summary{grid-template-columns:1fr}.gov-card{padding:17px}.gov-row{align-items:flex-start;flex-wrap:wrap}.gov-row em{max-width:150px}}
</style>
