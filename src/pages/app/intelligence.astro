---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Søk og assistent — Styr.ing" activeNav="workspace">
  <main class="intel-shell">
    <section id="intel-loading" class="intel-state"><span class="section-kicker">Søk og assistent</span><h1>Henter virksomhetsbildet.</h1><p>Kontrollerer tilgang til hendelser, leveranser og kildesøk.</p></section>
    <section id="intel-error" class="intel-state" hidden><span class="section-kicker">Tilgang</span><h1 id="intel-error-title">Kunne ikke åpne plattformflaten.</h1><p id="intel-error-copy">Prøv å logge inn på nytt.</p><a class="primary" href="/login">Gå til innlogging ↗</a></section>
    <div id="intel-content" hidden>
      <header class="intel-header"><div><a id="intel-back" href="/app">← Kundeområde</a><span class="section-kicker">Søk og assistent</span><h1>Finn tråden.<br /><em>Behold kilden.</em></h1><p>Spør på tvers av styre, økonomi, mennesker, kunder og drift. Treff og svar er utkast med synlig kilde — ingen agent utfører handlinger.</p></div><div class="intel-identity"><strong id="intel-board">—</strong><span id="intel-role">—</span></div></header>
      <section class="intel-grid">
        <article class="intel-card search-card"><div class="card-head"><div><span class="section-kicker">Universelt søk</span><h2>Hva leter du etter?</h2></div><span>Lesemodus</span></div><form id="search-form"><label for="search-input">Søk i virksomhetsbildet</label><div class="search-row"><input id="search-input" minlength="2" placeholder="f.eks. budsjett, risiko eller leverandør" autocomplete="off" /><button type="submit">Søk ↗</button></div></form><p id="search-status" class="status" role="status">Skriv minst to tegn.</p><div id="search-results" class="results"></div></article>
        <article class="intel-card assistant-card"><div class="card-head"><div><span class="section-kicker">Styr.assistent</span><h2>Lag et kildebasert utkast.</h2></div><span>HITL</span></div><form id="assistant-form"><label for="assistant-input">Spør arbeidsflaten</label><textarea id="assistant-input" rows="3" placeholder="Hva må styret følge opp før neste møte?"></textarea><button type="submit">Lag utkast ↗</button></form><p id="assistant-status" class="status" role="status">Svar lagres som utkast og må vurderes av en person.</p><div id="assistant-answer" class="answer" hidden></div></article>
      </section>
      <section class="intel-card event-card"><div class="card-head"><div><span class="section-kicker">Event mesh</span><h2>Integrasjoner med kontrollpunkt.</h2></div><a href="/api/events?boardId=board-1&view=summary">Åpne API ↗</a></div><div class="event-metrics"><article><small>Destinasjoner</small><strong id="event-destinations">—</strong><span>registrert</span></article><article><small>Hendelser siste 7 dager</small><strong id="event-recent">—</strong><span>kilde synlig</span></article><article><small>Leveranser i kø</small><strong id="event-queued">—</strong><span>sender ikke aktivert</span></article><article><small>Feil</small><strong id="event-failed">—</strong><span>krever oppfølging</span></article></div><p class="boundary">Styr.ing registrerer og klargjør hendelser, men sender ikke webhooks, signerer, betaler eller oppdaterer eksterne systemer før destinasjon, nøkkel, avtale og menneskelig godkjenning er på plass.</p></section>
    </div>
  </main>
</Layout>
<script is:inline>
  const qs=s=>document.querySelector(s);const esc=v=>String(v??'').replace(/[&<>'\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','\"':'&quot;'}[c]));let boardId='';
  const load=async()=>{try{const auth=await(await fetch('/api/auth')).json();if(!auth.authenticated){location.href=`/login?next=${encodeURIComponent(location.pathname)}`;return;}const p=new URLSearchParams(location.search);const selected=(auth.boards||[]).find(x=>x.id===p.get('boardId'))||(auth.boards||[])[0];if(!selected)throw Error('no_board');boardId=selected.id;const board=await(await fetch(`/api/board/${encodeURIComponent(boardId)}`)).json();const event=(await fetch(`/api/events?boardId=${encodeURIComponent(boardId)}&view=summary`)).json();const e=(await event).data||{};qs('#intel-loading').hidden=true;qs('#intel-content').hidden=false;qs('#intel-board').textContent=board.data?.board?.name||'Virksomhet';qs('#intel-role').textContent=selected.role==='owner'?'Eier':selected.role==='editor'?'Redaktør':'Leser';qs('#intel-back').href=`/app?boardId=${encodeURIComponent(boardId)}`;qs('#event-destinations').textContent=e.destinations?.count||0;qs('#event-recent').textContent=e.recent?.count||0;qs('#event-queued').textContent=e.queued?.count||0;qs('#event-failed').textContent=e.failed?.count||0;}catch(e){qs('#intel-loading').hidden=true;qs('#intel-error').hidden=false;qs('#intel-error-title').textContent=e.message==='no_board'?'Ingen virksomhet er koblet til kontoen.':'Plattformflaten kunne ikke lastes.';}};
  qs('#search-form')?.addEventListener('submit',async ev=>{ev.preventDefault();const q=qs('#search-input').value.trim();if(q.length<2){qs('#search-status').textContent='Skriv minst to tegn.';return;}qs('#search-status').textContent='Søker…';try{const r=await fetch(`/api/search?boardId=${encodeURIComponent(boardId)}&q=${encodeURIComponent(q)}`),d=await r.json();if(!r.ok)throw Error(d.error);qs('#search-status').textContent=`${d.count||0} treff · kilder er synlige`;qs('#search-results').innerHTML=(d.data||[]).map(x=>`<article class="result"><div><strong>${esc(x.title)}</strong><small>${esc(x.type)} · ${esc(x.source)}</small></div><p>${esc(x.snippet)}</p></article>`).join('')||'<p class="empty">Ingen treff.</p>';}catch{qs('#search-status').textContent='Søket er midlertidig utilgjengelig.';}});
  qs('#assistant-form')?.addEventListener('submit',async ev=>{ev.preventDefault();const q=qs('#assistant-input').value.trim();if(q.length<2){qs('#assistant-status').textContent='Skriv et litt lengre spørsmål.';return;}qs('#assistant-status').textContent='Lager utkast…';try{const r=await fetch('/api/assistant',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({boardId,question:q})}),d=await r.json();if(!r.ok)throw Error(d.error);qs('#assistant-status').textContent='Utkast lagret · menneskelig gjennomgang kreves';qs('#assistant-answer').hidden=false;qs('#assistant-answer').innerHTML=`<strong>${esc(d.answer)}</strong><small>${(d.citations||[]).length} kildehenvisninger · ${esc(d.provider)}</small>`;}catch(error){qs('#assistant-status').textContent=error.message==='write_not_authorized'?'Du har ikke rollen som kan lage utkast.':'Assistenten er midlertidig utilgjengelig.';}});load();
</script>
<style>
  .intel-shell{max-width:1160px;margin:0 auto;padding:42px 24px 88px}.intel-state{max-width:620px;margin:80px auto;text-align:center}.intel-state h1{font:500 clamp(2.5rem,6vw,4.5rem)/.95 Georgia,serif;letter-spacing:-.06em;margin:14px 0}.intel-state p,.boundary,.empty{color:var(--muted);font:.8rem/1.55 system-ui,sans-serif}.primary{display:inline-flex;margin-top:15px;padding:12px 16px;border-radius:9px;background:var(--night);color:#fff;font:700 .74rem/1 system-ui,sans-serif}.intel-header{display:flex;justify-content:space-between;align-items:end;gap:25px;margin-bottom:24px}.intel-header>a{display:block;margin-bottom:18px;color:var(--accent);font:700 .68rem/1 system-ui,sans-serif}.intel-header h1{margin:11px 0 8px;font:500 clamp(2.6rem,6vw,4.6rem)/.94 Georgia,serif;letter-spacing:-.06em}.intel-header h1 em{color:var(--accent);font-style:normal}.intel-header p{margin:0;max-width:680px;color:var(--muted);font:.84rem/1.55 system-ui,sans-serif}.intel-identity{display:grid;justify-items:end;gap:7px;min-width:180px}.intel-identity strong{font:700 .78rem/1.2 system-ui,sans-serif}.intel-identity span{padding:6px 9px;border-radius:999px;background:#e8f1df;color:var(--accent);font:700 .62rem/1 system-ui,sans-serif}.intel-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:15px;margin-bottom:15px}.intel-card{border:1px solid rgba(16,36,31,.09);border-radius:15px;background:#fff;padding:22px}.search-card{background:#f4f8f1}.assistant-card{background:#10241f;color:#fff}.assistant-card .section-kicker,.assistant-card .card-head>span{color:#bfe29c}.card-head{display:flex;justify-content:space-between;align-items:start;gap:15px;margin-bottom:15px}.card-head h2{margin:8px 0 0;font:500 1.5rem/1 Georgia,serif}.card-head>span{color:var(--muted);font:700 .65rem/1 system-ui,sans-serif}.intel-card label{display:block;margin-bottom:7px;color:var(--muted);font:700 .67rem/1 system-ui,sans-serif;text-transform:uppercase}.assistant-card label{color:#b9d5bf}.search-row{display:flex;gap:8px}.search-row input,.assistant-card textarea{min-width:0;flex:1;padding:12px;border:1px solid rgba(16,36,31,.14);border-radius:9px;background:#fff;color:var(--ink);font:.78rem/1.3 system-ui,sans-serif}.search-row button,.assistant-card button{border:0;border-radius:9px;padding:0 14px;background:var(--night);color:#fff;font:700 .7rem/1 system-ui,sans-serif;cursor:pointer}.assistant-card textarea{display:block;width:100%;resize:vertical;margin-bottom:8px;background:#1c382f;color:#fff;border-color:rgba(255,255,255,.18)}.assistant-card button{padding:11px 14px;background:#d5fb98;color:#16352b}.status{color:var(--muted);font:.68rem/1.4 system-ui,sans-serif}.assistant-card .status{color:#b9d5bf}.results{display:grid;gap:7px;margin-top:12px;max-height:300px;overflow:auto}.result{padding:10px 11px;border:1px solid rgba(16,36,31,.09);border-radius:9px;background:#fff}.result strong{display:block;font:700 .75rem/1.2 system-ui,sans-serif}.result small,.result p{display:block;margin:3px 0 0;color:var(--muted);font:.65rem/1.35 system-ui,sans-serif}.answer{margin-top:13px;padding:12px;border-radius:9px;background:#1c382f}.answer strong,.answer small{display:block;font:.72rem/1.45 system-ui,sans-serif}.answer small{margin-top:8px;color:#b9d5bf;font-size:.63rem}.event-card{margin-bottom:15px}.event-metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.event-metrics article{padding:14px;border-radius:10px;background:#f5f8f3}.event-metrics small,.event-metrics span{display:block;color:var(--muted);font:600 .63rem/1.3 system-ui,sans-serif}.event-metrics strong{display:block;margin:9px 0 4px;font:500 1.6rem/1 Georgia,serif}.event-metrics span{color:var(--accent)}.boundary{margin:16px 0 0;padding:15px 3px;border-top:1px solid rgba(16,36,31,.08)}
  @media(max-width:760px){.intel-shell{padding:28px 16px 60px}.intel-header{align-items:start;flex-direction:column}.intel-identity{justify-items:start}.intel-grid{grid-template-columns:1fr}.event-metrics{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:460px){.intel-card{padding:17px}.search-row{flex-direction:column}.search-row button{padding:11px}.event-metrics{grid-template-columns:1fr}}
</style>
