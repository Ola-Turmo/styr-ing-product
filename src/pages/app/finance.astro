---
import Layout from '../../layouts/Layout.astro';
import AccountingReportsQuick from '../../components/AccountingReportsQuick.astro';
import AnnualAccountsQuick from '../../components/AnnualAccountsQuick.astro';
import AssetRegisterQuick from '../../components/AssetRegisterQuick.astro';
import BankReconciliationQuick from '../../components/BankReconciliationQuick.astro';
import CardLedgerQuick from '../../components/CardLedgerQuick.astro';
import CreditNotePostingQuick from '../../components/CreditNotePostingQuick.astro';
import EHFInboxQuick from '../../components/EHFInboxQuick.astro';
import FxLedgerQuick from '../../components/FxLedgerQuick.astro';
import IntercompanyQuick from '../../components/IntercompanyQuick.astro';
import ManualVoucherQuick from '../../components/ManualVoucherQuick.astro';
import PayrollQuick from '../../components/PayrollQuick.astro';
import PeriodCloseQuick from '../../components/PeriodCloseQuick.astro';
import PostingQueueQuick from '../../components/PostingQueueQuick.astro';
import ReceivablesPayablesQuick from '../../components/ReceivablesPayablesQuick.astro';
import SalesInvoiceQuick from '../../components/SalesInvoiceQuick.astro';
import StatutoryNotesQuick from '../../components/StatutoryNotesQuick.astro';
import SupplierInvoiceQuick from '../../components/SupplierInvoiceQuick.astro';
import VatPeriodQuick from '../../components/VatPeriodQuick.astro';
---

<Layout title="Regnskap — Styr.ing" activeNav="finance">
  <div class="app-finance-shell">
    <section id="finance-loading" class="page-state" aria-live="polite"><span class="section-kicker">Regnskap</span><h1>Henter virksomheten din.</h1><p>Kontrollerer tilgang og klargjør regnskapsflaten.</p></section>
    <section id="finance-error" class="page-state" hidden><span class="section-kicker">Tilgang</span><h1 id="finance-error-title">Kunne ikke åpne regnskapet.</h1><p id="finance-error-copy">Prøv å logge inn på nytt.</p><a class="primary-link" href="/login?next=%2Fapp%2Ffinance">Gå til innlogging ↗</a></section>
    <div id="finance-content" hidden>
      <header class="app-finance-header"><div><a id="finance-back" class="back-link" href="/app">← Kundeområde</a><span class="section-kicker">Regnskap og økonomi</span><h1>Det viktigste først.</h1><p>Før bilag, send faktura, avstem banken og gjør perioden klar. Kontrollerte særtilfeller ligger samlet lenger ned.</p></div><div class="company-identity"><label for="company-select">Virksomhet</label><select id="company-select" aria-label="Velg virksomhet"></select><span id="finance-role">—</span></div></header>
      <nav class="finance-quick-nav" aria-label="Hurtigmeny for regnskap"><a href="#overview">Oversikt</a><a href="#daily-workflows">Daglig regnskap</a><a href="#reports">Rapporter</a><a href="#controlled-workflows">Flere kontroller</a></nav>
      <section id="overview" class="overview" aria-labelledby="overview-title"><div class="overview-copy"><span class="section-kicker">Status nå</span><h2 id="overview-title">Hva trenger oppmerksomhet?</h2><p id="overview-updated">Henter oppdaterte tall…</p></div><div class="overview-grid"><article><small>Bilag</small><strong id="metric-vouchers">—</strong><span>registrert</span></article><article><small>Åpne bankposter</small><strong id="metric-bank">—</strong><span>til avstemming</span></article><article><small>Leverandøravvik</small><strong id="metric-procurement">—</strong><span>må kontrolleres</span></article><article><small>Lønnskontroller</small><strong id="metric-payroll">—</strong><span>venter</span></article></div><p id="overview-status" class="overview-status" role="status" aria-live="polite"></p></section>
      <section id="daily-workflows" class="workflow-section" aria-labelledby="daily-workflows-title"><div class="workflow-section-head"><div><span class="section-kicker">Start her</span><h2 id="daily-workflows-title">Det du gjør gjennom måneden.</h2><p>Bilag, kunder, leverandører, bank, åpne poster, MVA og lønn i en naturlig arbeidsrekkefølge.</p></div><span class="workflow-badge">Regnskapskjerne</span></div><ManualVoucherQuick /><SalesInvoiceQuick /><SupplierInvoiceQuick /><BankReconciliationQuick /><ReceivablesPayablesQuick /><VatPeriodQuick /><PayrollQuick /></section>
      <section id="reports" class="workflow-section reports-section" aria-labelledby="reports-title"><div class="workflow-section-head"><div><span class="section-kicker">Oppfølging</span><h2 id="reports-title">Se og forklar det som er bokført.</h2><p>Resultat, balanse, saldobalanse og hovedbok bygger på posterte bilagslinjer.</p></div></div><AccountingReportsQuick /></section>
      <details id="controlled-workflows" class="controlled-workflows"><summary><span><span class="section-kicker">Ved behov</span><strong>Flere regnskapskontroller</strong><small>Eiendeler, bokføringsforslag, kreditnota, EHF, konsern, kort, valuta og årsoppgjør.</small></span><b>Åpne</b></summary><div class="controlled-workflows-body"><AssetRegisterQuick /><PostingQueueQuick /><CreditNotePostingQuick /><EHFInboxQuick /><IntercompanyQuick /><CardLedgerQuick /><FxLedgerQuick /><PeriodCloseQuick /><StatutoryNotesQuick /><AnnualAccountsQuick /></div></details>
      <p class="system-boundary">Eksterne bank-, betalings-, EHF- og myndighetssteg kjøres bare når virksomheten har en godkjent og konfigurert leverandøravtale. Interne utkast og kontrollspor er tydelig skilt fra ekstern innsending.</p>
    </div>
  </div>
</Layout>
<script is:inline>
  const financeQuery = new URLSearchParams(location.search); const financeEl = selector => document.querySelector(selector); const financeNumber = value => Number(value || 0).toLocaleString('nb-NO');
  const showFinanceError = (title, copy) => { financeEl('#finance-loading').hidden = true; financeEl('#finance-content').hidden = true; financeEl('#finance-error').hidden = false; financeEl('#finance-error-title').textContent = title; financeEl('#finance-error-copy').textContent = copy; };
  const financeJson = async url => { const response = await fetch(url, { headers: { accept: 'application/json' } }); const payload = await response.json().catch(() => ({})); if (!response.ok) throw new Error(payload.error || `HTTP ${response.status}`); return payload; };
  const loadFinanceOverview = async boardId => { const encoded = encodeURIComponent(boardId); const [finance, bank, procurement, payroll] = await Promise.all([financeJson(`/api/finance?boardId=${encoded}&view=summary`), financeJson(`/api/bank?boardId=${encoded}&view=summary`), financeJson(`/api/procurement?boardId=${encoded}&view=summary`), financeJson(`/api/payroll?boardId=${encoded}&view=summary`)]); const financeData=finance.data||{}, bankData=bank.data||{}, procurementData=procurement.data||{}, payrollData=payroll.data||{}; financeEl('#metric-vouchers').textContent=financeNumber(financeData.vouchers?.count??financeData.voucherCount); financeEl('#metric-bank').textContent=financeNumber(bankData.transactions?.count??bankData.openTransactions); financeEl('#metric-procurement').textContent=financeNumber(procurementData.exceptions?.count??procurementData.exceptionCount); financeEl('#metric-payroll').textContent=financeNumber(payrollData.pending??payrollData.checks?.pending); financeEl('#overview-updated').textContent=`Oppdatert ${new Date().toLocaleTimeString('nb-NO',{hour:'2-digit',minute:'2-digit'})}.`; const attention=Number(bankData.transactions?.count||0)+Number(procurementData.exceptions?.count||0)+Number(payrollData.pending||payrollData.checks?.pending||0); financeEl('#overview-status').textContent=attention?`${financeNumber(attention)} kontrollpunkter er synlige i arbeidsflytene under.`:'Ingen åpne kontrollpunkter i oversikten.'; };
  const startFinance = async () => { try { const auth=await financeJson('/api/auth'); if(!auth.authenticated){ location.replace(`/login?next=${encodeURIComponent(location.pathname+location.search)}`); return; } const boards=Array.isArray(auth.boards)?auth.boards:[]; if(!boards.length){showFinanceError('Ingen virksomhet er tilgjengelig.','Be en administrator invitere deg til virksomheten.');return;} const requested=financeQuery.get('boardId'); const selected=boards.find(board=>board.id===requested)||boards[0]; const select=financeEl('#company-select'); select.innerHTML=boards.map(board=>`<option value="${String(board.id).replace(/["&<>]/g,'')}">${String(board.name||'Virksomhet').replace(/[<>&]/g,'')}</option>`).join(''); select.value=selected.id; select.addEventListener('change',()=>{const next=new URL(location.href);next.searchParams.set('boardId',select.value);location.href=next.toString();}); financeEl('#finance-role').textContent=selected.role==='owner'?'Eier':selected.role==='editor'?'Regnskapsbruker':'Lesetilgang'; financeEl('#finance-back').href=`/app?boardId=${encodeURIComponent(selected.id)}`; if(requested!==selected.id)history.replaceState({},'',`/app/finance?boardId=${encodeURIComponent(selected.id)}`); financeEl('#finance-loading').hidden=true; financeEl('#finance-content').hidden=false; await loadFinanceOverview(selected.id); } catch(error){showFinanceError('Kunne ikke åpne regnskapet.',error instanceof Error?error.message:'Prøv igjen om litt.');} }; startFinance();
</script>
<style>
  .app-finance-shell{max-width:1180px;margin:0 auto;padding:42px 24px 80px}.page-state{max-width:620px;margin:70px auto;text-align:center}.page-state h1{margin:14px 0;font:500 clamp(2.5rem,6vw,4.5rem)/.95 Georgia,serif;letter-spacing:-.06em}.page-state p,.system-boundary{color:var(--muted);font:.82rem/1.55 system-ui,sans-serif}.primary-link{display:inline-flex;margin-top:16px;padding:12px 16px;border-radius:9px;background:var(--night);color:#fff;font:700 .74rem/1 system-ui,sans-serif}.app-finance-header{display:flex;justify-content:space-between;align-items:end;gap:32px;margin-bottom:22px}.back-link{display:block;margin-bottom:18px;font:700 .68rem/1 system-ui,sans-serif}.app-finance-header h1{margin:10px 0;font:500 clamp(2.8rem,6vw,4.8rem)/.92 Georgia,serif;letter-spacing:-.065em}.app-finance-header p{max-width:680px;color:var(--muted);font:.86rem/1.58 system-ui,sans-serif}.section-kicker{font:700 .66rem/1 system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:var(--accent)}.company-identity{min-width:220px;padding:14px;border:1px solid rgba(16,36,31,.1);border-radius:13px;background:#fff}.company-identity label,.company-identity span{display:block;color:var(--muted);font:700 .62rem/1.25 system-ui,sans-serif}.company-identity select{width:100%;margin:7px 0;padding:9px;border:1px solid rgba(16,36,31,.14);border-radius:8px;background:#fafcf9;color:var(--ink);font:700 .74rem/1 system-ui,sans-serif}.finance-quick-nav{position:sticky;top:62px;z-index:5;display:flex;gap:7px;overflow:auto;margin-bottom:22px;padding:10px 0;background:var(--paper);border-bottom:1px solid rgba(16,36,31,.1)}.finance-quick-nav a{white-space:nowrap;padding:9px 12px;border:1px solid rgba(16,36,31,.11);border-radius:999px;background:#fff;color:var(--muted);font:700 .68rem/1 system-ui,sans-serif}.finance-quick-nav a:hover{background:var(--night);color:#fff}.overview{margin-bottom:22px;padding:24px;border-radius:20px;background:linear-gradient(125deg,#10241f,#1f5a46);color:#fff}.overview-copy{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap}.overview-copy .section-kicker{color:#d5fb98}.overview h2{font:500 1.8rem/1 Georgia,serif}.overview-copy p{margin-left:auto;color:rgba(255,255,255,.65);font:.7rem/1 system-ui,sans-serif}.overview-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:20px}.overview-grid article{padding:15px;border:1px solid rgba(255,255,255,.12);border-radius:12px;background:rgba(255,255,255,.08)}.overview-grid small,.overview-grid span{display:block;color:rgba(255,255,255,.68);font:600 .62rem/1.3 system-ui,sans-serif}.overview-grid strong{display:block;margin:8px 0 5px;font:500 1.9rem/1 Georgia,serif;color:#e7ffc5}.overview-status{margin:14px 0 0;color:#e7ffc5;font:700 .7rem/1.4 system-ui,sans-serif}.workflow-section{margin-bottom:22px;padding:22px;border:1px solid rgba(16,36,31,.08);border-radius:20px;background:#f7faf6}.workflow-section-head{display:flex;justify-content:space-between;align-items:start;gap:18px;padding:2px 5px}.workflow-section-head h2{margin:9px 0 7px;font:500 clamp(1.9rem,3vw,2.6rem)/1 Georgia,serif}.workflow-section-head p{max-width:700px;color:var(--muted);font:.8rem/1.55 system-ui,sans-serif}.workflow-badge{padding:8px 10px;border-radius:999px;background:#dff2d2;color:#27643f;font:700 .62rem/1 system-ui,sans-serif;white-space:nowrap}.workflow-section>*:not(.workflow-section-head),.controlled-workflows-body>section{margin-left:0;margin-right:0}.reports-section{background:#fff}.controlled-workflows{margin-bottom:22px;border:1px solid rgba(16,36,31,.1);border-radius:20px;background:#fff;overflow:hidden}.controlled-workflows>summary{display:flex;justify-content:space-between;align-items:center;gap:18px;padding:24px;cursor:pointer;list-style:none}.controlled-workflows>summary::-webkit-details-marker{display:none}.controlled-workflows>summary strong,.controlled-workflows>summary small{display:block}.controlled-workflows>summary strong{margin-top:8px;font:500 1.75rem/1 Georgia,serif}.controlled-workflows>summary small{margin-top:8px;color:var(--muted);font:.76rem/1.45 system-ui,sans-serif}.controlled-workflows>summary>b{padding:9px 13px;border-radius:8px;background:var(--night);color:#fff;font:700 .68rem/1 system-ui,sans-serif}.controlled-workflows[open]>summary{background:#f3f7f1;border-bottom:1px solid rgba(16,36,31,.1)}.controlled-workflows-body{padding:2px 22px}.system-boundary{padding-top:17px;border-top:1px solid rgba(16,36,31,.1)}@media(max-width:760px){.app-finance-shell{padding:28px 15px 60px}.app-finance-header{align-items:start;flex-direction:column}.company-identity{width:100%}.finance-quick-nav{top:58px}.overview-copy{display:block}.overview-copy p{margin:10px 0 0}.overview-grid{grid-template-columns:repeat(2,1fr)}.workflow-section{padding:16px}.workflow-section-head{display:block}.workflow-badge{display:inline-flex;margin-top:12px}.controlled-workflows>summary{padding:20px 16px}.controlled-workflows-body{padding:2px 14px}}@media(max-width:460px){.overview-grid{grid-template-columns:1fr}}
</style>
