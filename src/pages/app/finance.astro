---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Økonomi og flyt — Styr.ing" activeNav="workspace">
  <main class="finance-shell">
    <section id="finance-loading" class="finance-state"><span class="section-kicker">Økonomi og flyt</span><h1>Henter kontrollsporet.</h1><p>Kontrollerer tilgang og laster eiendeler, kort, inntekter og innkjøp.</p></section>
    <section id="finance-error" class="finance-state" hidden><span class="section-kicker">Tilgang</span><h1 id="finance-error-title">Kunne ikke åpne økonomiflaten.</h1><p id="finance-error-copy">Prøv å logge inn på nytt.</p><a class="primary" href="/login">Gå til innlogging ↗</a></section>
    <div id="finance-content" hidden>
      <header class="finance-header"><div><a id="finance-back" href="/app">← Kundeområde</a><span class="section-kicker">Regnskap og økonomi</span><h1>Fra kilde til kontroll.</h1><p>Bilag, faktura, bankgrunnlag, lønn og innkjøp samlet i ett spor — med tydelig menneskelig godkjenning før bokføring eller eksterne steg.</p></div><div class="finance-identity"><strong id="finance-board">—</strong><span id="finance-role">—</span></div></header>
      <nav id="finance-tabs" class="finance-tabs" aria-label="Økonomi-visninger"></nav>
      <section class="finance-summary"><article><small>Eiendeler</small><strong id="metric-assets">—</strong><span>aktive registrerte</span></article><article><small>Bankgrunnlag</small><strong id="metric-bank">—</strong><span>åpne transaksjoner</span></article><article><small>Innkjøp</small><strong id="metric-orders">—</strong><span>åpne ordre</span></article><article><small>Inntekt</small><strong id="metric-revenue">—</strong><span>aktive kontrakter</span></article></section>
      <section class="finance-card"><div class="card-head"><div><span id="finance-kicker" class="section-kicker">Kontrollspor</span><h2 id="finance-title">—</h2></div><span id="finance-count">—</span></div><div id="finance-list" class="finance-list"><p class="empty">Henter data…</p></div></section>
      <p class="boundary">Styr.ing bokfører ikke automatisk, belaster ikke kort, sender ikke bestillinger og kobler ikke til bank eller betalingsleverandør uten konfigurert avtale. Godkjenning, dokumentasjon og leverandørsteg må fortsatt gjøres av riktig person.</p>
    </div>
  </main>
</Layout>
<script is:inline>
  const qs=s=>document.querySelector(s); const esc=v=>String(v??'').replace(/[&<>'\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','\"':'&quot;'}[c]));
  const tabs={summary:['Oversikt','Økonomisk kontroll'],bank:['Bank','Import og avstemming'],assets:['Eiendeler','Anlegg og avskrivning'],depreciation:['Avskrivning','Poster til godkjenning'],cards:['Firmakort','Kort og bilag'],transactions:['Transaksjoner','Kvitteringer og avstemming'],contracts:['Inntekter','Kontrakter'],obligations:['Ytelser','Leveranseforpliktelser'],schedule:['Plan','Inntektsplan'],orders:['Ordre','Innkjøpsordre'],receipts:['Mottak','Varemottak'],invoices:['Leverandørfaktura','Match og avvik']};
  const source={assets:['/api/assets',['summary','assets','depreciation']],cards:['/api/cards',['summary','cards','transactions']],revenue:['/api/revenue',['summary','contracts','obligations','schedule']],procurement:['/api/procurement',['summary','orders','receipts','invoices']],bank:['/api/bank',['summary','accounts','transactions','suggestions']]};
  const params=new URLSearchParams(location.search); let boardId=''; let current=params.get('view')&&tabs[params.get('view')]?params.get('view'):'summary';
  const apiView=v=>v==='bank'?['bank','summary']:v==='assets'||v==='depreciation'?['assets',v]:v==='cards'||v==='transactions'?['cards',v]:v==='contracts'||v==='obligations'||v==='schedule'?['revenue',v]:v==='orders'||v==='receipts'||v==='invoices'?['procurement',v]:['assets','summary'];
  const get=async(v)=>{const [key,view]=apiView(v);const r=await fetch(`${source[key][0]}?boardId=${encodeURIComponent(boardId)}&view=${view}`);const d=await r.json();if(!r.ok)throw new Error(d.error||'finance_load_failed');return d;};
  const bankRows=data=>Array.isArray(data)?data.map(x=>row(`${x.transaction_date||'Dato'} · ${x.description||'Transaksjon'}`,`${x.account_name||'Konto'} · ${x.external_reference||'referanse mangler'}`,x.status==='suggested'?'Matchforslag':x.status,x.status==='suggested'?'warn':'')):[];
  const row=(title,meta,state,tone='')=>`<div class="finance-row"><i class="${tone}"></i><span><strong>${esc(title)}</strong><small>${esc(meta)}</small></span><em>${esc(state||'—')}</em></div>`;
  const listRows=(view,data)=>{if(!Array.isArray(data))return[]; if(view==='assets')return data.map(x=>row(`${x.asset_number||'Eiendel'} · ${x.name||''}`,`${x.category||'kategori ikke satt'} · kost ${x.acquisition_cost_minor||0} øre`,x.status)); if(view==='depreciation')return data.map(x=>row(`${x.asset_number||'Eiendel'} · ${x.period||'periode'}`,`${x.name||''} · ${x.amount_minor||0} øre · ${x.ledger_type||'bok'}`,x.status,x.status!=='approved'?'warn':'')); if(view==='cards')return data.map(x=>row(`${x.card_name||'Kort'} · ${x.holder_name||'innehaver ikke satt'}`,`${x.last_four||'••••'} · ${x.status||'status ikke satt'}`,x.status)); if(view==='transactions')return data.map(x=>row(`${x.merchant_name||'Transaksjon'} · ${x.amount_minor||0} øre`,`${x.transaction_date||'dato ikke satt'} · ${x.holder_name||'innehaver ikke satt'}`,x.status,x.status==='needs_receipt'?'warn':'')); if(view==='contracts')return data.map(x=>row(`${x.contract_number||'Kontrakt'} · ${x.title||''}`,`${x.company_name||'kunde ikke satt'} · ${x.start_date||'dato ikke satt'}`,x.status)); if(view==='obligations')return data.map(x=>row(`${x.contract_number||'Kontrakt'} · ${x.description||'ytelse'}`,`allokert ${x.allocated_minor||0} øre`,x.status)); if(view==='schedule')return data.map(x=>row(`${x.contract_number||'Kontrakt'} · ${x.period||'periode'}`,`${x.obligation_description||'ytelse ikke satt'} · ${x.planned_minor||0} øre`,x.status,x.status!=='posted'?'warn':'')); if(view==='orders')return data.map(x=>row(`${x.order_number||'Ordre'} · ${x.supplier_name||'leverandør ikke satt'}`,`${x.created_at||'dato ikke satt'} · ${x.total_minor||0} øre`,x.status,x.status==='pending_approval'?'warn':'')); if(view==='receipts')return data.map(x=>row(`${x.order_number||'Ordre'} · ${x.supplier_name||''}`,`${x.received_date||'dato ikke satt'} · ${x.quantity||0} enheter`,x.status)); if(view==='invoices')return data.map(x=>row(`${x.invoice_number||'Faktura'} · ${x.order_number||'ordre ikke satt'}`,`${x.due_date||'forfall ikke satt'} · ${x.amount_minor||0} øre`,x.match_status||x.status,x.match_status==='exception'?'warn':'')); return[];};
  const render=async()=>{const d=await get(current);const label=tabs[current];qs('#finance-kicker').textContent=label[0];qs('#finance-title').textContent=label[1];let rows=[];if(current==='bank')rows=bankRows(d.data);else if(current==='summary'){const [a,c,r,p,b]=await Promise.all([get('summary'),(async()=>{const q=await fetch(`/api/cards?boardId=${encodeURIComponent(boardId)}&view=summary`);return q.json()})(),(async()=>{const q=await fetch(`/api/revenue?boardId=${encodeURIComponent(boardId)}&view=summary`);return q.json()})(),(async()=>{const q=await fetch(`/api/procurement?boardId=${encodeURIComponent(boardId)}&view=summary`);return q.json()})(),(async()=>{const q=await fetch(`/api/bank?boardId=${encodeURIComponent(boardId)}&view=summary`);return q.json()})()]);const s=a.data||{};qs('#finance-title').textContent='Økonomisk kontroll';qs('#metric-assets').textContent=s.assets?.count||0;qs('#metric-bank').textContent=b.data?.transactions?.count||0;qs('#metric-orders').textContent=p.data?.orders?.count||0;qs('#metric-revenue').textContent=r.data?.contracts?.count||0;rows=[row('Eiendeler',`${s.assets?.count||0} aktive · ${s.review?.count||0} avskrivninger til vurdering`,s.review?.count?'Krever vurdering':'Kontrollert',s.review?.count?'warn':''),row('Bankgrunnlag',`${b.data?.suggestions?.count||0} matchforslag`,b.data?.suggestions?.count?'Til godkjenning':'Ingen åpne steg',b.data?.suggestions?.count?'warn':''),row('Inntektsplan',`${r.data?.review?.count||0} linjer i plan/review`,r.data?.review?.count?'Menneskelig godkjenning':'Kontrollert',r.data?.review?.count?'warn':''),row('Innkjøp',`${p.data?.exceptions?.count||0} fakturaavvik`,p.data?.exceptions?.count?'Avvik':'Kontrollert',p.data?.exceptions?.count?'warn':'')];}else rows=listRows(current,d.data);qs('#finance-count').textContent=`${rows.length} rader`;qs('#finance-list').innerHTML=rows.length?rows.join(''):'<p class="empty">Ingen rader i denne visningen.</p>';document.querySelectorAll('#finance-tabs a').forEach(a=>a.classList.toggle('active',a.dataset.view===current));};
  const load=async()=>{try{const auth=await(await fetch('/api/auth')).json();if(!auth.authenticated){location.href=`/login?next=${encodeURIComponent(location.pathname+location.search)}`;return;}const selected=(auth.boards||[]).find(x=>x.id===params.get('boardId'))||(auth.boards||[])[0];if(!selected)throw new Error('no_board');boardId=selected.id;const board=await(await fetch(`/api/board/${encodeURIComponent(boardId)}`)).json();qs('#finance-loading').hidden=true;qs('#finance-content').hidden=false;qs('#finance-board').textContent=board.data?.board?.name||'Virksomhet';qs('#finance-role').textContent=selected.role==='owner'?'Eier':selected.role==='editor'?'Redaktør':'Leser';qs('#finance-back').href=`/app?boardId=${encodeURIComponent(boardId)}`;qs('#finance-tabs').innerHTML=Object.entries(tabs).map(([k,v])=>`<a data-view="${k}" href="/app/finance?boardId=${encodeURIComponent(boardId)}&view=${k}">${v[0]}</a>`).join('');await render();}catch(e){qs('#finance-loading').hidden=true;qs('#finance-error').hidden=false;qs('#finance-error-title').textContent=e.message==='no_board'?'Ingen virksomhet er koblet til kontoen.':'Økonomiflaten kunne ikke lastes.';}};load();
</script>
<style>
  .finance-shell{max-width:1160px;margin:0 auto;padding:42px 24px 88px}.finance-state{max-width:620px;margin:80px auto;text-align:center}.finance-state h1{font:500 clamp(2.5rem,6vw,4.5rem)/.95 Georgia,serif;letter-spacing:-.06em;margin:14px 0}.finance-state p,.boundary,.empty{color:var(--muted);font:.8rem/1.55 system-ui,sans-serif}.primary{display:inline-flex;margin-top:15px;padding:12px 16px;border-radius:9px;background:var(--night);color:#fff;font:700 .74rem/1 system-ui,sans-serif}.finance-header{display:flex;justify-content:space-between;align-items:end;gap:25px;margin-bottom:24px}.finance-header>a{display:block;margin-bottom:18px;color:var(--accent);font:700 .68rem/1 system-ui,sans-serif}.finance-header h1{margin:11px 0 8px;font:500 clamp(2.6rem,6vw,4.6rem)/.94 Georgia,serif;letter-spacing:-.06em}.finance-header p{margin:0;max-width:680px;color:var(--muted);font:.84rem/1.55 system-ui,sans-serif}.finance-identity{display:grid;justify-items:end;gap:7px;min-width:180px}.finance-identity strong{font:700 .78rem/1.2 system-ui,sans-serif}.finance-identity span{padding:6px 9px;border-radius:999px;background:#e8f1df;color:var(--accent);font:700 .62rem/1 system-ui,sans-serif}.finance-tabs{display:flex;gap:6px;overflow:auto;padding-bottom:7px;margin-bottom:15px}.finance-tabs a{white-space:nowrap;padding:9px 12px;border:1px solid rgba(16,36,31,.1);border-radius:9px;background:#fff;color:var(--muted);font:700 .68rem/1 system-ui,sans-serif}.finance-tabs a.active,.finance-tabs a:hover{background:var(--night);border-color:var(--night);color:#fff}.finance-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:11px;margin-bottom:15px}.finance-summary article,.finance-card{border:1px solid rgba(16,36,31,.09);border-radius:15px;background:#fff}.finance-summary article{padding:17px;min-height:105px}.finance-summary small,.finance-summary span{display:block;color:var(--muted);font:600 .67rem/1.35 system-ui,sans-serif}.finance-summary strong{display:block;margin:11px 0 5px;font:500 1.9rem/1 Georgia,serif}.finance-summary span{color:var(--accent)}.finance-card{padding:22px}.card-head{display:flex;justify-content:space-between;align-items:start;gap:15px;margin-bottom:13px}.card-head h2{margin:8px 0 0;font:500 1.5rem/1 Georgia,serif}.card-head>span{color:var(--muted);font:700 .66rem/1 system-ui,sans-serif}.finance-list{display:grid}.finance-row{display:flex;align-items:center;gap:11px;padding:13px 2px;border-bottom:1px solid rgba(16,36,31,.07)}.finance-row:last-child{border-bottom:0}.finance-row i{width:8px;height:8px;border-radius:50%;background:#76b76f;flex:none}.finance-row i.warn{background:#d69738}.finance-row span{display:grid;gap:4px;flex:1}.finance-row strong{font:700 .78rem/1.25 system-ui,sans-serif}.finance-row small{color:var(--muted);font:.68rem/1.35 system-ui,sans-serif}.finance-row em{font:600 .65rem/1 system-ui,sans-serif;font-style:normal;color:var(--muted);text-align:right}.boundary{margin:16px 0 0;padding:15px 3px;border-top:1px solid rgba(16,36,31,.08)}
  @media(max-width:760px){.finance-shell{padding:28px 16px 60px}.finance-header{align-items:start;flex-direction:column}.finance-identity{justify-items:start}.finance-summary{grid-template-columns:repeat(2,1fr)}.finance-card{padding:17px}.finance-row{align-items:flex-start;flex-wrap:wrap}.finance-row em{max-width:150px}}
  @media(max-width:480px){.finance-summary{grid-template-columns:1fr}}
</style>
