---
import Layout from '../../layouts/Layout.astro';
import AccountingReportsQuick from '../../components/AccountingReportsQuick.astro';
import AnnualAccountsQuick from '../../components/AnnualAccountsQuick.astro';
import AccountingSetupQuick from '../../components/AccountingSetupQuick.astro';
import AssetRegisterQuick from '../../components/AssetRegisterQuick.astro';
import BankReconciliationQuick from '../../components/BankReconciliationQuick.astro';
import CardLedgerQuick from '../../components/CardLedgerQuick.astro';
import CreditNotePostingQuick from '../../components/CreditNotePostingQuick.astro';
import EHFInboxQuick from '../../components/EHFInboxQuick.astro';
import FxLedgerQuick from '../../components/FxLedgerQuick.astro';
import IntercompanyQuick from '../../components/IntercompanyQuick.astro';
import ManualVoucherQuick from '../../components/ManualVoucherQuick.astro';
import PayrollQuick from '../../components/PayrollQuick.astro';
import PeriodCloseQuick from '../../components/PeriodCloseQuick.astro';
import PostingQueueQuick from '../../components/PostingQueueQuick.astro';
import ReceivablesPayablesQuick from '../../components/ReceivablesPayablesQuick.astro';
import CollectionReminderQuick from '../../components/CollectionReminderQuick.astro';
import RecurringInvoiceQuick from '../../components/RecurringInvoiceQuick.astro';
import SalesInvoiceQuick from '../../components/SalesInvoiceQuick.astro';
import StatutoryNotesQuick from '../../components/StatutoryNotesQuick.astro';
import SupplierInvoiceQuick from '../../components/SupplierInvoiceQuick.astro';
import SupplierCreditNoteQuick from '../../components/SupplierCreditNoteQuick.astro';
import ProductCatalogQuick from '../../components/ProductCatalogQuick.astro';
import VatPeriodQuick from '../../components/VatPeriodQuick.astro';
---

<Layout title="Regnskap — Styr.ing" activeNav="finance">
  <div class="app-finance-shell">
    <section id="finance-loading" class="page-state" aria-live="polite"><span class="section-kicker">Regnskap</span><h1>Henter virksomheten din.</h1><p>Kontrollerer tilgang og klargjør regnskapsflaten.</p></section>
    <section id="finance-error" class="page-state" hidden><span class="section-kicker">Tilgang</span><h1 id="finance-error-title">Kunne ikke åpne regnskapet.</h1><p id="finance-error-copy">Prøv å logge inn på nytt.</p><a class="primary-link" href="/login?next=%2Fapp%2Ffinance">Gå til innlogging ↗</a></section>
    <div id="finance-content" hidden>
      <header class="app-finance-header"><div><a id="finance-back" class="back-link" href="/app">← Kundeområde</a><span class="section-kicker">Regnskap og økonomi</span><h1>Det viktigste først.</h1><p>Før bilag, lag faktura, avstem banken og gjør perioden klar. Kontrollerte særtilfeller ligger samlet lenger ned.</p></div><div class="company-identity"><label for="company-select">Virksomhet</label><select id="company-select" aria-label="Velg virksomhet"></select><span id="finance-role">—</span></div></header>
      <nav class="finance-quick-nav" aria-label="Hurtigmeny for regnskap"><a href="#overview">Oversikt</a><a href="#finance-task-start">Start en oppgave</a><a href="#documents">Bilagsarkiv</a><a href="#reports">Rapporter</a><a href="#controlled-workflows">Flere kontroller</a></nav>
      <section id="finance-task-start" class="finance-task-start" aria-labelledby="finance-task-title"><div class="task-start-head"><div><span class="section-kicker">Hva skal du gjøre?</span><h2 id="finance-task-title">Start med oppgaven, ikke modulen.</h2><p>Velg den vanlige regnskapsoppgaven du vil gjøre. Vi tar deg direkte til riktig arbeidsflyt og markerer hvor du skal begynne.</p></div><button type="button" id="finance-task-clear" hidden>Vis hele regnskapet</button></div><div class="finance-task-grid"><button type="button" data-finance-task="voucher" data-target="#manual-voucher-title"><span>01</span><strong>Før et bilag</strong><small>Debet, kredit og dokumentasjon</small></button><button type="button" data-finance-task="invoice" data-target="#sales-invoice-title"><span>02</span><strong>Lag en faktura</strong><small>Kunde, linjer, kontroll og betaling</small></button><button type="button" data-finance-task="supplier" data-target="#supplier-quick-title"><span>03</span><strong>Registrer et kjøp</strong><small>Leverandør, mottak og faktura</small></button><button type="button" data-finance-task="receipt" data-target="#documents-title"><span>04</span><strong>Last opp kvittering</strong><small>Koble kjøpet til dokumentasjon</small></button><button type="button" data-finance-task="bank" data-target="#bank-reconciliation-title"><span>05</span><strong>Avstem banken</strong><small>Importer, kontroller og bokfør</small></button><button type="button" data-finance-task="vat" data-target="#vat-title"><span>06</span><strong>Gjør MVA klar</strong><small>Beregn og kontroller grunnlaget</small></button><button type="button" data-finance-task="payroll" data-target="#payroll-quick-title"><span>07</span><strong>Klargjør lønn</strong><small>Ansatte, trekk og totaler</small></button><button type="button" data-finance-task="period" data-target="#period-close-title"><span>08</span><strong>Avslutt måneden</strong><small>Kontroller før perioden låses</small></button><button type="button" data-finance-task="reports" data-target="#reports"><span>09</span><strong>Se rapporter</strong><small>Resultat, balanse og hovedbok</small></button><button type="button" data-finance-task="annual" data-target="#annual-accounts-title"><span>10</span><strong>Gjør årsoppgjøret klart</strong><small>Årsgrunnlag, noter og kontroll</small></button></div><p id="finance-task-status" class="finance-task-status" aria-live="polite">Ingen oppgave valgt. Hele regnskapsflaten vises.</p></section>
      <section id="overview" class="overview" aria-labelledby="overview-title"><div class="overview-copy"><span class="section-kicker">Status nå</span><h2 id="overview-title">Hva trenger oppmerksomhet?</h2><p id="overview-updated">Henter oppdaterte tall…</p></div><div class="overview-grid"><button type="button" class="overview-card" data-overview-task="voucher"><small>Bilag</small><strong id="metric-vouchers">—</strong><span>registrert · før et bilag ↗</span></button><button type="button" class="overview-card" data-overview-task="bank"><small>Åpne bankposter</small><strong id="metric-bank">—</strong><span>til avstemming ↗</span></button><button type="button" class="overview-card" data-overview-task="supplier"><small>Leverandøravvik</small><strong id="metric-procurement">—</strong><span>må kontrolleres ↗</span></button><button type="button" class="overview-card" data-overview-task="payroll"><small>Lønnskontroller</small><strong id="metric-payroll">—</strong><span>venter · åpne lønn ↗</span></button><button type="button" class="overview-card" data-overview-task="vat"><small>MVA-perioder</small><strong id="metric-vat">—</strong><span>til kontroll ↗</span></button><button type="button" class="overview-card overview-card-amount" data-overview-task="invoice"><small>Utestående fakturaer</small><strong id="metric-receivables">—</strong><span id="metric-receivables-detail">åpne poster · se fakturaer ↗</span></button></div><p id="overview-status" class="overview-status" role="status" aria-live="polite"></p></section>
      <AccountingSetupQuick />
      <section id="documents" class="finance-documents" aria-labelledby="documents-title"><div class="workflow-section-head"><div><span class="section-kicker">Bilagsarkiv</span><h2 id="documents-title">Hold dokumentasjonen med tallene.</h2><p>Last opp kvitteringer og fakturadokumenter, og knytt dem til et bilag eller en faktura. Filen får kontrollsum og lagres i virksomhetens arkiv.</p></div><span class="workflow-badge">R2 · tenant-avgrenset</span></div><form id="document-upload-form" enctype="multipart/form-data"><div class="document-form-grid"><label>Fil<input id="document-file" type="file" name="file" accept="application/pdf,image/jpeg,image/png,text/csv,application/xml,text/xml" required /></label><label>Kildetype<select name="entityType" id="document-entity-type"><option value="receipt">Kvittering</option><option value="sales_invoice">Salgsfaktura</option><option value="supplier_invoice">Leverandørfaktura</option><option value="voucher">Bilag</option><option value="other">Annet</option></select></label><label id="document-card-transaction-wrap" hidden>Koble til firmakortkjøp<select id="document-card-transaction"><option value="">Henter kjøp…</option></select></label><label id="document-supplier-invoice-wrap" hidden>Koble til leverandørfaktura<select id="document-supplier-invoice"><option value="">Henter fakturaer…</option></select></label><label id="document-sales-invoice-wrap" hidden>Koble til salgsfaktura<select id="document-sales-invoice"><option value="">Henter fakturaer…</option></select></label><label id="document-reference-wrap">Referanse (valgfritt)<input name="entityId" id="document-entity-id" maxlength="120" placeholder="Bilags- eller faktura-ID" /></label></div><p id="document-file-hint" class="document-file-hint">Velg PDF, bilde, CSV eller XML. Maks 10 MB.</p><button type="submit">Last opp dokument</button><p id="document-upload-status" class="form-note" role="status" aria-live="polite"></p></form><div id="document-list" class="document-list"><p class="form-note">Henter dokumentarkiv…</p></div></section>
      <section id="daily-workflows" class="workflow-section" aria-labelledby="daily-workflows-title"><div class="workflow-section-head"><div><span class="section-kicker">Daglig regnskap</span><h2 id="daily-workflows-title">Det du gjør gjennom måneden.</h2><p>Bilag, kunder, leverandører, bokføringskø, bank, åpne poster, MVA, lønn og periodeavslutning i en naturlig arbeidsrekkefølge.</p></div><span class="workflow-badge">Regnskapskjerne</span></div><div class="finance-task-workflow" data-finance-tasks="voucher"><ManualVoucherQuick /></div><div class="finance-task-workflow" data-finance-tasks="invoice"><SalesInvoiceQuick /><ProductCatalogQuick /><RecurringInvoiceQuick /><ReceivablesPayablesQuick /><CollectionReminderQuick /></div><div class="finance-task-workflow" data-finance-tasks="supplier"><SupplierInvoiceQuick /></div><div class="finance-task-workflow" data-finance-tasks="voucher invoice supplier"><PostingQueueQuick /></div><div class="finance-task-workflow" data-finance-tasks="bank"><BankReconciliationQuick /></div><div class="finance-task-workflow" data-finance-tasks="vat"><VatPeriodQuick /></div><div class="finance-task-workflow" data-finance-tasks="payroll"><PayrollQuick /></div><div class="finance-task-workflow" data-finance-tasks="period"><PeriodCloseQuick /></div></section>
      <section id="reports" class="workflow-section reports-section" aria-labelledby="reports-title"><div class="workflow-section-head"><div><span class="section-kicker">Oppfølging</span><h2 id="reports-title">Se og forklar det som er bokført.</h2><p>Resultat, balanse, saldobalanse og hovedbok bygger på posterte bilagslinjer.</p></div></div><AccountingReportsQuick /></section>
      <details id="controlled-workflows" class="controlled-workflows"><summary><span><span class="section-kicker">Ved behov</span><strong>Flere regnskapskontroller</strong><small>Eiendeler, kreditnota, EHF, konsern, kort, valuta og årsoppgjør.</small></span><b>Åpne</b></summary><div class="controlled-workflows-body"><AssetRegisterQuick /><CreditNotePostingQuick /><SupplierCreditNoteQuick /><EHFInboxQuick /><IntercompanyQuick /><CardLedgerQuick /><FxLedgerQuick /><StatutoryNotesQuick /><AnnualAccountsQuick /></div></details>
      <p class="system-boundary">Eksterne bank-, betalings-, EHF- og myndighetssteg kjøres bare når virksomheten har en godkjent og konfigurert leverandøravtale. Interne utkast og kontrollspor er tydelig skilt fra ekstern innsending.</p>
    </div>
  </div>
</Layout>
<script is:inline>
  const financeQuery = new URLSearchParams(location.search); const financeEl = selector => document.querySelector(selector); const financeCount = value => { if (value && typeof value === 'object') return Number(value.count || 0); const number = Number(value || 0); return Number.isFinite(number) ? number : 0; }; const financeNumber = value => financeCount(value).toLocaleString('nb-NO');
  const setFinanceDateDefaults = () => { const now = new Date(); const today = now.toISOString().slice(0,10); const period = today.slice(0,7); document.querySelectorAll('input[type="date"]').forEach(input => { if (!input.value) input.value = today; }); document.querySelectorAll('input[type="month"]').forEach(input => { if (!input.value) input.value = period; }); };
  setFinanceDateDefaults();
  const showFinanceError = (title, copy) => { financeEl('#finance-loading').hidden = true; financeEl('#finance-content').hidden = true; financeEl('#finance-error').hidden = false; financeEl('#finance-error-title').textContent = title; financeEl('#finance-error-copy').textContent = copy; };
  const financeJson = async url => { const response = await fetch(url, { headers: { accept: 'application/json' } }); const payload = await response.json().catch(() => ({})); if (!response.ok) throw new Error(payload.error || `HTTP ${response.status}`); return payload; };
  const loadFinanceOverview = async boardId => { const encoded = encodeURIComponent(boardId); const [finance, bank, procurement, payroll, vat] = await Promise.all([financeJson(`/api/finance?boardId=${encoded}&view=summary`), financeJson(`/api/bank?boardId=${encoded}&view=summary`), financeJson(`/api/procurement?boardId=${encoded}&view=summary`), financeJson(`/api/payroll?boardId=${encoded}&view=summary`), financeJson(`/api/mva?boardId=${encoded}&view=periods`)]); const financeData=finance.data||{}, bankData=bank.data||{}, procurementData=procurement.data||{}, payrollData=payroll.data||{}; const voucherCount=financeCount(financeData.vouchers?.count??financeData.voucherCount); const bankCount=financeCount(bankData.transactions?.count??bankData.openTransactions); const procurementCount=financeCount(procurementData.exceptions?.count??procurementData.exceptionCount); const payrollCount=financeCount(payrollData.pending??payrollData.checks?.pending); const vatRows=Array.isArray(vat.data)?vat.data:[]; const vatCount=vatRows.filter(row=>['calculated','approved','prepared'].includes(String(row.status))).length; const invoiceSummary=financeData.invoices||{}; const receivablesCount=financeCount(invoiceSummary.count); const receivablesMinor=Number(invoiceSummary.outstanding_minor||0); const overdueMinor=Number(invoiceSummary.overdue_minor||0); const money=value=>`${(Math.max(0,Number(value)||0)/100).toLocaleString('nb-NO',{minimumFractionDigits:0,maximumFractionDigits:0})} kr`; financeEl('#metric-vouchers').textContent=financeNumber(voucherCount); financeEl('#metric-bank').textContent=financeNumber(bankCount); financeEl('#metric-procurement').textContent=financeNumber(procurementCount); financeEl('#metric-payroll').textContent=financeNumber(payrollCount); financeEl('#metric-vat').textContent=financeNumber(vatCount); financeEl('#metric-receivables').textContent=money(receivablesMinor); financeEl('#metric-receivables-detail').textContent=`${financeNumber(receivablesCount)} fakturaer · ${overdueMinor?money(overdueMinor)+' forfalt':'ingen forfalte'} ↗`; financeEl('#overview-updated').textContent=`Oppdatert ${new Date().toLocaleTimeString('nb-NO',{hour:'2-digit',minute:'2-digit'})}.`; const attention=bankCount+procurementCount+payrollCount+vatCount; financeEl('#overview-status').textContent=attention?`${financeNumber(attention)} kontrollpunkter er synlige i arbeidsflytene under.`:'Ingen åpne kontrollpunkter i oversikten.'; };
  const startFinance = async () => { try { const auth=await financeJson('/api/auth'); if(!auth.authenticated){ location.replace(`/login?next=${encodeURIComponent(location.pathname+location.search)}`); return; } const boards=Array.isArray(auth.boards)?auth.boards:[]; if(!boards.length){showFinanceError('Ingen virksomhet er tilgjengelig.','Be en administrator invitere deg til virksomheten.');return;} const requested=financeQuery.get('boardId'); const selected=boards.find(board=>board.id===requested)||boards[0]; const select=financeEl('#company-select'); select.innerHTML=boards.map(board=>`<option value="${String(board.id).replace(/["&<>]/g,'')}">${String(board.name||'Virksomhet').replace(/[<>&]/g,'')}</option>`).join(''); select.value=selected.id; select.addEventListener('change',()=>{const next=new URL(location.href);next.searchParams.set('boardId',select.value);location.href=next.toString();}); financeEl('#finance-role').textContent=selected.role==='owner'?'Eier':selected.role==='editor'?'Regnskapsbruker':'Lesetilgang'; financeEl('#finance-back').href=`/app?boardId=${encodeURIComponent(selected.id)}`; if(requested!==selected.id)history.replaceState({},'',`/app/finance?boardId=${encodeURIComponent(selected.id)}`); financeEl('#finance-loading').hidden=true; financeEl('#finance-content').hidden=false; await loadFinanceOverview(selected.id); } catch(error){showFinanceError('Kunne ikke åpne regnskapet.',error instanceof Error?error.message:'Prøv igjen om litt.');} }; startFinance();
</script>
<script is:inline>
  (() => {
    const taskButtons = [...document.querySelectorAll('[data-finance-task]')];
    const workflows = [...document.querySelectorAll('[data-finance-tasks]')];
    const clear = document.querySelector('#finance-task-clear');
    const status = document.querySelector('#finance-task-status');
    const labels = { voucher: 'bilag', invoice: 'faktura', supplier: 'kjøp', receipt: 'kvittering', bank: 'bankavstemming', vat: 'MVA', payroll: 'lønn', period: 'månedsavslutning', reports: 'rapporter', annual: 'årsoppgjør' };
    const showAll = () => { workflows.forEach((workflow) => { workflow.hidden = false; workflow.classList.remove('finance-task-focus'); }); const reports = document.querySelector('#reports'); if (reports) reports.hidden = false; taskButtons.forEach((button) => button.classList.remove('active')); if (clear) clear.hidden = true; if (status) status.textContent = 'Ingen oppgave valgt. Hele regnskapsflaten vises.'; };
    const selectTask = (button) => { const task = button.dataset.financeTask; workflows.forEach((workflow) => { const visible = workflow.dataset.financeTasks?.split(/\s+/).includes(task); workflow.hidden = !visible; workflow.classList.toggle('finance-task-focus', visible); }); const reports = document.querySelector('#reports'); if (reports) reports.hidden = task !== 'reports'; const controlled = document.querySelector('#controlled-workflows'); if (task === 'annual' && controlled) controlled.open = true; taskButtons.forEach((item) => item.classList.toggle('active', item === button)); if (clear) clear.hidden = false; if (status) status.textContent = `Viser arbeidsflyten for ${labels[task] || task}. Andre steg er skjult mens du jobber.`; const target = task === 'reports' ? reports : document.querySelector(button.dataset.target); target?.scrollIntoView({ behavior: 'smooth', block: 'start' }); };
    taskButtons.forEach((button) => button.addEventListener('click', () => selectTask(button)));
    clear?.addEventListener('click', showAll);
    document.querySelectorAll('[data-overview-task]').forEach((card) => card.addEventListener('click', () => document.querySelector(`[data-finance-task="${card.dataset.overviewTask}"]`)?.click()));
  })();
</script>
<script is:inline>
  (() => {
    const escDoc = (value) => String(value ?? '').replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    const boardFromUrl = () => new URLSearchParams(location.search).get('boardId') || '';
    const loadDocs = async (boardId) => { const target=document.querySelector('#document-list'); if(!target || !boardId) return; try { const response=await fetch(`/api/documents?boardId=${encodeURIComponent(boardId)}`); const payload=await response.json(); if(!response.ok) throw new Error(payload.error||'documents_unavailable'); const rows=payload.data||[]; target.innerHTML=rows.length?rows.map((row)=>`<article><div><strong>${escDoc(row.file_name)}</strong><small>${escDoc(row.entity_type||'kilde')} · ${Math.ceil(Number(row.size_bytes||0)/1024)} KB · kontrollsum ${escDoc(String(row.content_hash||'').slice(0,14))}…</small></div><a href="/api/documents?boardId=${encodeURIComponent(boardId)}&documentId=${encodeURIComponent(row.id)}" target="_blank" rel="noreferrer">Åpne ↗</a></article>`).join(''):'<p class="form-note">Ingen dokumenter lastet opp ennå.</p>'; } catch { target.innerHTML='<p class="form-note">Dokumentarkivet kunne ikke lastes.</p>'; } };
    const initDocs = async () => { const form=document.querySelector('#document-upload-form'); if(!form) return; let boardId=boardFromUrl(); if(!boardId){ try { const auth=await (await fetch('/api/auth')).json(); boardId=auth.boards?.[0]?.id||''; } catch {} } if(!boardId) return; const fileInput=document.querySelector('#document-file'); const fileHint=document.querySelector('#document-file-hint'); const entityType=document.querySelector('#document-entity-type'); const entityId=document.querySelector('#document-entity-id'); const cardWrap=document.querySelector('#document-card-transaction-wrap'); const cardSelect=document.querySelector('#document-card-transaction'); const syncCardLink=()=>{const isReceipt=entityType?.value==='receipt';if(cardWrap)cardWrap.hidden=!isReceipt;if(isReceipt&&cardSelect?.value&&entityId)entityId.value=cardSelect.value;if(!isReceipt&&entityId)entityId.value='';}; const loadCardReceiptOptions=async()=>{try{const response=await fetch(`/api/cards?boardId=${encodeURIComponent(boardId)}&view=transactions`);const payload=await response.json();if(!response.ok)throw new Error(payload.error||'cards_unavailable');const missing=(payload.data||[]).filter(row=>row.status==='needs_receipt');if(cardSelect)cardSelect.innerHTML=missing.length?'<option value="">Velg firmakortkjøp (valgfritt)</option>'+missing.map(row=>`<option value="${escDoc(row.id)}">${escDoc(row.transaction_date)} · ${escDoc(row.merchant)} · ${Math.round(Number(row.amount_minor||0)/100).toLocaleString('nb-NO')} kr</option>`).join(''):'<option value="">Ingen kjøp mangler kvittering</option>';}catch{if(cardSelect)cardSelect.innerHTML='<option value="">Firmakortkjøp kunne ikke lastes</option>';}syncCardLink();}; fileInput?.addEventListener('change',()=>{const file=fileInput.files?.[0]; if(!file){if(fileHint)fileHint.textContent='Velg PDF, bilde, CSV eller XML. Maks 10 MB.';return;} const size=Math.round(file.size/1024); if(file.size>10*1024*1024){fileHint.textContent=`Filen er ${size} KB og for stor. Maks 10 MB.`;fileHint.classList.add('is-invalid');}else{fileHint.textContent=`${file.name} · ${size} KB klar for opplasting.`;fileHint.classList.remove('is-invalid');}}); entityType?.addEventListener('change',syncCardLink); cardSelect?.addEventListener('change',syncCardLink); await Promise.all([loadDocs(boardId),loadCardReceiptOptions()]); form.addEventListener('submit',async(event)=>{event.preventDefault();const status=document.querySelector('#document-upload-status');const file=fileInput?.files?.[0];if(!file){status.textContent='Velg en fil først.';return;}if(file.size>10*1024*1024){status.textContent='Filen er for stor. Maksimal størrelse er 10 MB.';return;}syncCardLink();const cardTransactionId=entityType?.value==='receipt'?(cardSelect?.value||''):'';const data=new FormData(form);data.set('boardId',boardId);if(cardTransactionId)data.set('entityId',cardTransactionId);status.textContent='Laster opp og beregner kontrollsum…';try{const response=await fetch('/api/documents',{method:'POST',body:data});const payload=await response.json();if(!response.ok)throw new Error(payload.error||'upload_failed');if(cardTransactionId){const linkResponse=await fetch('/api/cards',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({boardId,action:'attach_receipt',transactionId:cardTransactionId,receiptRef:`document:${payload.documentId}`})});const linkPayload=await linkResponse.json();if(!linkResponse.ok)throw new Error(linkPayload.error||'receipt_link_failed');status.textContent=`✓ ${payload.fileName} er arkivert og koblet til firmakortkjøpet. Kontrollsum ${String(payload.contentHash||'').slice(0,14)}…`;}else{status.textContent=`✓ ${payload.fileName} er arkivert. Kontrollsum ${String(payload.contentHash||'').slice(0,14)}…`;}form.reset();if(fileHint){fileHint.textContent='Velg PDF, bilde, CSV eller XML. Maks 10 MB.';fileHint.classList.remove('is-invalid');}await Promise.all([loadDocs(boardId),loadCardReceiptOptions()]);}catch(error){status.textContent=`Kunne ikke laste opp: ${error instanceof Error?error.message:'prøv igjen'}`;}}); };
    initDocs();
  })();
</script>
<script is:inline>
  (() => {
    const type=document.querySelector('#document-entity-type'); const supplierWrap=document.querySelector('#document-supplier-invoice-wrap'); const supplierSelect=document.querySelector('#document-supplier-invoice'); const salesWrap=document.querySelector('#document-sales-invoice-wrap'); const salesSelect=document.querySelector('#document-sales-invoice'); const ref=document.querySelector('#document-entity-id');
    const syncInvoice=()=>{const supplier=type?.value==='supplier_invoice';const sales=type?.value==='sales_invoice';if(supplierWrap)supplierWrap.hidden=!supplier;if(salesWrap)salesWrap.hidden=!sales;if(supplier&&supplierSelect?.value&&ref)ref.value=supplierSelect.value;if(sales&&salesSelect?.value&&ref)ref.value=salesSelect.value;};
    const loadSupplierInvoices=async boardId=>{if(!supplierSelect)return;const payload=await fetch(`/api/procurement?boardId=${encodeURIComponent(boardId)}&view=invoices`).then(r=>r.json());const rows=(payload.data||[]).filter(row=>!['cancelled','paid'].includes(String(row.status)));supplierSelect.innerHTML=rows.length?'<option value="">Velg leverandørfaktura (valgfritt)</option>'+rows.map(row=>`<option value="${escDoc(row.id)}">${escDoc(row.invoice_number)} · ${escDoc(row.supplier_party_name||row.supplier_name)} · ${Math.round(Number(row.amount_minor||0)/100).toLocaleString('nb-NO')} kr</option>`).join(''):'<option value="">Ingen åpne leverandørfakturaer</option>';};
    const loadSalesInvoices=async boardId=>{if(!salesSelect)return;const payload=await fetch(`/api/finance?boardId=${encodeURIComponent(boardId)}&view=invoices`).then(r=>r.json());const rows=(payload.data||[]).filter(row=>!['cancelled','paid'].includes(String(row.status)));salesSelect.innerHTML=rows.length?'<option value="">Velg salgsfaktura (valgfritt)</option>'+rows.map(row=>`<option value="${escDoc(row.id)}">${escDoc(row.invoice_number)} · ${escDoc(row.company_name||'Kunde')} · ${Math.round(Number(row.total_minor||0)/100).toLocaleString('nb-NO')} kr</option>`).join(''):'<option value="">Ingen åpne salgsfakturaer</option>';};
    const startInvoiceDocuments=async()=>{try{let boardId=new URLSearchParams(location.search).get('boardId')||'';if(!boardId){const auth=await fetch('/api/auth').then(r=>r.json());boardId=auth.boards?.[0]?.id||'';}if(!boardId)return;await Promise.all([loadSupplierInvoices(boardId),loadSalesInvoices(boardId)]);syncInvoice();}catch{if(supplierSelect)supplierSelect.innerHTML='<option value="">Leverandørfakturaer kunne ikke lastes</option>';if(salesSelect)salesSelect.innerHTML='<option value="">Salgsfakturaer kunne ikke lastes</option>';}};
    type?.addEventListener('change',syncInvoice);supplierSelect?.addEventListener('change',syncInvoice);salesSelect?.addEventListener('change',syncInvoice);startInvoiceDocuments();
    document.querySelector('#document-upload-form')?.addEventListener('submit',()=>{if((type?.value==='supplier_invoice'&&supplierSelect?.value)||(type?.value==='sales_invoice'&&salesSelect?.value))syncInvoice();},true);
  })();
</script>
