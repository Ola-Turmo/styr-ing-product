---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Møte og avstemning" activeNav="board-governance">
  <main class="g-shell">
    <section class="g-hero">
      <div><span class="eyebrow">Styr.ing · governance control</span><h1>Riktig møte.<br /><em>Riktig beslutning.</em></h1><p>Hold innkalling, fremmøte, habilitet og avstemninger i samme spor før protokollen går til signering.</p><a href="#g-work" class="primary">Åpne møtekontrollen ↓</a></div>
      <div class="g-orb"><strong id="hero-upcoming">—</strong><span>planlagte møter</span><small id="hero-quorum">— fremmøtte</small></div>
    </section>
    <section class="metrics"><article><span>Møter i registeret</span><strong id="m-meetings">—</strong><small>ikke kansellert</small></article><article><span>Planlagte møter</span><strong id="m-upcoming">—</strong><small>innkalling må følges opp</small></article><article><span>Fremmøtteregistreringer</span><strong id="m-quorum">—</strong><small>quorum-grunnlag</small></article><article class="dark"><span>eID/PAdES</span><strong>STOPP</strong><small>signering ikke aktivert</small></article></section>
    <section id="g-work" class="workspace"><div class="head"><div><span class="kicker">Møteprosess</span><h2>Møter, fremmøte og stemmer</h2></div><span id="status">Henter…</span></div><nav class="tabs">{[['meetings','Møter'],['attendance','Fremmøte'],['ballots','Avstemninger'],['dissents','Forbehold']].map(([key,label],i)=><button class={i===0?'active':''} data-view={key}>{label}</button>)}</nav><div id="list"></div></section>
    <section class="governance-actions"><div><span class="kicker">Kontrollert opprettelse</span><h2>Legg neste beslutning i sporet.</h2><p>Handlingene krever eier- eller redaktørrolle. De oppretter kun intern arbeidsdata; utsending, juridisk signering og offentlig innsending er ikke aktivert.</p></div><div class="action-grid">
      <form id="meeting-create-form"><strong>Nytt møte</strong><label>Tittel<input name="title" required maxlength="200" placeholder="Styremøte Q3" /></label><label>Dato<input name="date" type="date" required /></label><label>Tid<input name="time" type="time" /></label><button class="action-button" type="submit">Opprett møte</button></form>
      <form id="resolution-create-form"><strong>Nytt vedtak</strong><label>Møte<select name="meetingId" id="resolution-meeting" required></select></label><label>Nummer<input name="number" required maxlength="60" placeholder="2026/07" /></label><label>Tittel<input name="title" required maxlength="200" placeholder="Godkjenne budsjett" /></label><button class="action-button" type="submit">Opprett vedtak</button></form>
      <form id="meeting-status-form"><strong>Oppdater møte</strong><label>Møte<select name="meetingId" id="meeting-status-select" required></select></label><label>Status<select name="status"><option value="ongoing">Pågår</option><option value="completed">Fullført</option><option value="cancelled">Kansellert</option></select></label><button class="action-button" type="submit">Lagre status</button><small>Fullføring krever fortsatt protokoll- og signaturkontroll.</small></form>
      <form id="attendance-form"><strong>Registrer fremmøte</strong><label>Registrering<select name="attendanceId" id="attendance-record" required></select></label><label>Status<select name="attendanceStatus"><option value="present">Fremmøtt</option><option value="absent">Fraværende</option><option value="excused">Unnskyldt</option><option value="invited">Invitert</option></select></label><label class="check-label"><input name="conflictFlag" type="checkbox" /> Habilitet må vurderes</label><button class="action-button" type="submit">Lagre fremmøte</button></form>
      <form id="ballot-form"><strong>Registrer stemme</strong><label>Vedtak / medlem<select name="ballotKey" id="ballot-record" required></select></label><label>Stemme<select name="vote"><option value="for">For</option><option value="against">Mot</option><option value="abstain">Avstår</option><option value="recused">Inhabil</option></select></label><button class="action-button" type="submit">Lagre stemme</button></form>
      <form id="dissent-form"><strong>Registrer forbehold</strong><label>Vedtak / medlem<select name="dissentKey" id="dissent-record" required></select></label><label>Forbehold<textarea name="statement" maxlength="5000" required placeholder="Beskriv dissensen eller forbeholdet…"></textarea></label><button class="action-button" type="submit">Send til review</button><small>Intern registrering. eID/PAdES og Altinn er ikke konfigurert.</small></form>
      <form id="dissent-approve-form"><strong>Godkjenn forbehold</strong><label>Åpent forbehold<select name="dissentId" id="dissent-approval" required></select></label><button class="action-button" type="submit">Godkjenn internt</button></form>
    </div><p id="action-status" class="action-status" role="status" hidden></p></section>
    <section class="notice"><strong>Kontrollgrense</strong><p>Fremmøte og avstemning er et internt beslutningsspor. Juridisk gyldig innkalling, stemmeregler, eID og PAdES-LTV-forsegling krever særskilt godkjenning og leverandørkonfigurasjon.</p></section>
  </main>
</Layout>
<script is:inline>
  const esc = (value) => String(value ?? '').replace(/[&<>'"]/g, (character) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', "'":'&#39;', '"':'&quot;' }[character]));
  const boardId = new URLSearchParams(location.search).get('boardId') || 'board-1';
  const list = document.getElementById('list');
  const status = document.getElementById('status');
  const actionStatus = document.getElementById('action-status');
  const labels = { planned:'Planlagt', ongoing:'Pågår', completed:'Fullført', invited:'Invitert', present:'Fremmøtt', absent:'Fraværende', excused:'Unnskyldt', for:'For', against:'Mot', abstain:'Avstår', recused:'Inhabil' };
  const pill = (value) => `<em class="pill">${esc(labels[value] || value || '—')}</em>`;
  const api = async (path, options) => { const response = await fetch(path, options); const data = await response.json(); if (!response.ok) throw new Error(data.error || 'request_failed'); return data; };
  const setActionStatus = (message, error = false) => { actionStatus.hidden = !message; actionStatus.textContent = message || ''; actionStatus.classList.toggle('error', error); };
  const render = (view, rows) => {
    const format = {
      meetings: (row) => `<article><div><strong>${esc(row.title)}</strong><p>${esc(row.date)} · ${esc(row.time || 'Tid ikke satt')} · ${esc(row.location || 'Lokasjon ikke satt')}</p></div>${pill(row.status)}<small>${esc(row.present_count || 0)}/${esc(row.invited_count || 0)} fremmøtt</small></article>`,
      attendance: (row) => `<article><div><strong>${esc(row.meeting_title)} · ${esc(row.member_name)}</strong><p>${esc(row.role)} · ${row.conflict_flag ? 'Habilitet må vurderes' : 'Ingen registrert konflikt'}</p></div>${pill(row.attendance_status)}<small>${esc(row.date || '')}</small></article>`,
      ballots: (row) => `<article><div><strong>${esc(row.number)} · ${esc(row.title)}</strong><p>${esc(row.member_name)} · ${esc(row.role)}</p></div>${pill(row.vote || 'Ikke avgitt')}<small>${esc(row.cast_at || '')}</small></article>`,
      dissents: (row) => `<article><div><strong>${esc(row.number)} · ${esc(row.title)}</strong><p>${esc(row.member_name)} · ${esc(row.statement)}</p></div>${pill(row.status)}<small>${esc(row.signature_status)}</small></article>`,
    };
    list.innerHTML = rows.length ? rows.map(format[view]).join('') : '<p class="empty">Ingen registrerte rader.</p>';
  };
  const load = async (view) => { try { const data = await api(`/api/board_governance?boardId=${encodeURIComponent(boardId)}&view=${view}`); render(view, data.data || []); status.textContent = `${(data.data || []).length} poster · kilde synlig`; } catch { status.textContent = 'API utilgjengelig'; } };
  const loadSummary = async () => { try { const data = (await api(`/api/board_governance?boardId=${encodeURIComponent(boardId)}&view=summary`)).data || {}; document.getElementById('m-meetings').textContent = data.meetings?.count ?? 0; document.getElementById('m-upcoming').textContent = data.upcoming?.count ?? 0; document.getElementById('m-quorum').textContent = data.quorum?.count ?? 0; document.getElementById('hero-upcoming').textContent = data.upcoming?.count ?? 0; document.getElementById('hero-quorum').textContent = `${data.quorum?.count ?? 0} fremmøte registrert`; } catch {} };
  const refreshForms = async () => { try { const [meetings, attendance, ballots, dissents] = await Promise.all(['meetings','attendance','ballots','dissents'].map((view) => api(`/api/board_governance?boardId=${encodeURIComponent(boardId)}&view=${view}`))); const meetingRows = meetings.data || []; document.getElementById('resolution-meeting').innerHTML = meetingRows.filter((row) => row.status !== 'cancelled').map((row) => `<option value="${esc(row.id)}">${esc(row.date)} · ${esc(row.title)}</option>`).join('') || '<option value="">Ingen tilgjengelige møter</option>'; document.getElementById('meeting-status-select').innerHTML = meetingRows.filter((row) => !['completed','cancelled'].includes(row.status)).map((row) => `<option value="${esc(row.id)}">${esc(row.date)} · ${esc(row.title)} (${esc(labels[row.status] || row.status)})</option>`).join('') || '<option value="">Ingen åpne møter</option>'; document.getElementById('attendance-record').innerHTML = (attendance.data || []).map((row) => `<option value="${esc(row.id)}">${esc(row.meeting_title)} · ${esc(row.member_name)}</option>`).join('') || '<option value="">Ingen registreringer</option>'; const seen = new Set(); const ballotRows = (ballots.data || []).filter((row) => { const key = `${row.resolution_id}:${row.member_id}`; if (seen.has(key)) return false; seen.add(key); return true; }); const ballotOptions = ballotRows.map((row) => `<option value="${esc(row.resolution_id)}|${esc(row.member_id)}">${esc(row.number)} · ${esc(row.member_name)}</option>`).join('') || '<option value="">Ingen vedtak</option>'; document.getElementById('ballot-record').innerHTML = ballotOptions; document.getElementById('dissent-record').innerHTML = ballotOptions; document.getElementById('dissent-approval').innerHTML = (dissents.data || []).filter((row) => ['draft','review'].includes(row.status)).map((row) => `<option value="${esc(row.id)}">${esc(row.number)} · ${esc(row.member_name)} · ${esc(row.status)}</option>`).join('') || '<option value="">Ingen åpne forbehold</option>'; } catch { setActionStatus('Skjemaene kunne ikke lastes.', true); } };
  const post = async (payload) => { await api('/api/board_governance', { method:'POST', headers:{'content-type':'application/json'}, body:JSON.stringify({ boardId, ...payload }) }); setActionStatus('Endringen er lagret og auditert.'); await Promise.all([loadSummary(), refreshForms(), load(document.querySelector('.tabs button.active')?.dataset.view || 'meetings')]); };
  document.querySelectorAll('.tabs button').forEach((button) => button.addEventListener('click', () => { document.querySelectorAll('.tabs button').forEach((item) => item.classList.remove('active')); button.classList.add('active'); load(button.dataset.view); }));
  document.getElementById('meeting-create-form').addEventListener('submit', async (event) => { event.preventDefault(); const form = new FormData(event.currentTarget); try { await post({ action:'create_meeting', title:form.get('title'), date:form.get('date'), time:form.get('time') || null }); event.currentTarget.reset(); } catch (error) { setActionStatus(error.message === 'write_not_authorized' ? 'Du trenger eier- eller redaktørrolle for å opprette møter.' : 'Møtet kunne ikke opprettes.', true); } });
  document.getElementById('resolution-create-form').addEventListener('submit', async (event) => { event.preventDefault(); const form = new FormData(event.currentTarget); try { await post({ action:'create_resolution', meetingId:form.get('meetingId'), number:form.get('number'), title:form.get('title') }); event.currentTarget.reset(); } catch { setActionStatus('Vedtaket kunne ikke opprettes.', true); } });
  document.getElementById('meeting-status-form').addEventListener('submit', async (event) => { event.preventDefault(); const form = new FormData(event.currentTarget); try { await post({ action:'update_meeting_status', meetingId:form.get('meetingId'), status:form.get('status') }); } catch (error) { setActionStatus(error.message === 'write_not_authorized' ? 'Du trenger eier- eller redaktørrolle for å endre møter.' : 'Møtestatus kunne ikke lagres.', true); } });
  document.getElementById('attendance-form').addEventListener('submit', async (event) => { event.preventDefault(); const form = new FormData(event.currentTarget); try { await post({ action:'record_attendance', attendanceId:form.get('attendanceId'), attendanceStatus:form.get('attendanceStatus'), conflictFlag:form.get('conflictFlag') === 'on', conflictNote:form.get('conflictFlag') === 'on' ? 'Krever habilitetsvurdering' : null }); } catch { setActionStatus('Fremmøtet kunne ikke lagres.', true); } });
  document.getElementById('ballot-form').addEventListener('submit', async (event) => { event.preventDefault(); const form = new FormData(event.currentTarget); const [resolutionId, memberId] = String(form.get('ballotKey') || '|').split('|'); try { await post({ action:'cast_ballot', resolutionId, memberId, vote:form.get('vote') }); } catch { setActionStatus('Stemmen kunne ikke lagres.', true); } });
  document.getElementById('dissent-form').addEventListener('submit', async (event) => { event.preventDefault(); const form = new FormData(event.currentTarget); const [resolutionId, memberId] = String(form.get('dissentKey') || '|').split('|'); try { await post({ action:'record_dissent', resolutionId, memberId, statement:form.get('statement') }); event.currentTarget.reset(); } catch { setActionStatus('Forbeholdet kunne ikke lagres.', true); } });
  document.getElementById('dissent-approve-form').addEventListener('submit', async (event) => { event.preventDefault(); const form = new FormData(event.currentTarget); try { await post({ action:'approve_dissent', dissentId:form.get('dissentId') }); } catch { setActionStatus('Forbeholdet kunne ikke godkjennes.', true); } });
  Promise.all([loadSummary(), refreshForms(), load('meetings')]);
</script>
<style>
  .g-shell{max-width:1180px;margin:0 auto;padding:38px 24px 80px}.g-hero{display:grid;grid-template-columns:1fr .45fr;align-items:center;gap:24px;padding:44px;border-radius:27px;background:linear-gradient(120deg,#1d3540,#3b7480);color:#fff}.eyebrow,.kicker{font:700 .68rem system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:#c6eff0}.g-hero h1{margin:20px 0 16px;font:500 clamp(2.5rem,5vw,4.4rem)/.96 Georgia,serif}.g-hero h1 em{color:#bce9e6;font-style:normal}.g-hero p{max-width:570px;color:#ffffffbf;font:1rem/1.6 system-ui,sans-serif}.primary{display:inline-flex;margin-top:22px;padding:13px 17px;border-radius:10px;background:#bce9e6;color:#1d3540;font:700 .78rem system-ui,sans-serif}.g-orb{width:190px;height:190px;display:flex;flex-direction:column;align-items:center;justify-content:center;border:1px solid #bce9e6aa;border-radius:50%;background:#285864;color:#fff}.g-orb strong{font:500 3.2rem Georgia,serif;color:#c6eff0}.g-orb span,.g-orb small{font:.68rem system-ui,sans-serif;text-align:center}.g-orb small{margin-top:9px;color:#b4dcdd}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:16px 0 52px}.metrics article{min-height:105px;padding:17px;border:1px solid #10241f14;border-radius:15px;background:#fff;display:flex;flex-direction:column;justify-content:space-between}.metrics .dark{background:#10241f;color:#fff}.metrics span,.metrics small{color:#718078;font:600 .67rem system-ui,sans-serif}.metrics strong{font:500 1.55rem Georgia,serif}.workspace{padding:28px;border:1px solid #10241f18;border-radius:20px;background:#fff}.head{display:flex;justify-content:space-between;align-items:end}.head h2{margin:9px 0 0;font:500 2.1rem Georgia,serif}.head>span{color:#718078;font:.7rem system-ui,sans-serif}.tabs{display:flex;gap:6px;overflow:auto;margin:25px 0 12px}.tabs button{padding:10px 14px;border:1px solid #10241f1c;border-radius:9px;background:#fafbf9;color:#65746b;cursor:pointer;font:700 .72rem system-ui,sans-serif;white-space:nowrap}.tabs button.active{background:#3b7480;color:#fff}.workspace article{display:grid;grid-template-columns:1.6fr auto auto;gap:12px;align-items:center;padding:15px 4px;border-top:1px solid #10241f12}.workspace strong{font:600 .82rem system-ui,sans-serif}.workspace p{margin:5px 0 0;color:#718078;font:.7rem/1.35 system-ui,sans-serif}.pill{padding:5px 8px;border-radius:999px;background:#e8f5f5;color:#32717a;font:700 .61rem system-ui,sans-serif;font-style:normal;white-space:nowrap}.governance-actions{display:grid;grid-template-columns:.7fr 1.3fr;gap:25px;margin-top:32px;padding:28px;border:1px solid #10241f18;border-radius:20px;background:#f5faf3}.governance-actions h2{margin:10px 0 8px;font:500 1.8rem/1.05 Georgia,serif}.governance-actions p{color:#63736a;font:.78rem/1.5 system-ui,sans-serif}.action-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.action-grid form{display:grid;gap:8px;padding:16px;border:1px solid #10241f14;border-radius:12px;background:#fff}.action-grid strong{font:700 .78rem system-ui,sans-serif}.action-grid label{display:grid;gap:4px;color:#63736a;font:600 .64rem system-ui,sans-serif}.action-grid input,.action-grid select{width:100%;padding:9px;border:1px solid #10241f1c;border-radius:7px;background:#fff;font:.72rem system-ui,sans-serif}.check-label{display:flex!important;align-items:center;gap:6px}.check-label input{width:auto}.action-button{padding:9px;border:0;border-radius:8px;background:#3b7480;color:#fff;cursor:pointer;font:700 .68rem system-ui,sans-serif}.action-status{grid-column:1/-1;margin:5px 0 0;padding:9px 11px;border-radius:8px;background:#e2f3e5;color:#286447;font:700 .68rem system-ui,sans-serif}.action-status.error{background:#fae8e5;color:#97443d}.notice{margin-top:35px;padding:22px 25px;border-radius:16px;background:#e7f4f4}.notice strong{font:700 .78rem system-ui,sans-serif}.notice p{margin:8px 0 0;color:#63736a;font:.78rem/1.5 system-ui,sans-serif}.empty{color:#718078;font:.75rem system-ui,sans-serif}@media(max-width:900px){.g-hero{grid-template-columns:1fr}.metrics{grid-template-columns:repeat(2,1fr)}.governance-actions{grid-template-columns:1fr}}@media(max-width:560px){.g-shell{padding:20px 15px 55px}.g-hero{padding:28px 22px}.metrics{grid-template-columns:1fr}.workspace{padding:20px 16px}.workspace article{grid-template-columns:1fr auto}.workspace article small{grid-column:1}.action-grid{grid-template-columns:1fr}.governance-actions{padding:20px 16px}}
</style>
