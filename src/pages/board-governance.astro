---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Møte og avstemning" activeNav="board-governance"><main class="g-shell"><section class="g-hero"><div><span class="eyebrow">Styr.ing · governance control</span><h1>Riktig møte.<br /><em>Riktig beslutning.</em></h1><p>Hold innkalling, fremmøte, habilitet og avstemninger i samme spor før protokollen går til signering.</p><a href="#g-work" class="primary">Åpne møtekontrollen ↓</a></div><div class="g-orb"><strong id="hero-upcoming">—</strong><span>planlagte møter</span><small id="hero-quorum">— fremmøtte</small></div></section><section class="metrics"><article><span>Møter i registeret</span><strong id="m-meetings">—</strong><small>ikke kansellert</small></article><article><span>Planlagte møter</span><strong id="m-upcoming">—</strong><small>innkalling må følges opp</small></article><article><span>Fremmøtteregistreringer</span><strong id="m-quorum">—</strong><small>quorum-grunnlag</small></article><article class="dark"><span>eID/PAdES</span><strong>STOPP</strong><small>signering ikke aktivert</small></article></section><section id="g-work" class="workspace"><div class="head"><div><span class="kicker">Møteprosess</span><h2>Møter, fremmøte og stemmer</h2></div><span id="status">Henter…</span></div><nav class="tabs">{[['meetings','Møter'],['attendance','Fremmøte'],['ballots','Avstemninger']].map(([key,label],i)=><button class={i===0?'active':''} data-view={key}>{label}</button>)}</nav><div id="list"></div></section><section class="notice"><strong>Kontrollgrense</strong><p>Fremmøte og avstemning er et internt beslutningsspor. Juridisk gyldig innkalling, stemmeregler, eID og PAdES-LTV-forsegling krever særskilt godkjenning og leverandørkonfigurasjon.</p></section></main></Layout>
<script is:inline>
const esc=v=>String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));const list=document.getElementById('list'),status=document.getElementById('status');const labels={planned:'Planlagt',ongoing:'Pågår',completed:'Fullført',invited:'Invitert',present:'Fremmøtt',absent:'Fraværende',excused:'Unnskyldt',for:'For',against:'Mot',abstain:'Avstår',recused:'Inhabil'};const pill=v=>`<em class="pill">${esc(labels[v]||v||'—')}</em>`;const render=(view,rows)=>{const f={meetings:r=>`<article><div><strong>${esc(r.title)}</strong><p>${esc(r.date)} · ${esc(r.time||'Tid ikke satt')} · ${esc(r.location||'Lokasjon ikke satt')}</p></div>${pill(r.status)}<small>${esc(r.present_count||0)}/${esc(r.invited_count||0)} fremmøtt</small></article>`,attendance:r=>`<article><div><strong>${esc(r.meeting_title)} · ${esc(r.member_name)}</strong><p>${esc(r.role)} · ${r.conflict_flag?'Habilitet må vurderes':'Ingen registrert konflikt'}</p></div>${pill(r.attendance_status)}<small>${esc(r.meeting_date||r.date||'')}</small></article>`,ballots:r=>`<article><div><strong>${esc(r.number)} · ${esc(r.title)}</strong><p>${esc(r.member_name)} · ${esc(r.role)}</p></div>${pill(r.vote)}<small>${esc(r.cast_at||'')}</small></article>`};list.innerHTML=rows.length?rows.map(f[view]).join(''):'<p class="empty">Ingen registrerte rader.</p>';};const load=async view=>{try{const d=await (await fetch(`/api/board_governance?boardId=board-1&view=${view}`)).json();render(view,d.data||[]);status.textContent=`${(d.data||[]).length} poster · kilde synlig`;}catch{status.textContent='API utilgjengelig'}};const summary=async()=>{try{const d=(await (await fetch('/api/board_governance?boardId=board-1&view=summary')).json()).data||{};document.getElementById('m-meetings').textContent=d.meetings?.count??0;document.getElementById('m-upcoming').textContent=d.upcoming?.count??0;document.getElementById('m-quorum').textContent=d.quorum?.count??0;document.getElementById('hero-upcoming').textContent=d.upcoming?.count??0;document.getElementById('hero-quorum').textContent=`${d.quorum?.count??0} fremmøte registrert`;}catch{}};document.querySelectorAll('.tabs button').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.tabs button').forEach(x=>x.classList.remove('active'));b.classList.add('active');load(b.dataset.view)}));summary();load('meetings');
</script>
<style>.g-shell{max-width:1180px;margin:0 auto;padding:38px 24px 80px}.g-hero{display:grid;grid-template-columns:1fr .45fr;align-items:center;gap:24px;padding:44px;border-radius:27px;background:linear-gradient(120deg,#1d3540,#3b7480);color:#fff}.eyebrow,.kicker{font:700 .68rem system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:#c6eff0}.g-hero h1{margin:20px 0 16px;font:500 clamp(2.5rem,5vw,4.4rem)/.96 Georgia,serif}.g-hero h1 em{color:#bce9e6;font-style:normal}.g-hero p{max-width:570px;color:#ffffffbf;font:1rem/1.6 system-ui,sans-serif}.primary{display:inline-flex;margin-top:22px;padding:13px 17px;border-radius:10px;background:#bce9e6;color:#1d3540;font:700 .78rem system-ui,sans-serif}.g-orb{width:190px;height:190px;display:flex;flex-direction:column;align-items:center;justify-content:center;border:1px solid #bce9e6aa;border-radius:50%;background:#285864;color:#fff}.g-orb strong{font:500 3.2rem Georgia,serif;color:#c6eff0}.g-orb span,.g-orb small{font:.68rem system-ui,sans-serif;text-align:center}.g-orb small{margin-top:9px;color:#b4dcdd}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:16px 0 52px}.metrics article{min-height:105px;padding:17px;border:1px solid #10241f14;border-radius:15px;background:#fff;display:flex;flex-direction:column;justify-content:space-between}.metrics .dark{background:#10241f;color:#fff}.metrics span,.metrics small{color:#718078;font:600 .67rem system-ui,sans-serif}.metrics strong{font:500 1.55rem Georgia,serif}.workspace{padding:28px;border:1px solid #10241f18;border-radius:20px;background:#fff}.head{display:flex;justify-content:space-between;align-items:end}.head h2{margin:9px 0 0;font:500 2.1rem Georgia,serif}.head>span{color:#718078;font:.7rem system-ui,sans-serif}.tabs{display:flex;gap:6px;overflow:auto;margin:25px 0 12px}.tabs button{padding:10px 14px;border:1px solid #10241f1c;border-radius:9px;background:#fafbf9;color:#65746b;cursor:pointer;font:700 .72rem system-ui,sans-serif;white-space:nowrap}.tabs button.active{background:#3b7480;color:#fff}.workspace article{display:grid;grid-template-columns:1.6fr auto auto;gap:12px;align-items:center;padding:15px 4px;border-top:1px solid #10241f12}.workspace strong{font:600 .82rem system-ui,sans-serif}.workspace p{margin:5px 0 0;color:#718078;font:.7rem/1.35 system-ui,sans-serif}.pill{padding:5px 8px;border-radius:999px;background:#e8f5f5;color:#32717a;font:700 .61rem system-ui,sans-serif;font-style:normal;white-space:nowrap}.notice{margin-top:35px;padding:22px 25px;border-radius:16px;background:#e7f4f4}.notice strong{font:700 .78rem system-ui,sans-serif}.notice p{margin:8px 0 0;color:#63736a;font:.78rem/1.5 system-ui,sans-serif}@media(max-width:800px){.g-hero{grid-template-columns:1fr}.metrics{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.g-shell{padding:20px 15px 55px}.g-hero{padding:28px 22px}.metrics{grid-template-columns:1fr}.workspace{padding:20px 16px}.workspace article{grid-template-columns:1fr auto}.workspace article small{grid-column:1}}
</style>
