---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Mennesker — Styr.ing" activeNav="people">
  <main class="people-shell">
    <section class="people-hero"><div><span class="eyebrow"><i></i>Mennesker · HCM</span><h1>Bygg kapasitet med <em>samme kontekst.</em></h1><p>Følg ansatte, kandidater, mål, håndbok og opplæring i ett rolig arbeidsrom. Persondata i denne offentlige flaten er fiktive og tenant-sperret.</p></div><div class="people-orb"><span>Aktive personer</span><strong id="people-count">—</strong><small>i demo-organisasjonen</small></div></section>
    <section class="people-metrics"><div><span>Åpne kandidater</span><strong id="candidate-count">—</strong></div><div><span>Opplæring i kø</span><strong id="training-count">—</strong></div><div><span>Mangler lesespor</span><strong id="ack-count">—</strong></div><div><span>Mål åpne</span><strong id="goal-count">—</strong></div><div><span>Reviews åpne</span><strong id="review-count">—</strong></div></section>
    <nav class="people-tabs" aria-label="HCM-områder"><button class="people-tab active" data-view="people">Personer</button><button class="people-tab" data-view="goals">OKR og mål</button><button class="people-tab" data-view="candidates">Rekruttering</button><button class="people-tab" data-view="training">Opplæring</button><button class="people-tab" data-view="handbook">Håndbok</button><button class="people-tab" data-view="reviews">Medarbeidersamtaler</button><button class="people-tab" data-view="offboarding">Offboarding</button></nav>
    <section class="people-card"><div class="card-head"><div><span id="view-kicker" class="section-kicker">HCM · PERSONER</span><h2 id="view-title">Mennesker i organisasjonen</h2></div><a id="view-api" href="/api/hcm?boardId=board-1&view=people">API ↗</a></div><div id="people-list" class="people-list"><p class="muted">Henter arbeidsflate…</p></div></section>
    <section class="people-boundary"><div><span class="section-kicker">Trygg arbeidsflyt</span><h2>AI kan foreslå.<br /><em>Mennesker godkjenner.</em></h2><p>Rekruttering, opplæring og offboarding kan gi forslag og køer, men ingen tilgang blir trukket, kandidat avvist eller lønnsdata sendt uten eksplisitt godkjenning.</p></div><a href="/trust" class="boundary-button">Se tillitsmodellen ↗</a></section>
  </main>
</Layout>
<script is:inline>
  const esc = (v) => String(v ?? '').replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const labels = {people:['HCM · PERSONER','Mennesker i organisasjonen'],goals:['OKR · MÅL','Mål og fremdrift'],candidates:['ATS · REKRUTTERING','Kandidatpipeline'],training:['LMS · OPPLÆRING','Obligatoriske kurs'],handbook:['POLICY · HÅNDBOK','Lesespor og versjoner'],reviews:['OKR · REVIEWS','Medarbeidersamtaler'],offboarding:['LIVSSYKLUS · OFFBOARDING','Kontrollert avslutning']};
  const render = (view, data) => { const list = document.querySelector('#people-list'); if (!list) return; document.querySelector('#view-kicker').textContent=labels[view][0]; document.querySelector('#view-title').textContent=labels[view][1]; document.querySelector('#view-api').href=`/api/hcm?boardId=board-1&view=${view}`; const rows=data.data||[]; const renderers={people:x=>`<div class="hcm-row"><strong>${esc(x.name)}</strong><span>${esc(x.role||'')}${x.department?' · '+esc(x.department):''}</span><em>${esc(x.employment_status)}</em></div>`,goals:x=>`<div class="hcm-row"><strong>${esc(x.title)}</strong><span>${esc(x.owner_name||'Uten eier')} · ${esc(x.period||'Ingen periode')}</span><em>${esc(x.status)} · ${esc(x.progress)}%</em></div>`,candidates:x=>`<div class="hcm-row"><strong>${esc(x.name)}</strong><span>${esc(x.requisition_title||'Kandidat')}</span><em>${esc(x.stage)}${x.score?' · '+esc(x.score)+'/100':''}</em></div>`,training:x=>`<div class="hcm-row"><strong>${esc(x.course_title)}</strong><span>${esc(x.person_name)} · frist ${esc(x.due_date)}</span><em>${esc(x.status)}${x.score?' · '+esc(x.score)+'/100':''}</em></div>`,handbook:x=>`<div class="hcm-row"><strong>${esc(x.title)}</strong><span>v${esc(x.version)} · ${esc(x.category)}</span><em>${esc(x.acknowledgements)} lesespor</em></div>`,reviews:x=>`<div class="hcm-row"><strong>${esc(x.person_name)}</strong><span>${esc(x.period)} · ${esc(x.reviewer_name||'Ikke satt')}</span><em>${esc(x.status)}${x.rating?' · '+esc(x.rating)+'/5':''}</em></div>`,offboarding:x=>`<div class="hcm-row"><strong>${esc(x.person_name)}</strong><span>Siste dag ${esc(x.last_day)}</span><em>${esc(x.status)} · ${x.access_revoked&&x.assets_returned&&x.payroll_reviewed?'klar':'krever kontroll'}</em></div>`}; list.innerHTML=rows.length?rows.map(renderers[view]).join(''):'<p class="muted">Ingen registrerte rader i denne visningen.</p>'; };
  const load = (view) => fetch(`/api/hcm?boardId=board-1&view=${view}`).then(r=>r.json()).then(data=>render(view,data)).catch(()=>{document.querySelector('#people-list').innerHTML='<p class="muted">Arbeidsflaten er midlertidig utilgjengelig.</p>';});
  fetch('/api/hcm?boardId=board-1&view=summary').then(r=>r.json()).then(({data})=>{document.querySelector('#people-count').textContent=data.people?.count??'—';document.querySelector('#candidate-count').textContent=data.openCandidates?.count??'—';document.querySelector('#training-count').textContent=data.dueTraining?.count??'—';document.querySelector('#ack-count').textContent=data.pendingAck?.count??'—';document.querySelector('#goal-count').textContent=data.goals?.count??'—';document.querySelector('#review-count').textContent=data.reviews?.count??'—';}).catch(()=>{}); load('people'); document.querySelectorAll('.people-tab').forEach((tab)=>tab.addEventListener('click',()=>{document.querySelectorAll('.people-tab').forEach(x=>x.classList.remove('active'));tab.classList.add('active');load(tab.dataset.view);}));
</script>
<style>
 .people-shell{max-width:1180px;margin:0 auto;padding:44px 24px 76px}.people-hero{display:grid;grid-template-columns:1fr 270px;gap:40px;align-items:center;padding:42px;border-radius:26px;background:linear-gradient(120deg,#4d2e41,#8a4668);color:#fff}.eyebrow,.section-kicker{font:700 .68rem/1 system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase}.eyebrow{color:#ffd9e9}.eyebrow i{display:inline-block;width:7px;height:7px;border-radius:50%;background:#ffd9e9;margin-right:7px}.people-hero h1{font:500 clamp(2.5rem,5vw,4.2rem)/.95 Georgia,serif;letter-spacing:-.05em;margin:18px 0}.people-hero h1 em{color:#ffd0e4;font-style:normal}.people-hero p{max-width:570px;color:rgba(255,255,255,.75);font:.92rem/1.65 system-ui,sans-serif}.people-orb{width:195px;height:195px;border-radius:50%;display:flex;flex-direction:column;justify-content:center;align-items:center;background:rgba(58,27,45,.38);border:1px solid rgba(255,215,233,.54);margin:auto}.people-orb span,.people-orb small{font:700 .62rem/1 system-ui,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:#f0c2d8}.people-orb strong{font:500 2.7rem/1 Georgia,serif;color:#fff1f7;margin:12px 0}.people-metrics{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin:16px 0 35px}.people-metrics>div{padding:17px;border:1px solid rgba(16,36,31,.09);border-radius:14px;background:#fff}.people-metrics span{display:block;color:var(--muted);font:600 .65rem/1 system-ui,sans-serif;text-transform:uppercase}.people-metrics strong{display:block;margin-top:12px;font:500 1.7rem/1 Georgia,serif}.people-tabs{display:flex;gap:7px;overflow:auto;padding-bottom:14px}.people-tab{white-space:nowrap;padding:9px 12px;border:1px solid rgba(16,36,31,.1);border-radius:999px;background:#fff;color:var(--muted);font:700 .68rem/1 system-ui,sans-serif;cursor:pointer}.people-tab.active,.people-tab:hover{background:var(--night);border-color:var(--night);color:#fff}.people-card{padding:22px;border:1px solid rgba(16,36,31,.09);border-radius:16px;background:#fff}.card-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:16px}.card-head h2{margin:8px 0 0;font:500 1.65rem/1 Georgia,serif}.card-head a{color:var(--accent);font:700 .68rem/1 system-ui,sans-serif}.hcm-row{display:grid;grid-template-columns:1.1fr 1fr auto;gap:15px;align-items:center;padding:14px 0;border-top:1px solid rgba(16,36,31,.08);font:.77rem/1.3 system-ui,sans-serif}.hcm-row strong{font-weight:700}.hcm-row span{color:var(--muted)}.hcm-row em{color:var(--accent);font:.66rem/1.3 system-ui,sans-serif;font-style:normal;white-space:nowrap}.muted{color:var(--muted);font:.76rem/1.4 system-ui,sans-serif}.people-boundary{display:flex;justify-content:space-between;gap:25px;align-items:center;margin-top:52px;padding:30px;border-radius:20px;background:#f7eaf0}.people-boundary h2{margin:9px 0 12px;font:500 2rem/1 Georgia,serif}.people-boundary h2 em{color:#9d4f74;font-style:normal}.people-boundary p{max-width:600px;color:var(--muted);font:.82rem/1.6 system-ui,sans-serif}.boundary-button{padding:13px 16px;border-radius:10px;background:#4d2e41;color:#fff;white-space:nowrap;font:700 .76rem/1 system-ui,sans-serif}.boundary-button:hover{color:#fff;background:#7d3f60}@media(max-width:900px){.people-metrics{grid-template-columns:repeat(3,1fr)}}@media(max-width:760px){.people-hero{grid-template-columns:1fr}.people-orb{width:160px;height:160px;margin:0}.people-metrics{grid-template-columns:repeat(2,1fr)}.people-boundary{align-items:flex-start;flex-direction:column}}@media(max-width:500px){.people-shell{padding:24px 15px 55px}.people-hero{padding:28px 22px}.people-metrics{grid-template-columns:1fr}.hcm-row{grid-template-columns:1fr;gap:5px}.hcm-row em{white-space:normal}}
</style>
