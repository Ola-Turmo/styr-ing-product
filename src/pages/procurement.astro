---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Innkjøp og leverandører" activeNav="procurement"><main class="p-shell"><section class="p-hero"><div><span class="eyebrow">Styr.ing · procure-to-pay</span><h1>Fra bestilling til bilag.<br /><em>Med kontroll i mellom.</em></h1><p>Se hva som er bestilt, mottatt og fakturert før noen godkjenner betaling. EHF og bank er tydelig stoppet til adaptere og avtaler er på plass.</p><a href="#p-work" class="primary">Åpne innkjøpssporet ↓</a></div><div class="p-orb"><strong id="hero-exceptions">—</strong><span>avvik å følge</span><small id="hero-invoices">— i kø</small></div></section><section class="metrics"><article><span>Åpne bestillinger</span><strong id="m-orders">—</strong><small>totalverdi</small></article><article><span>Mottak bekreftet</span><strong id="m-receipts">—</strong><small>med dokumentasjon</small></article><article><span>Fakturakø</span><strong id="m-invoices">—</strong><small>før bokføring</small></article><article class="dark"><span>Ekstern betaling</span><strong>STOPP</strong><small>EHF/bank-adapter ikke aktivert</small></article></section><section id="p-work" class="workspace"><div class="head"><div><span class="kicker">Treveis matching</span><h2>Innkjøp og leverandører</h2></div><span id="status">Henter…</span></div><nav class="tabs">{[['orders','Bestillinger'],['receipts','Mottak'],['invoices','Fakturaer']].map(([key,label],i)=><button class={i===0?'active':''} data-view={key}>{label}</button>)}</nav><div id="list"></div></section><section class="notice"><strong>Produksjonsgrense</strong><p>Dette er et internt kontrollspor. Faktisk EHF-mottak, leverandørportal, attestasjon med juridisk virkning og bankbetaling krever leverandøravtaler, nøkler, fullmaktsmatrise og menneskelig godkjenning.</p></section></main></Layout>
<script is:inline>
const esc=v=>String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));const list=document.getElementById('list'),status=document.getElementById('status');const pill=v=>`<em class="pill">${esc(v||'—')}</em>`;const money=n=>`${new Intl.NumberFormat('nb-NO').format(Number(n||0)/100)} NOK`;const render=(view,rows)=>{const f={orders:r=>`<article><div><strong>${esc(r.order_number)} · ${esc(r.supplier_name)}</strong><p>${esc(r.requested_by||'Ukjent bestiller')} · ${esc(r.external_reference||'Intern bestilling')}</p></div>${pill(r.status)}<b>${money(r.total_minor)}</b></article>`,receipts:r=>`<article><div><strong>${esc(r.order_number)} · mottak</strong><p>${esc(r.received_date)} · ${esc(r.received_by||'Ukjent mottaker')}</p></div>${pill(r.status)}<small>${esc(r.notes||'Dokumentasjon ikke angitt')}</small></article>`,invoices:r=>`<article><div><strong>${esc(r.invoice_number)} · ${esc(r.supplier_name)}</strong><p>${esc(r.order_number||'Uten bestilling')} · Forfaller ${esc(r.due_date||'—')}</p></div>${pill(r.match_status)}<b>${money(r.amount_minor)}</b></article>`};list.innerHTML=rows.length?rows.map(f[view]).join(''):'<p class="empty">Ingen registrerte rader.</p>';};const load=async view=>{try{const d=await (await fetch(`/api/procurement?boardId=board-1&view=${view}`)).json();render(view,d.data||[]);status.textContent=`${(d.data||[]).length} poster · kilde synlig`;}catch{status.textContent='API utilgjengelig'}};const summary=async()=>{try{const d=(await (await fetch('/api/procurement?boardId=board-1&view=summary')).json()).data||{};document.getElementById('m-orders').textContent=d.orders?.count??0;document.getElementById('m-receipts').textContent=d.receipts?.count??0;document.getElementById('m-invoices').textContent=money(d.invoices?.amount_minor);document.getElementById('hero-exceptions').textContent=d.exceptions?.count??0;document.getElementById('hero-invoices').textContent=`${d.invoices?.count??0} fakturaer i kø`;}catch{}};document.querySelectorAll('.tabs button').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.tabs button').forEach(x=>x.classList.remove('active'));b.classList.add('active');load(b.dataset.view)}));summary();load('orders');
</script>
<style>.p-shell{max-width:1180px;margin:0 auto;padding:38px 24px 80px}.p-hero{display:grid;grid-template-columns:1fr .45fr;align-items:center;gap:24px;padding:44px;border-radius:27px;background:linear-gradient(120deg,#193f3a,#2f7a6e);color:#fff}.eyebrow,.kicker{font:700 .68rem system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:#c8f2d0}.p-hero h1{margin:20px 0 16px;font:500 clamp(2.5rem,5vw,4.4rem)/.96 Georgia,serif}.p-hero h1 em{color:#bff2cb;font-style:normal}.p-hero p{max-width:570px;color:#ffffffbf;font:1rem/1.6 system-ui,sans-serif}.primary{display:inline-flex;margin-top:22px;padding:13px 17px;border-radius:10px;background:#c8f2d0;color:#174139;font:700 .78rem system-ui,sans-serif}.p-orb{width:190px;height:190px;display:flex;flex-direction:column;align-items:center;justify-content:center;border:1px solid #c8f2d088;border-radius:50%;background:#1c574d;color:#fff}.p-orb strong{font:500 3.2rem Georgia,serif;color:#c8f2d0}.p-orb span,.p-orb small{font:.68rem system-ui,sans-serif}.p-orb small{margin-top:9px;color:#b8e4c5}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:16px 0 52px}.metrics article{min-height:105px;padding:17px;border:1px solid #10241f14;border-radius:15px;background:#fff;display:flex;flex-direction:column;justify-content:space-between}.metrics .dark{background:#10241f;color:#fff}.metrics span,.metrics small{color:#718078;font:600 .67rem system-ui,sans-serif}.metrics strong{font:500 1.7rem Georgia,serif}.workspace{padding:28px;border:1px solid #10241f18;border-radius:20px;background:#fff}.head{display:flex;justify-content:space-between;align-items:end}.head h2{margin:9px 0 0;font:500 2.1rem Georgia,serif}.head>span{color:#718078;font:.7rem system-ui,sans-serif}.tabs{display:flex;gap:6px;overflow:auto;margin:25px 0 12px}.tabs button{padding:10px 14px;border:1px solid #10241f1c;border-radius:9px;background:#fafbf9;color:#65746b;cursor:pointer;font:700 .72rem system-ui,sans-serif}.tabs button.active{background:#2f7a6e;color:#fff}.workspace article{display:grid;grid-template-columns:1.6fr auto auto;gap:12px;align-items:center;padding:15px 4px;border-top:1px solid #10241f12}.workspace strong{font:600 .82rem system-ui,sans-serif}.workspace p,.workspace small{margin:5px 0 0;color:#718078;font:.7rem/1.35 system-ui,sans-serif}.pill{padding:5px 8px;border-radius:999px;background:#e7f6eb;color:#2f7a6e;font:700 .61rem system-ui,sans-serif;font-style:normal;white-space:nowrap}.notice{margin-top:35px;padding:22px 25px;border-radius:16px;background:#e8f5eb}.notice strong{font:700 .78rem system-ui,sans-serif}.notice p{margin:8px 0 0;color:#63736a;font:.78rem/1.5 system-ui,sans-serif}@media(max-width:800px){.p-hero{grid-template-columns:1fr}.metrics{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.p-shell{padding:20px 15px 55px}.p-hero{padding:28px 22px}.metrics{grid-template-columns:1fr}.workspace{padding:20px 16px}.workspace article{grid-template-columns:1fr auto}.workspace article small{grid-column:1}}
</style>
