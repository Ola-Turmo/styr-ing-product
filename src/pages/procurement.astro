---
import Layout from '../layouts/Layout.astro';
import EHFInboxQuick from '../components/EHFInboxQuick.astro';
---
<Layout title="Innkjøp og fakturakontroll" activeNav="procurement">
  <main class="p-shell">
    <EHFInboxQuick />
    <section class="p-hero"><div><span class="eyebrow">Styr.ing · procure-to-pay</span><h1>Fra bestilling til bokføring.<br /><em>Med kontroll i hvert steg.</em></h1><p>Opprett innkjøpsordrer, registrer varemottak og match leverandørfakturaer i ett spor. Ingen betaling eller EHF sendes automatisk.</p><a class="primary" href="#p-work">Åpne innkjøpskontrollen ↓</a></div><div class="p-orb"><strong id="hero-orders">—</strong><span>aktive ordre</span><small id="hero-exceptions">— avvik</small></div></section>
    <section class="metrics"><article><span>Åpne innkjøpsordrer</span><strong id="m-orders">—</strong><small id="m-orders-total">—</small></article><article><span>Bekreftede mottak</span><strong id="m-receipts">—</strong><small>grunnlag for matching</small></article><article><span>EHF i kontroll</span><strong id="m-ehf">—</strong><small>transport ikke aktivert</small></article><article class="dark"><span>Match-avvik</span><strong id="m-exceptions">—</strong><small>krever menneskelig vurdering</small></article></section>
    <section id="p-work" class="workspace"><div class="head"><div><span class="kicker">Innkjøpsspor</span><h2>Ordre, mottak, EHF og faktura</h2></div><span id="status">Henter…</span></div><nav class="tabs"><button class="active" data-view="orders">Ordrer</button><button data-view="receipts">Mottak</button><button data-view="ehf">EHF-inbox</button><button data-view="invoices">Fakturaer</button></nav><div id="list"></div></section>
    <section class="actions"><div><span class="kicker">Kontrollert registrering</span><h2>Legg neste kjøp i sporet.</h2><p>Skrivetilgang krever eier- eller redaktørrolle. Treveis matching blokkeres når ordre eller bekreftet mottak mangler.</p></div><div class="action-grid">
      <form id="order-form"><strong>Ny innkjøpsordre</strong><label>Ordrenummer<input name="orderNumber" required maxlength="60" placeholder="PO-2026-014" /></label><label>Leverandør<input name="supplierName" required maxlength="200" placeholder="Leverandør AS" /></label><label>Beløp (NOK)<input name="total" type="number" min="0" step="0.01" required placeholder="12500" /></label><button type="submit">Opprett ordre</button></form>
      <form id="receipt-form"><strong>Registrer varemottak</strong><label>Ordre<select name="orderId" id="receipt-order" required></select></label><label>Dato<input name="receivedDate" type="date" required /></label><label>Status<select name="receiptStatus"><option value="confirmed">Bekreftet</option><option value="disputed">Avvik</option><option value="draft">Kladd</option></select></label><label>Notat<input name="notes" maxlength="500" placeholder="Alt mottatt" /></label><button type="submit">Lagre mottak</button></form>
      <form id="invoice-form"><strong>Ny leverandørfaktura</strong><label>Fakturanummer<input name="invoiceNumber" required maxlength="80" placeholder="INV-8842" /></label><label>Leverandør<input name="supplierName" required maxlength="200" placeholder="Leverandør AS" /></label><label>Beløp (NOK)<input name="amount" type="number" min="0" step="0.01" required placeholder="12500" /></label><label>Forfallsdato<input name="dueDate" type="date" required /></label><label>Ordre (valgfritt)<select name="orderId" id="invoice-order"><option value="">Ingen kobling</option></select></label><button type="submit">Registrer faktura</button></form>
      <form id="ehf-form"><strong>Ta imot EHF-grunnlag</strong><label>Dokumentreferanse<input name="documentRef" required maxlength="120" placeholder="urn:invoice:2026-001" /></label><label>Leverandør<input name="supplierName" required maxlength="200" placeholder="Leverandør AS" /></label><div class="form-row"><label>Fakturanummer<input name="invoiceNumber" required maxlength="80" placeholder="INV-8842" /></label><label>Beløp (NOK)<input name="amount" type="number" min="0.01" step="0.01" required placeholder="12500" /></label></div><div class="form-row"><label>Fakturadato<input name="issueDate" type="date" required /></label><label>Forfall<input name="dueDate" type="date" required /></label></div><button type="submit">Registrer EHF-grunnlag</button><small>EHF/PEPPOL-transport er ikke konfigurert.</small></form>
      <form id="ehf-validate-form"><strong>Valider EHF</strong><label>Dokument<select name="ehfId" id="validate-ehf" required></select></label><button type="submit">Valider felt</button><small>Validering oppretter ikke bokføring.</small></form>
      <form id="ehf-link-form"><strong>Koble til fakturaflyt</strong><label>Validert dokument<select name="ehfId" id="link-ehf" required></select></label><button type="submit">Opprett leverandørfaktura</button><small>Deretter må ordre, mottak og godkjenning kontrolleres.</small></form>
      <form id="match-form"><strong>Treveis matching</strong><label>Faktura<select name="invoiceId" id="match-invoice" required></select></label><button type="submit">Match mot ordre og mottak</button><small>Matching setter status til «matchet» og krever deretter godkjenning.</small></form>
      <form id="approve-order-form"><strong>Godkjenn ordre</strong><label>Ordre til godkjenning<select name="orderId" id="approve-order" required></select></label><button type="submit">Godkjenn ordre</button><small>Godkjenning sender ikke ordren til leverandøren.</small></form>
      <form id="attest-invoice-form"><strong>1 · Attester faktura</strong><label>Matchet faktura<select name="invoiceId" id="attest-invoice" required></select></label><button type="submit">Attester kontrollgrunnlag</button><small>Attestasjon bekrefter faktura, ordre og mottak. Den gir ikke betalingsfullmakt.</small></form>
      <form id="assign-invoice-form"><strong>2 · Anvis faktura</strong><label>Attestert faktura<select name="invoiceId" id="assign-invoice" required></select></label><button type="submit">Anvis for neste steg</button><small>Anvisning krever attestasjon først. Betaling og bokføring utføres fortsatt ikke automatisk.</small></form>
    </div><p id="action-status" class="action-status" role="status" hidden></p></section>
    <section class="notice"><strong>Kontrollgrense</strong><p>Styr.ing oppretter og dokumenterer intern arbeidsdata. EHF-utsending, bankavstemming, bokføring, betaling og attestasjon krever konfigurerte adaptere, fullmakter og eksplisitt menneskelig godkjenning.</p></section>
  </main>
</Layout>
<script is:inline>
  const esc=(v)=>String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
  const boardId=new URLSearchParams(location.search).get('boardId')||'board-1'; const list=document.getElementById('list'); const status=document.getElementById('status'); const actionStatus=document.getElementById('action-status');
  const labels={draft:'Kladd',pending_approval:'Til godkjenning',approved:'Anvist',ordered:'Bestilt',received:'Mottatt',closed:'Lukket',received_invoice:'Mottatt',matched:'Matchet',attested:'Attestert',assigned:'Anvist',exception:'Avvik',confirmed:'Bekreftet',disputed:'Avvik'};
  const api=async(path,opt)=>{const r=await fetch(path,opt);const d=await r.json();if(!r.ok)throw new Error(d.error||'request_failed');return d}; const money=(minor,currency='NOK')=>new Intl.NumberFormat('nb-NO',{style:'currency',currency}).format((Number(minor)||0)/100);
  const pill=(v)=>`<em class="pill">${esc(labels[v]||v||'—')}</em>`;
  const render=(view,rows)=>{const f={orders:r=>`<article><div><strong>${esc(r.order_number)} · ${esc(r.supplier_name)}</strong><p>${money(r.total_minor,r.currency)} · opprettet ${esc(r.created_at||'')}</p></div>${pill(r.status)}<small>${esc(r.requested_by||'—')}</small></article>`,receipts:r=>`<article><div><strong>${esc(r.order_number)} · ${esc(r.supplier_name)}</strong><p>${esc(r.received_date)} · ${esc(r.notes||'Ingen notat')}</p></div>${pill(r.status)}<small>${esc(r.received_by||'—')}</small></article>`,invoices:r=>{const stage=r.assigned_at?'assigned':r.attested_at?'attested':r.match_status||r.status;const trace=r.assigned_at?`Anvist av ${r.assigned_by||'ukjent'}`:r.attested_at?`Attestert av ${r.attested_by||'ukjent'}`:r.order_number||'Ingen ordre';return `<article><div><strong>${esc(r.invoice_number)} · ${esc(r.supplier_name)}</strong><p>${money(r.amount_minor,r.currency)} · forfall ${esc(r.due_date||'—')}</p></div>${pill(stage)}<small>${esc(trace)}</small></article>`}};list.innerHTML=rows.length?rows.map(f[view]).join(''):'<p class="empty">Ingen registrerte rader.</p>'};
  const load=async(view)=>{try{const d=await api(`/api/procurement?boardId=${encodeURIComponent(boardId)}&view=${view}`);render(view,d.data||[]);status.textContent=`${(d.data||[]).length} poster · kilde synlig`}catch{status.textContent='API utilgjengelig'}};
  const summary=async()=>{try{const d=(await api(`/api/procurement?boardId=${encodeURIComponent(boardId)}&view=summary`)).data||{};document.getElementById('m-orders').textContent=d.orders?.count??0;document.getElementById('hero-orders').textContent=d.orders?.count??0;document.getElementById('m-orders-total').textContent=money(d.orders?.total_minor);document.getElementById('m-receipts').textContent=d.receipts?.count??0;document.getElementById('m-invoices').textContent=d.invoices?.count??0;document.getElementById('m-invoice-total').textContent=money(d.invoices?.amount_minor);document.getElementById('m-exceptions').textContent=d.exceptions?.count??0;document.getElementById('hero-exceptions').textContent=`${d.exceptions?.count??0} avvik`;}catch{}}
  const refreshOptions=async()=>{try{const [o,i]=await Promise.all(['orders','invoices'].map(v=>api(`/api/procurement?boardId=${encodeURIComponent(boardId)}&view=${v}`)));document.getElementById('receipt-order').innerHTML=(o.data||[]).filter(r=>!['closed','cancelled'].includes(r.status)).map(r=>`<option value="${esc(r.id)}">${esc(r.order_number)} · ${esc(r.supplier_name)}</option>`).join('');document.getElementById('invoice-order').innerHTML='<option value="">Ingen kobling</option>'+(o.data||[]).map(r=>`<option value="${esc(r.id)}">${esc(r.order_number)} · ${esc(r.supplier_name)}</option>`).join('');document.getElementById('approve-order').innerHTML=(o.data||[]).filter(r=>r.status==='pending_approval').map(r=>`<option value="${esc(r.id)}">${esc(r.order_number)} · ${esc(r.supplier_name)}</option>`).join('');document.getElementById('match-invoice').innerHTML=(i.data||[]).filter(r=>r.status==='received').map(r=>`<option value="${esc(r.id)}">${esc(r.invoice_number)} · ${esc(r.supplier_name)}</option>`).join('');document.getElementById('attest-invoice').innerHTML=(i.data||[]).filter(r=>r.status==='matched'&&r.match_status==='matched'&&!r.attested_at).map(r=>`<option value="${esc(r.id)}">${esc(r.invoice_number)} · ${esc(r.supplier_name)}</option>`).join('');document.getElementById('assign-invoice').innerHTML=(i.data||[]).filter(r=>r.status==='matched'&&r.match_status==='matched'&&r.attested_at&&!r.assigned_at).map(r=>`<option value="${esc(r.id)}">${esc(r.invoice_number)} · attestert av ${esc(r.attested_by||'ukjent')}</option>`).join('')}catch{setActionStatus('Skjemaene kunne ikke lastes.',true)}};
  const post=async(payload)=>{await api('/api/procurement',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({boardId,...payload})});setActionStatus('Endringen er lagret og auditert.');await Promise.all([summary(),refreshOptions(),load(document.querySelector('.tabs button.active')?.dataset.view||'orders')])};
  document.querySelectorAll('.tabs button').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.tabs button').forEach(x=>x.classList.remove('active'));b.classList.add('active');load(b.dataset.view)}));
  document.getElementById('order-form').addEventListener('submit',async e=>{e.preventDefault();const f=new FormData(e.currentTarget);try{await post({action:'create_order',orderNumber:f.get('orderNumber'),supplierName:f.get('supplierName'),totalMinor:Math.round(Number(f.get('total'))*100),currency:'NOK'});e.currentTarget.reset()}catch(err){setActionStatus(err.message==='write_not_authorized'?'Du trenger eier- eller redaktørrolle for å opprette ordre.':'Ordren kunne ikke opprettes.',true)}});
  document.getElementById('receipt-form').addEventListener('submit',async e=>{e.preventDefault();const f=new FormData(e.currentTarget);try{await post({action:'create_receipt',purchaseOrderId:f.get('orderId'),receivedDate:f.get('receivedDate'),status:f.get('receiptStatus'),notes:f.get('notes')});e.currentTarget.reset()}catch{setActionStatus('Mottaket kunne ikke lagres.',true)}});
  document.getElementById('invoice-form').addEventListener('submit',async e=>{e.preventDefault();const f=new FormData(e.currentTarget);try{await post({action:'create_invoice',invoiceNumber:f.get('invoiceNumber'),supplierName:f.get('supplierName'),amountMinor:Math.round(Number(f.get('amount'))*100),currency:'NOK',dueDate:f.get('dueDate'),purchaseOrderId:f.get('orderId')||null});e.currentTarget.reset()}catch{setActionStatus('Fakturaen kunne ikke registreres.',true)}});
  document.getElementById('match-form').addEventListener('submit',async e=>{e.preventDefault();const f=new FormData(e.currentTarget);try{await post({action:'match_invoice',invoiceId:f.get('invoiceId')})}catch(err){setActionStatus(err.message==='three_way_match_required'?'Matching blokkert: ordre og bekreftet mottak må finnes.':'Fakturaen kunne ikke matches.',true)}});
  document.getElementById('approve-order-form').addEventListener('submit',async e=>{e.preventDefault();const f=new FormData(e.currentTarget);try{await post({action:'approve_order',orderId:f.get('orderId')})}catch{setActionStatus('Ordren kunne ikke godkjennes.',true)}});
  document.getElementById('attest-invoice-form').addEventListener('submit',async e=>{e.preventDefault();const f=new FormData(e.currentTarget);try{await post({action:'attest_invoice',invoiceId:f.get('invoiceId')})}catch{setActionStatus('Fakturaen kunne ikke attesteres.',true)}});
  document.getElementById('assign-invoice-form').addEventListener('submit',async e=>{e.preventDefault();const f=new FormData(e.currentTarget);try{await post({action:'assign_invoice',invoiceId:f.get('invoiceId')})}catch(err){setActionStatus(err.message==='four_eyes_required'?'Anvisning krever en annen person enn attestanten, med mindre eierrollen overstyrer.':'Fakturaen kunne ikke anvises.',true)}});
  const setActionStatus=(m,error=false)=>{actionStatus.hidden=!m;actionStatus.textContent=m||'';actionStatus.classList.toggle('error',error)};Promise.all([summary(),refreshOptions(),load('orders')]);
</script>
<style>
  .p-shell{max-width:1180px;margin:0 auto;padding:38px 24px 80px}.p-hero{display:grid;grid-template-columns:1fr .45fr;align-items:center;gap:24px;padding:44px;border-radius:27px;background:linear-gradient(120deg,#173d36,#28746c);color:#fff}.eyebrow,.kicker{font:700 .68rem system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:#c6eff0}.p-hero h1{margin:20px 0 16px;font:500 clamp(2.5rem,5vw,4.4rem)/.96 Georgia,serif}.p-hero h1 em{color:#bce9e6;font-style:normal}.p-hero p{max-width:570px;color:#ffffffbf;font:1rem/1.6 system-ui,sans-serif}.primary{display:inline-flex;margin-top:22px;padding:13px 17px;border-radius:10px;background:#bce9e6;color:#173d36;font:700 .78rem system-ui,sans-serif}.p-orb{width:190px;height:190px;display:flex;flex-direction:column;align-items:center;justify-content:center;border:1px solid #bce9e6aa;border-radius:50%;background:#206057}.p-orb strong{font:500 3.2rem Georgia,serif;color:#c6eff0}.p-orb span,.p-orb small{font:.68rem system-ui,sans-serif}.p-orb small{margin-top:9px;color:#b4dcdd}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:16px 0 52px}.metrics article{min-height:105px;padding:17px;border:1px solid #10241f14;border-radius:15px;background:#fff;display:flex;flex-direction:column;justify-content:space-between}.metrics .dark{background:#10241f;color:#fff}.metrics span,.metrics small{color:#718078;font:600 .67rem system-ui,sans-serif}.metrics strong{font:500 1.55rem Georgia,serif}.workspace{padding:28px;border:1px solid #10241f18;border-radius:20px;background:#fff}.head{display:flex;justify-content:space-between;align-items:end}.head h2{margin:9px 0 0;font:500 2.1rem Georgia,serif}.head>span{color:#718078;font:.7rem system-ui,sans-serif}.tabs{display:flex;gap:6px;overflow:auto;margin:25px 0 12px}.tabs button{padding:10px 14px;border:1px solid #10241f1c;border-radius:9px;background:#fafbf9;color:#65746b;cursor:pointer;font:700 .72rem system-ui,sans-serif;white-space:nowrap}.tabs button.active{background:#28746c;color:#fff}.workspace article{display:grid;grid-template-columns:1.6fr auto auto;gap:12px;align-items:center;padding:15px 4px;border-top:1px solid #10241f12}.workspace strong{font:600 .82rem system-ui,sans-serif}.workspace p{margin:5px 0 0;color:#718078;font:.7rem/1.35 system-ui,sans-serif}.pill{padding:5px 8px;border-radius:999px;background:#e8f5f5;color:#32717a;font:700 .61rem system-ui,sans-serif;font-style:normal;white-space:nowrap}.actions{display:grid;grid-template-columns:.7fr 1.3fr;gap:25px;margin-top:32px;padding:28px;border:1px solid #10241f18;border-radius:20px;background:#f5faf3}.actions h2{margin:10px 0 8px;font:500 1.8rem/1.05 Georgia,serif}.actions p{color:#63736a;font:.78rem/1.5 system-ui,sans-serif}.action-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.action-grid form{display:grid;gap:8px;padding:16px;border:1px solid #10241f14;border-radius:12px;background:#fff}.action-grid strong{font:700 .78rem system-ui,sans-serif}.action-grid label{display:grid;gap:4px;color:#63736a;font:600 .64rem system-ui,sans-serif}.action-grid input,.action-grid select{width:100%;padding:9px;border:1px solid #10241f1c;border-radius:7px;background:#fff;font:.72rem system-ui,sans-serif}.action-grid button{padding:9px;border:0;border-radius:8px;background:#28746c;color:#fff;cursor:pointer;font:700 .68rem system-ui,sans-serif}.action-grid small{color:#718078;font:.62rem/1.35 system-ui,sans-serif}.action-status{grid-column:1/-1;margin:5px 0 0;padding:9px 11px;border-radius:8px;background:#e2f3e5;color:#286447;font:700 .68rem system-ui,sans-serif}.action-status.error{background:#fae8e5;color:#97443d}.notice{margin-top:35px;padding:22px 25px;border-radius:16px;background:#e7f4f4}.notice strong{font:700 .78rem system-ui,sans-serif}.notice p{margin:8px 0 0;color:#63736a;font:.78rem/1.5 system-ui,sans-serif}.empty{color:#718078;font:.75rem system-ui,sans-serif}@media(max-width:900px){.p-hero{grid-template-columns:1fr}.metrics{grid-template-columns:repeat(2,1fr)}.actions{grid-template-columns:1fr}}@media(max-width:560px){.p-shell{padding:20px 15px 55px}.p-hero{padding:28px 22px}.metrics{grid-template-columns:1fr}.workspace{padding:20px 16px}.workspace article{grid-template-columns:1fr auto}.workspace article small{grid-column:1}.action-grid{grid-template-columns:1fr}.actions{padding:20px 16px}}
</style>
