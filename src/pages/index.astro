---
import Layout from '../layouts/Layout.astro';
const capabilities = [
  ['⌁', 'Styrearbeid', 'Møter, sakspapirer, vedtak og protokoller i én struktur.'],
  ['◈', 'Risiko og GRC', 'Få oversikt over risiko, hendelser, indikatorer og tiltak.'],
  ['✓', 'Internkontroll', 'Knytt kontroller til ansvar, bevis og oppfølging.'],
  ['◒', 'Frister og oppgaver', 'Fra styrevedtak til tydelig eier, frist og status.'],
  ['＋', 'Mennesker og policy', 'Roller, håndbok, OKR og opplæring på samme sted.'],
  ['⌂', 'Økonomi og leverandører', 'Gjør budsjett, avtaler og innkjøpssporet lesbart.'],
  ['◎', 'Kunder og inntekter', 'Følg pipeline, tilbud, salgsrom, abonnement og kundesaker.'],
  ['◫', 'Avtaler og eierskap', 'Hold kontrakter, fullmakter og eierskap i samme spor.'],
  ['✦', 'HMS og ESG', 'Følg avvik, SJA, karbon og leverandøraktsomhet.'],
];
const platformDomains = [
  ['Mennesker', 'HR, rekruttering, OKR, håndbok, LMS og lønnsgrunnlag.'],
  ['Økonomi', 'Regnskap, SAF-T, EHF, bank, skatt, lønn, likviditet og prosjekt.'],
  ['Kunder', 'CRM, tilbud, salgsrom, abonnement og service desk.'],
  ['Drift', 'ITSM, utstyr, SaaS-forbruk, kjørebok, flåte og FDV.'],
  ['Felt og prosjekt', 'Kjørebok, vedlikehold, FDV, timeføring og prosjektøkonomi.'],
  ['Eierskap', 'Styre, vedtak, avtaler, fullmakter, cap table og ESOP.'],
  ['Kontroll', 'Risiko, HMS, internkontroll, ESG og Åpenhetsloven.'],
  ['Finansiering', 'Likviditet, kort, betaling, purring og inkassoflyt — alltid med kontroll før sending.'],
   ['Plattform', 'Universelt søk med kilder, hendelser, API, MCP og KI-utkast med menneskelig godkjenning.'],
];
---
<Layout title="Styrearbeid med retning" activeNav="home">
  <main class="landing">
    <section class="landing-hero"><div class="hero-copy"><span class="eyebrow"><i></i>Norsk SaaS for bedre styring</span><h1>Gjør det komplekse<br /><em>lett å styre.</em></h1><p>Styr.ing samler styrearbeid, risiko, internkontroll og oppfølging i én rolig arbeidsflate — slik at flere ser hva som skjer, hva som mangler og hva som må besluttes.</p><div class="hero-cta"><a class="button button-primary" href="/workspace">Utforsk arbeidsflaten <span>↗</span></a><a class="button button-ghost" href="#capabilities">Se hva som er mulig <span>↓</span></a></div><div class="hero-proof"><span><b>01</b> Norske arbeidsmønstre</span><span><b>02</b> Mennesket i kontroll</span><span><b>03</b> Ett spor fra sak til handling</span></div></div><div class="hero-visual"><div class="visual-window"><div class="window-bar"><span class="window-brand"><i>s</i> styr.ing</span><span class="window-context">Pilotselskap AS · <b>Q2 2026</b></span></div><div class="window-body"><aside><span class="aside-active">⌁ <b>Oversikt</b></span><span>◈ Risiko</span><span>✓ Kontroll</span><span>＋ Oppgaver</span><span>⌂ Dokumenter</span></aside><div class="window-main"><div class="mini-heading"><div><small>God morgen, Ola</small><strong>Her er det viktigste nå.</strong></div><span class="mini-avatar">OT</span></div><div class="mini-stats"><div><small>Neste møte</small><b>15. juni</b><em>8 saker</em></div><div><small>Åpne oppgaver</small><b>6</b><em class="orange">2 høy prioritet</em></div><div><small>Kontrollstatus</small><b>94%</b><em class="green">+6% siste kvartal</em></div></div><div class="mini-chart"><div class="chart-head"><b>Kontroll og oppfølging</b><span>6 måneder ↗</span></div><div class="bars"><i style="height:44%"></i><i style="height:57%"></i><i style="height:52%"></i><i style="height:72%"></i><i style="height:66%"></i><i style="height:87%"></i><i style="height:94%"></i></div><div class="chart-labels"><span>Jan</span><span>Feb</span><span>Mar</span><span>Apr</span><span>Mai</span><span>Jun</span><span>Nå</span></div></div><div class="mini-task"><span class="task-dot"></span><div><b>Budsjett H2 2026 er klart for behandling</b><small>CFO · Frist 30. mai</small></div><span class="task-pill">Til behandling</span></div></div></div></div><div class="float-card float-top"><span class="float-icon">✦</span><div><small>Styr.assistent</small><b>3 punkter krever oppmerksomhet</b></div></div><div class="float-card float-bottom"><span class="float-check">✓</span><div><small>Kontrollbevis</small><b>Dokumentert i dag</b></div></div></div></section>
    <section class="capability-intro" id="capabilities"><span class="section-kicker">Én arbeidsflate</span><h2>Fra styrebordet til<br /><em>hele virksomheten.</em></h2><p>Se sammenhengen mellom beslutninger, mennesker, risiko og dokumentasjon — uten å hoppe mellom verktøy.</p></section>
    <section class="capability-grid">{capabilities.map((item, index) => <a href={index === 0 ? '/board' : index === 1 ? '/risk' : index === 2 ? '/internkontroll' : index === 3 ? '/compliance' : index === 6 ? '/commercial' : index === 7 ? '/governance' : index === 8 ? '/sustainability' : index === 9 ? '/field' : '/workspace'} class={`capability capability-${index}`}><span class="cap-icon">{item[0]}</span><span class="cap-number">0{index + 1}</span><h3>{item[1]}</h3><p>{item[2]}</p><span class="cap-arrow">↗</span></a>)}</section>
    <section class="platform-section"><div class="platform-head"><div><span class="section-kicker">Hele virksomheten</span><h2>Én rolig inngang.<br /><em>Åtte sammenhengende områder.</em></h2></div><p>Begynn med det som haster. Behold sammenhengen når virksomheten vokser. Integrasjoner aktiveres først når avtaler, tilgang og sikkerhet er på plass.</p></div><div class="platform-grid">{platformDomains.map((item, index) => <a href="/capabilities"><span>{String(index + 1).padStart(2,'0')}</span><div><h3>{item[0]}</h3><p>{item[1]}</p></div><b>↗</b></a>)}</div><div class="platform-status"><div><i></i><span><strong>Frontend</strong> Arbeidsflater, filtre, gjennomgang og eksport</span></div><div><i></i><span><strong>Backend</strong> D1-datamodell, API-kontrakt, hendelser og state</span></div><div><i class="pending"></i><span><strong>Eksterne adaptere</strong> Krever leverandøravtaler og produksjonsgodkjenning</span></div></div></section>
    <section class="signal-section"><div class="signal-copy"><span class="section-kicker">Bygget for beslutninger</span><h2>Gode møter skaper<br /><em>gode spor.</em></h2><p>Et vedtak er først nyttig når noen vet hva det betyr, hvem som eier det og når det skal følges opp. Styr.ing holder hele tråden synlig.</p><a class="button button-dark" href="/board/board-1">Se et illustrert møteforløp <span>↗</span></a></div><div class="signal-steps"><div class="signal-step"><span>01</span><div><b>Forbered</b><p>Samle agenda, dokumenter og beslutningsgrunnlag.</p></div></div><div class="signal-step active"><span>02</span><div><b>Beslutt</b><p>Gjør sak, ansvar og utfall tydelig for alle.</p></div></div><div class="signal-step"><span>03</span><div><b>Følg opp</b><p>La oppgaver, kontroller og frister leve videre.</p></div></div></div></section>
    <section class="final-cta"><span class="section-kicker">Klarere styring starter her</span><h2>Se hva som blir<br /><em>mulig når alt henger sammen.</em></h2><p>Utforsk den offentlige arbeidsflaten med fiktive data. Søk på tvers av virksomheten med synlige kilder, eller se hvordan AI-utkast alltid stopper for menneskelig godkjenning.</p><a class="button button-primary" href="/workspace#search">Prøv arbeidsflaten <span>↗</span></a></section>
  </main>
</Layout>
<style>
  .platform-section{max-width:1180px;margin:0 auto 80px;padding:64px 24px;background:#10241f;color:#fff}.platform-head{display:grid;grid-template-columns:1.1fr .9fr;gap:50px;align-items:end;margin-bottom:30px}.platform-head h2{font-size:clamp(2.3rem,4vw,3.4rem);line-height:1;letter-spacing:-.05em;font-weight:500;margin:14px 0 0}.platform-head h2 em{color:#c4ef8c;font-style:normal}.platform-head>p{color:#a8bab2;font:.86rem/1.65 system-ui,sans-serif;margin:0}.platform-grid{display:grid;grid-template-columns:repeat(2,1fr);border:1px solid rgba(255,255,255,.12);border-radius:14px;overflow:hidden}.platform-grid a{display:grid;grid-template-columns:35px 1fr 20px;gap:12px;align-items:start;padding:18px;color:#fff;border-bottom:1px solid rgba(255,255,255,.1);border-right:1px solid rgba(255,255,255,.1)}.platform-grid a:hover{background:rgba(255,255,255,.05)}.platform-grid span{color:#c4ef8c;font:700 .64rem/1 system-ui,sans-serif}.platform-grid h3{margin:0 0 6px;font:600 .9rem/1 system-ui,sans-serif}.platform-grid p{margin:0;color:#9fb0a8;font:.72rem/1.45 system-ui,sans-serif}.platform-grid b{color:#c4ef8c}.platform-status{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:18px}.platform-status>div{display:flex;gap:9px;align-items:flex-start;padding:12px;border-radius:9px;background:rgba(255,255,255,.04);color:#9fb0a8;font:.68rem/1.45 system-ui,sans-serif}.platform-status strong{display:block;color:#fff;margin-bottom:2px}.platform-status i{width:7px;height:7px;margin-top:3px;flex-shrink:0;border-radius:50%;background:#79ca82}.platform-status i.pending{background:#d5a24c}
  .landing{overflow:hidden}.landing-hero{max-width:1180px;margin:0 auto;padding:74px 24px 82px;display:grid;grid-template-columns:.9fr 1.1fr;gap:34px;align-items:center}.eyebrow,.section-kicker{font:700 .69rem/1 system-ui,sans-serif;letter-spacing:.15em;text-transform:uppercase}.eyebrow{display:inline-flex;align-items:center;gap:8px;color:var(--accent)}.eyebrow i{width:7px;height:7px;border-radius:50%;background:#4da572;box-shadow:0 0 0 4px rgba(77,165,114,.14)}.hero-copy h1{font-size:clamp(3.1rem,6vw,5.4rem);line-height:.93;letter-spacing:-.065em;font-weight:500;margin:22px 0}.hero-copy h1 em,.capability-intro h2 em,.signal-copy h2 em,.final-cta h2 em{color:var(--accent);font-style:normal}.hero-copy>p{max-width:510px;color:var(--muted);font:1rem/1.65 system-ui,sans-serif;margin:0 0 28px}.hero-cta{display:flex;align-items:center;gap:16px;flex-wrap:wrap}.button{display:inline-flex;align-items:center;gap:15px;border-radius:10px;padding:14px 18px;font:700 .8rem/1 system-ui,sans-serif}.button-primary{background:#10241f;color:#fff;box-shadow:0 9px 20px rgba(16,36,31,.13)}.button-primary:hover{background:#1f5c48;color:#fff}.button-ghost{color:var(--ink)}.button-ghost:hover{color:var(--accent)}.button-dark{color:#fff;background:#10241f}.hero-proof{display:flex;flex-wrap:wrap;gap:13px 18px;margin-top:42px;color:#809088;font:600 .65rem/1.2 system-ui,sans-serif}.hero-proof b{color:var(--accent);margin-right:4px}.hero-visual{min-width:0;position:relative;min-height:440px;display:grid;place-items:center}.hero-visual:before{content:'';position:absolute;width:82%;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,#e4f1d6 0%,rgba(228,241,214,.35) 42%,transparent 68%)}.visual-window{width:min(100%,570px);position:relative;z-index:1;border-radius:15px;overflow:hidden;background:#f7f8f5;border:1px solid rgba(16,36,31,.14);box-shadow:0 25px 60px rgba(16,36,31,.2);transform:rotate(2deg)}.window-bar{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:11px 14px;background:#fff;border-bottom:1px solid rgba(16,36,31,.08);font:600 .61rem/1 system-ui,sans-serif}.window-brand{color:var(--ink)}.window-brand i{display:inline-grid;place-items:center;width:18px;height:18px;margin-right:5px;border-radius:5px;background:#10241f;color:#d5fb98;font:700 .7rem/1 Georgia,serif;font-style:normal}.window-context{color:#87948c}.window-context b{color:var(--accent)}.window-body{display:grid;grid-template-columns:116px 1fr;min-height:325px}.window-body aside{padding:18px 10px;display:flex;flex-direction:column;gap:5px;background:#edf2ec;color:#809088;font:600 .62rem/1 system-ui,sans-serif}.window-body aside span{padding:9px 8px;border-radius:7px}.window-body aside .aside-active{background:#d8ead7;color:var(--accent)}.window-main{padding:18px 17px}.mini-heading{display:flex;justify-content:space-between;align-items:center}.mini-heading small,.mini-stats small{display:block;color:#87948c;font:600 .58rem/1.2 system-ui,sans-serif}.mini-heading strong{display:block;color:var(--ink);font:500 1.15rem/1.15 Georgia,serif;margin-top:4px}.mini-avatar{display:grid;place-items:center;width:29px;height:29px;border-radius:50%;background:#1f6f5b;color:#fff;font:700 .58rem/1 system-ui,sans-serif}.mini-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin:18px 0 12px}.mini-stats>div{padding:10px 9px;border-radius:8px;background:#fff;border:1px solid rgba(16,36,31,.06)}.mini-stats b{display:block;margin:7px 0 3px;color:var(--ink);font:500 1.05rem/1 Georgia,serif}.mini-stats em{font:600 .55rem/1 system-ui,sans-serif;font-style:normal;color:#5b9b6b}.mini-stats em.orange{color:#b68130}.mini-chart{padding:12px 10px 8px;background:#fff;border:1px solid rgba(16,36,31,.06);border-radius:8px}.chart-head{display:flex;justify-content:space-between;color:#5c6b65;font:600 .62rem/1 system-ui,sans-serif}.chart-head span{color:#9aa7a0;font-size:.55rem}.bars{height:85px;margin-top:12px;display:flex;align-items:end;gap:7px;border-bottom:1px solid #e3e9e2}.bars i{flex:1;border-radius:3px 3px 0 0;background:linear-gradient(#80c47f,#3e9068)}.chart-labels{display:flex;justify-content:space-between;color:#9aa7a0;font:.5rem/1 system-ui,sans-serif;margin-top:5px}.mini-task{display:flex;align-items:center;gap:9px;margin-top:11px;padding:10px;border-radius:8px;background:#fff;border:1px solid rgba(16,36,31,.06)}.task-dot{width:7px;height:7px;flex-shrink:0;border-radius:50%;background:#dda242}.mini-task div{flex:1}.mini-task b{display:block;color:var(--ink);font:600 .62rem/1.2 system-ui,sans-serif}.mini-task small{display:block;color:#8b9990;font:.56rem/1 system-ui,sans-serif;margin-top:3px}.task-pill{color:#a36e21;background:#fff1d8;padding:5px 6px;border-radius:5px;font:600 .52rem/1 system-ui,sans-serif;white-space:nowrap}.float-card{position:absolute;z-index:2;display:flex;align-items:center;gap:9px;padding:10px 12px;background:#fff;border:1px solid rgba(16,36,31,.1);border-radius:11px;box-shadow:0 12px 25px rgba(16,36,31,.13)}.float-card small{display:block;color:#8b9990;font:600 .55rem/1 system-ui,sans-serif}.float-card b{display:block;color:var(--ink);font:700 .64rem/1.2 system-ui,sans-serif;margin-top:4px}.float-icon,.float-check{width:26px;height:26px;border-radius:8px;display:grid;place-items:center;font-size:.85rem}.float-icon{background:#dff3be;color:#4f8059}.float-check{background:#dff3e5;color:#3b8e61}.float-top{top:34px;right:-3px}.float-bottom{bottom:28px;left:0}.capability-intro{max-width:670px;margin:0 auto;padding:50px 24px 28px;text-align:center}.section-kicker{color:var(--accent)}.capability-intro h2{font-size:clamp(2.2rem,4vw,3.4rem);line-height:1;letter-spacing:-.05em;font-weight:500;margin:14px 0}.capability-intro p{color:var(--muted);font:.9rem/1.6 system-ui,sans-serif;max-width:500px;margin:0 auto}.capability-grid{max-width:1180px;margin:0 auto;padding:0 24px 78px;display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.capability{min-height:220px;padding:20px;border:1px solid rgba(16,36,31,.09);border-radius:16px;background:#fff;color:var(--ink);position:relative;overflow:hidden;transition:.2s ease}.capability:hover{transform:translateY(-3px);box-shadow:0 14px 28px rgba(16,36,31,.09)}.capability:after{content:'';position:absolute;width:130px;height:130px;right:-42px;bottom:-42px;border-radius:50%;background:currentColor;opacity:.055}.capability-0{color:#1f6f5b}.capability-1{color:#726bb3}.capability-2{color:#b38329}.capability-3{color:#3974a1}.capability-4{color:#ad607c}.capability-5{color:#576a6a}.cap-icon{display:grid;place-items:center;width:38px;height:38px;border-radius:11px;background:rgba(16,36,31,.07);font-size:1.3rem}.cap-number{position:absolute;top:20px;right:20px;color:#97a49d;font:700 .63rem/1 system-ui,sans-serif;letter-spacing:.12em}.capability h3{color:var(--ink);font-size:1.15rem;margin:40px 0 7px}.capability p{color:var(--muted);font:.78rem/1.5 system-ui,sans-serif;max-width:230px}.cap-arrow{position:absolute;right:18px;bottom:15px;color:currentColor;font:1.2rem/1 system-ui,sans-serif}.signal-section{max-width:1180px;margin:0 auto 80px;padding:65px 24px;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;background:#eaf2e7}.signal-copy h2{font-size:clamp(2.3rem,4vw,3.5rem);line-height:.98;letter-spacing:-.05em;font-weight:500;margin:13px 0 18px}.signal-copy p{color:var(--muted);font:.9rem/1.65 system-ui,sans-serif;max-width:430px;margin:0 0 24px}.signal-steps{display:flex;flex-direction:column;gap:10px}.signal-step{display:flex;gap:14px;align-items:flex-start;padding:17px 18px;border:1px solid rgba(16,36,31,.08);border-radius:13px;background:rgba(255,255,255,.55)}.signal-step.active{background:#fff;border-color:rgba(31,111,91,.28);box-shadow:0 10px 24px rgba(16,36,31,.06)}.signal-step>span{color:#73907e;font:700 .68rem/1 system-ui,sans-serif;padding-top:2px}.signal-step b{color:var(--ink);font:700 .85rem/1 system-ui,sans-serif}.signal-step p{color:var(--muted);font:.75rem/1.45 system-ui,sans-serif;margin:6px 0 0}.final-cta{text-align:center;max-width:650px;margin:0 auto;padding:22px 24px 90px}.final-cta h2{font-size:clamp(2.4rem,4vw,3.5rem);line-height:.98;letter-spacing:-.05em;font-weight:500;margin:14px 0 18px}.final-cta p{color:var(--muted);font:.9rem/1.55 system-ui,sans-serif;margin:0 auto 23px;max-width:500px}
  @media(max-width:850px){.landing-hero{grid-template-columns:1fr;padding-top:50px}.hero-visual{min-height:405px}.capability-grid{grid-template-columns:repeat(2,1fr)}.platform-head{grid-template-columns:1fr;gap:18px}.platform-status{grid-template-columns:1fr}.signal-section{grid-template-columns:1fr;gap:35px}}
  @media(max-width:560px){.landing-hero{padding:35px 16px 50px}.hero-copy h1{font-size:3.25rem}.hero-proof{gap:9px 12px;margin-top:30px}.hero-visual{min-height:330px;transform:scale(.92);margin:0 -14px}.window-body{grid-template-columns:78px 1fr}.window-body aside{font-size:.5rem;padding:13px 6px}.window-main{padding:14px 10px}.mini-stats b{font-size:.85rem}.mini-stats em{font-size:.45rem}.float-top{right:-5px}.float-bottom{left:-3px}.capability-grid{grid-template-columns:1fr;padding:0 16px 55px}.capability{min-height:185px}.platform-section{margin-left:12px;margin-right:12px;padding:44px 18px}.platform-grid{grid-template-columns:1fr}.platform-grid a{border-right:0}.signal-section{padding:42px 20px;margin-bottom:55px}.final-cta{padding-bottom:65px}}
</style>
