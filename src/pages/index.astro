---
import Layout from '../layouts/Layout.astro';

const modules = [
  ['⌁', 'Styrearbeid', 'Møter, sakspapirer, vedtak og protokoller samlet.', '/board'],
  ['◈', 'Risiko og kontroll', 'Knytt risiko, kontroll, bevis og tiltak til ansvar.', '/risk'],
  ['◒', 'Økonomi og lønn', 'Bilag, perioder, lønnskontroller og rapporteringsgrunnlag i ett spor.', '/finance'],
  ['＋', 'Mennesker og HCM', 'Roller, mål, rekruttering, onboarding og offboarding med godkjenning.', '/people'],
  ['▣', 'Innkjøp', 'Bestilling, mottak, leverandørfaktura og treveis kontroll.', '/procurement'],
  ['◎', 'Kunder og kommersielt', 'Følg pipeline, tilbud, kundesaker og SLA fra samme kilde.', '/commercial'],
  ['⌂', 'Prosjekt og felt', 'Timer, kjørelister, vedlikehold og fakturagrunnlag med sporbarhet.', '/field'],
  ['◇', 'IT og drift', 'Eiendeler, SaaS-forbruk, tilgangsrevisjon og offboarding-kø.', '/it'],
  ['§', 'Avtaler og juss', 'Kontraktsgjennomgang, redlines, mandater og styregodkjenning.', '/governance'],
  ['◌', 'Kontrollspor', 'Se hvem som endret hva, når og hvorfor — med kilde og ansvar.', '/audit'],
];

const audiences = [
  ['Styreleder', 'Kom forberedt til møtet og se hva som krever beslutning.'],
  ['Daglig leder', 'Gjør ansvar, risiko og frister synlige i hverdagen.'],
  ['Styresekretær', 'Hold dokumenter, vedtak og oppfølging ryddig.'],
];
---

<Layout title="Styrearbeid med retning" activeNav="home">
  <div class="home">
    <section class="positioning" aria-label="Styr.ing for norske virksomheter">
      <span>NORSK SAAS FOR AS</span><strong>For norske styrer og ledere som vil følge opp det de beslutter.</strong><a href="/trust">Sikkerhet og datagrunnlag ↗</a>
    </section>

    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow"><i></i>Norsk SaaS for styrer og ledelse</p>
        <h1>Fra beslutning<br /><em>til fremdrift.</em></h1>
        <p class="lede">Styr.ing gjør styrearbeid og virksomhetsoppfølging enklere å holde i gang. Samle sak, vedtak, ansvar, risiko og dokumentasjon – og se hva som faktisk må skje videre.</p>
        <div class="actions"><a class="button primary" href="/workspace">Utforsk arbeidsflaten ↗</a><a class="button secondary" href="mailto:ola@styr.ing?subject=Demo%20av%20Styr.ing">Bestill en gjennomgang</a></div>
        <div class="proof"><span><b>01</b>Før møtet</span><span><b>02</b>I møtet</span><span><b>03</b>Etter møtet</span></div>
        <p class="hero-note"><span>✓</span> SaaS for styring og arbeidsflyt – ikke et nytt regnskaps- eller lønnssystem.</p>
      </div>

      <div class="product-stage" aria-label="Illustrasjon av Styr.ing arbeidsflate">
        <div class="glow"></div>
        <div class="app-card">
          <div class="app-bar"><span class="brand"><i>s</i> styr.ing</span><span>Illustrasjonsdata · styreportal</span></div>
          <div class="app-body">
            <aside><b>⌁ Oversikt</b><span>◈ Risiko</span><span>✓ Kontroll</span><span>＋ Oppgaver</span><span>⌂ Dokumenter</span></aside>
            <div class="dashboard">
              <div class="dashboard-head"><div><small>Styrets arbeidsflate</small><h2>Dette krever oppmerksomhet.</h2></div><b class="avatar">AS</b></div>
              <div class="stats"><div><small>Saker til behandling</small><strong>8</strong><em>2 krever vedtak</em></div><div><small>Åpne oppgaver</small><strong>6</strong><em class="warn">2 høy prioritet</em></div><div><small>Kontrollstatus</small><strong>94%</strong><em>Oppdatert i dag</em></div></div>
              <div class="chart"><div><b>Kontroll og oppfølging</b><span>Siste 6 måneder ↗</span></div><section class="bars" aria-hidden="true"><i style="height:42%"></i><i style="height:55%"></i><i style="height:50%"></i><i style="height:70%"></i><i style="height:65%"></i><i style="height:84%"></i><i style="height:94%"></i></section><small>Jan　 Feb　 Mar　 Apr　 Mai　 Jun　 Nå</small></div>
              <div class="task"><i></i><div><b>Budsjett H2 2026 er klart for behandling</b><small>Økonomiansvarlig · Frist 30. mai</small></div><span>Til behandling</span></div>
            </div>
          </div>
        </div>
        <div class="notice"><span>✦</span><div><small>Styr.assistent</small><b>3 punkter krever oppmerksomhet</b></div></div>
      </div>
    </section>

    <section class="audience" aria-label="Hvem bruker Styr.ing"><span class="kicker">Bygget rundt styrets ansvar</span>{audiences.map(([title, text]) => <div><strong>{title}</strong><span>{text}</span></div>)}<div><strong>Regnskapsfører</strong><span>Gi styret et ryddig beslutningsspor uten å overta kundens ansvar for bokføring eller rapportering.</span></div></section>

    <section class="modules" id="produkt">
      <div class="section-intro"><p class="kicker">Én plattform · flere arbeidsflater</p><h2>Alt dere trenger for<br /><em>bedre virksomhetsstyring.</em></h2><p>Start med møte, sak og vedtak. Koble på økonomi, mennesker, drift og kontroll når dere trenger det – uten å miste kilden, ansvaret eller historikken.</p></div>
      <div class="module-grid">{modules.map(([icon, title, text, href], index) => <a class="module" href={href}><span class="number">{String(index + 1).padStart(2, '0')}</span><span class="icon">{icon}</span><h3>{title}</h3><p>{text}</p><b>Åpne arbeidsflate ↗</b></a>)}</div>
    </section>

    <section class="trust-band"><div><p class="kicker">Trygghet i hver handling</p><h2>Oversikt uten<br /><em>falske løfter.</em></h2></div><div class="trust-copy"><p>Styr.ing er SaaS for styring og arbeidsflyt — ikke et regnskaps-, lønns- eller myndighetssystem. Den offentlige flaten bruker kun illustrasjonsdata; tilgang styres per styre, og skrivehandlinger krever autorisasjon og blir auditert.</p><a href="/trust">Les om sikkerhet, personvern og datagrunnlag ↗</a></div></section>

    <section class="fit" aria-labelledby="fit-title"><div><p class="kicker">Passer for dere som</p><h2 id="fit-title">Vil ha kontroll<br /><em>uten mer administrasjon.</em></h2></div><div class="fit-grid"><article><strong>Styreleder</strong><p>Få et samlet bilde av saker, risiko og oppfølging før møtet.</p></article><article><strong>Daglig leder</strong><p>Gjør beslutninger om til tydelige eiere, frister og kontrollpunkter.</p></article><article><strong>Styresekretær</strong><p>Hold sakspapirer, vedtak og protokoller i samme spor.</p></article><article><strong>Regnskapsfører</strong><p>Del beslutningsgrunnlag med styret uten å miste rollefordelingen.</p></article></div></section>

    <section class="steps"><div><p class="kicker">Slik fungerer det</p><h2>Fra sak til<br /><em>oppfølging.</em></h2><p>Én arbeidsflyt som gjør det tydelig hva som skal skje før, under og etter møtet.</p><a class="button dark" href="/board/board-1">Se et illustrert møteforløp ↗</a></div><div class="step-list"><div><b>01</b><span><strong>Forbered</strong><small>Samle agenda, dokumenter og beslutningsgrunnlag.</small></span></div><div class="active"><b>02</b><span><strong>Beslutt</strong><small>Gjør sak, ansvar og utfall tydelig for alle.</small></span></div><div><b>03</b><span><strong>Følg opp</strong><small>La oppgaver, kontroller og frister leve videre.</small></span></div></div></section>

    <section class="faq" aria-labelledby="faq-title"><div><p class="kicker">Vanlige spørsmål</p><h2 id="faq-title">Kort forklart,<br /><em>før dere bestemmer dere.</em></h2><p>Styr.ing er laget for virksomheter som vil ha kontroll på ansvar og oppfølging uten å kjøpe et nytt økonomisystem.</p></div><div class="faq-list"><details open><summary>Er Styr.ing et komplett regnskaps- eller lønnssystem?</summary><p>Nei. Styr.ing er SaaS for styring, arbeidsflyt og kontrollspor. Regnskapsfører og virksomhet beholder ansvaret for bokføring, lønn og lovpålagte innsendinger.</p></details><details><summary>Kan vi teste uten å legge inn reelle data?</summary><p>Ja. Den offentlige arbeidsflaten bruker kun illustrasjonsdata. Be om aktivering for en virksomhetsspesifikk gjennomgang.</p></details><details><summary>Hvordan starter vi?</summary><p>Bestill en gjennomgang. Vi avklarer virksomhet, roller, datagrunnlag og hvilke arbeidsflater som skal aktiveres før tilgang gis.</p></details></div></section>
    <section class="cta"><p class="kicker">Klarere styring starter her</p><h2>Gjør neste møte<br /><em>lettere å følge opp.</em></h2><p>Utforsk arbeidsflaten med fiktive data, eller bestill en rolig gjennomgang av hvordan Styr.ing kan passe deres AS.</p><div class="cta-actions"><a class="button primary" href="/workspace">Prøv arbeidsflaten ↗</a><a class="button secondary" href="mailto:ola@styr.ing?subject=Demo%20av%20Styr.ing">Kontakt oss</a></div></section>
  </div>
</Layout>

<style>
  .home{overflow:hidden}.positioning{max-width:1180px;margin:auto;padding:13px 24px;display:flex;gap:16px;align-items:center;border-bottom:1px solid rgba(16,36,31,.1);font:600 .72rem/1.3 system-ui,sans-serif;color:var(--muted)}.positioning>span{color:var(--accent);letter-spacing:.14em;font-size:.62rem}.positioning strong{color:var(--ink)}.positioning a{margin-left:auto;white-space:nowrap}.hero{max-width:1180px;margin:auto;padding:72px 24px 52px;display:grid;grid-template-columns:.9fr 1.1fr;gap:38px;align-items:center}.eyebrow,.kicker{font:700 .68rem/1 system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:var(--accent)}.eyebrow{display:flex;gap:8px;align-items:center}.eyebrow i{width:7px;height:7px;border-radius:50%;background:#4da572}.hero h1{font-size:clamp(3.4rem,6vw,5.5rem);line-height:.92;letter-spacing:-.07em;font-weight:500;margin:22px 0}.hero h1 em,.section-intro em,.trust-band em,.steps em,.cta em{font-style:normal;color:var(--accent)}.lede{max-width:510px;color:var(--muted);font:1rem/1.65 system-ui,sans-serif}.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}.button{display:inline-flex;align-items:center;gap:13px;border-radius:10px;padding:14px 18px;font:700 .78rem/1 system-ui,sans-serif}.button.primary,.button.dark{background:var(--ink);color:#fff}.button.primary:hover,.button.dark:hover{background:var(--accent);color:#fff}.button.secondary{color:var(--ink)}.proof{display:flex;flex-wrap:wrap;gap:12px 18px;margin-top:38px;color:#7c8a82;font:600 .64rem/1.2 system-ui,sans-serif}.proof b{color:var(--accent);margin-right:5px}.product-stage{min-width:0;min-height:420px;position:relative;display:grid;place-items:center}.glow{position:absolute;width:82%;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,#e2f0d5,transparent 68%)}.app-card{position:relative;z-index:1;width:min(100%,600px);border-radius:16px;overflow:hidden;background:#f7f8f5;border:1px solid rgba(16,36,31,.13);box-shadow:0 24px 55px rgba(16,36,31,.2);transform:rotate(2deg)}.app-bar{display:flex;justify-content:space-between;gap:10px;padding:12px 15px;background:#fff;border-bottom:1px solid rgba(16,36,31,.08);font:600 .6rem/1 system-ui,sans-serif;color:#84928a}.brand{color:var(--ink)}.brand i{display:inline-grid;place-items:center;width:19px;height:19px;margin-right:5px;border-radius:6px;background:var(--ink);color:#d5fb98;font-style:normal}.app-body{display:grid;grid-template-columns:118px 1fr;min-height:330px}.app-body aside{display:flex;flex-direction:column;gap:7px;padding:18px 10px;background:#edf2ec;color:#809088;font:600 .62rem/1 system-ui,sans-serif}.app-body aside>*{padding:9px 7px;border-radius:7px}.app-body aside b{background:#d8ead7;color:var(--accent)}.dashboard{padding:19px 17px}.dashboard-head{display:flex;justify-content:space-between;align-items:center}.dashboard-head small,.stats small{display:block;color:#87948c;font:600 .57rem/1.2 system-ui,sans-serif}.dashboard h2{font:500 1.2rem/1.1 Georgia,serif;margin-top:5px}.avatar{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--accent);color:#fff;font:700 .58rem/1 system-ui,sans-serif}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin:18px 0 12px}.stats>div{padding:10px 9px;border-radius:8px;background:#fff;border:1px solid rgba(16,36,31,.06)}.stats strong{display:block;margin:3px 0;color:var(--ink);font:500 1.05rem/1 Georgia,serif}.stats em{font:600 .53rem/1 system-ui,sans-serif;color:#5b9b6b;font-style:normal}.stats .warn{color:#b68130}.chart{padding:12px;border-radius:8px;background:#eef3ed;font:600 .6rem/1 system-ui,sans-serif;color:#5c6b65}.chart>div:first-child{display:flex;justify-content:space-between}.chart span{color:#9aa7a0;font-size:.54rem}.bars{height:86px;display:flex;align-items:end;gap:7px;margin-top:12px;border-bottom:1px solid #dce5dc}.bars i{flex:1;border-radius:3px 3px 0 0;background:linear-gradient(#80c47f,#3e9068)}.chart>small{color:#9aa7a0;font-size:.5rem}.task{display:flex;align-items:center;gap:8px;margin-top:11px;padding:10px;border-radius:8px;background:#fff;border:1px solid rgba(16,36,31,.06)}.task>i{width:7px;height:7px;flex:0 0 auto;border-radius:50%;background:#dda242}.task div{flex:1}.task b{display:block;font:600 .6rem/1.2 system-ui,sans-serif}.task small{display:block;margin-top:3px;color:#8b9990;font:.53rem/1 system-ui,sans-serif}.task span{padding:5px 6px;border-radius:5px;background:#fff1d8;color:#a36e21;font:600 .5rem/1 system-ui,sans-serif;white-space:nowrap}.notice{position:absolute;z-index:2;top:24px;right:-3px;display:flex;gap:9px;align-items:center;padding:11px 14px;border-radius:12px;background:#fff;box-shadow:0 12px 30px rgba(16,36,31,.14);font-family:system-ui,sans-serif}.notice>span{display:grid;place-items:center;width:27px;height:27px;border-radius:8px;background:#dff3be;color:#4f8059}.notice small,.notice b{display:block}.notice small{color:#8b9990;font-size:.55rem}.notice b{margin-top:3px;color:var(--ink);font-size:.64rem}.audience{max-width:1180px;margin:auto;padding:18px 24px;display:grid;grid-template-columns:1.2fr repeat(3,1fr);gap:12px;border-block:1px solid rgba(16,36,31,.1);font:600 .72rem/1.3 system-ui,sans-serif}.audience>div{display:grid;gap:3px;padding-left:14px;border-left:1px solid rgba(16,36,31,.12)}.audience span:not(.kicker){color:var(--muted);font-weight:400}.modules{max-width:1180px;margin:auto;padding:85px 24px}.section-intro{max-width:620px;text-align:center;margin:0 auto 32px}.section-intro h2,.trust-band h2,.steps h2,.cta h2{font-size:clamp(2.35rem,4vw,3.5rem);line-height:.98;letter-spacing:-.06em;font-weight:500;margin:14px 0}.section-intro>p:last-child,.steps>div>p:last-of-type,.cta>p:last-of-type{max-width:520px;margin:auto;color:var(--muted);font:.9rem/1.6 system-ui,sans-serif}.module-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.module{position:relative;min-height:220px;padding:20px;border:1px solid rgba(16,36,31,.1);border-radius:15px;background:#fff;color:var(--ink);transition:.2s}.module:hover{transform:translateY(-3px);box-shadow:0 14px 28px rgba(16,36,31,.09)}.module .number{position:absolute;right:18px;top:19px;color:#97a49d;font:700 .62rem/1 system-ui,sans-serif;letter-spacing:.1em}.module .icon{display:grid;place-items:center;width:38px;height:38px;border-radius:11px;background:#e8f1df;color:var(--accent);font-size:1.25rem}.module h3{margin:32px 0 7px;font:500 1.25rem/1 Georgia,serif}.module p{max-width:240px;color:var(--muted);font:.76rem/1.5 system-ui,sans-serif}.module b{position:absolute;left:20px;bottom:18px;color:var(--accent);font:700 .67rem/1 system-ui,sans-serif}.trust-band,.steps{max-width:1180px;margin:0 auto 80px;padding:62px 70px;display:grid;grid-template-columns:1fr .9fr;gap:60px;background:var(--ink);color:#fff}.trust-band h2 em{color:#c4ef8c}.trust-copy{align-self:end;color:#a8bab2;font:.88rem/1.65 system-ui,sans-serif}.trust-copy a{display:inline-block;margin-top:16px;color:#c4ef8c;font-weight:700}.steps{background:#eaf2e7;color:var(--ink)}.steps>div>p:last-of-type{margin:0 0 25px}.step-list{display:flex;flex-direction:column;gap:10px}.step-list>div{display:flex;gap:14px;padding:17px;border-radius:12px;background:rgba(255,255,255,.5)}.step-list .active{background:#fff;box-shadow:0 10px 22px rgba(16,36,31,.07)}.step-list b{color:#73907e;font:700 .67rem/1 system-ui,sans-serif}.step-list strong,.step-list small{display:block}.step-list strong{font:700 .84rem/1 system-ui,sans-serif}.step-list small{margin-top:6px;color:var(--muted);font:.75rem/1.4 system-ui,sans-serif}.cta{max-width:650px;margin:0 auto;padding:10px 24px 85px;text-align:center}.cta>p:last-of-type{margin-bottom:25px}.cta .button{margin-top:0}
  @media(max-width:1050px){.module-grid{grid-template-columns:repeat(3,1fr)}}
  .faq{max-width:1180px;margin:0 auto 80px;padding:55px 70px;display:grid;grid-template-columns:.8fr 1.2fr;gap:60px;background:#fff;border:1px solid rgba(16,36,31,.1);border-radius:20px}.faq h2{font-size:clamp(2.2rem,4vw,3.2rem);line-height:.98;letter-spacing:-.06em;font-weight:500;margin:14px 0}.faq h2 em{font-style:normal;color:var(--accent)}.faq>div>p:last-child{max-width:390px;color:var(--muted);font:.86rem/1.6 system-ui,sans-serif}.faq-list{border-top:1px solid rgba(16,36,31,.12)}.faq-list details{padding:18px 0;border-bottom:1px solid rgba(16,36,31,.12)}.faq-list summary{cursor:pointer;list-style:none;padding-right:28px;color:var(--ink);font:700 .86rem/1.35 system-ui,sans-serif;position:relative}.faq-list summary::-webkit-details-marker{display:none}.faq-list summary::after{content:'+';position:absolute;right:0;top:-2px;color:var(--accent);font:500 1.2rem/1 system-ui,sans-serif}.faq-list details[open] summary::after{content:'−'}.faq-list details p{max-width:620px;margin:9px 28px 0 0;color:var(--muted);font:.78rem/1.55 system-ui,sans-serif}.cta-actions{display:flex;justify-content:center;flex-wrap:wrap;gap:12px}.fit{max-width:1180px;margin:0 auto 80px;padding:55px 70px;display:grid;grid-template-columns:.8fr 1.2fr;gap:52px;background:#fff;border:1px solid rgba(16,36,31,.1);border-radius:20px}.fit h2{font-size:clamp(2.2rem,4vw,3.2rem);line-height:.98;letter-spacing:-.06em;font-weight:500;margin:14px 0}.fit h2 em{font-style:normal;color:var(--accent)}.fit-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.fit-grid article{padding:18px;border-radius:12px;background:#eef3ed}.fit-grid strong{font:700 .84rem/1 system-ui,sans-serif}.fit-grid p{margin-top:7px;color:var(--muted);font:.76rem/1.5 system-ui,sans-serif}
  @media(max-width:850px){.hero{grid-template-columns:1fr;padding-top:52px}.product-stage{min-height:380px}.module-grid{grid-template-columns:repeat(2,1fr)}.trust-band,.steps,.faq,.fit{grid-template-columns:1fr;gap:25px;padding:48px 32px}.audience{grid-template-columns:1fr 1fr}.audience .kicker{grid-column:1/-1}}
  @media(max-width:560px){.positioning{display:grid;grid-template-columns:auto 1fr;gap:8px 12px}.positioning a{grid-column:2;margin:0}.hero{padding:42px 16px 35px}.hero h1{font-size:3.35rem}.product-stage{min-height:310px;margin-inline:-20px;transform:scale(.94)}.app-body{grid-template-columns:78px 1fr}.app-body aside{padding:13px 6px;font-size:.5rem}.dashboard{padding:14px 10px}.stats strong{font-size:.88rem}.stats em{font-size:.45rem}.notice{right:-8px;top:8px}.audience{grid-template-columns:1fr;padding-inline:16px}.audience>div{padding:10px 0;border-left:0;border-top:1px solid rgba(16,36,31,.12)}.modules{padding:62px 16px}.module-grid{grid-template-columns:1fr}.module{min-height:190px}.trust-band,.steps,.faq,.fit{margin-inline:12px;padding:40px 22px}.fit-grid{grid-template-columns:1fr}.cta{padding-bottom:65px}}
  .hero-note{display:flex;align-items:flex-start;gap:7px;max-width:470px;margin-top:18px;color:#6f7e76;font:600 .68rem/1.45 system-ui,sans-serif}.hero-note span{color:var(--accent);font-size:.85rem}
</style>
