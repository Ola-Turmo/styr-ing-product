---
// Member Management — Styremedlemsadministrasjon
import Layout from '../../../layouts/Layout.astro';
import { demoBoardsFixed } from '../../../lib/db';
export function getStaticPaths() {
  return demoBoardsFixed.map(b => ({ params: { id: b.id } }));
}
const { id } = Astro.params;
const board = demoBoardsFixed.find(b => b.id === id) || demoBoardsFixed[0];
const members = [
  { name:'Demo Leder', role:'Styreleder', email:'leder@example.invalid', avatar:'👑', color:'#1a1a1a' },
  { name:'Demo Sekretær', role:'Styresekretær', email:'sekretar@example.invalid', avatar:'📋', color:'#065f46' },
  { name:'Demo Økonomi', role:'Styremedlem', email:'okonomi@example.invalid', avatar:'💼', color:'#34495e' },
  { name:'Demo IT', role:'Styremedlem', email:'it@example.invalid', avatar:'🖥', color:'#2c3e50' },
  { name:'Demo Observatør', role:'Observatør', email:'observator@example.invalid', avatar:'👁', color:'#636e72' },
];
---
<Layout title="Styremedlemmer" activeNav="boards">
<div class="container" data-board-id={id}>
  <a href={'/board/' + id} class="back-link">← Tilbake</a>
  
  <div class="header">
    <div><h1>Styremedlemmer</h1><p>{members.length} medlemmer</p></div>
    <button id="invite-button" class="btn-primary">Inviter medlem</button>
  </div>

  <div id="member-status" class="member-status" role="status" aria-live="polite"></div>
  <section id="invite-panel" class="invite-panel" hidden aria-labelledby="invite-title">
    <div class="invite-panel-head"><div><h2 id="invite-title">Inviter en kollega</h2><p>Send en sikker engangslenke til personen som skal ha tilgang.</p></div><button id="invite-close" type="button" class="btn-sm">Avbryt</button></div>
    <form id="invite-form" class="invite-form">
      <label for="invite-email">E-post</label><input id="invite-email" type="email" autocomplete="email" placeholder="navn@bedrift.no" required />
      <label for="invite-name">Navn</label><input id="invite-name" type="text" autocomplete="name" placeholder="Navn på personen" minlength="2" required />
      <label for="invite-role">Tilgang</label><select id="invite-role"><option value="viewer">Leser – kan se dokumenter og møter</option><option value="editor">Redaktør – kan oppdatere styrearbeid</option><option value="owner">Eier – full tilgang</option></select>
      <button class="btn-primary" type="submit">Opprett invitasjon</button>
    </form>
    <div id="invite-result" class="invite-result" hidden role="status" aria-live="polite"><strong>Invitasjonen er klar</strong><p>Lenken kan brukes én gang og utløper om 24 timer.</p><div class="invite-url-row"><input id="invite-url" readonly aria-label="Aktiveringslenke" /><button id="invite-copy" type="button" class="btn-sm">Kopier lenke</button></div><small>Send lenken direkte til mottakeren. Av sikkerhetshensyn lagres den ikke i Styr.ing.</small></div>
  </section>
  <div id="member-grid" class="member-grid">
    {members.map(m => (
      <div class="member-card">
        <div class="member-avatar" style={'background:' + m.color}>{m.avatar}</div>
        <div class="member-info">
          <strong>{m.name}</strong>
          <span class="member-role">{m.role}</span>
          <span class="member-email">{m.email}</span>
          <div class="member-perms">
            <span class="chip active">Les dokumenter</span>
            {m.role !== 'Observatør' && <span class="chip active">Delta i møter</span>}
            {(m.role === 'Styreleder' || m.role === 'Styresekretær') && <span class="chip active">Redigere protokoll</span>}
            {m.role === 'Styreleder' && <span class="chip active">Godkjenne vedtak</span>}
            {m.role === 'Styreleder' && <span class="chip active">Signaturrolle (demo)</span>}
            {m.role === 'Observatør' && <span class="chip inactive">Ingen stemmerett</span>}
          </div>
          <div class="member-activity">Deltok sist: 2026-03-15 · 3 av 3 møter · 100% oppmøte</div>
        </div>
        <div class="member-actions"><span class="btn-sm demo-control">Illustrasjon</span></div>
      </div>
    ))}
  </div>

  <div class="perm-table">
    <h3>Rettigheter per rolle</h3>
    <div class="perm-grid">
      <div class="perm-header"><span>Rolle</span><span>Les</span><span>Delta</span><span>Rediger</span><span>Godkjenne</span><span>Signere</span><span>Admin</span></div>
      {['Styreleder','Nestleder','Styremedlem','Styresekretær','Observatør'].map(r => (
        <div class="perm-row">
          <span class="perm-role">{r}</span><span>✓</span><span>✓</span>
          <span>{r === 'Styreleder' || r === 'Styresekretær' ? '✓' : '—'}</span>
          <span>{r === 'Styreleder' ? '✓' : '—'}</span>
          <span>{r === 'Styreleder' || r === 'Nestleder' ? '✓' : '—'}</span>
          <span>{r === 'Styreleder' ? '✓' : '—'}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="demo-notice">Kortene over er illustrasjonsdata. Når virksomheten er aktivert, kan autoriserte eiere og redaktører invitere, endre roller og fjerne tilgang. Identitetskontroll og signering må avtales og verifiseres separat.</div>
</div>
</Layout>

<script is:inline>
  const boardId = document.querySelector('.container')?.dataset.boardId || '';
  const live = document.createElement('div'); live.id = 'live-members'; document.querySelector('.container')?.prepend(live);
  const status = document.querySelector('#member-status');
  const esc = (value) => String(value ?? '').replace(/[&<>'"]/g, (char) => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','\"':'&quot;'}[char]));
  const roleLabel = { owner: 'Eier', editor: 'Redaktør', viewer: 'Leser' };
  const loadMembers = async () => {
    const response = await fetch(`/api/members?boardId=${encodeURIComponent(boardId)}`);
    if (!response.ok) return;
    const data = await response.json();
    live.innerHTML = `<div class="live-panel"><strong>Live tenant-tilgang</strong><span>${data.members.length} innloggede medlemmer · handlinger krever eier- eller redaktørtilgang</span></div>`;
    const grid = document.querySelector('#member-grid');
    if (!grid || !Array.isArray(data.members)) return;
    grid.innerHTML = data.members.map((member) => `<article class="member-card live-member-card" data-user-id="${esc(member.id)}"><div class="member-avatar" style="background:#1f6f5b">${member.role === 'owner' ? '👑' : '●'}</div><div class="member-info"><strong>${esc(member.name || member.email)}</strong><span class="member-role">${esc(roleLabel[member.role] || member.role)}</span><span class="member-email">${esc(member.email)}</span><div class="member-perms"><span class="chip active">${esc(member.account_role || 'bruker')}</span><span class="chip active">Tenant-tilgang</span></div></div><div class="member-actions"><label class="sr-only" for="role-${esc(member.id)}">Rolle for ${esc(member.name || member.email)}</label><select id="role-${esc(member.id)}" class="role-select" data-role-user="${esc(member.id)}"><option value="owner" ${member.role === 'owner' ? 'selected' : ''}>Eier</option><option value="editor" ${member.role === 'editor' ? 'selected' : ''}>Redaktør</option><option value="viewer" ${member.role === 'viewer' ? 'selected' : ''}>Leser</option></select><button type="button" class="btn-sm btn-save-role" data-user-id="${esc(member.id)}">Lagre rolle</button><button type="button" class="btn-sm btn-remove" data-remove-user="${esc(member.id)}">Fjern tilgang</button></div></article>`).join('');
    grid.querySelectorAll('[data-remove-user]').forEach((button) => button.addEventListener('click', () => updateMember(button.dataset.removeUser, 'remove')));
    grid.querySelectorAll('.btn-save-role').forEach((button) => button.addEventListener('click', () => { const select = grid.querySelector(`#role-${CSS.escape(button.dataset.userId || '')}`); updateMember(button.dataset.userId, 'set_role', select?.value); }));
  };
  const updateMember = async (userId, action, role) => {
    if (!userId) return;
    if (action === 'remove' && !window.confirm('Fjerne denne brukerens tilgang til styret?')) return;
    status.textContent = 'Lagrer…';
    const response = await fetch('/api/members', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ boardId, userId, action, role }) });
    const data = await response.json().catch(() => ({}));
    status.textContent = response.ok ? (action === 'remove' ? 'Tilgangen er fjernet.' : 'Rollen er oppdatert.') : (data.error === 'last_owner_must_remain' ? 'Minst én eier må bli igjen.' : 'Kunne ikke lagre endringen.');
    if (response.ok) loadMembers();
  };
  loadMembers().catch(() => {});
</script>
<script is:inline>
  const inviteButton = document.querySelector('#invite-button');
  const invitePanel = document.querySelector('#invite-panel'); const inviteForm = document.querySelector('#invite-form'); const inviteResult = document.querySelector('#invite-result'); const inviteUrl = document.querySelector('#invite-url'); const inviteCopy = document.querySelector('#invite-copy'); const inviteClose = document.querySelector('#invite-close');
  inviteButton?.addEventListener('click', () => { invitePanel.hidden = false; inviteResult.hidden = true; inviteForm.hidden = false; document.querySelector('#invite-email')?.focus(); });
  inviteClose?.addEventListener('click', () => { invitePanel.hidden = true; });
  inviteForm?.addEventListener('submit', async (event) => {
    event.preventDefault(); const submit = inviteForm.querySelector('button[type="submit"]'); submit.disabled = true; submit.textContent = 'Oppretter…'; status.textContent = '';
    const email = document.querySelector('#invite-email')?.value.trim(); const name = document.querySelector('#invite-name')?.value.trim(); const role = document.querySelector('#invite-role')?.value || 'viewer';
    try {
      const response = await fetch('/api/auth', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'invite_user', boardId, email, name, role }) }); const data = await response.json().catch(() => ({}));
      if (!response.ok) { status.textContent = data.error === 'owner_or_editor_required' ? 'Bare eier eller redaktør kan invitere.' : data.error === 'valid_email_name_and_boardId_required' ? 'Sjekk e-post, navn og rolle.' : 'Invitasjonen kunne ikke opprettes. Prøv igjen.'; return; }
      inviteUrl.value = `${location.origin}${data.activationUrl}`; inviteResult.hidden = false; inviteForm.hidden = true; status.textContent = 'Invitasjonen er opprettet.';
    } catch { status.textContent = 'Kunne ikke kontakte Styr.ing. Prøv igjen om litt.'; } finally { submit.disabled = false; submit.textContent = 'Opprett invitasjon'; }
  });
  inviteCopy?.addEventListener('click', async () => { try { await navigator.clipboard.writeText(inviteUrl.value); inviteCopy.textContent = 'Kopiert ✓'; setTimeout(() => { inviteCopy.textContent = 'Kopier lenke'; }, 1800); } catch { inviteUrl.select(); document.execCommand('copy'); inviteCopy.textContent = 'Kopiert ✓'; } });
</script>

<style>
.container { max-width: 800px; margin: 1.5rem auto; padding: 0 20px; }
.back-link { font-family: system-ui, sans-serif; font-size: 0.85rem; color: var(--muted); text-decoration: none; }
.header { display: flex; justify-content: space-between; align-items: flex-start; margin: 1rem 0 2rem; }
.header h1 { font-size: 1.6rem; margin: 0 0 4px; }
.header p { font-family: system-ui, sans-serif; color: var(--muted); margin: 0; }
.btn-primary { background: var(--accent); color: white; border: none; padding: 10px 20px; border-radius: 10px; font-family: system-ui, sans-serif; font-size: 0.85rem; font-weight: 600; cursor: pointer; }
.demo-control { cursor: default; opacity: 0.72; }
.member-status { min-height: 1.25rem; margin: -1rem 0 1rem; font-family: system-ui, sans-serif; font-size: 0.8rem; color: var(--accent); }
.invite-panel { margin: 0 0 1.25rem; padding: 18px; border: 1px solid rgba(31,111,91,.2); border-radius: 14px; background: #f7fbf5; font-family: system-ui, sans-serif; }
.invite-panel-head { display:flex; justify-content:space-between; gap:16px; align-items:flex-start; }
.invite-panel h2 { margin:0 0 4px; font-size:1.05rem; }
.invite-panel p { margin:0 0 12px; color:var(--muted); font-size:.8rem; }
.invite-form { display:grid; gap:7px; max-width:560px; }
.invite-form label { font-size:.72rem; font-weight:700; margin-top:6px; }
.invite-form input, .invite-form select { width:100%; box-sizing:border-box; padding:10px 11px; border:1px solid rgba(16,36,31,.18); border-radius:8px; background:#fff; font: .82rem system-ui,sans-serif; }
.invite-form .btn-primary { margin-top:8px; justify-self:start; }
.invite-result { margin-top:14px; padding:13px; border-radius:10px; background:#fff; border:1px solid rgba(31,111,91,.14); }
.invite-result strong { font-size:.84rem; }
.invite-result p { margin:4px 0 9px; }
.invite-result small { display:block; margin-top:8px; color:var(--muted); font-size:.7rem; }
.invite-url-row { display:flex; gap:7px; }
.invite-url-row input { flex:1; min-width:0; padding:9px; border:1px solid rgba(16,36,31,.16); border-radius:7px; font: .75rem ui-monospace,monospace; }
.live-panel { display: flex; justify-content: space-between; gap: 12px; margin: 0 0 1rem; padding: 12px 14px; border: 1px solid rgba(31,111,91,0.16); border-radius: 10px; background: rgba(31,111,91,0.06); font-family: system-ui, sans-serif; font-size: 0.8rem; }
.live-panel span { color: var(--muted); text-align: right; }
.role-select { padding: 5px 8px; border: 1px solid rgba(0,0,0,0.12); border-radius: 6px; background: white; font: 0.76rem system-ui, sans-serif; }

.member-grid { display: flex; flex-direction: column; gap: 12px; }
.member-card { display: flex; gap: 14px; padding: 18px; background: white; border: 1px solid rgba(16,36,31,0.08); border-radius: 12px; align-items: flex-start; }
.member-avatar { width: 44px; height: 44px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0; }
.member-info { flex: 1; }
.member-info strong { display: block; font-size: 0.95rem; margin-bottom: 2px; }
.member-role { font-family: system-ui, sans-serif; font-size: 0.8rem; color: var(--accent); font-weight: 600; display: block; }
.member-email { font-family: system-ui, sans-serif; font-size: 0.78rem; color: var(--muted); display: block; margin-bottom: 8px; }
.member-perms { display: flex; gap: 5px; flex-wrap: wrap; margin-bottom: 6px; }
.chip { font-family: system-ui, sans-serif; font-size: 0.66rem; padding: 2px 7px; border-radius: 100px; }
.chip.active { background: rgba(31,111,91,0.08); color: var(--accent); }
.chip.inactive { background: rgba(192,57,43,0.06); color: #c0392b; }
.member-activity { font-family: system-ui, sans-serif; font-size: 0.7rem; color: #aaa; }
.member-actions { display: flex; flex-direction: column; gap: 5px; }
.btn-sm { padding: 5px 12px; border: 1px solid rgba(0,0,0,0.1); border-radius: 6px; background: white; font-family: system-ui, sans-serif; font-size: 0.76rem; cursor: pointer; }
.btn-remove { color: #c0392b; border-color: rgba(192,57,43,0.2); }

.perm-table { margin-top: 2.5rem; background: white; border: 1px solid rgba(16,36,31,0.08); border-radius: 12px; padding: 20px; }
.perm-table h3 { font-size: 1rem; margin: 0 0 12px; }
.perm-grid { font-family: system-ui, sans-serif; font-size: 0.76rem; }
.perm-header, .perm-row { display: grid; grid-template-columns: 1.2fr 0.6fr 0.6fr 0.6fr 0.8fr 0.6fr 0.6fr; gap: 4px; padding: 7px 0; text-align: center; align-items: center; }
.perm-header { font-weight: 700; color: var(--muted); font-size: 0.7rem; text-transform: uppercase; border-bottom: 1px solid rgba(0,0,0,0.05); }
.perm-row { border-bottom: 1px solid rgba(0,0,0,0.03); }
.perm-role { text-align: left; font-weight: 600; }

.demo-notice { text-align: center; padding: 1.5rem; margin-top: 2rem; background: rgba(31,111,91,0.06); border-radius: 12px; font-family: system-ui, sans-serif; font-size: 0.85rem; color: var(--muted); }

@media (max-width: 600px) {
  .invite-url-row { flex-direction:column; }
  .invite-form .btn-primary { width:100%; }
  .live-panel { flex-direction: column; }
  .live-panel span { text-align: left; }
  .member-card { flex-wrap: wrap; }
  .member-actions { width: 100%; }
  .perm-header, .perm-row { grid-template-columns: repeat(7, 1fr); font-size: 0.68rem; }
}
</style>
