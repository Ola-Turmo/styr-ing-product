---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Hendelser og webhooks" activeNav="events">
  <main class="events-page">
    <section class="events-hero"><div><span class="eyebrow">Styr.ing · event mesh</span><h1>Hendelser som<br /><em>holder flyten synlig.</em></h1><p>Se hvilke destinasjoner som er registrert, hvilke hendelser som ligger i kø og hva som fortsatt krever godkjenning før noe kan sendes ut.</p></div><div class="hero-badge"><strong id="event-recent">—</strong><span>hendelser siste 7 dager</span><small id="event-mode">Sjekker backend…</small></div></section>
    <section class="event-metrics"><article><span>Destinasjoner</span><strong id="event-destinations">—</strong><small>registrert for virksomheten</small></article><article><span>I kø</span><strong id="event-queued">—</strong><small>venter på aktiv sender</small></article><article><span>Levert</span><strong id="event-sent">—</strong><small>ingen ekstern levering i preview</small></article><article class="dark"><span>Feil</span><strong id="event-failed">—</strong><small>krever gjennomgang</small></article></section>
    <section class="event-card"><div class="section-head"><div><span class="kicker">Destinasjoner</span><h2>Hvem kan motta hendelser?</h2></div><a href="/platform">Se plattformstatus ↗</a></div><div id="destinations" class="destination-list"><p class="empty">Henter destinasjoner…</p></div></section>
    <section class="event-card"><div class="section-head"><div><span class="kicker">Leveringskø</span><h2>Sporbar levering</h2></div><span id="delivery-status">Henter…</span></div><div id="deliveries" class="delivery-list"><p class="empty">Henter leveringer…</p></div></section>
    <aside class="notice"><strong>Produksjonsgrense</strong><p>Styr.ing kan registrere og klargjøre en leveringskø. En faktisk webhook-sender krever kundegodkjent endpoint, hemmelighetslager, signering, retry-policy, overvåking og en aktivert leverandøravtale.</p></aside>
  </main>
</Layout>
<script is:inline>
  const esc = (v) => String(v ?? '').replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const label = { proposed:'Foreslått', active:'Aktiv', paused:'Pauset', revoked:'Tilbakekalt', queued:'I kø', sent:'Levert', failed:'Feilet', skipped:'Hoppet over' };
  const load = async () => { try { const [s, d, q] = await Promise.all([fetch('/api/events?boardId=board-1&view=summary'), fetch('/api/events?boardId=board-1&view=destinations'), fetch('/api/events?boardId=board-1&view=deliveries')]); const summary = (await s.json()).data || {}; const destinations = (await d.json()).data || []; const deliveries = (await q.json()).data || []; document.getElementById('event-recent').textContent = summary.recent?.count ?? 0; document.getElementById('event-destinations').textContent = summary.destinations?.count ?? destinations.length; document.getElementById('event-queued').textContent = summary.queued?.count ?? 0; document.getElementById('event-sent').textContent = summary.sent?.count ?? 0; document.getElementById('event-failed').textContent = summary.failed?.count ?? 0; document.getElementById('event-mode').textContent = 'D1 tilkoblet · sender deaktivert'; document.getElementById('delivery-status').textContent = `${deliveries.length} spor siste 100`; document.getElementById('destinations').innerHTML = destinations.length ? destinations.map((row) => `<article><div><strong>${esc(row.name)}</strong><p>${esc(row.endpoint_url)}</p><small>Filter: ${esc(row.event_filter)}</small></div><em class="status status-${esc(row.status)}">${esc(label[row.status] || row.status)}</em></article>`).join('') : '<p class="empty">Ingen destinasjoner registrert.</p>'; document.getElementById('deliveries').innerHTML = deliveries.length ? deliveries.map((row) => `<article><div><strong>${esc(row.event_type)} · ${esc(row.destination_name)}</strong><p>${esc(row.created_at)}</p></div><em class="status status-${esc(row.status)}">${esc(label[row.status] || row.status)}</em></article>`).join('') : '<p class="empty">Leveringskøen er tom.</p>'; } catch { document.getElementById('event-mode').textContent = 'API utilgjengelig'; document.getElementById('destinations').innerHTML = '<p class="empty">Hendelsesdata er midlertidig utilgjengelig.</p>'; } }; load();
</script>
<style>
  .events-page{max-width:1180px;margin:0 auto;padding:38px 24px 80px}.events-hero{display:grid;grid-template-columns:1fr .42fr;gap:30px;align-items:center;padding:48px 44px;border-radius:26px;background:linear-gradient(120deg,#182f3a,#24566a);color:#fff}.eyebrow,.kicker{color:#bce9ef;font:700 .68rem/1 system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase}.events-hero h1{margin:20px 0 16px;font:500 clamp(2.7rem,5vw,4.5rem)/.96 Georgia,serif;letter-spacing:-.05em}.events-hero h1 em{color:#c4f2ca;font-style:normal}.events-hero p{max-width:580px;color:#c7dbe0;font:1rem/1.6 system-ui,sans-serif}.hero-badge{display:flex;flex-direction:column;align-items:center;justify-content:center;width:190px;height:190px;margin:auto;border:1px solid #bce9ef77;border-radius:50%;background:#173b49;box-shadow:0 15px 35px #071b2344}.hero-badge strong{color:#d5f69d;font:500 3.2rem/.9 Georgia,serif}.hero-badge span{margin-top:9px;color:#c7dbe0;font:700 .65rem system-ui,sans-serif;text-align:center}.hero-badge small{margin-top:12px;color:#abd5c1;font:.62rem system-ui,sans-serif}.event-metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:16px 0 50px}.event-metrics article{min-height:105px;padding:17px;border:1px solid #10241f14;border-radius:15px;background:#fff;display:flex;flex-direction:column;justify-content:space-between}.event-metrics .dark{background:#10241f;color:#fff}.event-metrics span,.event-metrics small{color:#718078;font:600 .67rem system-ui,sans-serif}.event-metrics strong{font:500 1.7rem Georgia,serif}.event-metrics small{font-weight:500}.event-card{padding:27px;border:1px solid #10241f18;border-radius:18px;background:#fff;margin-top:14px}.section-head{display:flex;justify-content:space-between;align-items:end;gap:12px;margin-bottom:18px}.section-head h2{margin:9px 0 0;font:500 2rem Georgia,serif;letter-spacing:-.04em}.section-head>a,.section-head>span{color:#718078;font:600 .72rem system-ui,sans-serif}.destination-list,.delivery-list{display:grid;gap:0}.destination-list article,.delivery-list article{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:15px 2px;border-top:1px solid #10241f12}.destination-list strong,.delivery-list strong{font:600 .82rem system-ui,sans-serif}.destination-list p,.destination-list small,.delivery-list p{margin:5px 0 0;color:#718078;font:.7rem/1.35 system-ui,sans-serif}.status{padding:5px 9px;border-radius:999px;background:#eef1ee;color:#718078;font:700 .61rem system-ui,sans-serif;font-style:normal;white-space:nowrap}.status-proposed{background:#fff0d8;color:#936017}.status-active,.status-sent{background:#e4f4e9;color:#23734f}.status-paused,.status-queued{background:#e7f0f8;color:#276487}.status-failed{background:#fae6e3;color:#a04d4d}.notice{margin-top:30px;padding:21px 24px;border-radius:15px;background:#eaf3ed;color:#5c6b65;font:.78rem/1.5 system-ui,sans-serif}.notice strong{color:#10241f}.notice p{margin:6px 0 0}.empty{color:#718078;font:.78rem system-ui,sans-serif}@media(max-width:800px){.events-hero{grid-template-columns:1fr}.event-metrics{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.events-page{padding:20px 15px 55px}.events-hero{padding:29px 22px}.event-metrics{grid-template-columns:1fr}.event-card{padding:20px 16px}.section-head{align-items:start;flex-direction:column}.destination-list article,.delivery-list article{align-items:start;flex-direction:column}.hero-badge{width:150px;height:150px}.hero-badge strong{font-size:2.6rem}}
</style>
