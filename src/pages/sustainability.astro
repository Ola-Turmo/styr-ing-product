---
import Layout from '../layouts/Layout.astro';
---
<Layout title="HMS og ESG" activeNav="sustainability"><main class="s-shell"><section class="s-hero"><div><span class="eyebrow">Styr.ing · HMS og ESG</span><h1>Gjør ansvar<br /><em>målelig.</em></h1><p>Samle avvik, SJA, sikkerhetsrunder, karbonmålinger og leverandøraktsomhet i samme oppfølgingsspor.</p><a href="#s-work" class="primary">Åpne kontrollbildet ↓</a></div><div class="s-orb"><strong id="hero-open">—</strong><span>åpne oppfølginger</span></div></section><section class="metrics"><article><span>Åpne</span><strong id="m-open">—</strong><small>hendelser og tiltak</small></article><article><span>Høy risiko</span><strong id="m-high">—</strong><small>krever prioritering</small></article><article><span>Karbon</span><strong id="m-carbon">—</strong><small>registrert verdi</small></article><article class="dark"><span>Guardrail</span><strong>HITL</strong><small>ingen automatisk rapportering</small></article></section><section id="s-work" class="workspace"><div class="head"><div><span class="kicker">GRC-register</span><h2>Hendelser og tiltak</h2></div><span id="status">Henter…</span></div><div id="list"></div></section><section class="notice"><strong>Produksjonsgrense</strong><p>Rapportering til myndigheter, karbonfaktorer, leverandørscanning og varsling krever datakilder, metode, avtaler og faglig godkjenning.</p></section></main></Layout>
<script is:inline>const e=v=>String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));const load=async()=>{try{const r=await fetch('/api/sustainability?boardId=board-1&view=summary'),d=(await r.json()).data||{};document.getElementById('m-open').textContent=d.open?.count??0;document.getElementById('m-high').textContent=d.high?.count??0;document.getElementById('m-carbon').textContent=d.carbon?.value??0;document.getElementById('hero-open').textContent=d.open?.count??0;const r2=await fetch('/api/sustainability?boardId=board-1&view=items'),rows=(await r2.json()).data||[];document.getElementById('status').textContent=`${rows.length} poster · kilder synlige`;document.getElementById('list').innerHTML=rows.map(x=>`<article><div><strong>${e(x.title)}</strong><p>${e(x.item_type)} · ${e(x.scope||'Omfang ikke satt')}</p></div><em>${e(x.status)}</em><small>${e(x.severity||'—')} · frist ${e(x.due_date||'—')}</small></article>`).join('')}catch{document.getElementById('status').textContent='API utilgjengelig'}};load();</script>
<style>.s-shell{max-width:1180px;margin:0 auto;padding:38px 24px 80px}.s-hero{display:grid;grid-template-columns:1fr .45fr;align-items:center;gap:24px;padding:44px;border-radius:27px;background:linear-gradient(120deg,#294337,#557b57);color:#fff}.eyebrow,.kicker{font:700 .68rem system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:#d3efba}.s-hero h1{margin:20px 0 16px;font:500 clamp(2.5rem,5vw,4.4rem)/.96 Georgia,serif}.s-hero h1 em{color:#d5fa9e;font-style:normal}.s-hero p{max-width:570px;color:#ffffffbf;font:1rem/1.6 system-ui,sans-serif}.primary{display:inline-flex;margin-top:22px;padding:13px 17px;border-radius:10px;background:#d7f69c;color:#243b2d;font:700 .78rem system-ui,sans-serif}.s-orb{width:190px;height:190px;display:flex;flex-direction:column;align-items:center;justify-content:center;border:1px solid #d0f0b7aa;border-radius:50%;background:#2d5540;color:#fff}.s-orb strong{font:500 3.2rem Georgia,serif;color:#dcffa9}.s-orb span{font:.68rem system-ui,sans-serif}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:16px 0 52px}.metrics article{min-height:105px;padding:17px;border:1px solid #10241f14;border-radius:15px;background:#fff;display:flex;flex-direction:column;justify-content:space-between}.metrics .dark{background:#10241f;color:#fff}.metrics span,.metrics small{color:#718078;font:600 .67rem system-ui,sans-serif}.metrics strong{font:500 1.7rem Georgia,serif}.metrics small{color:#478f68}.workspace{padding:28px;border:1px solid #10241f18;border-radius:20px;background:#fff}.head{display:flex;justify-content:space-between;align-items:end}.head h2{margin:9px 0 0;font:500 2.1rem Georgia,serif}.head>span{color:#718078;font:.7rem system-ui,sans-serif}.workspace article{display:grid;grid-template-columns:1.6fr auto auto;gap:12px;align-items:center;padding:15px 4px;border-top:1px solid #10241f12}.workspace strong{font:600 .82rem system-ui,sans-serif}.workspace p,.workspace small{margin:5px 0 0;color:#718078;font:.7rem system-ui,sans-serif}.workspace em{padding:5px 8px;border-radius:999px;background:#edf5e9;color:#477c51;font:700 .61rem system-ui,sans-serif;font-style:normal}.notice{margin-top:35px;padding:22px 25px;border-radius:16px;background:#eef5e9}.notice strong{font:700 .78rem system-ui,sans-serif}.notice p{margin:8px 0 0;color:#63736a;font:.78rem/1.5 system-ui,sans-serif}@media(max-width:800px){.s-hero{grid-template-columns:1fr}.metrics{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.s-shell{padding:20px 15px 55px}.s-hero{padding:28px 22px}.metrics{grid-template-columns:1fr}.workspace{padding:20px 16px}.workspace article{grid-template-columns:1fr auto}.workspace article small{grid-column:1}}</style>
