---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Internkontroll" activeNav="internkontroll">
  <div class="container control-page">
    <h1>Internkontroll</h1>
    <p class="intro">Samle kontrollpunkter, ansvar og siste vurdering i én arbeidsflate. Et kontrollpunkt kan markeres etter faglig gjennomgang.</p>
    <div class="stats"><div class="stat-card"><div id="control-total" class="stat-num">—</div><div class="stat-label">Kontrollpunkter</div></div><div class="stat-card"><div id="control-green" class="stat-num green">—</div><div class="stat-label">Grønn status</div></div><div class="stat-card"><div id="control-red" class="stat-num red">—</div><div class="stat-label">Krever tiltak</div></div></div>
    <div class="toolbar" role="toolbar" aria-label="Filtrer kontroller"><span>Vis</span><button class="filter active" data-filter="all">Alle</button><button class="filter" data-filter="green">Grønn</button><button class="filter" data-filter="yellow">Gul</button><button class="filter" data-filter="red">Rød</button><button id="export-controls" class="export" type="button">Eksporter utdrag ↗</button></div>
    <div id="control-list" class="control-list"><p class="empty">Henter kontroller…</p></div>
    <div class="notice">D1-kilde og tenant-scope er aktivert. Kontrollbevis, varsling og rammeverksvalg krever virksomhetens egen kvalitetssikring.</div>
  </div>
</Layout>
<script is:inline>
  const esc = (v) => String(v ?? '').replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); const labels = { green:'Grønn', yellow:'Gul', red:'Rød' }; let rows = [];
  const render = () => { const mode = document.querySelector('.filter.active')?.dataset.filter || 'all'; const visible = rows.filter((r) => mode === 'all' || r.status === mode); document.getElementById('control-list').innerHTML = visible.length ? visible.map((r) => `<article class="control-card"><div class="card-head"><h3>${esc(r.title)}</h3><span class="status status-${esc(r.status)}">${labels[r.status] || r.status}</span></div><p>${esc(r.notes || 'Kontrollpunkt med dokumentert ansvar og oppfølging.')}</p><div class="meta">Ansvar: ${esc(r.owner || 'Ikke satt')} · Frekvens: ${esc(r.frequency || 'Ikke satt')} · Sist vurdert: ${esc(r.last_review || 'Ikke vurdert')}</div><button class="review" type="button" data-control-id="${esc(r.id)}">Marker gjennomgått</button></article>`).join('') : '<p class="empty">Ingen kontroller i dette filteret.</p>'; document.querySelectorAll('.review').forEach((b) => b.addEventListener('click', async () => { const id = b.dataset.controlId; if (!id) return; const response = await fetch('/api/controls', { method:'POST', headers:{'content-type':'application/json','x-styr-api-key':'preview-write'}, body:JSON.stringify({boardId:'board-1',controlId:id,status:'green'}) }); if (response.ok) { const found = rows.find((r) => r.id === id); if (found) found.status = 'green'; render(); } })); };
  const load = async () => { try { const [s, i] = await Promise.all([fetch('/api/controls?boardId=board-1&view=summary'), fetch('/api/controls?boardId=board-1&view=items')]); const summary = (await s.json()).data || {}; rows = (await i.json()).data || []; document.getElementById('control-total').textContent = summary.total?.count ?? rows.length; document.getElementById('control-green').textContent = summary.green?.count ?? 0; document.getElementById('control-red').textContent = (Number(summary.red?.count || 0) + Number(summary.yellow?.count || 0)); render(); } catch { document.getElementById('control-list').innerHTML = '<p class="empty">Kontrolldata er midlertidig utilgjengelig.</p>'; } }; document.querySelectorAll('.filter').forEach((b) => b.addEventListener('click', () => { document.querySelectorAll('.filter').forEach((x) => x.classList.remove('active')); b.classList.add('active'); render(); })); document.getElementById('export-controls')?.addEventListener('click', () => { const blob = new Blob([rows.map((r) => `${r.title} · ${r.status} · ${r.owner || 'Ikke satt'}`).join('\n')], {type:'text/plain'}); const link = document.createElement('a'); link.href = URL.createObjectURL(blob); link.download = 'styring-kontroller.txt'; link.click(); URL.revokeObjectURL(link.href); }); load();
</script>
<style>
  .control-page{max-width:960px;margin:2rem auto;padding:0 20px}.control-page h1{font-size:2rem;margin-bottom:.5rem}.intro{font-family:system-ui,sans-serif;color:var(--muted);margin:0 0 2rem}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:2rem}.stat-card{background:#fff;border:1px solid rgba(16,36,31,.08);border-radius:12px;padding:16px;text-align:center}.stat-num{font-size:1.75rem;font-weight:700;color:var(--ink)}.stat-num.green{color:var(--accent)}.stat-num.red{color:#a04d4d}.stat-label{font-family:system-ui,sans-serif;font-size:.8rem;color:var(--muted);margin-top:2px}.toolbar{display:flex;align-items:center;flex-wrap:wrap;gap:7px;margin-bottom:18px;color:var(--muted);font:600 .7rem/1 system-ui,sans-serif}.filter,.export,.review{border:1px solid rgba(16,36,31,.12);border-radius:999px;background:#fff;color:var(--muted);cursor:pointer;font:600 .68rem/1 system-ui,sans-serif;padding:7px 10px}.filter.active,.filter:hover{color:#fff;background:var(--night);border-color:var(--night)}.export{margin-left:auto;color:var(--accent)}.control-list{display:grid;gap:16px}.control-card{background:#fff;border:1px solid rgba(16,36,31,.08);border-radius:14px;padding:20px 24px}.card-head{display:flex;justify-content:space-between;align-items:start;gap:16px}.card-head h3{font-size:1.05rem;margin:0}.control-card p{font-family:system-ui,sans-serif;font-size:.875rem;color:var(--muted);line-height:1.5}.meta{font-family:system-ui,sans-serif;font-size:.8rem;color:var(--muted)}.status{font-family:system-ui,sans-serif;font-size:.75rem;font-weight:600;padding:3px 12px;border-radius:100px;white-space:nowrap}.status-green{background:rgba(31,111,91,.1);color:var(--accent)}.status-yellow{background:rgba(216,169,77,.15);color:#8a7500}.status-red{background:rgba(160,77,77,.12);color:#a04d4d}.review{margin-top:14px;color:var(--accent)}.notice{margin-top:2rem;padding:1.5rem;background:rgba(31,111,91,.06);border-radius:12px;color:var(--muted);font:.9rem/1.5 system-ui,sans-serif}.empty{color:var(--muted);font:.85rem system-ui,sans-serif}@media(max-width:560px){.stats{grid-template-columns:1fr}.control-page{padding:0 15px}}
</style>
