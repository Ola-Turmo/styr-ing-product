---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Avtaler og eierskap" activeNav="governance">
<main class="gov-shell"><section class="gov-hero"><div><span class="eyebrow">Styr.ing · styring og juss</span><h1>Avtaler som tåler<br /><em>neste beslutning.</em></h1><p>Hold kontrakter, gjennomganger, fullmakter og eierskap i ett kontrollspor. Se hva som mangler før noen signerer eller fornyer.</p><a href="#governance-workspace" class="primary">Åpne kontrollbildet ↓</a></div><div class="hero-orb"><div class="orb-core"><span>Kontroll</span><strong id="hero-reviews">—</strong><small>avtaler til vurdering</small></div><i class="node n1">Fullmakter<br /><b id="hero-mandates">—</b> utkast</i><i class="node n2">Eierskap<br /><b id="hero-equity">—</b>% modellert</i></div></section>
<section class="metrics"><article><span>Avtaler</span><strong id="m-contracts">—</strong><small id="m-contracts-note">—</small></article><article><span>Fullmakter</span><strong id="m-mandates">—</strong><small>aktive og til vurdering</small></article><article><span>Eiere / puljer</span><strong id="m-equity">—</strong><small>aksjer i registeret</small></article><article><span>Redlines / opsjoner</span><strong id="m-legal">—</strong><small id="m-legal-note">— krever vurdering</small></article><article class="dark"><span>Guardrail</span><strong>HITL</strong><small>ingen automatisk signering</small></article></section>
<section id="governance-workspace" class="workspace"><div class="head"><div><span class="kicker">Styringsregister</span><h2>Se beslutningssporet</h2></div><span id="status">Henter…</span></div><nav class="tabs">{[['contracts','Avtaler'],['redlines','Redlines'],['mandates','Fullmakter'],['equity','Eierskap'],['grants','Opsjoner']].map(([key,label],i)=><button class={i===0?'active':''} data-view={key}>{label}</button>)}</nav><div id="list"></div></section>
<section class="governance-actions"><div><span class="kicker">Kontrollert juridisk flyt</span><h2>Flytt saken til neste kontrollpunkt.</h2><p>Handlingene krever eier- eller redaktørrolle og audit-logges. Signering, Brønnøysund-innsending og skatteberegning er fortsatt deaktivert.</p></div><div class="action-grid"><form id="review-form"><strong>Opprett kontraktsgjennomgang</strong><label>Avtale<select id="contract-select" name="contractId" required></select></label><label>Forfallsdato<input name="dueDate" type="date" required /></label><button type="submit">Opprett gjennomgang</button></form><form id="approve-review-form"><strong>Godkjenn gjennomgang</strong><label>Åpen gjennomgang<select id="review-select" name="reviewId" required></select></label><label>Beslutning<select name="decision"><option value="approved">Godkjent</option><option value="rejected">Avvist</option><option value="needs_changes">Krever endringer</option></select></label><button type="submit">Lagre beslutning</button></form><form id="redline-form"><strong>Godta redline</strong><label>Redline<select id="redline-select" name="redlineId" required></select></label><button type="submit">Godta redline</button><small>Dette er intern kontroll, ikke juridisk signering.</small></form><form id="mandate-form"><strong>Aktiver fullmakt</strong><label>Fullmakt<select id="mandate-select" name="mandateId" required></select></label><button type="submit">Aktiver fullmakt</button><small>Dokumentasjon må fortsatt foreligge.</small></form></div><p id="governance-action-status" class="action-status" role="status" hidden></p></section>
<section class="notice"><strong>Viktig grense</strong><p>Brønnøysund-oppslag, BankID/eID, PAdES-LTV og reell aksjeeierbok krever egne leverandøravtaler, nøkler, juridisk vurdering og kontrollert produksjonsoppsett.</p></section></main>
</Layout>
<script is:inline>
const esc=v=>String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));const labels={review:'Til gjennomgang',in_review:'Under vurdering',approved:'Godkjent',active:'Aktiv',draft:'Utkast',expired:'Utløpt',open:'Åpen'};const pill=v=>`<em class="pill">${esc(labels[v]||v||'—')}</em>`;const list=document.getElementById('list');
const render=(view,rows)=>{const f={contracts:r=>`<article><div><strong>${esc(r.title)}</strong><p>${esc(r.counterparty)} · ${esc(r.contract_type)} · eier ${esc(r.owner_name||'—')}</p></div>${pill(r.status)}${pill(r.review_status||'—')}<small>Varsel ${esc(r.renewal_notice_date||r.due_date||'—')}</small></article>`,redlines:r=>`<article><div><strong>${esc(r.contract_title)} · ${esc(r.clause_ref)}</strong><p>${esc(r.recommendation||'Juridisk vurdering mangler')}</p></div>${pill(r.risk_level)}${pill(r.status)}<small>${esc(r.counterparty)}</small></article>`,mandates:r=>`<article><div><strong>${esc(r.holder_name||'Uten innehaver')} · ${esc(r.mandate_type)}</strong><p>${esc(r.scope)}</p></div>${pill(r.status)}<small>Gyldig til ${esc(r.valid_until||'—')}</small></article>`,equity:r=>`<article><div><strong>${esc(r.holder_name)}</strong><p>${esc(r.holder_type)} · klasse ${esc(r.share_class)} · ${esc(r.vesting_status||'')}</p></div><b>${esc(r.ownership_percent)}%</b><small>${esc(r.shares)} aksjer</small></article>`,grants:r=>`<article><div><strong>${esc(r.grant_name)}</strong><p>${esc(r.holder_name||'Uten innehaver')} · ${esc(r.instrument)} · ${esc(r.granted_shares)} enheter</p></div>${pill(r.status)}${pill(r.tax_review_status)}<small>Vesting ${esc(r.vested_shares)}/${esc(r.granted_shares)}</small></article>`};list.innerHTML=rows.length?rows.map(f[view]).join(''):'<p class="empty">Ingen registrerte rader.</p>';};
const load=async view=>{try{const r=await fetch(`/api/governance?boardId=board-1&view=${view}`),d=await r.json();render(view,d.data||[]);document.getElementById('status').textContent=`${(d.data||[]).length} poster · kilde synlig`; }catch{document.getElementById('status').textContent='API utilgjengelig';}};const summary=async()=>{try{const r=await fetch('/api/governance?boardId=board-1&view=summary'),d=(await r.json()).data||{};const c=d.contracts||{},m=d.mandates||{},e=d.equity||{},rl=d.redlines||{},g=d.grants||{};document.getElementById('m-contracts').textContent=c.count??0;document.getElementById('m-contracts-note').textContent=`${c.review_count??0} til gjennomgang`;document.getElementById('m-mandates').textContent=m.count??0;document.getElementById('m-equity').textContent=e.shares??0;document.getElementById('m-legal').textContent=(rl.count??0)+(g.count??0);document.getElementById('m-legal-note').textContent=`${(rl.open_count??0)+(g.review_count??0)} krever vurdering`;document.getElementById('hero-reviews').textContent=c.review_count??0;document.getElementById('hero-mandates').textContent=m.draft_count??0;document.getElementById('hero-equity').textContent=e.holders?100:'—';}catch{}};
const actionStatus=document.getElementById('governance-action-status');const setActionStatus=(m,error=false)=>{actionStatus.hidden=!m;actionStatus.textContent=m||'';actionStatus.classList.toggle('error',error)};const api=async payload=>{const r=await fetch('/api/governance',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({boardId:'board-1',...payload})}),d=await r.json();if(!r.ok)throw new Error(d.error||'request_failed');setActionStatus('Endringen er lagret og auditert.');await Promise.all([summary(),refreshOptions(),load(document.querySelector('.tabs button.active')?.dataset.view||'contracts')])};const refreshOptions=async()=>{try{const [contracts,redlines,mandates]=await Promise.all(['contracts','redlines','mandates'].map(v=>fetch(`/api/governance?boardId=board-1&view=${v}`).then(r=>r.json())));document.getElementById('contract-select').innerHTML=(contracts.data||[]).map(r=>`<option value="${esc(r.id)}">${esc(r.title)} · ${esc(r.counterparty)}</option>`).join('');document.getElementById('review-select').innerHTML=(contracts.data||[]).filter(r=>['open','in_review'].includes(r.review_status)).map(r=>`<option value="${esc(r.review_id||r.id)}">${esc(r.title)} · ${esc(r.review_status)}</option>`).join('');document.getElementById('redline-select').innerHTML=(redlines.data||[]).filter(r=>['draft','review'].includes(r.status)).map(r=>`<option value="${esc(r.id)}">${esc(r.contract_title)} · ${esc(r.clause_ref)}</option>`).join('');document.getElementById('mandate-select').innerHTML=(mandates.data||[]).filter(r=>r.status==='draft').map(r=>`<option value="${esc(r.id)}">${esc(r.holder_name||'Uten innehaver')} · ${esc(r.mandate_type)}</option>`).join('')}catch{setActionStatus('Skjemaene kunne ikke lastes.',true)}};document.querySelectorAll('.tabs button').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.tabs button').forEach(x=>x.classList.remove('active'));b.classList.add('active');load(b.dataset.view)}));document.getElementById('review-form').addEventListener('submit',async e=>{e.preventDefault();const f=new FormData(e.currentTarget);try{await api({action:'create_contract_review',contractId:f.get('contractId'),dueDate:f.get('dueDate')});e.currentTarget.reset()}catch{setActionStatus('Gjennomgangen kunne ikke opprettes.',true)}});document.getElementById('approve-review-form').addEventListener('submit',async e=>{e.preventDefault();const f=new FormData(e.currentTarget);try{await api({action:'review_contract',reviewId:f.get('reviewId'),decision:f.get('decision')})}catch{setActionStatus('Beslutningen kunne ikke lagres.',true)}});document.getElementById('redline-form').addEventListener('submit',async e=>{e.preventDefault();const f=new FormData(e.currentTarget);try{await api({action:'accept_redline',redlineId:f.get('redlineId')})}catch{setActionStatus('Redline kunne ikke godtas.',true)}});document.getElementById('mandate-form').addEventListener('submit',async e=>{e.preventDefault();const f=new FormData(e.currentTarget);try{await api({action:'activate_mandate',mandateId:f.get('mandateId')})}catch{setActionStatus('Fullmakten kunne ikke aktiveres.',true)}});summary();refreshOptions();load('contracts');
</script>
<style>
.governance-actions{display:grid;grid-template-columns:.7fr 1.3fr;gap:25px;margin-top:34px;padding:28px;border:1px solid #10241f18;border-radius:20px;background:#f3f8f4}.governance-actions h2{margin:10px 0 8px;font:500 1.8rem/1.05 Georgia,serif}.governance-actions p{color:#63736a;font:.78rem/1.5 system-ui,sans-serif}.action-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.action-grid form{display:grid;gap:8px;padding:16px;border:1px solid #10241f14;border-radius:12px;background:#fff}.action-grid strong{font:700 .78rem system-ui,sans-serif}.action-grid label{display:grid;gap:4px;color:#63736a;font:600 .64rem system-ui,sans-serif}.action-grid input,.action-grid select{width:100%;padding:9px;border:1px solid #10241f1c;border-radius:7px;background:#fff;font:.72rem system-ui,sans-serif}.action-grid button{padding:9px;border:0;border-radius:8px;background:#183a40;color:#fff;cursor:pointer;font:700 .68rem system-ui,sans-serif}.action-grid small{color:#718078;font:.62rem/1.35 system-ui,sans-serif}.action-status{grid-column:1/-1;margin:4px 0 0;padding:9px 11px;border-radius:8px;background:#e2f3e5;color:#286447;font:700 .68rem system-ui,sans-serif}.action-status.error{background:#fae8e5;color:#97443d}.gov-shell{max-width:1180px;margin:0 auto;padding:38px 24px 80px}.gov-hero{display:grid;grid-template-columns:1fr .6fr;align-items:center;gap:25px;padding:44px;border-radius:27px;background:linear-gradient(120deg,#182c36,#315d65);color:#fff}.eyebrow,.kicker{font:700 .68rem/1 system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:#bfe5da}.gov-hero h1{margin:20px 0 16px;font:500 clamp(2.5rem,5vw,4.4rem)/.96 Georgia,serif;letter-spacing:-.055em}.gov-hero h1 em{color:#b9f0d6;font-style:normal}.gov-hero p{max-width:570px;color:rgba(255,255,255,.75);font:1rem/1.6 system-ui,sans-serif}.primary{display:inline-flex;margin-top:22px;padding:13px 17px;border-radius:10px;background:#c7f3d3;color:#18342c;font:700 .78rem/1 system-ui,sans-serif}.hero-orb{position:relative;min-height:250px;display:grid;place-items:center}.orb-core{width:132px;height:132px;display:flex;flex-direction:column;align-items:center;justify-content:center;border:1px solid #b7eed2;border-radius:50%;background:#173e42;box-shadow:0 0 40px #8bdec422}.orb-core span,.orb-core small{color:#b6d9cf;font:700 .58rem system-ui,sans-serif;text-transform:uppercase;letter-spacing:.1em}.orb-core strong{margin:8px 0;color:#c7f5c8;font:500 2.7rem Georgia,serif}.node{position:absolute;padding:9px 12px;border:1px solid #b6dcd355;border-radius:10px;background:#234e55;color:#d7f4e5;font:600 .68rem/1.35 system-ui,sans-serif;font-style:normal}.node b{color:#fff}.n1{top:15px;right:2%}.n2{bottom:10px;left:3%}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:16px 0 52px}.metrics article{min-height:108px;padding:17px;border:1px solid #10241f14;border-radius:15px;background:#fff;display:flex;flex-direction:column;justify-content:space-between}.metrics .dark{background:#10241f;color:#fff}.metrics span,.metrics small{color:#718078;font:600 .67rem/1.25 system-ui,sans-serif}.metrics strong{font:500 1.7rem/.9 Georgia,serif}.metrics small{color:#458d68}.workspace{padding:28px;border:1px solid #10241f18;border-radius:20px;background:#fff}.head{display:flex;justify-content:space-between;align-items:end}.head h2{margin:9px 0 0;font:500 2.1rem Georgia,serif;letter-spacing:-.04em}.head>span{color:#6d7d75;font:.7rem system-ui,sans-serif}.tabs{display:flex;gap:6px;margin:25px 0 12px}.tabs button{padding:10px 14px;border:1px solid #10241f1c;border-radius:9px;background:#fafbf9;color:#65746b;cursor:pointer;font:700 .72rem system-ui,sans-serif}.tabs button.active{background:#183a40;color:#fff}.workspace article{display:grid;grid-template-columns:1.6fr auto auto;gap:12px;align-items:center;padding:15px 4px;border-top:1px solid #10241f12}.workspace strong{font:600 .82rem system-ui,sans-serif}.workspace p,.workspace small{margin:5px 0 0;color:#718078;font:.7rem/1.35 system-ui,sans-serif}.pill{padding:5px 8px;border-radius:999px;background:#e7f3ef;color:#2e725b;font:700 .61rem system-ui,sans-serif;font-style:normal;white-space:nowrap}.notice{margin-top:35px;padding:22px 25px;border-radius:16px;background:#edf4f0}.notice strong{color:#234e55;font:700 .78rem system-ui,sans-serif}.notice p{margin:8px 0 0;color:#63736a;font:.78rem/1.5 system-ui,sans-serif}@media(max-width:800px){.gov-hero{grid-template-columns:1fr}.metrics{grid-template-columns:repeat(2,1fr)}.workspace article{grid-template-columns:1fr auto}.workspace article small{grid-column:1}}@media(max-width:560px){.governance-actions{display:grid;grid-template-columns:.7fr 1.3fr;gap:25px;margin-top:34px;padding:28px;border:1px solid #10241f18;border-radius:20px;background:#f3f8f4}.governance-actions h2{margin:10px 0 8px;font:500 1.8rem/1.05 Georgia,serif}.governance-actions p{color:#63736a;font:.78rem/1.5 system-ui,sans-serif}.action-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.action-grid form{display:grid;gap:8px;padding:16px;border:1px solid #10241f14;border-radius:12px;background:#fff}.action-grid strong{font:700 .78rem system-ui,sans-serif}.action-grid label{display:grid;gap:4px;color:#63736a;font:600 .64rem system-ui,sans-serif}.action-grid input,.action-grid select{width:100%;padding:9px;border:1px solid #10241f1c;border-radius:7px;background:#fff;font:.72rem system-ui,sans-serif}.action-grid button{padding:9px;border:0;border-radius:8px;background:#183a40;color:#fff;cursor:pointer;font:700 .68rem system-ui,sans-serif}.action-grid small{color:#718078;font:.62rem/1.35 system-ui,sans-serif}.action-status{grid-column:1/-1;margin:4px 0 0;padding:9px 11px;border-radius:8px;background:#e2f3e5;color:#286447;font:700 .68rem system-ui,sans-serif}.action-status.error{background:#fae8e5;color:#97443d}.gov-shell{padding:20px 15px 55px}.gov-hero{padding:28px 22px;border-radius:21px}.metrics{grid-template-columns:1fr}.workspace{padding:20px 16px}.head{align-items:start;flex-direction:column;gap:9px}}
</style>
