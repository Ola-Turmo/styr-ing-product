{
  "name": "styr-ing-product",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "verify:source": "node scripts/verify-source-integrity.mjs",
    "verify": "npm run verify:source && npm run build && node scripts/verify-concept-boundary.mjs",
    "verify:concept-boundary": "npm run build && node scripts/verify-concept-boundary.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name styr-ing --branch main"
  },
  "dependencies": {
    "@astrojs/cloudflare": "10.4.2",
    "astro": "^4.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
